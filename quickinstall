#!/bin/bash
if {
  echo "######### CONFIGURING..."
  ./configure -y
  } && {
  echo "######### BUILDING AND INSTALLING..."
  make -s fullinstall
  }
then
  echo "BreadCaml built and installed successfully."
else
  echo "FAILURE." 1>&2
  echo "Please read INSTALL.md and follow the manual installation procedure." 1>&2
  make -s clean > /dev/null 2>&1
fi

