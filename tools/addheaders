if (( $# == 0 )); then
    # nessun argomento: stampa i modelli disponibili.
    print_templates
    exit 0
elif (( $# > 1 )); then
    echo "$0: troppi argomenti." 1>&2
    echo "Usa '$0 --help' per informazioni." 1>&2
    exit 1
elif [[ $1 == "-help" || $1 == "--help" ]]; then
    help
    exit 0
elif [[ ! -d $1 ]]; then
    echo "$0: la cartella '$1' non esiste." 1>&2
    exit 1
fi

DIR="$1"

# Attende dall'utente una scelta valida
ask_user
until [[ $CHOICE == 0 || ( $CHOICE =~ ^[0-9]+ && -n ${TITLE[$CHOICE]} ) ]]; do
    read -p "Scelta non valida, riprova (^C per uscire): " CHOICE 
done

if [[ $CHOICE == 0 ]]; then
    echo "Rimuovo gli header da tutti i file in '$(pwd)' e nelle subdirectory,"
    read -p "CONFERMI? (s/n) " CONFIRM
    if [[ $CONFIRM =~ [sS] ]]; then
	remove_all_headers
    else
	echo "Rimozione annullata".
    fi
else
    echo "Applicazione di ${TITLE[$CHOICE]}..."
    # Usa eval per evitare l'espansione di * in FIND.
    eval "find \"\$DIR\" -type f \( ${FIND[$CHOICE]} \)"|while read -r FILE; do
	add_header "$FILE" "$CHOICE"
    done
    echo "Operazione completata!"
fi
