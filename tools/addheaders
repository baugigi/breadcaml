function help {
    cat <<EOF
$0 [DIRECTORY]
Aggiunge gli header appropriati a tutti i file sorgenti OCaml o ACME
nella DIRECTORY indicata e nelle sue subdirectory.
Se DIRECTORY non è indicata, stampa i modelli di header disponibili.
EOF
}

function print_templates {
    for I in ${!TITLE[@]}; do
	echo
	echo "MODELLO $I) ${TITLE[$I]}"
	echo "${HEADER[$I]}"
	echo
    done | less
}

function ask_user {
    echo "Quale header vuoi applicare ai file in '$DIR'?"
    for I in ${!TITLE[@]}; do
	echo " $I) ${TITLE[$I]}"
    done
    echo "Scegli un'opzione da 1 a ${#TITLE[@]},"
    read -p "oppure 0 per RIMUOVERE tutti gli header: " CHOICE
}

function add_header { #FILE #CHOICE
    # Salta il file se nelle prime tre righe contiene già la firma
    if grep -q -m 3 "$SIGNATURE" "$1"; then
        echo "Saltato (header già presente): $1"
    else
        TEMP_FILE=$(mktemp)
        echo "${HEADER[$2]}" > "$TEMP_FILE"
        echo >> "$TEMP_FILE"
        cat "$1" >> "$TEMP_FILE"
        mv "$TEMP_FILE" "$1"
        echo "Header n° $2 inserito in: $1"
    fi
}


