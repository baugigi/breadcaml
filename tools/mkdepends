#!/bin/bash

# depends.asm generator for src/asm/stdlib_*.asm routines

# All routines (OCaml primitives AND auxiliary routines) MUST:
#  - start with   !ifdef caml_PRIM__routine_name { ;optional comment
#  - end with     } ;optional comment
# The final '}' MUST be at 1ST COLUMN; any '}' in routine code MUST NOT.

PWD="$(pwd)"
[[ ${PWD%/src/asm} == $PWD ]] && { echo "Not in 'src/asm'!"; exit 1; }

# Input and output files
INFILE=stdlib_*.asm
OUTFILE=depends.asm

# sed program to extract deps
IFDEF='^[ \t]*!ifdef[ \t]+caml_PRIM__' # Regexp: routine's 1st line
ROUTINE='caml_[a-zA-Z0-9_]+'           # Regexp: routine name
SEDPROGRAM="
  /$IFDEF/, /^}/ {
  /$IFDEF/ {                           # First line:
    s/$IFDEF($ROUTINE).*$/\1 \"/       #  isolate routine name and add '"'
    h				       #  copy to hold space
    d				       #  delete, start next cycle
  }
  /^}/ {			       # Last line:
    g  				       #  get held text; then add '"'
    a \"
    p	  			       #  print: routine '"' dep dep... '"'
    d				       #  delete, start next cycle
  }
				       # Lines in between:
  s/;.*$//g                            #  remove ACME comments
  s/.*[ \t(><]($ROUTINE)/§\1/g         #  prepend § to each dep
  /§/! d                               #  no deps: delete, start next cycle
  /§/ s/[^§]*§($ROUTINE)[^§]*/\1 /g    #  deps: remove § and text between deps
  H                                    #  append deps to hold space
}"

# Init DEPS array
declare -A DEPS="($(sed -s -n -E "$SEDPROGRAM" $INFILE))"

# Remove fake deps, i.e., any caml_xyz which is not a routine (an array key)
for ROUTINE in ${!DEPS[@]}; do
    DEPLIST=''
    for DEP in ${DEPS["$ROUTINE"]}; do
	# if DEPS[DEP] is set; then add DEP to DEPLIST; fi
	[[ ${DEPS[$DEP]+dummy} ]] && DEPLIST+="$DEP "
    done
    DEPS["$ROUTINE"]="$DEPLIST"
done

# Calculate the transitive closure of all deps (breadth-first visit)
declare -A TRCLOS
declare -Ai VISITED
declare -a QUEUE
for ROUTINE in ${!DEPS[@]}; do
    VISITED=()
    QUEUE=()
    QHEAD=0
    for DEP in ${DEPS["$ROUTINE"]}; do
	VISITED["$DEP"]=1
	QUEUE+=("$DEP")
    done
    while (( QHEAD < ${#QUEUE[@]} )); do
	NODE="${QUEUE[$QHEAD]}"
	(( QHEAD++ ))
	for DEP in ${DEPS["$NODE"]}; do
	    if ! (( ${VISITED[$DEP]} )); then
		VISITED["$DEP"]=1
		QUEUE+=("$DEP")
	    fi
	done
    done
    TRCLOS["$ROUTINE"]=$(printf "%s\n" ${!VISITED[@]})
done

# Generate the output file
{   echo ";; Generated by $0 $(date -u -Iseconds)"
    echo ";; AUTO-GENERATED FILE - DO NOT EDIT"
    echo ""
    for ROUTINE in $(printf "%s\n" ${!DEPS[@]}|sort); do
	[[ ${TRCLOS[$ROUTINE]} ]] && {
            echo "!ifdef caml_PRIM__$ROUTINE {"
            for DEP in $(printf "%s\n" ${TRCLOS[$ROUTINE]}|sort); do
		echo "  !set caml_PRIM__$DEP=1"
            done
            echo "}"
            echo ""
	}
    done
} > "$OUTFILE"
