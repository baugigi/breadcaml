  2526                                          ;; The table is page-aligned. The fetch-exec routine sets C=bit7
  2527                                          ;; of fetched opcode, then accesses the table using 2*opcode as
  2528                                          ;; an index.  
  2529                          
  2530  1d7a eaeaeaeaeaeaeaea...                !align  $FF, $00
  2531                          caml_interp_jmptbl
  2532                                          ;; $00...$0f/$80...$8f  (unused opcodes: $0a, $82, $8d, $8e)
  2533  1e00 191d1e1d3b1d231d...                !wo ACC0_OFSREF, ACC1_ISINT, ACC07, ACC3_BEQ, ACC4_BNEQ
  2534  1e0a 391d3f1d051d001d                   !wo ACC5_BLTINT, ACC6_BLEINT, ACC7_BGTINT, ACC_BGEINT
  2535  1e12 e91c8d1af41cf41c                   !wo PUSH_ULTINT, UGEINT, PHACC1_BULTINT, PHACC2_BUGEINT 
  2536  1e1a f41cf41cef1c                       !wo PHACC17, PHACC17, PHACC5_STOP
  2537                                          ;; $10...$1f/$90...$94  (unused opcodes: $90...$94)
  2538  1e20 f41cf41cfd130314...                !wo PHACC17, PHACC17, PHACC, POPN, ASSIGNH, ENVACC14, ENVACC14
  2539  1e2e 0e1c0e1c021c021c...                !wo ENVACC14, ENVACC14, ENVACCN, PHENVACC14, PHENVACC14
  2540  1e38 021c021c021c5014                   !wo PHENVACC14, PHENVACC14, PHENVACC, PHRET
  2541                                          ;; $20...$2f
  2542  1e40 0e1c501450145014...                !wo APPLYN, APPLY13, APPLY13, APPLY13, APPTRMN, APPTRM13
  2543  1e4c 0e1c0e1cbe15df14...                !wo APPTRM13, APPTRM13, RETURN, RESTART, GRAB, CLOSURE, CLOSREC
  2544  1e5a 201c1117261c                       !wo OFSCLM2, OFSCL0, OFSCL2
  2545                                          ;; $30...$3f            (unused opcodes: $3b, $3d)
  2546  1e60 1c17201c201c261c...                !wo OFSCLN, PHOFSCLM2, PHOFSCL0, PHOFSCL2, PHOFSCLN, GETGLB
  2547  1e6c 261c521c4c1c1c17...                !wo PHGETGLB, GETGLBFLD, PHGETGLBFLD, SETGLB, ATOM0, $ffff
  2548  1e78 6d1cffff6d1c6d1c                   !wo PHATOM0, $ffff, MKBLKN, MKBLK13
  2549                                          ;; $40...$4f
  2550  1e80 6d1c6d1c7d178617...                !wo MKBLK13, MKBLK13, MKFBLK, GETFLD0, GETFLD13, GETFLD13
  2551  1e8c 771c7d17b0179517...                !wo GETFLD13, GETFLDN, GETFFLDN, SETFLD0, SETFLD13, SETFLD13
  2552  1e98 7d1c9517b017b017                   !wo SETFLD13, SETFLDN, SETFFLDN, VECLEN
  2553                                          ;; $50...$5f            (unused opcode: $5c)
  2554  1ea0 b017b017b017b017...                !wo GETVEC, SETVEC, GETCHR, SETCHR, BRANCH, BIF, BIFNOT, SWITCH
  2555  1eb0 da17e317e317e317...                !wo BOOLNOT, PHTRP, POPTRP, RAISE, $ffff, CCALL, CCALL, CCALL
  2556                                          ;; $60...$6f
  2557  1ec0 281828182818cb1c...                !wo CCALL, CCALL, CCALL, CST03, CST03, CST03, CST03, CSTN
  2558  1ed0 be1cbe1cbe1cbe1c...                !wo PHCST03, PHCST03, PHCST03, PHCST03, PHCSTN, NEGINT, ADDINT
  2559  1ede 8518                               !wo SUBINT
  2560                                          ;; $70...$7f
  2561  1ee0 9f188719a9199f18...                !wo MULINT, DIVINT, MODINT, ANDINT, ORINT, XORINT, LSLINT
  2562  1eee 9f189f18d119e119...                !wo LSRINT, ASRINT, EQ, NEQ, LTINT, LEINT, GTINT, GEINT, OFSINT
  2563                          
