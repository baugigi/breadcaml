   369                                  ;; AUX
   370                                  ;;
   371                          
   372                          !ifdef caml_PRIM__caml_string_index_y {
   373                          caml_string_index_y
   374                                  ;; given a string in ACCU, read index from SP[0], then
   375                                  ;; set Y and ACCU+1 so that ACCU+Y = &string[index];
   376                                  ;; raise Invalid_argument if not 0<=index<length(string).
   377                                  LDY # 1
   378                                  LDA (SP),Y                              ;get ARGh
   379                                  LSR                                     ;Int_val(ARGh)
   380                                  STA TMP + 1                             ;save
   381                                  DEY
   382                                  LDA (SP),Y                              ;get ARGl
   383                                  ROR                                     ;Int_val(ARGl)
   384                                  STA TMP                                 ;save
   385                                  JSR caml_string_length_yx               ;get string length in .Y.X
   386                                  CPX TMP + 1                             ;compare hi bytes
   387                                  BCC ++                                  ;.X < ARGh: error
   388                                  BNE +                                   ;.X > ARGh: ok
   389                                  CPY TMP                                 ;.X = ARGh: compare lo byte
   390                                  BCC ++                                  ;.Y < ARGl: error
   391                                  BEQ ++                                  ;.Y = ARGl: error
   392                          +       LDY TMP                                 ;reload index, lo
   393                                  LDA TMP + 1
   394                                  BEQ +
   395                                  INC ACCU + 1                            ;inc ACCUh if needed
   396                          +       RTS
   397                          ++      +caml_raise Invalid_argument, "index out of bounds"
   398                          }
   399                          
   400                          !ifdef caml_PRIM__caml_string_length_yx {
   401                          caml_string_length_yx
   402                                  ;; ACCU = string
   403                                  ;; return the string length in .Y,.X (int16, lo-hi)
   404  23f2 a52d                       LDA ACCU + 1
   405  23f4 48                         PHA                                     ;save ACCU + 1
   406  23f5 88                         DEY                                     ;LDY # -1
   407  23f6 c62d                       DEC ACCU + 1
   408  23f8 b12c                       LDA (ACCU),Y                            ;.A := size
   409  23fa e62d                       INC ACCU + 1
   410  23fc a200                       LDX # 0
   411  23fe 0a                         ASL
   412  23ff a8                         TAY                                     ;.Y := <(2 * size)
   413  2400 9008                       BCC @minus1
   414  2402 d003                       BNE +
   415  2404 88                         DEY                                     ;shortcut when .Y=256
   416  2405 d00b                       BNE @pad                                ;bne=jmp
   417  2407 e62d               +       INC ACCU + 1
   418  2409 e8                         INX                                     ;.X := >(2 * size)
   419  240a 88                 @minus1 DEY                                     ;.Y := <(2 * size - 1)
   420  240b c0ff                       CPY # $FF
   421  240d d003                       BNE @pad
   422  240f c62d                       DEC ACCU + 1
   423  2411 ca                         DEX                                     ;.X := >(2 * size - 1)
   424  2412 b12c               @pad    LDA (ACCU),Y                            ;.A := padding byte
   425  2414 f006                       BEQ +
   426  2416 88                         DEY                                     ;.Y := <(2 * size -1 -pad)
   427  2417 c0ff                       CPY # $FF
   428  2419 d001                       BNE +
   429  241b ca                         DEX                                     ;.X := >(2 * size -1 -pad)
   430  241c 68                 +       PLA
   431  241d 852d                       STA ACCU + 1                            ;restore ACCU+1
   432  241f 60                         RTS
   433                          }
   434                          
   435                          }      ;; !zone caml_STRINGS
