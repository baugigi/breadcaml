   222  86e2 b1fd                       LDA (SP),Y                      ; >len
   223  86e4 4a                         LSR
   224  86e5 8552                       STA @SIZE + 1                   ; SIZE + 1 := >int_val(len)
   225  86e7 88                         DEY
   226  86e8 b1fd                       LDA (SP),Y                      ; <len
   227  86ea 6a                         ROR
   228  86eb 8551                       STA @SIZE                       ; SIZE := <int_val(len)
   229  86ed 88                         DEY
   230  86ee b1fd                       LDA (SP),Y                      ; >dofs
   231  86f0 4a                         LSR
   232  86f1 8550                       STA @TO + 1                     ; TO := >int_val(dofs)
   233  86f3 88                         DEY
   234  86f4 b1fd                       LDA (SP),Y                      ; <dofs
   235  86f6 6a                         ROR
   236  86f7 854f                       STA @TO                         ; TO := <int_val(dofs)
   237  86f9 88                         DEY
   238  86fa b1fd                       LDA (SP),Y                      ; >dst
   239  86fc aa                         TAX
   240  86fd 88                         DEY
   241  86fe b1fd                       LDA (SP),Y                      ; <dst
   242  8700 18                         CLC
   243  8701 654f                       ADC @TO
   244  8703 854f                       STA @TO                         ; TO := <(dst + int_val(dofs))
   245  8705 8a                         TXA
   246  8706 6550                       ADC @TO + 1
   247  8708 8550                       STA @TO + 1                     ; TO + 1:= >(dst+int_val(dofs))
   248  870a 88                         DEY
   249  870b b1fd                       LDA (SP),Y                      ; >sofs
   250  870d 4a                         LSR
   251  870e aa                         TAX
   252  870f 88                         DEY
   253  8710 b1fd                       LDA (SP),Y                      ; <soft
   254  8712 6a                         ROR
   255  8713 18                         CLC
   256  8714 65fb                       ADC ACCU
   257  8716 854d                       STA @FROM                       ; FROM := <(src + int_val(sofs))
   258  8718 a8                         TAY
   259  8719 8a                         TXA
   260  871a 65fc                       ADC ACCU + 1
   261  871c 854e                       STA @FROM + 1                   ; FROM+1 := >(src+int_val(sofs))
   262  871e 20fd7e                     JSR caml_memcpy                 ; ok, even if src & dest overlap
   263  8721 a001                       LDY # <Val_unit
   264  8723 84fb                       STY ACCU
   265  8725 88                         DEY
   266  8726 84fc                       STY ACCU + 1
   267  8728 60                         RTS
