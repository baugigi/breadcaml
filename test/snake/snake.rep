   130                          ;; i15-i1e depend on i19
   131                          
   132                          !macro  i19 .n {                                ;ENVACC n
   133                                  +caml_range 0, .n, $FE, "ENVACC n: n"
   134                                  .n2h = >(2 * .n)
   135                                  .n2l = <(2 * .n)
   136                                  !set    caml_gen_ENVACC = 1
   137                            !if .n2l > 0 {
   138                                  LDY # .n2l
   139                            }
   140                            !if .n2h > 0 {
   141                                  INC ENV + 1
   142                                  JSR caml_ENVACC
   143                                  DEC ENV + 1
   144                            } else {
   145                                  JSR caml_ENVACC
   146                            }
   147                          }
