    40                          !ifdef caml_PRIM__caml_nonstd_sys_argv {
    41                          caml_nonstd_sys_argv
    42                                  ;; Sys.argv (via Sys.get_argv: unit -> string array).
    43                                  ;; Returns an array whose element 0 is executable_name and whose
    44                                  ;; other elements are the program arguments, taken from the BASIC input
    45                                  ;; buffer (C64_BUF), where the direct-mode line that started the program
    46                                  ;; is still stored in tokenized form.  Syntax accepted:
    47                                  ;;      RUN:REM arg1, "arg 2", arg3
    48                                  ;; The line must be exactly RUN, ':', REM (tokens; spaces allowed
    49                                  ;; between them) followed by the arguments.  Arguments are separated by commas;
    50                                  ;; unquoted ones are trimmed of leading and trailing spaces; a quoted
    51                                  ;; one is taken verbatim, without the quotes.  Otherwise: no arguments.
    52                                  ;; The buffer is overwritten by float conversions (stdlib_floats.asm),
    53                                  ;; so this primitive must be called early (Sys.argv is evaluated when
    54                                  ;; module Sys is initialised).
    55                          @POS    = TMP                           ;buffer offset of next arg, $FF = none
    56                          @STA    = TMP + 1                       ;buffer offset of current arg
    57                          @LEN    = TMP + 2                       ;length of current arg
    58                          @CNT    = TMP + 3                       ;arg counter / copy limit
    59                          @IDX    = TMP + 4                       ;byte offset of next array field
    60                                  ;; pass 1: count the arguments
    61                                  JSR @init
    62                                  LDA # 0
    63                                  STA @CNT
    64                          -       JSR @next
    65                                  BCS +
    66                                  INC @CNT
    67                                  BNE -                           ;(always)
    68                          +       LDX @CNT
    69                                  INX                             ;array size = args + 1
    70                                  LDY # 0
    71                                  TYA                             ;tag 0
    72                                  JSR caml_alloc                  ;BLK = new array
    73                                  TXA
    74                                  ASL
    75                                  TAY                             ;Y := byte size
    76                          -       LDA # 0                         ;initialise fields with Val_unit
    77                                  DEY
    78                                  STA (BLK),Y
    79                                  LDA # < Val_unit
    80                                  DEY
    81                                  STA (BLK),Y
    82                                  BNE -
    83                                  JSR caml_load_newblk            ;ACCU := array (a GC root)
    84                                  LDA # < caml_exec_name + 2      ;array[0] := executable_name
    85                                  STA (ACCU),Y                    ;(static block: not in the heap)
    86                                  INY
    87                                  LDA # > caml_exec_name + 2
    88                                  STA (ACCU),Y
    89                                  INY
    90                                  STY @IDX
    91                                  ;; pass 2: allocate and fill the strings
    92                                  JSR @init
    93                          @loop   JSR @next
    94                                  BCS @done
    95                                  LDA @LEN
    96                                  LSR
    97                                  TAX
    98                                  INX                             ;X := size in words
    99                                  LDA # String_tag
   100                                  JSR caml_alloc                  ;ACCU = array: updated by a GC
   101                                  LDY @IDX
   102                                  LDA BLK
   103                                  STA (ACCU),Y                    ;array[i] := new string
   104                                  INY
   105                                  LDA BLK + 1
   106                                  STA (ACCU),Y
   107                                  INY
   108                                  STY @IDX
   109                                  LDY # 0
   110                          -       CPY @LEN                        ;copy the characters
   111                                  BEQ +
   112                                  TYA
   113                                  CLC
   114                                  ADC @STA
   115                                  TAX
   116                                  LDA C64_BUF,X
   117                                  STA (BLK),Y
   118                                  INY
   119                                  BNE -                           ;(always)
   120                          +       LDA # 0                         ;padding
   121                                  STA (BLK),Y
   122                                  TYA
   123                                  LSR
   124                                  BCS @loop                       ;odd length: "\000"
   125                                  INY
   126                                  LDA # 1                         ;even length: "\000\001"
   127                                  STA (BLK),Y
   128                                  BNE @loop                       ;(always)
   129                          @done   LDY # 0
   130                                  RTS
   131                                  ;; -- parse the beginning of the line; set @POS
   132                          @init   LDX # 0
   133                                  JSR @skipsp
   134                                  LDA C64_BUF,X
   135                                  CMP # $8A                       ;RUN token
   136                                  BNE @none
   137                                  INX
   138                                  JSR @skipsp
   139                                  LDA C64_BUF,X
   140                                  CMP # ':'
   141                                  BNE @none
   142                                  INX
   143                                  JSR @skipsp
   144                                  LDA C64_BUF,X
   145                                  CMP # $8F                       ;REM token
   146                                  BNE @none
   147                                  INX
   148                                  JSR @skipsp
   149                                  LDA C64_BUF,X
   150                                  BEQ @none                       ;nothing after 'REM'
   151                                  STX @POS
   152                                  RTS
   153                          @none   LDA # $FF
   154                                  STA @POS
   155                                  RTS
   156                                  ;; -- X := X + number of spaces at C64_BUF,X
   157                          @skipsp LDA C64_BUF,X
   158                                  CMP # ' '
   159                                  BNE +
   160                                  INX
   161                                  BNE @skipsp
   162                          +       RTS
   163                                  ;; -- X := offset of the first ',' or 0 at C64_BUF,X or following
   164                          @tail   LDA C64_BUF,X
   165                                  BEQ +
   166                                  CMP # ','
   167                                  BEQ +
   168                                  INX
   169                                  BNE @tail
   170                          +       RTS
   171                                  ;; -- next argument: C = 1 if none, else C = 0, @STA, @LEN set
   172                          @next   LDX @POS
   173                                  INX
   174                                  BEQ @eof
   175                                  DEX
   176                                  JSR @skipsp
   177                                  LDA C64_BUF,X
   178                                  CMP # '"'
   179                                  BEQ @quote
   180                                  STX @STA
   181                                  JSR @tail
   182                                  TXA
   183                                  TAY                             ;Y := end of text
   184                          -       CPX @STA                        ;remove trailing spaces
   185                                  BEQ +
   186                                  LDA C64_BUF - 1,X
   187                                  CMP # ' '
   188                                  BNE +
   189                                  DEX
   190                                  BNE -                           ;(always)
   191                          +       TXA
   192                                  SEC
   193                                  SBC @STA
   194                                  STA @LEN
   195                                  TYA
   196                                  TAX
   197                                  BNE @tend                       ;(always unless offset 0)
   198                          @quote  INX
   199                                  STX @STA
   200                          -       LDA C64_BUF,X                   ;find the closing quote
   201                                  BEQ +
   202                                  CMP # '"'
   203                                  BEQ +
   204                                  INX
   205                                  BNE -
   206                          +       TXA
   207                                  SEC
   208                                  SBC @STA
   209                                  STA @LEN
   210                                  JSR @tail                       ;skip to the next ',' or the end
   211                          @tend   LDA C64_BUF,X
   212                                  BEQ @last
   213                                  INX
   214                                  STX @POS                        ;next argument starts after the ','
   215                                  CLC
   216                                  RTS
   217                          @last   LDA # $FF
   218                                  STA @POS
   219                                  CLC
   220                                  RTS
   221                          @eof    SEC
   222                                  RTS
   223                          }
   224                          
   225                          !ifdef caml_PRIM__caml_nonstd_get_exec_name {
   226                          caml_nonstd_get_exec_name
   227                                  ;; Sys.get_exec_name: ACCU := static string "output file name",
   228                                  ;; emitted by bcamlc (Export.export_exec_name).
   229                                  LDA # < caml_exec_name + 2
   230                                  STA ACCU
   231                                  LDA # > caml_exec_name + 2
   232                                  STA ACCU + 1
   233                                  RTS
   234                          }
   235                          
   236                          !ifdef caml_PRIM__caml_sys_exit {
   237                          caml_sys_exit
   238                                  ;; Stdlib.exit n: end the program and return to BASIC.  The exit code
   239                                  ;; n (a 15-bit OCaml int) is sign-extended to 16 bits and stored in
   240                                  ;; the SYS register storage area: low byte in C64_SAREG ("A", PEEK(780)),
   241                                  ;; high byte in C64_SXREG ("X", PEEK(781)).  The loader clears them at
   242                                  ;; start, and caml_end reloads A and X from them before returning.
   243                                  ;; ACCU = Val_int(n) = 2n + 1, so n = ACCU >> 1 (arithmetic shift).
   244                                  LDA ACCU + 1
   245                                  CMP # $80                       ;C := sign
   246                                  ROR
   247                                  STA C64_SXREG                   ;high byte of n
   248                                  LDA ACCU
   249                                  ROR
   250                                  STA C64_SAREG                   ;low byte of n
   251                                  LDX caml_hw_stack_ptr           ;Clean exit from all JSRs (see
   252                                  TXS                             ; caml_RAISE in runtime.asm)
   253                                  JMP caml_end
   254                          }
   255                          

