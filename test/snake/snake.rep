   655  0c3e 20caf1                     JSR C64_CHROUT
   656  0c41 a000                       LDY # 0
   657  0c43 b151               @pr_str LDA (@out),Y                    ;  Print the PETSCII string @out until a
   658  0c45 f00a                       BEQ +                           ;  0 is encountered. Valid strings can
   659  0c47 20caf1                     JSR C64_CHROUT                  ;  contain '\000' and non-printable
   660  0c4a c8                         INY                             ;  characters, which should be escaped;
   661  0c4b d0f6                       BNE @pr_str                     ;  here, however, we keep things short;
   662  0c4d e652                       INC @out + 1
   663  0c4f d0f2                       BNE @pr_str
   664  0c51 a922               +       LDA # $22                       ;  Print quote char;
   665  0c53 20caf1                     JSR C64_CHROUT
   666  0c56 4c5e0c                     JMP @next                       ;  Process next arg.
   667  0c59 a9a4               @under  LDA # $A4                       ; Not string: print underscore
   668  0c5b 20caf1                     JSR C64_CHROUT                  ;  then process next arg.
   669  0c5e c653               @next   DEC @count
   670  0c60 f00f                       BEQ @endl
