    14                          ;; -----------------------------------------------------------------------------
    15                          ;;                          C64.Screen - TEXT SCREEN
    16                          ;; -----------------------------------------------------------------------------
    17                          ;; Direct access to the 40x25 text screen (screen codes, not PETSCII) and to the
    18                          ;; color RAM, and cursor positioning via the Kernal. x = column (0..39),
    19                          ;; y = row (0..24); arguments are NOT checked here (the ML wrappers do it).
    20                          ;; The start of the screen RAM is taken from C64_HIBASE (page).
    21                          
    22                          !zone caml_C64_SCR {
    23                          
    24                          ;; TMP,TMP+1 := y * 40 + x      (x = Int_val(ACCU), y = Int_val(SP[0]), both < 128)
    25                          !macro caml_scr_offset {
    26                                  LDY # 0
    27                                  LDA (SP),Y
    28                                  LSR                             ;A := y   (low byte of Int_val is enough)
    29                                  STA TMP
    30                                  STY TMP + 1
    31                                  ASL TMP
    32                                  ROL TMP + 1
    33                                  ASL TMP
    34                                  ROL TMP + 1
    35                                  ASL TMP
    36                                  ROL TMP + 1                     ;TMP := y * 8
    37                                  LDA TMP
    38                                  STA TMP + 2
    39                                  LDA TMP + 1
    40                                  STA TMP + 3
    41                                  ASL TMP
    42                                  ROL TMP + 1
    43                                  ASL TMP
    44                                  ROL TMP + 1                     ;TMP := y * 32
    45                                  LDA TMP
    46                                  CLC
    47                                  ADC TMP + 2
    48                                  STA TMP
    49                                  LDA TMP + 1
    50                                  ADC TMP + 3
    51                                  STA TMP + 1                     ;TMP := y * 40
    52                                  LDA ACCU
    53                                  LSR                             ;A := x
    54                                  CLC
    55                                  ADC TMP
    56                                  STA TMP
    57                                  LDA TMP + 1
    58                                  ADC # 0
    59                                  STA TMP + 1                     ;TMP := y * 40 + x
    60                          }
    61                          ;; ACCU := screen RAM / color RAM start + TMP
    62                          !macro caml_scr_addr_screen {
    63                                  LDA TMP
    64                                  STA ACCU
    65                                  LDA TMP + 1
    66                                  CLC
    67                                  ADC C64_HIBASE
    68                                  STA ACCU + 1
    69                          }
    70                          !macro caml_scr_addr_color {
    71                                  LDA TMP
    72                                  STA ACCU
    73                                  LDA TMP + 1
    74                                  CLC
    75                                  ADC # >C64_COLRAM
    76                                  STA ACCU + 1
    77                          }
    78                          ;; A := low 8 bits of Int_val(SP[.n])   {Y = 0}
    79                          !macro caml_scr_value .n {
    80                                  LDY # .n * 2 + 1
    81                                  LDA (SP),Y
    82                                  LSR
    83                                  DEY
    84                                  LDA (SP),Y
    85                                  ROR
    86                                  LDY # 0
    87                          }
    88                          !macro caml_scr_ret_int {               ;ACCU := Val_int(A)   {Y = 0}
    89                                  STY ACCU + 1
    90                                  SEC
    91                                  ROL
    92                                  STA ACCU
    93                                  ROL ACCU + 1
    94                          }
    95                          !macro caml_scr_ret_unit {              ;{Y = 0}
    96                                  LDX # <Val_unit
    97                                  STX ACCU
    98                                  STY ACCU + 1
    99                          }
   100                          
