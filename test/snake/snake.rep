   758                          !macro  ia0 .n, .t {                            ;APPLYD n:
   759                                  +caml_range 1, .n, 3, "APPLYD n: n"	; direct self-call
   760                                  !set    caml_gen_APPLYD = 1
   761                                  LDY # 2 * .n - 1
   762                                  JSR caml_APPLYD                         ;builds the frame, then RTS
   763                                  JMP .t                                  ;enters the callee past its GRAB
   764                          }
   765                          !macro  ia1 .n, .s, .t {                        ;APPTERMD n s:
   766                                  +caml_range 1, .n, 3, "APPTERMD n s: n"	; direct self tail-call
   767                                  +caml_range .n, .s, $7F, "APPTERMD n s: s"
   768                                  !set    caml_gen_APPTRMD = 1
   769                                  LDX # 2 * (.s - .n)
   770                                  LDY # 2 * .n - 1
   771                                  JSR caml_APPTRMD
   772                                  JMP .t
   773                          }
   774                          !macro  ia2 .n, .t {                            ;APPLYG n:
   775                                  +caml_range 1, .n, 3, "APPLYG n: n"	; direct call of ACCU
   776                                  !set    caml_gen_APPLYG = 1
