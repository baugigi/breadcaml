   480                                  ;; -----------
   481                                  ;; conversions
   482                                  ;; -----------
   483                          
   484                          !ifdef caml_PRIM__caml_int32_of_int {
   485                          caml_int32_of_int
   486                                  +caml_i_stub 4, caml_i_of_int
   487                          }
