   142                          caml_IntValx3                           ;{A = v : int}
   143                                  LSR
   144                                  STA @adc + 1                    ;SMC: set arg for ADC# below
   145                                  ASL
   146                                 ;CLC
   147                          @adc    ADC # <.dummy                   ;SMC: ADC # Int_Val(v)
   148                                  RTS                             ;{A = 3 * IntVal(v), C = overflow}
   149                          }
