   607  0be1 20880c                     JSR @get_ACCU_field0            ;    && is_special_exn(Field(ACCU,0))
   608  0be4 c90a                       CMP # 1 + >caml_std_exn[caml_exn_no - 1]
   609  0be6 b008                       BCS @norm
   610  0be8 a550               @spec   LDA @fld1 + 1                   ;  then /* special exn */
   611  0bea a64f                       LDX @fld1                       ;    A:X := Field(ACCU,1)
   612  0bec a003                       LDY # 3                         ;    Y := 3
   613  0bee d00d                       BNE @pr_arg
   614  0bf0 a5fb               @norm   LDA ACCU                        ;  else /* normal exn */
