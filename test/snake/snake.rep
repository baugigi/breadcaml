     7                          !ifdef caml_PRIM__caml_nonstd_print_char {
     8                          caml_nonstd_print_char
     9  21cc 462d                       LSR ACCU + 1
    10  21ce a52c                       LDA ACCU
    11  21d0 6a                         ROR
    12  21d1 842d                       STY ACCU + 1
    13  21d3 a201                       LDX # <Val_unit
    14  21d5 862c                       STX ACCU
    15  21d7 4ccaf1                     JMP C64_CHROUT                          ;JMP = JSR+RTS
    16                          }
    17                          
    18                          !ifdef caml_PRIM__caml_nonstd_read_line {
    19                          caml_nonstd_read_line
    20                                  ;; Stdlib.read_line
    21                          @CNT    = TMP                                   ;string length
    22                          @PTR    = TMP + 2                               ;buffer pointer
    23                                  LDA # String_tag
    24                                  LDX # $FF
    25                                  JSR caml_alloc                          ;allocate buffer, addr in BLK
    26                                  LDA BLK
    27                                  STA @PTR
    28                                  LDA BLK + 1
    29                                  STA @PTR + 1                            ;init buffer pointer
    30                                  STY @CNT                                ;reset char counter
    31                                  STY @CNT + 1
    32                                  STY C64_BLNSW                           ;enable cursor blink
    33                          -       JSR C64_GETIN                           ;A:=char from keyboard; X,Y:=?
    34                                  BEQ -                                   ;no char entered
    35                                  TAX                                     ;save char in X
    36                                  CMP # $14
    37                                  BEQ @delete                             ;DELETE
    38                                  CMP # $0D
    39                                  BEQ @return                             ;RETURN
    40                                  AND # %01111111
    41                                  CMP # $20
    42                                  BCC -                                   ;NON-PRINTABLE
    43                                  LDA @CNT + 1                            ;check counter
    44                                  BEQ +                                   ;ok, cnt < 256
    45                                  LDA @CNT
    46                                  CMP # <509
    47                                  BEQ -                                   ;cnt=509, only DEL/CR admitted:
    48                          +       TXA                                     ;reload char in A
    49                                  LDY # $00                               ;(Y used by C64_GETIN)
    50                                  STA (@PTR),Y                            ;put char into the buffer
    51                                  INC @PTR                                ;increment the buffer pointer
    52                                  BNE +
    53                                  INC @PTR + 1
    54                          +       INC @CNT                                ;increment the counter
    55                                  BNE +
    56                                  INC @CNT + 1
    57                          +       JSR C64_CHROUT                          ;print char
    58                                  JMP -                                   ;process next char
    59                          @delete LDA @CNT                                ;if counter_lo = 0
    60                                  BNE +
    61                                  ORA @CNT + 1                            ;then if counter_hi = 0
    62                                  BEQ -                                   ;    then nothing to del, jmp -
    63                                  DEC @CNT + 1                            ;    else decr counter_hi;
    64                          +       DEC @CNT                                ;decr counter_lo
    65                                  LDA @PTR                                ;if pointer_lo = 0
    66                                  BNE +
    67                                  DEC @PTR + 1                            ;then decr pointer_hi
    68                          +       DEC @PTR                                ;decr pointer_lo
    69                                  TXA                                     ;reload char in A
    70                                  JSR C64_CHROUT                          ;print char
    71                                  JMP -                                   ;process next char
    72                          @return DEC C64_BLNSW                           ;disable cursor blink
    73                                  JSR C64_CHROUT                          ;print newline
    74                                  LSR @CNT + 1
    75                                  ROR @CNT                                ;counter := counter / 2
    76                                  LDY # 0
    77                                  TYA                                     ;add string padding:
    78                                  STA (@PTR),Y                            ;1st padding byte = 0
    79                                  BCS +                                   ;is counter even?
    80                                  INY
    81                                  TYA
    82                                  STA (@PTR),Y                            ;yes: 2nd padding byte = 1
    83                                  DEY                                     ;Y := 0
    84                          +       LDX @CNT
    85                                  INX                                     ;X := # words of padded string
    86                                  JSR caml_shrink_latest_alloc            ;shrink allocated block
    87                                  LDA BLK
    88                                  STA ACCU
    89                                  LDA BLK + 1
    90                                  STA ACCU + 1                            ;return string in ACCU
    91                                  RTS
    92                          }
    93                          
    94                          !ifdef caml_PRIM__caml_nonstd_print_string {
    95                          caml_nonstd_print_string
    96                                  ;; Stdlib.print_string
    97  21da a0ff                       LDY # -1
    98  21dc c62d                       DEC ACCU + 1
    99  21de b12c                       LDA (ACCU),Y                            ;get block size
   100  21e0 e62d                       INC ACCU + 1
   101  21e2 c8                         INY
   102  21e3 aa                         TAX                                     ;X := size
   103  21e4 ca                 -       DEX                                     ;X := X - 1
   104  21e5 f012                       BEQ +                                   ;Exit loop when X=0
   105  21e7 b12c                       LDA (ACCU),Y                            ;Loop: print 2 chars a time
   106  21e9 20caf1                     JSR C64_CHROUT                          ; first char
   107  21ec c8                         INY
   108  21ed b12c                       LDA (ACCU),Y
   109  21ef 20caf1                     JSR C64_CHROUT                          ; second one
   110  21f2 c8                         INY
   111  21f3 d0ef                       BNE -                                   ;Continue loop
   112  21f5 e62d                       INC ACCU + 1
   113  21f7 d0eb                       BNE -                                   ;BNE=JMP, continue loop
   114  21f9 c8                 +       INY
   115  21fa b12c                       LDA (ACCU),Y                            ;Load last byte
   116  21fc d006                       BNE +                                   ;If last byte = 0
   117  21fe 88                         DEY
   118  21ff b12c                       LDA (ACCU),Y                            ;then load previous one
   119  2201 20caf1                     JSR C64_CHROUT                          ; and print it.
   120  2204 a901               +       LDA # Val_unit
   121  2206 852c                       STA ACCU
   122  2208 a000                       LDY # 0
   123  220a 842d                       STY ACCU + 1                            ;ACCU := Val_unit
   124  220c 60                         RTS
   125                          }
   126                          
   127                          }       ;; !zone caml_IO
