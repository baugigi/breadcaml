   236                          
   237                                  ;; BASIC Floating point routines
   238                                  ;; Note: A:Y stands for a 16-bit value, A=hi byte, Y=lo byte
   239                                  
   240                                  ;; BEWARE: All routines affected by the well-known MULTIPLY BUG
   241                                  ;; (https://www.c64-wiki.com/wiki/Multiply_bug) are marked with [!]
   242                          
   243                                  ;; Movement
   244                          C64_MOVFM       = $BBA2 ;Load FAC from MEM (Y:A). Returns Y=0,A=exp,fl=exp.
   245                          C64_CONUPK      = $BA8C ;Load ARG from MEM (Y:A), set ARISIGN and A:=FAC exp.
   246                          C64_MOVAF       = $BC0C ;Copy (rounded) FAC to ARG.
   247                          C64_MOVMF       = $BBD4 ;Copy (rounded) FAC to MEM (Y:X). Returns A=FAC exp.
   248                          C64_MOVEF       = $BC0F ;Copy FAC to ARG without rounding. 
   249                          C64_MOVFA       = $BBFC ;Copy ARG to FAC
   250                                  ;; Basic Arithmetic
   251                          C64_FADD        = $B867 ;FAC := MEM (Y:A) + FAC 
   252                          C64_FADDT       = $B86A ;FAC := ARG + FAC
   253                          C64_FSUB        = $B850 ;FAC := MEM (Y:A) - FAC 
   254                          C64_FSUBT       = $B853 ;FAC := ARG - FAC
   255                          C64_FMUL        = $BA28 ;[!] FAC := MEM (Y:A) * FAC 
   256                          C64_FMULT       = $BA2B ;[!] FAC := ARG * FAC
   257                          C64_MUL10       = $BAE2 ;Quickly multiply the float held in FAC by 10.
   258                          C64_FDIV        = $BB0F ;FAC := MEM (Y:A) / FAC, ARG := remainder.
   259                          C64_FDIVT       = $BB12 ;FAC := ARG / FAC, ARG := remainder
   260                          C64_DIV10       = $BAFE ;FAC := ABS(FAC / 10).
   261                          C64_NEGOP       = $BFB4 ;Switch sign on the float in FAC, if non-zero
   262                                  ;; Trigonometry
   263                          C64_SIN         = $E26B ;[!] Perform the SIN function on the float in FAC
   264                          C64_COS         = $E264 ;[!] Perform the COS function on the float in FAC
   265                          C64_TAN         = $E2B4 ;[!] Perform the TAN function on the float in FAC
   266                          C64_ATN         = $E30E ;[!] Perform the ATN function on the float in FAC
   267                                  ;; Logarithms
   268                          C64_LOG         = $B9EA ;[!] FAC := ln FAC
   269                          C64_EXP         = $BFED ;[!] FAC := e ^ FAC
   270                          C64_FPWR        = $BF78 ;[!] FAC := MEM (Y:A) ^ FAC.
   271                          C64_FPWRT       = $BF7B ;[!] FAC := ARG ^ FAC.
   272                          C64_SQR         = $BF71 ;[!] FAC := FAC ^ 0.5
   273                          C64_SQRARG      = $BF74 ;[!] FAC := ARG ^ 0.5
   274                                  ;; Other functions
   275                          C64_FADDH       = $B849 ;Add .5 to FAC
   276                          C64_SIGN        = $BC2B ;Sets flags N,Z depending on whether FAC is 0, + or -.
   277                          C64_ABS         = $BC58 ;Perform the ABS function on the float in FAC
   278                          C64_INT         = $BCCC ;Perform the INT function on the float in FAC
   279                          C64_FCOMP       = $BC5B ;Compare FAC and MEM (Y:A). A = 0 (=), 1 (>), -1 (<).
   280                                  ;; Type Conversion
   281                          C64_FOUT        = $BDDD ;Convert float in FAC to a string at $100 (also in Y:A)
   282                          C64_STRVAL      = $B7B5 ;Convert a string ($22/$23, A=length) to float in FAC.  
