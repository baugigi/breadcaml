     5                           !source "/home/pifu/.opam/LTS/lib/bcaml/stdlib_aux_tools.asm"

; ******** Source: /home/pifu/.opam/LTS/lib/bcaml/stdlib_aux_tools.asm
     1                          ;;; -----------------------------------------------------------
     2                          ;;;     AUXILIARY TOOLS
     3                          ;;; -----------------------------------------------------------
     4                          
     5                          !zone AUX_TOOLS {
     6                                  
     7                          !ifdef caml_PRIM__caml_memcpy {
     8                                  ;; copy memory
     9                                  ;; TMP, TMP + 1 =  source start address
    10                                  ;; TMP + 2, TMP + 3 = destination start address
    11                                  ;; TMP + 4, TMP + 5 = number of bytes to move
    12                                  ;; used registers: A, X, Y; return Y = 0.
    13                          caml_memcpy
    14                                  @FROM = TMP                     ;source address
    15                                  @TO = TMP + 2                   ;destination address
    16                                  @NUM = TMP + 4                  ;num bytes
    17  216c a546                       LDA @FROM + 1
    18  216e c548                       CMP @TO + 1
    19  2170 902e                       BCC @caml_memcpy_up
    20  2172 d009                       BNE @caml_memcpy_dn
    21  2174 a545                       LDA @FROM
    22  2176 c547                       CMP @TO
    23  2178 9026                       BCC @caml_memcpy_up
    24  217a d001                       BNE @caml_memcpy_dn
    25  217c 60                         RTS
    26                                  ;; copy memory from a higher address to a lower one
    27                          @caml_memcpy_dn
    28  217d a000                       LDY # 0
    29  217f a64a                       LDX @NUM + 1
    30  2181 f00e                       BEQ +
    31  2183 b145               -       LDA (@FROM),Y                   ;move a page at a time
    32  2185 9147                       STA (@TO),Y
    33  2187 c8                         INY
    34  2188 d0f9                       BNE -
    35  218a e646                       INC @FROM + 1
    36  218c e648                       INC @TO + 1
    37  218e ca                         DEX
    38  218f d0f2                       BNE -
    39  2191 a649               +       LDX @NUM
    40  2193 f008                       BEQ +
    41  2195 b145               -       LDA (@FROM),Y                   ;move the remaining bytes
    42  2197 9147                       STA (@TO),Y
    43  2199 c8                         INY
    44  219a ca                         DEX
    45  219b d0f8                       BNE -
    46  219d a000               +       LDY # 0
    47  219f 60                         RTS
    48                                  ;; copy memory from a lower address to a higher one
    49                          @caml_memcpy_up
    50  21a0 a64a                       LDX @NUM + 1                    ;the last byte must be moved first
    51  21a2 18                         CLC                             ;start at the final pages of from & to
    52  21a3 8a                         TXA
    53  21a4 6546                       ADC @FROM + 1
    54  21a6 8546                       STA @FROM + 1
    55  21a8 18                         CLC
    56  21a9 8a                         TXA
    57  21aa 6548                       ADC @TO + 1
    58  21ac 8548                       STA @TO + 1
    59  21ae e8                         INX                             ;allows use of bne after dex below
    60  21af a449                       LDY @NUM
    61  21b1 f00e                       BEQ ++
    62  21b3 88                         DEY                             ;move bytes on the last page first
    63  21b4 f007                       BEQ +
    64  21b6 b145               -       LDA (@FROM),Y
    65  21b8 9147                       STA (@TO),Y
    66  21ba 88                         DEY
    67  21bb d0f9                       BNE -
    68  21bd b145               +       LDA (@FROM),Y                   ;handle y = 0 separately
    69  21bf 9147                       STA (@TO),Y
    70  21c1 88                 ++      DEY
    71  21c2 c646                       DEC @FROM + 1                   ;move the next page (if any)
    72  21c4 c648                       DEC @TO + 1
    73  21c6 ca                         DEX
    74  21c7 d0ed                       BNE -
    75  21c9 a000                       LDY # 0
    76  21cb 60                         RTS
    77                          }
    78                          
    79                          !ifdef  caml_PRIM__caml_blkcpy {
    80                                  ;; caml_blkcpy
    81                                  ;; Aux. routine to copy all fields from ACCU to BLK; C:Y = 2 * size.
    82                                  ;; The block's header is not copied!
    83                          caml_blkcpy
    84                                  BCC +                           ; less than 256 bytes (<128 fields)
    85                                  BEQ ++                          ; exactly 256 bytes   (=128 fields)
    86                                  INC ACCU + 1                    ; more than 256 bytes (>128 fields)
    87                                  INC BLK + 1
    88                          --
    89                          +       DEY
    90                          -       LDA (ACCU),Y
    91                                  STA (BLK),Y
    92                                  DEY
    93                                  BNE -
    94                                  LDA (ACCU),Y                    ; handle Y = 0 apart
    95                                  STA (BLK),Y
    96                                  BCC +
    97                                  DEC ACCU + 1
    98                                  DEC BLK + 1
    99                          ++      CLC
   100                                  BCC --
   101                          +       RTS
   102                          }
   103                          
   104                          }       ;; !zone AUX_TOOLS
   105                          

