   223                                  ;; BASIC Floating point routines
   224                          	;; BEWARE: MULTIPLY BUG! See https://www.c64-wiki.com/wiki/Multiply_bug
   225                          
   226                                  ;; Movement
   227                          C64_MOVFM       = $BBA2 ;Load FAC from MEM (A/Y). Returns Y=0,A=exp,fl=exp.
   228                          C64_CONUPK      = $BA8C ;Load ARG from MEM (A/Y), set ARISIGN and A:=FAC exp.
   229                          C64_MOVAF       = $BC0C ;Copy (rounded) FAC to ARG.
   230                          C64_MOVMF       = $BBD4 ;Copy (rounded) FAC to MEM (X/Y). Returns A=FAC exp.
   231                          C64_MOVEF       = $BC0F ;Copy FAC to ARG without rounding. 
   232                          C64_MOVFA       = $BBFC ;Copy ARG to FAC
   233                                  ;; Basic Arithmetic
   234                          C64_FADD        = $B867 ;FAC := MEM (A/Y) + FAC 
   235                          C64_FADDT       = $B86A ;FAC := ARG + FAC
   236                          C64_FSUB        = $B850 ;FAC := MEM (A/Y) - FAC 
   237                          C64_FSUBT       = $B853 ;FAC := ARG - FAC
   238                          C64_FMUL        = $BA28 ;FAC := MEM (A/Y) * FAC 
   239                          C64_FMULT       = $BA2B ;FAC := ARG * FAC
   240                          C64_MUL10       = $BAE2 ;Quickly multiply the float held in FAC by 10.
   241                          C64_FDIV        = $BB0F ;FAC := MEM (A/Y) / FAC, ARG := remainder.
   242                          C64_FDIVT       = $BB12 ;FAC := ARG / FAC, ARG := remainder
   243                          C64_DIV10       = $BAFE ;FAC := ABS(FAC / 10).
   244                          C64_NEGOP       = $BFB4 ;Switch sign on the float in FAC, if non-zero
