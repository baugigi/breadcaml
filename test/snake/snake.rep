   616  0bf3 6902                       ADC # 2                         ;    start from field 1
   617  0bf5 aa                         TAX
   618  0bf6 a5fc                       LDA ACCU + 1
   619  0bf8 6900                       ADC # 0
   620  0bfa a451                       LDY @sz    
   621  0bfc 88                         DEY                             ;    Y := size(ACCU) - 1
   622                          
   623  0bfd 8550               @pr_arg STA @arg + 1                    ;Print all args:
   624  0bff 864f                       STX @arg
