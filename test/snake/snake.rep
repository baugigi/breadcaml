; ******** Source: /home/pifu/.opam/LTS/lib/bcaml/stdlib.asm
     4                           !source "/home/pifu/.opam/LTS/lib/bcaml/stdlib_arrays.asm"

; ******** Source: /home/pifu/.opam/LTS/lib/bcaml/stdlib_arrays.asm
     1                          ;; ----------------------------------------------------------------------
     2                          ;; ARRAYS (ocaml-4.14.4/runtime/array.c)
     3                          ;; ----------------------------------------------------------------------
     4                          !zone caml_ARRAYS {
     5                          
     6                          !ifndef caml_arrays_warn {
     7                          caml_arrays_warn
     8                            !warn "TODO: caml_array_fill"
     9                            !warn "TODO: caml_floatarray_blit"
    10                            !warn "TODO: check for GC-invalidated pointers"
    11                          }
    12                          	
    13                          !ifdef caml_PRIM__caml_make_vect {
    14                          caml_make_vect
    15                                  ;; allocate and initialize an array
    16                                  ;; ACCU = length
    17                                  ;; SP[0] = init
    18                          @NFLO2  = TMP
    19                          @INIT   = TMP + 2
    20                                  ;; load init
    21                                  INY
    22                                  LDA (SP),Y
    23                                  STA @INIT + 1
    24                                  DEY
    25                                  LDA (SP),Y
    26                                  STA @INIT
    27                                  ;; is init a block?
    28                                  BIT caml_is_block                       ; test @INIT
    29                                  BNE @no_float_array
    30                                  ;; tag(init) = Double_tag?
    31                                  LDY # -2
    32                                  DEC @INIT + 1
    33                                  LDA (@INIT),Y
    34                                  INC @INIT + 1
    35                                  LDY # 0
    36                                  CMP # Double_tag
    37                                  BNE @no_float_array
    38                          ;;      ;; is init in heap?
    39                          ;;      SEC
    40                          ;;      LDA @INIT
    41                          ;;      SBC # < caml_heap_start
    42                          ;;      STA TMP
    43                          ;;      LDA @INIT + 1
    44                          ;;      SBC # > caml_heap_start
    45                          ;;      STA TMP + 1
    46                          ;;      LDA TMP
    47                          ;;      CMP # < caml_heap_sz
    48                          ;;      LDA TMP + 1
    49                          ;;      SBC # > caml_heap_sz
    50                          ;;      BCS @no_float_array
    51                                  ;; allocate float array 
    52                                  JSR caml_floatarray_create
    53                                  ;; init floats
    54                                  LDA @NFLO2                      ; see caml_floatarray_create
    55                                  LSR
    56                                  TAX                             ; X = no. of floats
    57                          ;       CLC
    58                          -       +caml_move_float @INIT, BLK
    59                                  LDA # < (2 * Double_wosize)
    60                                  ADC BLK
    61                                  STA BLK
    62                                  LDA # > (2 * Double_wosize)
    63                                  ADC BLK + 1
    64                                  STA BLK + 1
    65                                  DEX
    66                                  BNE -
    67                                  RTS
    68                          @no_float_array
    69                                  ;; check length
    70                                  LSR ACCU + 1
    71                                  BNE @error
    72                                  LDA ACCU
    73                                  ROR
    74                                  BNE +
    75                                  ;; length = 0, empty array
    76                                  LDA # < caml_atom0
    77                                  STA ACCU
    78                                  LDA # > caml_atom0
    79                                  STA ACCU + 1
    80                                  RTS
    81                                  ;; length > 0, allocate array
    82                          +       TAX                             ; size
    83                                  TYA                             ; tag = 0
    84                                  JSR caml_alloc
    85                                  LDA BLK
    86                                  STA ACCU
    87                                  LDA BLK + 1
    88                                  STA ACCU + 1
    89                                  ;; init fields
    90                          -       LDA @INIT
    91                                  STA (BLK),Y
    92                                  INY
    93                                  LDA @INIT + 1
    94                                  STA (BLK),Y
    95                                  INY
    96                                  BNE +
    97                                  INC BLK + 1
    98                          +       DEX
    99                                  BNE -
   100                                  LDY # 0
   101                                  RTS
   102                          @error  +caml_raise Invalid_argument, "Array.make"
   103                          }
   104                          
   105                          !ifdef caml_PRIM__caml_floatarray_create {
   106                                  ;; allocate an array of floats
   107                                  ;; ACCU = length
   108                          caml_floatarray_create
   109                          @NFLO2  = TMP                   ; see caml_make_vect
   110                                  LDA ACCU + 1
   111                                  BNE @error
   112                                  LDA ACCU
   113                                  ;; exn if 3 * index > 255
   114                                  AND # $FE
   115                                  BNE +
   116                                  ;; length = 0, empty array
   117                                  LDA # < caml_atom0
   118                                  STA ACCU
   119                                  LDA # > caml_atom0
   120                                  STA ACCU + 1
   121                                  RTS
   122                                  ;; length > 0, size is length * 3
   123                          +       STA @NFLO2
   124                                  LSR
   125                          ;       CLC                             ;implicit
   126                                  ADC @NFLO2
   127                                  BCS @error
   128                                  ;; allocate array of floats
   129                                  TAX                             ; size
   130                                  LDA # Double_array_tag          ; tag
   131                                  JSR caml_alloc
   132                                  LDA BLK
   133                                  STA ACCU
   134                                  LDA BLK + 1
   135                                  STA ACCU + 1
   136                                  RTS
   137                          @error  +caml_raise Invalid_argument, "Float.Array.create"
   138                          }
   139                          
   140                          !ifdef caml_PRIM__caml_make_array {
   141                                  ;; if init is a block of floats, unbox all elements
   142                                  ;; ACCU = init
   143                          caml_make_array
   144                          @FIELD0 = TMP
   145                          @NFLOATS= TMP + 2
   146                                  ;; exit if size(init) = 0
   147                                  LDA # >caml_atom0
   148                                  CMP ACCU + 1
   149                                  BNE +
   150                                  LDA # <caml_atom0
   151                                  CMP ACCU
   152                                  BEQ @exit
   153                                  ;; exit if Field(init,0) is not a block
   154                          +       INY
   155                                  LDA (ACCU),Y
   156                                  STA @FIELD0
   157                                  INY
   158                                  LDA (ACCU),Y
   159                                  STA @FIELD0 + 1
   160                                  BIT caml_is_block                       ; test @FIELD0
   161                                  BNE @exit
   162                          ;;      ;; exit if Field(init,0) is out of heap
   163                          ;;      SEC
   164                          ;;      LDA @FIELD0
   165                          ;;      SBC # < caml_heap_start
   166                          ;;      STA TMP
   167                          ;;      LDA @FIELD0 + 1
   168                          ;;      SBC # > caml_heap_start
   169                          ;;      STA TMP + 1
   170                          ;;      LDA TMP
   171                          ;;      CMP # < caml_heap_sz
   172                          ;;      LDA TMP + 1
   173                          ;;      SBC # > caml_heap_sz
   174                          ;;      BCS @exit
   175                                  ;; exit if tag(Field(init,0)) <> Double_tag
   176                                  LDY # -2
   177                                  DEC @FIELD0 + 1
   178                                  LDA (@FIELD0),Y
   179                                  CMP # Double_tag
   180                                  BEQ +
   181                                  LDY # 0
   182                          @exit   RTS
   183                                  ;; check length
   184                          +       INY
   185                                  DEC ACCU + 1
   186                                  LDA (ACCU),Y
   187                          ;       inc ACCU + 1
   188                                  INY
   189                                  CMP # 255 DIV Double_wosize + 1
   190                                  BCC +
   191                                  +caml_raise Out_of_memory
   192                                  ;; size is lenght * 3
   193                          +       STA @NFLOATS
   194                                  ASL
   195                          ;       clc
   196                                  ADC @NFLOATS
   197                                  ;; allocate array of floats
   198                                  TAX
   199                                  LDA # Double_array_tag
   200                                  JSR caml_alloc
   201                                  LDA BLK
   202                                  STA ACCU
   203                                  LDA BLK + 1
   204                                  STA ACCU + 1
   205                                  ;; init fields
   206                                  INC @FIELD0 + 1                 ; previously dec'ed
   207                          -       +caml_move_float @FIELD0, BLK
   208                                  DEX
   209                                  BEQ @exit
   210                                  INC @FIELD0
   211                                  INC @FIELD0
   212                                  BNE +
   213                                  INC @FIELD0 + 1
   214                          +       INC BLK
   215                                  INC BLK
   216                                  BNE -
   217                                  INC BLK + 1
   218                                  JMP -
   219                          }
   220                          
   221                          !ifdef caml_PRIM__caml_array_get {
   222                          caml_array_get
   223                                  ;; return an array element
   224                                  ;; ACCU = array
   225                                  ;; SP[0] = index
   226                          
   227                                  ;; load tag
   228                                  LDY # -2
   229                                  DEC ACCU + 1
   230                                  LDA (ACCU),Y
   231                                  INY
   232                                  ;; check if float
   233                                  CMP # Double_array_tag
   234                                  BNE caml_array_get_addr__loadsize
   235                                  JMP caml_floatarray_get__loadsize
   236                          }
   237                          
   238                          !ifdef caml_PRIM__caml_array_get_addr {
   239                                  ;; return an array element (no-float version)
   240                                  ;; ACCU = array
   241                                  ;; SP[0] = index
   242                          caml_array_get_addr
   243                                  DEY
   244                                  DEC ACCU + 1
   245                          caml_array_get_addr__loadsize
   246                                  LDA (ACCU),Y
   247                                  STA TMP                                 ; TMP := size
   248                                  INC ACCU + 1                            ; restore ptr to Field(0)
   249                                  LDY # 1
   250                                  LDA (SP),Y                              ; load index, hi
   251                                  LSR
   252                                  BNE @error                              ; exn if index>255 or index<0
   253                                  BCC +
   254                                  INC ACCU + 1                            ; inc ACCU if index > 127
   255                          +       DEY
   256                                  LDA (SP),Y                              ; load index, lo
   257                                  TAY                                     ; now ACCU+Y points to elt, hi
   258                                  ROR
   259                                  CMP TMP
   260                                  BCS @error                              ; exn if index >= size
   261                                  LDA (ACCU),Y                            ; get array elt, hi
   262                                  TAX
   263                                  DEY
   264                                  LDA (ACCU),Y                            ; get array elt, lo
   265                                  STA ACCU                                ; ACCU <- array[index]
   266                                  STX ACCU + 1
   267                                  LDY # 0
   268                                  RTS
   269                          @error  +caml_raise Invalid_argument, "index out of bounds"
   270                          }
   271                          
   272                          !ifdef caml_PRIM__caml_floatarray_get {
   273                                  ;; return an array element (floatarray version)
   274                                  ;; ACCU = array
   275                                  ;; SP[0] = index
   276                          caml_floatarray_get
   277                                  ;; load size
   278                                  DEY
   279                                  DEC ACCU + 1
   280                          caml_floatarray_get__loadsize
   281                          @SZ     = TMP
   282                          @IDX    = TMP + 1
   283                                  LDA (ACCU),Y
   284                                  STA @SZ
   285                                  INC ACCU + 1
   286                                  ;; load index, hi
   287                                  LDY # 1
   288                                  LDA (SP),Y
   289                                  BEQ +
   290                                  ;; exn if hi > 0
   291                                  JMP @error
   292                                  ;; load index, lo
   293                          +       DEY
   294                                  LDA (SP),Y
   295                                  ;; exn if 3 * index >= size
   296                                  AND # $FE
   297                                  BEQ +
   298                                  STA @IDX
   299                                  LSR
   300                                  ;CLC
   301                                  ADC @IDX
   302                                  BCS @error
   303                                  CMP @SZ
   304                                  BCS @error
   305                                  ;; ACCU <- &array[index]
   306                          +       ASL
   307                                  BCC +
   308                                  INC ACCU + 1
   309                                  CLC
   310                          +       ADC ACCU
   311                                  STA ACCU
   312                                  BCC +
   313                                  INC ACCU + 1
   314                                  ;; allocate float
   315                          +       LDA # Double_tag
   316                                  LDX # Double_wosize
   317                                  JSR caml_alloc
   318                                  ;; copy float
   319                                  +caml_move_float ACCU, BLK
   320                                  ;; return float
   321                                  LDA BLK
   322                                  STA ACCU
   323                                  LDA BLK + 1
   324                                  STA ACCU + 1
   325                                  RTS
   326                          @error  +caml_raise Invalid_argument, "index out of bounds"
   327                          }
   328                          
   329                          !ifdef caml_PRIM__caml_array_unsafe_get {
   330                          caml_array_unsafe_get
   331                                  ;; return an array element (unsafe version)
   332                                  ;; ACCU = array
   333                                  ;; SP[0] = index
   334                                  LDY # -2
   335                                  DEC ACCU + 1
   336                                  LDA (ACCU),Y                            ; load tag
   337                                  INC ACCU + 1                            ; restore ptr
   338                                  LDY # 0
   339                                  CMP # Double_array_tag                  ; check if float
   340                                  BEQ caml_floatarray_unsafe_get         ; yes: special case
   341                                  LDA (SP),Y                              ; Val_int(index), lo
   342                                  STA TMP
   343                                  INY
   344                                  LDA (SP),Y                              ; Val_int(index), hi
   345                                  BEQ +
   346                                  INC ACCU + 1
   347                          +       LDY TMP
   348                                  ;; get array element
   349                                  LDA (ACCU),Y                            ; array[index], hi
   350                                  TAX
   351                                  DEY
   352                                  LDA (ACCU),Y                            ; array[index], lo
   353                                  STA ACCU
   354                                  STX ACCU + 1
   355                                  LDY # 0
   356                                  RTS
   357                          }
   358                          
   359                          !ifdef caml_PRIM__caml_floatarray_unsafe_get {
   360                                  ;; return an array element (unsafe, floatarray version)
   361                                  ;; ACCU = array
   362                                  ;; SP[0] = index
   363                          caml_floatarray_unsafe_get
   364                                  ;; load index, lo (ignore hi byte)
   365                                  LDA (SP),Y                      ; 2*i+1
   366                                  ;; calc 3 * i
   367                                  AND # $FE
   368                                  STA TMP
   369                                  LSR
   370                                  CLC
   371                                  ADC TMP
   372                                  ;; ACCU <- &array[index]
   373                                  ASL
   374                                  BCC +
   375                                  INC ACCU + 1
   376                                  CLC
   377                          +       ADC ACCU
   378                                  STA ACCU
   379                                  BCC +
   380                                  INC ACCU + 1
   381                                  ;; allocate float
   382                          +       LDA # Double_tag
   383                                  LDX # Double_wosize
   384                                  JSR caml_alloc
   385                                  ;; copy float
   386                                  +caml_move_float ACCU, BLK
   387                                  ;; return float
   388                                  LDA BLK
   389                                  STA ACCU
   390                                  LDA BLK + 1
   391                                  STA ACCU + 1
   392                                  RTS
   393                          }
   394                          
   395                          !ifdef caml_PRIM__caml_array_set {
   396                          caml_array_set
   397                                  ;; set an array element to given value
   398                                  ;; ACCU = array
   399                                  ;; SP[0] = index
   400                                  ;; SP[1] = newval
   401                          
   402                                  ;; load tag
   403                                  LDY # -2
   404                                  DEC ACCU + 1
   405                                  LDA (ACCU),Y
   406                                  INY
   407                                  ;; check if float
   408                                  CMP # Double_array_tag
   409                                  BNE caml_array_set_addr__loadsize
   410                                  JMP caml_floatarray_set__loadsize
   411                          }
   412                          
   413                          !ifdef caml_PRIM__caml_array_set_addr {
   414                                  ;; set an array element to given value (no-float version)
   415                                  ;; ACCU = array
   416                                  ;; SP[0] = Val_int(index)
   417                                  ;; SP[1] = newval
   418                          caml_array_set_addr
   419                                  ;; load size
   420                                  DEY
   421                                  DEC ACCU + 1
   422                          caml_array_set_addr__loadsize
   423                          @SZ     = TMP
   424                          @NEW    = TMP + 1
   425                                  LDA (ACCU),Y
   426                                  STA @SZ
   427                                  INC ACCU + 1
   428                                  ;; load newval
   429                                  LDY # 3
   430                                  LDA (SP),Y
   431                                  STA @NEW + 1
   432                                  DEY
   433                                  LDA (SP),Y
   434                                  STA @NEW
   435                                  ;; load index, hi
   436                                  DEY
   437                                  LDA (SP),Y
   438                                  ;; exn if index > 255 or index < 0
   439                                  LSR
   440                                  BNE @error
   441                                  ;; load index, lo
   442                                  DEY
   443                                  LDA (SP),Y
   444                                  ROR
   445                                  ;; exn if index >= size
   446                                  CMP @SZ
   447                                  BCS @error
   448                                  ;; array[index] <- newval
   449                                  ASL
   450                                  BCC +
   451                                  INC ACCU + 1
   452                          +       TAY
   453                                  LDA @NEW
   454                                  STA (ACCU),Y
   455                                  INY
   456                                  LDA @NEW + 1
   457                                  STA (ACCU),Y
   458                                  ;; ACCU <- ()
   459                                  LDY # <Val_unit                 ;.Y := 1
   460                                  STY ACCU
   461                                  DEY
   462                                  STY ACCU + 1
   463                                  RTS
   464                          @error  +caml_raise Invalid_argument, "index out of bounds"
   465                          }
   466                          
   467                          !ifdef caml_PRIM__caml_floatarray_set {
   468                                  ;; set an array element to given value (floatarray version)
   469                                  ;; ACCU = array
   470                                  ;; SP[0] = index
   471                                  ;; SP[1] = newval
   472                          caml_floatarray_set
   473                                  ;; load size
   474                                  DEY
   475                                  DEC ACCU + 1
   476                          caml_floatarray_set__loadsize
   477                          @SZ     = TMP
   478                          @IDX    = TMP + 1
   479                          @NEW    = TMP + 2
   480                                  LDA (ACCU),Y
   481                                  STA @SZ
   482                                  INC ACCU + 1
   483                                  ;; load newval
   484                                  LDY # 3
   485                                  LDA (SP),Y
   486                                  STA @NEW + 1
   487                                  DEY
   488                                  LDA (SP),Y
   489                                  STA @NEW
   490                                  ;; load index, hi
   491                                  DEY
   492                                  LDA (SP),Y
   493                                  ;; exn if hi > 0
   494                                  BNE @error
   495                                  ;; load index, lo
   496                                  DEY
   497                                  LDA (SP),Y
   498                                  ;; exn if 3 * index >= size
   499                                  AND # $FE
   500                                  STA @IDX
   501                                  LSR
   502                                  CLC
   503                                  ADC @IDX
   504                                  BCS @error
   505                                  CMP @SZ
   506                                  BCS @error
   507                                  ;; ACCU <- &array[index]
   508                          +       ASL
   509                                  BCC +
   510                                  INC ACCU + 1
   511                                  CLC
   512                          +       ADC ACCU
   513                                  STA ACCU
   514                                  BCC +
   515                                  INC ACCU + 1
   516                                  ;; copy float
   517                          +       +caml_move_float @NEW, ACCU
   518                                  ;; ACCU <- ()
   519                                  STY ACCU + 1
   520                                  INY
   521                                  STY ACCU
   522                                  DEY
   523                                  RTS
   524                          @error  +caml_raise Invalid_argument, "index out of bounds"
   525                          }
   526                          
   527                          !ifdef caml_PRIM__caml_array_unsafe_set {
   528                          caml_array_unsafe_set
   529                                  ;; set an array element to given value (unsafe version)
   530                                  ;; ACCU = array
   531                                  ;; SP[0] = index
   532                                  ;; SP[1] = newval
   533                          
   534                                  ;; load tag
   535                                  LDY # -2
   536                                  DEC ACCU + 1
   537                                  LDA (ACCU),Y
   538                                  INC ACCU + 1
   539                                  LDY # 0
   540                                  ;; check if float
   541                                  CMP # Double_array_tag
   542                                  BEQ caml_floatarray_unsafe_set
   543                                  ;; FALLTHROUGH caml_array_unsafe_set_addr
   544                          }
   545                          
   546                          !ifdef caml_PRIM__caml_array_unsafe_set_addr {
   547                                  ;; set an array element to given value (unsafe, no-float version)
   548                                  ;; ACCU = array
   549                                  ;; SP[0] = index
   550                                  ;; SP[1] = newval
   551                          caml_array_unsafe_set_addr
   552                                  ;; load index
   553                                  LDA (SP),Y                      ; Val_int(index), lo
   554                                  STA TMP
   555                                  INY
   556                                  LDA (SP),Y                      ; Val_int(index), hi
   557                                  BEQ +
   558                                  INC ACCU + 1
   559                                  ;; load newval
   560                          +       INY
   561                                  LDA (SP),Y
   562                                  TAX
   563                                  INY
   564                                  LDA (SP),Y
   565                                  ;; array[index] <- newval
   566                                  LDY TMP
   567                                  STA (ACCU),Y
   568                                  DEY
   569                                  TXA
   570                                  STA (ACCU),Y
   571                                  ;; ACCU <- ()
   572                                  LDY # <Val_unit                 ;.Y := 1
   573                                  STY ACCU
   574                                  DEY
   575                                  STY ACCU + 1
   576                                  RTS
   577                          }
   578                          
   579                          !ifdef caml_PRIM__caml_floatarray_unsafe_set {
   580                                  ;; set an array element to given value (unsafe, floatarray version)
   581                                  ;; ACCU = array
   582                                  ;; SP[0] = index
   583                                  ;; SP[1] = newval
   584                          caml_floatarray_unsafe_set
   585                                  ;; load index, lo (ignore hi byte)
   586                                  LDA (SP),Y                      ; 2*i+1
   587                                  ;; calc 3 * i
   588                                  AND # $FE
   589                                  STA TMP
   590                                  LSR
   591                                  CLC
   592                                  ADC TMP
   593                                  ;; ACCU <- &array[index]
   594                                  ASL
   595                                  BCC +
   596                                  INC ACCU + 1
   597                                  CLC
   598                          +       ADC ACCU
   599                                  STA ACCU
   600                                  BCC +
   601                                  INC ACCU + 1
   602                                  ;; load newval
   603                          +       LDY # 2
   604                                  LDA (SP),Y
   605                                  STA TMP
   606                                  INY
   607                                  LDA (SP),Y
   608                                  STA TMP + 1
   609                                  ;; copy float
   610                                  +caml_move_float TMP, ACCU
   611                                  ;; ACCU <- ()
   612                                  LDA # <Val_unit
   613                                  STA ACCU
   614                                  STY ACCU + 1                    ; Y = 0
   615                                  RTS
   616                          }
