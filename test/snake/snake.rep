   199                                  BCC @fin
   200                                  LDX # Fu_LOG
   201                                  JMP caml_float_special1
   202                          @fin    LDA # <C64_ONE
   203                                  LDY # >C64_ONE
   204                                  +caml_JSR_BASROM C64_FADD
