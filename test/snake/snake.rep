    49                                  SBC # 2 * .w
    50                                  STA SP
    51                                  BCS +
    52                                  DEC SP + 1
    53                                  LDA SP + 1
    54                                  CMP # >caml_stack_start
    55                                  BCS +
    56                                  JMP caml_stack_overflow
    57                          + }}
