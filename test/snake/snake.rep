   627  0c05 20caf1                     JSR C64_CHROUT
   628  0c08 a000               @loop   LDY # 0                         ;Loop on all args:
   629  0c0a b14f                       LDA (@arg),Y
   630  0c0c aa                         TAX
   631  0c0d c8                         INY
   632  0c0e 2cd709                     BIT caml_is_block
   633  0c11 f01c                       BEQ @block
   634  0c13 b14f                       LDA (@arg),Y
