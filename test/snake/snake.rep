   250  870d 4a                         LSR
   251  870e aa                         TAX
   252  870f 88                         DEY
   253  8710 b1fd                       LDA (SP),Y                      ; <soft
   254  8712 6a                         ROR
   255  8713 18                         CLC
   256  8714 65fb                       ADC ACCU
   257  8716 854d                       STA @FROM                       ; FROM := <(src + int_val(sofs))
   258  8718 a8                         TAY
   259  8719 8a                         TXA
   260  871a 65fc                       ADC ACCU + 1
   261  871c 854e                       STA @FROM + 1                   ; FROM+1 := >(src+int_val(sofs))
   262  871e 200d7f                     JSR caml_memcpy                 ; ok, even if src & dest overlap
   263  8721 a001                       LDY # <Val_unit
   264  8723 84fb                       STY ACCU
   265  8725 88                         DEY
   266  8726 84fc                       STY ACCU + 1
   267  8728 60                         RTS
   268                          }
   269                          
   270                          !ifdef caml_PRIM__caml_nonstd_string_of_float {
   271                          caml_nonstd_string_of_float
   272                                  ;; Stdlib.string_of_float
   273                                  LDA ACCU
   274                                  LDX ACCU + 1
   275                                  STA caml_float_loadFAC__addr
   276                                  STX caml_float_loadFAC__addr + 1
   277                                  JSR caml_float_loadFAC          ;.A = flag byte
   278                                  BEQ @fin
   279                                  LDX # 0                         ;Special value: copy "-inf", "inf" or
   280                                  CMP # Fl_ninf                   ; "nan" to $0100 instead of calling
   281                                  BEQ @cp                         ; FOUT.
   282                                  INX
   283                                  CMP # Fl_pinf
   284                                  BEQ @cp
   285                                  LDX # @nan - @strs
   286                          @cp     LDY # 0
   287                          -       LDA @strs,X
   288                                  STA $0100,Y
   289                                  BEQ @len                        ;(copy the final 0 too)
   290                                  INX
   291                                  INY
   292                                  BNE -                           ;BNE=JMP
   293                          @fin    LDA $47                         ;WARNING: FOUT OVERWRITES $47
   294                                  PHA                             ;save it
   295                                  +caml_JSR_BASROM C64_FOUT       ;0-terminated string in $0100
   296                                  PLA                             ;restore $47 value
   297                                  STA $47
   298                          @len    JMP caml_string_from_0100
   299                          @strs   !text "-inf", 0                 ;"inf" is @strs + 1
   300                          @nan    !text "nan", 0
   301                          }
   302                          
   303                          !ifdef caml_PRIM__caml_nonstd_string_of_int {
   304                          caml_nonstd_string_of_int
   305                                  ;; Stdlib.string_of_int
   306                                  ;; Convert an int to string, using the C64 format: first char for sign
   307                                  ;; (space if positive, minus if negative), followed by 5 digit max and
   308                                  ;; no non-significative zeroes.
   309                          @DGT    = TMP
   310                          @SKIPZ  = TMP + 1
   311  8729 a9fc                       LDA # String_tag                ;Max len is 4 words:
   312  872b a204                       LDX # 4                         ;|'-','1'|'6','3'|'8','3'|\0,\1|
   313  872d 201f7b                     JSR caml_alloc                  ;Allocate string, addr in BLK
   314  8730 a920                       LDA # ' '                       ;Positive numbers start with ' '
   315  8732 24fc                       BIT ACCU + 1
   316  8734 100e                       BPL +
   317  8736 38                         SEC                             ;If value is negative,
   318  8737 a902                       LDA # 2                         ; negate it
   319  8739 e5fb                       SBC ACCU
   320  873b 85fb                       STA ACCU
   321  873d 98                         TYA
   322  873e e5fc                       SBC ACCU + 1
   323  8740 85fc                       STA ACCU + 1
   324  8742 a92d                       LDA # '-'                       ; and put a '-' into the string
   325  8744 914b               +       STA (BLK),Y
   326  8746 c8                         INY
   327  8747 46fc                       LSR ACCU + 1                    ;Get rid of trailing 1
   328  8749 66fb                       ROR ACCU
   329  874b a930                       LDA # '0'                       ;Set SKIPZ flag to '0' (=ignore
   330  874d 854e                       STA @SKIPZ                      ; all initial zeroes)
   331  874f a203                       LDX # 3                         ;For X := 3 downto 0
   332  8751 854d               --      STA @DGT                        ; Init DGT to '0'
   333  8753 a5fb                       LDA ACCU                        ; Loop for calculating DGT:
   334  8755 38                         SEC
   335  8756 fd9787             -       SBC @lo10,X                     ;  Subtract 10^(X+1) from ACCU
   336  8759 48                         PHA
   337  875a a5fc                       LDA ACCU + 1
   338  875c fd9b87                     SBC @hi10,X
   339  875f 9009                       BCC +                           ; Exit loop on negative result
   340  8761 85fc                       STA ACCU + 1                    ;  Store result in ACCU
   341  8763 68                         PLA
   342  8764 85fb                       STA ACCU
   343  8766 e64d                       INC @DGT                        ;  Set DGT to next char digit
   344  8768 b0ec                       BCS -                           ; BCS=JMP, Continue loop
   345  876a 68                 +       PLA
   346  876b a54d                       LDA @DGT
   347  876d c54e                       CMP @SKIPZ                      ; If DGT='0' & SKIPZ='0'
   348  876f f007                       BEQ +                           ; then ignore current digit
   349  8771 c64e                       DEC @SKIPZ                      ; else stop skipping zeroes,
   350  8773 914b                       STA (BLK),Y                     ;  put DGT into the string,
   351  8775 c8                         INY
   352  8776 a930                       LDA # '0'                       ;  set A='0' for next iteration.
   353  8778 ca                 +       DEX                             ; Decrement counter
   354  8779 10d6                       BPL --                          ;End_For
   355  877b 05fb                       ORA ACCU                        ;A := '0'|ACCU  (last digit)
   356  877d 914b                       STA (BLK),Y
   357  877f c8                         INY
   358  8780 a900                       LDA # 0                         ;Pad string with \0
   359  8782 914b                       STA (BLK),Y
   360  8784 c8                         INY
   361  8785 98                         TYA
   362  8786 4a                         LSR                             ;Compute block size (in wo.)
   363  8787 aa                         TAX
   364  8788 9005                       BCC +
   365  878a a901                       LDA # 1                         ;Add \1 pad if necessary
   366  878c 914b                       STA (BLK),Y
   367  878e e8                         INX                             ;size +1 for \0\1
   368  878f a000               +       LDY # 0
   369  8791 208d7d                     JSR caml_shrink_latest_alloc    ;Shrink block to computed size
   370  8794 4c7b7d                     JMP caml_load_newblk   
   371  8797 0a64e810           @lo10   !byte <10, <100, <1000, <10000
   372  879b 00000327           @hi10   !byte >10, >100, >1000, >10000
   373                          }
   374                          
   375                                  ;;
   376                                  ;; AUX
   377                                  ;;
   378                          
   379                          !ifdef caml_AUX__caml_string_from_0100 {
   380                          caml_string_from_0100
   381                                  ;; Make a string with the characters at $0100, ended by a 0 (255 at
   382                                  ;; most): ACCU := the new string.
   383                                  LDX # $FF
   384                          -       INX                             ;count string length (except 0)
   385                                  LDA $0100,X
   386                                  BNE -                           ;(X = length when loop ends)
   387                                  LDA # 1                         ;add a final 1 for padding; it
   388                                  STA $0101,X                     ;won't be copied if len is odd
   389                                  TXA                             ;A := length
   390                                  LSR
   391                                  TAX                             ;X := length / 2
   392                                  INX                             ;X := length/2+1=blk size (wo.)
   393                                  LDA # String_tag
   394                                  LDY # 0
   395                                  JSR caml_alloc                  ;allocate the new block
   396                                  JSR caml_load_newblk            ;ACCU := new string
   397                                  TXA
   398                                  ASL
   399                                  TAY                             ;Y := 2 * size
   400                                  DEY
   401                          -       LDA $0100,Y                     ;copy string and 0/01 padding
   402                                  STA (BLK),Y                     ;to the new block
   403                                  DEY
   404                                  BNE -
   405                                  LDA $0100
   406                                  STA (BLK),Y
   407                                  RTS
   408                          }
   409                          
   410                          !ifdef caml_AUX__caml_string_index_y {
   411                          caml_string_index_y
   412                                  ;; given a string in ACCU, read index from SP[0], then
   413                                  ;; set Y and ACCU+1 so that ACCU+Y = &string[index];
   414                                  ;; raise Invalid_argument if not 0<=index<length(string).
   415  879f a001                       LDY # 1
   416  87a1 b1fd                       LDA (SP),Y                      ;get ARGh
   417  87a3 4a                         LSR                             ;Int_val(ARGh)
   418  87a4 854e                       STA TMP + 1                     ;save
   419  87a6 88                         DEY
   420  87a7 b1fd                       LDA (SP),Y                      ;get ARGl
   421  87a9 6a                         ROR                             ;Int_val(ARGl)
   422  87aa 854d                       STA TMP                         ;save
   423  87ac 20c787                     JSR caml_string_length_yx       ;get string length in .Y.X
   424  87af e44e                       CPX TMP + 1                     ;compare hi bytes
   425  87b1 9011                       BCC ++                          ;.X < ARGh: error
   426  87b3 d006                       BNE +                           ;.X > ARGh: ok
   427  87b5 c44d                       CPY TMP                         ;.X = ARGh: compare lo byte
   428  87b7 900b                       BCC ++                          ;.Y < ARGl: error
   429  87b9 f009                       BEQ ++                          ;.Y = ARGl: error
   430  87bb a44d               +       LDY TMP                         ;reload index, lo
   431  87bd a54e                       LDA TMP + 1
   432  87bf f002                       BEQ +
   433  87c1 e6fc                       INC ACCU + 1                    ;inc ACCUh if needed
   434  87c3 60                 +       RTS
   435  87c4 4c8b7f             ++      JMP caml_err_index_oob
   436                          }
   437                          
   438                          !ifdef caml_AUX__caml_string_length_yx {
   439                          caml_string_length_yx
   440                                  ;; ACCU = string
   441                                  ;; return the string length in .Y,.X (int16, lo-hi)
   442  87c7 a5fc                       LDA ACCU + 1
   443  87c9 48                         PHA                             ;save ACCU + 1
   444  87ca 88                         DEY                             ;LDY # -1
   445  87cb c6fc                       DEC ACCU + 1
   446  87cd b1fb                       LDA (ACCU),Y                    ;.A := size
   447  87cf e6fc                       INC ACCU + 1
   448  87d1 a200                       LDX # 0
   449  87d3 0a                         ASL
   450  87d4 a8                         TAY                             ;.Y := <(2 * size)
   451  87d5 9008                       BCC @minus1
   452  87d7 d003                       BNE +
   453  87d9 88                         DEY                             ;shortcut when .Y=256
   454  87da d00b                       BNE @pad                        ;bne=jmp
   455  87dc e6fc               +       INC ACCU + 1
   456  87de e8                         INX                             ;.X := >(2 * size)
   457  87df 88                 @minus1 DEY                             ;.Y := <(2 * size - 1)
   458  87e0 c0ff                       CPY # $FF
   459  87e2 d003                       BNE @pad
   460  87e4 c6fc                       DEC ACCU + 1
   461  87e6 ca                         DEX                             ;.X := >(2 * size - 1)
   462  87e7 b1fb               @pad    LDA (ACCU),Y                    ;.A := padding byte
   463  87e9 f006                       BEQ +
   464  87eb 88                         DEY                             ;.Y := <(2 * size -1 -pad)
   465  87ec c0ff                       CPY # $FF
   466  87ee d001                       BNE +
   467  87f0 ca                         DEX                             ;.X := >(2 * size -1 -pad)
   468  87f1 68                 +       PLA
   469  87f2 85fc                       STA ACCU + 1                    ;restore ACCU+1
   470  87f4 60                         RTS
   471                          }
   472                          
   473                          }      ;; !zone caml_STRINGS
   474                          

