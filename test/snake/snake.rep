   180                          ;; ---- block operations --------------------------------------------------------
   181                          ;; fill_at page off len v / blit_at spage soff dpage doff len
   182                          ;; len is 0..16383. The checked versions raise Invalid_argument if the (first)
   183                          ;; destination address is below caml_stack_end, if len is negative, or if the
   184                          ;; destination range wraps around $FFFF. A range ending exactly at $FFFF is ok.
   185                          ;; blit_at works also if source and destination overlap.
   186                          
   187                          !ifdef caml_AUX__caml_hw_fill {
   188                          caml_hw_fill
   189                                  ;; ACCU = destination, TMP,TMP+1 = count, A = value
   190                                  LDX TMP + 1                     ;X := number of full pages
   191                                  BEQ @rem
   192                          @page   LDY # 0
   193                          @byte   STA (ACCU),Y
   194                                  INY
   195                                  BNE @byte
   196                                  INC ACCU + 1
   197                                  DEX
   198                                  BNE @page
   199                          @rem    LDY TMP                         ;Y := remaining bytes
   200                                  BEQ @done
   201                          @rbyte  DEY
   202                                  STA (ACCU),Y
   203                                  BNE @rbyte
   204                          @done   LDY # 0
   205                                  +caml_hw_ret_unit
   206                                  RTS
   207                          }
   208                          
   209                          !ifdef caml_AUX__caml_hw_blit {
   210                          caml_hw_blit
   211                                  ;; ACCU = source, TMP+4,TMP+5 = destination, TMP,TMP+1 = count
   212                                  LDA TMP + 4
   213                                  CMP ACCU
   214                                  LDA TMP + 5
   215                                  SBC ACCU + 1
   216                                  BCS @bwd                        ;destination >= source: copy backwards
   217                                  LDX TMP + 1                     ;forward copy: X := full pages
   218                                  BEQ @frem
   219                          @fpage  LDY # 0
   220                          @fbyte  LDA (ACCU),Y
   221                                  STA (TMP + 4),Y
   222                                  INY
   223                                  BNE @fbyte
   224                                  INC ACCU + 1
   225                                  INC TMP + 5
   226                                  DEX
   227                                  BNE @fpage
   228                          @frem   LDY # 0
   229                                  CPY TMP
   230                                  BEQ @done
   231                          @frbyte LDA (ACCU),Y
   232                                  STA (TMP + 4),Y
   233                                  INY
   234                                  CPY TMP
   235                                  BNE @frbyte
   236                          @done   LDY # 0
   237                                  +caml_hw_ret_unit
   238                                  RTS
   239                          @bwd    CLC                             ;backward copy: point both addresses
   240                                  LDA ACCU + 1                    ; to the end of the last full page,
   241                                  ADC TMP + 1                     ; copy the remainder first, then the
   242                                  STA ACCU + 1                    ; full pages from the top.
   243                                  CLC
   244                                  LDA TMP + 5
   245                                  ADC TMP + 1
   246                                  STA TMP + 5
   247                                  LDY TMP
   248                                  BEQ @bpages
   249                                  DEY
   250                          @brbyte LDA (ACCU),Y
   251                                  STA (TMP + 4),Y
   252                                  DEY
   253                                  CPY # $FF
   254                                  BNE @brbyte
   255                          @bpages LDX TMP + 1
   256                                  BEQ @bdone
   257                          @bpage  DEC ACCU + 1
   258                                  DEC TMP + 5
   259                                  LDY # $FF
   260                          @bbyte  LDA (ACCU),Y
   261                                  STA (TMP + 4),Y
   262                                  DEY
   263                                  CPY # $FF
   264                                  BNE @bbyte
   265                                  DEX
   266                                  BNE @bpage
   267                          @bdone  JMP @done
   268                          }
   269                          
   270                          !ifdef caml_PRIM__caml_nonstd_hw_unsafe_fill_at {
   271                          caml_nonstd_hw_unsafe_fill_at
   272                                  +caml_hw_addr_page
   273                                  +caml_hw_int16 1
   274                                  +caml_hw_value 2
   275                                  JMP caml_hw_fill
   276                          }
   277                          
   278                          !ifdef caml_PRIM__caml_nonstd_hw_fill_at {
   279                          caml_nonstd_hw_fill_at
   280                                  +caml_hw_addr_page
   281                                  +caml_hw_int16 1
   282                                  LDA ACCU
   283                                  CMP # <caml_stack_end
   284                                  LDA ACCU + 1
   285                                  SBC # >caml_stack_end
   286                                  BCC @err                        ;destination below caml_stack_end
   287                                  LDA TMP + 1
   288                                  CMP # $40
   289                                  BCS @err                        ;negative length
   290                                  LDA ACCU
   291                                  CLC
   292                                  ADC TMP
   293                                  STA TMP + 2
   294                                  LDA ACCU + 1
   295                                  ADC TMP + 1
   296                                  BCC @ok
   297                                  ORA TMP + 2
   298                                  BNE @err                        ;wraps around $FFFF
   299                          @ok     +caml_hw_value 2
   300                                  JMP caml_hw_fill
   301                          @err    +caml_raise Invalid_argument, "C64.Hw.Mem.fill_at"
   302                          }
   303                          
