   129                          ;; i15-i1e depend on i19
   130                          !macro  i19 .n {                                ;ENVACC n
   131                                  +caml_range 0, .n, $FE, "ENVACC n: n"
   132                                  .n2h = >(2 * .n)
   133                                  .n2l = <(2 * .n)
   134                                  !set    caml_gen_ENVACC = 1
   135                            !if .n2l > 0 {
   136                                  LDY # .n2l
   137                            }
   138                            !if .n2h > 0 {
   139                                  INC ENV + 1
   140                                  JSR ENVACC
   141                                  DEC ENV + 1
   142                            } else {
   143                                  JSR ENVACC
   144                            }
   145                          }
