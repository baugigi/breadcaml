   191                          !ifdef caml_PRIM__caml_blit_string {
   192                          caml_blit_string
   193                                  ;; ACCU=src, SP[0]=sofs SP[1]=dst, SP[2]=dofs, SP[3]=len
   194                                  ;; copies len consecutive bytes, starting from src.[sofs], to dst.[dofs]
   195                                  ;; source and destination intervals may overlap.
   196                                  ;; (unsafe, args are checked in Bytes module)
   197                          @FROM   = TMP
   198                          @TO     = TMP + 2
   199                          @SIZE   = TMP + 4
   200  232d a007                       LDY # 7
   201  232f b12e                       LDA (SP),Y                              ; >len
   202  2331 4a                         LSR
   203  2332 854a                       STA @SIZE + 1                           ; SIZE + 1 := >int_val(len)
   204  2334 88                         DEY
   205  2335 b12e                       LDA (SP),Y                              ; <len
   206  2337 6a                         ROR
   207  2338 8549                       STA @SIZE                               ; SIZE := <int_val(len)
   208  233a 88                         DEY
   209  233b b12e                       LDA (SP),Y                              ; >dofs
   210  233d 4a                         LSR
   211  233e 8548                       STA @TO + 1                             ; TO := >int_val(dofs)
   212  2340 88                         DEY
   213  2341 b12e                       LDA (SP),Y                              ; <dofs
   214  2343 6a                         ROR
   215  2344 8547                       STA @TO                                 ; TO := <int_val(dofs)
   216  2346 88                         DEY
   217  2347 b12e                       LDA (SP),Y                              ; >dst
   218  2349 aa                         TAX
   219  234a 88                         DEY
   220  234b b12e                       LDA (SP),Y                              ; <dst
   221  234d 18                         CLC
   222  234e 6547                       ADC @TO
   223  2350 8547                       STA @TO                                 ; TO := <(dst + int_val(dofs))
   224  2352 8a                         TXA
   225  2353 6548                       ADC @TO + 1
   226  2355 8548                       STA @TO + 1                             ; TO + 1:= >(dst+int_val(dofs))
   227  2357 88                         DEY
   228  2358 b12e                       LDA (SP),Y                              ; >sofs
   229  235a 4a                         LSR
   230  235b aa                         TAX
   231  235c 88                         DEY
   232  235d b12e                       LDA (SP),Y                              ; <soft
   233  235f 6a                         ROR
   234  2360 18                         CLC
   235  2361 652c                       ADC ACCU
   236  2363 8545                       STA @FROM                               ; FROM := <(src + int_val(sofs))
   237  2365 a8                         TAY
   238  2366 8a                         TXA
   239  2367 652d                       ADC ACCU + 1
   240  2369 8546                       STA @FROM + 1                           ; FROM+1 := >(src+int_val(sofs))
   241  236b 206c21                     JSR caml_memcpy                         ; ok, even if src & dest overlap
   242  236e a001                       LDY # <Val_unit
   243  2370 842c                       STY ACCU
   244  2372 88                         DEY
