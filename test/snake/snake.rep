   526                          !ifdef caml_PRIM__caml_float_loadFAC {
   527                                  ;; how to use:
   528                                  ;; 1) set  caml_float_loadFAC__addr
   529                                  ;; 2) call caml_float_loadFAC
   530                          caml_float_loadFAC
   531                                  LDX # 4
   532                          caml_float_loadFAC__addr = * + 1
   533                          -       LDA .dummy,X            ;SMC: replaced with real address
   534                                  STA C64_FAC,X
   535                                  DEX
   536                                  BPL -
   537                                  LDA C64_FAC + 1         ;copy 1st byte of mantissa
   538                                  STA C64_FAC + 5         ;to FAC sign byte
   539                                  ORA # $80
   540                                  STA C64_FAC + 1         ;set 1st bit of mantissa = 1
   541                                  INX
   542                                  STX C64_FACRND          ;FAC round byte := 0
   543                                  RTS
   544                          }
   545                          
   546                          !ifdef caml_PRIM__caml_float_loadARG {
   547                                  ;; how to use:
   548                                  ;; 1) set  caml_float_loadARG__addr
   549                                  ;; 2) call caml_float_loadARG
   550                          caml_float_loadARG
   551                                  LDX # 4
   552                          caml_float_loadARG__addr = * + 1
   553                          -       LDA .dummy,X            ;SMC: replaced with real address
