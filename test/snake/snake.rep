    15                          ;; -----------------------------------------------------------------------------
    16                          ;;                                ALLOC DUMMY
    17                          ;; -----------------------------------------------------------------------------
    18                          
    19                          !zone caml_DUMMY {
    20                          
    21                          !ifdef caml_PRIM__caml_alloc_dummy_function {
    22                          caml_alloc_dummy_function = caml_alloc_dummy
    23                          }
    24                          !ifdef caml_PRIM__caml_alloc_dummy {
    25                                  ;; allocate a dummy block for a recursive value (or function)
    26                                  ;; ACCU = size, (SP[0] = function arity, ignored)
    27                          caml_alloc_dummy
    28                                  LSR ACCU + 1
    29                                  LDA ACCU
    30                                  ROR
    31                                  BNE +                           ; size = 0
    32                                  JMP caml_mkatom0
    33                                  ;; allocate block
    34                          +       TAX
    35                                  TYA
    36                                  JSR caml_alloc
    37                                  JSR caml_block_fill0            ;fill fields with Val_zero
    38                                  JMP caml_load_newblk   
    39                          }
    40                          
    41                          !ifdef caml_PRIM__caml_alloc_dummy_float {
    42                                  ;; allocate a dummy block for a recursive array/record of floats
    43                                  ;; ACCU = no. of floats
    44                          caml_alloc_dummy_float
    45                                  ;; ignore ACCU + 1, as 0 <= no. of floats <= 85
    46                                  LDA ACCU
    47                                  LSR
    48                                  BNE +                           ; Atom(0)
    49                                  JMP caml_mkatom0
    50                                  ;; X <- no. of floats * Double_wosize
    51                          +       CLC
    52                                  ADC ACCU
    53                                  TAX
    54                                  DEX
    55                                  ;; allocate block
    56                                  TYA                             ; A = Y = 0
    57                                  JSR caml_alloc
    58                                  JMP caml_load_newblk   
    59                          }
    60                          
    61                          !ifdef caml_PRIM__caml_update_dummy {
    62                                  ;; update a dummy block with given value
    63                                  ;; ACCU = dummy, SP[0] = newval
    64                          caml_update_dummy
    65                                  ;; load newval size
    66                                  LDA (SP),Y
    67                                  STA TMP
    68                                  INY
    69                                  LDA (SP),Y
    70                                  STA TMP + 1
    71                                  LDY # -1
    72                                  DEC TMP + 1
    73                                  LDA (TMP),y
    74                                  BNE +
    75                                  ;; size = 0, update nothing
    76                                  INY                             ; Y = 0
    77                                  BEQ ++
    78                                  ;; tag(dummy) <- tag(newval)
    79                          +       TAX                             ; save size
    80                                  DEY
    81                                  DEC ACCU + 1
    82                                  LDA (TMP),y
    83                                  STA (ACCU),y
    84                                  INC ACCU + 1
    85                                  INC TMP + 1
    86                                  ;; copy newval fields into dummy ones
    87                                  TXA                             ; reload size
    88                                  ASL
    89                                  TAY                             ; Y = 2 * size, Carry = MSB
    90                                  JSR caml_blkcpy
    91                                  ;; ACCU <- ()
    92                          ++      STY ACCU + 1                    ; Y = 0
    93                                  LDA # <Val_unit
    94                                  STA ACCU
    95                                  RTS
    96                          }
    97                          
    98                          }       ;; !zone caml_DUMMY
    99                          

