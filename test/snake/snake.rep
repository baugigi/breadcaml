   128  7b2e d006                       BNE +                           ;  if size + 1 = 256
   129  7b30 e64a                       INC HEAP + 1                    ;  then incr. HEAPh
   130  7b32 e64a                       INC HEAP + 1                    ;    twice (512 bytes)
   131  7b34 d00f                       BNE @limits                     ;    BNE=JMP
   132  7b36 8a                 +       TXA                             ;  else
   133  7b37 0a                         ASL                             ;    C:A := 2*(size+1),
   134  7b38 9003                       BCC +                           ;    if carry set then
   135  7b3a e64a                       INC HEAP + 1                    ;      add it to HEAPh,
   136  7b3c 18                         CLC
   137  7b3d 6549               +       ADC HEAP                        ;    add 2*(size+1)
   138  7b3f 8549                       STA HEAP                        ;    to HEAPl
   139  7b41 9002                       BCC @limits
   140  7b43 e64a                       INC HEAP + 1
   141                                  ;; If there's enough room, write tag and size into the header and exit
   142  7b45 adc57a             @limits LDA .CUR_END
   143  7b48 c549                       CMP HEAP
   144  7b4a adc67a                     LDA .CUR_END + 1
   145  7b4d e54a                       SBC HEAP + 1                    ;.CUR_END < HEAP?
   146  7b4f 9015                       BCC @gctry                      ;yes: try a garbage collection
   147  7b51 a53f                       LDA @TAG                        ;no: write tag and size  
   148  7b53 a000                       LDY # 0
   149  7b55 914b                       STA (BLK),Y                     ;  header's 1st by. := tag
   150  7b57 e64b                       INC BLK                         ;  (safe, BLK is even)
   151  7b59 a53e                       LDA @SZ
   152  7b5b 914b                       STA (BLK),Y                     ;  header's 2nd by. := size
   153  7b5d e64b                       INC BLK
   154  7b5f d002                       BNE +
   155  7b61 e64c                       INC BLK + 1                     ;  BLK=address of field(0)
   156  7b63 28                 +       PLP                             ;  pop GC-done flag
   157  7b64 aa                         TAX                             ;  RETURN A=X=size, BLK=addr,
   158  7b65 60                         RTS                             ;    C=GC-done flag.
   159                                  ;; else try a GC or, if already done, raise OOM
   160  7b66 28                 @gctry  PLP                             ;get GC-done flag from HW stack
   161  7b67 b00a                       BCS @oom                        ;check if GC done yet:
   162  7b69 a000                       LDY # 0                         ;(callers may pass Y<>0, e.g. CLOSURE)
   163  7b6b 207e7b                     JSR .caml_garbage_collect       ;no: call the garbage collector
   164  7b6e a63e                       LDX @SZ                         ; X := size
   165  7b70 38                         SEC                             ; set GC-done flag
   166  7b71 b0b1                       BCS @retry                      ; then try to allocate again.
