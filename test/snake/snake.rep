   121                          !ifdef caml_PRIM__caml_obj_dup {
   122                                  ;; ACCU = arg
   123                          caml_obj_dup
   124                                  DEY
   125                                  DEC ACCU + 1
   126                                  LDA (ACCU),Y                            ; A := size
   127                                  BEQ @atom                               ; exit if size = 0
   128                                  TAX                                     ; X := size
   129                                  DEY
   130                                  LDA (ACCU),Y                            ; A := tag
   131                                  INC ACCU + 1                            ; restore pointer
   132                                  LDY # 0                                 ;   and Y register
   133                                  JSR caml_alloc                          ; allocate a new block
   134                                  TXA                                     ; A := size
   135                                  ASL
   136                                  TAY                                     ; Y,C := 2 * size
   137                                  JSR caml_blkcpy                         ; copy the blk pointed by ACCU
   138                                  LDA BLK
   139                                  STA ACCU
   140                                  LDA BLK + 1
   141                                  STA ACCU + 1
   142                                  RTS
   143                          @atom   INC ACCU + 1
   144                                  INY
   145                                  RTS
   146                          }
