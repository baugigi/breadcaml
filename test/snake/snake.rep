   208                                  BEQ @end
   209                                  LDA BLK
   210                                  CLC
   211                                  ADC # Double_wosize * 2
   212                                  STA BLK
   213                                  BCC @loop
   214                                  INC BLK + 1
   215                                  BCS @loop                        ;C is still set
   216                          @end    LDA @RES                         ;ACCU := new array
   217                                  STA ACCU
   218                                  LDA @RES + 1
   219                                  STA ACCU + 1
   220                                  RTS                              ;{Y = 0}
   221                          }
