   397                          ;; -----------------------------------------------------------------------------
   398                          ;;      ROM/RAM OVERLAP - WAPPER FOR CALLS TO BASIC ROUTINES
   399                          ;; -----------------------------------------------------------------------------
   400                          
   401                                  ;; Macro: call a BASIC ROM routine
   402                          !macro caml_JSR_BASROM .routine {
   403                            !ifndef caml_basic_rom_overlap {      ;Best case: code never overlaps
   404                                  JSR .routine                    ; BASIC ROM.
   405                            } else {
   406                              !if * + 9 < C64_BASROM {            ;BASROM is disabled but this part of
   407                                  JSR caml_BASROM_on              ; of code doesn't overlap it.
   408                                  JSR .routine
   409                                  JSR caml_BASROM_off
   410                              } else {                            ;Worst case: this part of code overlaps 
   411                                  PHP                             ; BASIC ROM. Pass the routine address to 
   412                                  PHA                             ; a wrapper in a safe zone and call it.
   413                                  LDA # <.routine
   414                                  STA caml_BASROM_wrapper__addr
   415                                  LDA # >.routine
   416                                  STA caml_BASROM_wrapper__addr + 1
   417                                  JSR caml_BASROM_wrapper
   418                              }
   419                            }
   420                          }
   421                          
   422                          !ifdef caml_basic_rom_overlap {
   423                          caml_BASROM_wrapper                     ;Wrapper for 'Worst case' above
   424                                  SEI
   425                                  LDA C64_R6510
   426                                  ORA # %00000011
   427                                  STA C64_R6510
   428                                  CLI
   429                                  PLA
   430                                  PLP
   431                          caml_BASROM_wrapper__addr = * + 1
   432                                  JSR .dummy                      ;SMC: JSR .routine
   433                                  ;; fallthrough caml_BASROM_off
   434                          caml_BASROM_off                         ;Deactivate BASIC ROM
   435                                  PHP
   436                                  PHA
   437                                  SEI
   438                                  LDA C64_R6510
   439                                  AND # %11111110
   440                                  STA C64_R6510
   441                                  CLI
   442                                  PLA
   443                                  PLP
   444                                  RTS
   445                          caml_BASROM_on                          ;Activate BASIC ROM
   446                                  PHP
   447                                  PHA
   448                                  SEI
   449                                  LDA C64_R6510
   450                                  ORA # %00000011
   451                                  STA C64_R6510
   452                                  CLI
   453                                  PLA
   454                                  PLP
   455                                  RTS
   456                          }
