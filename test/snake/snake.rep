   314                          ;; BEGIN 'bcamlopt -otime' SECTION
   315                          ;;
   316                                  
   317                          ;; DIRECT CALLS. The callee is statically known and its arity equals n:
   318                          ;; - APPLYD/APPTERMD: the callee is the enclosing function itself (ENV is
   319                          ;;   already right);
   320                          ;; - APPLYG/APPTERMG: the callee is the closure in ACCU (ENV := ACCU), whose
   321                          ;;   code address is known at compile time.
   322                          ;; The code pointer is not read and GRAB is skipped (so XARGS := Val_Int(0) for
   323                          ;; APPLY, XARGS unchanged for APPTERM). The macro is JSR routine : JMP .t, so
   324                          ;; the frame's return address is that of the JSR + 4 (over the JMP).
   325                          
   326                          !macro caml_applyd_body .setenv {       ;{Y = 2n-1, n <= 3}
   327                                  @SP = TMP
   328                                  @N2M1 = TMP + 2
   329                                  STY @N2M1
   330                                  LDA SP                          ;Save current SP value
   331                                  STA @SP
   332                                  LDA SP + 1
   333                                  STA @SP + 1
   334                                  +caml_grow_stack 3
   335                          -       LDA (@SP),Y                     ;Slide n arguments by 3 slots
   336                                  STA (SP),Y
   337                                  DEY
   338                                  BPL -
   339                                  LDY @N2M1
   340                                  INY
   341                                  TSX                             ;peek return address on hw stack
   342                                  LDA $0101,X
   343                                  CLC
   344                                  ADC # 4                         ;over JMP .t (3 bytes) + 1 (JSR)
   345                                  STA (SP),Y                      ;STACK[n] := return address
   346                                  INY
   347                                  LDA $0102,X
   348                                  ADC # 0
   349                                  STA (SP),Y
   350                                  INY
   351                                  LDA ENV                         ;STACK[n+1] := ENV
   352                                  STA (SP),Y
   353                                  INY
   354                                  LDA ENV + 1
   355                                  STA (SP),Y
   356                                  INY
   357                                  LDA XARGS                       ;STACK[n+2] := XARGS
   358                                  STA (SP),Y
   359                            !if .setenv {
   360                                  LDA ACCU                        ;ENV := ACCU (closure)
   361                                  STA ENV
   362                                  LDA ACCU + 1
   363                                  STA ENV + 1
   364                            }
   365                                  LDA # 1
   366                                  STA XARGS                       ;XARGS := Val_Int(0) (GRAB skipped)
   367                                  LDY # 0
   368                                  RTS                             ;to JMP .t   {Y = 0}
   369                          }
   370                          
   371                          !macro caml_apptrmd_body .setenv {      ;{X = 2(s-n), Y = 2n-1}
   372                                  LDA SP
   373                                  STA TMP
   374                                  LDA SP + 1
   375                                  STA TMP + 1                     ;save stack pointer
   376                                  TXA
   377                                  CLC
   378                                  ADC SP                          ;Pop s elements, push n
   379                                  STA SP
   380                                  BCC +
   381                                  INC SP + 1
   382                          +:-     LDA (TMP),Y                     ;move n elements from old top
   383                                  STA (SP),Y                      ;to new one
   384                                  DEY
   385                                  BNE -
   386                                  LDA (TMP),Y
   387                                  STA (SP),Y
   388                            !if .setenv {
   389                                  LDA ACCU                        ;ENV := ACCU (closure)
   390                                  STA ENV
   391                                  LDA ACCU + 1
   392                                  STA ENV + 1
   393                            }
   394                                  RTS                             ;to JMP .t   {Y = 0}
   395                          }
