    99                          
   100                          !ifdef caml_PRIM__caml_bytes_get {
   101                          caml_bytes_get = caml_string_get
   102                          }
   103                          !ifdef caml_PRIM__caml_string_get {
   104                          caml_string_get
   105                                  ;; ACCU=string, SP[0]=index
   106                                  ;; return string[index]
   107  5711 203158                     JSR caml_string_index_y
   108  5714 b1fb                       LDA (ACCU),Y                    ;get char
   109  5716 38                         SEC
   110  5717 2a                         ROL
   111  5718 85fb                       STA ACCU
   112  571a a900                       LDA # 0
   113  571c a8                         TAY                             ;.Y := 0
   114  571d 2a                         ROL
   115  571e 85fc                       STA ACCU + 1                    ;ACCU := Val_char(char)
   116  5720 60                         RTS
   117                          }
   118                          
   119                          !ifdef caml_PRIM__caml_bytes_set {
   120                          caml_bytes_set = caml_string_set
   121                          }
   122                          !ifdef caml_PRIM__caml_string_set {
   123                          caml_string_set
   124                                  ;; ACCU=string, SP[0]=index, SP[1]=newval
   125                                  ;; string.[index]<-newval; return: ()
   126                          ;       TMP                             ; used by caml_string_index_y
   127                          ;       TMP + 1                         ; used by caml_string_index_y
   128                          @CHAR   = TMP + 2
   129                                  LDY # 3
   130                                  LDA (SP),Y                      ; get newval, hi
   131                                  DEY
   132                                  LSR
   133                                  LDA (SP),Y                      ; get newval, lo
   134                                  ROR
   135                                  STA @CHAR                       ; save char_val(newval)
   136                                  JSR caml_string_index_y         ; Y := index
   137                                  LDA @CHAR
   138                                  STA (ACCU),Y                    ; modify string in place
   139                                  LDY # <Val_unit
   140                                  STY ACCU
   141                                  DEY
   142                                  STY ACCU + 1                    ; return ()
   143                                  RTS
   144                          }
