    18                          !ifdef caml_PRIM__caml_create_string {
    19                          caml_create_string
    20                                  ;; ACCU = length
    21                                  ;; alloc a new block for a string of given length (max 509)
    22                          
    23  22c8 a52d                       LDA ACCU + 1                            ;load >length
    24  22ca 4a                         LSR                                     ;
    25  22cb 662c                       ROR ACCU                                ;ACCUl,A := Int_val(lenght)
    26  22cd 4a                         LSR
    27  22ce d02d                       BNE +++                                 ;A>0 => len > max, raise exn.
    28  22d0 662c                       ROR ACCU                                ;ACCUl :=  Int_val(lenght) / 2
    29  22d2 08                         PHP                                     ;save carry (remainder)
    30  22d3 a62c                       LDX ACCU                                ;X := block size, in words
    31  22d5 e8                         INX                                     ;take into account Ocaml padding
    32  22d6 f024                       BEQ ++                                  ;Exception if size > 255
    33  22d8 a9fc                       LDA # String_tag                        ;load tag
    34  22da 20111f                     JSR caml_alloc                          ;allocate block
    35  22dd a557                       LDA BLK
    36  22df 852c                       STA ACCU
    37  22e1 a558                       LDA BLK + 1
    38  22e3 852d                       STA ACCU + 1                            ;ACCU := address of new block
    39  22e5 ca                         DEX                                     ;Compute the padding bytes:
    40  22e6 8a                         TXA                                     ;A := size - 1
    41  22e7 0a                         ASL                                     ;A := 2 * size - 2
    42  22e8 9002                       BCC +
    43  22ea e658                       INC BLK + 1
    44  22ec a8                 +       TAY                                     ;BLK+.Y = address of last word
    45  22ed a900                       LDA # 0
    46  22ef 28                         PLP                                     ;reload .C flag
    47  22f0 b004                       BCS +                                   ;string length is odd?
    48  22f2 9157                       STA (BLK),Y                             ;no: padding = "\000\001"
    49  22f4 a901                       LDA # 1
    50  22f6 c8                 +       INY                                     ;yes: padding = "\000"
    51  22f7 9157                       STA (BLK),Y
    52  22f9 a000                       LDY # 0
    53  22fb 60                         RTS
    54  22fc 28                 ++      PLP
    55                          +++     +caml_raise Invalid_argument, "String.create"

