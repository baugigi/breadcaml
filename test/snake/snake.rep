   244                          !ifdef caml_PRIM__caml_lessthan {
   245                          caml_lessthan
   246                                  JSR caml_compare_val
   247                                  BPL caml_return_false
   248                                  BMI caml_return_true
   249                          }
   250                          
   251                          !ifdef caml_PRIM__caml_greaterequal {
   252                          caml_greaterequal
   253                                  JSR caml_compare_val
   254                                  BPL caml_return_true
   255                                  BMI caml_return_false
   256                          }
   257                          
   258                          !ifdef caml_PRIM__caml_lessequal {
   259                          caml_lessequal
   260                                  JSR caml_compare_val
   261                                  BMI caml_return_true
   262                                  BNE caml_return_false
   263                                  BEQ caml_return_true
   264                          }
   265                          
   266                          !ifdef caml_PRIM__caml_greaterthan {
   267                          caml_greaterthan
   268                                  JSR caml_compare_val
   269                                  BMI caml_return_false
   270                                  BNE caml_return_true
   271                                  BEQ caml_return_false
   272                          }
   273                          
   274                          !ifdef caml_PRIM__caml_compare {
   275                          caml_compare
   276                                  INY                                     ;set .COMPARE=1
   277                                  JSR caml_compare_val
   278                                  ;; FALLTHROUGH caml_compare_set_result
   279                          }
   280                          
   281                          !ifdef caml_PRIM__caml_compare_set_result {
   282                          caml_compare_set_result
   283                                  BPL +
   284                                  LDA # -1
   285                                  STA ACCU
   286                                  STA ACCU + 1
   287                                  RTS
   288                          +       SEC
   289                                  ROL
   290                                  STA ACCU
   291                                  STY ACCU + 1
   292                                  RTS
   293                          }
   294                          
   295                          !ifdef caml_PRIM__caml_compare_identity_setV2 {
   296                          caml_compare_identity_setV2
   297                                  ;; check if ACCU == SP[0] (physical identity)
   298                                  ;; yes: return Z = 1
   299                                  ;; no:  return Z = 0, .V2 = SP[0]
   300                                  LDA (SP),Y
   301                                  TAX
   302                                  INY
   303                                  LDA (SP),Y
   304                                  DEY
   305                                  CPX .V1
   306                                  BNE +
   307                                  CMP .V1 + 1
   308                                  BNE +
   309                                  RTS
   310                          +       STX .V2
   311                                  STA .V2 + 1
   312                                  RTS
   313                          }
   314                          
   315                          !ifdef caml_PRIM__caml_compare_val {
   316                          caml_compare_val
   317                                  ;; Compare values in ACCU and SP[0].
   318                                  ;; PREREQUISITE: Y <> 0 if called by caml_compare, Y = 0 otherwise.
   319                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   320                                  ;; Status byte is set according to A.
   321                                  STY .COMPARE                            ;Y <> 0 iif called by caml_compare
   322                                  LDY # 0
   323                                  LDA SP
   324                                  STA .SAVESP
   325                                  LDA SP + 1
   326                                  STA .SAVESP + 1
   327                                  LDA (SP),Y
   328                                  STA .V2
   329                                  INY
   330                                  LDA (SP),Y
   331                                  STA .V2 + 1
   332                          .loop   LDY # 0
   333                                  STY .CMP
   334                                  LDA .V1 + 1
   335                                  LDX .V1
   336                                  CPX .V2
   337                                  BEQ .eq_tst
   338                                  SBC .V2 + 1
   339                          .neq    BVC +                                   ;(signed) v1<v2 iif V xor N = 1
   340                                  ORA # $80
   341                          +       BMI +
   342                                  INC .CMP                                ;v1 > v2 => CMP := 1
   343                                  BNE .int_or_block                       ;bne=jmp
   344                          +       DEC .CMP                                ;v1 < v2 => CMP := -1
   345                                  BNE .int_or_block                       ;bne=jmp
   346                          .eq_tst SBC .V2 + 1
   347                                  BNE .neq
   348                                  CMP .COMPARE                            ;v1==v2; called by caml_compare?
   349                                  BEQ .int_or_block                       ;no: go deep, maybe raise exn :(
   350                                  JMP .next_item                          ;yes: speed up, go to next_item
   351                          .int_or_block
   352                                  TXA
   353                                  BIT caml_is_block
   354                                  BEQ .v1_block
   355                                  LDA .V2
   356                                  BIT caml_is_block
   357                                  BEQ .v1_int_v2_block
   358                                  LDA .CMP
   359                                  JMP .return_or_next
   360                          .v1_int_v2_block
   361                                  LDY # -2
   362                                  DEC .V2 + 1
   363                                  LDA (.V2),Y                             ;A := Tag(v2)
   364                                  INC .V2 + 1
   365                                  CMP # Forward_tag                       ;check for special cases
   366                                  BEQ .v2_forward
   367                                  CMP # Custom_tag
   368                                  BEQ .v2_custom
   369                                  LDA # -1
   370                                  JMP .return                             ;int < block => RETURN LESS
   371                          .v2_forward
   372                                  LDY # 1
   373                                  LDA (.V2),Y                             ;v2 := Field(v2,0)
   374                                  TAX
   375                                  DEY
   376                                  LDA (.V2),Y
   377                                  STX .V2 + 1
   378                                  STA .V2
   379                                  JMP .loop                               ;continue
   380                          .v2_custom
   381                                  LDY # 1
   382                                  LDA (.V2),Y                             ;load jmptbl address
   383                                  STA .v2jsr + 2
   384                                  DEY
   385                                  LDA (.V2),Y
   386                                  STA .v2jsr + 1
   387                          .v2jsr  JSR .dummy                              ;call custom_compare, res. in A
   388                                  JMP .return_or_next
   389                          .v1_block
   390                                  LDA .V2
   391                                  BIT caml_is_block
   392                                  BEQ .v1_block_v2_block
   393                                  LDY # -2                                ;v1:block, v2:int
   394                                  DEC .V1 + 1
   395                                  LDA (.V1),Y                             ;A := Tag(v1)
   396                                  INC .V1 + 1
   397                                  CMP # Forward_tag                       ;check for special cases
   398                                  BEQ .v1_forward
   399                                  CMP # Custom_tag
   400                                  BEQ .v1_cust_tst
   401                                  LDA # 1
   402                                  JMP .return                             ;block > int => RETURN GREATER
   403                          .v1_forward
   404                                  LDY # 1
   405                                  LDA (.V1),Y                             ;v1 := Field(v1,0)
   406                                  TAX
   407                                  DEY
   408                                  LDA (.V1),Y
   409                                  STX .V1 + 1
   410                                  STA .V1
   411                                  JMP .loop                               ;continue
   412                          .v1_cust_tst
   413                                  LDY # 1
   414                                  LDA (.V1),Y                             ;load jmptbl address
   415                                  STA .v1jsr + 2
   416                                  DEY
   417                                  LDA (.V1),Y
   418                                  STA .v1jsr + 1
   419                          .v1jsr  JSR .dummy                              ;call custom_compare, res. in A
   420                                  JMP .return_or_next
   421                          .v1_block_v2_block
   422                                  LDY # -2
   423                                  DEC .V1 + 1
   424                                  DEC .V2 + 1
   425                                  LDA (.V2),Y
   426                                  TAX                                     ;X := Tag_v2
   427                                  LDA (.V1),Y                             ;A := Tag_v1
   428                                  INC .V1 + 1
   429                                  INC .V2 + 1
   430                                  CMP # Forward_tag
   431                                  BEQ .v1_forward                         ;jump if Tag_v1=Forward_tag
   432                                  CPX # Forward_tag
   433                                  +beq .v2_forward                        ;jump if Tag_v2=Forward_tag
   434                                  STX .CMP
   435                                  SEC
   436                                  SBC .CMP
   437                                  BEQ .switch_on_tag                      ;Tag_v1=Tag_v2 =>choose routine
   438                                  JMP .return                             ;Tag_v1!=Tag_v2=>RETURN
   439                          .switch_on_tag
   440                                  CPX # String_tag                        ;dichotomic switch
   441                                  BCC .t249
   442                                  BNE .t254
   443                                  JSR caml_compare_val_string_tag
   444                                  JMP .return_or_next
   445                          .t249   CPX # Infix_tag
   446                                  BCC .t247
   447                                  BNE +
   448                          -       +caml_raise Invalid_argument, "compare: functional value"
   449                          +       +caml_raise Invalid_argument, "compare: abstract value"
   450                          .t247   CPX # Closure_tag
   451                                  BCC .default
   452                                  BEQ -
   453                                  JSR caml_compare_val_object_tag
   454                                  JMP .return_or_next
   455                          .t254   CPX # Double_array_tag
   456                                  BCC .t253
   457                                  BNE .t255
   458                                  JSR caml_compare_val_double_array_tag
   459                                  JMP .return_or_next
   460                          .t253   JSR caml_compare_val_double_tag
   461                                  JMP .return_or_next
   462                          .t255   JSR caml_compare_val_custom_tag
   463                                  JMP .return_or_next
   464                          .default
   465                                  ;; compare sizes first
   466                                  LDY # -1
   467                                  DEC .V1 + 1
   468                                  DEC .V2 + 1
   469                                  LDA (.V1),Y                             ;A := size(v1)
   470                                  TAX                                     ;save it
   471                                  SEC
   472                                  SBC (.V2),Y                             ;A := size(v1) - size(v2)
   473                                  BNE .return                             ;A <> 0 ==> return(A)
   474                                  TXA                                     ;reload size(v1)
   475                                  BEQ .next_item                          ;v1, v2 atoms ==> next_item
   476                                  INC .V1 + 1
   477                                  INC .V2 + 1
   478                                  DEX                                     ;only one field?
   479                                  BEQ .field0                             ;yes:compare Fld(v1,0) Fld(v2,0)
   480                                  +caml_grow_stack 3                      ;no: save data on stack:
   481                                  LDY # 0
   482                                  CLC
   483                                  LDA .V1
   484                                  ADC # 2
   485                                  STA (SP),Y
   486                                  INY
   487                                  LDA .V1 + 1
   488                                  ADC # 0
   489                                  STA (SP),Y                              ;address of Field(v1,1) in SP[0]
   490                                  INY
   491                                  CLC
   492                                  LDA .V2
   493                                  ADC # 2
   494                                  STA (SP),Y
   495                                  INY
   496                                  LDA .V2 + 1
   497                                  ADC # 0
   498                                  STA (SP),Y                              ;address of Field(v2,1) in SP[1]
   499                                  INY
   500                                  DEX                                     ;# of following fields in SP[2]
   501                                  TXA
   502                                  STA (SP),Y
   503                          .field0 LDY # 0
   504                                  LDA (.V1),Y                             ;get <Field(v1,0)
   505                                  TAX                                     ;save it
   506                                  LDA (.V2),Y                             ;get <Field(v2,0)
   507                                  STA .CMP                                ;save it
   508                                  INY
   509                                  LDA (.V1),Y                             ;get >Field(v1,0)
   510                                  STA .V1 + 1                             ;.V1 + 1 :=  >Field(v1,0)
   511                                  LDA (.V2),Y                             ;get >Field(v2,0)
   512                                  STA .V2 + 1                             ;.V2 + 1  := >Field(v2,0)
   513                                  STX .V1                                 ;.V1 := Field(v1,0)
   514                                  LDA .CMP
   515                                  STA .V2                                 ;.V2 := Field(v2,0)
   516                                  JMP .loop                               ;continue comparison on v1, v2
   517                          .return_or_next
   518                                  ORA # 0                                 ;set status byte according to A
   519                                  BEQ .next_item                          ;if A=0 then compare nexts
   520                          .return LDX .SAVESP                             ;else
   521                                  STX SP                                  ; restore SP
   522                                  LDX .SAVESP + 1
   523                                  STX SP + 1
   524                                  LDY # 0
   525                                  ORA # 0                                 ; set status byte according to A
   526                                  RTS                                     ; exit
   527                          .next_item
   528                                  LDA SP                                  ;if SP = .SAVESP
   529                                  CMP .SAVESP
   530                                  BNE +
   531                                  LDA SP + 1
   532                                  CMP .SAVESP + 1
   533                                  BNE +
   534                                  LDA # 0                                 ;then RETURN EQUAL
   535                                  BEQ .return                             ;BEQ=JMP
   536                          +       LDY # 0                                 ;else get next item from stack:
   537                                  LDA (SP),Y                              ;V1 := SP[0] (lo byte)
   538                                  STA .V1
   539                                  CLC
   540                                  ADC # 2
   541                                  STA (SP),Y                              ;SP[0] := &next field (lo byte)
   542                                  INY
   543                                  LDA (SP),Y                              ;as above, hi byte
   544                                  STA .V1 + 1
   545                                  ADC # 0
   546                                  STA (SP),Y
   547                                  INY
   548                                  LDA (SP),Y                              ;V2 := SP[1] (lo byte)
   549                                  STA .V2
   550                                  CLC
   551                                  ADC # 2
   552                                  STA (SP),Y                              ;SP[1] := &next field (lo byte)
   553                                  INY
   554                                  LDA (SP),Y                              ;as above, hi byte
   555                                  STA .V2 + 1
   556                                  ADC # 0
   557                                  STA (SP),Y
   558                                  INY
   559                                  LDA (SP),Y                              ;get counter of remaining fields
   560                                  BEQ +                                   ;if counter = 0, continue loop
   561                                  SEC
   562                                  SBC # 1                                 ;else decrement the counter
   563                                  STA (SP),Y
   564                                  CLC
   565                                  LDA # 6
   566                                  ADC SP
   567                                  STA SP
   568                                  BCC +
   569                                  INC SP + 1                              ;and pop items from stack
   570                          +       LDY # 1                                 ;get curr. Fld(v1,x), Fld(v2,x)
   571                                  LDA (.V1),Y
   572                                  TAX
   573                                  LDA (.V2),Y
   574                                  STA .CMP
   575                                  DEY
   576                                  LDA (.V1),Y
   577                                  STA .V1
   578                                  STX .V1 + 1
   579                                  LDA (.V2),Y
   580                                  STA .V2
   581                                  LDA .CMP
   582                                  STA .V2 + 1
   583                                  JMP .loop                               ;continue loop
   584                          }
   585                          
   586                          !ifdef caml_PRIM__caml_compare_val_double_tag {
   587                          caml_compare_val_double_tag
   588                                  ;; Compare floats in ACCU and SP[0].
   589                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   590                                  ;; Status byte is set according to A.
   591                                  LDA .V1
   592                                  STA caml_float_loadFAC__addr
   593                                  LDA .V1 + 1
   594                                  STA caml_float_loadFAC__addr + 1
   595                                  JSR caml_float_loadFAC
   596                                  LDY .V2 + 1
   597                                  LDA .V2
   598                                  +caml_JSR_BASROM C64_FCOMP
   599                                  LDY # 0
   600                                  ORA # 0                                 ;set status byte according to A
   601                                  RTS
   602                          }
   603                          
   604                          !ifdef caml_PRIM__caml_compare_val_string_tag {
   605                          caml_compare_val_string_tag
   606                                  ;; Compare strings in ACCU and SP[0].
   607                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   608                                  ;; Status byte is set according to A.
   609                                  LDY # -1
   610                                  DEC .V1 + 1
   611                                  DEC .V2 + 1
   612                                  LDA (.V1),Y
   613                                  TAX
   614                                  SEC
   615                                  SBC (.V2),Y
   616                                  STA .CMP                                ;CMP = size(v1) - size(v2)
   617                                  BCC +
   618                                  LDA (.V2),Y
   619                                  TAX                                     ;X := min(size(v1), size(v2))
   620                          +       INY                                     ;Y := 0
   621                          --      INC .V1 + 1                             ;for Y := 0 to X - 1 {
   622                                  INC .V2 + 1                             ;  compare char by char:
   623                          -       DEX
   624                                  BEQ ++
   625                                  LDA (.V1),Y                             ;  1st byte
   626                                  CMP (.V2),Y
   627                                  BCC @lt
   628                                  BNE @gt
   629                                  INY
   630                                  LDA (.V1),Y                             ;  2nd byte
   631                                  CMP (.V2),Y
   632                                  BCC @lt
   633                                  BNE @gt
   634                                  INY
   635                                  BNE -
   636                                  BEQ --                                  ;}
   637                          ++      LDA (.V1),Y                             ;last word, 1st char
   638                                  CMP (.V2),Y
   639                                  BCC @lt
   640                                  BNE @gt
   641                                                                          ;(sub)strings are =, return CMP
   642                                  LDA .CMP                                ;CMP is size(v1)-size(v2),
   643                                  BNE +                                   ;if CMP = 0, adjust result
   644                                  INY                                     ;according to string paddings:
   645                                  CLC                                     ;len_v1-len_v2=-pad_v1+pad_v2
   646                                  ADC (.V2),Y
   647                                  SEC
   648                                  SBC (.V1),Y
   649                          +       LDY # 0
   650                                  ORA # 0                                 ;set status byte according to A
   651                                  RTS
   652                          @lt     LDY # 0
   653                                  LDA # -1
   654                                  RTS
   655                          @gt     LDY # 0
   656                                  LDA # 1
   657                                  RTS
   658                          }
   659                          
   660                          !ifdef caml_PRIM__caml_compare_val_custom_tag {
   661                          caml_compare_val_custom_tag
   662                                  ;; Compare custom values in ACCU and SP[0].
   663                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   664                                  ;; Status byte is set according to A.
   665                                  +caml_raise Not_found
   666                          }
   667                          
   668                          !ifdef caml_PRIM__caml_compare_val_double_array_tag {
   669                          caml_compare_val_double_array_tag
   670                                  ;; Compare floatarrays in ACCU and SP[0].
   671                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   672                                  ;; Status byte is set according to A.
   673                                  +caml_raise Not_found
   674                          }
   675                          
   676                          !ifdef caml_PRIM__caml_compare_val_object_tag {
   677                          caml_compare_val_object_tag
   678                                  ;; Compare objects in ACCU and SP[0].
   679                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   680                                  ;; Status byte is set according to A.
   681                                  +caml_raise Not_found
   682                          }
   683                          
   684                          !ifdef caml_PRIM__caml_string_eq_neq {           ;caml_compare_val_string_tag is
   685                          caml_string_eq_neq                              ; slower for equality tests
   686                                  LDY # -1
   687                                  DEC .V1 + 1
   688                                  DEC .V2 + 1
   689                                  LDA (.V1),Y
   690                                  CMP (.V2),Y
   691                                  BNE @neq
   692                                  TAX
   693                                  INY                                     ;Y := 0
   694                          --      INC .V1 + 1                             ;loop:
   695                                  INC .V2 + 1                             ; compare strings chr by chr
   696                          -       DEX
   697                                  BEQ +
   698                                  LDA (.V1),Y                             ;1st byte
   699                                  CMP (.V2),Y
   700                                  BNE @neq
   701                                  INY
   702                                  LDA (.V1),Y                             ;2nd byte
   703                                  CMP (.V2),Y
   704                                  BNE @neq
   705                                  INY
   706                                  BEQ --
   707                                  BNE -
   708                          +       LDA (.V1),Y                             ;last word, 1st char
   709                                  CMP (.V2),Y
   710                                  BNE @neq
   711                                  LDY # 0
   712                                  TYA
   713                                  RTS
   714                          @neq    LDY # 0
   715                                  LDA # -1
   716                                  RTS
   717                          }
   718                          
   719                          }       ;; !zone caml_COMPARISONS
   720                          

