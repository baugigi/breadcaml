   250                          ;; i2d-i2f, i31-i34 depend on i30
   251                          
   252                          !macro  i30 .n {                                ;OFFSETCLOSURE n
   253                                  +caml_range -$FE, .n, $FE, "OFFSETCLOSURE n: n"
   254                                  +caml_range 0, .n mod 2, 0, "OFFSETCLOSURE n: n mod 2"
   255                                  .n2h = >(2 * .n)
   256                                  .n2l = <(2 * .n)
