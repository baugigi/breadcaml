   149                          !macro  i16     {+i19 2}
   150                          !macro  i17     {+i19 3}
   151                          !macro  i18     {+i19 4}
   152                          !macro  i1a     {+i09 : +i19 1}                 ;PUSHENVACCi -> PUSH; ENVACC i
   153                          !macro  i1b     {+i09 : +i19 2}
   154                          !macro  i1c     {+i09 : +i19 3}
   155                          !macro  i1d     {+i09 : +i19 4}
   156                          !macro  i1e .n  {+i09 : +i19 .n}                ;PUSHENVACC n -> PUSH; ENVACC n
   157                          !macro  i1f .adr {                              ;PUSHRETADDR adr
   158                                  !set    caml_gen_PHRET = 1
   159                                  LDA # <.adr
   160                                  LDX # >.adr
   161                                  JSR caml_PHRET
   162                          }
