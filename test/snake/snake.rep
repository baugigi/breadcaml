  2283                                          JMP caml_ACCH
  2284                              } else { !set caml_ACC_BGEINT = caml_ACCH }
  2285                            } else { !set caml_ACC_BGEINT = caml_BGTGEINT }
  2286                          }
  2287                                  ;; Pair: ACC7 ($07), BGTINT ($87)
  2288                          !set caml_ACC7_BGTINT = *
  2289                          !ifdef caml_gen_ACC7_BGTINT {
  2290                            !ifdef caml_gen_ACC07 {
  2291                              !ifdef caml_gen_BGTGEINT {
  2292                                          BCC caml_ACC07
  2293                                          ;; fallthrough caml_BGTGEINT
  2294                              } else { !set caml_ACC7_BGTINT = caml_ACC07 }
  2295                            } else { !set caml_ACC7_BGTINT = caml_BGTGEINT }
  2296                          }
  2297                          caml_BGTGEINT                           ;BGTINT and BGEINT
  2298                          !ifdef caml_gen_BGTGEINT {
  2299                                          JSR caml_interp_getarg
  2300                                          TAX
  2301                                          JSR caml_interp_getarg
  2302                                          TAY
  2303                                          TXA
  2304                                          JSR caml_CMP_SGN
  2305                                          BPL caml_BRANCH
  2306                                          CLC:JMP caml_interp_skip2or3by  ;BCC would be out-of-range
  2307                          }
  2308                                  ;; Pair: PUSHACC1 ($0B), BULTINT ($8B)
  2309                          !set caml_PHACC1_BULTINT = *
  2310                          !ifdef caml_gen_PHACC1_BULTINT {
  2311                            !ifdef caml_gen_PHACC17 {
  2312                              !ifdef caml_gen_BULTINT {
  2313                                          BCC caml_PHACC17
  2314                                          ;; fallthrough caml_BULTINT
  2315                              } else { !set caml_PHACC1_BULTINT = caml_PHACC17 }
  2316                            } else { !set caml_PHACC1_BULTINT = caml_BULTINT }
  2317                          }
  2318                          caml_BULTINT
  2319                          !ifdef caml_gen_BULTINT {
  2320                                          JSR caml_interp_getarg
  2321                                          CMP ACCU
  2322                                          JSR caml_interp_getarg
  2323                                          SBC ACCU + 1
  2324                                          BCC caml_BRANCH
  2325                                          CLC:BCC caml_interp_skip2or3by  ;OK: BCC +116
  2326                          }
  2327                                  ;; Pair: PUSHACC2 ($0C), BUGEINT ($8C)
  2328                          !set caml_PHACC2_BUGEINT = *
  2329                          !ifdef caml_gen_PHACC2_BUGEINT {
  2330                            !ifdef caml_gen_PHACC17 {
  2331                              !ifdef caml_gen_BUGEINT {
  2332                                          BCC caml_PHACC17
  2333                                          ;; fallthrough caml_BUGEINT
  2334                              } else { !set caml_PHACC2_BUGEINT = caml_PHACC17 }
  2335                            } else { !set caml_PHACC2_BUGEINT = caml_BUGEINT }
  2336                          }
  2337                          caml_BUGEINT
  2338                          !ifdef caml_gen_BUGEINT {
  2339                                          JSR caml_interp_getarg
  2340                                          CMP ACCU
  2341                                          JSR caml_interp_getarg
  2342                                          SBC ACCU + 1
  2343                                          BCS caml_BRANCH
  2344                                          CLC:BCC caml_interp_skip2or3by
  2345                          }
  2346                                  ;; Pair: ACC0 ($00), OFFSETREF ($80)
  2347                          !set caml_ACC0_OFSREF = *
  2348                          !ifdef caml_gen_ACC0_OFSREF {
  2349                            !ifdef caml_gen_ACC07 {
  2350                              !ifdef caml_gen_OFSREF {
  2351                                          BCC caml_ACC07
  2352                                          JMP caml_OFSREF
  2353                              } else { !set caml_ACC0_OFSREF = caml_ACC07 }
  2354                            } else { !set caml_ACC0_OFSREF = caml_OFSREF }
  2355                          }
  2356                                  ;; Pair: ACC1 ($01), ISINT ($81)
  2357                          !set caml_ACC1_ISINT = *
  2358                          !ifdef caml_gen_ACC1_ISINT {
  2359                            !ifdef caml_gen_ACC07 {
  2360                              !ifdef caml_gen_ISINT {
  2361                                          BCC caml_ACC07
  2362                                          JMP caml_ISINT
  2363                              } else { !set caml_ACC1_ISINT = caml_ACC07 }
  2364                            } else { !set caml_ACC1_ISINT = caml_ISINT }
  2365                          }
  2366                                  ;; Pair: ACC3 ($03), BEQ ($83)
  2367                          !set caml_ACC3_BEQ = *
  2368                          !ifdef caml_gen_ACC3_BEQ {
  2369                            !ifdef caml_gen_ACC07 {
  2370                              !ifdef caml_gen_BEQ {
  2371                                          BCC caml_ACC07
  2372                                          ;; fallthrough caml_BEQ
  2373                              } else { !set caml_ACC3_BEQ = caml_ACC07 }
  2374                            } else { !set caml_ACC3_BEQ = caml_BEQ }
  2375                          }
  2376                          caml_BEQ
  2377                          !ifdef caml_gen_BEQ {
  2378                                          JSR caml_interp_getarg
  2379                                          CMP ACCU
  2380                                          BEQ +
  2381                                          SEC:BCS caml_interp_skip2or3by
  2382                          +               JSR caml_interp_getarg
  2383                                          CMP ACCU + 1
  2384                                          BEQ caml_BRANCH
  2385                                          CLC:BCC caml_interp_skip2or3by
  2386                          }
  2387                                  ;; Pair: ACC4 ($04), BNEQ ($84)
  2388                          !set caml_ACC4_BNEQ = *
  2389                          !ifdef caml_gen_ACC4_BNEQ {
  2390                            !ifdef caml_gen_ACC07 {
  2391                              !ifdef caml_gen_BNEQ {
  2392                                          BCC caml_ACC07
  2393                                          ;; fallthrough caml_BNEQ
  2394                              } else { !set caml_ACC4_BNEQ = caml_ACC07 }
  2395                            } else { !set caml_ACC4_BNEQ = caml_BNEQ }
  2396                          }
  2397                          caml_BNEQ
  2398                          !ifdef caml_gen_BNEQ {
  2399                                          JSR caml_interp_getarg
  2400                                          CMP ACCU
  2401                                          BEQ +
  2402                                          JSR caml_interp_getarg  ;ignore hi byte
  2403                                          JMP caml_BRANCH
  2404                          +               JSR caml_interp_getarg
  2405                                          CMP ACCU + 1
  2406                                          BNE caml_BRANCH
  2407                                          CLC:BCC caml_interp_skip2or3by
  2408                          }
  2409                                  ;; Pair: ACC5 ($05), BLTINT ($85)
  2410                          !set caml_ACC5_BLTINT = *
  2411                          !ifdef caml_gen_ACC5_BLTINT {
  2412                            !ifdef caml_gen_ACC07 {
  2413                              !ifdef caml_gen_BLTLEINT {
  2414                                          BCS caml_BLTLEINT
  2415                                          ;; fallthrough caml_ACC07
  2416                              } else { !set caml_ACC5_BLTINT = caml_ACC07 }
  2417                            } else { !set caml_ACC5_BLTINT = caml_BLTLEINT }
  2418                          }
  2419                          caml_ACC07
  2420                          !ifdef caml_gen_ACC07 {
  2421                                          TAY                     ;Y=2n
  2422                                          JMP caml_ACCL
  2423                          }
  2424                                  ;; Pair: ACC6 ($06), BLEINT ($86)
  2425                          !set caml_ACC6_BLEINT = *
  2426                          !ifdef caml_gen_ACC6_BLEINT {
  2427                            !ifdef caml_gen_ACC07 {
  2428                              !ifdef caml_gen_BLTLEINT {
  2429                                          BCC caml_ACC07
  2430                                          ;; fallthrough caml_BLTLEINT
  2431                              } else { !set caml_ACC6_BLEINT = caml_ACC07 }
  2432                            } else { !set caml_ACC6_BLEINT = caml_BLTLEINT }
  2433                          }
  2434                          caml_BLTLEINT                           ;BLTINT and BLEINT
  2435                          !ifdef caml_gen_BLTLEINT {
  2436                                          JSR caml_interp_getarg
  2437                                          TAX
  2438                                          JSR caml_interp_getarg
  2439                                          TAY
  2440                                          TXA
  2441                                          JSR caml_CMP_SGN
  2442                                          BMI caml_BRANCH
  2443                                          CLC:BCC caml_interp_skip2or3by
  2444                          }
  2445                                          ;; INTERPRETER ROUTINES: branches, arg. fetch, byte skip
  2446                          caml_BRANCH     LDA (PC),Y              ;Branch to *PC
  2447                                          TAX
  2448                                          INC PC
  2449                                          BNE +
  2450                                          INC PC + 1
  2451                          +               LDA (PC),Y
  2452                                          ;; fallthrough caml_interp_start
  2453                          caml_interp_start                       ;ENTRYPOINT: start interpreter
  2454                                          STX PC
  2455                                          STA PC + 1
  2456                                          JMP caml_interp_fetch
  2457                          caml_interp_skip2or3by                  ;Skip next 2 + Carry bytes
  2458                                          LDA # 2
  2459                                          ADC PC
  2460                                          STA PC
  2461                                          BCC +
  2462                                          INC PC + 1
  2463                          +               JMP caml_interp_fetch
  2464                          caml_interp_getarg                      ;Fetch a 1-byte argument
  2465                                          LDA (PC),Y
  2466                                          INC PC
  2467                                          BNE +
  2468                                          INC PC + 1
  2469                          +               RTS
  2470                          caml_INVALID    JMP C64_RESET           ;invalid/unused opcode -> reset
  2471                          
  2472                                          ;; OPCODES JUMPTABLE.
  2473                                          ;; The table is page-aligned. The fetch-exec routine sets C=bit7
  2474                                          ;; of fetched opcode, then accesses this table using 2*opcode as
  2475                                          ;; an index.
  2476                          
  2477                                          !align  $FF, $00
  2478                          caml_interp_jmptbl
  2479                                          ;; $00...$0F/$80...$8F  (UNUSED OPCODES: $0A, $82, $8D, $8E)
  2480                                          !wo caml_ACC0_OFSREF, caml_ACC1_ISINT, caml_ACC07, caml_ACC3_BEQ
  2481                                          !wo caml_ACC4_BNEQ, caml_ACC5_BLTINT, caml_ACC6_BLEINT
  2482                                          !wo caml_ACC7_BGTINT, caml_ACC_BGEINT, caml_PUSH_ULTINT
  2483                                          !wo caml_UGEINT, caml_PHACC1_BULTINT, caml_PHACC2_BUGEINT
  2484                                          !wo caml_PHACC17, caml_PHACC17, caml_PHACC5_STOP
  2485                                          ;; $10...$1F/$90...$94  (UNUSED OPCODES: $90...$94)
  2486                                          !wo caml_PHACC17, caml_PHACC17, caml_PHACC, caml_POPN
  2487                                          !wo caml_ASSIGNH, caml_ENVACC14, caml_ENVACC14, caml_ENVACC14
  2488                                          !wo caml_ENVACC14, caml_ENVACCN, caml_PHENVACC14
  2489                                          !wo caml_PHENVACC14, caml_PHENVACC14, caml_PHENVACC14
  2490                                          !wo caml_PHENVACC, caml_PHRET
  2491                                          ;; $20...$2F
  2492                                          !wo caml_APPLYN, caml_APPLY13, caml_APPLY13, caml_APPLY13
  2493                                          !wo caml_APPTRMN, caml_APPTRM13, caml_APPTRM13, caml_APPTRM13
  2494                                          !wo caml_RETURN, caml_RESTART, caml_GRAB, caml_CLOSURE
  2495                                          !wo caml_CLOSREC, caml_OFSCLM2, caml_OFSCL0, caml_OFSCL2
  2496                                          ;; $30...$3F            (UNUSED OPCODES: $3B, $3D)
  2497                                          !wo caml_OFSCLN, caml_PHOFSCLM2, caml_PHOFSCL0, caml_PHOFSCL2
  2498                                          !wo caml_PHOFSCLN, caml_GETGLB, caml_PHGETGLB, caml_GETGLBFLD
  2499                                          !wo caml_PHGETGLBFLD, caml_SETGLB, caml_ATOM0, caml_INVALID
  2500                                          !wo caml_PHATOM0, caml_INVALID, caml_MKBLKN, caml_MKBLK13
  2501                                          ;; $40...$4F
  2502                                          !wo caml_MKBLK13, caml_MKBLK13, caml_MKFBLK, caml_GETFLD0
  2503                                          !wo caml_GETFLD13, caml_GETFLD13, caml_GETFLD13, caml_GETFLDN
  2504                                          !wo caml_GETFFLDN, caml_SETFLD0, caml_SETFLD13, caml_SETFLD13
  2505                                          !wo caml_SETFLD13, caml_SETFLDN, caml_SETFFLDN, caml_VECLEN
  2506                                          ;; $50...$5F            (UNUSED OPCODE: $5C)
  2507                                          !wo caml_GETVEC, caml_SETVEC, caml_GETCHR, caml_SETCHR
  2508                                          !wo caml_BRANCH, caml_BIF, caml_BIFNOT, caml_SWITCH
  2509                                          !wo caml_BOOLNOT, caml_PHTRP, caml_POPTRP, caml_RAISE
  2510                                          !wo caml_INVALID, caml_CCALL, caml_CCALL, caml_CCALL
  2511                                          ;; $60...$6F
  2512                                          !wo caml_CCALL, caml_CCALL, caml_CCALL, caml_CST03, caml_CST03
  2513                                          !wo caml_CST03, caml_CST03, caml_CSTN, caml_PHCST03
  2514                                          !wo caml_PHCST03, caml_PHCST03, caml_PHCST03, caml_PHCSTN
  2515                                          !wo caml_NEGINT, caml_ADDINT, caml_SUBINT
  2516                                          ;; $70...$7F
  2517                                          !wo caml_MULINT, caml_DIVINT, caml_MODINT, caml_ANDINT
  2518                                          !wo caml_ORINT, caml_XORINT, caml_LSLINT, caml_LSRINT
  2519                                          !wo caml_ASRINT, caml_EQ, caml_NEQ, caml_LTINT, caml_LEINT
  2520                                          !wo caml_GTINT, caml_GEINT, caml_OFSINT
  2521                          } ;ifdef caml_INTERP
  2522                          
  2523                          caml_runtime_end
  2524                          } ;zone caml_RUNTIME
  2525                          

