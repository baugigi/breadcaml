    18                          
    19                          !zone caml_OBJ_OO {
    20                          
    21                          caml_OOID
    22  220d 0100                       !word Val_zero
    23                          
    24                          !ifdef caml_PRIM__caml_obj_is_block {
    25                                  ;; return true if value is a block
    26                                  ;; ACCU = value
    27                          caml_obj_is_block
    28                                  LDA # Val_true
    29                                  LSR ACCU
    30                                  BCC +
    31                                  LDA # Val_false
    32                          +       STA ACCU
    33                                  STY ACCU + 1
    34                                  RTS
    35                          }
    36                          
    37                          !ifdef caml_PRIM__caml_obj_tag {
    38                                  ;; return tag(value)
    39                                  ;; ACCU = value
    40                          caml_obj_tag
    41                                  LDA ACCU
    42                                  BIT caml_is_block
    43                                  BNE @int
    44                                  LDX ACCU + 1
    45                                  CPX # > caml_heap_start
    46                                  BCC @ooh
    47                                  BNE +
    48                                  CMP # < caml_heap_start
    49                                  BCC @ooh
    50                          +       CPX # > caml_heap_end
    51                                  BCC +
    52                                  BNE @ooh
    53                                  CMP # < caml_heap_end
    54                                  BCS @ooh
    55                                  ;; Val_int(tag(ACCU))
    56                          +       LDY # -2
    57                                  DEC ACCU + 1
    58                                  LDA (ACCU),Y
    59                                  SEC
    60                                  ROL
    61                                  STA ACCU
    62                                  LDY # 0
    63                                  STY ACCU + 1
    64                                  ROL ACCU + 1
    65                                  RTS
    66                          @ooh    +Val_Int ~@oohtag, Out_of_heap_tag
    67                                  LDA # > @ohtag
    68                                  LDX # < @oohtag
    69                                  BNE @res                                ;BNE = JMP
    70                          @int    +Val_Int ~@inttag, Int_tag
    71                                  LDA # > @inttag
    72                                  LDX # < @inttag
    73                          @res    STA ACCU + 1
    74                                  STX ACCU
    75                                  RTS
    76                          }
    77                          
    78                          !ifdef caml_PRIM__caml_obj_set_tag {
    79                                  ;; ACCU = value
    80                                  ;; SP[0] = new tag
    81                          caml_obj_set_tag
    82                                  INY
    83                                  LDA (SP),Y
    84                                  LSR
    85                                  DEY
    86                                  LDA (SP),Y
    87                                  ROR
    88                                  LDY # -2
    89                                  DEC ACCU + 1
    90                                  STA (ACCU),Y
    91                                  LDY # <Val_unit
    92                                  STY ACCU
    93                                  DEY
    94                                  STY ACCU + 1
    95                                  RTS
    96                          }
    97                          
    98                          !ifdef caml_PRIM__caml_obj_block {
    99                                  ;; ACCU = tag
   100                                  ;; SP[0] = size
   101                          caml_obj_block
   102                                  INY
   103                                  LDA (SP),Y
   104                                  LSR
   105                                  DEY
   106                                  LDA (SP),Y
   107                                  ROR
   108                                  BNE +
   109                                  ;; return Atom(0) if size = 0
   110                                  LDA # < caml_atom0
   111                                  STA ACCU
   112                                  LDA # > caml_atom0
   113                                  STA ACCU + 1
   114                                  RTS
   115                                  ;; allocate a new block if size > 0
   116                          +       TAX
   117                                  LSR ACCU + 1
   118                                  LDA ACCU
   119                                  ROR
   120                                  JSR caml_alloc
   121                                  LDA BLK
   122                                  STA ACCU
   123                                  LDA BLK + 1
   124                                  STA ACCU + 1
   125                                  ;; fill fields with Val_int(0)
   126                          -       LDA # < Val_zero
   127                                  STA (BLK),Y
   128                                  INY
   129                                  LDA # > Val_zero
   130                                  STA (BLK),Y
   131                                  INY
   132                                  BNE +
   133                                  INC BLK + 1
   134                          +       DEX
   135                                  BNE -
   136                                  LDY # 0
   137                                  RTS
   138                          }
   139                          
   140                          !ifdef caml_PRIM__caml_obj_dup {
   141                                  ;; ACCU = arg
   142                          caml_obj_dup
   143                                  DEY
   144                                  DEC ACCU + 1
   145                                  LDA (ACCU),Y                            ; A := size
   146                                  BEQ @atom                               ; exit if size = 0
   147                                  TAX                                     ; X := size
   148                                  DEY
   149                                  LDA (ACCU),Y                            ; A := tag
   150                                  INC ACCU + 1                            ; restore pointer
   151                                  LDY # 0                                 ;   and Y register
   152                                  JSR caml_alloc                          ; allocate a new block
   153                                  TXA                                     ; A := size
   154                                  ASL
   155                                  TAY                                     ; Y,C := 2 * size
   156                                  JSR caml_blkcpy                         ; copy the blk pointed by ACCU
   157                                  LDA BLK
   158                                  STA ACCU
   159                                  LDA BLK + 1
   160                                  STA ACCU + 1
   161                                  RTS
   162                          @atom   INC ACCU + 1
   163                                  INY
   164                                  RTS
   165                          }
   166                          
   167                          !ifdef caml_PRIM__caml_set_oo_id {
   168                          caml_set_oo_id
   169                                  LDY # 3
   170                                  LDA caml_OOID + 1
   171                                  STA (ACCU),Y
   172                                  DEY
   173                                  LDA caml_OOID
   174                                  STA (ACCU),Y
   175                                  LDY # 0
   176                                  CLC
   177                                  ADC # 2
   178                                  STA caml_OOID
   179                                  BCC +
   180                                  INC caml_OOID + 1
   181                          +       RTS
   182                          }
   183                          
   184                          !ifdef caml_PRIM__caml_fresh_oo_id {
   185                          caml_fresh_oo_id
   186  220f ad0e22                     LDA caml_OOID + 1
   187  2212 852d                       STA ACCU + 1
   188  2214 ad0d22                     LDA caml_OOID
   189  2217 852c                       STA ACCU
   190  2219 18                         CLC
   191  221a 6902                       ADC # 2
   192  221c 8d0d22                     STA caml_OOID
   193  221f 9003                       BCC +
   194  2221 ee0e22                     INC caml_OOID + 1
   195  2224 60                 +       RTS
   196                          }
   197                          
   198                          !ifdef caml_PRIM__caml_int_as_pointer {
   199                                  ;; ACCU = n
   200                          caml_int_as_pointer
   201                                  DEC ACCU
   202                                  RTS
   203                          }
   204                          
   205                          !ifdef caml_PRIM__caml_obj_truncate {
   206                                  ;; truncate a block to newsize
   207                                  ;; ACCU = value
   208                                  ;; SP[0] = newsize
   209                          
   210                                  ;; Obj.truncate is deprecated!
   211                          
   212                                  ;; WARNING: Obj.truncate o s  when  Obj.size o = s + 1
   213                                  ;; will leave an atom on the heap, which could cause the garbage
   214                                  ;; collector to crash if it is reachable from some root!
   215                          
   216                          caml_obj_truncate
   217                                  @NEWSZ = TMP
   218                                  ;; load tag and size
   219                                  DEY
   220                                  DEC ACCU + 1
   221                                  LDA (ACCU),Y
   222                                  TAX                                     ;X := size
   223                                  DEY
   224                                  LDA (ACCU),Y
   225                                  CMP # Double_array_tag
   226                                  BEQ @floatarray
   227                                  ;; calculate Int_val(newsize)
   228                                  LDY # 1
   229                                  LDA (SP),Y
   230                                  DEY
   231                                  LSR
   232                                  BNE @error                              ;error if newsize > 255 or < 0
   233                                  LDA (SP),Y
   234                                  ROR
   235                                  BEQ @error                              ;error if newsize = 0
   236                                  STA @NEWSZ
   237                                  CPX @NEWSZ
   238                                  BEQ @exit                               ;exit if newsize = size
   239                                  BCC @error                              ;error if newsize > size
   240                                  ;; 0 < NEWSZ < size, write NEWSZ into header
   241                          @trunc  DEY
   242                                  STA (ACCU),Y
   243                                  INC ACCU + 1
   244                                  ;; set (ACCU),Y to point to Field(ACCU, newsize)
   245                                  ASL
   246                                  BCC +
   247                                  INC ACCU + 1
   248                          +       TAY
   249                                  ;; header for the leftovers: tag = No_scan_tag, sz = size-1-newsize
   250                                  ;; WARNING: sz could be 0, the GC won't be happy if block is reachable!
   251                                  LDA # No_scan_tag
   252                                  STA (ACCU),Y                            ;tag = No_scan_tag
   253                                  INY
   254                                  DEX
   255                                  TXA
   256                                  SEC
   257                                  SBC @NEWSZ                              ;sz = size-1-NEWSZ
   258                                  STA (ACCU),Y
   259                          @exit   LDY # <Val_unit
   260                                  STY ACCU                                ;ACCU := ()
   261                                  DEY
   262                                  STY ACCU + 1
   263                                  RTS
   264                                  ;; calculate Int_val(newsize) * Double_wosize
   265                          @floatarray
   266                                  LDY # 1
   267                                  LDA (SP),Y
   268                                  BNE @error                              ;error if newsize > 127 or < 0
   269                                  DEY
   270                                  LDA (SP),Y
   271                                  AND # %11111110                         ;A = 2 * newsize
   272                                  BEQ @error                              ;error if newsize = 0
   273                                  STA @NEWSZ                              ;NEWSZ = 2 * newsize
   274                                  LSR
   275                                  ;CLC                                    ;C=0 because of previous AND
   276                                  ADC @NEWSZ                              ;A = Double_wosize * newsize
   277                                  BCS @error                              ;error if > 255
   278                                  STA @NEWSZ                              ;NEWSZ=Double_wosize * newsize
   279                                  CPX @NEWSZ
   280                                  BEQ @exit                               ;exit if NEWSZ = size
   281                                  BCS @trunc                              ;error if NEWSZ > size
   282                          @error  +caml_raise Invalid_argument, "Obj.truncate"
   283                          }
   284                          
   285                          !ifdef caml_PRIM__caml_obj_add_offset {
   286                                  ;; ACCU = value
   287                                  ;; SP[0] = offset
   288                          caml_obj_add_offset
   289                                  LDA (SP),Y
   290                                  STA TMP
   291                                  INY
   292                                  LDA (SP),Y
   293                                  STA TMP + 1
   294                                  DEY
   295                                  LSR TMP + 1
   296                                  ROR TMP
   297                                  CLC
   298                                  LDA TMP
   299                                  ADC ACCU
   300                                  STA ACCU
   301                                  LDA TMP + 1
   302                                  ADC ACCU + 1
   303                                  STA ACCU + 1
   304                                  RTS
   305                          }
   306                          
   307                          !ifdef caml_PRIM__caml_lazy_follow_forward {
   308                                  ;; ACCU = value
   309                          caml_lazy_follow_forward
   310                                  ;; is value a block?
   311                                  LDA ACCU
   312                                  BIT caml_is_block
   313                                  BNE @exit
   314                                  ;; tag(value) = Forward_tag?
   315                                  LDY # -2
   316                                  DEC ACCU + 1
   317                                  LDA (ACCU),Y
   318                                  INC ACCU + 1
   319                                  LDY # 0
   320                                  CMP # Forward_tag
   321                                  BNE @exit
   322                                  ;; is value in heap?
   323                                  SEC
   324                                  LDA # < caml_heap_start
   325                                  SBC ACCU
   326                                  STA TMP
   327                                  LDA # > caml_heap_start
   328                                  SBC ACCU + 1
   329                                  STA TMP + 1
   330                                  LDA TMP
   331                                  CMP # < caml_heap_sz
   332                                  LDA TMP + 1
   333                                  SBC # > caml_heap_sz
   334                                  BCS @exit
   335                                  ;; ACCU <- Field(value,0)
   336                                  LDA (ACCU),Y
   337                                  TAX
   338                                  INY
   339                                  LDA (ACCU),Y
   340                                  STA ACCU + 1
   341                                  STX ACCU
   342                                  DEY
   343                          @exit   RTS
   344                          }
   345                          
   346                          !ifdef caml_PRIM__caml_lazy_make_forward {
   347                                  ;; ACCU = value
   348                          caml_lazy_make_forward
   349                                  LDA # Forward_tag
   350                                  LDX # 1
   351                                  JSR caml_alloc
   352                                  LDA ACCU
   353                                  STA (BLK),Y
   354                                  INY
   355                                  LDA ACCU + 1
   356                                  STA (BLK),Y
   357                                  DEY
   358                                  LDA BLK
   359                                  STA ACCU
   360                                  LDA BLK + 1
   361                                  STA ACCU + 1
   362                                  RTS
   363                          }
   364                          
   365                          }      ;; !zone caml_OBJ_OO
   366                          
   368                                  
   369                          

