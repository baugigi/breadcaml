   116                          C64_CNTDN       = $A5   ;Cassette Sync Countdown
   117                          C64_BUFPNT      = $A6   ;Pointer: Tape I/O Buffer
   118                          C64_INBIT       = $A7   ;RS-232 Input Bits / Cassette Temp
