   583  0ba0 20880c                     JSR @get_ACCU_field0            ;  /* no args */
   584  0ba3 20990c                     JSR @pr_exn                     ;  print Field(ACCU,0) /* exn_name */
   585  0ba6 4cf809                     JMP caml_end                    ;  exit
   586  0ba9 0dc5584345505449...@uncght !text 13, "Exception: ", 0
   587                          
   588  0bb6 20880c             @args   JSR @get_ACCU_field0            ;else /* one or more args */
   589  0bb9 a000                       LDY # 0
   590  0bbb 208e0c                     JSR @get_field
   591  0bbe 20990c                     JSR @pr_exn                     ;  print Field(Field(ACCU,0),0)
   592  0bc1 a551                       LDA @sz    
   593  0bc3 c902                       CMP # 2                         ;  if size(ACCU) = 2
   594  0bc5 d029                       BNE @norm
   595  0bc7 a5fc                       LDA ACCU + 1
   596  0bc9 a6fb                       LDX ACCU
   597  0bcb a002                       LDY # 2
   598  0bcd 208e0c                     JSR @get_field
   599  0bd0 8550                       STA @fld1 + 1
   600  0bd2 864f                       STX @fld1
   601  0bd4 8a                         TXA
