     9                          ;; Check for out-of-range argument
    10                          !macro caml_range .min, .arg, .max, .txt {
    11                            !if (.arg < .min) | (.arg > .max) {
    12                                  !error .txt + " = ", .arg, " out of range [", .min, ", ", .max, "]"
    13                            }
    14                          }
    15                          
    16                          ;; These shouldn't be necessary: ocamlc should have already given up
    17                          !macro  i82     {!serious "ERROR: Objects and classes not implemented"}
    18                          !macro  i8d .t  {!serious "ERROR: Objects and classes not implemented"}
    19                          !macro  i8e     {!serious "ERROR: Objects and classes not implemented"}
    20                          
