   156                          !ifdef caml_PRIM__caml_nonstd_scr_poke {
   157                          caml_nonstd_scr_poke
   158  595e 200259                     JSR caml_scr_offset
   159                                  +caml_scr_addr_screen

; ******** macro from /home/piero/.opam/LTS/lib/bcaml/c64lib_screen.asm
