     7                           !source "/home/pifu/.opam/LTS/lib/bcaml/stdlib_dummy.asm"

; ******** Source: /home/pifu/.opam/LTS/lib/bcaml/stdlib_dummy.asm
     1                          ;;; -----------------------------------------------------------
     2                          :;; ALLOC DUMMY (ocaml-4.04.1/byterun/alloc.c)
     3                          ;;; -----------------------------------------------------------
     4                          
     5                          !zone caml_DUMMY {
     6                          
     7                          !ifdef caml_PRIM__caml_alloc_dummy_function {
     8                          caml_alloc_dummy_function = caml_alloc_dummy
     9                          }
    10                          !ifdef caml_PRIM__caml_alloc_dummy {
    11                                  ;; allocate a dummy block for a recursive value (or function)
    12                                  ;; ACCU = size, (SP[0] = function arity, ignored)
    13                          caml_alloc_dummy
    14                                  LSR ACCU + 1
    15                                  LDA ACCU
    16                                  ROR
    17                                  BEQ +                           ; size = 0
    18                                  ;; allocate block
    19                                  TAX
    20                                  TYA
    21                                  JSR caml_alloc
    22                                  LDA BLK
    23                                  STA ACCU
    24                                  LDA BLK + 1
    25                                  STA ACCU + 1
    26                                  RTS
    27                                  ;; Atom(0)
    28                          +       LDA # < caml_atom0
    29                                  STA ACCU
    30                                  LDA # > caml_atom0
    31                                  STA ACCU + 1
    32                                  RTS
    33                          }
    34                          
    35                          !ifdef caml_PRIM__caml_alloc_dummy_float {
    36                                  ;; allocate a dummy block for a recursive array/record of floats
    37                                  ;; ACCU = no. of floats
    38                          caml_alloc_dummy_float
    39                                  ;; ignore ACCU + 1, as 0 <= no. of floats <= 85
    40                                  LDA ACCU
    41                                  LSR
    42                                  BEQ +                           ; Atom(0)
    43                                  ;; X <- no. of floats * Double_wosize
    44                                  CLC
    45                                  ADC ACCU
    46                                  TAX
    47                                  DEX
    48                                  ;; allocate block
    49                                  TYA                             ; A = Y = 0
    50                                  JSR caml_alloc
    51                                  LDA BLK
    52                                  STA ACCU
    53                                  LDA BLK + 1
    54                                  STA ACCU + 1
    55                                  RTS
    56                                  ;; Atom(0)
    57                          +       LDA # < caml_atom0
    58                                  STA ACCU
    59                                  LDA # > caml_atom0
    60                                  STA ACCU + 1
    61                                  RTS
    62                          }
    63                          
    64                          !ifdef caml_PRIM__caml_update_dummy {
    65                                  ;; update a dummy block with given value
    66                                  ;; ACCU = dummy, SP[0] = newval
    67                          caml_update_dummy
    68                                  ;; load newval size
    69                                  LDA (SP),Y
    70                                  STA TMP
    71                                  INY
    72                                  LDA (SP),Y
    73                                  STA TMP + 1
    74                                  LDY # -1
    75                                  DEC TMP + 1
    76                                  LDA (TMP),y
    77                                  BNE +
    78                                  ;; size = 0, update nothing
    79                                  INY                             ; Y = 0
    80                                  BEQ ++
    81                                  ;; tag(dummy) <- tag(newval)
    82                          +       TAX                             ; save size
    83                                  DEY
    84                                  DEC ACCU + 1
    85                                  LDA (TMP),y
    86                                  STA (ACCU),y
    87                                  INC ACCU + 1
    88                                  INC TMP + 1
    89                                  ;; copy newval fields into dummy ones
    90                                  TXA                             ; reload size
    91                                  ASL
    92                                  TAY                             ; Y = 2 * size, Carry = MSB
    93                                  JSR caml_blkcpy
    94                                  ;; ACCU <- ()
    95                          ++      STY ACCU + 1                    ; Y = 0
    96                                  LDA # <Val_unit
    97                                  STA ACCU
    98                                  RTS
    99                          }
   100                          
   101                          }       ;; !zone caml_DUMMY
   102                          

