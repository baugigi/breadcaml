    18                          
    19                          !zone caml_STRINGS {
    20                          
    21                          !ifdef caml_PRIM__caml_string_of_bytes {
    22                          caml_string_of_bytes = caml_bytes_of_string
    23                          }
    24                          !ifdef caml_PRIM__caml_bytes_of_string {
    25                          caml_bytes_of_string
    26  22c7 60                         RTS
    27                          }
    28                          
    29                          !ifdef caml_PRIM__caml_create_bytes {
    30                          caml_create_bytes = caml_create_string
    31                          }
    32                          !ifdef caml_PRIM__caml_create_string {
    33                          caml_create_string
    34                                  ;; ACCU = length
    35                                  ;; alloc a new block for a string of given length (max 509)
    36                          
    37  22c8 a52d                       LDA ACCU + 1                            ;load >length
    38  22ca 4a                         LSR                                     ;
    39  22cb 662c                       ROR ACCU                                ;ACCUl,A := Int_val(lenght)
    40  22cd 4a                         LSR
    41  22ce d02d                       BNE +++                                 ;A>0 => len > max, raise exn.
    42  22d0 662c                       ROR ACCU                                ;ACCUl :=  Int_val(lenght) / 2
    43  22d2 08                         PHP                                     ;save carry (remainder)
    44  22d3 a62c                       LDX ACCU                                ;X := block size, in words
    45  22d5 e8                         INX                                     ;take into account Ocaml padding
    46  22d6 f024                       BEQ ++                                  ;Exception if size > 255
    47  22d8 a9fc                       LDA # String_tag                        ;load tag
    48  22da 20111f                     JSR caml_alloc                          ;allocate block
    49  22dd a557                       LDA BLK
    50  22df 852c                       STA ACCU
    51  22e1 a558                       LDA BLK + 1
    52  22e3 852d                       STA ACCU + 1                            ;ACCU := address of new block
    53  22e5 ca                         DEX                                     ;Compute the padding bytes:
    54  22e6 8a                         TXA                                     ;A := size - 1
    55  22e7 0a                         ASL                                     ;A := 2 * size - 2
    56  22e8 9002                       BCC +
    57  22ea e658                       INC BLK + 1
    58  22ec a8                 +       TAY                                     ;BLK+.Y = address of last word
    59  22ed a900                       LDA # 0
    60  22ef 28                         PLP                                     ;reload .C flag
    61  22f0 b004                       BCS +                                   ;string length is odd?
    62  22f2 9157                       STA (BLK),Y                             ;no: padding = "\000\001"
    63  22f4 a901                       LDA # 1
    64  22f6 c8                 +       INY                                     ;yes: padding = "\000"
    65  22f7 9157                       STA (BLK),Y
    66  22f9 a000                       LDY # 0
    67  22fb 60                         RTS
    68  22fc 28                 ++      PLP
    69                          +++     +caml_raise Invalid_argument, "String.create"

