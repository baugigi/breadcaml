    12                          	!source "/home/piero/.opam/LTS/lib/bcaml/stdlib_random.asm" 

; ******** Source: /home/piero/.opam/LTS/lib/bcaml/stdlib_random.asm
     1                          ;; ——————————————————————————————————————————————————————————————————————
     2                          ;; The BreadCaml Project / Progetto BreadCaml
     3                          ;; Copyright (C) 21-Apr-2026 Piero Furiesi
     4                          ;; 
