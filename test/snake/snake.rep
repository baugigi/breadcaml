   112                          () : unit
   113                          
   115                          ;; BLOCKS:     .__Pointer__.   16-bit word-aligned pointers, lsb=0
   116                          ;;             |_lo_0¦__hi_|
   117                          ;;            /
   118                          ;; .__Header_*___Fld(0)__.___Fld(1)__._ _._Fld(Sz-1)_.
   119                          ;; |Tag_¦_Sz_|___Value___|___Value___|···|___Value___|
   120                          
   121                                  ;; BIT caml_is_block will set Z=1 <=> A is a block
   122                          !addr   caml_is_block   = .isblk + 1
   123                          
   124                                  Custom_tag      = 255            ;custom block
   125                                  Double_array_tag= 254            ;array of unboxed floats
   126                                  Double_tag      = 253            ;float
   127                                  String_tag      = 252            ;string
   128                                  Abstract_tag    = 251            ;abstract
   129                                  No_scan_tag     = 251            ;tag >= No_scan_tag ==> no GC scan
   130                                  Forward_tag     = 250            ;lazy value, fwd ptr
   131                                  Infix_tag       = 249            ;rec.closuse; lsb=1 ==> no GC scan
   132                                  Object_tag      = 248            ;object/exception
   133                                  Closure_tag     = 247            ;closure
   134                                  Lazy_tag        = 246            ;lazy value
   135                          
   137                          ;; ATOM(0):    .Tag_Sz_*                 ;Atom(t) with t>0 not allowed, as no
   138                          ;;             |_0_¦_0_|                 ; OCaml value is represented as such
   139                          
   140                                  ;; Statically allocated, word-aligned
   141                          !addr   caml_atom0 = .zeroes + 2 + .zeroes % 2
   142                          
   144                          ;; FLOAT blocks: C64 MFLP representation, not IEEE!
   145                          ;; .Tag_Sz_*_________._________._________.
   146                          ;; |253¦_3_|Expo¦±M_a|_n_t¦_i_s|_s_a¦_Fl_|      Fl = special value flag
   147                          ;;
   148                          ;; Byte 5 (Fl) tells whether the float is finite or one of the IEEE special
   149                          ;; values. The encoding allows a fast test (LDA/ORA + BNE) and makes the flag
   150                          ;; the signed ordering key of the special values (nan < -inf < finite < +inf):
   151                          ;;   $00 finite    $01 +infinity    $FF -infinity    $80 nan
   152                          ;; Two's complement negation of the flag is the negation of the float (it
   153                          ;; swaps +-inf, and keeps $00 and $80 unchanged). Bytes 0-4 of the special
   154                          ;; values are canonical, so routines ignoring the flag degrade gracefully:
   155                          ;;   +-infinity = largest magnitude ($FF, +-$FFFFFFFF), nan = 0.0 ($00...).
   156                          
   157                                  Double_wosize   = 3
   158                                  Float_flag      = 5             ;offset of the flag byte in the block
   159                                  Fl_pinf         = $01
   160                                  Fl_ninf         = $FF
   161                                  Fl_nan          = $80
   162                          
   163                          !macro  caml_move_float .from, .to {     ;Copy float block fields and set Y = 0
   164                                  LDY # 2 * Double_wosize - 1      ; at exit
   165                          -       LDA (.from),Y
   166                                  STA (.to),Y
   167                                  DEY
   168                                  BPL -
   169                                  INY
   170                          }
   171                          
   173                          ;; STRING blocks: length = 2 * Sz - 1 - last byte;
   174                          ;; .Tag_Sz_*___________.___________.___________.
   175                          ;; |252¦_3_|_'O'_¦_'C'_|_'a'_¦_'m'_|_'l'_¦__0__| "OCaml" length=2*3-1-0=5
   176                          ;; .Tag_Sz_*___________.___________.___________.
   177                          ;; |252¦_3_|_'C'_¦_'='_|_'6'_¦_'4'_|__0__¦__1__| "C=64"  length=2*3-1-1=4
   178                          
   179                          !macro  caml_string .str {              ;Assemble the string .str with proper
   180                                  !text .str, 0                   ; trailing byte(s)
   181                                  !if len(.str) % 2 = 0 { !byte 1 }
   182                          }
   183                          
   185                          ;; CLOSURE/RECURSIVE CLOSURE blocks: Sz = 2 * nfun - 1 + nvar
   186                          ;; .Tag_Sz_*0______.Tag_Sz_*1______.Tag_Sz_*2______._ _.______.______._
   187                          ;; |247¦Sz_|_code0_|249¦_2_|_code1_|249¦_4_|_code2_|···|_Var0_|_Var1_|_···
   188                          ;;                  /    \___________/___\___ # of words from *0 to *i = 2i
   189                          ;; Infix_tag_______/________________/
   190                          
   192                          ;; EXCEPTION blocks:
   193                          ;; .Tag_Sz_*____________._____.
