   382                          !ifdef caml_PRIM__caml_float_of_int {
   383                          caml_float_of_int
   384                                  LDA ACCU + 1
   385                                  CMP # $80                       ;CMP + ROR = arithm. shift right
   386                                  ROR
   387                                  TAX
   388                                  ROR ACCU
   389                                  LDY ACCU
   390                                  TXA
   391                                  +caml_JSR_BASROM C64_GIVAYF
   392                                  JMP caml_float_alloc_result
   393                          }
