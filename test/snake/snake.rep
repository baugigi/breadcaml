   439                                  STY C64_FAC + 5                 ;clear FAC sign
   440                                  STY C64_FACRND                  ;clear FAC round byte
   441                                  LDA # 64 + $80
   442                                  STA C64_FAC                     ;set exponent (64)
   443                                  LDY # 6
   444                                  LDX # 3
   445                          -       LDA (ACCU),Y                    ;copy int64 hi bytes into FAC mantissa
   446                                  STA C64_FAC + 1,X
   447                                  INY
   448                                  DEX
   449                                  BPL -
   450                                  EOR # $80
