   184  574b 4a                         LSR
   185  574c 88                         DEY
   186  574d b1fd                       LDA (SP),Y
   187  574f 6a                         ROR
   188                                  ;; start substitution
   189  5750 a000                       LDY # 0
   190  5752 a64d                       LDX TMP
   191  5754 91fb               --      STA (ACCU),Y                    ;modify string in place
   192  5756 ca                         DEX
   193  5757 f008                       BEQ +
   194  5759 c8                 -       INY
   195  575a d0f8                       BNE --
   196  575c e6fc                       INC ACCU + 1
   197  575e 4c5457                     JMP --
   198  5761 e44e               +       CPX TMP + 1
   199  5763 f005                       BEQ ++
   200  5765 c64e                       DEC TMP + 1
   201  5767 4c5957                     JMP -
   202  576a a001               ++      LDY # <Val_unit
   203  576c 84fb                       STY ACCU
   204  576e 88                         DEY
   205  576f 84fc                       STY ACCU + 1                    ;return ()
   206  5771 60                         RTS
   207                          }
