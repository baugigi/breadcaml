   618                          !ifdef caml_PRIM__caml_array_blit {
   619                          caml_array_blit
   620                                  ;; copy a subarray to other one (source and dest may overlap)
   621                                  ;; ACCU = arr1
   622                                  ;; SP[0] = ofs1
   623                                  ;; SP[1] = arr2
   624                                  ;; SP[2] = ofs2
   625                                  ;; SP[3] = n
   626                          @NBY    = TMP + 2
   627                                  ;; load tag
   628                                  LDY # -2
   629                                  DEC ACCU + 1
   630                                  LDA (ACCU),Y
   631                                  INC ACCU + 1
   632                                  ;; check if float
   633                                  CMP # Double_array_tag
   634                                  BNE @no_float
   635                                  ;; array of floats, compute source start address
   636                                  LDY # 0
   637                                  STY @NBY + 1
   638                                  LDA (SP),Y                      ; ofs1, ignore hi byte
   639                                  AND # $FE
   640                                  STA TMP
   641                                  LSR
   642                                  CLC
   643                                  ADC TMP
   644                                  ;; ACCU <- &arr1[ofs1]
   645                                  ASL                             ; A = 6 * ofs1
   646                                  BCC +
   647                                  INC ACCU + 1
   648                                  CLC
   649                          +       ADC ACCU
   650                                  STA ACCU
   651                                  BCC +
   652                                  INC ACCU + 1
   653                                  ;; compute destination start address
   654                          +       LDY # 4
   655                                  LDA (SP),Y                      ; ofs2, ignore hi byte
   656                                  ;; calc 3 * index
   657                                  AND # $FE
   658                                  STA TMP
   659                                  LSR
   660                                  CLC
   661                                  ADC TMP
   662                                  ;; TMP <- &arr2[ofs2]
   663                                  TAX                             ; X = 3 * ofs2
   664                                  DEY
   665                                  LDA (SP),Y
   666                                  STA TMP + 1
   667                                  TXA
   668                                  ASL                             ; A = 6 * ofs2
   669                                  BCC +
   670                                  INC TMP + 1
   671                                  CLC
   672                          +       DEY
   673                                  ADC (SP),Y
   674                                  STA TMP
   675                                  BCC +
   676                                  INC TMP + 1
   677                                  ;; @NBY = 6 * n (no. of bytes to be moved)
   678                          +       LDY # 6
   679                                  LDA (SP),Y                      ; ignore hi byte
   680                                  AND # $FE
   681                                  STA @NBY
   682                                  LSR
   683                                  CLC
   684                                  ADC @NBY
   685                                  STA @NBY
   686                                  BCC +
   687                                  INC @NBY + 1
   688                          +       JMP @copy
   689                          @no_float
   690                                  ;; ordinary array, compute source start address
   691                                  LDY # 0
   692                                  CLC
   693                                  LDA (SP),Y
   694                                  ADC ACCU
   695                                  STA ACCU
   696                                  INY
   697                                  LDA (SP),Y
   698                                  ADC ACCU + 1
   699                                  STA ACCU + 1
   700                                  LDA ACCU
   701                                  BNE +
   702                                  DEC ACCU + 1
   703                          +       DEC ACCU
   704                                  ;; compute destination start address
   705                                  INY
   706                                  LDA (SP),Y
   707                                  STA TMP
   708                                  INY
   709                                  LDA (SP),Y
   710                                  STA TMP + 1
   711                                  INY
   712                                  CLC
   713                                  LDA TMP
   714                                  ADC (SP),Y
   715                                  STA TMP
   716                                  INY
   717                                  LDA TMP + 1
   718                                  ADC (SP),Y
   719                                  STA TMP + 1
   720                                  LDA TMP
   721                                  BNE +
   722                                  DEC TMP + 1
   723                          +       DEC TMP
   724                                  ;; compute no. of bytes to be copied
   725                                  INY
   726                                  LDA @NBY
   727                                  ADC (SP),Y
   728                                  STA @NBY
   729                                  INY
   730                                  LDA @NBY + 1
   731                                  ADC (SP),Y
   732                                  STA @NBY + 1
   733                                  LDA @NBY
   734                                  BNE +
   735                                  DEC @NBY + 1
   736                          +       DEC @NBY
   737                                  ;; copy bytes from source to destination
   738                          @copy   LDA ACCU
   739                                  CMP TMP
   740                                  LDA ACCU + 1
   741                                  SBC TMP + 1
   742                                  BCS @cpydn
   743                                  ;; ACCU < TMP, copy memory up (arr1[0] last)
   744                                  LSR @NBY + 1
   745                                  LDY @NBY
   746                                  JSR caml_blkcpy
   747                                  ;; ACCU <- ()
   748                          @done   STY ACCU + 1                    ; Y = 0
   749                                  LDA # <Val_unit
   750                                  STA ACCU
   751                                  RTS
   752                                  ;; ACCU >= TMP, copy memory down (arr1[0] first)
   753                          @cpydn  LDX @NBY + 1                    ; 0 or 1
   754                                  BEQ +
   755                                  LDY # 0
   756                          -       LDA (ACCU),Y                    ; >255 bytes: copy a whole page
   757                                  STA (TMP),Y
   758                                  INY
   759                                  BNE -
   760                                  INC ACCU + 1
   761                                  INC TMP + 1
   762                          +       LDX @NBY
   763                                  BEQ +
   764                          -       LDA (ACCU),Y                    ; copy the remaining bytes
   765                                  STA (TMP),Y
   766                                  INY
   767                                  DEX
   768                                  BNE -
   769                          +       LDY # 0
   770                                  JMP @done
   771                          }
   772                          
   773                          !ifdef caml_PRIM__caml_array_sub {
   774                          caml_array_sub
   775                                  ;; allocate and return a subarray
   776                                  ;; ACCU = a
   777                                  ;; SP[0] = ofs
   778                                  ;; SP[1] = n
   779                          @NBY    = TMP
   780                                  ;; load tag
   781                                  LDY # -2
   782                                  DEC ACCU + 1
   783                                  LDA (ACCU),Y
   784                                  INC ACCU + 1
   785                                  ;; check if float
   786                                  CMP # Double_array_tag
   787                                  BNE @no_floats
   788                                  ;; array of floats, compute source start address
   789                                  LDY # 0                         ; ignore hi byte
   790                                  STY @NBY + 1
   791                                  LDA (SP),Y
   792                                  AND # $FE
   793                                  STA TMP
   794                                  LSR
   795                                  CLC
   796                                  ADC TMP
   797                                  ;; ACCU <- &arr1[ofs1]
   798                                  ASL                             ; A = 6 * ofs1
   799                                  BCC +
   800                                  INC ACCU + 1
   801                                  CLC
   802                          +       ADC ACCU
   803                                  STA ACCU
   804                                  BCC +
   805                                  INC ACCU + 1
   806                                  ;; @NBY = 6 * n (no. of bytes to be moved)
   807                          +       LDY # 2
   808                                  LDA (SP),Y                      ; ignore hi byte
   809                                  AND # $FE
   810                                  STA @NBY
   811                                  LSR
   812                                  CLC
   813                                  ADC @NBY
   814                                  STA @NBY
   815                                  BCC +
   816                                  INC @NBY + 1
   817                                  ;; allocate subarray
   818                          +       LDA @NBY + 1
   819                                  LSR
   820                                  LDA @NBY
   821                                  ROR
   822                                  TAX
   823                                  LDA # Double_array_tag
   824                                  JSR caml_alloc
   825                                  JMP @copy
   826                          @no_floats
   827                                  ;; ordinary array, compute source start address
   828                                  LDY # 0
   829                                  CLC
   830                                  LDA ACCU
   831                                  ADC (SP),Y
   832                                  STA ACCU
   833                                  INY
   834                                  LDA ACCU + 1
   835                                  ADC (SP),Y
   836                                  STA ACCU + 1
   837                                  LDA ACCU
   838                                  BNE +
   839                                  DEC ACCU + 1
   840                          +       DEC ACCU
   841                                  ;; compute no. of bytes to be copied
   842                                  INY
   843                                  LDA (SP),Y
   844                                  STA @NBY
   845                                  INY
   846                                  LDA (SP),Y
   847                                  STA @NBY + 1
   848                                  LDA @NBY
   849                                  BNE +
   850                                  DEC @NBY + 1
   851                          +       DEC @NBY
   852                                  ;; allocate subarray
   853                                  LDA @NBY + 1
   854                                  LSR
   855                                  LDA @NBY
   856                                  ROR
   857                                  TAX
   858                                  LDA # 0
   859                                  JSR caml_alloc
   860                                  ;; copy bytes from source to destination
   861                          @copy   LSR @NBY + 1
   862                                  LDY @NBY
   863                                  JSR caml_blkcpy
   864                                  ;; ACCU <- subarray
   865                          @done   LDA BLK
   866                                  STA ACCU
   867                                  LDA BLK + 1
   868                                  STA ACCU + 1
   869                                  RTS
   870                          }
   871                          
   872                          !ifdef caml_PRIM__caml_array_append {
   873                          caml_array_append
   874                                  ;; append two arrays
   875                                  ;; ACCU = arr1
   876                                  ;; SP[0] = arr2
   877                          @AUX    = TMP
   878                          @SIZE1  = TMP + 2
   879                          @SIZE2  = TMP + 4
   880                                  ;; load sizes
   881                                  LDA (SP),Y
   882                                  STA @AUX
   883                                  INY
   884                                  LDA (SP),Y
   885                                  STA @AUX + 1
   886                                  LDY # -1
   887                                  DEC ACCU + 1
   888                                  DEC @AUX + 1
   889                                  LDA (ACCU),Y
   890                                  STA @SIZE1
   891                                  LDA (@AUX),Y
   892                                  STA @SIZE2
   893                                  CLC
   894                                  ADC @SIZE1
   895                                  BCC +
   896                                  ;; exception if total size > 255
   897                                  INY                             ; Y = 0
   898                                  JMP @error
   899                                  ;; load tag and allocate
   900                          +       DEY
   901                                  TAX                             ; size
   902                                  LDA (ACCU),Y                    ; tag
   903                                  JSR caml_alloc
   904                                  ;; copy arr1 to dest
   905                                  INC ACCU + 1
   906                                  LDA @SIZE1
   907                                  ASL
   908                                  TAY
   909                                  JSR caml_blkcpy
   910                                  ;; ACCU <- arr2
   911                                  LDA @AUX
   912                                  STA ACCU
   913                                  LDA @AUX + 1
   914                                  STA ACCU + 1
   915                                  ;; save ptr to result
   916                                  LDA BLK
   917                                  STA @AUX
   918                                  LDA BLK + 1
   919                                  STA @AUX + 1
   920                                  ;; TMP <- &TMP[SIZE1]
   921                          +       LDA @SIZE1
   922                                  ASL
   923                                  BCC +
   924                                  INC BLK + 1
   925                                  CLC
   926                          +       ADC BLK
   927                                  STA BLK
   928                                  BCC +
   929                                  INC BLK + 1
   930                                  ;; copy arr2 to dest
   931                          +       LDA @SIZE2
   932                                  ASL
   933                                  TAY
   934                                  JSR caml_blkcpy
   935                                  ;; ACCU <- AUX
   936                                  LDA @AUX
   937                                  STA ACCU
   938                                  LDA @AUX + 1
   939                                  STA ACCU + 1
   940                                  RTS
   941                          @error  +caml_raise Invalid_argument, "Array.append"
   942                          }
   943                          
   944                          !ifdef caml_PRIM__caml_array_concat {
   945                          caml_array_concat
   946                                  ;; concatenate all arrays in a list
   947                                  ;; ACCU = list
   948                          @TAG    = TMP
   949                          @SIZE   = TMP + 1
   950                          @HEAD   = TMP + 2
   951                          @TAIL   = TMP + 4
   952                          @RESULT = TMP + 2
   953                                  DEY
   954                                  STY @TAG                        ; @TAG = -1
   955                                  INY
   956                                  STY @SIZE
   957                                  ;; return caml_atom0 if list = []
   958                                  LDA ACCU
   959                                  BIT caml_is_block
   960                                  BNE @atom0
   961                                  ;; scan list and sum all arrays sizes
   962                                  LDA (ACCU),Y
   963                                  STA @HEAD
   964                                  INY
   965                                  LDA (ACCU),Y
   966                                  STA @HEAD + 1
   967                                  INY
   968                                  LDA (ACCU),Y
   969                                  STA @TAIL
   970                                  INY
   971                                  LDA (ACCU),Y
   972                                  STA @TAIL + 1
   973                                  ;; get current array size and add it to @SIZE
   974                          -       LDY # -1
   975                                  DEC @HEAD + 1
   976                                  LDA (@HEAD),Y
   977                                  BEQ +
   978                                  CLC
   979                                  ADC @SIZE
   980                                  BCS @error                      ; raise exn if > 255
   981                                  STA @SIZE
   982                                  ;; only once: set @TAG from first non-empty array
   983                                  CPY @TAG                        ; test if @TAG = -1
   984                                  BNE +
   985                                  DEY
   986                                  LDA (@HEAD),Y
   987                                  STA @TAG
   988                                  INY
   989                                  ;; set @HEAD to next list element, @TAIL to rest
   990                          +       INY
   991                                  LDA @TAIL
   992                                  BIT caml_is_block                       ; end of list?
   993                                  BEQ @alloc                      ; yes:  exit loop
   994                                  LDA (@TAIL),Y                   ; no:   continue
   995                                  STA @HEAD
   996                                  INY
   997                                  LDA (@TAIL),Y
   998                                  STA @HEAD + 1
   999                                  INY
  1000                                  LDA (@TAIL),Y
  1001                                  TAX
  1002                                  INY
  1003                                  LDA (@TAIL),Y
  1004                                  STX @TAIL
  1005                                  STA @TAIL + 1
  1006                                  JMP -
  1007                                  ;; allocate destination array
  1008                          @alloc  LDX @SIZE
  1009                                  BEQ @atom0
  1010                                  LDA @TAG
  1011                                  JSR caml_alloc
  1012                                  LDA BLK
  1013                                  STA @RESULT
  1014                                  LDA BLK + 1
  1015                                  STA @RESULT + 1                 ; save dest address
  1016                                  ;; scan list again and append all arrays
  1017                                  LDY # 3
  1018                                  LDA (ACCU),Y
  1019                                  STA @TAIL + 1
  1020                                  DEY
  1021                                  LDA (ACCU),Y
  1022                                  STA @TAIL
  1023                                  DEY
  1024                                  LDA (ACCU),Y
  1025                                  TAX
  1026                                  DEY
  1027                                  LDA (ACCU),Y
  1028                                  STX ACCU + 1
  1029                                  STA ACCU
  1030                                  ;; get current array size
  1031                          -       LDY # -1
  1032                                  DEC ACCU + 1
  1033                                  LDA (ACCU),Y
  1034                                  BEQ ++                          ; skip if zero
  1035                                  INC ACCU + 1
  1036                                  TAX
  1037                                  ASL
  1038                                  TAY
  1039                                  ;; copy array elements to destination
  1040                                  JSR caml_blkcpy
  1041                                  TXA
  1042                                  ;; set BLK pointer to first element to be copied next
  1043                                  ASL
  1044                                  BCC +
  1045                                  CLC
  1046                                  INC BLK + 1
  1047                          +       ADC BLK
  1048                                  STA BLK
  1049                                  BCC ++
  1050                                  INC BLK + 1
  1051                                  ;; set ACCU to next list element, @TAIL to rest
  1052                          ++      LDY # 0
  1053                                  LDA @TAIL
  1054                                  BIT caml_is_block               ; end of list?
  1055                                  BEQ @eol                        ; yes:  exit
  1056                                  LDA (@TAIL),Y                   ; no:   continue
  1057                                  STA ACCU
  1058                                  INY
  1059                                  LDA (@TAIL),Y
  1060                                  STA ACCU + 1
  1061                                  INY
  1062                                  LDA (@TAIL),Y
  1063                                  TAX
  1064                                  INY
  1065                                  LDA (@TAIL),Y
  1066                                  STX @TAIL
  1067                                  STA @TAIL + 1
  1068                                  JMP -                           ; loop
  1069                                  ;; set ACCU = destination array and return
  1070                          @eol    LDA @RESULT
  1071                                  STA ACCU
  1072                                  LDA @RESULT + 1
  1073                                  STA ACCU + 1
  1074                                  RTS
  1075                          @atom0  LDA # < caml_atom0
  1076                                  STA ACCU
  1077                                  LDA # > caml_atom0
  1078                                  STA ACCU + 1
  1079                                  RTS
  1080                          @error  +caml_raise Invalid_argument, "Array.concat"
  1081                          }
  1082                          
  1083                          }      ;; !zone caml_ARRAYS
  1084                          

