   186                          !ifdef caml_PRIM__caml_obj_truncate {
   187                                  ;; truncate a block to newsize
   188                                  ;; ACCU = value
   189                                  ;; SP[0] = newsize
   190                          
   191                                  ;; Obj.truncate is deprecated!
   192                          
   193                                  ;; WARNING: Obj.truncate o s  when  Obj.size o = s + 1
   194                                  ;; will leave an atom on the heap, which could cause the garbage
   195                                  ;; collector to crash if it is reachable from some root!
   196                          
   197                          caml_obj_truncate
   198                                  @NEWSZ = TMP
   199                                  ;; load tag and size
   200                                  DEY
   201                                  DEC ACCU + 1
   202                                  LDA (ACCU),Y
   203                                  TAX                                     ;X := size
   204                                  DEY
   205                                  LDA (ACCU),Y
   206                                  CMP # Double_array_tag
   207                                  BEQ @floatarray
   208                                  ;; calculate Int_val(newsize)
   209                                  LDY # 1
   210                                  LDA (SP),Y
   211                                  DEY
   212                                  LSR
   213                                  BNE @error                              ;error if newsize > 255 or < 0
   214                                  LDA (SP),Y
   215                                  ROR
   216                                  BEQ @error                              ;error if newsize = 0
   217                                  STA @NEWSZ
   218                                  CPX @NEWSZ
   219                                  BEQ @exit                               ;exit if newsize = size
   220                                  BCC @error                              ;error if newsize > size
   221                                  ;; 0 < NEWSZ < size, write NEWSZ into header
   222                          @trunc  DEY
   223                                  STA (ACCU),Y
   224                                  INC ACCU + 1
   225                                  ;; set (ACCU),Y to point to Field(ACCU, newsize)
   226                                  ASL
   227                                  BCC +
   228                                  INC ACCU + 1
   229                          +       TAY
   230                                  ;; header for the leftovers: tag = No_scan_tag, sz = size-1-newsize
   231                                  ;; WARNING: sz could be 0, the GC won't be happy if block is reachable!
   232                                  LDA # No_scan_tag
   233                                  STA (ACCU),Y                            ;tag = No_scan_tag
   234                                  INY
   235                                  DEX
   236                                  TXA
   237                                  SEC
   238                                  SBC @NEWSZ                              ;sz = size-1-NEWSZ
   239                                  STA (ACCU),Y
   240                          @exit   LDY # <Val_unit
   241                                  STY ACCU                                ;ACCU := ()
   242                                  DEY
   243                                  STY ACCU + 1
   244                                  RTS
   245                                  ;; calculate Int_val(newsize) * Double_wosize
   246                          @floatarray
   247                                  LDY # 1
   248                                  LDA (SP),Y
   249                                  BNE @error                              ;error if newsize > 127 or < 0
   250                                  DEY
   251                                  LDA (SP),Y
   252                                  AND # %11111110                         ;A = 2 * newsize
   253                                  BEQ @error                              ;error if newsize = 0
   254                                  STA @NEWSZ                              ;NEWSZ = 2 * newsize
   255                                  LSR
   256                                  ;CLC                                    ;C=0 because of previous AND
   257                                  ADC @NEWSZ                              ;A = Double_wosize * newsize
   258                                  BCS @error                              ;error if > 255
   259                                  STA @NEWSZ                              ;NEWSZ=Double_wosize * newsize
   260                                  CPX @NEWSZ
   261                                  BEQ @exit                               ;exit if NEWSZ = size
   262                                  BCS @trunc                              ;error if NEWSZ > size
   263                          @error  +caml_raise Invalid_argument, "Obj.truncate"
   264                          }
