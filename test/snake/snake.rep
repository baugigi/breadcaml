    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          ;; -----------------------------------------------------------------------------
    15                          ;;                       C64.Sound - timing helpers (PAL / NTSC)
    16                          ;; -----------------------------------------------------------------------------
    17                          ;; Frame length in CPU cycles tells the video standard (hence the SID clock):
    18                          ;;      PAL 312 x 63 = 19656   NTSC 263 x 65 = 17095 (old NTSC 262 x 64 = 16768)
    19                          ;;      PAL-N 312 x 65 = 20280
    20                          !zone caml_C64_SND {
    21                          
    22                          !ifdef caml_PRIM__caml_nonstd_snd_frame_cycles {
    23                          caml_nonstd_snd_frame_cycles
    24                                  ;; Measures a whole frame with CIA2 timer B (free-running, no IRQ).
    25                                  ;; IRQs are masked for ~3 frames (the jiffy clock loses 3 ticks).
    26  8d00 08                         PHP
    27  8d01 78                         SEI
    28  8d02 a900                       LDA # 0
    29  8d04 8d0fdd                     STA C64_CIA2_CRB                ;stop timer B
    30  8d07 a9ff                       LDA # $FF
    31  8d09 8d06dd                     STA C64_CIA2_TBLO
    32  8d0c 8d07dd                     STA C64_CIA2_TBHI
    33  8d0f a910                       LDA # %00010000
    34  8d11 8d0fdd                     STA C64_CIA2_CRB                ;force load $FFFF (still stopped)
    35  8d14 20408d                     JSR @sync
    36  8d17 a901                       LDA # %00000001
    37  8d19 8d0fdd                     STA C64_CIA2_CRB                ;start at raster line 0
    38  8d1c 20408d                     JSR @sync
    39  8d1f a900                       LDA # 0
    40  8d21 8d0fdd                     STA C64_CIA2_CRB                ;stop at the next raster line 0
    41  8d24 38                         SEC
    42  8d25 a9ff                       LDA # $FF
    43  8d27 ed06dd                     SBC C64_CIA2_TBLO
    44  8d2a 85fb                       STA ACCU
    45  8d2c a9ff                       LDA # $FF
    46  8d2e ed07dd                     SBC C64_CIA2_TBHI
    47  8d31 85fc                       STA ACCU + 1                    ;elapsed cycles (up to 20280)
    48  8d33 46fc                       LSR ACCU + 1
    49  8d35 66fb                       ROR ACCU                        ;halved: must fit 15 bits
    50  8d37 38                         SEC
    51  8d38 26fb                       ROL ACCU
    52  8d3a 26fc                       ROL ACCU + 1                    ;Val_int
    53  8d3c 28                         PLP
    54  8d3d a000                       LDY # 0
    55  8d3f 60                         RTS
    56  8d40 ad12d0             @sync   LDA C64_VIC_RASTER              ;leave line 0 ...
    57  8d43 f0fb                       BEQ @sync
    58  8d45 ad12d0             @w0     LDA C64_VIC_RASTER              ;... and wait for the next one (bit 8 = 0)
    59  8d48 d0fb                       BNE @w0
    60  8d4a ad11d0                     LDA C64_VIC_CR1
    61  8d4d 30f6                       BMI @w0
    62  8d4f 60                         RTS
    63                          }
    64                          
    65                          !ifdef caml_PRIM__caml_nonstd_snd_wait_frame {
    66                          caml_nonstd_snd_wait_frame
    67                                  ;; Returns when the raster reaches line 248 (once per frame).
    68  8d50 ad12d0             @a      LDA C64_VIC_RASTER
    69  8d53 c9f8                       CMP # $F8
    70  8d55 f0f9                       BEQ @a
    71  8d57 ad12d0             @b      LDA C64_VIC_RASTER
    72  8d5a c9f8                       CMP # $F8
    73  8d5c d0f9                       BNE @b
    74  8d5e a201                       LDX # <Val_unit
    75  8d60 86fb                       STX ACCU
    76  8d62 a000                       LDY # 0
    77  8d64 84fc                       STY ACCU + 1
    78  8d66 60                         RTS
    79                          }
    80                          
    81                          }       ;; !zone caml_C64_SND
    82                          

