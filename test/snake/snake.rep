     8                          	!source "/home/piero/.opam/LTS/lib/bcaml/stdlib_format.asm" 

; ******** Source: /home/piero/.opam/LTS/lib/bcaml/stdlib_format.asm
     1                          ;; ——————————————————————————————————————————————————————————————————————
     2                          ;; The BreadCaml Project / Progetto BreadCaml
     3                          ;; Copyright (C) 21-Apr-2026 Piero Furiesi
     4                          ;; 
     5                          ;; This program is  free software; you can redistribute  it and/or modify
     6                          ;; it under the terms of the  GNU GENERAL PUBLIC LICENSE (GPL) version 2,
     7                          ;; as specified in the LICENSE-en file in the project root folder.
     8                          ;; 
     9                          ;; Questo  programma  è software  libero;  può  essere ridistribuito  e/o
    10                          ;; modificato nei termini della GNU GENERAL PUBLIC LICENSE (GPL) versione
    11                          ;; 2, come specificato nel file  LICENZA-it nella cartella principale del
    12                          ;; progetto.
    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          
    16                          ;; -----------------------------------------------------------------------------
    17                          ;;                       NUMBER FORMATTING FOR PRINTF
    18                          ;; -----------------------------------------------------------------------------
    19                          ;; Primitives used by CamlinternalFormat (the reduced Printf). The digits of the
    20                          ;; floating point numbers are produced by the BASIC ROM (DIV10, INT, MUL10...),
    21                          ;; the results are built at $0100 and turned into a string by
    22                          ;; caml_string_from_0100 (in stdlib_strings.asm).
    23                          
    24                          !zone caml_FORMAT {
    25                          
    26                          ;; fmt_hex flags n -> string
    27                          ;;   flags = 0: octal, 1: hexadecimal with the letters of the (unshifted)
    28                          ;;   PETSCII "a".."f", 2: with the shifted ones ("A".."F").
    29                          ;;   n is treated as a 15 bit pattern (so -1 gives 7fff), no prefix, no
    30                          ;;   padding, at least one digit.
    31                          !ifdef caml_PRIM__caml_nonstd_fmt_hex {
    32                          caml_nonstd_fmt_hex
    33                          @VAL    = TMP                           ;(16 bit) value still to convert
    34                                  LDY # 1
    35                                  LDA (SP),Y                      ;n, hi byte
    36                                  LSR                             ;drop the tag bit:
    37                                  STA @VAL + 1                    ; VAL := tagged(n) >> 1 = n & $7FFF
    38                                  DEY
    39                                  LDA (SP),Y
    40                                  ROR
    41                                  STA @VAL
    42                                  LDA ACCU                        ;low byte of the tagged flags
    43                                  LSR                             ;A := flags
    44                                  BNE @hex
    45                                  LDA # 3                         ;octal: 3 bits per digit
    46                                  STA @bits
    47                                  LDA # 7
    48                                  STA @mask
    49                                  BNE @conv                       ;BNE = JMP
    50                          @hex    TAX                             ;X := 1 or 2
    51                                  LDA # 4                         ;hexadecimal: 4 bits per digit
    52                                  STA @bits
    53                                  LDA # 15
    54                                  STA @mask
    55                                  LDA @lbase - 1,X                ;letters base for flags 1, 2
    56                                  STA @letter
    57                          @conv   LDX # 0                         ;X := number of digits so far
    58                          @next   LDA @VAL                        ;next digit, least significant first,
    59                                  AND @mask                       ; stored at $0120,X
    60                                  CMP # 10
    61                                  BCC @dig
    62                                  ADC @letter                     ;(C = 1): letter = $41 or $C1 + d - 10
    63                                  BNE @put                        ;BNE = JMP
    64                          @dig    ORA # $30
    65                          @put    STA $0120,X
    66                                  INX
    67                                  LDY @bits
    68                          -       LSR @VAL + 1                    ;VAL := VAL >> bits
    69                                  ROR @VAL
    70                                  DEY
    71                                  BNE -
    72                                  LDA @VAL
    73                                  ORA @VAL + 1
    74                                  BNE @next                       ;until no more digits
    75                                  LDY # 0                         ;copy the digits reversed to $0100
    76                          -       DEX
    77                                  LDA $0120,X
    78                                  STA $0100,Y
    79                                  INY
    80                                  TXA
    81                                  BNE -
    82                                  STA $0100,Y                     ;final 0 (A = 0)
    83                                  JMP caml_string_from_0100
    84                          @lbase  !byte $41 - 11, $C1 - 11        ;value to add with C = 1
    85                          @bits   !byte 0
    86                          @mask   !byte 0
    87                          @letter !byte 0
    88                          }
    89                          
    90                          ;; fmt_float prec x -> string
    91                          ;;   x with prec decimal digits and no exponent, like printf "%.<prec>f";
    92                          ;;   0 <= prec <= 9 (prec is not checked). The number x*10^prec, rounded to an
    93                          ;;   integer, must be less than 2^32: the digits are got with DIV10 and INT,
    94                          ;;   exactly. If not (and for inf and nan) the result is the empty string.
    95                          !ifdef caml_PRIM__caml_nonstd_fmt_float {
    96                          caml_nonstd_fmt_float
    97                                  LDA ACCU
    98                                  LSR
    99                                  STA @p                          ;prec
   100                                  LDY # 0
   101                                  LDA (SP),Y
   102                                  STA caml_float_loadFAC__addr
   103                                  INY
   104                                  LDA (SP),Y
   105                                  STA caml_float_loadFAC__addr + 1
   106                                  JSR caml_float_loadFAC          ;FAC := x, .A = flag byte
   107                                  BEQ @normal
   108                          @empty  LDA # 0                         ;inf, nan or too big: empty string
   109                                  STA $0100
   110                                  JMP caml_string_from_0100
   111                          @normal LDA C64_FACSGN
   112                                  AND # $80
   113                                  STA @neg                        ;$80 if x < 0
   114                                  LDA # 0
   115                                  STA C64_FACSGN                  ;FAC := |x|
   116                                  LDA @p
   117                                  STA @cnt
   118                          @scale  BEQ @round                      ;FAC := |x| * 10^prec; the test of
   119                                  LDA C64_FACEXP                  ; the size avoids the BASIC overflow
   120                                  CMP # $A1
   121                                  BCS @empty                      ;|x| * 10^k >= 2^32
   122                                  +caml_JSR_BASROM C64_MUL10
   123                                  DEC @cnt
   124                                  JMP @scale
   125                          @round  +caml_JSR_BASROM C64_FADDH      ;FAC := INT(FAC + 0.5)
   126                                  +caml_JSR_BASROM C64_INT
   127                                  LDA C64_FACEXP
   128                                  CMP # $A1
   129                                  BCS @empty
   130                                  LDX # 0                         ;X := number of digits so far
   131                                  STX @n
   132                                  TAY
   133                                  BEQ @pad                        ;FAC = 0: no digits (padded below)
   134                          @digit  LDX # <@x                       ;x := FAC
   135                                  LDY # >@x
   136                                  +caml_JSR_BASROM C64_MOVMF
   137                                  +caml_JSR_BASROM C64_DIV10      ;q := INT(x / 10)
   138                                  +caml_JSR_BASROM C64_INT
   139                                  LDX # <@q
   140                                  LDY # >@q
   141                                  +caml_JSR_BASROM C64_MOVMF
   142                                  +caml_JSR_BASROM C64_MUL10      ;FAC := x - 10 * q = last digit
   143                                  LDA # <@x
   144                                  LDY # >@x
   145                                  +caml_JSR_BASROM C64_FSUB
   146                                  +caml_JSR_BASROM C64_FACINX     ;.Y := digit
   147                                  TYA
   148                                  ORA # $30
   149                                  LDX @n
   150                                  STA $0120,X                     ;digits are stored reversed
   151                                  INX
   152                                  STX @n
   153                                  LDA # <@q                       ;FAC := q
   154                                  LDY # >@q
   155                                  +caml_JSR_BASROM C64_MOVFM
   156                                  LDA C64_FACEXP
   157                                  BNE @digit                      ;until q = 0
   158                                  LDX @n
   159                          @pad    LDA @p                          ;at least prec + 1 digits, so that
   160                                  CLC                             ; there is an integer digit: "0.05"
   161                                  ADC # 1
   162                                  STA @cnt
   163                                  LDA # $30
   164                          -       CPX @cnt
   165                                  BCS @out
   166                                  STA $0120,X
   167                                  INX
   168                                  BNE -                           ;BNE = JMP
   169                          @out    LDY # 0                         ;compose the string at $0100
   170                                  LDA @neg
   171                                  BPL @nosign
   172                                  LDA # $2D                       ;'-'
   173                                  STA $0100,Y
   174                                  INY
   175                          @nosign DEX                             ;next digit, most significant first
   176                                  LDA $0120,X
   177                                  STA $0100,Y
   178                                  INY
   179                                  CPX @p                          ;just put the units digit?
   180                                  BNE @nodot
   181                                  LDA @p
   182                                  BEQ @nodot                      ;prec = 0: no decimal point
   183                                  LDA # $2E                       ;'.'
   184                                  STA $0100,Y
   185                                  INY
   186                          @nodot  TXA
   187                                  BNE @nosign
   188                                  STA $0100,Y                     ;final 0 (A = 0)
   189                                  JMP caml_string_from_0100
   190                          @p      !byte 0
   191                          @neg    !byte 0
   192                          @cnt    !byte 0
   193                          @n      !byte 0
   194                          ;; Operands of the BASIC ROM routines (FSUB, MOVFM read them, MOVMF writes them).
   195                          ;; They must not be in the code area: if it overlaps the BASIC ROM, the ROM
   196                          ;; routines would read the ROM instead of our data.  Page 1 is used instead
   197                          ;; (as for the digits at $0120 and the result at $0100, which does not reach
   198                          ;; $0110 before x and q are no longer needed).
   199                          @x      = $0110                         ;5 bytes
   200                          @q      = $0115                         ;5 bytes
   201                          }
   202                          
   203                          } ;!zone caml_FORMAT
   204                          

; ******** Source: /home/piero/.opam/LTS/lib/bcaml/stdlib.asm
     9                          	!source "/home/piero/.opam/LTS/lib/bcaml/stdlib_integers.asm" 

; ******** Source: /home/piero/.opam/LTS/lib/bcaml/stdlib_integers.asm
     1                          ;; ——————————————————————————————————————————————————————————————————————
     2                          ;; The BreadCaml Project / Progetto BreadCaml
     3                          ;; Copyright (C) 21-Apr-2026 Piero Furiesi
     4                          ;; 
     5                          ;; This program is  free software; you can redistribute  it and/or modify
     6                          ;; it under the terms of the  GNU GENERAL PUBLIC LICENSE (GPL) version 2,
     7                          ;; as specified in the LICENSE-en file in the project root folder.
     8                          ;; 
     9                          ;; Questo  programma  è software  libero;  può  essere ridistribuito  e/o
    10                          ;; modificato nei termini della GNU GENERAL PUBLIC LICENSE (GPL) versione
    11                          ;; 2, come specificato nel file  LICENZA-it nella cartella principale del
    12                          ;; progetto.
    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          
    15                          ;; -----------------------------------------------------------------------------
    16                          ;;                                  INTEGERS
    17                          ;; -----------------------------------------------------------------------------
    18                          
    19                          ;; - Each primitive is a stub that loads parameters and jumps to a shared core.
    20                          ;; - The NB parameter (4 or 8) is passed in X. The core stores it within the
    21                          ;;   operand of an LDX # inside caml_i_alloc.
    22                          ;; - For add, sub, and, or, and xor operations, the core patches their opcode
    23                          ;;   and sets the C flag using CMP #$80, which results in C=1 only for SBC.
    24                          ;; - caml_i_alloc allocates the block and writes the custom pointer to
    25                          ;;   Field(0).
    26                          ;; - A 27-byte scratch area (.MZ) is used, it starts from TMP + 6 to keep
    27                          ;;   caml_compare's SAVE_SP and COMPARE intact.
    28                          
    29                          !zone caml_INTEGERS {
    30                          
    31                          .MZ = TMP + 6                           ;27 bytes of scratch area 
    32                          .ORA_OPC = $11                          ;opcode for ORA (zp),Y
    33                          .AND_OPC = $31                          ;opcode for AND (zp),Y
    34                          .EOR_OPC = $51                          ;opcode for EOR (zp),Y
    35                          .ADC_OPC = $71                          ;opcode for ADC (zp),Y
    36                          .SBC_OPC = $F1                          ;opcode for SBC (zp),Y -- negative
    37                          .L_SHIFT = $00                          ;flag: logical shift
    38                          .A_SHIFT = $80                          ;flag: arithmetic shift
    39                          
    40                          !macro caml_i_stub .a, .nb, .core {
    41                                  LDA # .a
    42                                  LDX # .nb
    43                                  BNE .core                       ;BNE=JMP
    44                          }
    45                          !macro caml_i_stub .nb, .core {
    46                                  LDX # .nb
    47                                  BNE .core                       ;BNE=JMP
    48                          }
    49                          
    50                                  ;; -----------------------------------------
    51                                  ;; allocation / common prologue and epilogue
    52                                  ;; -----------------------------------------
    53                          
    54                          !ifdef caml_AUX__caml_i_custom {
    55                          !align $01, $00
    56                          caml_i_custom
    57                          caml_i_custom__int32
    58                                  !word caml_int32_compare, caml_int32_hash
    59                          caml_i_custom__int64
    60                                  !word caml_int64_compare, caml_int64_hash
    61                          }
    62                          
    63                          !ifdef caml_AUX__caml_i_alloc {
    64                          caml_i_alloc                          ;{X = NB}
    65                                  STX caml_i_alloc__nb          ;SMC: NB = operand of the LDX # below
    66                                  TXA
    67                                  LSR
    68                                  TAX
    69                                  INX                             ;X := size in words = NB / 2 + 1
    70                                  LDA # Custom_tag
    71                                  JSR caml_alloc                  ;BLK := new block, Y = 0
    72                                  LDA caml_i_alloc__nb
    73                                  CLC
    74                                  ADC # < (caml_i_custom - 4)
    75                                  STA (BLK),Y                     ;Field(0) := caml_int32/64_custom
    76                                  LDA # > (caml_i_custom - 4)
    77                                  ADC # 0
    78                                  INY
    79                                  STA (BLK),Y
    80                                  DEY
    81                          caml_i_alloc__nb = * + 1
    82                                  LDX # 0                         ;SMC: X := NB
    83                                  RTS                             ;{X = NB, Y = 0}
    84                          }
    85                          
    86                          !ifdef caml_AUX__caml_i_ret {
    87                          caml_i_ret
    88                                  LDY # 0
    89                                  JMP caml_load_newblk   
    90                          }
    91                          
    92                                  ;; --------------------------
    93                                  ;;   add, sub, and, or, xor
    94                                  ;; --------------------------
    95                          
    96                          !ifdef caml_PRIM__caml_int32_add {
    97                          caml_int32_add
    98                                  +caml_i_stub .ADC_OPC, 4, caml_i_alu
    99                          }
   100                          !ifdef caml_PRIM__caml_int32_sub {
   101                          caml_int32_sub
   102                                  +caml_i_stub .SBC_OPC, 4, caml_i_alu
   103                          }
   104                          !ifdef caml_PRIM__caml_int32_and {
   105                          caml_int32_and
   106                                  +caml_i_stub .AND_OPC, 4, caml_i_alu
   107                          }
   108                          !ifdef caml_PRIM__caml_int32_or  {
   109                          caml_int32_or 
   110                                  +caml_i_stub .ORA_OPC, 4, caml_i_alu
   111                          }
   112                          !ifdef caml_PRIM__caml_int32_xor {
   113                          caml_int32_xor
   114                                  +caml_i_stub .EOR_OPC, 4, caml_i_alu
   115                          }
   116                          !ifdef caml_PRIM__caml_int64_add {
   117                          caml_int64_add
   118                                  +caml_i_stub .ADC_OPC, 8, caml_i_alu
   119                          }
   120                          !ifdef caml_PRIM__caml_int64_sub {
   121                          caml_int64_sub
   122                                  +caml_i_stub .SBC_OPC, 8, caml_i_alu
   123                          }
   124                          !ifdef caml_PRIM__caml_int64_and {
   125                          caml_int64_and
   126                                  +caml_i_stub .AND_OPC, 8, caml_i_alu
   127                          }
   128                          !ifdef caml_PRIM__caml_int64_or  {
   129                          caml_int64_or 
   130                                  +caml_i_stub .ORA_OPC, 8, caml_i_alu
   131                          }
   132                          !ifdef caml_PRIM__caml_int64_xor {
   133                          caml_int64_xor
   134                                  +caml_i_stub .EOR_OPC, 8, caml_i_alu
   135                          }
   136                          
   137                          !ifdef caml_AUX__caml_i_bin {
   138                          caml_i_bin                            ;{X = NB}
   139                                  JSR caml_i_alloc
   140                                  LDA (SP),Y
   141                                  STA TMP                         ;TMP := ptr to the 2nd operand
   142                                  INY
   143                                  LDA (SP),Y
   144                                  STA TMP + 1
   145                                  DEY
   146                                  RTS                             ;{X = NB, Y = 0}
   147                          }
   148                          
   149                          !ifdef caml_AUX__caml_i_alu {
   150                          caml_i_alu                            ;{A = opcode of "op (TMP),Y", X = NB}
   151                                  STA @opc                        ;SMC: patch the opcode
   152                                  JSR caml_i_bin
   153                                  LDY # 2
   154                                  LDA @opc
   155                                  CMP # $80                       ;C=1 only for SBC ($F1); ADC needs 0
   156                          -       LDA (ACCU),Y
   157                          @opc    ADC (TMP),Y                     ;SMC: ADC, SBC, AND, ORA, or EOR.
   158                                  STA (BLK),Y
   159                                  INY
   160                                  DEX
   161                                  BNE -
   162                                  JMP caml_i_ret
   163                          }
   164                          
   165                                  ;; -------
   166                                  ;;   neg
   167                                  ;; -------
   168                          
   169                          !ifdef caml_PRIM__caml_int32_neg {
   170                          caml_int32_neg
   171                                  +caml_i_stub 4, caml_i_neg
   172                          }
   173                          !ifdef caml_PRIM__caml_int64_neg {
   174                          caml_int64_neg
   175                                  +caml_i_stub 8, caml_i_neg
   176                          }
   177                          
   178                          !ifdef caml_AUX__caml_i_neg {
   179                          caml_i_neg
   180                                  JSR caml_i_alloc
   181                                  LDY # 2
   182                                  SEC
   183                          -       LDA # 0
   184                                  SBC (ACCU),Y
   185                                  STA (BLK),Y
   186                                  INY
   187                                  DEX
   188                                  BNE -
   189                                  JMP caml_i_ret
   190                          }
   191                          
   192                                  ;; -----------------------------------
   193                                  ;; shifts -- count is taken modulo 64,
   194                                  ;; n >= NB * 8 is unspecified in OCaml
   195                                  ;; -----------------------------------
   196                          
   197                          !ifdef caml_PRIM__caml_int32_shift_left {
   198                          caml_int32_shift_left
   199                                  +caml_i_stub 4, caml_i_shl
   200                          }
   201                          !ifdef caml_PRIM__caml_int32_shift_right {
   202                          caml_int32_shift_right
   203                                  +caml_i_stub .A_SHIFT, 4, caml_i_shr
   204                          }
   205                          !ifdef caml_PRIM__caml_int32_shift_right_unsigned {
   206                          caml_int32_shift_right_unsigned
   207                                  +caml_i_stub .L_SHIFT, 4, caml_i_shr
   208                          }
   209                          !ifdef caml_PRIM__caml_int64_shift_left {
   210                          caml_int64_shift_left
   211                                  +caml_i_stub 8, caml_i_shl
   212                          }
   213                          !ifdef caml_PRIM__caml_int64_shift_right_unsigned {
   214                          caml_int64_shift_right_unsigned
   215                                  +caml_i_stub .L_SHIFT, 8, caml_i_shr
   216                          }
   217                          !ifdef caml_PRIM__caml_int64_shift_right {
   218                          caml_int64_shift_right
   219                                  +caml_i_stub .A_SHIFT, 8, caml_i_shr
   220                          }
   221                          
   222                          !ifdef caml_AUX__caml_i_shp {
   223                          caml_i_shp                            ;{X = NB}
   224                                  JSR caml_i_alloc
   225                                  LDY # 2
   226                          -       LDA (ACCU),Y
   227                                  STA (BLK),Y
   228                                  INY
   229                                  DEX
   230                                  BNE -
   231                                  LDY # 0
   232                                  LDA (SP),Y                      ;low byte of Val_int(count)
   233                                  LSR
   234                                  AND # %00111111
   235                                  RTS                             ;{BLK = copy of ACCU; A = count}
   236                          }
   237                          
   238                          !ifdef caml_AUX__caml_i_shl {
   239                          caml_i_shl
   240                                  JSR caml_i_shp
   241                                  BEQ @done
   242                                  STA TMP
   243                          -       LDY # 2
   244                                  LDX caml_i_alloc__nb
   245                                  CLC
   246                          @l      LDA (BLK),Y
   247                                  ROL
   248                                  STA (BLK),Y
   249                                  INY
   250                                  DEX
   251                                  BNE @l
   252                                  DEC TMP
   253                                  BNE -
   254                          @done   JMP caml_i_ret
   255                          }
   256                          
   257                          !ifdef caml_AUX__caml_i_shr {
   258                          caml_i_shr                            ;{A=$80 arithmetic|0 logical, X = NB}
   259                                  STA TMP + 1
   260                                  JSR caml_i_shp
   261                                  BEQ @done
   262                                  STA TMP
   263                          -       LDY caml_i_alloc__nb
   264                                  INY                             ;Y := index of the top byte
   265                                  LDX caml_i_alloc__nb
   266                                  LDA (BLK),Y
   267                                  AND TMP + 1
   268                                  CMP # $80                       ;C = sign (arithmetic) or 0 (logical)
   269                          @l      LDA (BLK),Y
   270                                  ROR
   271                                  STA (BLK),Y
   272                                  DEY
   273                                  DEX
   274                                  BNE @l
   275                                  DEC TMP
   276                                  BNE -
   277                          @done   JMP caml_i_ret
   278                          }
   279                          
   280                                  ;; --------------------------------------------
   281                                  ;; multiplication (low NB bytes of the product)
   282                                  ;; --------------------------------------------
   283                          
   284                          !ifdef caml_PRIM__caml_int32_mul {
   285                          caml_int32_mul
   286                                  +caml_i_stub 4, caml_i_mul
   287                          }
   288                          !ifdef caml_PRIM__caml_int64_mul {
   289                          caml_int64_mul
   290                                  +caml_i_stub 8, caml_i_mul
   291                          }
   292                          
   293                          !ifdef caml_AUX__caml_i_mul {
   294                          caml_i_mul
   295                          @P      = .MZ                           ;8 by: partial product
   296                          @N      = .MZ + 8                       ;8 by: 2nd operand
   297                          @B      = .MZ + 16                      ;multiplier byte, then result byte
   298                          @CNT    = .MZ + 17
   299                          @J      = .MZ + 18                      ;index (2...) of current multiplier byte
   300                          @W      = .MZ + 19                      ;P/N signific. by. in this pass (NB...1)
   301                                  JSR caml_i_bin
   302                                  STX @W
   303                                  LDY # 2
   304                          -       LDA (TMP),Y
   305                                  STA @N - 2,Y
   306                                  INY
   307                                  DEX
   308                                  BNE -
   309                                  LDX @W
   310                                  LDA # 0
   311                          -       DEX
   312                                  STA @P,X
   313                                  BNE -
   314                                  LDA # 2
   315                                  STA @J
   316                          @pass   LDY @J
   317                                  LDA (ACCU),Y
   318                                  LSR                             ;bit 0 -> C
   319                                  STA @B
   320                                  LDA # 8
   321                                  STA @CNT
   322                          @step   BCC @shift
   323                                  LDX # 0                         ;P += N (W bytes)
   324                                  LDY @W
   325                                  CLC
   326                          -       LDA @P,X
   327                                  ADC @N,X
   328                                  STA @P,X
   329                                  INX
   330                                  DEY
   331                                  BNE -
   332                          @shift  LDX @W                          ;(P:B) >>= 1, carry in from ADC
   333                                  DEX
   334                          -       ROR @P,X
   335                                  DEX
   336                                  BPL -
   337                                  ROR @B
   338                                  DEC @CNT
   339                                  BNE @step
   340                                  LDY @J
   341                                  LDA @B
   342                                  STA (BLK),Y
   343                                  INC @J
   344                                  DEC @W
   345                                  BNE @pass
   346                                  JMP caml_i_ret
   347                          }
   348                          
   349                                  ;; -----------------------------------------
   350                                  ;; div / mod (truncated towards zero, exact)
   351                                  ;; -----------------------------------------
   352                          
   353                          !ifdef caml_PRIM__caml_int32_div {
   354                          caml_int32_div
   355                                  +caml_i_stub 0, 4, caml_i_div
   356                          }
   357                          !ifdef caml_PRIM__caml_int32_mod {
   358                          caml_int32_mod
   359                                  +caml_i_stub 8, 4, caml_i_div
   360                          }
   361                          !ifdef caml_PRIM__caml_int64_div {
   362                          caml_int64_div
   363                                  +caml_i_stub 0, 8, caml_i_div
   364                          }
   365                          !ifdef caml_PRIM__caml_int64_mod {
   366                          caml_int64_mod
   367                                  +caml_i_stub 8, 8, caml_i_div
   368                          }
   369                          
   370                          !ifdef caml_AUX__caml_i_div {
   371                          caml_i_div                            ;{A=result idx: 0 quot.|8 rem., X = NB}
   372                          @D      = .MZ                           ;dividend, then quotient (8 by)
   373                          @R      = .MZ + 8                       ;remainder (8 by)
   374                          @S      = .MZ + 16                      ;divisor (8 by)
   375                          @BASE   = .MZ + 24
   376                          @SGN    = .MZ + 25
   377                          @CNT    = .MZ + 26
   378                                  STA @BASE
   379                                  JSR caml_i_bin
   380                                  STY @SGN                        ;OR of the divisor bytes
   381                                  LDY # 2
   382                          -       LDA (ACCU),Y
   383                                  STA @D - 2,Y
   384                                  LDA (TMP),Y
   385                                  STA @S - 2,Y
   386                                  ORA @SGN
   387                                  STA @SGN
   388                                  INY
   389                                  DEX
   390                                  BNE -
   391                                  LDA @SGN
   392                                  BNE +
   393                                  +caml_raise Division_by_zero
   394                          +       LDX caml_i_alloc__nb
   395                                  LDA @D - 1,X
   396                                  STA @SGN                        ;bit 7 := sign of the dividend
   397                                  LDA @BASE
   398                                  BNE +                           ;rem.: sign of the dividend
   399                                  LDA @SGN
   400                                  EOR @S - 1,X                    ;quot.: dividend sign EOR divisor sign
   401                                  STA @SGN
   402                          +       LDA @D - 1,X
   403                                  BPL +
   404                                  LDX # 0
   405                                  JSR @neg                        ;D := |D|
   406                                  LDX caml_i_alloc__nb
   407                          +       LDA @S - 1,X
   408                                  BPL +
   409                                  LDX # 16
   410                                  JSR @neg                        ;S := |S|
   411                          +       LDA # 0                         ;R := 0
   412                                  LDY # 7
   413                          -       STA @R,Y
   414                                  DEY
   415                                  BPL -
   416                                  LDA caml_i_alloc__nb
   417                                  ASL
   418                                  ASL
   419                                  ASL
   420                                  STA @CNT                        ;8 * NB steps
   421                          @bit    CLC                             ;(D:R) <<= 1
   422                                  LDX # 0
   423                                  JSR @rol
   424                                  LDX # 8
   425                                  JSR @rol
   426                                  SEC                             ;BLK := R - S (scratch)
   427                                  LDY # 2
   428                                  LDX caml_i_alloc__nb
   429                          -       LDA @R - 2,Y
   430                                  SBC @S - 2,Y
   431                                  STA (BLK),Y
   432                                  INY
   433                                  DEX
   434                                  BNE -
   435                                  BCC @next                       ;R < S
   436                                  LDY # 2                         ;R := R - S, quotient bit := 1
   437                                  LDX caml_i_alloc__nb
   438                          -       LDA (BLK),Y
   439                                  STA @R - 2,Y
   440                                  INY
   441                                  DEX
   442                                  BNE -
   443                                  INC @D
   444                          @next   DEC @CNT
   445                                  BNE @bit
   446                                  BIT @SGN
   447                                  BPL +
   448                                  LDX @BASE
   449                                  JSR @neg                        ;negate the selected result
   450                          +       LDA caml_i_alloc__nb
   451                                  CLC
   452                                  ADC # 2
   453                                  STA @CNT
   454                                  LDX @BASE
   455                                  LDY # 2
   456                          -       LDA @D,X
   457                                  STA (BLK),Y
   458                                  INX
   459                                  INY
   460                                  CPY @CNT
   461                                  BNE -
   462                                  JMP caml_i_ret
   463                          @neg    SEC                             ;negate NB bytes at @D + X
   464                                  LDY caml_i_alloc__nb
   465                          -       LDA # 0
   466                                  SBC @D,X
   467                                  STA @D,X
   468                                  INX
   469                                  DEY
   470                                  BNE -
   471                                  RTS
   472                          @rol    LDY caml_i_alloc__nb          ;ROL NB bytes at @D + X
   473                          -       ROL @D,X
   474                                  INX
   475                                  DEY
   476                                  BNE -
   477                                  RTS
   478                          }
   479                          
   480                                  ;; -----------
   481                                  ;; conversions
   482                                  ;; -----------
   483                          
   484                          !ifdef caml_PRIM__caml_int32_of_int {
   485                          caml_int32_of_int
   486                                  +caml_i_stub 4, caml_i_of_int
   487                          }
   488                          !ifdef caml_PRIM__caml_int32_to_int {
   489                          caml_int32_to_int = caml_i_to_int
   490                          }
   491                          !ifdef caml_PRIM__caml_int32_bswap {
   492                          caml_int32_bswap
   493                                  +caml_i_stub 4, caml_i_bswap
   494                          }
   495                          !ifdef caml_PRIM__caml_int64_of_int {
   496                          caml_int64_of_int
   497                                  +caml_i_stub 8, caml_i_of_int
   498                          }
   499                          !ifdef caml_PRIM__caml_int64_of_int32 {
   500                          caml_int64_of_int32
   501                                  +caml_i_stub 8, caml_i_conv
   502                          }
   503                          !ifdef caml_PRIM__caml_int64_to_int32 {
   504                          caml_int64_to_int32
   505                                  +caml_i_stub 4, caml_i_conv
   506                          }
   507                          !ifdef caml_PRIM__caml_int64_to_int {
   508                          caml_int64_to_int = caml_i_to_int
   509                          }
   510                          !ifdef caml_PRIM__caml_int64_bswap {
   511                          caml_int64_bswap
   512                                  +caml_i_stub 8, caml_i_bswap
   513                          }
   514                          
   515                          !ifdef caml_AUX__caml_i_of_int {
   516                          caml_i_of_int                         ;ACCU = Val_int(n), 15-bit signed
   517                                  JSR caml_i_alloc
   518                                  LDA ACCU + 1
   519                                  CMP # $80                       ;C := sign
   520                                  ROR                             ;arithmetic shift of Val_int
   521                                  STA TMP
   522                                  LDA ACCU
   523                                  ROR
   524                                  LDY # 2
   525                                  STA (BLK),Y
   526                                  INY
   527                                  LDA TMP
   528                                  STA (BLK),Y
   529                                  INY
   530                                  JMP caml_i_sext               ;fill the upper bytes with the sign
   531                          }
   532                          
   533                          !ifdef caml_AUX__caml_i_sext {
   534                          caml_i_sext                           ;{Y=1st byte to fill}:
   535                                                                  ;BLK[Y...NB+1] := sign of BLK[Y-1]
   536                                  LDA caml_i_alloc__nb
   537                                  CLC
   538                                  ADC # 2
   539                                  STA TMP                         ;TMP := index past the last byte
   540                                  DEY
   541                                  LDA (BLK),Y
   542                                  INY
   543                                  ASL                             ;C := sign
   544                                  LDA # 0
   545                                  SBC # 0
   546                                  EOR # $FF                       ;A := $FF if negative, else 0
   547                          -       CPY TMP
   548                                  BEQ +
   549                                  STA (BLK),Y
   550                                  INY
   551                                  BNE -
   552                          +       JMP caml_i_ret
   553                          }
   554                          
   555                          !ifdef caml_AUX__caml_i_conv {
   556                          caml_i_conv                           ;{X = NB of the result}
   557                                  JSR caml_i_alloc              ;copy the low 4 bytes, sign-extend
   558                                  LDY # 2
   559                          -       LDA (ACCU),Y
   560                                  STA (BLK),Y
   561                                  INY
   562                                  CPY # 6
   563                                  BNE -
   564                                  JMP caml_i_sext
   565                          }
   566                          
   567                          !ifdef caml_AUX__caml_i_to_int {
   568                          caml_i_to_int                         ;only the low 15 bits matter
   569                                  LDY # 2
   570                                  LDA (ACCU),Y
   571                                  SEC
   572                                  ROL
   573                                  TAX
   574                                  INY
   575                                  LDA (ACCU),Y
   576                                  ROL
   577                                  STA ACCU + 1
   578                                  STX ACCU
   579                                  LDY # 0
   580                                  RTS
   581                          }
   582                          
   583                          !ifdef caml_AUX__caml_i_bswap {
   584                          caml_i_bswap                          ;push NB bytes, pop them back
   585                                  JSR caml_i_alloc
   586                                  LDY # 2
   587                          -       LDA (ACCU),Y
   588                                  PHA
   589                                  INY
   590                                  DEX
   591                                  BNE -
   592                                  LDX caml_i_alloc__nb
   593                                  LDY # 2
   594                          -       PLA
   595                                  STA (BLK),Y
   596                                  INY
   597                                  DEX
   598                                  BNE -
   599                                  JMP caml_i_ret
   600                          }
   601                          
   602                          ;; float -> int, truncated towards zero, without C64_QINT because it's bugged.  
   603                          ;; The 32-bit mantissa is copied MSB first at the top of a big-endian NB-byte
   604                          ;; magnitude M, shifted right by 8*NB - e bits (e = exponent - 128), then
   605                          ;; negated if needed.
   606                          
   607                          !ifdef caml_PRIM__caml_int32_of_float {
   608                          caml_int32_of_float
   609                                  +caml_i_stub 4, caml_i_of_float
   610                          }
   611                          !ifdef caml_PRIM__caml_int64_of_float {
   612                          caml_int64_of_float
   613                                  +caml_i_stub 8, caml_i_of_float
   614                          }
   615                          
   616                          !ifdef caml_AUX__caml_i_of_float {
   617                          caml_i_of_float
   618                                  JSR caml_i_alloc
   619                                  LDA ACCU
   620                                  STA caml_float_loadFAC__addr
   621                                  LDA ACCU + 1
   622                                  STA caml_float_loadFAC__addr + 1
   623                                  JSR caml_float_loadFAC
   624                                  LDA # 0                         ;M := 0 (.MZ[0...7])
   625                                  LDX # 7
   626                          -       STA .MZ,X
   627                                  DEX
   628                                  BPL -
   629                                  LDA C64_FAC                     ;biased exponent
   630                                  CMP # 129
   631                                  BCC @store                      ;|x| < 1, or x = 0
   632                                  SBC # 128                       ;C = 1: A := e
   633                                  STA TMP
   634                                  LDA caml_i_alloc__nb
   635                                  ASL
   636                                  ASL
   637                                  ASL                             ;8 * NB
   638                                  SEC
   639                                  SBC TMP                         ;A := s = 8*NB - e
   640                                  BCC @store                      ;out of range: unspecified, return 0
   641                                  STA TMP
   642                                  LDX # 3
   643                          -       LDA C64_FAC + 1,X
   644                                  STA .MZ,X                       ;mantissa, MSB first
   645                                  DEX
   646                                  BPL -
   647                                  LDA TMP
   648                                  BEQ @sign
   649                          @shr    CLC                             ;M >>= 1
   650                                  LDX # 0
   651                                  LDY caml_i_alloc__nb
   652                          -       ROR .MZ,X
   653                                  INX
   654                                  DEY
   655                                  BNE -
   656                                  DEC TMP
   657                                  BNE @shr
   658                          @sign   BIT C64_FAC + 5
   659                                  BPL @store
   660                                  LDX caml_i_alloc__nb          ;M := -M, from the last byte
   661                                  DEX
   662                                  SEC
   663                          -       LDA # 0
   664                                  SBC .MZ,X
   665                                  STA .MZ,X
   666                                  DEX
   667                                  BPL -
   668                          @store  LDX caml_i_alloc__nb          ;BLK := M, little endian
   669                                  DEX
   670                                  LDY # 2
   671                          -       LDA .MZ,X
   672                                  STA (BLK),Y
   673                                  INY
   674                                  DEX
   675                                  BPL -
   676                                  JMP caml_i_ret
   677                          }
   678                          
   679                                  ;; -------------------------
   680                                  ;; custom ops: compare, hash
   681                                  ;; -------------------------
   682                          
   683                          !ifdef caml_PRIM__caml_int32_compare {
   684                          caml_int32_compare
   685                                  +caml_i_stub 4, caml_i_compare
   686                          }
   687                          !ifdef caml_PRIM__caml_int32_hash {
   688                          caml_int32_hash
   689                                  +caml_i_stub 4, caml_i_hash
   690                          }
   691                          !ifdef caml_PRIM__caml_int64_compare {
   692                          caml_int64_compare
   693                                  +caml_i_stub 8, caml_i_compare
   694                          }
   695                          !ifdef caml_PRIM__caml_int64_hash {
   696                          caml_int64_hash
   697                                  +caml_i_stub 8, caml_i_hash
   698                          }
   699                          
   700                          !ifdef caml_AUX__caml_i_compare {
   701                          caml_i_compare                        ;{X = NB, Y = 0}
   702                                  DEX                             ;NB-1 uns. bytes, then the signed one
   703                                  STY .MZ + 2                     ;OR of the differences
   704                                  LDA (SP),Y
   705                                  STA .MZ
   706                                  INY
   707                                  LDA (SP),Y
   708                                  STA .MZ + 1
   709                                  SEC
   710                          -       INY
   711                                  LDA (ACCU),Y
   712                                  SBC (.MZ),Y
   713                                  ORA .MZ + 2
   714                                  STA .MZ + 2
   715                                  DEX
   716                                  BNE -
   717                                  INY
   718                                  LDA (ACCU),Y
   719                                  SBC (.MZ),Y                     ;top byte: signed difference
   720                                  TAX                             ;X := raw difference (EOR below may
   721                                  ORA .MZ + 2                     ; turn a non-zero one into 0, e.g. $80)
   722                                  STA .MZ + 2                     ;OR of all raw differences
   723                                  TXA                             ;(TAX/ORA/STA/TXA leave V untouched)
   724                                  BVC +
   725                                  EOR # $80                       ;overflow: true sign is inverted
   726                          +       BMI @lt
   727                                  LDY # 0
   728                                  STY ACCU + 1
   729                                  LDA .MZ + 2
   730                                  BNE +                           ;greater
   731                                  LDA # <Val_zero
   732                                  STA ACCU
   733                                  RTS
   734                          +       LDA # <Val_one
   735                                  STA ACCU
   736                                  RTS
   737                          @lt     LDY # $FF
   738                                  STY ACCU
   739                                  STY ACCU + 1
   740                                  INY
   741                                  RTS
   742                          }
   743                          
   744                          !ifdef caml_AUX__caml_i_hash {
   745                          caml_i_hash                           ;{X = NB, Y = 0}:
   746                                                                  ;Val_int(xor(hi half):xor(lo half))
   747                                  TXA
   748                                  TAY
   749                                  INY                             ;Y := last data byte
   750                                  TXA
   751                                  LSR
   752                                  STA .MZ                         ;.MZ := NB / 2
   753                                  JSR @fold
   754                                  PHA
   755                                  JSR @fold
   756                                  SEC
   757                                  ROL
   758                                  STA ACCU
   759                                  PLA
   760                                  ROL
   761                                  STA ACCU + 1
   762                                  LDY # 0
   763                                  RTS
   764                          @fold   LDX .MZ
   765                                  LDA # 0
   766                          -       EOR (ACCU),Y
   767                                  DEY
   768                                  DEX
   769                                  BNE -
   770                                  RTS
   771                          }
   772                          
   773                          }       ;; !zone caml_INTEGERS
