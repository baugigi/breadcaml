   166                          C64_BAD         = $0100 ;Tape Input Error Log
   167                          C64_BUF         = $0200 ;System INPUT Buffer
   168                          C64_LAT         = $0259 ;Kernal Table: Active Logical File No's.
   169                          C64_FAT         = $0263 ;Kernal Table: Device No. for Each File
   170                          C64_SAT         = $026D ;Kernal Table: Second Address Each File
   171                          C64_KEYD        = $0277 ;Keyboard Buffer Queue (FIFO)
   172                          C64_MEMSTR      = $0281 ;Pointer: Bottom of Memory for O.S.
   173                          C64_MEMSIZ      = $0283 ;Pointer: Top of Memory for O.S.
   174                          C64_TIMOUT      = $0285 ;Flag: Kernal Variable for IEEE Timeout
   175                          C64_COLOR       = $0286 ;Current Character Color Code
   176                          C64_GDCOL       = $0287 ;Background Color Under Cursor
   177                          C64_HIBASE      = $0288 ;Top of Screen Memory (Page)
   178                          C64_XMAX        = $0289 ;Size of Keyboard Buffer
   179                          C64_RPTFLG      = $028A ;Flag: REPEAT Key Used, $80 = Repeat
   180                          C64_KOUNT       = $028B ;Repeat Speed Counter
   181                          C64_DELAY       = $028C ;Repeat Delay Counter
   182                          C64_SHFLAG      = $028D ;Flag: Keyb'rd SHIFT Key/CTRL Key/C= Key
   183                          C64_LSTSHF      = $028E ;Last Keyboard Shift Pattern
   184                          C64_KEYLOG      = $028F ;Vector: Keyboard Table Setup
