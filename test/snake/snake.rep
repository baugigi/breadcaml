    18                          !ifdef caml_PRIM__caml_obj_tag {
    19                                  ;; return tag(value)
    20                                  ;; ACCU = value
    21                          caml_obj_tag
    22                                  LDA ACCU
    23                                  BIT caml_is_block
    24                                  BNE @int
    25                                  LDX ACCU + 1
    26                                  CPX # > caml_heap_start
    27                                  BCC @ooh
    28                                  BNE +
    29                                  CMP # < caml_heap_start
    30                                  BCC @ooh
    31                          +       CPX # > caml_heap_end
    32                                  BCC +
    33                                  BNE @ooh
    34                                  CMP # < caml_heap_end
    35                                  BCS @ooh
    36                                  ;; Val_int(tag(ACCU))
    37                          +       LDY # -2
    38                                  DEC ACCU + 1
    39                                  LDA (ACCU),Y
    40                                  SEC
    41                                  ROL
    42                                  STA ACCU
    43                                  LDY # 0
    44                                  STY ACCU + 1
    45                                  ROL ACCU + 1
    46                                  RTS
    47                          @ooh    +Val_Int ~@oohtag, Out_of_heap_tag
    48                                  LDA # > @ohtag
    49                                  LDX # < @oohtag
    50                                  BNE @res                                ;BNE = JMP
    51                          @int    +Val_Int ~@inttag, Int_tag
    52                                  LDA # > @inttag
    53                                  LDX # < @inttag
    54                          @res    STA ACCU + 1
    55                                  STX ACCU
    56                                  RTS
    57                          }
