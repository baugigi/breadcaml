   271                          
   272                                  ;; Macro: call a BASIC ROM routine
   273                          !macro caml_JSR_BASROM .routine {
   274                            !ifndef caml_basic_rom_overlap {              ;Best case: code never overlaps
   275                                  JSR .routine                            ;BASIC ROM
   276                            } else {
   277                              !if @x < C64_BASROM {                       ;BASROM is disabled but this
   278                                  JSR caml_BASROM_on                      ;part of code doesn't overlap it
   279                                  JSR .routine
   280                                  JSR caml_BASROM_off
   281                          @x  } else {                                    ;Worst case: this part of code
   282                                  PHP                                     ;overlaps BASIC ROM. Pass the
   283                                  PHA                                     ;routine address to a wrapper
   284                                  LDA # <.routine                         ;in a safe zone and call it
   285                                  STA caml_BASROM_addr
   286                                  LDA # >.routine
   287                                  STA caml_BASROM_addr + 1
   288                                  JSR caml_BASROM_wrapper
   289                              }
   290                            }
   291                          }
   292                          
   293                          !ifdef caml_basic_rom_overlap {
   294                          caml_BASROM_wrapper                             ;Wrapper for 'Worst case' above
   295                                  LDA C64_D6510
   296                                  ORA # %00000011
   297                                  STA C64_D6510
   298                                  PLA
   299                                  PLP
   300                          caml_BASROM_addr = * + 1
   301                                  JSR .dummy                              ;SMC: JSR .routine
   302                                  ;; fallthrough caml_BASROM_off
   303                          caml_BASROM_off                                 ;Deactivate BASIC ROM
   304                                  PHP
   305                                  PHA
   306                                  LDA C64_D6510
   307                                  AND # %11111110
   308                                  STA C64_D6510
   309                                  PLA
   310                                  PLP
   311                                  RTS
   312                          caml_BASROM_on                                  ;Activate BASIC ROM
   313                                  PHP
   314                                  PHA
   315                                  LDA C64_D6510
   316                                  ORA # %00000011
   317                                  STA C64_D6510
   318                                  PLA
   319                                  PLP
   320                                  RTS
   321                          }
