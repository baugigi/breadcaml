   476                          ;; Conversion from IEEE754 binary64 to C64FLP and vice-versa.
   477                          ;; See en.wikipedia.org/wiki/Double-precision_floating-point_format
   478                          ;; &   www.c64-wiki.com/wiki/Floating_point_arithmetic
   479                          ;;
   480                          ;; IEEE754:      |±¦e10_e04|e03_e00¦m51_m48|m47_m40|...|m07_m00|
   481                          ;; little-endian |m07_m00|...|m47_m40|e03_e00¦m51_m48|±¦e10_e04| Int64.t
   482                          ;; exponent representation: excess-1023
   483                          ;;      exp = $001...$7FE -> ± (2^(exp-1023) * 1.mantissa)
   484                          ;;      exp = $7FF -> special numbers: NaN, +infinity, -infinity
   485                          ;;      exp = $000, mantissa =  0 -> +0.0, -0.0
   486                          ;;      exp = $000, mantissa <> 0 ->  ± (2^(-1022) * 0.mantissa)
   487                          ;; range:   ±2.22507386E-308 ... ±1.79769313E+308 (normal)
   488                          ;;          ±4.94065646E-324 ... ±2.22507386E-308 (subnormal)
   489                          ;; example: 1.0= |0¦0111111|1111¦0000|00000000|...|00000000|
   490                          ;; little-endian |00000000|...|00000000|1111¦0000|0¦0111111| Int64.t
   491                          ;;
   492                          ;; C64 (in RAM): |E07_E00|±¦M30_M24|M23_M16|M15_M08|M07_M00|
   493                          ;; C64 (in FAC): |E07_E00|1¦M30_M24|M23_M16|M15_M08|M07_M00|±///////|
   494                          ;; exponent representation: excess-128
   495                          ;;      exp = $01...$FF -> ± (2^(exp-128) * 0.1mantissa)
   496                          ;;      exp = $00 -> 0.0
   497                          ;; range:   ±2.93873588E-39 ... ±1.70141183E+38
   498                          ;; example: 1.0= |10000001|0¦0000000|00000000|00000000|00000000|  (RAM)
   499                          ;;          1.0= |10000001|1¦0000000|00000000|00000000|00000000|0|(FAC)
   500                          
   501                          !ifdef  caml_PRIM__caml_int64_bits_of_float {
   502                          caml_int64_bits_of_float
   503                          @EXPHI  = TMP
   504                                  +caml_int64_alloc
   505                                  LDA ACCU
   506                                  STA caml_float_loadFAC_addr
   507                                  LDA ACCU + 1
   508                                  STA caml_float_loadFAC_addr + 1
   509                                  JSR caml_float_loadFAC
   510                                  LDA C64_FAC                     ;load exp
   511                                  CLC
   512                                  ADC # <(1023 - 128 - 1)         ;adjust bias, lo bits
   513                                  STA C64_FAC                     ;save
   514                                  LDA # 0
   515                                  ADC # >(1023 - 128 - 1)         ;idem, hi bits
   516                                  LDX # 3                         ;shift left exp 4 times
   517                          -       ASL C64_FAC
   518                                  ROL
   519                                  DEX
   520                                  BPL -
   521                                  STA @EXPHI
   522                                  LDA C64_FAC + 5                 ;load sign byte
   523                                  AND # %10000000                 ;get bit 7
   524                                  ORA @EXPHI                      ;merge with exp
   525                                  LDY # 9
   526                                  STA (BLK),Y                     ;save |±¦e10_e04|
   527                                  LDX # 4                         ;shift left mantissa 5 times
   528                          -       ASL C64_FAC + 4
   529                            !for @i, 3, 1 {
   530                                  ROL C64_FAC + @i
   531                            }
   532                                  ROL
   533                                  DEX
   534                                  BPL -
   535                                  AND # %00001111                 ;merge m51_m48
   536                                  ORA C64_FAC                     ;with e03_e00
   537                                  DEY
   538                            !for @i, 1, 4 {
   539                                  STA (BLK),Y
   540                                  LDA C64_FAC + @i
   541                                  DEY
   542                            }
   543                                  LDA # 0
   544                                  STA (BLK),Y                     ;put 0 in last 3 bytes
   545                                  DEY
   546                                  STA (BLK),Y
   547                                  DEY
   548                                  STA (BLK),Y
   549                                  TAY
   550                                  LDA BLK
   551                                  STA ACCU
   552                                  LDA BLK + 1
   553                                  STA ACCU + 1
   554                                  ;return result
   555                                  RTS
   556                          }
   557                          
   558                          !ifdef  caml_PRIM__caml_int64_float_of_bits {
   559                          caml_int64_float_of_bits
   560                                  LDY # 9
   561                                  LDA (ACCU),Y                    ;.A <- sign¦e10_e04
   562                                  STA C64_FAC + 5                 ;put sign into FAC sign byte
   563                                  AND # %01111111                 ;clear sign bit
   564                                  TAX
   565                                  DEY
   566                                  LDA (ACCU),Y                    ;.A <- e03_e00¦m51_m48
   567                                  STA C64_FAC + 1
   568                                  SEC
   569                                  SBC # <((1023-128-1) << 4)      ;adjust exp bias, lo bits
   570                                  STA C64_FAC
   571                                  TXA
   572                                  SBC # >((1023-128-1) << 4)      ;idem, hi bits
   573                                  BCS +
   574                                  LDA # 0                         ;treat floats under C64 repr.
   575                                  STA C64_FAC                     ;lower limit as zero:
   576                          @zero   STA C64_FAC + 5                 ;clear minus sign, if any;
   577                                  JMP caml_float_alloc_result     ;allocate float and return
   578                          @exn    +caml_raise Invalid_argument, "Int64.float_of_bits"
   579                          @mask  !byte %11110000
   580                          +       BIT @mask
   581                                  BNE @exn                        ;if NaN, ±inf or overflow, raise exn
   582                            !for @i, 1, 4 {
   583                                  LSR                             ;shift result into FAC exp byte
   584                                  ROR C64_FAC
   585                            }
   586                                  BEQ @zero                       ;if zero skip mantissa loading
   587                                  DEY
   588                                  LDA (ACCU),Y                    ;load significative part of mantissa
   589                                  STA C64_FAC + 2
   590                                  DEY
   591                                  LDA (ACCU),Y
   592                                  STA C64_FAC + 3
   593                                  DEY
   594                                  LDA (ACCU),Y
   595                                  STA C64_FAC + 4
   596                                  DEY
   597                                  LDA (ACCU),Y
   598                                  STA C64_FACRND
   599                                  LDX # 2                         ;shift left 3 times
   600                          -       ASL C64_FACRND
   601                            !for @i, 4, 1 {
   602                                  ROL C64_FAC + @i
   603                            }
   604                                  DEX
   605                                  BPL -
   606                                  LDA C64_FAC + 1
   607                                  ORA # $80                       ;set leftmost bit of mantissa
   608                                  STA C64_FAC + 1
   609                                  JMP caml_float_alloc_result     ;allocate float and return
   610                          }
   611                          
   612                          ; caml_int64_bits_of_float(value vd)
   613                          ; caml_int64_div(value v1, value v2)
   614                          ; caml_int64_mod(value v1, value v2)
   615                          ; caml_int64_bswap(value v)
   616                          ; caml_int64_of_int(value v)
   617                          ; caml_int64_to_int(value v)
   618                          ; caml_int64_of_float
   619                          ; caml_int64_of_int32(value v)
   620                          ; caml_int64_to_int32(value v)
   621                          
   622                          }       ;; zone caml_INT64
