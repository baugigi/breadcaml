   280                                  ;; --------------------------------------------
   281                                  ;; multiplication (low NB bytes of the product)
   282                                  ;; --------------------------------------------
   283                          
   284                          !ifdef caml_PRIM__caml_int32_mul {
   285                          caml_int32_mul
   286                                  +caml_i_stub 4, caml_i_mul
   287                          }
   288                          !ifdef caml_PRIM__caml_int64_mul {
   289                          caml_int64_mul
   290                                  +caml_i_stub 8, caml_i_mul
   291                          }
   292                          
   293                          !ifdef caml_AUX__caml_i_mul {
   294                          caml_i_mul
   295                          @P      = .MZ                           ;8 by: partial product
   296                          @N      = .MZ + 8                       ;8 by: 2nd operand
   297                          @B      = .MZ + 16                      ;multiplier byte, then result byte
   298                          @CNT    = .MZ + 17
   299                          @J      = .MZ + 18                      ;index (2...) of current multiplier byte
   300                          @W      = .MZ + 19                      ;P/N signific. by. in this pass (NB...1)
   301                                  JSR caml_i_bin
   302                                  STX @W
   303                                  LDY # 2
   304                          -       LDA (TMP),Y
   305                                  STA @N - 2,Y
   306                                  INY
   307                                  DEX
   308                                  BNE -
   309                                  LDX @W
   310                                  LDA # 0
   311                          -       DEX
   312                                  STA @P,X
   313                                  BNE -
   314                                  LDA # 2
   315                                  STA @J
   316                          @pass   LDY @J
   317                                  LDA (ACCU),Y
   318                                  LSR                             ;bit 0 -> C
   319                                  STA @B
   320                                  LDA # 8
   321                                  STA @CNT
   322                          @step   BCC @shift
   323                                  LDX # 0                         ;P += N (W bytes)
   324                                  LDY @W
   325                                  CLC
   326                          -       LDA @P,X
   327                                  ADC @N,X
   328                                  STA @P,X
   329                                  INX
   330                                  DEY
   331                                  BNE -
   332                          @shift  LDX @W                          ;(P:B) >>= 1, carry in from ADC
   333                                  DEX
   334                          -       ROR @P,X
   335                                  DEX
   336                                  BPL -
   337                                  ROR @B
   338                                  DEC @CNT
   339                                  BNE @step
   340                                  LDY @J
   341                                  LDA @B
   342                                  STA (BLK),Y
   343                                  INC @J
   344                                  DEC @W
   345                                  BNE @pass
   346                                  JMP caml_i_ret
   347                          }
