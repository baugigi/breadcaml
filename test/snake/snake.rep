    16                          ;;                              AUXILIARY TOOLS
    17                          ;; -----------------------------------------------------------------------------
    18                          
    19                          !zone AUX_TOOLS {
    20                          
    21                          .dummy = $1234                          ;dummy operand for self-modifying
    22                                                                  ;code (SMC in comments)
    23                          
    24                          !ifdef caml_AUX__caml_memcpy {
    25                                  ;; Copy a contiguous memory area.  Start address in TMP (wo.),
    26                                  ;; destination address in TMP + 2 (wo.), size in TMP + 4 (wo.).
    27                                  ;; Source and destination areas may overlap.
    28                                  ;; Used registers: A, X, Y. Return Y = 0.
    29                          caml_memcpy
    30                                  @FROM = TMP                     ;source address
    31                                  @TO = TMP + 2                   ;destination address
    32                                  @NUM = TMP + 4                  ;num bytes
    33  7f0d a54e                       LDA @FROM + 1
    34  7f0f c550                       CMP @TO + 1
    35  7f11 902e                       BCC .caml_memcpy__up
    36  7f13 d009                       BNE .caml_memcpy__dn
    37  7f15 a54d                       LDA @FROM
    38  7f17 c54f                       CMP @TO
    39  7f19 9026                       BCC .caml_memcpy__up
    40  7f1b d001                       BNE .caml_memcpy__dn
    41  7f1d 60                         RTS                             ;just in case @FROM = @TO
    42                          .caml_memcpy__dn
    43                                  ;; copy from a higher address to a lower one
    44  7f1e a000                       LDY # 0
    45  7f20 a652                       LDX @NUM + 1
    46  7f22 f00e                       BEQ +
    47  7f24 b14d               -       LDA (@FROM),Y                   ;move a page at a time
    48  7f26 914f                       STA (@TO),Y
    49  7f28 c8                         INY
    50  7f29 d0f9                       BNE -
    51  7f2b e64e                       INC @FROM + 1
    52  7f2d e650                       INC @TO + 1
    53  7f2f ca                         DEX
    54  7f30 d0f2                       BNE -
    55  7f32 a651               +       LDX @NUM
    56  7f34 f008                       BEQ +
    57  7f36 b14d               -       LDA (@FROM),Y                   ;move the remaining bytes
    58  7f38 914f                       STA (@TO),Y
    59  7f3a c8                         INY
    60  7f3b ca                         DEX
    61  7f3c d0f8                       BNE -
    62  7f3e a000               +       LDY # 0
    63  7f40 60                         RTS
    64                          .caml_memcpy__up
    65                                  ;; copy from a lower address to a higher one
    66  7f41 a652                       LDX @NUM + 1                    ;the last byte must be moved first
    67  7f43 18                         CLC                             ;start at the final pages of from & to
    68  7f44 8a                         TXA
    69  7f45 654e                       ADC @FROM + 1
    70  7f47 854e                       STA @FROM + 1
    71  7f49 18                         CLC
    72  7f4a 8a                         TXA
    73  7f4b 6550                       ADC @TO + 1
    74  7f4d 8550                       STA @TO + 1
    75  7f4f e8                         INX                             ;allows use of BNE after DEX below
    76  7f50 a451                       LDY @NUM
    77  7f52 f00e                       BEQ ++
    78  7f54 88                         DEY                             ;move bytes on the last page first
    79  7f55 f007                       BEQ +
    80  7f57 b14d               -       LDA (@FROM),Y
    81  7f59 914f                       STA (@TO),Y
    82  7f5b 88                         DEY
    83  7f5c d0f9                       BNE -
    84  7f5e b14d               +       LDA (@FROM),Y                   ;handle Y = 0 separately
    85  7f60 914f                       STA (@TO),Y
    86  7f62 88                 ++      DEY
    87  7f63 c64e                       DEC @FROM + 1                   ;move the next page (if any)
    88  7f65 c650                       DEC @TO + 1
    89  7f67 ca                         DEX
    90  7f68 d0ed                       BNE -
    91  7f6a a000                       LDY # 0
    92  7f6c 60                         RTS
    93                          }
    94                          
    95                          !ifdef  caml_AUX__caml_blkcpy {
    96                                  ;; Copy all fields from ACCU to BLK; C:Y = 2 * #fields.
    97                                  ;; The block's header is not copied!
    98                          caml_blkcpy
    99  7f6d 9006                       BCC +                           ; less than 256 bytes (<128 fields)
   100  7f6f f016                       BEQ ++                          ; exactly 256 bytes   (=128 fields)
   101  7f71 e6fc                       INC ACCU + 1                    ; more than 256 bytes (>128 fields)
   102  7f73 e64c                       INC BLK + 1
   103                          --
   104  7f75 88                 +       DEY
   105  7f76 b1fb               -       LDA (ACCU),Y
   106  7f78 914b                       STA (BLK),Y
   107  7f7a 88                         DEY
   108  7f7b d0f9                       BNE -
   109  7f7d b1fb                       LDA (ACCU),Y                    ; handle Y = 0 apart
   110  7f7f 914b                       STA (BLK),Y
   111  7f81 9007                       BCC +
   112  7f83 c6fc                       DEC ACCU + 1
   113  7f85 c64c                       DEC BLK + 1
   114  7f87 18                 ++      CLC
   115  7f88 90eb                       BCC --
   116  7f8a 60                 +       RTS
   117                          }
   118                          
   119                          !ifdef  caml_AUX__caml_err_index_oob {
   120                          caml_err_index_oob
   121                                  ;; Raise the exn below.
   122                                  +caml_raise Invalid_argument, "index out of bounds"

