   687  0c7f a0ff                       LDY # -1
   688  0c81 b14d                       LDA (@tmp),Y
   689  0c83 aa                         TAX
   690  0c84 88                         DEY
   691  0c85 b14d                       LDA (@tmp),Y
   692  0c87 60                         RTS
   693                          
