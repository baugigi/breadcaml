   110  5965 a54e                LDA TMP + 1
   111  5967 18                  CLC
   112  5968 6d8802              ADC C64_HIBASE
   113  596b 85fc                STA ACCU + 1

; ******** Source: /home/piero/.opam/LTS/lib/bcaml/c64lib_screen.asm
   160                                  +caml_scr_value 1

; ******** macro from /home/piero/.opam/LTS/lib/bcaml/c64lib_screen.asm
   124                          .n
   125  596d a003                LDY # .n * 2 + 1
