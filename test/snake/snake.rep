    44                          caml_create_string
    45                                  ;; ACCU = length
    46                                  ;; alloc a new block for a string of given length (max 509)
    47  861b a5fb                       LDA ACCU
    48  861d 854d                       STA TMP
    49  861f a5fc                       LDA ACCU + 1                    ;load >length
    50  8621 4a                         LSR                             ;
    51  8622 664d                       ROR TMP                         ;A:TMP := Int_val(lenght)
    52  8624 4a                         LSR
    53  8625 d028                       BNE +++                         ;A>0 => len > max, raise exn.
    54  8627 664d                       ROR TMP                         ;TMP :=  Int_val(lenght) / 2
    55  8629 08                         PHP                             ;save carry (remainder)
    56  862a a64d                       LDX TMP                         ;X := block size, in words
    57  862c e8                         INX                             ;take into account Ocaml padding
    58  862d f01f                       BEQ ++                          ;Exception if size > 255
    59  862f a9fc                       LDA # String_tag                ;load tag
    60  8631 20117b                     JSR caml_alloc                  ;allocate block
    61  8634 206b7d                     JSR caml_load_newblk            ;ACCU := address of new block
    62  8637 ca                         DEX                             ;Compute the padding bytes:
    63  8638 8a                         TXA                             ;A := size - 1
    64  8639 0a                         ASL                             ;A := 2 * size - 2
    65  863a 9002                       BCC +
    66  863c e64c                       INC BLK + 1
    67  863e a8                 +       TAY                             ;BLK+.Y = address of last word
    68  863f a900                       LDA # 0
    69  8641 28                         PLP                             ;reload .C flag
    70  8642 b004                       BCS +                           ;string length is odd?
    71  8644 914b                       STA (BLK),Y                     ;no: padding = "\000\001"
    72  8646 a901                       LDA # 1
    73  8648 c8                 +       INY                             ;yes: padding = "\000"
    74  8649 914b                       STA (BLK),Y
    75  864b a000                       LDY # 0
    76  864d 60                         RTS
    77  864e 28                 ++      PLP
    78                          +++     +caml_raise Invalid_argument, "String.create"

