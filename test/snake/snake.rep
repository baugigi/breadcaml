    18                          	!source "/home/piero/.opam/LTS/lib/bcaml/c64lib_kernal.asm" 

; ******** Source: /home/piero/.opam/LTS/lib/bcaml/c64lib_kernal.asm
     1                          ;; ——————————————————————————————————————————————————————————————————————
     2                          ;; The BreadCaml Project / Progetto BreadCaml
     3                          ;; Copyright (C) 21-Apr-2026 Piero Furiesi
     4                          ;; 
     5                          ;; This program is  free software; you can redistribute  it and/or modify
     6                          ;; it under the terms of the  GNU GENERAL PUBLIC LICENSE (GPL) version 2,
     7                          ;; as specified in the LICENSE-en file in the project root folder.
     8                          ;; 
     9                          ;; Questo  programma  è software  libero;  può  essere ridistribuito  e/o
    10                          ;; modificato nei termini della GNU GENERAL PUBLIC LICENSE (GPL) versione
    11                          ;; 2, come specificato nel file  LICENZA-it nella cartella principale del
    12                          ;; progetto.
    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          ;; ——————————————————————————————————————————————————————————————————————
    15                          ;; C64.Hw.Kernal: thin wrappers around the Kernal I/O routines (through the
    16                          ;; jump table at $FF81-$FFF3, so that alternative Kernals work too).
    17                          ;;
    18                          ;; Conventions as in c64lib_hw.asm: the arguments are not popped here, ACCU = 1st
    19                          ;; argument, SP[0] = 2nd, ...; 8-bit values are taken modulo 256; every
    20                          ;; primitive returns with Y = 0.  No primitive allocates, so no GC issue arises
    21                          ;; (the name strings are read in place while the Kernal runs).
    22                          ;;
    23                          ;; A primitive that may fail returns the Kernal error code (0 = no error;
    24                          ;; 1 too many files, 2 file open, 3 file not open, 4 file not found, 5 device
    25                          ;; not present, 6 not input file, 7 not output file, 8 missing file name,
    26                          ;; 9 illegal device number).  Most DOS errors (e.g. a missing file on OPEN) are
    27                          ;; NOT reported here but by the drive error channel and the status byte (READST).
    28                          ;;
    29                          ;; Kernal messages (SEARCHING FOR, LOADING...) are switched off by LOAD/SAVE.
    30                          ;; File names must be at most 255 characters long.
    31                          ;; ——————————————————————————————————————————————————————————————————————
    32                          
    33                          !zone caml_C64_KN {
    34                          
    35                          !macro caml_kn_a8 {                     ;A := low 8 bits of Int_val(ACCU)
    36                                  LDA ACCU + 1
    37                                  LSR
    38                                  LDA ACCU
    39                                  ROR
    40                          }
    41                          !macro caml_kn_s8 .n {                  ;A := low 8 bits of Int_val(SP[.n])  {Y = 0}
    42                                  LDY # .n * 2 + 1
    43                                  LDA (SP),Y
    44                                  LSR
    45                                  DEY
    46                                  LDA (SP),Y
    47                                  ROR
    48                                  LDY # 0
    49                          }
    50                          !macro caml_kn_ret8 {                   ;ACCU := Val_int(A)
    51                                  LDY # 0
    52                                  STY ACCU + 1
    53                                  SEC
    54                                  ROL
    55                                  STA ACCU
    56                                  ROL ACCU + 1
    57                          }
    58                          !macro caml_kn_ret_err {                ;after a Kernal call: Val_int(C ? A : 0)
    59                                  BCS +
    60                                  LDA # 0
    61                          +       +caml_kn_ret8
    62                          }
    63                          !macro caml_kn_ret_unit {
    64                                  LDY # 0
    65                                  LDX # <Val_unit
    66                                  STX ACCU
    67                                  STY ACCU + 1
    68                          }
    69                          !macro caml_kn_nameptr .n {             ;ACCU := string SP[.n]  {Y = 0}
    70                                  LDY # .n * 2                    ;(then the caller must JSR
    71                                  LDA (SP),Y                      ; caml_string_length_yx, which is
    72                                  STA ACCU                        ; not called here, otherwise mkdepends
    73                                  INY                             ; would not see the dependency)
    74                                  LDA (SP),Y
    75                                  STA ACCU + 1
    76                                  LDY # 0
    77                          }
    78                          !macro caml_kn_setnam {                 ;SETNAM for ACCU, .Y,.X = length
    79                                  TXA
    80                                  BEQ +
    81                                  LDY # 255                       ;longer than 255: truncated
    82                          +       TYA                             ;A := length
    83                                  LDX ACCU
    84                                  LDY ACCU + 1
    85                                  JSR C64_KSETNAM
    86                          }
    87                          
    88                          ;; open_file lfn dev sa name -> error code
    89                          !ifdef caml_PRIM__caml_nonstd_kn_open {
    90                          caml_nonstd_kn_open
    91                                  +caml_kn_s8 1                   ;secondary address
    92                                  STA TMP
    93                                  +caml_kn_s8 0                   ;device
    94                                  TAX
    95                                  +caml_kn_a8                     ;logical file number
    96                                  LDY TMP
    97                                  JSR C64_KSETLFS
    98                                  +caml_kn_nameptr 2
    99                                  JSR caml_string_length_yx
   100                                  +caml_kn_setnam
   101                                  JSR C64_KOPEN
   102                                  +caml_kn_ret_err
   103                                  RTS
   104                          }
   105                          ;; close lfn -> unit
   106                          !ifdef caml_PRIM__caml_nonstd_kn_close {
   107                          caml_nonstd_kn_close
   108                                  +caml_kn_a8
   109                                  JSR C64_KCLOSE
   110                                  +caml_kn_ret_unit
   111                                  RTS
   112                          }
   113                          ;; chkin lfn / chkout lfn -> error code
   114                          !ifdef caml_PRIM__caml_nonstd_kn_chkin {
   115                          caml_nonstd_kn_chkin
   116                                  +caml_kn_a8
   117                                  TAX
   118                                  JSR C64_KCHKIN
   119                                  +caml_kn_ret_err
   120                                  RTS
   121                          }
   122                          !ifdef caml_PRIM__caml_nonstd_kn_chkout {
   123                          caml_nonstd_kn_chkout
   124                                  +caml_kn_a8
   125                                  TAX
   126                                  JSR C64_KCHKOUT
   127                                  +caml_kn_ret_err
   128                                  RTS
   129                          }
   130                          ;; clrchn () / clall () -> unit
   131                          !ifdef caml_PRIM__caml_nonstd_kn_clrchn {
   132                          caml_nonstd_kn_clrchn
   133                                  JSR C64_KCLRCHN
   134                                  +caml_kn_ret_unit
   135                                  RTS
   136                          }
   137                          !ifdef caml_PRIM__caml_nonstd_kn_clall {
   138                          caml_nonstd_kn_clall
   139                                  JSR C64_KCLALL
   140                                  +caml_kn_ret_unit
   141                                  RTS
   142                          }
   143                          ;; chrin () -> byte (0..255); chrout byte -> unit; readst () -> status byte
   144                          !ifdef caml_PRIM__caml_nonstd_kn_chrin {
   145                          caml_nonstd_kn_chrin
   146                                  JSR C64_KCHRIN
   147                                  +caml_kn_ret8
   148                                  RTS
   149                          }
   150                          !ifdef caml_PRIM__caml_nonstd_kn_chrout {
   151                          caml_nonstd_kn_chrout
   152                                  +caml_kn_a8
   153                                  JSR C64_KCHROUT
   154                                  +caml_kn_ret_unit
   155                                  RTS
   156                          }
   157                          !ifdef caml_PRIM__caml_nonstd_kn_readst {
   158                          caml_nonstd_kn_readst
   159                                  JSR C64_KREADST
   160                                  +caml_kn_ret8
   161                                  RTS
   162                          }
   163                          ;; load dev sa name page off -> error code.  The end address (last byte + 1) is
   164                          ;; left in the Kernal variable EAL/EAH ($AE/$AF).  With sa = 0 the file is
   165                          ;; loaded at page:off, otherwise at the address stored in the file.
   166                          !ifdef caml_PRIM__caml_nonstd_kn_load {
   167                          caml_nonstd_kn_load
   168                                  LDA # 0
   169                                  JSR C64_KSETMSG                 ;no Kernal messages
   170                                  +caml_kn_s8 0                   ;secondary address
   171                                  TAY
   172                                  +caml_kn_a8                     ;device
   173                                  TAX
   174                                  LDA # 1                         ;logical file number (not used)
   175                                  JSR C64_KSETLFS
   176                                  +caml_kn_s8 3                   ;off
   177                                  STA TMP
   178                                  +caml_kn_s8 2                   ;page
   179                                  STA TMP + 1
   180                                  +caml_kn_nameptr 1
   181                                  JSR caml_string_length_yx
   182                                  +caml_kn_setnam
   183                                  LDX TMP
   184                                  LDY TMP + 1
   185                                  LDA # 0                         ;0 = load
   186                                  JSR C64_KLOAD
   187                                  BCS +
   188                                  STX C64_EAL                     ;whichever the Kernal version,
   189                                  STY C64_EAL + 1                 ; the end address is in EAL/EAH
   190                          +       +caml_kn_ret_err
   191                                  RTS
   192                          }
   193                          ;; set_range spage soff epage eoff -> unit:
   194                          ;; STAL := start, EAL := end (= last byte + 1)
   195                          !ifdef caml_PRIM__caml_nonstd_kn_range {
   196                          caml_nonstd_kn_range
   197                                  +caml_kn_a8
   198                                  STA C64_STAL + 1
   199                                  +caml_kn_s8 0
   200                                  STA C64_STAL
   201                                  +caml_kn_s8 1
   202                                  STA C64_EAL + 1
   203                                  +caml_kn_s8 2
   204                                  STA C64_EAL
   205                                  +caml_kn_ret_unit
   206                                  RTS
   207                          }
   208                          ;; save dev name -> error code: save STAL..EAL-1 (see set_range).
   209                          !ifdef caml_PRIM__caml_nonstd_kn_save {
   210                          caml_nonstd_kn_save
   211                                  LDA # 0
   212                                  JSR C64_KSETMSG                 ;no Kernal messages
   213                                  +caml_kn_a8                     ;device
   214                                  TAX
   215                                  LDA # 1                         ;logical file number (not used)
   216                                  LDY # 1                         ;secondary address (forced by Kernal)
   217                                  JSR C64_KSETLFS
   218                                  +caml_kn_nameptr 0
   219                                  JSR caml_string_length_yx
   220                                  +caml_kn_setnam
   221                                  LDA # C64_STAL                  ;zero page address of the start pointer
   222                                  LDX C64_EAL
   223                                  LDY C64_EAL + 1
   224                                  JSR C64_KSAVE
   225                                  +caml_kn_ret_err
   226                                  RTS
   227                          }
   228                          
   229                          } ;!zone caml_C64_KN
   230                          

