   583                          
   584                                  ;; Processor port mask (not an address)
   585                          C64_R6510_RAM     = %11111000   ;AND mask for C64_R6510: disable all ROMs
   586                                  ;; CIA bit masks (same layout in CIA 1 and CIA 2)
   587                                  ;; ICR, written: bit 7 = 1 sets the bits given, bit 7 = 0 clears them
   588                          C64_CIA_ICR_SET   = %10000000   ;ICR write: SET/CLR flg; ICR read: IR (any int.)
   589                          C64_CIA_ICR_TA    = %00000001   ;Timer A underflow
   590                          C64_CIA_ICR_TB    = %00000010   ;Timer B underflow
   591                          C64_CIA_ICR_ALRM  = %00000100   ;Time of Day alarm
   592                          C64_CIA_ICR_SP    = %00001000   ;Serial shift register full/empty
