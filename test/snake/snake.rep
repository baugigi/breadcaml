   180                          ;; ---- block operations --------------------------------------------------------
   181                          ;; fill_at page off len v / blit_at spage soff dpage doff len
   182                          ;; len is 0..16383. The checked versions raise Invalid_argument if the (first)
   183                          ;; destination address is below caml_stack_end, if len is negative, or if the
   184                          ;; destination range wraps around $FFFF. A range ending exactly at $FFFF is ok.
   185                          ;; blit_at works also if source and destination overlap.
   186                          
   187                          !ifdef caml_AUX__caml_hw_fill {
   188                          caml_hw_fill
   189                                  ;; ACCU = destination, TMP,TMP+1 = count, A = value
   190  88ab a64e                       LDX TMP + 1                     ;X := number of full pages
   191  88ad f00c                       BEQ @rem
   192  88af a000               @page   LDY # 0
   193  88b1 91fb               @byte   STA (ACCU),Y
   194  88b3 c8                         INY
   195  88b4 d0fb                       BNE @byte
   196  88b6 e6fc                       INC ACCU + 1
   197  88b8 ca                         DEX
   198  88b9 d0f4                       BNE @page
   199  88bb a44d               @rem    LDY TMP                         ;Y := remaining bytes
   200  88bd f005                       BEQ @done
   201  88bf 88                 @rbyte  DEY
   202  88c0 91fb                       STA (ACCU),Y
   203  88c2 d0fb                       BNE @rbyte
   204  88c4 a000               @done   LDY # 0
   205                                  +caml_hw_ret_unit

