   439                          !macro  i57 .n, .tab {                          ;SWITCH n tab
   440                                  +caml_range 0, .n, $FF, "SWITCH n t: n"
   441                            !if (0 < .n) & (.n < len(.tab)) {             ;both iptrs & pptrs present,
   442                                  LDA ACCU                                ;select the appropriate
   443                                  AND # 1                                 ;jumptable section
   444                                  BEQ .pptrs
   445                            }
   446                            !if 0 < .n {
   447                                  !set    caml_gen_SWITCHI = 1            ;iptrs: pointers are stored in
   448                                  LDA # <(.adr - 1)                       ;ACCU = offset + 1,
   449                                  LDX # >(.adr - 1)                       ;so base address = .adr - 1
   450                                  JMP caml_SWITCHI                             ;tab[0]...tab[n-1],
   451                            }
   452                          .pptrs
   453                            !if .n < len(.tab) {
   454                                  !set    caml_gen_SWITCHP = 1            ;pptrs: pointers are stored in
   455                                  LDA # <(.adr + 2 * .n)                  ;Tag(ACCU) = offset,
   456                                  LDX # >(.adr + 2 * .n)                  ;so base address = .adr + 2 * .n
   457                                  JMP caml_SWITCHP                             ;tab[n]...tab[len-1],
   458                            }
   459                                  !align $01, $00                         ;avoid JMP($xxFF) bug
   460                          .adr    !word .tab                              ;jumptable
   461                          }
