   202  087f ea                         !align  $01, $00
   203                                  @ot = Object_tag
   204                                  @st = String_tag
   205                                  ;;  Exn_hdr:Exn      F0, F1:    Str_hdr:Str      F0
   206  0880 f8028808fffffc07...        !byte @ot,2:@x0 !word +, -1:!byte @st,7:+ !text "Out_of_memory",0
   207  0896 f8029e08fefffc05...        !byte @ot,2:@x1 !word +, -2:!byte @st,5:+ !text "Sys_error",0
   208  08a8 f802b008fdfffc04...        !byte @ot,2:@x2 !word +, -3:!byte @st,4:+ !text "Failure",0
   209  08b8 f802c008fcfffc09...        !byte @ot,2:@x3 !word +, -4:!byte @st,9:+ !text "Invalid_argument",0,1
   210  08d2 f802da08fbfffc06...        !byte @ot,2:@x4 !word +, -5:!byte @st,6:+ !text "End_of_file",0
   211  08e6 f802ee08fafffc09...        !byte @ot,2:@x5 !word +, -6:!byte @st,9:+ !text "Division_by_zero",0,1
   212  0900 f8020809f9fffc05...        !byte @ot,2:@x6 !word +, -7:!byte @st,5:+ !text "Not_found",0
   213  0912 f8021a09f8fffc07...        !byte @ot,2:@x7 !word +, -8:!byte @st,7:+ !text "Match_failure",0
   214  0928 f8023009f7fffc08...        !byte @ot,2:@x8 !word +, -9:!byte @st,8:+ !text "Stack_overflow",0,1
   215  0940 f8024809f6fffc08...        !byte @ot,2:@x9 !word +,-10:!byte @st,8:+ !text "Sys_blocked_io",0,1
   216  0958 f8026009f5fffc08...        !byte @ot,2:@xa !word +,-11:!byte @st,8:+ !text "Assert_failure",0,1
   217  0970 f8027809f4fffc09...        !byte @ot,2:@xb !word +,-12:!byte @st,9:+ !text "Undef_rec_module",0,1
   218                          }
   219                                  caml_exn_no = 12
   220                                  caml_std_exn = [@x0,@x1,@x2,@x3,@x4,@x5,@x6,@x7,@x8,@x9,@xa,@xb]
   221                          
   222                                  Out_of_memory   =  0 :  End_of_file     =  4 :  Stack_overflow  =  8
   223                                  Sys_error       =  1 :  Division_by_zero=  5 :  Sys_blocked_io  =  9
   224                                  Failure         =  2 :  Not_found       =  6 :  Assert_failure  = 10
   225                                  Invalid_argument=  3 :  Match_failure   =  7 :  Undef_rec_module= 11
   226                          
   227                          !macro  caml_raise .exn {               ;Raise a standard exception with no
   228                                  LDA # <caml_std_exn[.exn]       ; arguments.
   229                                  STA ACCU
   230                                  LDA # >caml_std_exn[.exn]
   231                                  STA ACCU + 1
   232                                  JMP caml_RAISE
   233                          }
   234                          !macro  caml_raise .exn, .str {         ;Raise a standard exception with a
   235                                  LDA # <.blk                     ; string argument.
   236                                  STA ACCU
   237                                  LDA # >.blk
   238                                  STA ACCU + 1
   239                                  JMP caml_RAISE
   240                                  !align $01, $00
   241                                  !byte String_tag, (.h - .s) div 2
   242                          .s      +caml_string .str
   243                          .h      !byte 0, 2
   244                          .blk    !word caml_std_exn[.exn], .s
   245                          }
