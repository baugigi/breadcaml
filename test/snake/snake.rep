   205                          !ifdef caml_PRIM__caml_int32_shift_right_unsigned {
   206                          caml_int32_shift_right_unsigned
   207                                  +caml_i_stub .L_SHIFT, 4, caml_i_shr
   208                          }
   209                          !ifdef caml_PRIM__caml_int64_shift_left {
   210                          caml_int64_shift_left
   211                                  +caml_i_stub 8, caml_i_shl
   212                          }
   213                          !ifdef caml_PRIM__caml_int64_shift_right_unsigned {
   214                          caml_int64_shift_right_unsigned
   215                                  +caml_i_stub .L_SHIFT, 8, caml_i_shr
   216                          }
   217                          !ifdef caml_PRIM__caml_int64_shift_right {
   218                          caml_int64_shift_right
   219                                  +caml_i_stub .A_SHIFT, 8, caml_i_shr
   220                          }
   221                          
   222                          !ifdef caml_AUX__caml_i_shp {
   223                          caml_i_shp                            ;{X = NB}
   224                                  JSR caml_i_alloc
   225                                  LDY # 2
   226                          -       LDA (ACCU),Y
   227                                  STA (BLK),Y
   228                                  INY
   229                                  DEX
   230                                  BNE -
   231                                  LDY # 0
   232                                  LDA (SP),Y                      ;low byte of Val_int(count)
   233                                  LSR
   234                                  AND # %00111111
   235                                  RTS                             ;{BLK = copy of ACCU; A = count}
   236                          }
   237                          
   238                          !ifdef caml_AUX__caml_i_shl {
   239                          caml_i_shl
   240                                  JSR caml_i_shp
   241                                  BEQ @done
   242                                  STA TMP
   243                          -       LDY # 2
   244                                  LDX caml_i_alloc__nb
   245                                  CLC
   246                          @l      LDA (BLK),Y
   247                                  ROL
   248                                  STA (BLK),Y
   249                                  INY
   250                                  DEX
   251                                  BNE @l
   252                                  DEC TMP
   253                                  BNE -
   254                          @done   JMP caml_i_ret
   255                          }
   256                          
   257                          !ifdef caml_AUX__caml_i_shr {
   258                          caml_i_shr                            ;{A=$80 arithmetic|0 logical, X = NB}
   259                                  STA TMP + 1
   260                                  JSR caml_i_shp
   261                                  BEQ @done
   262                                  STA TMP
   263                          -       LDY caml_i_alloc__nb
   264                                  INY                             ;Y := index of the top byte
   265                                  LDX caml_i_alloc__nb
   266                                  LDA (BLK),Y
   267                                  AND TMP + 1
   268                                  CMP # $80                       ;C = sign (arithmetic) or 0 (logical)
   269                          @l      LDA (BLK),Y
   270                                  ROR
   271                                  STA (BLK),Y
   272                                  DEY
   273                                  DEX
   274                                  BNE @l
   275                                  DEC TMP
   276                                  BNE -
   277                          @done   JMP caml_i_ret
   278                          }
