   421                          !macro  i57 .n, .tab {                          ;SWITCH n tab
   422                                  +caml_range 0, .n, $FF, "SWITCH n t: n"
   423                            !if (0 < .n) & (.n < len(.tab)) {             ;both iptrs & pptrs present,
   424                                  LDA ACCU                                ;select the appropriate
   425                                  AND # 1                                 ;jumptable section
   426                                  BEQ .pptrs
   427                            }
   428                            !if 0 < .n {
   429                                  !set    caml_gen_SWITCHI = 1            ;iptrs: pointers are stored in
   430                                  LDA # <(.adr - 1)                       ;ACCU = offset + 1,
   431                                  LDX # >(.adr - 1)                       ;so base address = .adr - 1
   432                                  JMP caml_SWITCHI                             ;tab[0]...tab[n-1],
   433                            }
   434                          .pptrs
   435                            !if .n < len(.tab) {
   436                                  !set    caml_gen_SWITCHP = 1            ;pptrs: pointers are stored in
   437                                  LDA # <(.adr + 2 * .n)                  ;Tag(ACCU) = offset,
   438                                  LDX # >(.adr + 2 * .n)                  ;so base address = .adr + 2 * .n
   439                                  JMP caml_SWITCHP                             ;tab[n]...tab[len-1],
   440                            }
   441                                  !align $01, $00                         ;avoid JMP($xxFF) bug
   442                          .adr    !word .tab                              ;jumptable
   443                          }
