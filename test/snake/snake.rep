   117                                  TAX
   118                                  JSR C64_KCHKIN
   119                                  +caml_kn_ret_err
   120                                  RTS
   121                          }
   122                          !ifdef caml_PRIM__caml_nonstd_kn_chkout {
   123                          caml_nonstd_kn_chkout
   124                                  +caml_kn_a8
   125                                  TAX
   126                                  JSR C64_KCHKOUT
   127                                  +caml_kn_ret_err
   128                                  RTS
   129                          }
   130                          ;; clrchn () / clall () -> unit
   131                          !ifdef caml_PRIM__caml_nonstd_kn_clrchn {
   132                          caml_nonstd_kn_clrchn
   133                                  JSR C64_KCLRCHN
   134                                  +caml_kn_ret_unit
   135                                  RTS
   136                          }
   137                          !ifdef caml_PRIM__caml_nonstd_kn_clall {
   138                          caml_nonstd_kn_clall
   139                                  JSR C64_KCLALL
   140                                  +caml_kn_ret_unit
   141                                  RTS
   142                          }
   143                          ;; chrin () -> byte (0..255); chrout byte -> unit; readst () -> status byte
   144                          !ifdef caml_PRIM__caml_nonstd_kn_chrin {
   145                          caml_nonstd_kn_chrin
   146                                  JSR C64_KCHRIN
