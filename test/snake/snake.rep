     7                          ;; as specified in the LICENSE-en file in the project root folder.
     8                          ;; 
     9                          ;; Questo  programma  è software  libero;  può  essere ridistribuito  e/o
    10                          ;; modificato nei termini della GNU GENERAL PUBLIC LICENSE (GPL) versione
    11                          ;; 2, come specificato nel file  LICENZA-it nella cartella principale del
    12                          ;; progetto.
    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          ;; -----------------------------------------------------------------------------
    15                          ;;                          C64.Screen - TEXT SCREEN
    16                          ;; -----------------------------------------------------------------------------
    17                          ;; Direct access to the 40x25 text screen (screen codes, not PETSCII) and to the
    18                          ;; color RAM, and cursor positioning via the Kernal. x = column (0..39),
    19                          ;; y = row (0..24). Coordinates out of range are saturated to the nearest edge.
    20                          ;; The start of the screen RAM is taken from C64_HIBASE (page).
    21                          
    22                          !zone caml_C64_SCR {
    23                          
    24                          ;; ---- coordinates -------------------------------------------------------------
    25                          ;; Out-of-range coordinates are not an error: they are saturated to the nearest
    26                          ;; edge of the screen (x to 0..39, y to 0..24), so that the primitives can be
    27                          ;; called directly from OCaml, without any argument check in the ML code.
    28                          
    29                          !ifdef caml_AUX__caml_scr_sat {
    30                          caml_scr_sat
    31                                  ;; in:  A = low byte and X = high byte of a tagged int, Y = maximum (< 128)
    32                                  ;; out: A := Int_val saturated to 0..Y   (Y is clobbered)
    33  58d1 e000                       CPX # 0
    34  58d3 300d                       BMI @low                        ;negative
    35  58d5 d009                       BNE @high                       ;>= 128
    36  58d7 4a                         LSR                             ;A := Int_val (0..127)
    37  58d8 8454                       STY TMP + 7
    38  58da c554                       CMP TMP + 7
    39  58dc 9006                       BCC @ret
    40  58de f004                       BEQ @ret
    41  58e0 98                 @high   TYA
    42  58e1 60                         RTS
    43  58e2 a900               @low    LDA # 0
    44  58e4 60                 @ret    RTS
    45                          }
    46                          
    47                          !ifdef caml_AUX__caml_scr_xy {
    48                          caml_scr_xy
    49                                  ;; TMP+6 := x = Int_val(ACCU) saturated to 0..39
    50                                  ;; TMP+5 := y = Int_val(SP[0]) saturated to 0..24     {Y = 0}
    51  58e5 a001                       LDY # 1
    52  58e7 b1fd                       LDA (SP),Y
    53  58e9 aa                         TAX
    54  58ea 88                         DEY
    55  58eb b1fd                       LDA (SP),Y
    56  58ed a018                       LDY # 24
    57  58ef 20d158                     JSR caml_scr_sat
    58  58f2 8552                       STA TMP + 5
    59  58f4 a6fc                       LDX ACCU + 1
    60  58f6 a5fb                       LDA ACCU
    61  58f8 a027                       LDY # 39
    62  58fa 20d158                     JSR caml_scr_sat
    63  58fd 8553                       STA TMP + 6
    64  58ff a000                       LDY # 0
    65  5901 60                         RTS
    66                          }
    67                          
    68                          !ifdef caml_AUX__caml_scr_offset {
    69                          caml_scr_offset
    70                                  ;; TMP,TMP+1 := y * 40 + x     (x, y saturated)      {Y = 0}
    71  5902 20e558                     JSR caml_scr_xy
    72  5905 a552                       LDA TMP + 5                     ;A := y
    73  5907 854d                       STA TMP
    74  5909 844e                       STY TMP + 1
    75  590b 064d                       ASL TMP
    76  590d 264e                       ROL TMP + 1
    77  590f 064d                       ASL TMP
    78  5911 264e                       ROL TMP + 1
    79  5913 064d                       ASL TMP
    80  5915 264e                       ROL TMP + 1                     ;TMP := y * 8
    81  5917 a54d                       LDA TMP
    82  5919 854f                       STA TMP + 2
    83  591b a54e                       LDA TMP + 1
    84  591d 8550                       STA TMP + 3
    85  591f 064d                       ASL TMP
    86  5921 264e                       ROL TMP + 1
    87  5923 064d                       ASL TMP
    88  5925 264e                       ROL TMP + 1                     ;TMP := y * 32
    89  5927 a54d                       LDA TMP
    90  5929 18                         CLC
    91  592a 654f                       ADC TMP + 2
    92  592c 854d                       STA TMP
    93  592e a54e                       LDA TMP + 1
    94  5930 6550                       ADC TMP + 3
    95  5932 854e                       STA TMP + 1                     ;TMP := y * 40
    96  5934 a553                       LDA TMP + 6                     ;A := x
    97  5936 18                         CLC
    98  5937 654d                       ADC TMP
    99  5939 854d                       STA TMP
   100  593b a54e                       LDA TMP + 1
   101  593d 6900                       ADC # 0
   102  593f 854e                       STA TMP + 1                     ;TMP := y * 40 + x
   103  5941 60                         RTS
   104                          }
   105                          
   106                          ;; ACCU := screen RAM / color RAM start + TMP
   107                          !macro caml_scr_addr_screen {
   108                                  LDA TMP
   109                                  STA ACCU
   110                                  LDA TMP + 1
   111                                  CLC
   112                                  ADC C64_HIBASE
   113                                  STA ACCU + 1
   114                          }
   115                          !macro caml_scr_addr_color {
   116                                  LDA TMP
   117                                  STA ACCU
   118                                  LDA TMP + 1
   119                                  CLC
   120                                  ADC # >C64_COLRAM
   121                                  STA ACCU + 1
   122                          }
   123                          ;; A := low 8 bits of Int_val(SP[.n])   {Y = 0}
   124                          !macro caml_scr_value .n {
   125                                  LDY # .n * 2 + 1
   126                                  LDA (SP),Y
   127                                  LSR
   128                                  DEY
   129                                  LDA (SP),Y
   130                                  ROR
   131                                  LDY # 0
   132                          }
   133                          !macro caml_scr_ret_int {               ;ACCU := Val_int(A)   {Y = 0}
   134                                  STY ACCU + 1
   135                                  SEC
   136                                  ROL
   137                                  STA ACCU
   138                                  ROL ACCU + 1
   139                          }
   140                          !macro caml_scr_ret_unit {              ;{Y = 0}
   141                                  LDX # <Val_unit
   142                                  STX ACCU
   143                                  STY ACCU + 1
   144                          }
   145                          
   146                          !ifdef caml_PRIM__caml_nonstd_scr_peek {
   147                          caml_nonstd_scr_peek
   148  5942 200259                     JSR caml_scr_offset
   149                                  +caml_scr_addr_screen

