   250                          ;; i2d-i2f, i31-i34 depend on i30
   251                          
   252                          !macro  i30 .n {                                ;OFFSETCLOSURE n
   253                                  +caml_range -$FE, .n, $FE, "OFFSETCLOSURE n: n"
   254                                  +caml_range 0, .n mod 2, 0, "OFFSETCLOSURE n: n mod 2"
   255                                  .n2h = >(2 * .n)
   256                                  .n2l = <(2 * .n)
   257                            !if .n2h > 0 {
   258                                  LDY # .n2h
   259                              }
   260                            !if .n = 0 {
   261                                  !set    caml_gen_OFSCL0 = 1
   262                                  JSR caml_OFSCL0
   263                            } else {
   264                                  !set    caml_gen_OFSCLN = 1
   265                                  LDA # .n2l
   266                                  JSR caml_OFSCLN
   267                            }
   268                          }
