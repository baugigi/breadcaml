     9                          ;; Questo  programma  è software  libero;  può  essere ridistribuito  e/o
    10                          ;; modificato nei termini della GNU GENERAL PUBLIC LICENSE (GPL) versione
    11                          ;; 2, come specificato nel file  LICENZA-it nella cartella principale del
    12                          ;; progetto.
    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          ;; -----------------------------------------------------------------------------
    15                          ;;                 C64.Gfx - HIRES / MULTICOLOR BITMAP GRAPHICS
    16                          ;; -----------------------------------------------------------------------------
    17                          ;; The bitmap lives in the VIC bank selected by Gfx.init (bank 0..2; bank 3 is
    18                          ;; not supported). Coordinates: hires 320 x 200, multicolor 160 x 200.
    19                          ;; If the bitmap is in $A000-$BFFF (RAM under the BASIC ROM) the routines clear
    20                          ;; LORAM in R6510 while they read/write it.
    21                          ;; An optional "virtual window" maps user coordinates to the physical ones:
    22                          ;;      p = floor(|v - org| * K / 65536),  K = ceil((size - 1) * 65536 / |span|)
    23                          ;; Lines: Bresenham, with a fast self-modifying loop for lines that are fully
    24                          ;; inside the screen, and a clipping (slower) loop for the others.
    25                          
    26                          !zone caml_C64_GFX {
    27                          
    28                          ;; TMP area map ($4D-$6A; all of it is free while a primitive runs)
    29                          caml_gfx_X1     = TMP                   ;endpoints: X1,Y1,X2,Y2 (16 bit, signed)
    30                          caml_gfx_Y1     = TMP + 2
    31                          caml_gfx_X2     = TMP + 4
    32                          caml_gfx_Y2     = TMP + 6
    33                          caml_gfx_DX     = TMP + 8               ;line: |dx|
    34                          caml_gfx_DY     = TMP + 10              ;      |dy|
    35                          caml_gfx_E      = TMP + 12              ;      error term (signed 16 bit)
    36                          caml_gfx_CNT    = TMP + 14              ;      pixels left
    37                          caml_gfx_PTR    = TMP + 16              ;      byte address of the pixel
    38                          caml_gfx_MAJ    = TMP + 18              ;      major delta
    39                          caml_gfx_MIN    = TMP + 20              ;      minor delta
    40                          caml_gfx_SXN    = TMP + 22              ;      fast line: x/y step is negative
    41                          caml_gfx_SYN    = TMP + 23
    42                          caml_gfx_SXL    = TMP + 22              ;      slow line: x step as 16 bit
    43                          caml_gfx_SXH    = TMP + 23
    44                          caml_gfx_SYL    = TMP + 24              ;                 y step as 16 bit
    45                          caml_gfx_SYH    = TMP + 25
    46                          caml_gfx_T      = TMP + 26              ;locate: temporary (3 bytes)
    47                          caml_gfx_XM     = TMP + 29              ;slow line: major axis is x
    48                          caml_gfx_V      = TMP + 8               ;tx: value (16 bit)
    49                          caml_gfx_D      = TMP + 10              ;    d
    50                          caml_gfx_P      = TMP + 12              ;    product (5 bytes)
    51                          caml_gfx_SG     = TMP + 17              ;    sign
    52                          caml_gfx_N      = TMP + 8               ;div32: dividend / quotient (4 bytes)
    53                          caml_gfx_DV     = TMP + 12              ;       divisor (16 bit)
    54                          caml_gfx_R      = TMP + 14              ;       remainder (16 bit)
    55                          
    56                          ;; ACCU := Int_val(ACCU), sign extended, stored in .dst (16 bit)
    57                          !macro caml_gfx_arg_acc .dst {
    58                                  LDA ACCU + 1
    59                                  CMP # $80
    60                                  ROR
    61                                  STA .dst + 1
    62                                  LDA ACCU
    63                                  ROR
    64                                  STA .dst
    65                          }
    66                          ;; .dst := Int_val(SP[.n]), sign extended   {Y = 0}
    67                          !macro caml_gfx_arg_sp .n, .dst {
    68                                  LDY # .n * 2 + 1
    69                                  LDA (SP),Y
    70                                  CMP # $80
    71                                  ROR
    72                                  STA .dst + 1
    73                                  DEY
    74                                  LDA (SP),Y
    75                                  ROR
    76                                  STA .dst
    77                                  LDY # 0
    78                          }
    79                          !macro caml_gfx_ret_int {               ;ACCU := Val_int(A)   {Y = 0}
    80                                  STY ACCU + 1
    81                                  SEC
    82                                  ROL
    83                                  STA ACCU
    84                                  ROL ACCU + 1
    85                          }
    86                          !macro caml_gfx_ret_unit {              ;{Y = 0}
    87                                  LDX # <Val_unit
    88                                  STX ACCU
    89                                  STY ACCU + 1
    90                          }
    91                          ;; Negate a 16 bit zero-page variable
    92                          !macro caml_gfx_neg16 .v {
    93                                  SEC
    94                                  LDA # 0
    95                                  SBC .v
    96                                  STA .v
    97                                  LDA # 0
    98                                  SBC .v + 1
    99                                  STA .v + 1
   100                          }
   101                          
   102                          ;; ---- data ---------------------------------------------------------------------
   103                          
   104                          !ifdef caml_AUX__caml_gfx_data {
   105                          caml_gfx_data
   106                          caml_gfx_data__npos     !byte 8         ;pixels per byte-cell: 8 hires, 4 multicolor
   107                          caml_gfx_data__pmask    !byte 7         ;npos - 1
   108                          caml_gfx_data__mc       !byte 0         ;1 = multicolor
   109                          caml_gfx_data__pat      !byte $FF       ;pen pattern ($FF, $AA, $55, $00 ...)
   110                          caml_gfx_data__romoff   !byte 0         ;1 = bitmap under the BASIC ROM
   111                          caml_gfx_data__r6510    !byte 0         ;saved R6510
   112                          caml_gfx_data__win      !byte 0         ;1 = virtual window active
   113                          caml_gfx_data__wlo      !byte <320      ;physical width
   114                          caml_gfx_data__whi      !byte >320
   115                          caml_gfx_data__bmphi    !byte 0         ;bitmap start page
   116                          caml_gfx_data__msk      !fill 8, 0      ;pixel masks within a byte
   117                          caml_gfx_data__nmsk     !fill 8, 0      ;inverted masks
   118                          caml_gfx_data__val      !fill 8, 0      ;masks & pen pattern
   119                          caml_gfx_data__rowlo    !fill 25, 0     ;address of each cell row (bitmap + 320 * r)
   120                          caml_gfx_data__rowhi    !fill 25, 0
   121                          caml_gfx_data__orglo    !byte 0, 0      ;window, one entry per axis (0 = x, 1 = y)
   122                          caml_gfx_data__orghi    !byte 0, 0
   123                          caml_gfx_data__neg      !byte 0, 0      ;1 = axis is reversed
   124                          caml_gfx_data__k0       !byte 0, 0      ;K, 24 bit
   125                          caml_gfx_data__k1       !byte 0, 0
   126                          caml_gfx_data__k2       !byte 0, 0
   127                          }
   128                          
   129                          ;; ---- helpers --------------------------------------------------------------------
   130                          
   131                          !ifdef caml_AUX__caml_gfx_tabs {
   132                          caml_gfx_tabs
   133                                  ;; Rebuild msk/nmsk/val from mc and pat
   134                                  LDA caml_gfx_data__mc
   135                                  BNE @mc
   136                                  LDX # 7
   137                          @h      LDA @hmask,X
   138                                  STA caml_gfx_data__msk,X
   139                                  DEX
   140                                  BPL @h
   141                                  BMI @vals                       ;(always)
   142                          @mc     LDX # 3
   143                          @m      LDA @mmask,X
   144                                  STA caml_gfx_data__msk,X
   145                                  DEX
   146                                  BPL @m
   147                          @vals   LDX caml_gfx_data__npos
   148                                  DEX
   149                          @v      LDA caml_gfx_data__msk,X
   150                                  EOR # $FF
   151                                  STA caml_gfx_data__nmsk,X
   152                                  LDA caml_gfx_data__msk,X
   153                                  AND caml_gfx_data__pat
   154                                  STA caml_gfx_data__val,X
   155                                  DEX
   156                                  BPL @v
   157                                  RTS
   158                          @hmask  !byte $80, $40, $20, $10, $08, $04, $02, $01
   159                          @mmask  !byte $C0, $30, $0C, $03
   160                          }
   161                          
   162                          !ifdef caml_AUX__caml_gfx_rom_off {
   163                          caml_gfx_rom_off
   164                                  ;; Save R6510; if the bitmap is under the BASIC ROM, switch it off.
   165                                  LDA C64_R6510
   166                                  STA caml_gfx_data__r6510
   167                                  LDX caml_gfx_data__romoff
   168                                  BEQ @x
   169                                  AND # $FE
   170                                  STA C64_R6510
   171                          @x      RTS
   172                          }
   173                          
   174                          !ifdef caml_AUX__caml_gfx_rom_restore {
   175                          caml_gfx_rom_restore
   176                                  LDA caml_gfx_data__r6510
   177                                  STA C64_R6510
   178                                  RTS
   179                          }
   180                          
   181                          !ifdef caml_AUX__caml_gfx_inside {
   182                          caml_gfx_inside
   183                                  ;; Carry clear if 0 <= X1 < width and 0 <= Y1 < 200, else carry set.
   184                                  LDA caml_gfx_Y1 + 1
   185                                  BNE @no
   186                                  LDA caml_gfx_Y1
   187                                  CMP # 200
   188                                  BCS @no
   189                                  LDA caml_gfx_X1
   190                                  CMP caml_gfx_data__wlo
   191                                  LDA caml_gfx_X1 + 1
   192                                  SBC caml_gfx_data__whi          ;carry set if X1 >= width (or negative)
   193                                  RTS
   194                          @no     SEC
   195                                  RTS
   196                          }
   197                          
   198                          !ifdef caml_AUX__caml_gfx_outcode {
   199                          caml_gfx_outcode
   200                                  ;; X = 0 for (X1,Y1), 4 for (X2,Y2). A := %YYXX outcode:
   201                                  ;; 1 = x < 0, 2 = x >= width, 4 = y < 0, 8 = y >= 200
   202                                  LDA # 0
   203                                  STA caml_gfx_T
   204                                  LDA caml_gfx_X1 + 1,X
   205                                  BPL @xpos
   206                                  LDA # 1
   207                                  STA caml_gfx_T
   208                                  BNE @y
   209                          @xpos   LDA caml_gfx_X1,X
   210                                  CMP caml_gfx_data__wlo
   211                                  LDA caml_gfx_X1 + 1,X
   212                                  SBC caml_gfx_data__whi
   213                                  BCC @y
   214                                  LDA # 2
   215                                  STA caml_gfx_T
   216                          @y      LDA caml_gfx_Y1 + 1,X
   217                                  BPL @ypos
   218                                  LDA caml_gfx_T
   219                                  ORA # 4
   220                                  STA caml_gfx_T
   221                                  BNE @e
   222                          @ypos   LDA caml_gfx_Y1 + 1,X
   223                                  BNE @ybig
   224                                  LDA caml_gfx_Y1,X
   225                                  CMP # 200
   226                                  BCC @e
   227                          @ybig   LDA caml_gfx_T
   228                                  ORA # 8
   229                                  STA caml_gfx_T
   230                          @e      LDA caml_gfx_T
   231                                  RTS
   232                          }
   233                          
   234                          !ifdef caml_AUX__caml_gfx_locate {
   235                          caml_gfx_locate
   236                                  ;; In: X1 in 0..width-1, Y1 in 0..199.
   237                                  ;; Out: PTR = address of the cell line, X = pixel position in the cell
   238                                  ;;      (0..npos-1), Y = line in the cell (0..7).
   239                                  ;; The column offset is built directly in PTR: hires x & $F8 (+256 if
   240                                  ;; x >= 256), multicolor (x & $FC) * 2 (x < 160), then added to the
   241                                  ;; address of the cell row.
   242                                  LDA caml_gfx_Y1
   243                                  AND # 7
   244                                  TAY                             ;Y := line in the cell
   245                                  LDA caml_gfx_Y1
   246                                  LSR
   247                                  LSR
   248                                  LSR
   249                                  TAX                             ;X := cell row
   250                                  LDA caml_gfx_data__mc
   251                                  BNE @mc
   252                                  LDA caml_gfx_X1                 ;hires: column * 8
   253                                  AND # $F8
   254                                  STA caml_gfx_PTR
   255                                  LDA caml_gfx_X1 + 1
   256                                  STA caml_gfx_PTR + 1
   257                          @add    CLC
   258                                  LDA caml_gfx_PTR
   259                                  ADC caml_gfx_data__rowlo,X
   260                                  STA caml_gfx_PTR
   261                                  LDA caml_gfx_PTR + 1
   262                                  ADC caml_gfx_data__rowhi,X
   263                                  STA caml_gfx_PTR + 1
   264                                  LDA caml_gfx_X1
   265                                  AND caml_gfx_data__pmask
   266                                  TAX                             ;X := position in the cell
   267                                  RTS
   268                          @mc     LDA caml_gfx_X1                 ;multicolor: column * 8
   269                                  AND # $FC                       ; = (x & $FC) * 2, carry = bit 7
   270                                  ASL
   271                                  STA caml_gfx_PTR
   272                                  LDA # 0
   273                                  ROL
   274                                  STA caml_gfx_PTR + 1
   275                                  JMP @add
   276                          }
   277                          
   278                          ;; ---- virtual window -------------------------------------------------------------
   279                          
   280                          !ifdef caml_AUX__caml_gfx_tx {
   281                          caml_gfx_tx
   282                                  ;; V := transform(V) for axis Y (0 = x, 1 = y); saturated to +-16383.
   283                                  LDA caml_gfx_data__neg,Y
   284                                  BNE @flip
   285                                  SEC
   286                                  LDA caml_gfx_V
   287                                  SBC caml_gfx_data__orglo,Y
   288                                  STA caml_gfx_D
   289                                  LDA caml_gfx_V + 1
   290                                  SBC caml_gfx_data__orghi,Y
   291                                  STA caml_gfx_D + 1
   292                                  JMP @sign
   293                          @flip   SEC
   294                                  LDA caml_gfx_data__orglo,Y
   295                                  SBC caml_gfx_V
   296                                  STA caml_gfx_D
   297                                  LDA caml_gfx_data__orghi,Y
   298                                  SBC caml_gfx_V + 1
   299                                  STA caml_gfx_D + 1
   300                          @sign   LDA caml_gfx_D + 1
   301                                  STA caml_gfx_SG                 ;bit 7 = sign
   302                                  BPL @mag
   303                                  +caml_gfx_neg16 caml_gfx_D      ;D := |D|
   304                          @mag    LDA # 0
   305                                  STA caml_gfx_P
   306                                  STA caml_gfx_P + 1
   307                                  STA caml_gfx_P + 2
   308                                  STA caml_gfx_P + 3
   309                                  STA caml_gfx_P + 4
   310                                  LDX # 16
   311                          @mul    LSR caml_gfx_D + 1
   312                                  ROR caml_gfx_D
   313                                  BCC @shift
   314                                  CLC
   315                                  LDA caml_gfx_P + 2
   316                                  ADC caml_gfx_data__k0,Y
   317                                  STA caml_gfx_P + 2
   318                                  LDA caml_gfx_P + 3
   319                                  ADC caml_gfx_data__k1,Y
   320                                  STA caml_gfx_P + 3
   321                                  LDA caml_gfx_P + 4
   322                                  ADC caml_gfx_data__k2,Y
   323                                  STA caml_gfx_P + 4
   324                          @shift  ROR caml_gfx_P + 4
   325                                  ROR caml_gfx_P + 3
   326                                  ROR caml_gfx_P + 2
   327                                  ROR caml_gfx_P + 1
   328                                  ROR caml_gfx_P
   329                                  DEX
   330                                  BNE @mul
   331                                  ;; product = P4:P3:P2:P1:P0; integer part = P4:P3:P2
   332                                  LDA caml_gfx_SG
   333                                  BPL @sat
   334                                  LDA caml_gfx_P                  ;negative: floor => add 1 if fractional
   335                                  ORA caml_gfx_P + 1
   336                                  BEQ @sat
   337                                  INC caml_gfx_P + 2
   338                                  BNE @sat
   339                                  INC caml_gfx_P + 3
   340                                  BNE @sat
   341                                  INC caml_gfx_P + 4
   342                          @sat    LDA caml_gfx_P + 4
   343                                  BNE @big
   344                                  LDA caml_gfx_P + 3
   345                                  CMP # $40
   346                                  BCC @fit
   347                          @big    LDA # $FF
   348                                  STA caml_gfx_P + 2
   349                                  LDA # $3F
   350                                  STA caml_gfx_P + 3
   351                          @fit    LDA caml_gfx_SG
   352                                  BPL @store
   353                                  SEC
   354                                  LDA # 0
   355                                  SBC caml_gfx_P + 2
   356                                  STA caml_gfx_V
   357                                  LDA # 0
   358                                  SBC caml_gfx_P + 3
   359                                  STA caml_gfx_V + 1
   360                                  RTS
   361                          @store  LDA caml_gfx_P + 2
   362                                  STA caml_gfx_V
   363                                  LDA caml_gfx_P + 3
   364                                  STA caml_gfx_V + 1
   365                                  RTS
   366                          }
   367                          
   368                          !ifdef caml_AUX__caml_gfx_xf {
   369                          caml_gfx_xf
   370                                  ;; Transform the 16 bit value at TMP + X (X = 0, 2, 4, 6) with axis Y.
   371                                  LDA TMP,X
   372                                  STA caml_gfx_V
   373                                  LDA TMP + 1,X
   374                                  STA caml_gfx_V + 1
   375                                  TXA
   376                                  PHA
   377                                  JSR caml_gfx_tx
   378                                  PLA
   379                                  TAX
   380                                  LDA caml_gfx_V
   381                                  STA TMP,X
   382                                  LDA caml_gfx_V + 1
   383                                  STA TMP + 1,X
   384                                  RTS
   385                          }
   386                          
   387                          !ifdef caml_AUX__caml_gfx_xfall {
   388                          caml_gfx_xfall
   389                                  ;; Transform X1,Y1,X2,Y2.
   390                                  LDX # 0
   391                                  LDY # 0
   392                                  JSR caml_gfx_xf
   393                                  LDX # 2
   394                                  LDY # 1
   395                                  JSR caml_gfx_xf
   396                                  LDX # 4
   397                                  LDY # 0
   398                                  JSR caml_gfx_xf
   399                                  LDX # 6
   400                                  LDY # 1
   401                                  JMP caml_gfx_xf
   402                          }
   403                          
   404                          !ifdef caml_AUX__caml_gfx_div32 {
   405                          caml_gfx_div32
   406                                  ;; N (32 bit) := N / DV (16 bit); R := remainder.
   407                                  LDA # 0
   408                                  STA caml_gfx_R
   409                                  STA caml_gfx_R + 1
   410                                  LDX # 32
   411                          @l      ASL caml_gfx_N
   412                                  ROL caml_gfx_N + 1
   413                                  ROL caml_gfx_N + 2
   414                                  ROL caml_gfx_N + 3
   415                                  ROL caml_gfx_R
   416                                  ROL caml_gfx_R + 1
   417                                  BCS @sub
   418                                  LDA caml_gfx_R
   419                                  CMP caml_gfx_DV
   420                                  LDA caml_gfx_R + 1
   421                                  SBC caml_gfx_DV + 1
   422                                  BCC @nx
   423                          @sub    SEC
   424                                  LDA caml_gfx_R
   425                                  SBC caml_gfx_DV
   426                                  STA caml_gfx_R
   427                                  LDA caml_gfx_R + 1
   428                                  SBC caml_gfx_DV + 1
   429                                  STA caml_gfx_R + 1
   430                                  INC caml_gfx_N
   431                          @nx     DEX
   432                                  BNE @l
   433                                  RTS
   434                          }
   435                          
   436                          !ifdef caml_AUX__caml_gfx_winaxis {
   437                          caml_gfx_winaxis
   438                                  ;; X = 0 / 2 and Y = 0 / 1 for the x / y axis. The window is
   439                                  ;; [TMP + X, TMP + 4 + X] (16 bit each: origin, other end).
   440                                  SEC
   441                                  LDA TMP + 4,X
   442                                  SBC TMP,X
   443                                  STA caml_gfx_DV
   444                                  LDA TMP + 5,X
   445                                  SBC TMP + 1,X
   446                                  STA caml_gfx_DV + 1
   447                                  LDA # 0
   448                                  STA caml_gfx_data__neg,Y
   449                                  LDA caml_gfx_DV + 1
   450                                  BPL @pos
   451                                  LDA # 1
   452                                  STA caml_gfx_data__neg,Y
   453                                  +caml_gfx_neg16 caml_gfx_DV     ;DV := |span|
   454                          @pos    LDA caml_gfx_DV + 1
   455                                  BNE @ok
   456                                  LDA caml_gfx_DV
   457                                  CMP # 2
   458                                  BCS @ok
   459                                  +caml_raise Invalid_argument, "C64.Gfx.window"
   460                          @ok     LDA TMP,X
   461                                  STA caml_gfx_data__orglo,Y
   462                                  LDA TMP + 1,X
   463                                  STA caml_gfx_data__orghi,Y
   464                                  ;; N := ((size - 1) << 16) + (|span| - 1)   =>  N / |span| = K
   465                                  SEC
   466                                  LDA caml_gfx_DV
   467                                  SBC # 1
   468                                  STA caml_gfx_N
   469                                  LDA caml_gfx_DV + 1
   470                                  SBC # 0
   471                                  STA caml_gfx_N + 1
   472                                  CPY # 0
   473                                  BNE @yaxis
   474                                  SEC
   475                                  LDA caml_gfx_data__wlo
   476                                  SBC # 1
   477                                  STA caml_gfx_N + 2
   478                                  LDA caml_gfx_data__whi
   479                                  SBC # 0
   480                                  STA caml_gfx_N + 3
   481                                  JMP @div
   482                          @yaxis  LDA # 199
   483                                  STA caml_gfx_N + 2
   484                                  LDA # 0
   485                                  STA caml_gfx_N + 3
   486                          @div    TXA
   487                                  PHA
   488                                  TYA
   489                                  PHA
   490                                  JSR caml_gfx_div32
   491                                  PLA
   492                                  TAY
   493                                  PLA
   494                                  TAX
   495                                  LDA caml_gfx_N
   496                                  STA caml_gfx_data__k0,Y
   497                                  LDA caml_gfx_N + 1
   498                                  STA caml_gfx_data__k1,Y
   499                                  LDA caml_gfx_N + 2
   500                                  STA caml_gfx_data__k2,Y
   501                                  RTS
   502                          }
   503                          
   504                          ;; ---- init / exit / pen ---------------------------------------------------------
   505                          
   506                          !ifdef caml_PRIM__caml_nonstd_gfx_init {
   507                          caml_nonstd_gfx_init
   508                                  ;; Gfx.init bank screen bitmap mode  (offsets are within the VIC bank)
   509                                  +caml_gfx_arg_acc caml_gfx_X1   ;bank 0..2
   510                                  +caml_gfx_arg_sp 0, caml_gfx_Y1 ;screen offset: multiple of $400
   511                                  +caml_gfx_arg_sp 1, caml_gfx_X2 ;bitmap offset: 0 or $2000
   512                                  +caml_gfx_arg_sp 2, caml_gfx_Y2 ;mode: 0 hires, 1 multicolor
   513                                  JMP @check
   514                          @bad    +caml_raise Invalid_argument, "C64.Gfx.init"
   515                          @check  LDA caml_gfx_X1 + 1
   516                                  BNE @bad
   517                                  LDA caml_gfx_X1
   518                                  CMP # 3
   519                                  BCS @bad                        ;bank must be 0..2
   520                                  LDA caml_gfx_X2
   521                                  BNE @bad
   522                                  LDA caml_gfx_X2 + 1
   523                                  BEQ @bm0
   524                                  CMP # $20
   525                                  BNE @bad                        ;bitmap offset must be 0 or $2000
   526                                  BEQ @bmok
   527                          @bm0    LDA caml_gfx_X1
   528                                  CMP # 1
   529                                  BNE @bad                        ;offset 0 of banks 0, 2 overlaps the char ROM image
   530                          @bmok   LDA caml_gfx_Y1
   531                                  BNE @bad
   532                                  LDA caml_gfx_Y1 + 1
   533                                  AND # 3
   534                                  BNE @bad                        ;screen offset must be a multiple of $400
   535                                  LDA caml_gfx_Y1 + 1
   536                                  CMP # $40
   537                                  BCS @bad
   538                                  LDX caml_gfx_X1
   539                                  CPX # 1
   540                                  BEQ @scrok                      ;bank 1 has no char ROM image
   541                                  CMP # $10
   542                                  BCC @scrok
   543                                  CMP # $20
   544                                  BCC @bad                        ;screen in the char ROM image ($1000-$1FFF)
   545                          @scrok  LDA caml_gfx_Y2 + 1
   546                                  BNE @bad
   547                                  LDA caml_gfx_Y2
   548                                  CMP # 2
   549                                  BCS @bad
   550                                  STA caml_gfx_data__mc
   551                                  ;; bitmap start page = bank * $40 + (bitmap offset >> 8)
   552                                  LDA caml_gfx_X1
   553                                  ASL
   554                                  ASL
   555                                  ASL
   556                                  ASL
   557                                  ASL
   558                                  ASL
   559                                  CLC
   560                                  ADC caml_gfx_X2 + 1
   561                                  STA caml_gfx_data__bmphi
   562                                  AND # $E0
   563                                  LDX # 0
   564                                  CMP # $A0
   565                                  BNE +
   566                                  INX
   567                          +       STX caml_gfx_data__romoff
   568                                  ;; mode dependent data
   569                                  LDA caml_gfx_data__mc
   570                                  BNE @mcdat
   571                                  LDA # 8
   572                                  STA caml_gfx_data__npos
   573                                  LDA # 7
   574                                  STA caml_gfx_data__pmask
   575                                  LDA # <320
   576                                  STA caml_gfx_data__wlo
   577                                  LDA # >320
   578                                  STA caml_gfx_data__whi
   579                                  LDA # $FF
   580                                  STA caml_gfx_data__pat
   581                                  BNE @rows                       ;(always)
   582                          @mcdat  LDA # 4
   583                                  STA caml_gfx_data__npos
   584                                  LDA # 3
   585                                  STA caml_gfx_data__pmask
   586                                  LDA # <160
   587                                  STA caml_gfx_data__wlo
   588                                  LDA # >160
   589                                  STA caml_gfx_data__whi
   590                                  LDA # $55
   591                                  STA caml_gfx_data__pat
   592                          @rows   LDA # 0
   593                                  STA caml_gfx_data__win
   594                                  STA caml_gfx_PTR
   595                                  LDA caml_gfx_data__bmphi
   596                                  STA caml_gfx_PTR + 1
   597                                  LDX # 0
   598                          @row    LDA caml_gfx_PTR
   599                                  STA caml_gfx_data__rowlo,X
   600                                  LDA caml_gfx_PTR + 1
   601                                  STA caml_gfx_data__rowhi,X
   602                                  CLC
   603                                  LDA caml_gfx_PTR
   604                                  ADC # <320
   605                                  STA caml_gfx_PTR
   606                                  LDA caml_gfx_PTR + 1
   607                                  ADC # >320
   608                                  STA caml_gfx_PTR + 1
   609                                  INX
   610                                  CPX # 25
   611                                  BNE @row
   612                                  JSR caml_gfx_tabs
   613                                  ;; VIC: memory control, bitmap mode, multicolor, bank
   614                                  LDA caml_gfx_Y1 + 1
   615                                  LSR
   616                                  LSR                             ;screen offset / $400
   617                                  ASL
   618                                  ASL
   619                                  ASL
   620                                  ASL
   621                                  STA caml_gfx_T
   622                                  LDA caml_gfx_X2 + 1
   623                                  BEQ +
   624                                  LDA caml_gfx_T
   625                                  ORA # %00001000                 ;bitmap at offset $2000
   626                                  STA caml_gfx_T
   627                          +       LDA caml_gfx_T
   628                                  STA C64_VIC_VMCB
   629                                  LDA C64_VIC_CR1
   630                                  ORA # %00100000                 ;BMM
   631                                  STA C64_VIC_CR1
   632                                  LDA C64_VIC_CR2
   633                                  AND # %11101111
   634                                  LDX caml_gfx_data__mc
   635                                  BEQ +
   636                                  ORA # %00010000                 ;MCM
   637                          +       STA C64_VIC_CR2
   638                                  LDA C64_CIA2_PRA
   639                                  AND # %11111100
   640                                  STA caml_gfx_T
   641                                  LDA # 3
   642                                  SEC
   643                                  SBC caml_gfx_X1
   644                                  ORA caml_gfx_T
   645                                  STA C64_CIA2_PRA                ;VIC bank (inverted bits)
   646                                  LDY # 0
   647                                  +caml_gfx_ret_unit
   648                                  RTS
   649                          }
   650                          
   651                          !ifdef caml_PRIM__caml_nonstd_gfx_exit {
   652                          caml_nonstd_gfx_exit
   653                                  ;; Gfx.exit: back to the text mode, bank 0, standard memory control
   654                                  LDA C64_VIC_CR1
   655                                  AND # %11011111
   656                                  STA C64_VIC_CR1
   657                                  LDA C64_VIC_CR2
   658                                  AND # %11101111
   659                                  STA C64_VIC_CR2
   660                                  LDA # $15
   661                                  STA C64_VIC_VMCB
   662                                  LDA C64_CIA2_PRA
   663                                  ORA # %00000011
   664                                  STA C64_CIA2_PRA
   665                                  LDY # 0
   666                                  +caml_gfx_ret_unit
   667                                  RTS
   668                          }
   669                          
   670                          !ifdef caml_PRIM__caml_nonstd_gfx_pen {
   671                          caml_nonstd_gfx_pen
   672                                  ;; Gfx.pen p: hires 0 / 1; multicolor 0..3
   673                                  LDA ACCU
   674                                  LSR                             ;A := p (low byte)
   675                                  LDX caml_gfx_data__mc
   676                                  BNE @mc
   677                                  AND # 1
   678                                  BEQ @set
   679                                  LDA # $FF
   680                                  BNE @set
   681                          @mc     AND # 3
   682                                  TAX
   683                                  LDA @pats,X
   684                          @set    STA caml_gfx_data__pat
   685                                  JSR caml_gfx_tabs
   686                                  LDY # 0
   687                                  +caml_gfx_ret_unit
   688                                  RTS
   689                          @pats   !byte $00, $55, $AA, $FF
   690                          }
   691                          
   692                          ;; ---- plot / point ---------------------------------------------------------------
   693                          
   694                          !ifdef caml_PRIM__caml_nonstd_gfx_plot {
   695                          caml_nonstd_gfx_plot
   696                                  ;; Gfx.plot x y
   697                                  +caml_gfx_arg_acc caml_gfx_X1
   698                                  +caml_gfx_arg_sp 0, caml_gfx_Y1
   699                                  LDA caml_gfx_data__win
   700                                  BEQ @nowin
   701                                  LDX # 0
   702                                  LDY # 0
   703                                  JSR caml_gfx_xf
   704                                  LDX # 2
   705                                  LDY # 1
   706                                  JSR caml_gfx_xf
   707                          @nowin  JSR caml_gfx_inside
   708                                  BCS @done
   709                                  JSR caml_gfx_rom_off
   710                                  JSR caml_gfx_locate
   711                                  LDA (caml_gfx_PTR),Y
   712                                  AND caml_gfx_data__nmsk,X
   713                                  ORA caml_gfx_data__val,X
   714                                  STA (caml_gfx_PTR),Y
   715                                  JSR caml_gfx_rom_restore
   716                          @done   LDY # 0
   717                                  +caml_gfx_ret_unit
   718                                  RTS
   719                          }
   720                          
   721                          !ifdef caml_PRIM__caml_nonstd_gfx_point {
   722                          caml_nonstd_gfx_point
   723                                  ;; Gfx.point x y: pen value of the pixel (0..3), or -1 if outside
   724                                  +caml_gfx_arg_acc caml_gfx_X1
   725                                  +caml_gfx_arg_sp 0, caml_gfx_Y1
   726                                  LDA caml_gfx_data__win
   727                                  BEQ @nowin
   728                                  LDX # 0
   729                                  LDY # 0
   730                                  JSR caml_gfx_xf
   731                                  LDX # 2
   732                                  LDY # 1
   733                                  JSR caml_gfx_xf
   734                          @nowin  JSR caml_gfx_inside
   735                                  BCC @in
   736                                  LDA # $FF
   737                                  STA ACCU
   738                                  STA ACCU + 1                    ;ACCU := Val_int(-1)
   739                                  LDY # 0
   740                                  RTS
   741                          @in     JSR caml_gfx_rom_off
   742                                  JSR caml_gfx_locate
   743                                  LDA (caml_gfx_PTR),Y
   744                                  AND caml_gfx_data__msk,X
   745                                  STA caml_gfx_T
   746                                  JSR caml_gfx_rom_restore
   747                                  LDA caml_gfx_data__mc
   748                                  BNE @mc
   749                                  LDA caml_gfx_T
   750                                  BEQ @ret
   751                                  LDA # 1
   752                                  BNE @ret
   753                          @mc     TXA
   754                                  EOR # 3
   755                                  ASL
   756                                  TAX                             ;X := 2 * (3 - position)
   757                                  LDA caml_gfx_T
   758                          @sh     CPX # 0
   759                                  BEQ @ret
   760                                  LSR
   761                                  DEX
   762                                  JMP @sh
   763                          @ret    LDY # 0
   764                                  +caml_gfx_ret_int
   765                                  RTS
   766                          }
   767                          
   768                          ;; ---- line -----------------------------------------------------------------------
   769                          
   770                          !ifdef caml_PRIM__caml_nonstd_gfx_line {
   771                          caml_nonstd_gfx_line
   772                                  ;; Gfx.line x1 y1 x2 y2
   773                                  +caml_gfx_arg_acc caml_gfx_X1
   774                                  +caml_gfx_arg_sp 0, caml_gfx_Y1
   775                                  +caml_gfx_arg_sp 1, caml_gfx_X2
   776                                  +caml_gfx_arg_sp 2, caml_gfx_Y2
   777                                  LDA caml_gfx_data__win
   778                                  BEQ @nowin
   779                                  JSR caml_gfx_xfall
   780                          @nowin  LDX # 0
   781                                  JSR caml_gfx_outcode
   782                                  STA caml_gfx_T + 1
   783                                  LDX # 4
   784                                  JSR caml_gfx_outcode
   785                                  STA caml_gfx_T + 2
   786                                  AND caml_gfx_T + 1
   787                                  BNE @done                       ;both ends on the same outer side
   788                                  LDA caml_gfx_T + 1
   789                                  ORA caml_gfx_T + 2
   790                                  BNE @slow
   791                                  JMP caml_gfx_fastline
   792                          @slow   JMP caml_gfx_slowline
   793                          @done   LDY # 0
   794                                  +caml_gfx_ret_unit
   795                                  RTS
   796                          }
   797                          
   798                          !ifdef caml_AUX__caml_gfx_fastline {
   799                          caml_gfx_fastline
   800                                  ;; Both endpoints are inside the screen. Self-modifying Bresenham:
   801                                  ;; the step routines @xstep and @ystep and the JSRs to them are patched
   802                                  ;; for the direction and for the major axis.
   803                                  JSR caml_gfx_rom_off
   804                                  JSR caml_gfx_locate             ;PTR, X, Y := start pixel
   805                                  SEC
   806                                  LDA caml_gfx_X2
   807                                  SBC caml_gfx_X1
   808                                  STA caml_gfx_DX
   809                                  LDA caml_gfx_X2 + 1
   810                                  SBC caml_gfx_X1 + 1
   811                                  STA caml_gfx_DX + 1
   812                                  LDA # 0
   813                                  STA caml_gfx_SXN
   814                                  STA caml_gfx_SYN
   815                                  LDA caml_gfx_DX + 1
   816                                  BPL @dxp
   817                                  INC caml_gfx_SXN
   818                                  +caml_gfx_neg16 caml_gfx_DX     ;DX := |dx|
   819                          @dxp    SEC
   820                                  LDA caml_gfx_Y2
   821                                  SBC caml_gfx_Y1
   822                                  BCS @dyp
   823                                  INC caml_gfx_SYN
   824                                  EOR # $FF
   825                                  ADC # 1                         ;(carry is clear) A := |dy|
   826                          @dyp    STA caml_gfx_DY
   827                                  ;; major axis: x if dx >= dy
   828                                  LDA caml_gfx_DX + 1
   829                                  BNE @xmaj
   830                                  LDA caml_gfx_DX
   831                                  CMP caml_gfx_DY
   832                                  BCS @xmaj
   833                                  ;; y-major: MAJ = dy, MIN = dx
   834                                  LDA caml_gfx_DY
   835                                  STA caml_gfx_MAJ
   836                                  LDA # 0
   837                                  STA caml_gfx_MAJ + 1
   838                                  LDA caml_gfx_DX
   839                                  STA caml_gfx_MIN
   840                                  LDA # <@ystep
   841                                  STA @jmaj + 1
   842                                  LDA # >@ystep
   843                                  STA @jmaj + 2
   844                                  LDA # <@xstep
   845                                  STA @jmin + 1
   846                                  LDA # >@xstep
   847                                  STA @jmin + 2
   848                                  JMP @common
   849                          @xmaj   LDA caml_gfx_DX
   850                                  STA caml_gfx_MAJ
   851                                  LDA caml_gfx_DX + 1
   852                                  STA caml_gfx_MAJ + 1
   853                                  LDA caml_gfx_DY
   854                                  STA caml_gfx_MIN
   855                                  LDA # <@xstep
   856                                  STA @jmaj + 1
   857                                  LDA # >@xstep
   858                                  STA @jmaj + 2
   859                                  LDA # <@ystep
   860                                  STA @jmin + 1
   861                                  LDA # >@ystep
   862                                  STA @jmin + 2
   863                          @common ;; E := -((MAJ + 1) >> 1); CNT := MAJ
   864                                  LDA caml_gfx_MAJ
   865                                  STA caml_gfx_CNT
   866                                  CLC
   867                                  ADC # 1
   868                                  STA caml_gfx_E
   869                                  LDA caml_gfx_MAJ + 1
   870                                  STA caml_gfx_CNT + 1
   871                                  ADC # 0
   872                                  STA caml_gfx_E + 1
   873                                  LSR caml_gfx_E + 1
   874                                  ROR caml_gfx_E
   875                                  +caml_gfx_neg16 caml_gfx_E
   876                                  ;; x direction
   877                                  LDA caml_gfx_SXN
   878                                  BNE @xneg
   879                                  LDA # $E8                       ;INX
   880                                  STA @xinc
   881                                  LDA caml_gfx_data__npos
   882                                  STA @xchk + 1                   ;CPX #npos
   883                                  LDA # 0
   884                                  STA @xld + 1                    ;LDX #0
   885                                  LDA # 8
   886                                  STA @xwlo + 1                   ;ADC #8
   887                                  LDA # 0
   888                                  STA @xwhi + 1                   ;ADC #0
   889                                  JMP @ydir
   890                          @xneg   LDA # $CA                       ;DEX
   891                                  STA @xinc
   892                                  LDA # $FF
   893                                  STA @xchk + 1                   ;CPX #$FF
   894                                  LDX caml_gfx_data__npos
   895                                  DEX
   896                                  STX @xld + 1                    ;LDX #npos-1
   897                                  LDA # $F8
   898                                  STA @xwlo + 1                   ;ADC #-8
   899                                  LDA # $FF
   900                                  STA @xwhi + 1
   901                          @ydir   LDA caml_gfx_SYN
   902                                  BNE @yneg
   903                                  LDA # $C8                       ;INY
   904                                  STA @yinc
   905                                  LDA # 8
   906                                  STA @ychk + 1                   ;CPY #8
   907                                  LDA # 0
   908                                  STA @yld + 1                    ;LDY #0
   909                                  LDA # <320
   910                                  STA @ywlo + 1                   ;ADC #<320
   911                                  LDA # >320
   912                                  STA @ywhi + 1                   ;ADC #>320
   913                                  JMP @go
   914                          @yneg   LDA # $88                       ;DEY
   915                                  STA @yinc
   916                                  LDA # $FF
   917                                  STA @ychk + 1                   ;CPY #$FF
   918                                  LDA # 7
   919                                  STA @yld + 1                    ;LDY #7
   920                                  LDA # <(-320)
   921                                  STA @ywlo + 1
   922                                  LDA # >(-320 & $FFFF)
   923                                  STA @ywhi + 1
   924                          @go     JSR caml_gfx_locate             ;PTR, X, Y := start pixel (again)
   925                          @loop   LDA (caml_gfx_PTR),Y            ;plot
   926                                  AND caml_gfx_data__nmsk,X
   927                                  ORA caml_gfx_data__val,X
   928                                  STA (caml_gfx_PTR),Y
   929                                  LDA caml_gfx_CNT
   930                                  ORA caml_gfx_CNT + 1
   931                                  BEQ @end
   932                                  LDA caml_gfx_CNT
   933                                  BNE +
   934                                  DEC caml_gfx_CNT + 1
   935                          +       DEC caml_gfx_CNT
   936                          @jmaj   JSR @xstep                      ;(patched) major axis step
   937                                  CLC
   938                                  LDA caml_gfx_E
   939                                  ADC caml_gfx_MIN
   940                                  STA caml_gfx_E
   941                                  BCC +
   942                                  INC caml_gfx_E + 1
   943                          +       LDA caml_gfx_E + 1
   944                                  BMI @loop                       ;E < 0: no minor step
   945                                  SEC
   946                                  LDA caml_gfx_E
   947                                  SBC caml_gfx_MAJ
   948                                  STA caml_gfx_E
   949                                  LDA caml_gfx_E + 1
   950                                  SBC caml_gfx_MAJ + 1
   951                                  STA caml_gfx_E + 1
   952                          @jmin   JSR @ystep                      ;(patched) minor axis step
   953                                  JMP @loop
   954                          @end    JSR caml_gfx_rom_restore
   955                                  LDY # 0
   956                                  +caml_gfx_ret_unit
   957                                  RTS
   958                          @xstep
   959                          @xinc   INX                             ;(patched INX / DEX)
   960                          @xchk   CPX # 8                         ;(patched) npos / $FF
   961                                  BNE @xr
   962                          @xld    LDX # 0                         ;(patched) 0 / npos-1
   963                                  LDA caml_gfx_PTR
   964                                  CLC
   965                          @xwlo   ADC # 8                         ;(patched) +8 / -8
   966                                  STA caml_gfx_PTR
   967                                  LDA caml_gfx_PTR + 1
   968                          @xwhi   ADC # 0                         ;(patched)
   969                                  STA caml_gfx_PTR + 1
   970                          @xr     RTS
   971                          @ystep
   972                          @yinc   INY                             ;(patched INY / DEY)
   973                          @ychk   CPY # 8                         ;(patched) 8 / $FF
   974                                  BNE @yr
   975                          @yld    LDY # 0                         ;(patched) 0 / 7
   976                                  LDA caml_gfx_PTR
   977                                  CLC
   978                          @ywlo   ADC # <320                      ;(patched) +320 / -320
   979                                  STA caml_gfx_PTR
   980                                  LDA caml_gfx_PTR + 1
   981                          @ywhi   ADC # >320                      ;(patched)
   982                                  STA caml_gfx_PTR + 1
   983                          @yr     RTS
   984                          }
   985                          
   986                          !ifdef caml_AUX__caml_gfx_slowline {
   987                          caml_gfx_slowline
   988                                  ;; At least one endpoint is outside the screen: clip pixel by pixel.
   989                                  JSR caml_gfx_rom_off
   990                                  SEC
   991                                  LDA caml_gfx_X2
   992                                  SBC caml_gfx_X1
   993                                  STA caml_gfx_DX
   994                                  LDA caml_gfx_X2 + 1
   995                                  SBC caml_gfx_X1 + 1
   996                                  STA caml_gfx_DX + 1
   997                                  LDA # 1
   998                                  STA caml_gfx_SXL
   999                                  LDA # 0
  1000                                  STA caml_gfx_SXH
  1001                                  LDA caml_gfx_DX + 1
  1002                                  BPL @dxp
  1003                                  LDA # $FF
  1004                                  STA caml_gfx_SXL
  1005                                  STA caml_gfx_SXH
  1006                                  +caml_gfx_neg16 caml_gfx_DX
  1007                          @dxp    SEC
  1008                                  LDA caml_gfx_Y2
  1009                                  SBC caml_gfx_Y1
  1010                                  STA caml_gfx_DY
  1011                                  LDA caml_gfx_Y2 + 1
  1012                                  SBC caml_gfx_Y1 + 1
  1013                                  STA caml_gfx_DY + 1
  1014                                  LDA # 1
  1015                                  STA caml_gfx_SYL
  1016                                  LDA # 0
  1017                                  STA caml_gfx_SYH
  1018                                  LDA caml_gfx_DY + 1
  1019                                  BPL @dyp
  1020                                  LDA # $FF
  1021                                  STA caml_gfx_SYL
  1022                                  STA caml_gfx_SYH
  1023                                  +caml_gfx_neg16 caml_gfx_DY
  1024                          @dyp    ;; major axis: x if DX >= DY (16 bit)
  1025                                  LDA caml_gfx_DX
  1026                                  CMP caml_gfx_DY
  1027                                  LDA caml_gfx_DX + 1
  1028                                  SBC caml_gfx_DY + 1
  1029                                  BCC @ymaj
  1030                                  LDA # 1
  1031                                  STA caml_gfx_XM
  1032                                  LDA caml_gfx_DX
  1033                                  STA caml_gfx_MAJ
  1034                                  LDA caml_gfx_DX + 1
  1035                                  STA caml_gfx_MAJ + 1
  1036                                  LDA caml_gfx_DY
  1037                                  STA caml_gfx_MIN
  1038                                  LDA caml_gfx_DY + 1
  1039                                  STA caml_gfx_MIN + 1
  1040                                  JMP @init
  1041                          @ymaj   LDA # 0
  1042                                  STA caml_gfx_XM
  1043                                  LDA caml_gfx_DY
  1044                                  STA caml_gfx_MAJ
  1045                                  LDA caml_gfx_DY + 1
  1046                                  STA caml_gfx_MAJ + 1
  1047                                  LDA caml_gfx_DX
  1048                                  STA caml_gfx_MIN
  1049                                  LDA caml_gfx_DX + 1
  1050                                  STA caml_gfx_MIN + 1
  1051                          @init   LDA caml_gfx_MAJ
  1052                                  STA caml_gfx_CNT
  1053                                  CLC
  1054                                  ADC # 1
  1055                                  STA caml_gfx_E
  1056                                  LDA caml_gfx_MAJ + 1
  1057                                  STA caml_gfx_CNT + 1
  1058                                  ADC # 0
  1059                                  STA caml_gfx_E + 1
  1060                                  LSR caml_gfx_E + 1
  1061                                  ROR caml_gfx_E
  1062                                  +caml_gfx_neg16 caml_gfx_E
  1063                          @loop   JSR caml_gfx_inside
  1064                                  BCS @np
  1065                                  JSR caml_gfx_locate
  1066                                  LDA (caml_gfx_PTR),Y
  1067                                  AND caml_gfx_data__nmsk,X
  1068                                  ORA caml_gfx_data__val,X
  1069                                  STA (caml_gfx_PTR),Y
  1070                          @np     LDA caml_gfx_CNT
  1071                                  ORA caml_gfx_CNT + 1
  1072                                  BEQ @end
  1073                                  LDA caml_gfx_CNT
  1074                                  BNE +
  1075                                  DEC caml_gfx_CNT + 1
  1076                          +       DEC caml_gfx_CNT
  1077                                  LDA caml_gfx_XM
  1078                                  BEQ @majy
  1079                                  JSR @addx
  1080                                  JMP @err
  1081                          @majy   JSR @addy
  1082                          @err    CLC
  1083                                  LDA caml_gfx_E
  1084                                  ADC caml_gfx_MIN
  1085                                  STA caml_gfx_E
  1086                                  LDA caml_gfx_E + 1
  1087                                  ADC caml_gfx_MIN + 1
  1088                                  STA caml_gfx_E + 1
  1089                                  BMI @loop
  1090                                  SEC
  1091                                  LDA caml_gfx_E
  1092                                  SBC caml_gfx_MAJ
  1093                                  STA caml_gfx_E
