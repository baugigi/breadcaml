    50                          ;; -----------------------------------------------------------------------------
    51                          ;;      ZERO-PAGE RESERVED ADDRESSES
    52                          ;; -----------------------------------------------------------------------------
    53                          
    54                          !addr {
    55                          	ACCU	= C64_FREKZP     	; 	  2 by. Accumulator
    56                                  SP      = C64_FREKZP + 2 	; 	  2 by. Stack Pointer
    57                                  XARGS   = C64_UNUSZP     	; 	  1 by. Extra_args
    58                                  ENV     = $2B 			;-$2C     2 by. Environment
    59                                  TRAPSP  = $2D 			;-$2E     2 by. Trap Pointer
    60                            !ifdef caml_INTERP {
    61                                  caml_interp_fetch = $2F 	;-$3D    15 by. FETCH-EXEC LOOP
    62                                  PC                = $30 	;-$31           Program Counter
    63                            }
    64                                  GC      = $3E 			;-$46     9 by. caml_alloc
    65                          					;($47-$48       Used by C64_FOUT)
    66                                  HEAP    = $49 			;-$4A     2 by. Heap Pointer
    67                                  BLK     = $4B 			;-$4C     2 by. caml_alloc: New Block
    68                                  TMP     = $4D 			;Temp.area, towards the BASIC FLPT zone.
    69                                                          	;See stdlib_floats.asm for more info.
    70                          
    71                          ;; All ZP memory locations, except for C64_FREKZP (4 by.), C64_UNUSZP (1 by.),
    72                          ;; and the FLPT area, must be saved and restored upon exit.
    73                                  .zpbase = $2B		;start
    74                                  .zpend  = $4E		;end + 1
    75                          }
