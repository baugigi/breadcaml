     8                          ;; 
     9                          ;; Questo  programma  è software  libero;  può  essere ridistribuito  e/o
    10                          ;; modificato nei termini della GNU GENERAL PUBLIC LICENSE (GPL) versione
    11                          ;; 2, come specificato nel file  LICENZA-it nella cartella principale del
    12                          ;; progetto.
    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          
    15                          ;; -----------------------------------------------------------------------------
    16                          ;;                                   RANDOM
    17                          ;; -----------------------------------------------------------------------------
    18                          
    19                          ;; X ABC Algorithm Pseudo-Random Number Generator for 8-Bit Devices.
    20                          ;; Quite fast, but not good for cryptographic/security purposes.
    21                          ;; From EternityForest (1), with modifications by Stix (2).
    22                          ;; (1) https://www.electro-tech-online.com/threads/ultra-fast-pseudorandom-
    23                          ;;                                            number-generator-for-8-bit.124249/
    24                          ;; (2) https://www.stix.id.au/wiki/Fast_8-bit_pseudorandom_number_generator
    25                          ;; Links are also on archive.org
    26                          
    27                          ;; NUMBER OF CYCLES AND THEIR LENGTHS:
    28                          ;;     Length   Count   Seeds (a,b,c,x)
    29                          ;; 2826386176    1      00,00,00,00
    30                          ;;  653676288    1      10,00,00,00
    31                          ;;  630179072    1      11,00,00,00
    32                          ;;  136099072    1      2A,00,00,00
    33                          ;;   19772672    2      7B,00,00,00  41,02,00,00
    34                          ;;    3474944    2      5E,02,00,00  BC,04,00,00
    35                          ;;     647936    1      E2,34,00,00
    36                          ;;     401152    1      52,27,00,00
    37                          ;;     224512    1      3E,19,00,00
    38                          ;;     196864    1      2B,38,00,00
    39                          ;;     156160    2      70,27,00,00  03,83,01,00
    40                          ;;      90112    2      FE,3A,00,00  D1,CE,00,00
    41                          ;;      66048    2      1A,0B,01,00  EA,8D,01,00
    42                          ;;       9472    2      65,1D,06,00  53,7E,15,00
    43                          ;;       5376    2      E8,19,01,00  5D,9D,0C,00
    44                          ;;       2048    2      F0,D3,0D,00  7A,F9,54,00
    45                          ;;        512    4      4C,95,3A,00  CF,EC,55,00  97,F6,70,00  E6,26,D3,00
    46                          ;;        256    2      00,02,01,00  7A,9D,21,00
    47                          ;; ----------   --
    48                          ;; 4294967296   30
    49                          
    50                          ;; DIEHARDER RESULT: (dieharder ver. 3.31.1 (C) 2003 Robert G. Brown)
    51                          ;;         test_name   |ntup| tsamples |psamples|  p-value |Assessment
    52                          ;; -- 8< --         108 lines of PASSED TESTS snipped         -- 8< --
    53                          ;;         diehard_opso|   0|   2097152|     100|0.00000000|  FAILED  
    54                          ;;         diehard_oqso|   0|   2097152|     100|0.00000008|  FAILED  
    55                          ;;           sts_serial|   4|    100000|     100|0.99564586|   WEAK   
    56                          ;;          rgb_bitdist|   4|    100000|     100|0.99890820|   WEAK   
    57                          ;; rgb_minimum_distance|   2|     10000|    1000|0.00429146|   WEAK   
    58                          ;;         dab_monobit2|  12|  65000000|       1|1.00000000|  FAILED
    59                          
    60                          ;; Note that  all above data refer  to the original 8-bit  PRNG algorithm, whose
    61                          ;; result  is  stored  in   `caml_nonstd_random_int__a`;  for  the  purposes  of
    62                          ;; BreadCaml, the  result is a 15-bit  OCaml integer, whose least  significant 8
    63                          ;; bits are taken from `caml_nonstd_random_int__a` and the remaining 7 bits from
    64                          ;; `caml_nonstd_random_int__b (discarding the most  significant bit): this could
    65                          ;; affect the strength of the algorithm as a whole.
    66                          
    69                          !zone caml_RANDOM {
    70                          
    71                          !ifdef caml_PRIM__caml_nonstd_random_int {
    72                          caml_nonstd_random_int
    73  55fa eefe55                     INC caml_nonstd_random_int__x
    74                          caml_nonstd_random_int__x = * + 1
    75  55fd a900                       LDA # $00                       ;SMC: LDA x
    76  55ff 4d1656                     EOR caml_nonstd_random_int__c
    77                          caml_nonstd_random_int__a = * + 1
    78  5602 4900                       EOR # $00                       ;SMC: EOR a
    79  5604 8d0356                     STA caml_nonstd_random_int__a
    80  5607 18                         CLC
    81                          caml_nonstd_random_int__b = * + 1
    82  5608 6900                       ADC # $00                       ;SMC: ADC b
    83  560a 8d0956                     STA caml_nonstd_random_int__b
    84  560d 4a                         LSR
    85  560e 9002                       BCC +                           ;Stix's mod: LSR changed with
    86  5610 0980                       ORA # $80                       ;8-bit right rotate
    87  5612 4d0356             +       EOR caml_nonstd_random_int__a
    88                          caml_nonstd_random_int__c = * + 1
    89  5615 6900                       ADC # $00                       ;SMC: ADC c
    90  5617 8d1656                     STA caml_nonstd_random_int__c
    91  561a ad0356                     LDA caml_nonstd_random_int__a   ;a is the 8-bit random number
    92                                  ;; Original PRNG algo ends here.
    93  561d 38                         SEC
    94  561e 2a                         ROL                             ;Return a 15-bit OCaml integer
    95  561f 85fb                       STA ACCU                        ;from a and b, discarding
    96  5621 ad0956                     LDA caml_nonstd_random_int__b   ;bit #7 of b.
    97  5624 2a                         ROL
    98  5625 85fc                       STA ACCU + 1
    99  5627 60                         RTS
   100                          }
   101                          
   102                          !ifdef caml_PRIM__caml_nonstd_random_self_init {
   103                          caml_nonstd_random_self_init
   104                                  ;; ARG0 is (), returned as is
   105  5628 a5a2                       LDA C64_TIME + 2                ;Use the jiffy clock and the
   106  562a 8dfe55                     STA caml_nonstd_random_int__x   ;current raster line no. to
   107  562d 4d12d0                     EOR C64_VIC_RASTER              ;generate a "random" seed
   108  5630 8d0356                     STA caml_nonstd_random_int__a
   109  5633 0a                 -       ASL                             ;"random" delay
   110  5634 d0fd                       BNE -
   111  5636 adfe55                     LDA caml_nonstd_random_int__x
   112  5639 4d12d0                     EOR C64_VIC_RASTER
   113  563c 8d0956                     STA caml_nonstd_random_int__b
   114  563f 4a                 -       LSR                             ;"random" delay
   115  5640 d0fd                       BNE -
   116  5642 ad12d0                     LDA C64_VIC_RASTER
   117  5645 8d1656                     STA caml_nonstd_random_int__c
   118  5648 60                         RTS
   119                          }
   120                          
   121                          !ifdef caml_PRIM__caml_nonstd_random_set_state {
   122                          caml_nonstd_random_set_state
   123                                  ;; ARG0 is a 4-char string "xabc"
   124  5649 a003                       LDY #3
   125  564b b1fb                       LDA (ACCU),Y
   126  564d 8d1656                     STA caml_nonstd_random_int__c
   127  5650 88                         DEY
   128  5651 b1fb                       LDA (ACCU),Y
   129  5653 8d0956                     STA caml_nonstd_random_int__b
   130  5656 88                         DEY
   131  5657 b1fb                       LDA (ACCU),Y
   132  5659 8d0356                     STA caml_nonstd_random_int__a
   133  565c 88                         DEY
   134  565d b1fb                       LDA (ACCU),Y
   135  565f 8dfe55                     STA caml_nonstd_random_int__x
   136  5662 84fc                       STY ACCU + 1
   137  5664 a901                       LDA #<Val_unit
   138  5666 85fb                       STA ACCU
   139  5668 60                         RTS
   140                          }
   141                          
   142                          !ifdef caml_PRIM__caml_nonstd_random_get_state {
   143                          caml_nonstd_random_get_state
   144                                  ;; return a 4-char string "xabc"
   145  5669 a203                       LDX # 3
   146  566b a9fc                       LDA # String_tag
   147  566d 20b750                     JSR caml_alloc
   148  5670 a005                       LDY # 5
   149  5672 a901                       LDA # 1                         ;OCaml string padding \001
   150  5674 914b                       STA (BLK),Y
   151  5676 88                         DEY
   152  5677 a900                       LDA # 0                         ;OCaml string padding \000
   153  5679 914b                       STA (BLK),Y
   154  567b 88                         DEY
   155  567c ad1656                     LDA caml_nonstd_random_int__c
   156  567f 914b                       STA (BLK),Y
   157  5681 88                         DEY
   158  5682 ad0956                     LDA caml_nonstd_random_int__b
   159  5685 914b                       STA (BLK),Y
   160  5687 88                         DEY
   161  5688 ad0356                     LDA caml_nonstd_random_int__a
   162  568b 914b                       STA (BLK),Y
   163  568d 88                         DEY
   164  568e adfe55                     LDA caml_nonstd_random_int__x
   165  5691 914b                       STA (BLK),Y
   166  5693 4c1353                     JMP caml_load_newblk   
   167                          }
   168                          }       ;; !zone caml_RANDOM
   169                          

