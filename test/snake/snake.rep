   226  59a9 c920                       CMP # $20
   227  59ab 901c                       BCC @space
   228  59ad c940                       CMP # $40
   229  59af 9029                       BCC @ret
   230  59b1 c960                       CMP # $60
   231  59b3 9022                       BCC @m40
   232  59b5 c980                       CMP # $80
   233  59b7 9014                       BCC @m20
   234  59b9 c9a0                       CMP # $A0
   235  59bb 900c                       BCC @space
   236  59bd c9c0                       CMP # $C0
   237  59bf 9016                       BCC @m40
