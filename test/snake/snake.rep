    72                          !macro  i11     {+i09 : +i08 7}
    73                          !macro  i12 .n  {+i09 : +i08 .n}                ;PUSHACC n -> PUSH; ACC n
    74                          !macro  i13 .n {                                ;POP n
    75                                  +caml_range 0, .n, $7FFF, "POP n: n"
    76                                  .n2h = >(2 * .n)
    77                                  .n2l = <(2 * .n)
    78                            !if .n = 0 {
    79                                  ;NOP
    80                            } elif .n = 1 {
    81                                  !set    caml_gen_POP1 = 1
    82                                  JSR caml_POP1
    83                            } else {
    84                                  LDA # .n2l
    85                              !if .n2h > 0 {
    86                                  LDY # .n2h
    87                              }
    88                                  !set    caml_gen_POPN = 1
    89                                  JSR caml_POPN
    90                            }
    91                          }
    92                          !macro  i14 .n {                                ;ASSIGN n
    93                                  +caml_range 0, .n, $7FFF, "ASSIGN n: n"
    94                                  .n2h = >(2 * .n)
    95                                  .n2l = <(2 * .n)
    96                                  !set    caml_gen_ASSIGNL = 1
    97                            !if .n2l > 0 {
    98                                  LDY # .n2l
    99                            }
   100                            !if .n2h = 0 {
   101                                  JSR caml_ASSIGNL
   102                            } elif .n2h = 1 {
   103                                  INC SP + 1
   104                                  JSR caml_ASSIGNL
   105                                  DEC SP + 1
   106                            } else {
   107                                  !set    caml_gen_ASSIGNH = 1
   108                                  LDA # .n2h
