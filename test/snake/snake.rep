    85  7af8 c8                         INY
    86  7af9 b14d                       LDA (TMP),Y                     ;hi byte
    87  7afb 88                         DEY
    88  7afc e090                       CPX # <caml_glob_end            ;address >= caml_glob_end?
    89  7afe e991                       SBC # >caml_glob_end
    90  7b00 900a                       BCC @skip
