    16                          ;;                              AUXILIARY TOOLS
    17                          ;; -----------------------------------------------------------------------------
    18                          
    19                          !zone AUX_TOOLS {
    20                          
    21                          .dummy = $1234                          ;dummy operand for self-modifying
    22                                                                  ;code (SMC in comments)
    23                          
    24                          !ifdef caml_AUX__caml_memcpy {
    25                                  ;; Copy a contiguous memory area.  Start address in TMP (wo.),
    26                                  ;; destination address in TMP + 2 (wo.), size in TMP + 4 (wo.).
    27                                  ;; Source and destination areas may overlap.
    28                                  ;; Used registers: A, X, Y. Return Y = 0.
    29                          caml_memcpy
    30                                  @FROM = TMP                     ;source address
    31                                  @TO = TMP + 2                   ;destination address
    32                                  @NUM = TMP + 4                  ;num bytes
    33  7efd a54e                       LDA @FROM + 1
    34  7eff c550                       CMP @TO + 1
    35  7f01 902e                       BCC .caml_memcpy__up
    36  7f03 d009                       BNE .caml_memcpy__dn
    37  7f05 a54d                       LDA @FROM
    38  7f07 c54f                       CMP @TO
    39  7f09 9026                       BCC .caml_memcpy__up
    40  7f0b d001                       BNE .caml_memcpy__dn
    41  7f0d 60                         RTS                             ;just in case @FROM = @TO
    42                          .caml_memcpy__dn
    43                                  ;; copy from a higher address to a lower one
    44  7f0e a000                       LDY # 0
    45  7f10 a652                       LDX @NUM + 1
    46  7f12 f00e                       BEQ +
    47  7f14 b14d               -       LDA (@FROM),Y                   ;move a page at a time
    48  7f16 914f                       STA (@TO),Y
    49  7f18 c8                         INY
    50  7f19 d0f9                       BNE -
    51  7f1b e64e                       INC @FROM + 1
    52  7f1d e650                       INC @TO + 1
    53  7f1f ca                         DEX
    54  7f20 d0f2                       BNE -
    55  7f22 a651               +       LDX @NUM
    56  7f24 f008                       BEQ +
    57  7f26 b14d               -       LDA (@FROM),Y                   ;move the remaining bytes
    58  7f28 914f                       STA (@TO),Y
    59  7f2a c8                         INY
    60  7f2b ca                         DEX
    61  7f2c d0f8                       BNE -
    62  7f2e a000               +       LDY # 0
    63  7f30 60                         RTS
    64                          .caml_memcpy__up
    65                                  ;; copy from a lower address to a higher one
    66  7f31 a652                       LDX @NUM + 1                    ;the last byte must be moved first
    67  7f33 18                         CLC                             ;start at the final pages of from & to
    68  7f34 8a                         TXA
    69  7f35 654e                       ADC @FROM + 1
    70  7f37 854e                       STA @FROM + 1
    71  7f39 18                         CLC
    72  7f3a 8a                         TXA
    73  7f3b 6550                       ADC @TO + 1
    74  7f3d 8550                       STA @TO + 1
    75  7f3f e8                         INX                             ;allows use of BNE after DEX below
    76  7f40 a451                       LDY @NUM
    77  7f42 f00e                       BEQ ++
    78  7f44 88                         DEY                             ;move bytes on the last page first
    79  7f45 f007                       BEQ +
    80  7f47 b14d               -       LDA (@FROM),Y
    81  7f49 914f                       STA (@TO),Y
    82  7f4b 88                         DEY
    83  7f4c d0f9                       BNE -
    84  7f4e b14d               +       LDA (@FROM),Y                   ;handle Y = 0 separately
    85  7f50 914f                       STA (@TO),Y
    86  7f52 88                 ++      DEY
    87  7f53 c64e                       DEC @FROM + 1                   ;move the next page (if any)
    88  7f55 c650                       DEC @TO + 1
    89  7f57 ca                         DEX
    90  7f58 d0ed                       BNE -
    91  7f5a a000                       LDY # 0
    92  7f5c 60                         RTS
    93                          }
    94                          
    95                          !ifdef  caml_AUX__caml_blkcpy {
    96                                  ;; Copy all fields from ACCU to BLK; C:Y = 2 * #fields.
    97                                  ;; The block's header is not copied!
    98                          caml_blkcpy
    99  7f5d 9006                       BCC +                           ; less than 256 bytes (<128 fields)
   100  7f5f f016                       BEQ ++                          ; exactly 256 bytes   (=128 fields)
   101  7f61 e6fc                       INC ACCU + 1                    ; more than 256 bytes (>128 fields)
   102  7f63 e64c                       INC BLK + 1
   103                          --
   104  7f65 88                 +       DEY
   105  7f66 b1fb               -       LDA (ACCU),Y
   106  7f68 914b                       STA (BLK),Y
   107  7f6a 88                         DEY
   108  7f6b d0f9                       BNE -
   109  7f6d b1fb                       LDA (ACCU),Y                    ; handle Y = 0 apart
   110  7f6f 914b                       STA (BLK),Y
   111  7f71 9007                       BCC +
   112  7f73 c6fc                       DEC ACCU + 1
   113  7f75 c64c                       DEC BLK + 1
   114  7f77 18                 ++      CLC
   115  7f78 90eb                       BCC --
   116  7f7a 60                 +       RTS
   117                          }
   118                          
   119                          !ifdef  caml_AUX__caml_err_index_oob {
   120                          caml_err_index_oob
   121                                  ;; Raise the exn below.
   122                                  +caml_raise Invalid_argument, "index out of bounds"

