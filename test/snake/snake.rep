   148                          
   149                          !ifdef caml_AUX__caml_i_alu {
   150                          caml_i_alu                            ;{A = opcode of "op (TMP),Y", X = NB}
   151                                  STA @opc                        ;SMC: patch the opcode
   152                                  JSR caml_i_bin
   153                                  LDY # 2
   154                                  LDA @opc
   155                                  CMP # $80                       ;C=1 only for SBC ($F1); ADC needs 0
   156                          -       LDA (ACCU),Y
   157                          @opc    ADC (TMP),Y                     ;SMC: ADC, SBC, AND, ORA, or EOR.
   158                                  STA (BLK),Y
   159                                  INY
   160                                  DEX
   161                                  BNE -
   162                                  JMP caml_i_ret
   163                          }
