     1                          ;;; ==========================================================================
     2                          ;;; MEMORY MANAGEMENT - HEAP ALLOCATION AND GARBAGE COLLECTION
     3                          ;;; ==========================================================================
     4                          
     5                          !zone caml_MEMORY {
     6                          caml_memory
     7                          
     8                          .dummy = $1234                          ;dummy operand for self-modifying
     9                                                                  ;code (SMC in comments)
    10                          
    11                                  ;; CONSTANTS
    12                          .heap_start     = caml_glob_data                ;start of heap
    13                          .heap_end       = caml_stack_start              ;end of heap + 1
    14                          .halfsz = ((.heap_end - .heap_start) div 4) * 2 ;heap half-size; ensure it's even
    15                          
    16                                  ;; VARIABLES
    17  1f00 e224               .CUR_START      !word .heap_start               ;current half
    18  1f02 7060               .CUR_END        !word .heap_start + .halfsz     ;end of current half
    19  1f04 7060               .OTH_START      !word .heap_start + .halfsz     ;other half of the heap
    20  1f06 fe9b               .OTH_END        !word .heap_start + .halfsz * 2 ;end of other half
    21                          
    23                          ;; globals - due strategie possibili:
    24                          ;; 1) considero i globals già allocati nello heap, con .heap_start =
    25                          ;;    caml_glob_data e inizializzando HEAP a caml_glob_end: in questo
    26                          ;;    modo, quando c'è una gc i globals vengono spostati da una metà
    27                          ;;    all'altra dello heap, ma la scansione dei puntatori nei blocchi
    28                          ;;    è semplice (sta già nell'algo di Cheney)
    29                          ;; 2) tengo i globals fuori dallo heap, con .heap_start = caml_glob_end:
    30                          ;;    così evito lo spostamento dei globals a ogni gc (che può essere
    31                          ;;    costosa ad es. se ci sono grandi array) ma devo considerare ogni
    32                          ;;    puntatore all'interno di ogni blocco dei globals una radice e
    33                          ;;    modificare l'algo di gc.
    34                          ;; PER ORA SI USA 1)
    35                          
    36                          caml_heap_init
    37                                  ;; Initialize the heap pointer. Called by caml_init.
    38  1f08 a910                       LDA # <caml_glob_end                    ;globals are already allocated
    39  1f0a 8530                       STA HEAP                                ;so set HEAP after them
    40  1f0c a926                       LDA # >caml_glob_end
    41  1f0e 8531                       STA HEAP + 1
    42  1f10 60                         RTS
    43                          caml_alloc
    44                                  ;; Allocate a block; params: A=tag, X=size>0 (no atoms!)
    45                                  ;; Return BLK=block's address, A=X=size, Y=0; or raise Out_of_memory.
    46                          @SZ     = GC                                    ;1 by - block size
    47                          @TAG    = GC + 1                                ;1 by - block tag
    48                          @SCN    = GC + 2                                ;2 by scanned block
    49                          @PTR    = GC + 4                                ;2 by aux pointer
    50                          @CNT    = GC + 6                                ;2 by field counter
    51                                  ;; Save the parameters
    52  1f11 8659                       STX @SZ
    53  1f13 855a                       STA @TAG
    54                                  ;; C=0: gc not tried yet; C=1: alloc failed, GC done, retrying)
    55  1f15 18                         CLC
    56  1f16 08                 @retry  PHP                                     ;save GC-done flag on HW stack
    57  1f17 a530                       LDA HEAP
    58  1f19 8557                       STA BLK
    59  1f1b a531                       LDA HEAP + 1
    60  1f1d 8558                       STA BLK + 1
    61                                  ;; Increment HEAP by the # of bytes to be allocated
    62  1f1f e8                         INX                                     ;perform HEAP:=HEAP+2*(size+1):
    63  1f20 d006                       BNE +                                   ;  if size + 1 = 256
    64  1f22 e631                       INC HEAP + 1                            ;  then incr. HEAPh
    65  1f24 e631                       INC HEAP + 1                            ;    twice (512 bytes)
    66  1f26 d00f                       BNE @limits                             ;    BNE=JMP
    67  1f28 8a                 +       TXA                                     ;  else
    68  1f29 0a                         ASL                                     ;    C:A := 2*(size+1),
    69  1f2a 9003                       BCC +                                   ;    if carry set then
    70  1f2c e631                       INC HEAP + 1                            ;      add it to HEAPh,
    71  1f2e 18                         CLC
    72  1f2f 6530               +       ADC HEAP                                ;    add 2*(size+1)
    73  1f31 8530                       STA HEAP                                ;    to HEAPl
    74  1f33 9002                       BCC @limits
    75  1f35 e631                       INC HEAP + 1
    76                                  ;; If there's enough room, write tag and size into the header and exit
    77  1f37 ad021f             @limits LDA .CUR_END
    78  1f3a c530                       CMP HEAP
    79  1f3c ad031f                     LDA .CUR_END + 1
    80  1f3f e531                       SBC HEAP + 1                            ;.CUR_END < HEAP?
    81  1f41 9015                       BCC @gctry                              ;yes: try a garbage collection
    82  1f43 a55a                       LDA @TAG                                ;no: write tag and size  
    83  1f45 a000                       LDY # 0
    84  1f47 9157                       STA (BLK),Y                             ;  header's 1st by. := tag
    85  1f49 e657                       INC BLK                                 ;  (safe, BLK is even)
    86  1f4b a559                       LDA @SZ
    87  1f4d 9157                       STA (BLK),Y                             ;  header's 2nd by. := size
    88  1f4f e657                       INC BLK
    89  1f51 d002                       BNE +
    90  1f53 e658                       INC BLK + 1                             ;  BLK=address of field(0)
    91  1f55 28                 +       PLP                                     ;  pop GC-done flag
    92  1f56 aa                         TAX                                     ;  RETURN A=X=size, BLK=addr,
    93  1f57 60                         RTS                                     ;    C=GC-done flag.
    94                                  ;; else try a GC or, if already done, raise OOM
    95  1f58 28                 @gctry  PLP                                     ;get GC-done flag from HW stack
    96  1f59 b008                       BCS @oom                                ;check if GC done yet:
    97  1f5b 206e1f                     JSR .caml_garbage_collect               ;no: call the garbage collector
    98  1f5e a659                       LDX @SZ                                 ; X := size
    99  1f60 38                         SEC                                     ; set GC-done flag
   100  1f61 b0b3                       BCS @retry                              ; then try to allocate again.
   101                          @oom    +caml_raise Out_of_memory               ;

; ******** macro from /home/pifu/.opam/LTS/lib/bcaml/loader.asm
   155                          .exn
   156  1f63 a990                LDA # <caml_std_exn[.exn]
   157  1f65 852c                STA ACCU
   158  1f67 a908                LDA # >caml_std_exn[.exn]
   159  1f69 852d                STA ACCU + 1
   160  1f6b 4ce317              JMP caml_RAISE

; ******** Source: /home/pifu/.opam/LTS/lib/bcaml/memory.asm
   101                          yes: raise OOM.
   102                          
   103                          .caml_garbage_collect
   104                                  ;; Stop-and-copy garbage collector, based on C.J. Cheney's algorithm
   105                                  ;; 1) Swap the current half of the heap with the other one
   106  1f6e ad041f                     LDA .OTH_START                          ;lo bytes...
   107  1f71 ae001f                     LDX .CUR_START
   108  1f74 8d001f                     STA .CUR_START
   109  1f77 8e041f                     STX .OTH_START
   110  1f7a 8530                       STA HEAP
   111  1f7c ad061f                     LDA .OTH_END
   112  1f7f ae021f                     LDX .CUR_END
   113  1f82 8d021f                     STA .CUR_END
   114  1f85 8e061f                     STX .OTH_END
   115  1f88 ad051f                     LDA .OTH_START + 1                      ;...and hi bytes
   116  1f8b ae011f                     LDX .CUR_START + 1
   117  1f8e 8d011f                     STA .CUR_START + 1
   118  1f91 8e051f                     STX .OTH_START + 1
   119  1f94 8531                       STA HEAP + 1
   120  1f96 ad071f                     LDA .OTH_END + 1
   121  1f99 ae031f                     LDX .CUR_END + 1
   122  1f9c 8d031f                     STA .CUR_END + 1
   123  1f9f 8e071f                     STX .OTH_END + 1
   124                                  ;; 2) Scan all roots, copy each pointed block to the fresh half,
   125                                  ;; update each pointer to reference the copy
   126                                  ;; --- Accumulator ---
   127  1fa2 a52c                       LDA ACCU
   128  1fa4 2cb809                     BIT caml_is_block                       ;Is it a pointer?
   129  1fa7 d00f                       BNE +                                   ;Skip if not
   130  1fa9 855b                       STA @SCN
   131  1fab a52d                       LDA ACCU + 1
   132  1fad 855c                       STA @SCN + 1
   133  1faf 208a20                     JSR .caml_gc_fwdptr                     ;Get fwd ptr (maybe copy blk)
   134  1fb2 9004                       BCC +                                   ;Skip if not a ptr in heap
   135  1fb4 852c                       STA ACCU                                ;Save fwd pointer, lo
   136  1fb6 862d                       STX ACCU + 1                            ;     and hi byte.
   137                                  ;; --- Environment ---
   138  1fb8 a534               +       LDA ENV                                 ;Do as above, for ENV.
   139  1fba 2cb809                     BIT caml_is_block
   140  1fbd d00f                       BNE +
   141  1fbf 855b                       STA @SCN
   142  1fc1 a535                       LDA ENV + 1
   143  1fc3 855c                       STA @SCN + 1
   144  1fc5 208a20                     JSR .caml_gc_fwdptr
   145  1fc8 9004                       BCC +
   146  1fca 8534                       STA ENV
   147  1fcc 8635                       STX ENV + 1
   148                                  ;; --- Stack ---
   149  1fce a900               +       LDA # < caml_stack_start                ;Do as above for all stack elts:
   150  1fd0 8d6220                     STA @testlo + 1                         ;set <last_address
   151  1fd3 a99c                       LDA # > caml_stack_start
   152  1fd5 8d6620                     STA @testhi + 1                         ;set >last_address
   153  1fd8 a900                       LDA # < caml_stack_end
   154  1fda 855d                       STA @PTR                                ;set <first_address + 1
   155  1fdc a9a0                       LDA # > caml_stack_end
   156  1fde 855e                       STA @PTR + 1                            ;set >first_address + 1
   157  1fe0 205920                     JSR .caml_gc_scnroot
   158                                  ;; --- Globals ---
   159  1fe3 a962                       LDA # < caml_glob_table                 ;Same, for globals
   160  1fe5 8d6220                     STA @testlo + 1
   161  1fe8 a924                       LDA # > caml_glob_table
   162  1fea 8d6620                     STA @testhi + 1
   163  1fed a9e2                       LDA # < caml_glob_data
   164  1fef 855d                       STA @PTR
   165  1ff1 a924                       LDA # > caml_glob_data
   166  1ff3 855e                       STA @PTR + 1
   167  1ff5 205920                     JSR .caml_gc_scnroot
   168                                  ;; 3) Scan all pointers in blocks that have been copied to the fresh
   169                                  ;; half of the heap, copy their pointed blocks to the fresh half,
   170                                  ;; update each pointer to reference the copy.
   171  1ff8 ad001f                     LDA .CUR_START
   172  1ffb 855d                       STA @PTR
   173  1ffd ad011f                     LDA .CUR_START + 1
   174  2000 855e                       STA @PTR + 1
   175  2002 a55d               --      LDA @PTR                                ;Loop: scan blocks
   176  2004 c530                       CMP HEAP
   177  2006 a55e                       LDA @PTR + 1
   178  2008 e531                       SBC HEAP + 1
   179  200a b04c                       BCS +++                                 ;Exit loop if @PTR >= HEAP
   180  200c b15d                       LDA (@PTR),Y                            ; Load tag (Y=0 here)
   181  200e aa                         TAX                                     ; Save it in X
   182  200f e65d                       INC @PTR                                ; Safe, @PTR is even before INC
   183  2011 b15d                       LDA (@PTR),Y                            ; Load block size
   184  2013 e65d                       INC @PTR                                ; Set @PTR to point to Field(0)
   185  2015 d002                       BNE +
   186  2017 e65e                       INC @PTR + 1
   187  2019 e0fb               +       CPX # No_scan_tag                       ; Is tag >= No_scan_tag?
   188  201b 9010                       BCC @scan
   189  201d 0a                         ASL                                     ; Yes: compute A := 2*size and
   190  201e 9003                       BCC +                                   ;  add it to @PTR.
   191  2020 e65e                       INC @PTR + 1
   192  2022 18                         CLC
   193  2023 655d               +       ADC @PTR
   194  2025 855d                       STA @PTR
   195  2027 90d9                       BCC --
   196  2029 e65e                       INC @PTR + 1                            ;  Now @PTR->next block's header
   197  202b b0d5                       BCS --                                  ;  Continue the outer loop.
   198  202d 855f               @scan   STA @CNT                                ; No: set @CNT = # of fields
   199  202f b15d               -       LDA (@PTR),Y                            ; Loop: scan fields
   200  2031 2cb809                     BIT caml_is_block                       ;  Is current field a block?
   201  2034 d014                       BNE @next                               ;  Skip it if not.
   202  2036 855b                       STA @SCN                                ;  Yes: store it in @SCN, lo by.
   203  2038 c8                         INY
   204  2039 b15d                       LDA (@PTR),Y
   205  203b 855c                       STA @SCN + 1                            ;  and hi by.
   206  203d 88                         DEY
   207  203e 208a20                     JSR .caml_gc_fwdptr                     ;  Get fwd ptr (maybe copy blk)
   208  2041 9007                       BCC @next                               ;  Skip if block is out_of_heap
   209  2043 915d                       STA (@PTR),Y                            ;  Save fwd ptr, lo byte
   210  2045 8a                         TXA                                     ;  A := fwd ptr, hi byte
   211  2046 c8                         INY
   212  2047 915d                       STA (@PTR),Y                            ;  Save fwd ptr, hi byte.
   213  2049 88                         DEY                                     ;  Y=0 now.
   214  204a e65d               @next   INC @PTR                                ;  Increment @PTR twice to let
   215  204c e65d                       INC @PTR                                ;  it point to next field.
   216  204e d002                       BNE +
   217  2050 e65e                       INC @PTR + 1
   218  2052 c65f               +       DEC @CNT                                ;  Decrement loop counter
   219  2054 d0d9                       BNE -                                   ; End of loop: scan fields.
   220  2056 f0aa                       BEQ --                                  ;End of loop: scan blocks.
   221  2058 60                 +++     RTS                                     ;GC done.
   222                          
   223                          .caml_gc_scnroot
   224                                  ;; Subroutine: loop on @PTR > last_address and call .caml_gc_fwdptr
   225  2059 a55d               -       LDA @PTR
   226  205b d002                       BNE +
   227  205d c65e                       DEC @PTR + 1
   228  205f c65d               +       DEC @PTR                                ;@PTR points to curr elt, hi by.
   229  2061 a934               @testlo LDA # <.dummy                           ;SMC: real arg is <last_address
   230  2063 c55d                       CMP @PTR
   231  2065 a912               @testhi LDA # >.dummy                           ;SMC: real arg is >last_address
   232  2067 e55e                       SBC @PTR + 1
   233  2069 b01e                       BCS +                                   ;Exit loop if all elts scanned
   234  206b b15d                       LDA (@PTR),Y                            ;Get hi byte (Y=0 here)
   235  206d aa                         TAX                                     ;Save it in X
   236  206e c65d                       DEC @PTR                                ;Safe, @PTR is odd before DEC
   237  2070 b15d                       LDA (@PTR),Y                            ;Get lo byte
   238  2072 2cb809                     BIT caml_is_block                       ;Is it a pointer?
   239  2075 d0e2                       BNE -                                   ;If not, skip it
   240  2077 855b                       STA @SCN                                ;Save the pointer, lo byte
   241  2079 865c                       STX @SCN + 1                            ;and hi byte
   242  207b 208a20                     JSR .caml_gc_fwdptr                     ;Get fwd ptr (maybe copy blk)
   243  207e 90d9                       BCC -                                   ;Skip if out_of_heap
   244  2080 915d                       STA (@PTR),Y                            ;Save fwd pointer, lo byte
   245  2082 8a                         TXA                                     ;(prepare to save hi by: A := X
   246  2083 c8                         INY                                     ; and adjust Y)
   247  2084 915d                       STA (@PTR),Y                            ;Save hi byte
   248  2086 88                         DEY                                     ;Y=0 now
   249  2087 f0d0                       BEQ -                                   ;BEQ=JMP, continue loop
   250  2089 60                 +       RTS
   251                          .caml_gc_fwdptr
   252                                  ;; Subroutine: if @SCN is allocated in the old half of the heap, copy
   253                                  ;; it in the fresh one, set Field(0)=forward pointer, set size=0, then
   254                                  ;; return C=1, X:A=fwd ptr, Y=0; if already copied, return C=0, Y=0.
   255  208a a55b                       LDA @SCN                                ;Check if out-of-heap ptr:
   256  208c cd041f                     CMP .OTH_START
   257  208f a55c                       LDA @SCN + 1
   258  2091 ed051f                     SBC .OTH_START + 1                      ;@SCN < lower bound?
   259  2094 900d                       BCC +                                   ;yes: exit
   260  2096 a55b                       LDA @SCN
   261  2098 cd061f                     CMP .OTH_END
   262  209b a55c                       LDA @SCN + 1
   263  209d ed071f                     SBC .OTH_END + 1                        ;@SCN >= higher bound?
   264  20a0 9002                       BCC ++                                  ;no:  go ahead
   265  20a2 18                         CLC                                     ;yes: clear carry and exit
   266  20a3 60                 +       RTS                                     ;RETURN C=0, Y=0.
   267  20a4 c65c               ++      DEC @SCN + 1                            ;decrement ptr's hi byte
   268  20a6 a0ff                       LDY # -1                                ; and set Y in order to
   269  20a8 b15b               @again  LDA (@SCN),Y                            ; get block size
   270  20aa d00c                       BNE @copy                               ;if size = 0
   271  20ac e65c                       INC @SCN + 1                            ;then restore the pointer,
   272  20ae a001                       LDY # 1                                 ;  get fwd ptr from Field(0):
   273  20b0 b15b                       LDA (@SCN),Y                            ;    get hi byte
   274  20b2 aa                         TAX                                     ;    and save it in X
   275  20b3 88                         DEY                                     ;    get lo byte
   276  20b4 b15b                       LDA (@SCN),Y                            ;    and save it in A
   277  20b6 38                         SEC                                     ;  set C=1
   278  20b7 60                         RTS                                     ;  RETURN C=1, X:A=fwdptr, Y=0.
   279  20b8 aa                 @copy   TAX                                     ;else X := size
   280  20b9 a900                       LDA # 0                                 ;  mark this block as visited,
   281  20bb 915b                       STA (@SCN),Y                            ;    setting its size = 0
   282  20bd 88                         DEY                                     ;  Y := $FE
   283  20be b15b                       LDA (@SCN),Y                            ;  A := tag
   284  20c0 c9f9                       CMP # Infix_tag                         ;  is it an infix block?
   285  20c2 f055                       BEQ @infix                              ;  yes: skip to proper section.
   286  20c4 e65c                       INC @SCN + 1                            ;  restore the pointer
   287  20c6 a000                       LDY # 0                                 ;  and Y register
   288  20c8 9130                       STA (HEAP),Y                            ;  write tag in new block
   289  20ca e630                       INC HEAP
   290  20cc 8a                         TXA
   291  20cd 9130                       STA (HEAP),Y                            ;  write size
   292  20cf e630                       INC HEAP                                ;  now HEAP->Field(0)
   293  20d1 d002                       BNE +
   294  20d3 e631                       INC HEAP + 1
   295  20d5 a530               +       LDA HEAP
   296  20d7 8557                       STA BLK                                 ;  BLK := &Field(0)
   297  20d9 a531                       LDA HEAP + 1
   298  20db 8558                       STA BLK + 1
   299  20dd 8a                         TXA                                     ;  Add 2*size to HEAP
   300  20de 0a                         ASL
   301  20df 9003                       BCC +
   302  20e1 e631                       INC HEAP + 1
   303  20e3 18                         CLC
   304  20e4 6530               +       ADC HEAP
   305  20e6 8530                       STA HEAP
   306  20e8 9002                       BCC +
   307  20ea e631                       INC HEAP + 1
   308  20ec 8a                 +       TXA                                     ;  Prepare to copy all fields:
   309  20ed 0a                         ASL
   310  20ee a8                         TAY                                     ;  C:Y := 2*size
   311  20ef 9006                       BCC @lt256                              ;   2*size < 256by (<128 fields)
   312  20f1 f016                       BEQ @eq256                              ;   2*size = 256by (=128 fields)
   313  20f3 e65c                       INC @SCN + 1                            ;   2*size > 256by (>128 fields)
   314  20f5 e658                       INC BLK + 1
   315                          --                                              ;  loop: copy @SCN fields to BLK
   316  20f7 88                 @lt256  DEY
   317  20f8 b15b               -       LDA (@SCN),Y
   318  20fa 9157                       STA (BLK),Y
   319  20fc 88                         DEY
   320  20fd d0f9                       BNE -
   321  20ff b15b                       LDA (@SCN),Y                            ;   handle Y = 0 apart
   322  2101 9157                       STA (BLK),Y
   323  2103 9007                       BCC @wrtfwd                             ;  exit loop
   324  2105 c65c                       DEC @SCN + 1
   325  2107 c658                       DEC BLK + 1
   326  2109 18                 @eq256  CLC
   327  210a 90eb                       BCC --
   328  210c c8                 @wrtfwd INY                                     ;  Y:=1
   329  210d a558                       LDA BLK + 1                             ;  load fwd pointer, hi
   330  210f 915b                       STA (@SCN),Y                            ;  write it in field(0), hi
   331  2111 aa                         TAX                                     ;  and move it in X
   332  2112 88                         DEY                                     ;  Y := 0
   333  2113 a557                       LDA BLK                                 ;  load fwd pointer, lo
   334  2115 915b                       STA (@SCN),Y                            ;  and write it in field(0),lo
   335  2117 38                         SEC                                     ;  set carry before exit
   336  2118 60                         RTS                                     ;  RETURN (X:A=fwdptr, Y=0)
   337  2119 8a                 @infix  TXA                                     ;A:=X=size=dist.from main blk
   338  211a 8e3821                     STX @dst + 1                            ;save it for later
   339  211d 0a                         ASL                                     ;C:A := 2*dist.
   340  211e 8d2921                     STA @dst2lo + 1                         ;write next SBC's arg.
   341  2121 9002                       BCC +                                   ;perform @SCN:=@SCN-.DST:
   342  2123 c65c                       DEC @SCN + 1                            ;  decr @SCN_hi if C set
   343  2125 a55b               +       LDA @SCN                                ;  load @SCN_lo
   344  2127 38                         SEC
   345  2128 e934               @dst2lo SBC # <.dummy                           ;  SMC: subtract <2*dist.
   346  212a 855b                       STA @SCN                                ;  save result, lo by.
   347  212c b002                       BCS +
   348  212e c65c                       DEC @SCN + 1                            ;  adjust hi by.
   349  2130 c8                 +       INY                                     ;(@SCN),Y = main block's size
   350  2131 20a820                     JSR @again                              ;get main block's fwdptr in X:A
   351  2134 8d3f21                     STA @fwdlo + 1                          ;write next ADC's arg.
   352  2137 a934               @dst    LDA # <.dummy                           ;SMC: get infix's SIZE
   353  2139 0a                         ASL                                     ;A := <SIZE*2, C := >SIZE*2 
   354  213a 9002                       BCC @fwdlo                              ;perform X:A:=X:A+main fwd ptr:
   355  213c e8                         INX                                     ;  incr X if SIZE*2>255
   356  213d 18                         CLC
   357  213e 6934               @fwdlo  ADC # <.dummy                           ;  SMC: add forward ptr, lo byte
   358  2140 9001                       BCC +
   359  2142 e8                         INX                                     ;  adjust X
   360  2143 38                 +       SEC                                     ;set carry before exit
   361  2144 60                         RTS                                     ;RETURN(X:A=infix forward ptr)
   362                          caml_shrink_latest_alloc
   363                                  ;; Reduce the size of the latest allocated block; new size MUST BE less
   364                                  ;; than the original one (no check) and NO GARBAGE COLLECTION occurred
   365                                  ;; since the block allocation. Params: X=size>0, Y=0, BLK=address.
   366                                  ;; Shrinking is done by updating the new size in the block's header and
   367                                  ;; the HEAP pointer.
   368                                  ;; Return: A=X=size, Y=0.
   369                          @SZ     = GC                                    ;2 by - block size in bytes
   370  2145 c658                       DEC BLK + 1                             ;Prepare access to the 'size'
   371  2147 88                         DEY                                     ; byte in block's header
   372  2148 b157                       LDA (BLK),Y                             ;Read original size from header
   373  214a 8559                       STA @SZ                                 ; and save it
   374  214c 8a                         TXA                                     ;A := new size
   375  214d 9157                       STA (BLK),Y                             ;Write new size into header
   376  214f e658                       INC BLK + 1                             ;Restore block pointer
   377  2151 c8                         INY                                     ; and Y register
   378  2152 49ff                       EOR # $FF                               ;Do an inverse subtraction:
   379  2154 38                         SEC                                     ; A := @SZ - A
   380  2155 6559                       ADC @SZ                                 ;    = orig.size - new size
   381  2157 0a                         ASL                                     ;Compute 2 * A
   382  2158 8559                       STA @SZ                                 ;Store result, lo byte, in @SZ
   383  215a 845a                       STY @SZ + 1                             ;Set @SZ + 1 to 0
   384  215c 265a                       ROL @SZ + 1                             ;Store result, MSB, in @SZ + 1
   385  215e a530                       LDA HEAP                                ;Recover unused block bytes by
   386  2160 38                         SEC                                     ; decrementing the heap pointer
   387  2161 e559                       SBC @SZ                                 ; by 2 * (orig.size - new size)
   388  2163 8530                       STA HEAP                                ;Store new value, lo byte
   389  2165 a531                       LDA HEAP + 1
   390  2167 e55a                       SBC @SZ + 1
   391  2169 8531                       STA HEAP + 1                            ;Store new value, hi byte
   392  216b 60                         RTS                                     ;Return.
   393                          caml_memory_end
   394                          } ;!zone caml_MEMORY
