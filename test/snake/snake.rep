   544                          ;; ----------------------------------------------------------------------------
   545                          ;;      UNCAUGHT EXCEPTIONS
   546                          ;; ----------------------------------------------------------------------------
   547                          ;; Arguments: only integer values ​​and blocks with String_tag are printed. Other
   548                          ;; blocks are printed as "_", except for the ONE block argument to the "special"
   549                          ;; exceptions Match_failure, Assert_failure, and Undef_rec_module, which has
   550                          ;; type (string * int * int) and is printed in full.
   551                          ;;
   552                          ;; Exception with no arguments:
   553                          ;;   { Object_tag; 2 | { String_tag; n | ASCII_chars } | oid } = EXN_BLOCK
   554                          ;; Exception with k>0 arguments:
   555                          ;;   { 0; k | EXN_BLOCK | arg1 | ... | argk }
   556                          ;; Special exceptions:
   557                          ;;   { 0; 2 | EXN_BLOCK | { 0; 3 | string | int | int } }
   558                          
   559                                  ;; Print the uncaught exception in ACCU with its arguments, if any.
   560                          caml_uncaught_exn
   561                                  @tmp    = TMP                   ;@get_tag_sz, @get_field, @pr_exn
   562                                  @fld1   = TMP + 2               ;main routine
   563                                  @sz     = TMP + 4               ;main routine
   564                                  @arg    = TMP + 2               ;@pr_arg
   565                                  @out    = TMP + 4               ;@pr_arg
   566                                  @count  = TMP + 6               ;@pr_arg
   567  0b7c a902                       LDA # 2                         ;Exit code 2 (as in OCaml for an
   568  0b7e 8d0c03                     STA C64_SAREG                   ; uncaught exception)
   569  0b81 a900                       LDA # 0
   570  0b83 8d0d03                     STA C64_SXREG
   571  0b86 a200                       LDX # 0
   572  0b88 bda90b             -       LDA @uncght,X                   ;Print "\rException: "
