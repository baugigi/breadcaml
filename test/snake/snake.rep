   125                          !ifdef  caml_AUX__caml_ptr_add2A {
   126                                  ;; Add 2 * A to a ZP pointer.
   127                          caml_ptr_add2A
   128                                  ASL                             ;{X = ptr addr, A = n}
   129                                  BCC +
   130                                  INC 1,X
   131                                  CLC
   132                          +       ADC 0,X
   133                                  STA 0,X
   134                                  BCC +
   135                                  INC 1,X
   136                          +       RTS                             ;{X = ptr addr, A = <2n, ptr += 2n}
