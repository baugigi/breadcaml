   306                          !ifdef caml_PRIM__caml_nonstd_string_of_int {
   307                          caml_nonstd_string_of_int
   308                                  ;; Stdlib.string_of_int
   309                                  ;; Convert an int to string, using the C64 format: first char for sign
   310                                  ;; (space if positive, minus if negative), followed by 5 digit max and
   311                                  ;; no non-significative zeroes.
   312                          @DGT    = TMP
   313                          @SKIPZ  = TMP + 1
   314  2376 a9fc                       LDA # String_tag                        ;Max len is 4 words:
   315  2378 a204                       LDX # 4                                 ;|'-','1'|'6','3'|'8','3'|\0,\1|
   316  237a 20111f                     JSR caml_alloc                          ;Allocate string, addr in BLK
   317  237d a920                       LDA # ' '                               ;Positive numbers start with ' '
   318  237f 242d                       BIT ACCU + 1
   319  2381 100e                       BPL +
   320  2383 38                         SEC                                     ;If value is negative,
   321  2384 a902                       LDA # 2                                 ; negate it
   322  2386 e52c                       SBC ACCU
   323  2388 852c                       STA ACCU
   324  238a 98                         TYA
   325  238b e52d                       SBC ACCU + 1
   326  238d 852d                       STA ACCU + 1
   327  238f a92d                       LDA # '-'                               ; and put a '-' into the string
   328  2391 9157               +       STA (BLK),Y
   329  2393 c8                         INY
   330  2394 462d                       LSR ACCU + 1                            ;Get rid of trailing 1
   331  2396 662c                       ROR ACCU
   332  2398 a930                       LDA # '0'                               ;Set SKIPZ flag to '0' (=ignore
   333  239a 8546                       STA @SKIPZ                              ; all initial zeroes)
   334  239c a203                       LDX # 3                                 ;For X := 3 downto 0
   335  239e 8545               --      STA @DGT                                ; Init DGT to '0'
   336  23a0 a52c                       LDA ACCU                                ; Loop for calculating DGT:
   337  23a2 38                         SEC
   338  23a3 fdea23             -       SBC @lo10,X                             ;  Subtract 10^(X+1) from ACCU
   339  23a6 48                         PHA
   340  23a7 a52d                       LDA ACCU + 1
   341  23a9 fdee23                     SBC @hi10,X
   342  23ac 9009                       BCC +                                   ; Exit loop on negative result
   343  23ae 852d                       STA ACCU + 1                            ;  Store result in ACCU
   344  23b0 68                         PLA
   345  23b1 852c                       STA ACCU
   346  23b3 e645                       INC @DGT                                ;  Set DGT to next char digit
   347  23b5 b0ec                       BCS -                                   ; BCS=JMP, Continue loop
   348  23b7 68                 +       PLA
   349  23b8 a545                       LDA @DGT
   350  23ba c546                       CMP @SKIPZ                              ; If DGT='0' & SKIPZ='0'
   351  23bc f007                       BEQ +                                   ; then ignore current digit
   352  23be c646                       DEC @SKIPZ                              ; else stop skipping zeroes,
   353  23c0 9157                       STA (BLK),Y                             ;  put DGT into the string,
   354  23c2 c8                         INY
   355  23c3 a930                       LDA # '0'                               ;  set A='0' for next iteration.
   356  23c5 ca                 +       DEX                                     ; Decrement counter
   357  23c6 10d6                       BPL --                                  ;End_For
   358  23c8 052c                       ORA ACCU                                ;A := '0'|ACCU  (last digit)
   359  23ca 9157                       STA (BLK),Y
   360  23cc c8                         INY
   361  23cd a900                       LDA # 0                                 ;Pad string with \0
   362  23cf 9157                       STA (BLK),Y
   363  23d1 c8                         INY
   364  23d2 98                         TYA
   365  23d3 4a                         LSR                                     ;Compute block size (in wo.)
   366  23d4 aa                         TAX
   367  23d5 9005                       BCC +
   368  23d7 a901                       LDA # 1                                 ;Add \1 pad if necessary
   369  23d9 9157                       STA (BLK),Y
   370  23db e8                         INX                                     ;size +1 for \0\1
   371  23dc a557               +       LDA BLK
   372  23de 852c                       STA ACCU
   373  23e0 a558                       LDA BLK + 1
   374  23e2 852d                       STA ACCU + 1
   375  23e4 a000                       LDY # 0
   376  23e6 204521                     JSR caml_shrink_latest_alloc            ;Shrink block to computed size
   377  23e9 60                         RTS
   378  23ea 0a64e810           @lo10   !byte <10, <100, <1000, <10000
   379  23ee 00000327           @hi10   !byte >10, >100, >1000, >10000
   380                          }
