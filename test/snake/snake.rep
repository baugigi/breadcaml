    81                          !ifdef caml_PRIM__caml_string_get {
    82                          caml_string_get
    83                                  ;; ACCU=string, SP[0]=index
    84                                  ;; return string[index]
    85                          
    86                                  JSR caml_string_index_y
    87                                  LDA (ACCU),Y                            ;get char
    88                                  SEC
    89                                  ROL
    90                                  STA ACCU
    91                                  LDA # 0
    92                                  TAY                                     ;.Y := 0
    93                                  ROL
    94                                  STA ACCU + 1                            ;ACCU := Val_char(char)
    95                                  RTS
    96                          }
    97                          
    98                          !ifdef caml_PRIM__caml_bytes_set {
    99                          caml_bytes_set = caml_string_set
   100                          }
   101                          !ifdef caml_PRIM__caml_string_set {
   102                          caml_string_set
   103                                  ;; ACCU=string, SP[0]=index, SP[1]=newval
   104                                  ;; string.[index]<-newval; return: ()
   105                          ;       TMP                                     ; used by caml_string_index_y
   106                          ;       TMP + 1                                 ; used by caml_string_index_y
   107                          @CHAR   = TMP + 2
   108                                  LDY # 3
   109                                  LDA (SP),Y                              ; get newval, hi
   110                                  DEY
   111                                  LSR
   112                                  LDA (SP),Y                              ; get newval, lo
   113                                  ROR
   114                                  STA @CHAR                               ; save char_val(newval)
   115                                  JSR caml_string_index_y                 ; Y := index
   116                                  LDA @CHAR
   117                                  STA (ACCU),Y                            ; modify string in place
   118                                  LDY # <Val_unit
   119                                  STY ACCU
   120                                  DEY
   121                                  STY ACCU + 1                            ; return ()
   122                                  RTS
   123                          }
   124                          
   125                          !ifdef caml_PRIM__caml_fill_bytes {
   126                          caml_fill_bytes = caml_fill_string
   127                          }
   128                          !ifdef caml_PRIM__caml_fill_string {
   129                          caml_fill_string
   130                                  ;; ACCU = string, SP[0]=ofs, SP[1]=num, SP[2]=char
   131                                  ;; for num times, string.[i]<-char starting from i=ofs; return: ()
   132                                  ;; (unsafe, args are checked in Bytes module)
   133                          
   134                                  ;; TMP + 1 <- int_val(num)
   135                                  LDY # 3
   136                                  LDA (SP),Y
   137                                  LSR
   138                                  STA TMP + 1
   139                                  DEY
   140                                  LDA (SP),Y
   141                                  ROR
   142                                  BNE +
   143                                  CMP TMP + 1
   144                                  BEQ ++                          ;num = 0, nothing to do
   145                          +       STA TMP
   146                                  ;; ACCU <- ACCU + int_val(pos)
   147                                  DEY
   148                                  LDA (SP),Y
   149                                  LSR
   150                                  TAX
   151                                  DEY
   152                                  LDA (SP),Y
   153                                  ROR
   154                                  CLC
   155                                  ADC ACCU
   156                                  STA ACCU
   157                                  TXA
   158                                  ADC ACCU + 1
   159                                  STA ACCU + 1
   160                                  ;; A <- int_val(char)
   161                                  LDY # 5
   162                                  LDA (SP),Y
   163                                  LSR
   164                                  DEY
   165                                  LDA (SP),Y
   166                                  ROR
   167                                  ;; start substitution
   168                                  LDY # 0
   169                                  LDX TMP
   170                          --      STA (ACCU),Y                            ;modify string in place
   171                                  DEX
   172                                  BEQ +
   173                          -       INY
   174                                  BNE --
   175                                  INC ACCU + 1
   176                                  JMP --
   177                          +       CPX TMP + 1
   178                                  BEQ ++
   179                                  DEC TMP + 1
   180                                  JMP -
   181                          ++      LDY # <Val_unit
   182                                  STY ACCU
   183                                  DEY
   184                                  STY ACCU + 1                            ;return ()
   185                                  RTS
   186                          }
