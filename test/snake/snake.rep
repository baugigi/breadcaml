   154                          
   155                                  ;; TMP + 1 <- int_val(num)
   156  5721 a003                       LDY # 3
   157  5723 b1fd                       LDA (SP),Y
   158  5725 4a                         LSR
   159  5726 854e                       STA TMP + 1
   160  5728 88                         DEY
