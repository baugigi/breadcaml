    24                          !ifdef caml_PRIM__caml_bytes_of_string {
    25                          caml_bytes_of_string
    26  5696 88                         DEY
    27  5697 c6fc                       DEC ACCU + 1
    28  5699 b1fb                       LDA (ACCU),Y
    29  569b aa                         TAX
    30  569c e6fc                       INC ACCU + 1
    31  569e a9fc                       LDA # String_tag
    32  56a0 20b750                     JSR caml_alloc
    33  56a3 8a                         TXA
    34  56a4 0a                         ASL
    35  56a5 a8                         TAY
    36  56a6 200555                     JSR caml_blkcpy
    37  56a9 4c1353                     JMP caml_load_newblk
    38                          }
    39                          
    40                          !ifdef caml_PRIM__caml_create_bytes {
    41                          caml_create_bytes = caml_create_string
    42                          }
    43                          !ifdef caml_PRIM__caml_create_string {
    44                          caml_create_string
    45                                  ;; ACCU = length
    46                                  ;; alloc a new block for a string of given length (max 509)
    47  56ac a5fb                       LDA ACCU
    48  56ae 854d                       STA TMP
    49  56b0 a5fc                       LDA ACCU + 1                    ;load >length
    50  56b2 4a                         LSR                             ;
    51  56b3 664d                       ROR TMP                         ;A:TMP := Int_val(lenght)
    52  56b5 4a                         LSR
    53  56b6 d028                       BNE +++                         ;A>0 => len > max, raise exn.
    54  56b8 664d                       ROR TMP                         ;TMP :=  Int_val(lenght) / 2
    55  56ba 08                         PHP                             ;save carry (remainder)
    56  56bb a64d                       LDX TMP                         ;X := block size, in words
    57  56bd e8                         INX                             ;take into account Ocaml padding
    58  56be f01f                       BEQ ++                          ;Exception if size > 255
    59  56c0 a9fc                       LDA # String_tag                ;load tag
    60  56c2 20b750                     JSR caml_alloc                  ;allocate block
    61  56c5 201353                     JSR caml_load_newblk            ;ACCU := address of new block
    62  56c8 ca                         DEX                             ;Compute the padding bytes:
    63  56c9 8a                         TXA                             ;A := size - 1
    64  56ca 0a                         ASL                             ;A := 2 * size - 2
    65  56cb 9002                       BCC +
    66  56cd e64c                       INC BLK + 1
    67  56cf a8                 +       TAY                             ;BLK+.Y = address of last word
    68  56d0 a900                       LDA # 0
    69  56d2 28                         PLP                             ;reload .C flag
    70  56d3 b004                       BCS +                           ;string length is odd?
    71  56d5 914b                       STA (BLK),Y                     ;no: padding = "\000\001"
    72  56d7 a901                       LDA # 1
    73  56d9 c8                 +       INY                             ;yes: padding = "\000"
    74  56da 914b                       STA (BLK),Y
    75  56dc a000                       LDY # 0
    76  56de 60                         RTS
    77  56df 28                 ++      PLP
    78                          +++     +caml_raise Invalid_argument, "String.create"

