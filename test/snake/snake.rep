   649  824b d004                       BNE @gt
   650  824d a900                       LDA # 0                         ;(equal)
   651  824f f006                       BEQ @ret                        ;BEQ=JMP
   652  8251 a901               @gt     LDA # 1
   653  8253 d002                       BNE @ret                        ;BNE=JMP
   654  8255 a9ff               @lt     LDA # -1
   655  8257 a000               @ret    LDY # 0
   656  8259 0900                       ORA # 0                         ;set status byte according to A
   657  825b 60                         RTS
