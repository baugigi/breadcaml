    19                          !ifdef caml_PRIM__caml_nonstd_mem_peek {
    20                          caml_nonstd_mem_peek
    21                                  ;; Sys.mem_peek lo hi returns the content of memory location at address
    22                                  ;; 256*hi+lo as an integer; lo, hi are taken modulo 256.
    23  5887 c8                         INY
    24  5888 b1fd                       LDA (SP),Y
    25  588a 4a                         LSR
    26  588b 88                         DEY
    27  588c b1fd                       LDA (SP),Y
    28  588e 6a                         ROR
    29  588f 66fc                       ROR ACCU + 1
    30  5891 85fc                       STA ACCU + 1
    31  5893 66fb                       ROR ACCU
    32  5895 b1fb                       LDA (ACCU),Y
    33  5897 2a                         ROL
    34  5898 85fb                       STA ACCU
    35  589a 84fc                       STY ACCU + 1
    36  589c 26fc                       ROL ACCU + 1
    37  589e 60                         RTS
    38                          }
