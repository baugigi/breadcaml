    14                          
    15                          ;;; --------------------
    16                          ;;;        RANDOM
    17                          ;;; --------------------
    18                          
    19                          ;; X ABC Algorithm Pseudo-Random Number Generator for 8-Bit Devices.
    20                          ;; Quite fast, but not good for cryptographic/security purposes.
    21                          ;; From EternityForest, https://www.electro-tech-online.com/threads/
    22                          ;;      ultra-fast-pseudorandom-number-generator-for-8-bit.124249/
    23                          ;; With modifications by Stix:
    24                          ;;      https://www.stix.id.au/wiki/Fast_8-bit_pseudorandom_number_generator
    25                          ;; Stix's statistics about the cycles of this PRNG:
    26                          ;;     Length   Count   Seeds (a,b,c,x)
    27                          ;; 2826386176    1      00,00,00,00
    28                          ;;  653676288    1      10,00,00,00
    29                          ;;  630179072    1      11,00,00,00
    30                          ;;  136099072    1      2A,00,00,00
    31                          ;;   19772672    2      7B,00,00,00  41,02,00,00
    32                          ;;    3474944    2      5E,02,00,00  BC,04,00,00
    33                          ;;     647936    1      E2,34,00,00
    34                          ;;     401152    1      52,27,00,00
    35                          ;;     224512    1      3E,19,00,00
    36                          ;;     196864    1      2B,38,00,00
    37                          ;;     156160    2      70,27,00,00  03,83,01,00
    38                          ;;      90112    2      FE,3A,00,00  D1,CE,00,00
    39                          ;;      66048    2      1A,0B,01,00  EA,8D,01,00
    40                          ;;       9472    2      65,1D,06,00  53,7E,15,00
    41                          ;;       5376    2      E8,19,01,00  5D,9D,0C,00
    42                          ;;       2048    2      F0,D3,0D,00  7A,F9,54,00
    43                          ;;        512    4      4C,95,3A,00  CF,EC,55,00  97,F6,70,00  E6,26,D3,00
    44                          ;;        256    2      00,02,01,00  7A,9D,21,00
    45                          ;; ----------   --
    46                          ;; 4294967296   30
    47                          ;;
    48                          ;; Please note that those statistics are about 8-bit random numbers (returned in
    49                          ;; caml_nonstd_random_int__a); for BreadCaml purposes, I take a 15-bit OCaml
    50                          ;; integer from caml_nonstd_random_int__a (lo bits) and caml_nonstd_random_int__b
    51                          ;; (hi bits, discarding bit #7): this may affect the whole algorithm strength.
    52                          
    53                          !zone caml_RANDOM {
    54                          
    55                          !ifdef caml_PRIM__caml_nonstd_random_int {
    56                          caml_nonstd_random_int
    57  2225 ee2922                     INC caml_nonstd_random_int__x
    58                          caml_nonstd_random_int__x = * + 1
    59  2228 a900                       LDA # $00                               ;SMC: LDA __x
    60  222a 4d4122                     EOR caml_nonstd_random_int__c
    61                          caml_nonstd_random_int__a = * + 1
    62  222d 4900                       EOR # $00                               ;SMC: EOR __a
    63  222f 8d2e22                     STA caml_nonstd_random_int__a
    64  2232 18                         CLC
    65                          caml_nonstd_random_int__b = * + 1
    66  2233 6900                       ADC # $00                               ;SMC: ADC __b
    67  2235 8d3422                     STA caml_nonstd_random_int__b
    68  2238 4a                         LSR
    69  2239 9002                       BCC +                                   ;Stix's mod: LSR changed with
    70  223b 0980                       ORA # $80                               ;8-bit right rotate
    71  223d 4d2e22             +       EOR caml_nonstd_random_int__a
    72                          caml_nonstd_random_int__c = * + 1
    73  2240 6900                       ADC # $00                               ;SMC: ADC __c
    74  2242 8d4122                     STA caml_nonstd_random_int__c
    75  2245 ad2e22                     LDA caml_nonstd_random_int__a           ;__a is the 8-bit random number
    76                                  ;; end of PRNG algo
    77  2248 38                         SEC
    78  2249 2a                         ROL                                     ;Return a 15-bit OCaml integer
    79  224a 852c                       STA ACCU                                ;from __a and __b, discarding
    80  224c ad3422                     LDA caml_nonstd_random_int__b           ;bit#7 of __b
    81  224f 2a                         ROL
    82  2250 852d                       STA ACCU + 1
    83  2252 60                         RTS
    84                          }
    85                          
    86                          !ifdef caml_PRIM__caml_nonstd_random_self_init {
    87                          caml_nonstd_random_self_init
    88                                  ;; ARG0 is (), returned as is
    89  2253 a5a2                       LDA C64_TIME + 2                        ;Use the jiffy clock and the
    90  2255 8d2922                     STA caml_nonstd_random_int__x           ;current raster line no. to
    91  2258 4d12d0                     EOR C64_VIC_RASTER                      ;generate a "random" seed
    92  225b 8d2e22                     STA caml_nonstd_random_int__a
    93  225e 0a                 -       ASL                                     ;"random" delay
    94  225f d0fd                       BNE -
    95  2261 ad2922                     LDA caml_nonstd_random_int__x
    96  2264 4d12d0                     EOR C64_VIC_RASTER
    97  2267 8d3422                     STA caml_nonstd_random_int__b
    98  226a 4a                 -       LSR                                     ;"random" delay
    99  226b d0fd                       BNE -
   100  226d ad12d0                     LDA C64_VIC_RASTER
   101  2270 8d4122                     STA caml_nonstd_random_int__c
   102  2273 60                         RTS
   103                          }
   104                          
   105                          !ifdef caml_PRIM__caml_nonstd_random_set_state {
   106                          caml_nonstd_random_set_state
   107                                  ;; ARG0 is a 4-char string "xabc"
   108  2274 a003                       LDY #3
   109  2276 b12c                       LDA (ACCU),Y
   110  2278 8d4122                     STA caml_nonstd_random_int__c
   111  227b 88                         DEY
   112  227c b12c                       LDA (ACCU),Y
   113  227e 8d3422                     STA caml_nonstd_random_int__b
   114  2281 88                         DEY
   115  2282 b12c                       LDA (ACCU),Y
   116  2284 8d2e22                     STA caml_nonstd_random_int__a
   117  2287 88                         DEY
   118  2288 b12c                       LDA (ACCU),Y
   119  228a 8d2922                     STA caml_nonstd_random_int__x
   120  228d 842d                       STY ACCU + 1
   121  228f a901                       LDA #<Val_unit
   122  2291 852c                       STA ACCU
   123  2293 60                         RTS
   124                          }
   125                          
   126                          !ifdef caml_PRIM__caml_nonstd_random_get_state {
   127                          caml_nonstd_random_get_state
   128                                  ;; return a 4-char string "xabc"
   129  2294 a203                       LDX # 3
   130  2296 a9fc                       LDA # String_tag
   131  2298 20111f                     JSR caml_alloc
   132  229b a005                       LDY # 5
   133  229d a901                       LDA # 1                                 ;OCaml string padding \001
   134  229f 9157                       STA (BLK),Y
   135  22a1 88                         DEY
   136  22a2 a900                       LDA # 0                                 ;OCaml string padding \000
   137  22a4 9157                       STA (BLK),Y
   138  22a6 88                         DEY
   139  22a7 ad4122                     LDA caml_nonstd_random_int__c
   140  22aa 9157                       STA (BLK),Y
   141  22ac 88                         DEY
   142  22ad ad3422                     LDA caml_nonstd_random_int__b
   143  22b0 9157                       STA (BLK),Y
   144  22b2 88                         DEY
   145  22b3 ad2e22                     LDA caml_nonstd_random_int__a
   146  22b6 9157                       STA (BLK),Y
   147  22b8 88                         DEY
   148  22b9 ad2922                     LDA caml_nonstd_random_int__x
   149  22bc 9157                       STA (BLK),Y
   150  22be a557                       LDA BLK
   151  22c0 852c                       STA ACCU
   152  22c2 a558                       LDA BLK + 1
   153  22c4 852d                       STA ACCU + 1
   154  22c6 60                         RTS
   155                          }
   156                          }       ;; !zone caml_RANDOM
   157                          

