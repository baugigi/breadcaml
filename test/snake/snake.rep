    23                                  ;; --------------------------------------------------------------------
    24                                  ;;      NATIVE CODE GENERATION
    25                                  ;; --------------------------------------------------------------------
    26                          
    27                          ;; Macros in opcode order, but dependencies
    28                          
    29                          ;; i00-i12 depend on i08
    30                          !macro  i08 .n {                                ;ACCESS n
    31                                  +caml_range 0, .n, $7FFF, "ACC n: n" 
    32                                  .n2h = >(2 * .n)
    33                                  .n2l = <(2 * .n)
    34                            !if .n2l > 0 {
    35                                  LDY # .n2l
    36                            }
    37                            !if .n2h = 0 {
    38                                  !set    caml_gen_ACCL = 1
    39                                  JSR caml_ACCL
    40                            } elif .n2h = 1 {
    41                                  !set    caml_gen_ACCL = 1
    42                                  INC SP + 1
    43                                  JSR caml_ACCL
    44                                  DEC SP + 1
    45                            } else {
    46                                  !set    caml_gen_ACCH = 1
    47                                  LDA # .n2h
    48                                  JSR caml_ACCH
    49                            }
    50                          }
    51                          !macro  i00     {+i08 0}                        ;ACCi -> ACC i
    52                          !macro  i01     {+i08 1}
    53                          !macro  i02     {+i08 2}
    54                          !macro  i03     {+i08 3}
    55                          !macro  i04     {+i08 4}
    56                          !macro  i05     {+i08 5}
    57                          !macro  i06     {+i08 6}
    58                          !macro  i07     {+i08 7}
