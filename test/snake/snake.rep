   395                          !ifdef caml_PRIM__caml_copysign_float {
   396                          caml_copysign_float
   397                                  ;; |ACCU| with the sign of SP[0] (the sign of nan is taken as '+')
   398                                  LDY # 0
   399                                  LDA (SP),Y
   400                                  STA TMP
   401                                  INY
   402                                  LDA (SP),Y
   403                                  STA TMP + 1                     ;(TMP) = SP[0]
   404                                  LDY # Float_flag
   405                                  LDA (TMP),Y
   406                                  BNE @yspec
   407                                  LDY # 1                         ;finite: load 1st mantissa byte of
   408                                  LDA (TMP),Y                     ; SP[0] (its bit 7 is the sign)
   409                          @sign   PHA
   410                                  JSR caml_float_unop             ;ACCU --> FAC
   411                                  PLA                             ;(this and TAX do not touch C)
   412                                  TAX
   413                                  BCS @spx
   414                                  STA C64_FAC + 5                 ;copy the sign to FAC sign byte
   415                                  JMP caml_float_alloc_result
   416                          @yspec  CMP # Fl_ninf                   ;special: C=1 only if -inf
   417                                  LDA # 0
   418                                  ROR                             ;bit 7 of .A = sign of SP[0]
   419                                  JMP @sign
   420                          @spx    LDY # Float_flag                ;ACCU is special:
   421                                  LDA (ACCU),Y
   422                                  CMP # Fl_nan
   423                                  BNE @inf
   424                                  LDY # 0                         ; nan: result is ACCU itself
   425                                  RTS
   426                          @inf    LDA # Ft_PINF                   ; infinity:
   427                                  CPX # $80                       ;  C=1 if the sign is '-'
   428                                  BCC @tpl
   429                                  LDA # Ft_NINF
   430                          @tpl    JMP caml_float_ret_tpl
   431                          }
   432                          
   433                          !ifdef caml_PRIM__caml_float_of_string {
   434                          caml_float_of_string
   435                                  ;; Special values first: [+|-] ("nan" | "inf" | "infinity"), any case
   436                                  LDY # 0
   437                                  STY TMP + 2                     ;sign ($FF = '-')
   438                                  LDA (ACCU),Y
   439                                  CMP # '-'
   440                                  BNE @plus
   441                                  DEC TMP + 2
   442                                  INY
   443                                  BNE @word                       ;BNE=JMP
   444                          @plus   CMP # '+'
   445                                  BNE @word
   446                                  INY
   447                          @word   STY TMP + 3
   448                                  LDX # @w_nan - @words
   449                                  JSR @try
   450                                  BEQ @isnan
   451                                  LDX # @w_inf - @words
   452                                  LDY TMP + 3
   453                                  JSR @try
   454                                  BEQ @isinf
   455                                  LDX # @w_infinity - @words
   456                                  LDY TMP + 3
   457                                  JSR @try
   458                                  BNE @num                        ;no match: it is a number
   459                          @isinf  LDA # Ft_PINF
   460                                  BIT TMP + 2
   461                                  BPL @tpl
   462                                  LDA # Ft_NINF
   463                                  BNE @tpl                        ;BNE=JMP
   464                          @isnan  LDA # Ft_NAN
   465                          @tpl    JMP caml_float_ret_tpl
   466                          @try    LDA @words,X                    ;match string at (ACCU),Y with word X
   467                                  BEQ @end                        ; (case-insensitive: PETSCII uppercase
   468                                  LDA (ACCU),Y                    ; letters are $C1-$DA, lowercase $41-$5A)
   469                                  AND # $7F
   470                                  CMP @words,X
   471                                  BNE @no                         ;mismatch: return Z=0
   472                                  INY
   473                                  INX
   474                                  BNE @try                        ;BNE=JMP
   475                          @end    LDA (ACCU),Y                    ;string must end here: return Z=1 if so
   476                          @no     RTS
   477                          @words
   478                          @w_nan      !text "nan", 0
   479                          @w_inf      !text "inf", 0
   480                          @w_infinity !text "infinity", 0
   481                          @num    TSX                             ;overflow (+-infinity): see
   482                                  STX caml_float_overflow__sp     ; caml_float_overflow
   483                                  LDA # Fo_STR
   484                                  STA caml_float_overflow__op
   485                                  LDA C64_CHRPTR                  ;Save the current CHRPTR value
   486                                  STA TMP
   487                                  LDA C64_CHRPTR + 1
   488                                  STA TMP + 1
   489                                  LDA ACCU + 1
   490                                  LDX ACCU
   491                          !ifdef caml_basic_rom_overlap {
   492                                  ;; FIN reads the string with the BASIC ROM on, but the string may be in
   493                                  ;; the RAM under it ($A000-$BFFF): copy it (0-terminated, max 80 chars)
   494                                  ;; to the BASIC input buffer and convert the copy.
   495                                  CMP # > (C64_BASROM - 79)       ;If the first 80 characters of the
   496                                  BCC @setptr                     ; string are below $A000, skip the copy
   497                                  BNE @setptr                     ; and set the pointer to ACCU;
   498                                  CPX # < (C64_BASROM - 79)
   499                                  BCC @setptr
   500                                  LDY # 0                         ;else copy the string to the buffer
   501                          -       LDA (ACCU),Y
   502                                  STA C64_BUF,Y
   503                                  BEQ +
   504                                  INY
   505                                  CPY # 80
   506                                  BCC -
   507                                  LDA # 0
   508                                  STA C64_BUF,Y
   509                          +       LDA # >C64_BUF                  ; and set the pointer to it.
   510                                  LDX # <C64_BUF
   511                          }
   512                          @setptr STA C64_CHRPTR + 1              ;CHRPTR := A:X
   513                                  STX C64_CHRPTR
   514                                  JSR C64_CHRGOT                  ;not a BASIC ROM routine
   515                                  +caml_JSR_BASROM C64_FIN        ;String to float conversion routine
   516                                  ;; FIN never fails: it converts the longest valid prefix (0 if none) and
   517                                  ;; leaves C64_CHRPTR at the first character it did not use. Accept only
   518                                  ;; a string that FIN consumed up to its end (0 byte)...
   519                                  LDY # 0
   520                                  LDA (C64_CHRPTR),Y
   521                                  BNE @bad                        ;trailing garbage ("12abc", "abc")
   522                                  LDA C64_FAC
   523                                  BNE @good                       ;...and, if the result is 0, only if
   524                          @dig    LDA (ACCU),Y                    ; there is a mantissa digit before the
   525                                  BEQ @bad                        ; exponent: "-", ".", "", "e5" are not
   526                                  CMP # $45                       ; numbers, "0", "-0.0", "0e5" are.
   527                                  BEQ @bad                        ;$45 = 'e'
   528                                  EOR # $30
   529                                  CMP # 10
   530                                  BCC @good                       ;a digit
   531                                  INY
   532                                  BNE @dig
   533                          @bad    LDA TMP                         ;Restore the previous value of CHRPTR
   534                                  STA C64_CHRPTR
   535                                  LDA TMP + 1
   536                                  STA C64_CHRPTR + 1
   537                                  +caml_raise Failure, "float_of_string"
   538                          @good   LDA TMP                         ;Restore the previous value of CHRPTR
   539                                  STA C64_CHRPTR
   540                                  LDA TMP + 1
   541                                  STA C64_CHRPTR + 1
   542                                  JMP caml_float_alloc_result
   543                          }
   544                          
   545                          !ifdef caml_PRIM__caml_ldexp_float {
   546                                  ;; compute ACCU * 2 ^ N, -255 < N < 255.
   547                                  ;; SP[0] = Val_int(N) (usual tagged int, two's complement if N < 0)
   548                          caml_ldexp_float
   549                                  LDY # Float_flag
   550                                  LDA (ACCU),Y
   551                                  BEQ @fin
   552                                  LDY # 0                         ;nan, +-infinity: ldexp x n = x
   553                                  RTS
   554                          @fin    LDY # 0
   555                                  LDA # Double_tag
   556                                  LDX # Double_wosize
   557                                  JSR caml_alloc                  ;{Y = 0}
   558                                  LDA # 0                         ;the flag byte of the result is 0
   559                                  LDY # Float_flag                ; (ldexp x n = x if x is nan or inf,
   560                                  STA (BLK),Y                     ;  see below)
   561                                  TAY                             ;.Y = 0
   562                                  LDA (ACCU),Y                    ;(biased) exponent of the source
   563                                  BEQ @save                       ;0.0 * 2^N = 0.0: don't add N to exp 0
   564                                  STA TMP
   565                                  INY
   566                                  LDA (SP),Y                      ;hi byte of Val_int(N)
   567                                  TAX                             ;X: bit 7 = sign of N
   568                                  LSR                             ;C := bit 0 of hi byte
   569                                  DEY
   570                                  LDA (SP),Y
   571                                  ROR                             ;A := low byte of N (two's complement)
   572                                  STA TMP + 1
   573                                  TXA
   574                                  BMI @neg                        ;N < 0 ?
   575                                  LDA TMP + 1                     ;no: exp := exp + N
   576                                  CLC
   577                                  ADC TMP
   578                                  BCC @save
   579                                  LDY # 1                         ; overflow: +-infinity,
   580                                  LDA (ACCU),Y                    ;  with the sign of the source
   581                                  BMI @ninf
   582                                  LDA # Ft_PINF
   583                                  BNE @tpl                        ;BNE=JMP
   584                          @ninf   LDA # Ft_NINF
   585                          @tpl    JMP caml_float_ret_tpl
   586                          @neg    LDA TMP + 1                     ;yes: exp := exp - |N| = exp + (256-|N|)
   587                                  CLC
   588                                  ADC TMP
   589                                  BCS @save                       ; if underflow,
   590                                  LDA # 0                         ;  set exp = 0 (result = 0.0)
   591                          @save   STA (BLK),Y                     ;save exp byte (Y = 0)
   592                                  BEQ +                           ;skip copy of mantissa if zero
   593                                  LDY # 4
   594                          -       LDA (ACCU),Y                    ;copy mantissa
   595                                  STA (BLK),Y
   596                                  DEY
   597                                  BNE -
   598                          +       JMP caml_load_newblk
   599                          }
   600                          
   601                          !ifdef caml_PRIM__caml_frexp_float {
   602                          caml_frexp_float
   603                                  ;; allocate a new float with same mantissa and exp=0
   604                                  LDA # Double_tag                ;tag of new float
   605                                  LDX # Double_wosize             ;size of new float
   606                                  JSR caml_alloc                  ;alloc new float
   607                                  LDY # Float_flag
   608                                  LDA (ACCU),Y
   609                                  STA (BLK),Y                     ;copy the flag byte
   610                                  BEQ @fin
   611                                  LDY # 4                         ;nan, +-infinity: frexp x = (x, 0)
   612                          -       LDA (ACCU),Y                    ; copy the float,
   613                                  STA (BLK),Y
   614                                  DEY
   615                                  BPL -
   616                                  INY
   617                                  TYA
   618                                  PHA                             ; and set the exponent to 0
   619                                  BEQ @pair
   620                          @fin    LDY # 0
   621                                  LDA (ACCU),Y                    ;load (biased) exponent
   622                                  PHA                             ;save it for later
   623                                  BNE @nz                         ;float is 0.0?
   624                                  STA (BLK),Y                     ;yes: set new float exp = 0
   625                                  BEQ @pair                       ; and go further
   626                          @nz     LDA # $80                       ;no: set new float exp = $80
   627                                  STA (BLK),Y
   628                                  LDY # 4                         ; then copy the mantissa
   629                          -       LDA (ACCU),Y
   630                                  STA (BLK),Y
   631                                  DEY
   632                                  BNE -
   633                          @pair   JSR caml_load_newblk            ;ACCU = new float
   634                                  ;; allocate a new pair (float * int)
   635                                  LDA # 0                         ;tag of new pair
   636                                  LDX # 2                         ;size of new pair
   637                                  JSR caml_alloc                  ;alloc new pair
   638                                  ;; set pair elements
   639                                  LDA ACCU
   640                                  STA (BLK),Y
   641                                  INY
   642                                  LDA ACCU + 1
   643                                  STA (BLK),Y                     ;field0 := new float
   644                                  INY
   645                                  LDX # 0
   646                                  PLA                             ;reload biased exponent
   647                                  BNE @debias                     ;exp = 0?
   648                                  LDA # <Val_zero                 ;yes:
   649                                  STA (BLK),Y                     ; set field1,lo := <Val_int(0)
   650                                  LDA # >Val_zero
   651                                  BEQ @fld1h                      ; beq=jmp to set field1,hi
   652                          @debias SEC                             ;no:
   653                                  SBC # $80                       ; compute debiased exponent
   654                                  BCS @valint                     ; if negative,
   655                                  DEX                             ;  set hi byte = $FF
   656                                  SEC
   657                          @valint ROL                             ; compute <Val_int(exponent)
   658                                  STA (BLK),Y                     ; field1,lo := <Val_int(exponent)
   659                                  TXA
   660                                  ROL                             ; compute >Val_int(exponent)
   661                          @fld1h  INY
   662                                  STA (BLK),Y                     ;field1,hi := >Val_int(exponent)
   663                                  LDY # 0
   664                                  JMP caml_load_newblk   
   665                          }
