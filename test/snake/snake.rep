   445                          !source "/home/piero/.opam/LTS/lib/bcaml/memory_sc.asm"

; ******** Source: /home/piero/.opam/LTS/lib/bcaml/memory_sc.asm
     1                          ;; ——————————————————————————————————————————————————————————————————————
     2                          ;; The BreadCaml Project / Progetto BreadCaml
     3                          ;; Copyright (C) 21-Apr-2026 Piero Furiesi
     4                          ;; 
     5                          ;; This program is  free software; you can redistribute  it and/or modify
     6                          ;; it under the terms of the  GNU GENERAL PUBLIC LICENSE (GPL) version 2,
     7                          ;; as specified in the LICENSE-en file in the project root folder.
     8                          ;; 
     9                          ;; Questo  programma  è software  libero;  può  essere ridistribuito  e/o
    10                          ;; modificato nei termini della GNU GENERAL PUBLIC LICENSE (GPL) versione
    11                          ;; 2, come specificato nel file  LICENZA-it nella cartella principale del
    12                          ;; progetto.
    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          
    15                          ;; -----------------------------------------------------------------------------
    16                          ;;      MEMORY MANAGEMENT - HEAP ALLOCATION AND GARBAGE COLLECTION
    17                          ;;      STOP-AND-COPY GARBAGE COLLECTOR
    18                          ;; -----------------------------------------------------------------------------
    19                          
    20                          !ifndef caml_gc_stop_and_copy !eof
    21                          
    22                          ;; GLOBALS - Two possible strategies:
    23                          ;; caml_globals_on_heap = 1
    24                          ;;   Treat globals as pre-allocated in the heap, setting .heap_start to
    25                          ;;   caml_glob_data and initializing HEAP at caml_glob_end. During a GC cycle,
    26                          ;;   globals are moved from one heap semi-space to the other. However, scanning
    27                          ;;   pointers inside the blocks remains straightforward, as it is already
    28                          ;;   handled by Cheney's algorithm.
    29                          ;; caml_globals_on_heap = <undef> -- DEFAULT
    30                          ;;   Treat globals as statically allocated outside the heap, setting .heap_start
    31                          ;;   to caml_glob_end. This prevents globals from being copied during every GC
    32                          ;;   cycle (which can be expensive). On the other hand, the GC must scan every
    33                          ;;   global and treat each internal pointer as a root. While the GC
    34                          ;;   implementation becomes more complex, this approach avoids repeatedly moving
    35                          ;;   globals between the two semi-spaces and frees up G/2 bytes of heap space
    36                          ;;   (where G is the size of the globals).
    37                          
    38                          !zone caml_MEMORY {
    39                          caml_memory
    40                          
    41                          .dummy = $1234                          ;dummy operand for self-modifying
    42                                                                  ;code (SMC in comments)
    43                          
    44                          !ifndef caml_globals_on_heap {
    45                            .hs = caml_glob_end
    46                          } else {
    47                            .hs = caml_glob_data
    48                          }
    49                            .heap_start = .hs                     ;start of heap
    50                            .heap_end = caml_stack_start          ;end of heap + 1
    51                            .halfsz = ((.heap_end-.hs) div 4) * 2 ;heap halfsize; ensure it's even
    52                          
    53                          ;; VARIABLE DATA
    54  505b 445d               .CUR_START      !word .hs               ;current half
    55  505d a294               .CUR_END        !word .hs + .halfsz     ;end of current half
    56  505f a294               .OTH_START      !word .hs + .halfsz     ;other half of the heap
    57  5061 00cc               .OTH_END        !word .hs + .halfsz * 2 ;end of other half
    58                          
    59  5063 445da294a29400cc   .PRISTINE       !word .hs, .hs + .halfsz, .hs + .halfsz, .hs + .halfsz * 2
    60                          
    61                                  ;; Initialize the heap pointer and the semi-space variables, which a
    62                                  ;; previous run may have swapped. Called by caml_init.
    63                          caml_heap_init
    64  506b a207                       LDX # 7
    65  506d bd6350             -       LDA .PRISTINE,X
    66  5070 9d5b50                     STA .CUR_START,X
    67  5073 ca                         DEX
    68  5074 10f7                       BPL -
    69                                  ;; A previous run left in the global table pointers to its heap, that
    70                                  ;; the GC would take as roots: reset them to Val_unit.
    71  5076 a98a                       LDA # <caml_glob_table
    72  5078 854d                       STA TMP
    73  507a a95a                       LDA # >caml_glob_table
    74  507c 854e                       STA TMP + 1
    75  507e a000                       LDY # 0
    76  5080 a54d               @next   LDA TMP                         ;end of table?
    77  5082 c98e                       CMP # <caml_glob_data
    78  5084 a54e                       LDA TMP + 1
    79  5086 e95b                       SBC # >caml_glob_data
    80  5088 b024                       BCS @done
    81  508a b14d                       LDA (TMP),Y                     ;lo byte
    82  508c aa                         TAX
    83  508d 4a                         LSR
    84  508e b014                       BCS @skip                       ;odd: integer
    85  5090 c8                         INY
    86  5091 b14d                       LDA (TMP),Y                     ;hi byte
    87  5093 88                         DEY
    88  5094 e044                       CPX # <caml_glob_end            ;address >= caml_glob_end?
    89  5096 e95d                       SBC # >caml_glob_end
    90  5098 900a                       BCC @skip
    91  509a a901                       LDA # <Val_unit                 ;yes (heap pointer): reset it
    92  509c 914d                       STA (TMP),Y
    93  509e c8                         INY
    94  509f a900                       LDA # >Val_unit
    95  50a1 914d                       STA (TMP),Y
    96  50a3 88                         DEY
    97  50a4 e64d               @skip   INC TMP
    98  50a6 e64d                       INC TMP
    99  50a8 d0d6                       BNE @next
   100  50aa e64e                       INC TMP + 1
   101  50ac d0d2                       BNE @next                       ;BNE = JMP
   102  50ae a944               @done   LDA # <caml_glob_end
   103  50b0 8549                       STA HEAP
   104  50b2 a95d                       LDA # >caml_glob_end
   105  50b4 854a                       STA HEAP + 1
   106  50b6 60                         RTS
   107                          
   108                                  ;; Allocate a block (NOT FOR ATOMS!); params: A=tag, X=size>0
   109                                  ;; Return BLK=block's address, A=X=size, Y=0; or raise Out_of_memory
   110                                  ;; C = 1 iif a GC occurred
   111                          caml_alloc
   112                          @SZ     = GC                            ;1 by - block size
   113                          @TAG    = GC + 1                        ;1 by - block tag
   114                          @SCN    = GC + 2                        ;2 by scanned block
   115                          @PTR    = GC + 4                        ;2 by aux pointer
   116                          @CNT    = GC + 6                        ;2 by field counter
   117                                  ;; C=0: gc not tried yet; C=1: alloc failed, GC done, retrying)
   118  50b7 18                         CLC
   119  50b8 863e                       STX @SZ
   120  50ba 853f                       STA @TAG
   121  50bc 08                 @retry  PHP                             ;save GC-done flag on HW stack
   122  50bd a549                       LDA HEAP
   123  50bf 854b                       STA BLK
   124  50c1 a54a                       LDA HEAP + 1
   125  50c3 854c                       STA BLK + 1
   126                                  ;; Increment HEAP by the # of bytes to be allocated
   127  50c5 e8                         INX                             ;perform HEAP:=HEAP+2*(size+1):
   128  50c6 d006                       BNE +                           ;  if size + 1 = 256
   129  50c8 e64a                       INC HEAP + 1                    ;  then incr. HEAPh
   130  50ca e64a                       INC HEAP + 1                    ;    twice (512 bytes)
   131  50cc d00f                       BNE @limits                     ;    BNE=JMP
   132  50ce 8a                 +       TXA                             ;  else
   133  50cf 0a                         ASL                             ;    C:A := 2*(size+1),
   134  50d0 9003                       BCC +                           ;    if carry set then
   135  50d2 e64a                       INC HEAP + 1                    ;      add it to HEAPh,
   136  50d4 18                         CLC
   137  50d5 6549               +       ADC HEAP                        ;    add 2*(size+1)
   138  50d7 8549                       STA HEAP                        ;    to HEAPl
   139  50d9 9002                       BCC @limits
   140  50db e64a                       INC HEAP + 1
   141                                  ;; If there's enough room, write tag and size into the header and exit
   142  50dd ad5d50             @limits LDA .CUR_END
   143  50e0 c549                       CMP HEAP
   144  50e2 ad5e50                     LDA .CUR_END + 1
   145  50e5 e54a                       SBC HEAP + 1                    ;.CUR_END < HEAP?
   146  50e7 9015                       BCC @gctry                      ;yes: try a garbage collection
   147  50e9 a53f                       LDA @TAG                        ;no: write tag and size  
   148  50eb a000                       LDY # 0
   149  50ed 914b                       STA (BLK),Y                     ;  header's 1st by. := tag
   150  50ef e64b                       INC BLK                         ;  (safe, BLK is even)
   151  50f1 a53e                       LDA @SZ
   152  50f3 914b                       STA (BLK),Y                     ;  header's 2nd by. := size
