    89                          !macro  i13 .n {                                ;POP n
    90                                  +caml_range 0, .n, $7FFF, "POP n: n"
    91                                  .n2h = >(2 * .n)
    92                                  .n2l = <(2 * .n)
    93                            !if .n = 0 {
    94                                  ;NOP
    95                            } elif .n = 1 {
    96                                  !set    caml_gen_POP1 = 1
    97                                  JSR POP1
    98                            } else {
    99                                  LDA # .n2l
   100                              !if .n2h > 0 {
   101                                  LDY # .n2h
   102                              }
   103                                  !set    caml_gen_POPN = 1
   104                                  JSR POPN
   105                            }
   106                          }
   107                          !macro  i14 .n {                                ;ASSIGN n
   108                                  +caml_range 0, .n, $7FFF, "ASSIGN n: n"
   109                                  .n2h = >(2 * .n)
   110                                  .n2l = <(2 * .n)
   111                                  !set    caml_gen_ASSIGNL = 1
   112                            !if .n2l > 0 {
   113                                  LDY # .n2l
   114                            }
   115                            !if .n2h = 0 {
   116                                  JSR ASSIGNL
   117                            } elif .n2h = 1 {
   118                                  INC SP + 1
   119                                  JSR ASSIGNL
   120                                  DEC SP + 1
   121                            } else {
   122                                  !set    caml_gen_ASSIGNH = 1
   123                                  LDA # .n2h
   124                                  JSR ASSIGNH
   125                                  STX SP + 1
   126                            }
   127                          }
