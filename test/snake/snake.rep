   164                          ;; i21-i23 depend on i20
   165                          
   166                          !macro  i20 .n {                                ;APPLY n
   167                                  +caml_range 1, .n, $7F, "APPLY n: n"
   168                                  !set    caml_gen_APPLY = 1
   169                                  LDY # 2 * .n - 1
   170                            !if .n <= 3 {
   171                                  !set    caml_gen_APPLY13 = 1
   172                                  JSR caml_APPLY13                        ;JSR=JMP+push retadr-1 on hw stack
   173                            } else {
   174                                  JMP caml_APPLY
   175                            }
   176                          }
   177                          !macro  i21     {+i20 1}                        ;APPLYi -> APPLY i
   178                          !macro  i22     {+i20 2}
   179                          !macro  i23     {+i20 3}
   180                          
   181                          ;; i25-i27 depend on i24
   182                          
   183                          !macro  i24 .n, .s {                            ;APPTERM n s
   184                                  +caml_range 1, .n, $7F, "APPTERM n s: n"
   185                                  +caml_range .n, .s, $7F, "APPTERM n s: s"
   186                                  !set    caml_gen_APPTRM1 = 1
   187                                  LDX # 2 * (.s - .n)
   188                            !if .n = 1 {
   189                                  INY
   190                                  JMP caml_APPTRM1
   191                            } else {
   192                                  !set    caml_gen_APPTRMN = 1
   193                                  LDA # 2 * (.n - 1)
   194                                  JMP caml_APPTRMN
   195                            }
   196                          }
   197                          !macro  i25 .s  {+i24 1,.s}                     ;APPTERMi s -> APPTERM i s
   198                          !macro  i26 .s  {+i24 2,.s}
   199                          !macro  i27 .s  {+i24 3,.s}
   200                          !macro  i28 .n {                                ;RETURN n
   201                                  +caml_range 0, .n, $7F, "RETURN n: n"
   202                                  !set    caml_gen_RETURN = 1
   203                                  !set    caml_gen_GORETURN = 1
   204                            !if .n = 0 {
   205                                  TYA
   206                            } else {
   207                                  LDA # 2 * .n
   208                            }
   209                                  JMP caml_RETURN
   210                          }
   211                          !macro  i29 {                                   ;RESTART
   212                                  !set    caml_gen_RESTART = 1
   213                                  !set    caml_restart_len = .end - *     ;needed by GRAB routine
   214                                  JSR caml_RESTART
   215                          .end
   216                          }
   217                          !macro  i2a .n {                                ;GRAB n
   218                                  +caml_range 0, .n, $7C, "GRAB n: n"
   219                                  +Val_Int ~.v, .n
   220                                  !set    caml_gen_GRAB = 1
   221                                  !set    caml_gen_GORETURN = 1
   222                                  !set    caml_grab_len = .end - *        ;needed by GRAB routine
   223                                  LDA # .v
   224                                  JSR caml_GRAB
   225                          .end
   226                          }
   227                          !macro  i2b .n, .ptr {                          ;CLOSURE n ptr
   228                                  +caml_range 0, .n, $7F, "CLOSURE n p: n"
   229                                  LDX # .n
   230                                  LDA # <.ptr
   231                                  LDY # >.ptr
   232                                  !set    caml_gen_CLOSURE = 1
   233                                  JSR caml_CLOSURE
   234                          }
   235                          !macro  i2c .f, .v, .o, .t {                    ;CLOSUREREC f v o t
   236                                  +caml_range 1, .f, $80, "CLOSUREREC f v o t: f"
   237                                  +caml_range 0, .v, $FE, "CLOSUREREC f v o t: v"
   238                                  +caml_range 1, 2 * .f - 1 + .v, $FF, "CLOSUREREC f v o t: 2f-1+v"
   239                                  !set    caml_gen_CLOSREC = 1
   240                                  LDA # .v
   241                                  STA TMP
   242                                  LDA # .f
   243                                  LDY # <.data
   244                                  LDX # >.data
   245                                  JMP +
   246                          .data   !word .o, .t
   247                          +       JSR caml_CLOSREC
   248                          }
