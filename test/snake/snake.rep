    29                          caml_ensure_stack_capacity
    30                                  ;; do nothing and return Val_unit
    31                                  LDA # < Val_unit
    32                                  STA ACCU
    33                                  ;LDY # 0
    34                                  STY ACCU + 1
    35                                  RTS
