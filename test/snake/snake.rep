   397  7cf7 88                         DEY                             ;  Y := $FE
   398  7cf8 b140                       LDA (@SCN),Y                    ;  A := tag
   399  7cfa e641                       INC @SCN + 1                    ;  restore the pointer
   400  7cfc a000                       LDY # 0                         ;  and Y register
   401  7cfe 9149                       STA (HEAP),Y                    ;  write tag in new block
   402  7d00 e649                       INC HEAP
   403  7d02 8a                         TXA
   404  7d03 9149                       STA (HEAP),Y                    ;  write size
   405  7d05 e649                       INC HEAP                        ;  now HEAP->Field(0)
   406  7d07 d002                       BNE +
   407  7d09 e64a                       INC HEAP + 1
   408  7d0b a549               +       LDA HEAP
   409  7d0d 854b                       STA BLK                         ;  BLK := &Field(0)
   410  7d0f a54a                       LDA HEAP + 1
   411  7d11 854c                       STA BLK + 1
   412  7d13 8a                         TXA                             ;  Add 2*size to HEAP
   413  7d14 0a                         ASL
   414  7d15 9003                       BCC +
   415  7d17 e64a                       INC HEAP + 1
   416  7d19 18                         CLC
   417  7d1a 6549               +       ADC HEAP
   418  7d1c 8549                       STA HEAP
   419  7d1e 9002                       BCC +
   420  7d20 e64a                       INC HEAP + 1
   421  7d22 8a                 +       TXA                             ;  Prepare to copy all fields:
   422  7d23 0a                         ASL
   423  7d24 a8                         TAY                             ;  C:Y := 2*size
   424  7d25 9006                       BCC @lt256                      ;   2*size < 256by (<128 fields)
   425  7d27 f016                       BEQ @eq256                      ;   2*size = 256by (=128 fields)
   426  7d29 e641                       INC @SCN + 1                    ;   2*size > 256by (>128 fields)
   427  7d2b e64c                       INC BLK + 1
   428                          --                                      ;  loop: copy @SCN fields to BLK
   429  7d2d 88                 @lt256  DEY
   430  7d2e b140               -       LDA (@SCN),Y
   431  7d30 914b                       STA (BLK),Y
   432  7d32 88                         DEY
   433  7d33 d0f9                       BNE -
   434  7d35 b140                       LDA (@SCN),Y                    ;   handle Y = 0 apart
   435  7d37 914b                       STA (BLK),Y
   436  7d39 9007                       BCC @wrtfwd                     ;  exit loop
   437  7d3b c641                       DEC @SCN + 1
   438  7d3d c64c                       DEC BLK + 1
   439  7d3f 18                 @eq256  CLC
   440  7d40 90eb                       BCC --
   441  7d42 c8                 @wrtfwd INY                             ;  Y:=1
   442  7d43 a54c                       LDA BLK + 1                     ;  load fwd pointer, hi
   443  7d45 9140                       STA (@SCN),Y                    ;  write it in field(0), hi
   444  7d47 aa                         TAX                             ;  and move it in X
   445  7d48 88                         DEY                             ;  Y := 0
   446  7d49 a54b                       LDA BLK                         ;  load fwd pointer, lo
   447  7d4b 9140                       STA (@SCN),Y                    ;  and write it in field(0),lo
   448  7d4d 38                         SEC                             ;  set carry before exit
   449  7d4e 60                         RTS                             ;  RETURN (X:A=fwdptr, Y=0)
   450                                  ;;  An infix block is NOT marked as visited: its size is the offset from
   451                                  ;;  the main block, needed by any other pointer to it (only the main
   452                                  ;;  block is copied and gets a forward pointer).
   453  7d4f 8a                 @infix  TXA                             ;A := X = size = dist.from main blk
   454  7d50 8e6e7d                     STX @dst + 1                    ;save it for later
   455  7d53 0a                         ASL                             ;C:A := 2*dist.
   456  7d54 8d5f7d                     STA @dst2lo + 1                 ;write next SBC's arg.
   457  7d57 9002                       BCC +                           ;perform @SCN := @SCN - .DST:
   458  7d59 c641                       DEC @SCN + 1                    ;  decr @SCN_hi if C set
   459  7d5b a540               +       LDA @SCN                        ;  load @SCN_lo
   460  7d5d 38                         SEC
   461  7d5e e934               @dst2lo SBC # <.dummy                   ;  SMC: subtract <2*dist.
   462  7d60 8540                       STA @SCN                        ;  save result, lo by.
   463  7d62 b002                       BCS +
   464  7d64 c641                       DEC @SCN + 1                    ;  adjust hi by.
   465  7d66 c8                 +       INY                             ;(@SCN),Y = main block's size
   466  7d67 20da7c                     JSR @again                      ;get main block's fwdptr in X:A
   467  7d6a 8d757d                     STA @fwdlo + 1                  ;write next ADC's arg.
   468  7d6d a934               @dst    LDA # <.dummy                   ;SMC: get infix's SIZE
   469  7d6f 0a                         ASL                             ;A := <SIZE*2, C := >SIZE*2 
   470  7d70 9002                       BCC @fwdlo                      ;perform X:A:=X:A+main fwd ptr:
   471  7d72 e8                         INX                             ;  incr X if SIZE*2>255
   472  7d73 18                         CLC
   473  7d74 6934               @fwdlo  ADC # <.dummy                   ;  SMC: add forward ptr, lo byte
   474  7d76 9001                       BCC +
   475  7d78 e8                         INX                             ;  adjust X
   476  7d79 38                 +       SEC                             ;set carry before exit
   477  7d7a 60                         RTS                             ;RETURN (X:A = infix forward ptr)
   478                          
   479                                  ;; Copy BLK to ACCU.
   480                          caml_load_newblk
   481  7d7b a54c                       LDA BLK + 1
   482  7d7d 85fc                       STA ACCU + 1
   483  7d7f a54b                       LDA BLK
   484  7d81 85fb                       STA ACCU
   485  7d83 60                         RTS
   486                          
   487                                  ;; ACCU := Atom(0)
   488                          caml_mkatom0
   489  7d84 a97e                       LDA # < caml_atom0
   490  7d86 85fb                       STA ACCU
   491  7d88 a908                       LDA # > caml_atom0
   492  7d8a 85fc                       STA ACCU + 1
   493  7d8c 60                         RTS
   494                          
   495                          caml_shrink_latest_alloc
   496                                  ;; Reduce the size of the latest allocated block; new size MUST BE less
   497                                  ;; than the original one (no check) and NO GARBAGE COLLECTION occurred
   498                                  ;; since the block allocation. Params: X=size>0, Y=0, BLK=address.
   499                                  ;; Shrinking is done by updating the new size in the block's header and
   500                                  ;; the HEAP pointer. Return: A=X=size, Y=0.
   501                                  @SZ2 = GC                       ;2 by - block size in bytes
   502  7d8d c64c                       DEC BLK + 1                     ;Prepare access to the 'size'
   503  7d8f 88                         DEY                             ; byte in block's header
   504  7d90 b14b                       LDA (BLK),Y                     ;Read original size from header
   505  7d92 853e                       STA @SZ2                        ; and save it
   506  7d94 8a                         TXA                             ;A := new size
   507  7d95 914b                       STA (BLK),Y                     ;Write new size into header
   508  7d97 e64c                       INC BLK + 1                     ;Restore block pointer
   509  7d99 c8                         INY                             ; and Y register
   510  7d9a 49ff                       EOR # $FF                       ;Do an inverse subtraction:
   511  7d9c 38                         SEC                             ; A := @SZ2 - A
   512  7d9d 653e                       ADC @SZ2                        ;    = orig.size - new size
   513  7d9f 0a                         ASL                             ;Compute 2 * A
   514  7da0 853e                       STA @SZ2                        ;Store result, lo byte, in @SZ2
   515  7da2 843f                       STY @SZ2 + 1                    ;Set @SZ2 + 1 to 0
   516  7da4 263f                       ROL @SZ2 + 1                    ;Store result, MSB, in @SZ2 + 1
   517  7da6 a549                       LDA HEAP                        ;Recover unused block bytes by
   518  7da8 38                         SEC                             ; decrementing the heap pointer
   519  7da9 e53e                       SBC @SZ2                        ; by 2 * (orig.size - new size)
   520  7dab 8549                       STA HEAP                        ;Store new value, lo byte
   521  7dad a54a                       LDA HEAP + 1
   522  7daf e53f                       SBC @SZ2 + 1
   523  7db1 854a                       STA HEAP + 1                    ;Store new value, hi byte
   524  7db3 60                         RTS                             ;Return.
   525                          
   526                          caml_memory_end
