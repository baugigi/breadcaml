   246                          C64_SIN         = $E26B ;Perform the SIN function on the float in FAC
   247                          C64_COS         = $E264 ;Perform the COS function on the float in FAC
   248                          C64_TAN         = $E2B4 ;Perform the TAN function on the float in FAC
   249                          C64_ATN         = $E30E ;Perform the ATN function on the float in FAC
