     8                           !source "/home/pifu/.opam/LTS/lib/bcaml/stdlib_floats.asm"

; ******** Source: /home/pifu/.opam/LTS/lib/bcaml/stdlib_floats.asm
     1                          ;;; ----------------------------------------------------------------------------
     2                          ;;; FLOATS
     3                          ;;; ----------------------------------------------------------------------------
     4                          
     5                          ;;; ZEROPAGE LOCATIONS
     6                          ;;; used by the C64's BASIC ROM floating point routines:
     7                          ;;;
     8                          ;;; $12         used by tan and (in preparation for tan) by sin & cos routines
     9                          ;;; $22-$23     used to move variables into the accumulators and back to memory
    10                          ;;; $24-$25     used during FP comparisons and when converting PETSCII into FP
    11                          ;;; $26-$2A     result of multiplication or division
    12                          ;;; $47         used by FOUT
    13                          ;;; $56         used in addition and subtraction, and also the exp function
    14                          ;;; $5C-$60     used by the PETSCII conversion routines
    15                          ;;; $61         FAC1 exponent
    16                          ;;; $62-$65     FAC1 mantissa
    17                          ;;; $66         FAC1 sign in bit 7
    18                          ;;; $67         used by trig, exp, log functions and PETSCII to FP conversion
    19                          ;;; $68         used during normalisation and FP to integer conversion
    20                          ;;; $69         FAC2 exponent
    21                          ;;; $6A-$6D     FAC2 mantissa
    22                          ;;; $6E         FAC2 sign in bit 7
    23                          ;;; $6F         sign result of arithmetic operations, set when FAC2 is loaded
    24                          ;;; $70         low order rounding byte for FAC1, cleared when FAC1 is loaded
    25                          ;;; $71-$72     used during series eval. and when converting PETSCII into FP
    26                          ;;; $73-$8A     CHRGET routine, used when converting a PETSCII string into FP
    27                          
    28                          !zone caml_FLOATS {
    29                          
    30                          .dummy  = $1234                                 ;dummy operand for self-modifying
    31                                                                          ;code (SMC in comments)
    32                          
    33                          !ifndef caml_float_zp_check {
    34                          caml_float_zp_check
    35                            !for .i in [[$12,$12],[$22,$2A],[$47,$47],[$56,$56],[$5C,$8A]] {
    36                              !if (caml_zp_start <= .i[1]) & (.i[0] < caml_zp_end) {
    37                                !warn "ZP storage overlaps FLPT workspace", .i
    38                              }
    39                            }
    40                          }
    41                          !ifdef caml_PRIM__caml_nonstd_sign_float {
    42                          caml_nonstd_sign_float
    43                                  ;; Stdlib.sign_float
    44                                  LDA (ACCU),Y                            ;Read byte #0 (exponent)
    45                                  BEQ @zero                               ;Exponent=0 <=> float=0.
    46                                  INY
    47                                  LDA (ACCU),Y                            ;Read byte #1 (mantissa, msb)
    48                                  BPL @pos                                ;If the mantissa is negative,
    49                                  LDY # $FF                               ; set ACCU=Val_Int(-1)
    50                                  STY ACCU + 1
    51                                  STY ACCU
    52                                  INY
    53                                  RTS
    54                          @pos    DEY                                     ;else
    55                                  LDA # Val_one                           ; set ACCU=Val_Int(1)
    56                                  BNE @store                              ; BNE=JMP.
    57                          @zero   LDA # Val_zero                          ;Zero: set ACCU=Val_Int(0).
    58                          @store  STA ACCU
    59                                  STY ACCU + 1
    60                                  RTS                                     ;Y=0 at exit.
    61                          }
