    17                          ;; -----------------------------------------------------------------------------
    18                          
    19                          !zone caml_OBJ {
    20                          
    21                          ;; UNIMPLEMENTED:
    22                          ;; CAMLprim value caml_obj_raw_field(value arg, value pos)
    23                          ;; CAMLprim value caml_obj_set_raw_field(value arg, value pos, value bits)
    24                          ;; CAMLprim value caml_obj_with_tag(value new_tag_v, value arg)
    25                          ;; CAMLprim value caml_get_public_method (value obj, value tag)
    26                          
    27                          caml_OOID
    28  55c3 0100                       !word Val_zero                  ; init value for OOID
    29                          
    30                          !ifdef caml_PRIM__caml_obj_tag {
    31                                  ;; ACCU = value
    32                                  ;; return tag(value)
    33                          caml_obj_tag
    34                                  LDA ACCU
    35                                  BIT caml_is_block
    36                                  BNE @int
    37                                  LDX ACCU + 1
    38                                  CPX # > caml_glob_data          ; static data and heap: real tag
    39                                  BCC @chkat
    40                                  BNE +
    41                                  CMP # < caml_glob_data
    42                                  BCC @chkat
    43                          +       CPX # > caml_stack_start        ; = heap end address + 1
    44                                  BCC @tag
    45                                  BNE @ooh
    46                                  CMP # < caml_stack_start
    47                                  BCS @ooh
    48                                  ;; Val_int(tag(ACCU))
    49                          @tag    LDY # -2
    50                                  DEC ACCU + 1
    51                                  LDA (ACCU),Y
    52                                  SEC
    53                                  ROL
    54                                  STA ACCU
    55                                  LDY # 0
    56                                  STY ACCU + 1
    57                                  ROL ACCU + 1
    58                                  RTS
    59                          @chkat  CMP # < caml_atom0              ;atom(0) lies in the loader area:
    60                                  BNE @ooh                        ; its tag is 0
    61                                  CPX # > caml_atom0
    62                                  BNE @ooh
    63                                  LDA # < Val_zero
    64                                  STA ACCU
    65                                  LDA # > Val_zero
    66                                  STA ACCU + 1
    67                                  RTS
    68                          @ooh    +Val_Int ~@oohtag, 1001         ;Out_of_heap_tag
    69                                  LDA # > @oohtag
    70                                  LDX # < @oohtag
    71                                  BNE @res                        ;BNE = JMP
    72                          @int    +Val_Int ~@inttag, 1000         ; Int_tag
    73                                  LDA # > @inttag
    74                                  LDX # < @inttag
    75                          @res    STA ACCU + 1
    76                                  STX ACCU
    77                                  RTS
    78                          }
    79                          
    80                          !ifdef caml_PRIM__caml_obj_set_tag {
    81                                  ;; ACCU = value, SP[0] = new tag
    82                          caml_obj_set_tag
    83                                  INY
    84                                  LDA (SP),Y
    85                                  LSR
    86                                  DEY
    87                                  LDA (SP),Y
    88                                  ROR
    89                                  LDY # -2
    90                                  DEC ACCU + 1
    91                                  STA (ACCU),Y
    92                                  LDY # <Val_unit
    93                                  STY ACCU
    94                                  DEY
    95                                  STY ACCU + 1
    96                                  RTS
    97                          }
    98                          
    99                          ;; camlinternalLazy.ml:
   100                          ;; external make_forward : Obj.t -> Obj.t -> unit = "caml_obj_make_forward"
   101                          !ifdef caml_PRIM__caml_obj_make_forward {
   102                                  ;; CAMLprim value caml_obj_make_forward (value blk, value fwd)
   103                                  ;; {    
   104                                  ;;   caml_modify(&Field(blk, 0), fwd);
   105                                  ;;   Tag_val (blk) = Forward_tag;
   106                                  ;;   return Val_unit;
   107                                  ;; }
   108                          caml_obj_make_forward
   109                                  LDA (SP),Y
   110                                  STA (ACCU),Y
   111                                  INY
   112                                  LDA (SP),Y
   113                                  STA (ACCU),Y
   114                                  LDY # -2
   115                                  DEC ACCU + 1
   116                                  LDA # Forward_tag
   117                                  STA (ACCU),Y
   118                                  LDY # 0
   119                                  STY ACCU + 1
   120                                  LDA # < Val_unit
   121                                  STA ACCU
   122                                  RTS
   123                          }
   124                          
   126                          !ifdef caml_PRIM__caml_obj_block {
   127                                  ;; ACCU = tag, SP[0] = size
   128                          caml_obj_block
   129                                  INY
   130                                  LDA (SP),Y
   131                                  LSR
   132                                  DEY
   133                                  LDA (SP),Y
   134                                  ROR
   135                                  BNE +
   136                                  JMP caml_mkatom0
   137                                  ;; allocate a new block if size > 0
   138                          +       TAX
   139                                  LSR ACCU + 1
   140                                  LDA ACCU
   141                                  ROR
   142                                  JSR caml_alloc
   143                                  JSR caml_load_newblk
   144                                  JMP caml_block_fill0
   145                          }
   146                          
   147                          !ifdef caml_PRIM__caml_obj_dup {
   148                                  ;; ACCU = arg
   149                          caml_obj_dup
   150  55c5 88                         DEY
   151  55c6 c6fc                       DEC ACCU + 1
   152  55c8 b1fb                       LDA (ACCU),Y                    ; A := size
   153  55ca f014                       BEQ @atom                       ; exit if size = 0
   154  55cc aa                         TAX                             ; X := size
   155  55cd 88                         DEY
   156  55ce b1fb                       LDA (ACCU),Y                    ; A := tag
   157  55d0 e6fc                       INC ACCU + 1                    ; restore pointer
   158  55d2 a000                       LDY # 0                         ;   and Y register
   159  55d4 20b750                     JSR caml_alloc                  ; allocate a new block
   160  55d7 8a                         TXA                             ; A := size
   161  55d8 0a                         ASL
   162  55d9 a8                         TAY                             ; Y,C := 2 * size
   163  55da 200555                     JSR caml_blkcpy                 ; copy the blk pointed by ACCU
   164  55dd 4c1353                     JMP caml_load_newblk   
   165  55e0 e6fc               @atom   INC ACCU + 1
   166  55e2 c8                         INY
   167  55e3 60                         RTS
   168                          }
   169                          
   170                          !ifdef caml_PRIM__caml_obj_truncate {
   171                                  ;; truncate a block to newsize; ACCU = value, SP[0] = newsize
   172                                  ;; Obj.truncate is deprecated!
   173                                  ;; WARNING: Obj.truncate o s when Obj.size o = s + 1 will leave an atom
   174                                  ;; on the heap, which could cause the garbage collector to crash if it
   175                                  ;; is reachable from some root!
   176                          
   177                          caml_obj_truncate
   178                                  @NEWSZ = TMP
   179                                  ;; load tag and size
   180                                  DEY
   181                                  DEC ACCU + 1
   182                                  LDA (ACCU),Y
   183                                  TAX                             ;X := size
   184                                  DEY
   185                                  LDA (ACCU),Y
   186                                  CMP # Double_array_tag
   187                                  BEQ @floatarray
   188                                  ;; calculate Int_val(newsize)
   189                                  LDY # 1
   190                                  LDA (SP),Y
   191                                  DEY
   192                                  LSR
   193                                  BNE @error                      ;error if newsize > 255 or < 0
   194                                  LDA (SP),Y
   195                                  ROR
   196                                  BEQ @error                      ;error if newsize = 0
   197                                  STA @NEWSZ
   198                                  CPX @NEWSZ
   199                                  BEQ @exit                       ;exit if newsize = size
   200                                  BCC @error                      ;error if newsize > size
   201                                  ;; 0 < NEWSZ < size, write NEWSZ into header
   202                          @trunc  DEY
   203                                  STA (ACCU),Y
   204                                  INC ACCU + 1
   205                                  ;; set (ACCU),Y to point to Field(ACCU, newsize)
   206                                  ASL
   207                                  BCC +
   208                                  INC ACCU + 1
   209                          +       TAY
   210                                  ;; header for the leftovers: tag = No_scan_tag, sz = size-1-newsize
   211                                  ;; WARNING: sz could be 0, the GC won't be happy if block is reachable!
   212                                  LDA # No_scan_tag
   213                                  STA (ACCU),Y                    ;tag = No_scan_tag
   214                                  INY
   215                                  DEX
   216                                  TXA
   217                                  SEC
   218                                  SBC @NEWSZ                      ;sz = size-1-NEWSZ
   219                                  STA (ACCU),Y
   220                          @exit   LDY # <Val_unit
   221                                  STY ACCU                        ;ACCU := ()
   222                                  DEY
   223                                  STY ACCU + 1
   224                                  RTS
   225                                  ;; calculate Int_val(newsize) * Double_wosize
   226                          @floatarray
   227                                  LDY # 1
   228                                  LDA (SP),Y
   229                                  BNE @error                      ;error if newsize > 127 or < 0
   230                                  DEY
   231                                  LDA (SP),Y
   232                                  AND # %11111110                 ;A = 2 * newsize
   233                                  BEQ @error                      ;error if newsize = 0
   234                                  STA @NEWSZ                      ;NEWSZ = 2 * newsize
   235                                  LSR
   236                                  ;CLC                            ;C=0 because of previous AND
   237                                  ADC @NEWSZ                      ;A = Double_wosize * newsize
   238                                  BCS @error                      ;error if > 255
   239                                  STA @NEWSZ                      ;NEWSZ=Double_wosize * newsize
   240                                  CPX @NEWSZ
   241                                  BEQ @exit                       ;exit if NEWSZ = size
   242                                  BCS @trunc                      ;error if NEWSZ > size
   243                          @error  +caml_raise Invalid_argument, "Obj.truncate"
   244                          }
   245                          
   246                          !ifdef caml_PRIM__caml_obj_add_offset {
   247                                  ;; ACCU = value, SP[0] = offset
   248                          caml_obj_add_offset
   249                                  LDA (SP),Y
   250                                  STA TMP
   251                                  INY
   252                                  LDA (SP),Y
   253                                  STA TMP + 1
   254                                  DEY
   255                                  LSR TMP + 1
   256                                  ROR TMP
   257                                  CLC
   258                                  LDA TMP
   259                                  ADC ACCU
   260                                  STA ACCU
   261                                  LDA TMP + 1
   262                                  ADC ACCU + 1
   263                                  STA ACCU + 1
   264                                  RTS
   265                          }
   266                          
   267                          ;; lazy.ml:
   268                          ;; external make_forward : 'a -> 'a lazy_t = "caml_lazy_make_forward"
   269                          !ifdef caml_PRIM__caml_lazy_make_forward {
   270                                  ;; CAMLprim value caml_lazy_make_forward (value v)
   271                                  ;; {
   272                                  ;;   CAMLparam1 (v);
   273                                  ;;   CAMLlocal1 (res);
   274                                  ;;   res = caml_alloc_small (1, Forward_tag);
   275                                  ;;   Field (res, 0) = v;
   276                                  ;;   CAMLreturn (res);
   277                                  ;; }
   278                          caml_lazy_make_forward
   279                                  LDA # Forward_tag
   280                                  LDX # 1
   281                                  JSR caml_alloc
   282                                  LDA ACCU
   283                                  STA (BLK),Y
   284                                  INY
   285                                  LDA ACCU + 1
   286                                  STA (BLK),Y
   287                                  DEY
   288                                  JMP caml_load_newblk   
   289                          }
   290                          
   291                          !ifdef caml_PRIM__caml_set_oo_id {
   292                          caml_set_oo_id
   293                                  LDY # 3
   294                                  LDA caml_OOID + 1
   295                                  STA (ACCU),Y
   296                                  DEY
   297                                  LDA caml_OOID
   298                                  STA (ACCU),Y
   299                                  LDY # 0
   300                                  CLC
   301                                  ADC # 2
   302                                  STA caml_OOID
   303                                  BCC +
   304                                  INC caml_OOID + 1
   305                          +       RTS
   306                          }
   307                          
   308                          !ifdef caml_PRIM__caml_fresh_oo_id {
   309                          caml_fresh_oo_id
   310  55e4 adc455                     LDA caml_OOID + 1
   311  55e7 85fc                       STA ACCU + 1
   312  55e9 adc355                     LDA caml_OOID
   313  55ec 85fb                       STA ACCU
   314  55ee 18                         CLC
   315  55ef 6902                       ADC # 2
   316  55f1 8dc355                     STA caml_OOID
   317  55f4 9003                       BCC +
   318  55f6 eec455                     INC caml_OOID + 1
   319  55f9 60                 +       RTS
   320                          }
