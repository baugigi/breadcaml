   696                          !ifdef  caml_PRIM__caml_int32_float_of_bits {
   697                          caml_int32_float_of_bits
   698                                  LDY # 4
   699                                  LDA (ACCU),Y                    ;.A <- e00¦m22_m16
   700                                  CMP # $80                       ;.C <- e00
   701                                  ORA # $80                       ;.A <- 1¦m22_m16
   702                                  STA C64_FAC + 1                 ;store into FAC
   703                                  INY
   704                                  LDA (ACCU),Y                    ;.A <- sign¦e07_e01
   705                                  ROL                             ;.C <- sign, .A <- e07_e00
   706                                  ROR C64_FAC + 5                 ;put sign into FAC sign byte
   707                                  CMP # $FE                       ;raise exn if NaN, +-infinity, or
   708                                  BCS @exn                        ;if conversion would overflow
   709                                  TAX                             ;.X <- exp
   710                                  LDY # 3
   711                                  LDA (ACCU),Y                    ;.A <- m15_m08
   712                                  STA C64_FAC + 2                 ;store into FAC
   713                                  DEY
   714                                  LDA (ACCU),Y                    ;.A <- m07_m00
   715                                  STA C64_FAC + 3                 ;store into FAC
   716                                  LDY # 0
   717                                  STY C64_FAC + 4                 ;clear FAC unused mantissa bits
   718                                  STY C64_FACRND                  ;and FAC round byte
   719                                  CPX # 1
   720                                  BCC @zero                       ;jump if +0.0, -0.0 or subnormal
   721                                  INX
   722                                  INX                             ;adjust exp bias
   723                          -       STX C64_FAC                     ;set FAC exp
   724                                  JMP caml_float_alloc_result     ;allocate float and return
   725                          @zero   LDA C64_FAC + 3                 ;check if +0.0 or -0.0
   726                                  BNE @subnrm                     ;jump if subnormal
   727                                  LDA C64_FAC + 2
   728                                  BNE @subnrm                     ;jump if subnormal
   729                                  LDA C64_FAC + 1
   730                                  AND # $7F                       ;ignore leftmost bit of mantissa (1)
   731                                  BNE @subnrm                     ;jump if subnormal
   732                                  STA C64_FAC + 1
   733                                  STA C64_FAC + 5                 ;clear minus sign, if any
   734                                  BEQ -                           ;set FAC exp, allocate float and return
   735                          @subnrm LDX # 2                         ;subnormal: set biased exp = -126
   736                                  STX C64_FAC
   737                          -       ASL C64_FAC + 3                 ;try to normalize (FAC+4 ignored as null)
   738                                  ROL C64_FAC + 2
   739                                  ROL C64_FAC + 1
   740                                  BMI +                           ;ok, leftmost bit is 1
   741                                  DEC C64_FAC
   742                                  BNE -
   743                                  LDY # 0                         ;ko, result is zero
   744                                  STY C64_FAC + 5                 ;clear minus sign, if any
   745                          +       JMP caml_float_alloc_result     ;allocate float and return
   746                          @exn    +caml_raise Invalid_argument, "Int32.float_of_bits"
   747                          }
