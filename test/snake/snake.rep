    79                          !ifdef caml_PRIM__caml_obj_block {
    80                                  ;; ACCU = tag
    81                                  ;; SP[0] = size
    82                          caml_obj_block
    83                                  INY
    84                                  LDA (SP),Y
    85                                  LSR
    86                                  DEY
    87                                  LDA (SP),Y
    88                                  ROR
    89                                  BNE +
    90                                  ;; return Atom(0) if size = 0
    91                                  LDA # < caml_atom0
    92                                  STA ACCU
    93                                  LDA # > caml_atom0
    94                                  STA ACCU + 1
    95                                  RTS
    96                                  ;; allocate a new block if size > 0
    97                          +       TAX
    98                                  LSR ACCU + 1
    99                                  LDA ACCU
   100                                  ROR
   101                                  JSR caml_alloc
   102                                  LDA BLK
   103                                  STA ACCU
   104                                  LDA BLK + 1
   105                                  STA ACCU + 1
   106                                  ;; fill fields with Val_int(0)
   107                          -       LDA # < Val_zero
   108                                  STA (BLK),Y
   109                                  INY
   110                                  LDA # > Val_zero
   111                                  STA (BLK),Y
   112                                  INY
   113                                  BNE +
   114                                  INC BLK + 1
   115                          +       DEX
   116                                  BNE -
   117                                  LDY # 0
   118                                  RTS
   119                          }
