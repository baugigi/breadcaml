    76                          
    77                          !macro  i09 {                                   ;PUSH
    78                                  !set    caml_gen_PUSH = 1
    79                                  JSR caml_PUSH
    80                          }
    81                          !macro  i0a     {+i09}                          ;PUSHACC0 -> caml_PUSH
    82                          !macro  i0b     {+i09 : +i08 1}                 ;PUSHACCi -> PUSH; ACC i
    83                          !macro  i0c     {+i09 : +i08 2}
    84                          !macro  i0d     {+i09 : +i08 3}
    85                          !macro  i0e     {+i09 : +i08 4}
    86                          !macro  i0f     {+i09 : +i08 5}
    87                          !macro  i10     {+i09 : +i08 6}
    88                          !macro  i11     {+i09 : +i08 7}
    89                          !macro  i12 .n  {+i09 : +i08 .n}                ;PUSHACC n -> PUSH; ACC n
    90                          !macro  i13 .n {                                ;POP n
    91                                  +caml_range 0, .n, $7FFF, "POP n: n"
    92                                  .n2h = >(2 * .n)
    93                                  .n2l = <(2 * .n)
    94                            !if .n = 0 {
    95                                  ;NOP
    96                            } elif .n = 1 {
    97                                  !set    caml_gen_POP1 = 1
    98                                  JSR caml_POP1
    99                            } else {
   100                                  LDA # .n2l
   101                              !if .n2h > 0 {
   102                                  LDY # .n2h
   103                              }
   104                                  !set    caml_gen_POPN = 1
   105                                  JSR caml_POPN
   106                            }
   107                          }
   108                          !macro  i14 .n {                                ;ASSIGN n
   109                                  +caml_range 0, .n, $7FFF, "ASSIGN n: n"
   110                                  .n2h = >(2 * .n)
   111                                  .n2l = <(2 * .n)
   112                                  !set    caml_gen_ASSIGNL = 1
   113                            !if .n2l > 0 {
   114                                  LDY # .n2l
   115                            }
   116                            !if .n2h = 0 {
   117                                  JSR caml_ASSIGNL
   118                            } elif .n2h = 1 {
   119                                  INC SP + 1
   120                                  JSR caml_ASSIGNL
   121                                  DEC SP + 1
   122                            } else {
   123                                  !set    caml_gen_ASSIGNH = 1
   124                                  LDA # .n2h
   125                                  JSR caml_ASSIGNH
   126                                  STX SP + 1
   127                            }
   128                          }
