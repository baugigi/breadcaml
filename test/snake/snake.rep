   453                                  LDX # <TMP
   454                                  LDY # >TMP
   455                                  +caml_JSR_BASROM C64_MOVMF      ;copy FAC to TMP
   456                          ;       ldy #0                          ;Y = 0 by MOVMF
   457                                  STY C64_FAC + 5                 ;clear FAC sign
   458                                  STY C64_FACRND                  ;clear FAC round byte
   459                                  LDA # 32 + $80
   460                                  STA C64_FAC                     ;set exponent (32)
   461                                  LDY # 2
   462                                  LDX # 3
   463                          -       LDA (ACCU),Y                    ;copy int64 lo bytes into FAC mantissa
   464                                  STA C64_FAC + 1,X
   465                                  INY
   466                                  DEX
   467                                  BPL -
   468                                  SEC                             ;set carry (positive)
   469                                  +caml_JSR_BASROM C64_FADFLT     ;normalize
   470                                  LDA # <TMP
   471                                  LDY # >TMP
   472                                  +caml_JSR_BASROM C64_FADD       ;FAC := TMP + FAC
