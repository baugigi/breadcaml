   212                          !ifdef caml_PRIM__caml_blit_string {
   213                          caml_blit_string
   214                                  ;; ACCU=src, SP[0]=sofs SP[1]=dst, SP[2]=dofs, SP[3]=len
   215                                  ;; copies len consecutive bytes, starting from src.[sofs], to dst.[dofs]
   216                                  ;; source and destination intervals may overlap.
   217                                  ;; (unsafe, args are checked in Bytes module)
   218                          @FROM   = TMP
   219                          @TO     = TMP + 2
   220                          @SIZE   = TMP + 4
   221  5772 a007                       LDY # 7
   222  5774 b1fd                       LDA (SP),Y                      ; >len
   223  5776 4a                         LSR
   224  5777 8552                       STA @SIZE + 1                   ; SIZE + 1 := >int_val(len)
   225  5779 88                         DEY
   226  577a b1fd                       LDA (SP),Y                      ; <len
   227  577c 6a                         ROR
   228  577d 8551                       STA @SIZE                       ; SIZE := <int_val(len)
   229  577f 88                         DEY
   230  5780 b1fd                       LDA (SP),Y                      ; >dofs
   231  5782 4a                         LSR
   232  5783 8550                       STA @TO + 1                     ; TO := >int_val(dofs)
   233  5785 88                         DEY
   234  5786 b1fd                       LDA (SP),Y                      ; <dofs
   235  5788 6a                         ROR
   236  5789 854f                       STA @TO                         ; TO := <int_val(dofs)
   237  578b 88                         DEY
   238  578c b1fd                       LDA (SP),Y                      ; >dst
   239  578e aa                         TAX
   240  578f 88                         DEY
   241  5790 b1fd                       LDA (SP),Y                      ; <dst
   242  5792 18                         CLC
   243  5793 654f                       ADC @TO
   244  5795 854f                       STA @TO                         ; TO := <(dst + int_val(dofs))
   245  5797 8a                         TXA
   246  5798 6550                       ADC @TO + 1
   247  579a 8550                       STA @TO + 1                     ; TO + 1:= >(dst+int_val(dofs))
   248  579c 88                         DEY
   249  579d b1fd                       LDA (SP),Y                      ; >sofs
   250  579f 4a                         LSR
   251  57a0 aa                         TAX
   252  57a1 88                         DEY
   253  57a2 b1fd                       LDA (SP),Y                      ; <soft
   254  57a4 6a                         ROR
   255  57a5 18                         CLC
   256  57a6 65fb                       ADC ACCU
   257  57a8 854d                       STA @FROM                       ; FROM := <(src + int_val(sofs))
   258  57aa a8                         TAY
   259  57ab 8a                         TXA
   260  57ac 65fc                       ADC ACCU + 1
   261  57ae 854e                       STA @FROM + 1                   ; FROM+1 := >(src+int_val(sofs))
   262  57b0 20a554                     JSR caml_memcpy                 ; ok, even if src & dest overlap
   263  57b3 a001                       LDY # <Val_unit
   264  57b5 84fb                       STY ACCU
   265  57b7 88                         DEY
   266  57b8 84fc                       STY ACCU + 1
   267  57ba 60                         RTS
   268                          }
