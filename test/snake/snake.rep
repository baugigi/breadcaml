   212                          !ifdef caml_PRIM__caml_blit_string {
   213                          caml_blit_string
   214                                  ;; ACCU=src, SP[0]=sofs SP[1]=dst, SP[2]=dofs, SP[3]=len
   215                                  ;; copies len consecutive bytes, starting from src.[sofs], to dst.[dofs]
   216                                  ;; source and destination intervals may overlap.
   217                                  ;; (unsafe, args are checked in Bytes module)
   218                          @FROM   = TMP
   219                          @TO     = TMP + 2
   220                          @SIZE   = TMP + 4
