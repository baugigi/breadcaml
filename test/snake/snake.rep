    19                          !address {
    20                                  ;; Default address space
    21                          C64_VICSCN      = $0400 ;Start address of 1024 Byte Screen Memory Area
    22                          C64_BASRAM      = $0800 ;Start address of BASIC RAM - should be $00
    23                          C64_BASROM      = $A000 ;Start address of BASIC ROM (Vector: BASIC cold start)
    24                          C64_HIRAM       = $C000 ;Start address of free high RAM area
    25                          C64_IOROM       = $D000 ;Start address of I/O ROM
    26                          C64_KERROM      = $E000 ;Start address of Kernal ROM
    27                                          
    28                                  ;; Zeropage
    29                          	;; Free locations: C64_UNUSZP (1 by.), C64_FREKZP (4 by.)
    30                          C64_D6510       = $00   ;Data Direction register
    31                          C64_R6510       = $01   ;Data buffer
    32                          C64_UNUSZP      = $02   ;UNUSED
