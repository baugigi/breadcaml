   367                            !pseudopc caml_interp_fetch {
   368                                          @PC  = @fetch + 1               ;Bytecode interpreter
   369                                          @idx = @exec + 1                ;fetch-exec routine:
   370  0a6d ad3412             @fetch          LDA .dummy                      ; 3 by. SMC: fetch next opc
   371  0a70 e637                               INC+1 @PC                       ; 2 by. incr. LDA operand (PCl)
   372  0a72 d002                               BNE +                           ; 2 by.
   373  0a74 e638                               INC+1 @PC + 1                   ; 2 by. incr. LDA operand (PCh)
   374                          +
   375                              !ifdef caml_DEBUG {
   376                                          JSR caml_debug
   377                              } else {
   378  0a76 0a                                 ASL                             ; 1 by. C:A = 2 * opc
   379  0a77 8543                               STA+1 @idx                      ; 2 by. modify JMP() operand
   380                              }
   381  0a79 6c001e             @exec           JMP (caml_interp_jmptbl)        ; 3 by. SMC: JMP(>jmptbl + A)
   382                            }                                             ;--
   383                          } else {!fill 15}                               ;15 by. total
   384  0a7c 0000000000000000...        !fill 28                                ;28 by. for BLK, GC, TMP
   385                          
   386                          ;; -----------------------------------------------------------------------------
   387                          ;;      INTERPRETER TRACING DEBUGGER
   388                          ;;      | PC | Opcode | ACCU | SP[0] ... SP[5] | ENV | XARGS |
   389                          ;; -----------------------------------------------------------------------------
   390                          
   391                          !ifdef  caml_INTERP {
   392                          !ifdef caml_DEBUG {
   393                          caml_debug
   394                                  @RevOn  = $12
   395                                  @RevOff = $92
   396                                  @Cyan   = $9F
   397                                  @LBlue  = $9A
   398                                  @CR     = $0D
   399                                  PHP                                     ;       [S
   400                                  PHA                                     ;       [opc; S
   401                                  ;; print a header every 22 lines
   402                                  DEC @count
   403                                  BPL +
   404                                  LDA # @CR
   405                                  JSR C64_CHROUT
   406                                  LDX # @hdr - @end                       ;negative number
   407                          -       LDA @end - $100,X
   408                                  JSR C64_CHROUT
   409                                  INX
   410                                  BNE -
   411                                  LDA #21
   412                                  STA @count
   413                          +       ;; print PC
   414                                  LDA PC
   415                                  SEC
   416                                  SBC # 1
   417                                  PHA                                     ;       [PC; opc; S
   418                                  LDA PC + 1
   419                                  SBC # 0
   420                                  JSR @pr_hex
   421                                  PLA                                     ;A=PC   [opc; S
   422                                  JSR @pr_hex
   423                                  ;; print opcode
   424                                  LDA # @RevOn
   425                                  JSR C64_CHROUT
   426                                  PLA                                     ;A=opc  [S
   427                                  PHA                                     ;       [opc; S
   428                                  JSR @pr_hex
   429                                  ;; print ACCU
   430                                  LDA # @Cyan
   431                                  JSR C64_CHROUT
   432                                  LDA ACCU + 1
   433                                  JSR @pr_hex
   434                                  LDA ACCU
   435                                  JSR @pr_hex
   436                                  LDA # @RevOff
   437                                  JSR C64_CHROUT
   438                                  ;; print top 6 stack elements
   439                                  LDY # 0
   440                          -       TYA
   441                                  PHA                                     ;       [Y/4; opc; S
   442                                  LSR
   443                                  LSR
   444                                  LDA # @LBlue
   445                                  BCS +                                   ;switch Cyan/LBlue
   446                                  LDA # @Cyan
   447                          +       JSR C64_CHROUT
   448                                  PLA                                     ;A=Y/4  [opc; S
   449                                  TAY
   450                                  LDA (SP),Y
   451                                  TAX
   452                                  INY
   453                                  LDA (SP),Y
   454                                  JSR @pr_hex                             ;print STACK[i]
   455                                  TXA
   456                                  JSR @pr_hex
   457                                  INY
   458                                  CPY # 12
   459                                  BNE -
   460                                  ;; print ENV
   461                                  LDA # @RevOn
   462                                  JSR C64_CHROUT
   463                                  LDA ENV + 1
   464                                  JSR @pr_hex
   465                                  LDA ENV
   466                                  JSR @pr_hex
   467                                  ;; print XARGS
   468                                  LDA # @RevOff
   469                                  JSR C64_CHROUT
   470                                  LDA XARGS
   471                                  LSR
   472                                  JSR @pr_hex
   473                                  ;; continue fetch-exec
   474                                  PLA                                     ;A=opc  [S
   475                                  PLP                                     ;S      [
   476                                  ASL
   477                                  LDY # 0
   478                                  RTS
   479                          @count  !byte 0
   480                          @pr_hex PHA                                     ;       [A
   481                                  LSR
   482                                  LSR
   483                                  LSR
   484                                  LSR
   485                                  LDX # 2
   486                                  BNE +
   487                          -       PLA                                     ;A      [
   488                                  AND # $0F
   489                          +       CLC
   490                                  ADC # '0'
   491                                  CMP # '9' + 1
   492                                  BCC +
   493                                  ADC # 7 -1                              ;-1 as C=1
   494                          +       JSR C64_CHROUT
   495                                  DEX
   496                                  BNE -
   497                                  RTS
   498                          @hdr    !text @RevOn, "addr", @RevOff, "oc",   @Cyan,  "accu", @RevOn, "stk0"
   499                                  !text @LBlue, "   1", @Cyan,   "   2", @LBlue, "   3", @Cyan,  "   4"
   500                                  !text @LBlue, "   5", @RevOff, " env", @RevOn, "xa",   @RevOff
   501                          @end
   502                          }} ;ifdef caml_INTERP & caml_DEBUG
   503                          
   504                          caml_loader_end
   505                          } ;zone caml_LOADER
   506                          

