   712                                  ;; Custom blocks: Field(v,0) points to the custom operations, a table
   713                                  ;; whose first word is the address of the compare primitive.
   714                                  ;; BreadCaml has no compare_ext: int vs custom is decided by
   715                                  ;; caml_compare_val (int < block), as in OCaml when compare_ext = NULL.
   716                          !ifdef caml_AUX__caml_compare_val_custom_tag {
   717                          caml_compare_val_custom_tag
   718                                  ;; Compare custom blocks in .V1 (ACCU) and .V2, by calling the
