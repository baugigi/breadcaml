   139                          !ifdef caml_PRIM__caml_fill_bytes {
   140                          caml_fill_bytes = caml_fill_string
   141                          }
   142                          !ifdef caml_PRIM__caml_fill_string {
   143                          caml_fill_string
   144                                  ;; ACCU = string, SP[0]=ofs, SP[1]=num, SP[2]=char
   145                                  ;; for num times, string.[i]<-char starting from i=ofs; return: ()
   146                                  ;; (unsafe, args are checked in Bytes module)
   147                          
   148                                  ;; TMP + 1 <- int_val(num)
   149                                  LDY # 3
   150                                  LDA (SP),Y
   151                                  LSR
   152                                  STA TMP + 1
   153                                  DEY
   154                                  LDA (SP),Y
   155                                  ROR
   156                                  BNE +
   157                                  CMP TMP + 1
   158                                  BEQ ++                          ;num = 0, nothing to do
   159                          +       STA TMP
   160                                  ;; ACCU <- ACCU + int_val(pos)
   161                                  DEY
   162                                  LDA (SP),Y
   163                                  LSR
   164                                  TAX
   165                                  DEY
   166                                  LDA (SP),Y
   167                                  ROR
   168                                  CLC
   169                                  ADC ACCU
   170                                  STA ACCU
   171                                  TXA
   172                                  ADC ACCU + 1
   173                                  STA ACCU + 1
   174                                  ;; A <- int_val(char)
   175                                  LDY # 5
   176                                  LDA (SP),Y
   177                                  LSR
   178                                  DEY
   179                                  LDA (SP),Y
   180                                  ROR
   181                                  ;; start substitution
   182                                  LDY # 0
   183                                  LDX TMP
   184                          --      STA (ACCU),Y                            ;modify string in place
   185                                  DEX
   186                                  BEQ +
   187                          -       INY
   188                                  BNE --
   189                                  INC ACCU + 1
   190                                  JMP --
   191                          +       CPX TMP + 1
   192                                  BEQ ++
   193                                  DEC TMP + 1
   194                                  JMP -
   195                          ++      LDY # <Val_unit
   196                                  STY ACCU
   197                                  DEY
   198                                  STY ACCU + 1                            ;return ()
   199                                  RTS
   200                          }
   201                          
   202                          !ifdef caml_PRIM__caml_blit_bytes {
   203                          caml_blit_bytes = caml_blit_string
   204                          }
   205                          !ifdef caml_PRIM__caml_blit_string {
   206                          caml_blit_string
   207                                  ;; ACCU=src, SP[0]=sofs SP[1]=dst, SP[2]=dofs, SP[3]=len
   208                                  ;; copies len consecutive bytes, starting from src.[sofs], to dst.[dofs]
   209                                  ;; source and destination intervals may overlap.
   210                                  ;; (unsafe, args are checked in Bytes module)
   211                          @FROM   = TMP
   212                          @TO     = TMP + 2
   213                          @SIZE   = TMP + 4
   214  232d a007                       LDY # 7
   215  232f b12e                       LDA (SP),Y                              ; >len
   216  2331 4a                         LSR
   217  2332 854a                       STA @SIZE + 1                           ; SIZE + 1 := >int_val(len)
   218  2334 88                         DEY
   219  2335 b12e                       LDA (SP),Y                              ; <len
   220  2337 6a                         ROR
   221  2338 8549                       STA @SIZE                               ; SIZE := <int_val(len)
   222  233a 88                         DEY
   223  233b b12e                       LDA (SP),Y                              ; >dofs
   224  233d 4a                         LSR
   225  233e 8548                       STA @TO + 1                             ; TO := >int_val(dofs)
   226  2340 88                         DEY
   227  2341 b12e                       LDA (SP),Y                              ; <dofs
   228  2343 6a                         ROR
   229  2344 8547                       STA @TO                                 ; TO := <int_val(dofs)
   230  2346 88                         DEY
   231  2347 b12e                       LDA (SP),Y                              ; >dst
   232  2349 aa                         TAX
   233  234a 88                         DEY
   234  234b b12e                       LDA (SP),Y                              ; <dst
   235  234d 18                         CLC
   236  234e 6547                       ADC @TO
   237  2350 8547                       STA @TO                                 ; TO := <(dst + int_val(dofs))
   238  2352 8a                         TXA
   239  2353 6548                       ADC @TO + 1
   240  2355 8548                       STA @TO + 1                             ; TO + 1:= >(dst+int_val(dofs))
   241  2357 88                         DEY
   242  2358 b12e                       LDA (SP),Y                              ; >sofs
   243  235a 4a                         LSR
   244  235b aa                         TAX
   245  235c 88                         DEY
   246  235d b12e                       LDA (SP),Y                              ; <soft
   247  235f 6a                         ROR
   248  2360 18                         CLC
   249  2361 652c                       ADC ACCU
   250  2363 8545                       STA @FROM                               ; FROM := <(src + int_val(sofs))
   251  2365 a8                         TAY
   252  2366 8a                         TXA
   253  2367 652d                       ADC ACCU + 1
   254  2369 8546                       STA @FROM + 1                           ; FROM+1 := >(src+int_val(sofs))
   255  236b 206c21                     JSR caml_memcpy                         ; ok, even if src & dest overlap
   256  236e a001                       LDY # <Val_unit
   257  2370 842c                       STY ACCU
   258  2372 88                         DEY
   259  2373 842d                       STY ACCU + 1
   260  2375 60                         RTS
   261                          }
