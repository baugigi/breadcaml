   642  823e b14d               @key    LDA (.V2),Y                     ;flags are signed keys: nan = -128,
   643  8240 4980                       EOR # $80                       ; -inf = -1, finite = 0, +inf = 1.
   644  8242 8551                       STA .CMP                        ;Compare them as unsigned, after
   645  8244 8a                         TXA                             ; inverting bit 7.
   646  8245 4980                       EOR # $80
   647  8247 c551                       CMP .CMP
