   508                          !ifdef caml_PRIM__caml_float_alloc_result {
   509                          caml_float_alloc_result
   510                                  ;; store result in a new allocated float
   511                                  LDA # Double_tag
   512                                  LDX # Double_wosize
   513                                  LDY # 0
   514                                  JSR caml_alloc
   515                                  LDX BLK
   516                                  LDY BLK + 1
   517                                  +caml_JSR_BASROM C64_MOVMF
   518                                  LDA BLK
   519                                  STA ACCU
   520                                  LDA BLK + 1
   521                                  STA ACCU + 1
   522                                  LDY # 0
   523                                  RTS
   524                          }
