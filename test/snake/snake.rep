   625                          !ifdef caml_PRIM__caml_array_blit {
   626                          caml_array_blit
   627                                  ;; copy a subarray to other one (source and dest may overlap)
   628                                  ;; ACCU = arr1
   629                                  ;; SP[0] = ofs1
   630                                  ;; SP[1] = arr2
   631                                  ;; SP[2] = ofs2
   632                                  ;; SP[3] = n
   633                          @NBY    = TMP + 2
   634                                  ;; load tag
   635                                  LDY # -2
   636                                  DEC ACCU + 1
   637                                  LDA (ACCU),Y
   638                                  INC ACCU + 1
   639                                  ;; check if float
   640                                  CMP # Double_array_tag
   641                                  BNE @no_float
   642                                  ;; array of floats, compute source start address
   643                                  LDY # 0
   644                                  STY @NBY + 1
   645                                  LDA (SP),Y                      ; ofs1, ignore hi byte
   646                                  AND # $FE
   647                                  STA TMP
   648                                  LSR
   649                                  CLC
   650                                  ADC TMP
   651                                  ;; ACCU <- &arr1[ofs1]
   652                                  ASL                             ; A = 6 * ofs1
   653                                  BCC +
   654                                  INC ACCU + 1
   655                                  CLC
   656                          +       ADC ACCU
   657                                  STA ACCU
   658                                  BCC +
   659                                  INC ACCU + 1
   660                                  ;; compute destination start address
   661                          +       LDY # 4
   662                                  LDA (SP),Y                      ; ofs2, ignore hi byte
   663                                  ;; calc 3 * index
   664                                  AND # $FE
   665                                  STA TMP
   666                                  LSR
   667                                  CLC
   668                                  ADC TMP
   669                                  ;; TMP <- &arr2[ofs2]
   670                                  TAX                             ; X = 3 * ofs2
   671                                  DEY
   672                                  LDA (SP),Y
   673                                  STA TMP + 1
   674                                  TXA
   675                                  ASL                             ; A = 6 * ofs2
   676                                  BCC +
   677                                  INC TMP + 1
   678                                  CLC
   679                          +       DEY
   680                                  ADC (SP),Y
   681                                  STA TMP
   682                                  BCC +
   683                                  INC TMP + 1
   684                                  ;; @NBY = 6 * n (no. of bytes to be moved)
   685                          +       LDY # 6
   686                                  LDA (SP),Y                      ; ignore hi byte
   687                                  AND # $FE
   688                                  STA @NBY
   689                                  LSR
   690                                  CLC
   691                                  ADC @NBY
   692                                  STA @NBY
   693                                  BCC +
   694                                  INC @NBY + 1
   695                          +       JMP @copy
   696                          @no_float
   697                                  ;; ordinary array, compute source start address
   698                                  LDY # 0
   699                                  CLC
   700                                  LDA (SP),Y
   701                                  ADC ACCU
   702                                  STA ACCU
   703                                  INY
   704                                  LDA (SP),Y
   705                                  ADC ACCU + 1
   706                                  STA ACCU + 1
   707                                  LDA ACCU
   708                                  BNE +
   709                                  DEC ACCU + 1
   710                          +       DEC ACCU
   711                                  ;; compute destination start address
   712                                  INY
   713                                  LDA (SP),Y
   714                                  STA TMP
   715                                  INY
   716                                  LDA (SP),Y
   717                                  STA TMP + 1
   718                                  INY
   719                                  CLC
   720                                  LDA TMP
   721                                  ADC (SP),Y
   722                                  STA TMP
   723                                  INY
   724                                  LDA TMP + 1
   725                                  ADC (SP),Y
   726                                  STA TMP + 1
   727                                  LDA TMP
   728                                  BNE +
   729                                  DEC TMP + 1
   730                          +       DEC TMP
   731                                  ;; compute no. of bytes to be copied
   732                                  INY
   733                                  LDA @NBY
   734                                  ADC (SP),Y
   735                                  STA @NBY
   736                                  INY
   737                                  LDA @NBY + 1
   738                                  ADC (SP),Y
   739                                  STA @NBY + 1
   740                                  LDA @NBY
   741                                  BNE +
   742                                  DEC @NBY + 1
   743                          +       DEC @NBY
   744                                  ;; copy bytes from source to destination
   745                          @copy   LDA ACCU
   746                                  CMP TMP
   747                                  LDA ACCU + 1
   748                                  SBC TMP + 1
   749                                  BCS @cpydn
   750                                  ;; ACCU < TMP, copy memory up (arr1[0] last)
   751                                  LSR @NBY + 1
   752                                  LDY @NBY
   753                                  JSR caml_blkcpy
   754                                  ;; ACCU <- ()
   755                          @done   STY ACCU + 1                    ; Y = 0
   756                                  LDA # <Val_unit
   757                                  STA ACCU
   758                                  RTS
   759                                  ;; ACCU >= TMP, copy memory down (arr1[0] first)
   760                          @cpydn  LDX @NBY + 1                    ; 0 or 1
   761                                  BEQ +
   762                                  LDY # 0
   763                          -       LDA (ACCU),Y                    ; >255 bytes: copy a whole page
   764                                  STA (TMP),Y
   765                                  INY
   766                                  BNE -
   767                                  INC ACCU + 1
   768                                  INC TMP + 1
   769                          +       LDX @NBY
   770                                  BEQ +
   771                          -       LDA (ACCU),Y                    ; copy the remaining bytes
   772                                  STA (TMP),Y
   773                                  INY
   774                                  DEX
   775                                  BNE -
   776                          +       LDY # 0
   777                                  JMP @done
   778                          }
   779                          
   780                          !ifdef caml_PRIM__caml_array_sub {
   781                          caml_array_sub
   782                                  ;; allocate and return a subarray
   783                                  ;; ACCU = a
   784                                  ;; SP[0] = ofs
   785                                  ;; SP[1] = n
   786                          @NBY    = TMP
   787                                  ;; load tag
   788                                  LDY # -2
   789                                  DEC ACCU + 1
   790                                  LDA (ACCU),Y
   791                                  INC ACCU + 1
   792                                  ;; check if float
   793                                  CMP # Double_array_tag
   794                                  BNE @no_floats
   795                                  ;; array of floats, compute source start address
   796                                  LDY # 0                         ; ignore hi byte
   797                                  STY @NBY + 1
   798                                  LDA (SP),Y
   799                                  AND # $FE
   800                                  STA TMP
   801                                  LSR
   802                                  CLC
   803                                  ADC TMP
   804                                  ;; ACCU <- &arr1[ofs1]
   805                                  ASL                             ; A = 6 * ofs1
   806                                  BCC +
   807                                  INC ACCU + 1
   808                                  CLC
   809                          +       ADC ACCU
   810                                  STA ACCU
   811                                  BCC +
   812                                  INC ACCU + 1
   813                                  ;; @NBY = 6 * n (no. of bytes to be moved)
   814                          +       LDY # 2
   815                                  LDA (SP),Y                      ; ignore hi byte
   816                                  AND # $FE
   817                                  STA @NBY
   818                                  LSR
   819                                  CLC
   820                                  ADC @NBY
   821                                  STA @NBY
   822                                  BCC +
   823                                  INC @NBY + 1
   824                                  ;; allocate subarray
   825                          +       LDA @NBY + 1
   826                                  LSR
   827                                  LDA @NBY
   828                                  ROR
   829                                  TAX
   830                                  LDA # Double_array_tag
   831                                  JSR caml_alloc
   832                                  JMP @copy
   833                          @no_floats
   834                                  ;; ordinary array, compute source start address
   835                                  LDY # 0
   836                                  CLC
   837                                  LDA ACCU
   838                                  ADC (SP),Y
   839                                  STA ACCU
   840                                  INY
   841                                  LDA ACCU + 1
   842                                  ADC (SP),Y
   843                                  STA ACCU + 1
   844                                  LDA ACCU
   845                                  BNE +
   846                                  DEC ACCU + 1
   847                          +       DEC ACCU
   848                                  ;; compute no. of bytes to be copied
   849                                  INY
   850                                  LDA (SP),Y
   851                                  STA @NBY
   852                                  INY
   853                                  LDA (SP),Y
   854                                  STA @NBY + 1
   855                                  LDA @NBY
   856                                  BNE +
   857                                  DEC @NBY + 1
   858                          +       DEC @NBY
   859                                  ;; allocate subarray
   860                                  LDA @NBY + 1
   861                                  LSR
   862                                  LDA @NBY
   863                                  ROR
   864                                  TAX
   865                                  LDA # 0
   866                                  JSR caml_alloc
   867                                  ;; copy bytes from source to destination
   868                          @copy   LSR @NBY + 1
   869                                  LDY @NBY
   870                                  JSR caml_blkcpy
   871                                  ;; ACCU <- subarray
   872                          @done   LDA BLK
   873                                  STA ACCU
   874                                  LDA BLK + 1
   875                                  STA ACCU + 1
   876                                  RTS
   877                          }
   878                          
   879                          !ifdef caml_PRIM__caml_array_append {
   880                          caml_array_append
   881                                  ;; append two arrays
   882                                  ;; ACCU = arr1
   883                                  ;; SP[0] = arr2
   884                          @AUX    = TMP
   885                          @SIZE1  = TMP + 2
   886                          @SIZE2  = TMP + 4
   887                                  ;; load sizes
   888                                  LDA (SP),Y
   889                                  STA @AUX
   890                                  INY
   891                                  LDA (SP),Y
   892                                  STA @AUX + 1
   893                                  LDY # -1
   894                                  DEC ACCU + 1
   895                                  DEC @AUX + 1
   896                                  LDA (ACCU),Y
   897                                  STA @SIZE1
   898                                  LDA (@AUX),Y
   899                                  STA @SIZE2
   900                                  CLC
   901                                  ADC @SIZE1
   902                                  BCC +
   903                                  ;; exception if total size > 255
   904                                  INY                             ; Y = 0
   905                                  JMP @error
   906                                  ;; load tag and allocate
   907                          +       DEY
   908                                  TAX                             ; size
   909                                  LDA (ACCU),Y                    ; tag
   910                                  JSR caml_alloc
   911                                  ;; copy arr1 to dest
   912                                  INC ACCU + 1
   913                                  LDA @SIZE1
   914                                  ASL
   915                                  TAY
   916                                  JSR caml_blkcpy
   917                                  ;; ACCU <- arr2
   918                                  LDA @AUX
   919                                  STA ACCU
   920                                  LDA @AUX + 1
   921                                  STA ACCU + 1
   922                                  ;; save ptr to result
   923                                  LDA BLK
   924                                  STA @AUX
   925                                  LDA BLK + 1
   926                                  STA @AUX + 1
   927                                  ;; TMP <- &TMP[SIZE1]
   928                          +       LDA @SIZE1
   929                                  ASL
   930                                  BCC +
   931                                  INC BLK + 1
   932                                  CLC
   933                          +       ADC BLK
   934                                  STA BLK
   935                                  BCC +
   936                                  INC BLK + 1
   937                                  ;; copy arr2 to dest
   938                          +       LDA @SIZE2
   939                                  ASL
   940                                  TAY
   941                                  JSR caml_blkcpy
   942                                  ;; ACCU <- AUX
   943                                  LDA @AUX
   944                                  STA ACCU
   945                                  LDA @AUX + 1
   946                                  STA ACCU + 1
   947                                  RTS
   948                          @error  +caml_raise Invalid_argument, "Array.append"
   949                          }
   950                          
   951                          !ifdef caml_PRIM__caml_array_concat {
   952                          caml_array_concat
   953                                  ;; concatenate all arrays in a list
   954                                  ;; ACCU = list
   955                          @TAG    = TMP
   956                          @SIZE   = TMP + 1
   957                          @HEAD   = TMP + 2
   958                          @TAIL   = TMP + 4
   959                          @RESULT = TMP + 2
   960                                  DEY
   961                                  STY @TAG                        ; @TAG = -1
   962                                  INY
   963                                  STY @SIZE
   964                                  ;; return caml_atom0 if list = []
   965                                  LDA ACCU
   966                                  BIT caml_is_block
   967                                  BNE @atom0
   968                                  ;; scan list and sum all arrays sizes
   969                                  LDA (ACCU),Y
   970                                  STA @HEAD
   971                                  INY
   972                                  LDA (ACCU),Y
   973                                  STA @HEAD + 1
   974                                  INY
   975                                  LDA (ACCU),Y
   976                                  STA @TAIL
   977                                  INY
   978                                  LDA (ACCU),Y
   979                                  STA @TAIL + 1
   980                                  ;; get current array size and add it to @SIZE
   981                          -       LDY # -1
   982                                  DEC @HEAD + 1
   983                                  LDA (@HEAD),Y
   984                                  BEQ +
   985                                  CLC
   986                                  ADC @SIZE
   987                                  BCS @error                      ; raise exn if > 255
   988                                  STA @SIZE
   989                                  ;; only once: set @TAG from first non-empty array
   990                                  CPY @TAG                        ; test if @TAG = -1
   991                                  BNE +
   992                                  DEY
   993                                  LDA (@HEAD),Y
   994                                  STA @TAG
   995                                  INY
   996                                  ;; set @HEAD to next list element, @TAIL to rest
   997                          +       INY
   998                                  LDA @TAIL
   999                                  BIT caml_is_block                       ; end of list?
  1000                                  BEQ @alloc                      ; yes:  exit loop
  1001                                  LDA (@TAIL),Y                   ; no:   continue
  1002                                  STA @HEAD
  1003                                  INY
  1004                                  LDA (@TAIL),Y
  1005                                  STA @HEAD + 1
  1006                                  INY
  1007                                  LDA (@TAIL),Y
  1008                                  TAX
  1009                                  INY
  1010                                  LDA (@TAIL),Y
  1011                                  STX @TAIL
  1012                                  STA @TAIL + 1
  1013                                  JMP -
  1014                                  ;; allocate destination array
  1015                          @alloc  LDX @SIZE
  1016                                  BEQ @atom0
  1017                                  LDA @TAG
  1018                                  JSR caml_alloc
  1019                                  LDA BLK
  1020                                  STA @RESULT
  1021                                  LDA BLK + 1
  1022                                  STA @RESULT + 1                 ; save dest address
  1023                                  ;; scan list again and append all arrays
  1024                                  LDY # 3
  1025                                  LDA (ACCU),Y
  1026                                  STA @TAIL + 1
  1027                                  DEY
  1028                                  LDA (ACCU),Y
  1029                                  STA @TAIL
  1030                                  DEY
  1031                                  LDA (ACCU),Y
  1032                                  TAX
  1033                                  DEY
  1034                                  LDA (ACCU),Y
  1035                                  STX ACCU + 1
  1036                                  STA ACCU
  1037                                  ;; get current array size
  1038                          -       LDY # -1
  1039                                  DEC ACCU + 1
  1040                                  LDA (ACCU),Y
  1041                                  BEQ ++                          ; skip if zero
  1042                                  INC ACCU + 1
  1043                                  TAX
  1044                                  ASL
  1045                                  TAY
  1046                                  ;; copy array elements to destination
  1047                                  JSR caml_blkcpy
  1048                                  TXA
  1049                                  ;; set BLK pointer to first element to be copied next
  1050                                  ASL
  1051                                  BCC +
  1052                                  CLC
  1053                                  INC BLK + 1
  1054                          +       ADC BLK
  1055                                  STA BLK
  1056                                  BCC ++
  1057                                  INC BLK + 1
  1058                                  ;; set ACCU to next list element, @TAIL to rest
  1059                          ++      LDY # 0
  1060                                  LDA @TAIL
  1061                                  BIT caml_is_block               ; end of list?
  1062                                  BEQ @eol                        ; yes:  exit
  1063                                  LDA (@TAIL),Y                   ; no:   continue
  1064                                  STA ACCU
  1065                                  INY
  1066                                  LDA (@TAIL),Y
  1067                                  STA ACCU + 1
  1068                                  INY
  1069                                  LDA (@TAIL),Y
  1070                                  TAX
  1071                                  INY
  1072                                  LDA (@TAIL),Y
  1073                                  STX @TAIL
  1074                                  STA @TAIL + 1
  1075                                  JMP -                           ; loop
  1076                                  ;; set ACCU = destination array and return
  1077                          @eol    LDA @RESULT
  1078                                  STA ACCU
  1079                                  LDA @RESULT + 1
  1080                                  STA ACCU + 1
  1081                                  RTS
  1082                          @atom0  LDA # < caml_atom0
  1083                                  STA ACCU
  1084                                  LDA # > caml_atom0
  1085                                  STA ACCU + 1
  1086                                  RTS
  1087                          @error  +caml_raise Invalid_argument, "Array.concat"
  1088                          }
  1089                          
  1090                          }      ;; !zone caml_ARRAYS
  1091                          

