   126                          
   127                                  ;; Statically allocated, word-aligned
   128                          !addr   caml_atom0 = .zeroes + 2 + .zeroes % 2
   129                          
   130                          ;; FLOAT blocks: C64 MFLP representation, not IEEE!
   131                          ;; .Tag_Sz_*_________._________._________.
   132                          ;; |253¦_3_|Expo¦±M_a|_n_t¦_i_s|_s_a¦_??_|      ?? = unused byte
   133                          
   134                                  Double_wosize   = 3
   135                          
   136                          !macro  caml_move_float .FROM, .TO {            ;Copy float block fields
   137                                  LDY # 2 * Double_wosize - 2             ;and set Y=0 at exit
   138                          -       LDA (.FROM),Y
   139                                  STA (.TO),Y
   140                                  DEY
   141                                  BPL -
   142                                  INY
   143                          }
   144                          
   145                          ;; STRING blocks: length = 2 * Sz - 1 - last byte;
   146                          ;; .Tag_Sz_*___________.___________.___________.
   147                          ;; |252¦_3_|_'O'_¦_'C'_|_'a'_¦_'m'_|_'l'_¦__0__| "OCaml" length=2*3-1-0=5
   148                          ;; .Tag_Sz_*___________.___________.___________.
   149                          ;; |252¦_3_|_'C'_¦_'='_|_'6'_¦_'4'_|__0__¦__1__| "C=64"  length=2*3-1-1=4
   150                          
   151                          !macro  caml_string .str {                      ;Assemble the string .str
   152                                  !text .str, 0                           ;with proper trailing byte(s)
   153                                  !if len(.str) % 2 = 0 { !byte 1 }
   154                          }
   155                          
   156                          ;; EXCEPTIONS:
   157                          ;; .Tag_Sz_*____________._____.                 standard exceptions:
   158                          ;; |248¦_2_|_string_blk_|_oid_|                 oid = -1 ... -12  = -exn_no-1
   159                          ;;          /
   160                          ;; .Tag_Sz_*_.______···_______.
   161                          ;; |252¦Sz_|_"Exception_name"_|
   162                          
   163                                  Out_of_memory   =  0 :  End_of_file     =  4 :  Stack_overflow  =  8
   164                                  Sys_error       =  1 :  Division_by_zero=  5 :  Sys_blocked_io  =  9
   165                                  Failure         =  2 :  Not_found       =  6 :  Assert_failure  = 10
   166                                  Invalid_argument=  3 :  Match_failure   =  7 :  Undef_rec_module= 11
   167                                  caml_exn_no     = 12
   168                          
   169                          !macro  caml_raise .exn {                       ;Raise a standard exception
   170                                  LDA # <caml_std_exn[.exn]
   171                                  STA ACCU
   172                                  LDA # >caml_std_exn[.exn]
   173                                  STA ACCU + 1
   174                                  JMP RAISE
   175                          }
   176                          !macro  caml_raise .exn, .str {                 ;As above, with a string arg.
   177                                  LDA # <.blk
   178                                  STA ACCU
   179                                  LDA # >.blk
   180                                  STA ACCU + 1
   181                                  JMP RAISE
   182                                  !align $01, $00
   183                                  !byte String_tag, (.h - .s) div 2
   184                          .s      +caml_string .str
   185                          .h      !byte 0, 2
   186                          .blk    !word caml_std_exn[.exn], .s
   187                          }
   188                                  ;; Statically allocate std exns and init caml_std_exn[] ptr array
   189                          !macro  caml_alloc_exn .s, .i {
   190                                  +Val_Int ~.id, -.i - 1
   191                                  !byte String_tag, (.hdr - .str) div 2   ;string block's header
   192                          .str    +caml_string .s                         ;string block's fields
   193                          .hdr    !byte Object_tag, 2                     ;exception block's header
   194                          .fld    !word .str, .id                         ;exception block's fields
   195                                  !set caml_std_exn = caml_std_exn + [.fld]
   196                          }
   197                          !set .x=["Out\xa4of\xa4memory","Sys\xa4error","Failure","Invalid\xa4argument"]
   198                          !set .x=.x+["End\xa4of\xa4file","Division\xa4by\xa4zero","Not\xa4found"]
   199                          !set .x=.x+["Match\xa4failure","Stack\xa4overflow","Sys\xa4blocked\xa4io"]
   200                          !set .x=.x+["Assert\xa4failure","Undef\xa4rec\xa4module"]
   201                          !set    caml_std_exn    = []                    ;array of pointers
   202  087d ea                 !align  $01, $00
   203                          !for .i, 0, caml_exn_no - 1 { +caml_alloc_exn .x[.i], .i }

