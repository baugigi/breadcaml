    98                                  JSR caml_POP1
    99                            } else {
   100                                  LDA # .n2l
   101                              !if .n2h > 0 {
   102                                  LDY # .n2h
   103                              }
   104                                  !set    caml_gen_POPN = 1
   105                                  JSR caml_POPN
   106                            }
   107                          }
   108                          !macro  i14 .n {                                ;ASSIGN n
   109                                  +caml_range 0, .n, $7FFF, "ASSIGN n: n"
   110                                  .n2h = >(2 * .n)
