    17                          ;;IOtools_get_key
    18                          ;;	LDY # 0
    19                          ;;	STY ACCU + 1                            ;ACCUh := 0
    20                          ;;	JSR C64_GETIN				;A:=get char from keyboard queue
    21                          ;;	SEC
    22                          ;;	ROL
    23                          ;;	STA ACCU                                ;ACCUl := <Val_char(A)
    24                          ;;	ROL ACCU + 1                            ;ACCUh := >Val_char(A)
    25                          ;;	RTS
    26                          
    27                          IOtools_get_key
    28  1348 462c               	LSR ACCU				;X := max retries (0-127)
    29  134a a62c               	LDX ACCU
    30  134c 842d               	STY ACCU + 1                            ;ACCUh := 0
    31  134e 203ef1             -       JSR C64_GETIN				;A:=get char from keyboard queue
    32  1351 d003               	BNE +
    33  1353 ca                 	DEX					;if null, retry (max X times)
    34  1354 d0f8               	BNE -
    35  1356 38                 +       SEC
    36  1357 2a                         ROL
    37  1358 852c                       STA ACCU                                ;ACCUl := <Val_char(A)
    38  135a 262d                       ROL ACCU + 1                            ;ACCUh := >Val_char(A)
    39  135c 60                         RTS
    40                          
    41                          IOtools_videoram_read
    42                                  ;; ACCU is address, relative to start of video RAM; 0 <= ACCU <= 999
    43  135d 462d                       LSR ACCU + 1
    44  135f 662c                       ROR ACCU                                ;ACCU := Int_val(ACCU)
    45  1361 a904                       LDA # >1024                             ;1024 = start of video RAM
    46  1363 18                         CLC
    47  1364 652d                       ADC ACCU + 1
    48  1366 852d                       STA ACCU + 1                            ;ACCU := address to peek
    49  1368 a000                       LDY # 0
    50  136a b12c                       LDA (ACCU),Y                            ;A := peek(address)
    51  136c 842d                       STY ACCU + 1                            ;ACCUh := 0
    52  136e 38                         SEC
    53  136f 2a                         ROL
    54  1370 852c                       STA ACCU                                ;ACCUl := <Val_int(A)
    55  1372 262d                       ROL ACCU + 1                            ;ACCUh := >Val_int(A)
    56  1374 60                         RTS
    57                          
    58                          IOtools_videoram_write
    59                                  ;; ACCU is address, relative to start of video RAM; 0 <= ACCU <= 999
    60                                  ;; SP[0] is value to write, 0 <= SP[0] <= 255
    61  1375 462d                       LSR ACCU + 1
    62  1377 662c                       ROR ACCU                                ;ACCU := Int_val(ACCU)
    63  1379 a904                       LDA # >1024                             ;1024 = start of video RAM
    64  137b 18                         CLC
    65  137c 652d                       ADC ACCU + 1
    66  137e 852d                       STA ACCU + 1                            ;ACCU := address to poke
    67  1380 a001                       LDY #1
    68  1382 b12e                       LDA (SP),Y                              ;A := >SP[0]
    69  1384 4a                         LSR
    70  1385 88                         DEY
    71  1386 b12e                       LDA (SP),Y                              ;A := <SP[0]
    72  1388 6a                         ROR
    73  1389 912c                       STA (ACCU),Y                            ;write memory
    74  138b a901                       LDA # Val_unit
    75  138d 852c                       STA ACCU                                ;ACCUl := <Val_unit
    76  138f 842d                       STY ACCU + 1                            ;ACCUh := >Val_unit
    77  1391 60                         RTS
    78                          
    79                          IOtools_set_cursor_position
    80                                  ;; Int_val(ACCU) = 256 * row + column
    81  1392 a52d                       LDA ACCU + 1
    82  1394 4a                         LSR
    83  1395 aa                         TAX                                     ;X := row
    84  1396 a52c                       LDA ACCU
    85  1398 6a                         ROR
    86  1399 a8                         TAY                                     ;Y := column
