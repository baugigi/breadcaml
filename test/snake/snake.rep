   128                          C64_NXTBIT      = $B5   ;RS-232 Next Bit to Send/ Tape EOT Flag
   129                          C64_RODATA      = $B6   ;RS-232 Out Byte Buffer
   130                          C64_FNLEN       = $B7   ;Length of Current File Name
   131                          C64_LA          = $B8   ;-$B9 Current Logical File Number
   132                          C64_FA          = $BA   ;Current Device Number
   133                          C64_FNADR       = $BB   ;-$BC Pointer: Current File Name
   134                          C64_ROPRTY      = $BD   ;RS-232 Out Parity / Cassette Temp
   135                          C64_FSBLK       = $BE   ;Cassette Read / Write Block Count
   136                          C64_MYCH        = $BF   ;Serial Word Buffer
   137                          C64_CAS1        = $C0   ;Tape Motor Interlock
   138                          C64_STAL        = $C1   ;-$C2 I/O Start Address
   139                          C64_MEMUSS      = $C3   ;-$C4 Tape Load Temps
   140                          C64_LSTX        = $C5   ;Current Key Pressed: CHR$(n)  No Key
