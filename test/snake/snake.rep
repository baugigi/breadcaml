   386                          !ifdef caml_PRIM__caml_string_index_y {
   387                          caml_string_index_y
   388                                  ;; given a string in ACCU, read index from SP[0], then
   389                                  ;; set Y and ACCU+1 so that ACCU+Y = &string[index];
   390                                  ;; raise Invalid_argument if not 0<=index<length(string).
   391                                  LDY # 1
   392                                  LDA (SP),Y                              ;get ARGh
   393                                  LSR                                     ;Int_val(ARGh)
   394                                  STA TMP + 1                             ;save
   395                                  DEY
   396                                  LDA (SP),Y                              ;get ARGl
   397                                  ROR                                     ;Int_val(ARGl)
   398                                  STA TMP                                 ;save
   399                                  JSR caml_string_length_yx               ;get string length in .Y.X
   400                                  CPX TMP + 1                             ;compare hi bytes
   401                                  BCC ++                                  ;.X < ARGh: error
   402                                  BNE +                                   ;.X > ARGh: ok
   403                                  CPY TMP                                 ;.X = ARGh: compare lo byte
   404                                  BCC ++                                  ;.Y < ARGl: error
   405                                  BEQ ++                                  ;.Y = ARGl: error
   406                          +       LDY TMP                                 ;reload index, lo
   407                                  LDA TMP + 1
   408                                  BEQ +
   409                                  INC ACCU + 1                            ;inc ACCUh if needed
   410                          +       RTS
   411                          ++      +caml_raise Invalid_argument, "index out of bounds"
   412                          }
   413                          
   414                          !ifdef caml_PRIM__caml_string_length_yx {
   415                          caml_string_length_yx
   416                                  ;; ACCU = string
   417                                  ;; return the string length in .Y,.X (int16, lo-hi)
   418  23f2 a52d                       LDA ACCU + 1
   419  23f4 48                         PHA                                     ;save ACCU + 1
   420  23f5 88                         DEY                                     ;LDY # -1
   421  23f6 c62d                       DEC ACCU + 1
   422  23f8 b12c                       LDA (ACCU),Y                            ;.A := size
   423  23fa e62d                       INC ACCU + 1
   424  23fc a200                       LDX # 0
   425  23fe 0a                         ASL
   426  23ff a8                         TAY                                     ;.Y := <(2 * size)
   427  2400 9008                       BCC @minus1
   428  2402 d003                       BNE +
   429  2404 88                         DEY                                     ;shortcut when .Y=256
   430  2405 d00b                       BNE @pad                                ;bne=jmp
   431  2407 e62d               +       INC ACCU + 1
   432  2409 e8                         INX                                     ;.X := >(2 * size)
   433  240a 88                 @minus1 DEY                                     ;.Y := <(2 * size - 1)
   434  240b c0ff                       CPY # $FF
   435  240d d003                       BNE @pad
   436  240f c62d                       DEC ACCU + 1
   437  2411 ca                         DEX                                     ;.X := >(2 * size - 1)
   438  2412 b12c               @pad    LDA (ACCU),Y                            ;.A := padding byte
   439  2414 f006                       BEQ +
   440  2416 88                         DEY                                     ;.Y := <(2 * size -1 -pad)
   441  2417 c0ff                       CPY # $FF
   442  2419 d001                       BNE +
   443  241b ca                         DEX                                     ;.X := >(2 * size -1 -pad)
   444  241c 68                 +       PLA
   445  241d 852d                       STA ACCU + 1                            ;restore ACCU+1
   446  241f 60                         RTS
   447                          }
   448                          
   449                          }      ;; !zone caml_STRINGS
