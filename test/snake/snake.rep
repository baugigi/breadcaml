   123                          caml_string_set
   124                                  ;; ACCU=string, SP[0]=index, SP[1]=newval
   125                                  ;; string.[index]<-newval; return: ()
   126                          ;       TMP                             ; used by caml_string_index_y
   127                          ;       TMP + 1                         ; used by caml_string_index_y
   128                          @CHAR   = TMP + 2
   129                                  LDY # 3
   130                                  LDA (SP),Y                      ; get newval, hi
   131                                  DEY
   132                                  LSR
   133                                  LDA (SP),Y                      ; get newval, lo
   134                                  ROR
   135                                  STA @CHAR                       ; save char_val(newval)
   136                                  JSR caml_string_index_y         ; Y := index
   137                                  LDA @CHAR
   138                                  STA (ACCU),Y                    ; modify string in place
   139                                  LDY # <Val_unit
   140                                  STY ACCU
   141                                  DEY
   142                                  STY ACCU + 1                    ; return ()
   143                                  RTS
   144                          }
