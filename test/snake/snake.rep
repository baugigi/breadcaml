   321                          !ifdef caml_PRIM__caml_ldexp_float {
   322                                  ;; compute ACCU * 2 ^ N, -255 < N < 255.
   323                                  ;; To be called with    SP[0] = Val_int(N) if N >= 0
   324                                  ;;                      SP[0] = Val_int(256-N) if N < 0
   325                          caml_ldexp_float
   326                                  LDA # Double_tag
   327                                  LDX # Double_wosize
   328                                  JSR caml_alloc
   329                                  INY
   330                                  LDA (SP),Y
   331                                  DEY
   332                                  LSR                             ;.A := Int_val(>SP[0])
   333                                  BEQ @add                        ;N >= 0 ?
   334                                  LDA (SP),Y                      ;no:
   335                                  ROR                             ;   .A := Int_val(SP[0])
   336                                  SEC
   337                                  EOR # $FF                       ;   subtract .A from exponent
   338                                  ADC (ACCU),Y                    ;   (eor/adc = inverse sbc)
   339                                  BCS @save                       ;   if underflow,
   340                                  LDA # 0                         ;   set exp = 0 (result = 0.0)
   341                          @save   STA (BLK),Y                     ;save exp byte
   342                                  BEQ +                           ;skip copy of mantissa if underflow
   343                                  LDY # 4
   344                          -       LDA (ACCU),Y                    ;copy mantissa
   345                                  STA (BLK),Y
   346                                  DEY
   347                                  BNE -
   348                          +       LDA BLK
   349                                  STA ACCU
   350                                  LDA BLK + 1
   351                                  STA ACCU + 1                    ;ACCU := BLK
   352                                  RTS
   353                          @add    LDA (SP),Y                      ;yes:
   354                                  ROR                             ;   .A := Int_val(SP[0])
   355                                  CLC
   356                                  ADC (ACCU),Y                    ;   add .A to exponent
   357                                  BCC @save                       ;   go to @save
   358                                  LDX # C64_ERR_OVERFLOW          ;   manage overflow (error)
   359                                  JMP (C64_IERROR)
   360                          }
   361                          
   362                          !ifdef caml_PRIM__caml_frexp_float {
   363                          caml_frexp_float
   364                                  @NEW = BLK                      ;used by caml_alloc
   365                                  @FLO = TMP
   366                                  ;; allocate a new float with same mantissa and exp=0
   367                                  LDA # Double_tag                ;tag of new float
   368                                  LDX # Double_wosize             ;size of new float
   369                                  JSR caml_alloc                  ;alloc new float
   370                                  LDA (ACCU),Y                    ;load (biased) exponent
   371                                  PHA                             ;save it for later
   372                                  BNE @nz                         ;float is 0.0?
   373                                  STA (@NEW),Y                    ;yes: set new float exp = 0
   374                                  BEQ @pair                       ;     and go further
   375                          @nz     LDA # $80                       ;no: set new float exp = $80
   376                                  STA (@NEW),Y
   377                                  LDY # 4                         ;    then copy the mantissa
   378                          -       LDA (ACCU),Y
   379                                  STA (@NEW),Y
   380                                  DEY
   381                                  BNE -
   382                                  ;; allocate a new pair (float * int)
   383                          @pair   LDA @NEW
   384                                  STA @FLO
   385                                  LDA @NEW + 1
   386                                  STA @FLO + 1                    ;save new float ptr in @FLO
   387                                  LDA # 0                         ;tag of new pair
   388                                  LDX # 2                         ;size of new pair
   389                                  JSR caml_alloc                  ;alloc new pair
   390                                  ;; set pair elements
   391                                  LDA @FLO
   392                                  STA (@NEW),Y
   393                                  INY
   394                                  LDA @FLO + 1
   395                                  STA (@NEW),Y                    ;field0 := new float
   396                                  INY
   397                                  LDX # 0
   398                                  PLA                             ;reload biased exponent
   399                                  BNE @debias                     ;exp = 0?
   400                                  LDA # <Val_zero                 ;yes: set field1,lo := <Val_int(0)
   401                                  STA (@NEW),Y
   402                                  LDA # >Val_zero
   403                                  BEQ @fld1h                      ;     beq=jmp to set field1,hi
   404                          @debias SEC                             ;no:  compute debiased exponent
   405                                  SBC # $80
   406                                  BCS @valint                     ;     if negative,
   407                                  DEX                             ;     set hi byte = $FF
   408                                  SEC
   409                          @valint ROL                             ;compute <Val_int(exponent)
   410                                  STA (@NEW),Y                    ;field1,lo := <Val_int(exponent)
   411                                  TXA
   412                                  ROL                             ;compute >Val_int(exponent)
   413                          @fld1h  INY
   414                                  STA (@NEW),Y                    ;field1,hi := >Val_int(exponent)
   415                                  LDA @NEW
   416                                  STA ACCU
   417                                  LDA @NEW + 1
   418                                  STA ACCU + 1                    ;ACCU := new pair
   419                                  LDY # 0
   420                                  RTS
   421                          }
