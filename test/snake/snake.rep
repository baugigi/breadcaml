     5                          !zone caml_COMPARISONS {
     6                          
     7                          !ifndef caml_compare_warn {
     8                          caml_compare_warn
     9                            !warn "TODO: caml_compare_val_custom_tag"
    10                            !warn "TODO: caml_compare_val_double_array_tag"
    11                            !warn "TODO: caml_compare_val_object_tag"
    12                          }
    13                          
    14                          .dummy = $1234                                  ;dummy address for SMC
    15                                  
    16                          !macro  beq .adr { BNE + : JMP .adr :+ }        ;Long branch if equal
    17                          !macro  bne .adr { BEQ + : JMP .adr :+ }        ;Long branch if not equal
    18                          
    19                          .V1     = ACCU                                  ;word, 1st argument
    20                          .V2     = TMP                                   ;word, 2nd argument
    21                          .SAVESP = TMP + 2                               ;word, SP backup
    22                          .CMP    = TMP + 4                               ;byte, result/temp
    23                          .COMPARE= TMP + 5                               ;byte, total ordering flag
    24                          .FLTMP  = TMP + 6                               ;5 bytes, float temp area
    25                                  ;; TMP + 11 ...                         ;free
    26                          
    27                                  ;;
    28                                  ;; int
    29                                  ;;
    30                          
    31                          !ifdef caml_PRIM__caml_int_compare {
    32                          caml_int_compare
    33                                  LDA ACCU + 1                            ;Compare hi bytes by subtraction
    34                                  INY
    35                                  SEC
    36                                  SBC (SP),Y
    37                                  BEQ ++                                  ;if A = arg0h-arg1h <> 0 then
    38                                  BVC +                                   ;  A_7 <- N xor V
    39                                  EOR #$80                                ;  (A_7=1 <==> arg0 < arg1)
    40                          +       STA ACCU + 1                            ;  store it in ACCUh
    41                                  DEY
    42                                  RTS                                     ;  exit (ACCUl unchanged);      
    43                          ++      DEY                                     ;else
    44                                  LDA (SP),Y                              ;  compare lo bytes
    45                                  CMP ACCU                                ;  (C=1 <==> arg0 <= arg1)
    46                                  BEQ caml_return_zero                    ;  if equal, return Val_zero;
    47                                  ROR ACCU + 1                            ;  else rotate C -> ACCUh_7
    48                                  RTS                                     ;  and exit (ACCUl unchanged);
    49                          }
    50                          
