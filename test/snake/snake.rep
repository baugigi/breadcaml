   647  0c2c 4c5e0c                     JMP @next                       ;  then process next arg.
   648  0c2f b14f               @block  LDA (@arg),Y                    ; Arg is a block, check if string
   649  0c31 8552                       STA @out + 1
   650  0c33 8651                       STX @out
   651  0c35 20790c                     JSR @get_tag_size
   652  0c38 c9fc                       CMP # String_tag
   653  0c3a d01d                       BNE @under
