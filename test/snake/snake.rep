   162  572b 6a                         ROR
   163  572c d004                       BNE +
   164  572e c54e                       CMP TMP + 1
   165  5730 f038                       BEQ ++                          ;num = 0, nothing to do
   166  5732 854d               +       STA TMP
   167                                  ;; ACCU <- ACCU + int_val(pos)
   168  5734 88                         DEY
   169  5735 b1fd                       LDA (SP),Y
   170  5737 4a                         LSR
   171  5738 aa                         TAX
   172  5739 88                         DEY
   173  573a b1fd                       LDA (SP),Y
   174  573c 6a                         ROR
