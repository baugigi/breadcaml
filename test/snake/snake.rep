    61                          !macro  i09 {                                   ;PUSH
    62                                  !set    caml_gen_PUSH = 1
    63                                  JSR caml_PUSH
    64                          }
    65                          !macro  i0a     {+i09}                          ;PUSHACC0 -> caml_PUSH
    66                          !macro  i0b     {+i09 : +i08 1}                 ;PUSHACCi -> PUSH; ACC i
