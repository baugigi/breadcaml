    15                          ;; -----------------------------------------------------------------------------
    16                          ;;                                COMPARISONS
    17                          ;; -----------------------------------------------------------------------------
    18                          
    19                          !zone caml_COMPARISONS {
    20                          
    21                          .dummy = $1234                          ;dummy address for SMC
    22                          
    23                          .V1     = ACCU                          ;word, 1st argument
    24                          .V2     = TMP                           ;word, 2nd argument
    25                          .SAVESP = TMP + 2                       ;word, SP backup
    26                          .CMP    = TMP + 4                       ;byte, result/temp
    27                          .COMPARE= TMP + 5                       ;byte, total ordering flag
    28                          
    29                          .LESS    = %10000000			;operator bitmasks
    30                          .GREATER = %00000010
    31                          .EQUAL   = %00000001
    32                          .UNORD   = %00000100                    ;unordered (nan): floats only
    33                          
    34                                  ;;
    35                                  ;; int
    36                                  ;;
    37                          
    38                          !ifdef caml_PRIM__caml_int_compare {
    39                          caml_int_compare
    40                                  LDA ACCU + 1
    41                                  SEC
    42                                  INY
    43                                  SBC (SP),Y
    44                                  BVC +
    45                                  BPL @y0_m1
    46                                  BMI @y0_p1
    47                          +       BMI @y0_m1
    48                                  BNE @y0_p1
    49                                  DEY
    50                                  LDA ACCU
    51                                  CMP (SP),Y
    52                                  BCC @m1
    53                                  BNE caml_return_one
    54                                  BEQ caml_return_zero
    55                          @y0_p1  DEY
    56                                  BEQ caml_return_one     	;BEQ=JMP
    57                          @y0_m1  DEY
    58                          @m1	LDA # -1
    59                                  STA ACCU
    60                                  STA ACCU + 1
    61                                  RTS
    62                          }
    63                          
    64                                  ;;
    65                                  ;; float
    66                                  ;;
    67                          
    68                          !ifdef caml_PRIM__caml_float_compare {
    69                          caml_float_compare
    70                                  JSR caml_compare_identity_setV2
    71                                  BEQ caml_return_zero            ;(compare nan nan = 0: total ordering)
    72                                  LDA # 1
    73                                  STA .COMPARE                    ;total ordering: nan < -inf < x < inf
    74                                  JSR caml_compare_val_double_tag
    75                                  JMP caml_cmp_res
    76                          }
    77                          
    78                                  ;;
    79                                  ;; bytes/string
    80                                  ;;
    81                          
    82                          !ifdef caml_PRIM__caml_string_equal {
    83                          caml_string_equal
    84                                  LDA # .EQUAL
    85                                  BNE caml_scmp
    86                          }
    87                          
    88                          !ifdef caml_PRIM__caml_string_notequal {
    89                          caml_string_notequal
    90                                  LDA # .LESS | .GREATER
    91                                  BNE caml_scmp
    92                          }
    93                          
    94                          !ifdef caml_PRIM__caml_string_lessthan {
    95                          caml_string_lessthan
    96                                  LDA # .LESS
    97                                  BNE caml_scmp
    98                          }
    99                          
   100                          !ifdef caml_PRIM__caml_string_greaterequal {
   101                          caml_string_greaterequal
   102                                  LDA # .GREATER | .EQUAL
   103                                  BNE caml_scmp
   104                          }
   105                          
   106                          !ifdef caml_PRIM__caml_string_lessequal {
   107                          caml_string_lessequal
   108                                  LDA # .LESS | .EQUAL
   109                                  BNE caml_scmp
   110                          }
   111                          
   112                          !ifdef caml_PRIM__caml_string_greaterthan {
   113                          caml_string_greaterthan
   114                                  LDA # .GREATER
   115                                  BNE caml_scmp
   116                          }
   117                          
   118                          !ifdef caml_PRIM__caml_string_compare {
   119                          caml_string_compare
   120                                  JSR caml_compare_identity_setV2
   121                                  BEQ caml_return_zero
   122                                  JSR caml_compare_val_string_tag
   123                                  JMP caml_cmp_res
   124                          }
   125                          
   126                          !ifdef caml_PRIM__caml_bytes_equal {
   127                          caml_bytes_equal = caml_string_equal
   128                          }
   129                          !ifdef caml_PRIM__caml_bytes_notequal {
   130                          caml_bytes_notequal = caml_string_notequal
   131                          }
   132                          !ifdef caml_PRIM__caml_bytes_lessthan {
   133                          caml_bytes_lessthan = caml_string_lessthan
   134                          }
   135                          !ifdef caml_PRIM__caml_bytes_greaterequal {
   136                          caml_bytes_greaterequal = caml_string_greaterequal
   137                          }
   138                          !ifdef caml_PRIM__caml_bytes_lessequal {
   139                          caml_bytes_lessequal = caml_string_lessequal
   140                          }
   141                          !ifdef caml_PRIM__caml_bytes_greaterthan {
   142                          caml_bytes_greaterthan = caml_string_greaterthan
   143                          }
   144                          !ifdef caml_PRIM__caml_bytes_compare {
   145                          caml_bytes_compare = caml_string_compare
   146                          }
   147                          
   148                                  ;;
   149                                  ;; comparison results
   150                                  ;;
   151                          
   152                          !ifdef  caml_AUX__caml_return_true {
   153                          caml_return_true
   154                                  STY ACCU + 1
   155                                  LDA # <Val_true
   156                                  STA ACCU
   157                                  RTS
   158                          }
   159                          
   160                          !ifdef  caml_AUX__caml_return_false {
   161                          caml_return_false
   162                                  STY ACCU + 1
   163                                  LDA # <Val_false
   164                                  STA ACCU
   165                                  RTS
   166                          }
   167                          
   168                          !ifdef  caml_AUX__caml_return_zero {
   169                          caml_return_zero = caml_return_false
   170                          }
   171                          !ifdef  caml_AUX__caml_return_one {
   172                          caml_return_one = caml_return_true
   173                          }
   174                          
   175                                  ;;
   176                                  ;; polymorphic comparisons
   177                                  ;;
   178                          
   179                          !ifdef caml_PRIM__caml_equal {
   180                          caml_equal
   181                                  JSR caml_compare_val
   182                                  BNE caml_return_false
   183                                  BEQ caml_return_true
   184                          }
   185                          
   186                          !ifdef caml_PRIM__caml_notequal {
   187                          caml_notequal
   188                                  JSR caml_compare_val
   189                                  BNE caml_return_true
   190                                  BEQ caml_return_false
   191                          }
   192                          
   193                          !ifdef caml_PRIM__caml_lessthan {
   194                          caml_lessthan
   195                                  JSR caml_compare_val
   196                                  BPL caml_return_false
   197                                  BMI caml_return_true
   198                          }
   199                          
   200                          !ifdef caml_PRIM__caml_greaterequal {
   201                          caml_greaterequal
   202                                  JSR caml_compare_val
   203                                  BMI caml_return_false
   204                                  CMP # 2                         ;2 = unordered (nan)
   205                                  BCC caml_return_true
   206                                  BCS caml_return_false
   207                          }
   208                          
   209                          !ifdef caml_PRIM__caml_lessequal {
   210                          caml_lessequal
   211                                  JSR caml_compare_val
   212                                  BMI caml_return_true
   213                                  BEQ caml_return_true
   214                                  BPL caml_return_false
   215                          }
   216                          
   217                          !ifdef caml_PRIM__caml_greaterthan {
   218                          caml_greaterthan
   219                                  JSR caml_compare_val
   220                                  BMI caml_return_false
   221                                  BEQ caml_return_false
   222                                  CMP # 2                         ;2 = unordered (nan)
   223                                  BCC caml_return_true
   224                                  BCS caml_return_false
   225                          }
   226                          
   227                          !ifdef caml_PRIM__caml_compare {
   228                          caml_compare
   229                                  INY                             ;set .COMPARE=1
   230                                  JSR caml_compare_val
   231                                  ;; FALLTHROUGH caml_cmp_res
   232                          }
   233                          
   234                          !ifdef  caml_AUX__caml_cmp_res {
   235                          caml_cmp_res
   236                                  BMI +
   237                                  BEQ caml_return_zero
   238                                  BPL caml_return_one
   239                          +       LDA # -1
   240                                  STA ACCU
   241                                  STA ACCU + 1
   242                                  RTS
   243                          }
   244                          
   245                          !ifdef caml_AUX__caml_scmp {
   246                          caml_scmp                               ;{A = mask}
   247                                  STA caml_cmp__mask
   248                                  JSR caml_compare_identity_setV2
   249                                  BNE @diff
   250                                  LDA # 0                         ;identical strings: A := 0 (equal)
   251                                  JMP caml_cmp
   252                          @diff   JSR caml_compare_val_string_tag
   253                                  JMP caml_cmp
   254                          }
   255                          
   256                          !ifdef caml_AUX__caml_fcmp {
   257                          caml_fcmp                               ;{A = mask}
   258                                  STA caml_cmp__mask
   259                                  LDA (SP),Y                      ;.V2 := SP[0] (no shortcut if v1 == v2:
   260                                  STA .V2                         ; nan <> nan)
   261                                  INY
   262                                  LDA (SP),Y
   263                                  STA .V2 + 1
   264                                  LDA # 0
   265                                  STA .COMPARE                    ;partial ordering: nan is unordered
   266                                  JSR caml_compare_val_double_tag
   267                                  ;; FALLTHROUGH caml_cmp
   268                          }
   269                          
   270                          !ifdef caml_AUX__caml_cmp {
   271                          caml_cmp
   272                                  TAX                             ;A = -1, 0, 1 or 2 (unordered)
   273                                  INX
   274                                  LDA .res,X
   275                          caml_cmp__mask = * + 1
   276                                  AND # <.dummy                   ;SMC: AND #mask
   277                                  BNE caml_return_true
   278                                  BEQ caml_return_false
   279                          .res    !byte .LESS, .EQUAL, .GREATER, .UNORD
   280                          }
   281                          
   282                                  ;;
   283                                  ;; float comparison operators (kept next to caml_fcmp: BNE range)
   284                                  ;;
   285                          
   286                          !ifdef caml_PRIM__caml_eq_float {
   287                          caml_eq_float
   288                                  LDA # .EQUAL
   289                                  BNE caml_fcmp
   290                          }
   291                          
   292                          !ifdef caml_PRIM__caml_neq_float {
   293                          caml_neq_float
   294                                  LDA # .LESS | .GREATER | .UNORD ;(x <> nan is true)
   295                                  BNE caml_fcmp
   296                          }
   297                          
   298                          !ifdef caml_PRIM__caml_le_float {
   299                          caml_le_float
   300                                  LDA # .LESS | .EQUAL
   301                                  BNE caml_fcmp
   302                          }
   303                          
   304                          !ifdef caml_PRIM__caml_lt_float {
   305                          caml_lt_float
   306                                  LDA # .LESS
   307                                  BNE caml_fcmp
   308                          }
   309                          
   310                          !ifdef caml_PRIM__caml_ge_float {
   311                          caml_ge_float
   312                                  LDA # .GREATER | .EQUAL
   313                                  BNE caml_fcmp
   314                          }
   315                          
   316                          !ifdef caml_PRIM__caml_gt_float {
   317                          caml_gt_float
   318                                  LDA # .GREATER
   319                                  BNE caml_fcmp
   320                          }
   321                          
   322                          !ifdef caml_AUX__caml_compare_identity_setV2 {
   323                          caml_compare_identity_setV2
   324                                  ;; check if ACCU == SP[0] (physical identity)
   325                                  ;; yes: return Z = 1
   326                                  ;; no:  return Z = 0, .V2 = SP[0]
   327                                  LDA (SP),Y
   328                                  TAX
   329                                  INY
   330                                  LDA (SP),Y
   331                                  DEY
   332                                  CPX .V1
   333                                  BNE +
   334                                  CMP .V1 + 1
   335                                  BNE +
   336                                  RTS
   337                          +       STX .V2
   338                                  STA .V2 + 1
   339                                  RTS
   340                          }
   341                          
   342                          !ifdef caml_AUX__caml_compare_val {
   343                          caml_compare_val
   344                                  ;; Compare values in ACCU and SP[0].
   345                                  ;; PREREQUISITE: Y <> 0 if called by caml_compare, Y = 0 otherwise.
   346                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   347                                  ;; Status byte is set according to A.
   348                                  STY .COMPARE                    ;Y <> 0 iif called by caml_compare
   349                                  LDY # 0
   350                                  LDA SP
   351                                  STA .SAVESP
   352                                  LDA SP + 1
   353                                  STA .SAVESP + 1
   354                                  LDA (SP),Y
   355                                  STA .V2
   356                                  INY
   357                                  LDA (SP),Y
   358                                  STA .V2 + 1
   359                          .loop   LDY # 0
   360                                  STY .CMP
   361                                  LDA .V1 + 1
   362                                  LDX .V1
   363                                  CPX .V2
   364                                  BEQ .eq_tst
   365                                  SBC .V2 + 1
   366                          .neq    BVC +                           ;(signed) v1<v2 iif V xor N = 1
   367                                  EOR # $80
   368                          +       BMI +
   369                                  INC .CMP                        ;v1 > v2 => CMP := 1
   370                                  BNE .int_or_block               ;bne=jmp
   371                          +       DEC .CMP                        ;v1 < v2 => CMP := -1
   372                                  BNE .int_or_block               ;bne=jmp
   373                          .eq_tst SBC .V2 + 1
   374                                  BNE .neq
   375                                  CMP .COMPARE                    ;v1==v2; called by caml_compare?
   376                                  BEQ .int_or_block               ;no: go deep, maybe raise exn :(
   377                                  JMP .next_item                  ;yes: speed up, go to next_item
   378                          .int_or_block
   379                                  TXA
   380                                  BIT caml_is_block
   381                                  BEQ .v1_block
   382                                  LDA .V2
   383                                  BIT caml_is_block
   384                                  BEQ .v1_int_v2_block
   385                                  LDA .CMP
   386                                  JMP .return_or_next
   387                          .v1_int_v2_block
   388                                  LDY # -2
   389                                  DEC .V2 + 1
   390                                  LDA (.V2),Y                     ;A := Tag(v2)
   391                                  INC .V2 + 1
   392                                  CMP # Forward_tag               ;check for special cases
   393                                  BEQ .v2_forward
   394                                  LDA # -1
   395                                  JMP .return                     ;int < block => RETURN LESS
   396                          .v2_forward
   397                                  LDY # 1
   398                                  LDA (.V2),Y                     ;v2 := Field(v2,0)
   399                                  TAX
   400                                  DEY
   401                                  LDA (.V2),Y
   402                                  STX .V2 + 1
   403                                  STA .V2
   404                                  JMP .loop                       ;continue
   405                          .v1_block
   406                                  LDA .V2
   407                                  BIT caml_is_block
   408                                  BEQ .v1_block_v2_block
   409                                  LDY # -2                        ;v1:block, v2:int
   410                                  DEC .V1 + 1
   411                                  LDA (.V1),Y                     ;A := Tag(v1)
   412                                  INC .V1 + 1
   413                                  CMP # Forward_tag               ;check for special cases
   414                                  BEQ .v1_forward
   415                                  LDA # 1
   416                                  JMP .return                     ;block > int => RETURN GREATER
   417                          .v1_forward
   418                                  LDY # 1
   419                                  LDA (.V1),Y                     ;v1 := Field(v1,0)
   420                                  TAX
   421                                  DEY
   422                                  LDA (.V1),Y
   423                                  STX .V1 + 1
   424                                  STA .V1
   425                                  JMP .loop                       ;continue
   426                          .v1_block_v2_block
   427                                  LDY # -2
   428                                  DEC .V1 + 1
   429                                  DEC .V2 + 1
   430                                  LDA (.V2),Y
   431                                  TAX                             ;X := Tag_v2
   432                                  LDA (.V1),Y                     ;A := Tag_v1
   433                                  INC .V1 + 1
   434                                  INC .V2 + 1
   435                                  CMP # Forward_tag
   436                                  BEQ .v1_forward                 ;jump if Tag_v1=Forward_tag
   437                                  CPX # Forward_tag
   438                                  BNE +
   439                                  JMP .v2_forward                 ;jump if Tag_v2=Forward_tag
   440                          +       STX .CMP
   441                                  SEC
   442                                  SBC .CMP                        ;C = (Tag_v1 >= Tag_v2): UNSIGNED
   443                                  BEQ .switch_on_tag              ;Tag_v1=Tag_v2 =>choose routine
   444                                  LDA # -1                        ;LDA doesn't alter C
   445                                  BCC +                           ;Tag_v1 < Tag_v2 => RETURN LESS
   446                                  LDA # 1                         ;Tag_v1 > Tag_v2 => RETURN GREATER
   447                          +       JMP .return
   448                          .switch_on_tag
   449                                  CPX # Closure_tag
   450                                  BCC .default
   451                                  LDA .brtbl - Closure_tag,X      ;Switch on tag: load the branch offset
   452                                  STA .brtbl - 1                  ; and save it as the argument of BNE.
   453                                  BNE *                           ;SMC; branch always taken.
   454                          .brtbl  !for .t in [.tcl,.tob,.tcl,.tfw,.tab,.tst,.tdb,.tar,.tcu] {
   455                                    !byte .t - .brtbl             ;Offsets for the BNE above.
   456                                  }
   457                          .tcl    JMP .err_fun                    ;(the code is out of line: the offsets
   458                                                                  ; in .brtbl must be < 128)
   459                          .tob    JSR caml_compare_val_object_tag
   460                                  JMP .return_or_next
   461                          .tab    JMP .err_abs
   462                          .tst    JSR caml_compare_val_string_tag
   463                                  JMP .return_or_next
   464                          .tdb    JSR caml_compare_val_double_tag
   465                                  JMP .return_or_next
   466                          .tar    JSR caml_compare_val_double_array_tag
   467                                  JMP .return_or_next
   468                          .tcu    JSR caml_compare_val_custom_tag
   469                                  JMP .return_or_next
   470                          .tfw
   471                          .default
   472                                  ;; compare sizes first
   473                                  LDY # -1
   474                                  DEC .V1 + 1
   475                                  DEC .V2 + 1
   476                                  LDA (.V1),Y                     ;A := size(v1)
   477                                  TAX                             ;save it
   478                                  SEC
   479                                  SBC (.V2),Y                     ;C = (size(v1) >= size(v2)): UNSIGNED
   480                                  BEQ .samesz
   481                                  LDA # -1                        ;LDA doesn't alter C
   482                                  BCC .retsz                      ;size(v1) < size(v2) => LESS
   483                                  LDA # 1                         ;size(v1) > size(v2) => GREATER
   484                          .retsz  JMP .return
   485                          .samesz TXA                             ;reload size(v1)
   486                                  BEQ .next_item                  ;v1, v2 atoms ==> next_item
   487                                  INC .V1 + 1
   488                                  INC .V2 + 1
   489                                  DEX                             ;only one field?
   490                                  BEQ .field0                     ;yes:compare Fld(v1,0) Fld(v2,0)
   491                                  +caml_grow_stack 3              ;no: save data on stack:
   492                                  LDY # 0
   493                                  CLC
   494                                  LDA .V1
   495                                  ADC # 2
   496                                  STA (SP),Y
   497                                  INY
   498                                  LDA .V1 + 1
   499                                  ADC # 0
   500                                  STA (SP),Y                      ;address of Field(v1,1) in SP[0]
   501                                  INY
   502                                  CLC
   503                                  LDA .V2
   504                                  ADC # 2
   505                                  STA (SP),Y
   506                                  INY
   507                                  LDA .V2 + 1
   508                                  ADC # 0
   509                                  STA (SP),Y                      ;address of Field(v2,1) in SP[1]
   510                                  INY
   511                                  DEX                             ;# of following fields in SP[2]
   512                                  TXA
   513                                  STA (SP),Y
   514                          .field0 LDY # 0
   515                                  LDA (.V1),Y                     ;get <Field(v1,0)
   516                                  TAX                             ;save it
   517                                  LDA (.V2),Y                     ;get <Field(v2,0)
   518                                  STA .CMP                        ;save it
   519                                  INY
   520                                  LDA (.V1),Y                     ;get >Field(v1,0)
   521                                  STA .V1 + 1                     ;.V1 + 1 :=  >Field(v1,0)
   522                                  LDA (.V2),Y                     ;get >Field(v2,0)
   523                                  STA .V2 + 1                     ;.V2 + 1  := >Field(v2,0)
   524                                  STX .V1                         ;.V1 := Field(v1,0)
   525                                  LDA .CMP
   526                                  STA .V2                         ;.V2 := Field(v2,0)
   527                                  JMP .loop                       ;continue comparison on v1, v2
   528                          .return_or_next
   529                                  ORA # 0                         ;set status byte according to A
   530                                  BEQ .next_item                  ;if A=0 then compare nexts
   531                          .return LDX .SAVESP                     ;else
   532                                  STX SP                          ; restore SP
   533                                  LDX .SAVESP + 1
   534                                  STX SP + 1
   535                                  LDY # 0
   536                                  ORA # 0                         ; set status byte according to A
   537                                  RTS                             ; exit
   538                          .next_item
   539                                  LDA SP                          ;if SP = .SAVESP
   540                                  CMP .SAVESP
   541                                  BNE +
   542                                  LDA SP + 1
   543                                  CMP .SAVESP + 1
   544                                  BNE +
   545                                  LDA # 0                         ;then RETURN EQUAL
   546                                  BEQ .return                     ;BEQ=JMP
   547                          +       LDY # 0                         ;else get next item from stack:
   548                                  LDA (SP),Y                      ;V1 := SP[0] (lo byte)
   549                                  STA .V1
   550                                  CLC
   551                                  ADC # 2
   552                                  STA (SP),Y                      ;SP[0] := &next field (lo byte)
   553                                  INY
   554                                  LDA (SP),Y                      ;as above, hi byte
   555                                  STA .V1 + 1
   556                                  ADC # 0
   557                                  STA (SP),Y
   558                                  INY
   559                                  LDA (SP),Y                      ;V2 := SP[1] (lo byte)
   560                                  STA .V2
   561                                  CLC
   562                                  ADC # 2
   563                                  STA (SP),Y                      ;SP[1] := &next field (lo byte)
   564                                  INY
   565                                  LDA (SP),Y                      ;as above, hi byte
   566                                  STA .V2 + 1
   567                                  ADC # 0
   568                                  STA (SP),Y
   569                                  INY
   570                                  LDA (SP),Y                      ;counter = # of fields following
   571                                  BEQ .pop                        ; the one we are going to compare
   572                                  SEC                             ;counter <> 0: there are more fields
   573                                  SBC # 1                         ; => decrement the counter,
   574                                  STA (SP),Y                      ; and keep the 3 words on the stack
   575                                  BCS +                           ;BCS=JMP (A >= 1, so no borrow)
   576                          .pop    CLC                             ;counter = 0: last field
   577                                  LDA # 6                         ; => pop the 3 words from the stack
   578                                  ADC SP
   579                                  STA SP
   580                                  BCC +
   581                                  INC SP + 1
   582                          +       LDY # 1                         ;get curr. Fld(v1,x), Fld(v2,x)
   583                                  LDA (.V1),Y
   584                                  TAX
   585                                  LDA (.V2),Y
   586                                  STA .CMP
   587                                  DEY
   588                                  LDA (.V1),Y
   589                                  STA .V1
   590                                  STX .V1 + 1
   591                                  LDA (.V2),Y
   592                                  STA .V2
   593                                  LDA .CMP
   594                                  STA .V2 + 1
   595                                  JMP .loop                       ;continue loop
   596                          .err_fun +caml_raise Invalid_argument, "compare: functional value"
   597                          .err_abs +caml_raise Invalid_argument, "compare: abstract value"
   598                          !if .tfw - .brtbl > 127 {
   599                                  !error "caml_compare_val: branch table offset too large"
   600                          }
   601                          }
   602                          
   603                          !ifdef caml_AUX__caml_compare_val_double_tag {
   604                          caml_compare_val_double_tag
   605                                  ;; Compare floats in ACCU (.V1) and .V2.
   606                                  ;; Result: A = -1/0/1 according to the OCaml semantics of compare.
   607                                  ;; Status byte is set according to A.
   608                                  ;; .COMPARE <> 0: total ordering, nan < -inf < finite numbers < +inf and
   609                                  ;;                nan = nan, else nan is unordered: A = 2 if a nan
   610                                  ;;                is involved.
   611                                  LDY # Float_flag
   612                                  LDA (.V1),Y                     ;flag bytes of both floats: if any is
   613                                  TAX                             ; not 0, a float is inf or nan
   614                                  ORA (.V2),Y
   615                                  BNE @spec
   616                                  JSR caml_float_unop             ;copy .V1 to FAC
   617                           !ifdef caml_basic_rom_overlap {
   618                                  LDY # 4                         ;FCOMP reads its memory operand with the
   619                          -       LDA (.V2),Y                     ; BASIC ROM on, but the float may be in
   620                                  STA TMP + 8,Y                   ; the RAM under it ($A000-$BFFF): copy
   621                                  DEY                             ; it to the zero page and compare
   622                                  BPL -                           ; with the copy.
   623                                  LDA # TMP + 8
   624                                  LDY # 0
   625                           } else {
   626                                  LDY .V2 + 1
   627                                  LDA .V2
   628                           }
   629                                  +caml_JSR_BASROM C64_FCOMP
   630                                  LDY # 0
   631                                  ORA # 0                         ;set status byte according to A
   632                                  RTS
   633                          @spec   LDA .COMPARE                    ;.X = flag of v1, .Y = Float_flag
   634                                  BNE @key
   635                                  CPX # Fl_nan                    ;partial ordering:
   636                                  BEQ @unord                      ; v1 is nan,
   637                                  LDA (.V2),Y
   638                                  CMP # Fl_nan
   639                                  BNE @key
   640                          @unord  LDA # 2                         ; or v2 is nan: unordered
   641                                  BNE @ret                        ;BNE=JMP
   642                          @key    LDA (.V2),Y                     ;flags are signed keys: nan = -128,
   643                                  EOR # $80                       ; -inf = -1, finite = 0, +inf = 1.
   644                                  STA .CMP                        ;Compare them as unsigned, after
   645                                  TXA                             ; inverting bit 7.
   646                                  EOR # $80
   647                                  CMP .CMP
   648                                  BCC @lt
   649                                  BNE @gt
   650                                  LDA # 0                         ;(equal)
   651                                  BEQ @ret                        ;BEQ=JMP
   652                          @gt     LDA # 1
   653                                  BNE @ret                        ;BNE=JMP
   654                          @lt     LDA # -1
   655                          @ret    LDY # 0
   656                                  ORA # 0                         ;set status byte according to A
   657                                  RTS
   658                          }
   659                          
   660                          !ifdef caml_AUX__caml_compare_val_string_tag {
   661                          caml_compare_val_string_tag
   662                                  ;; Compare strings in ACCU and SP[0].
   663                                  ;; Result: A -1/0/1 according to the OCaml semantics of compare.
   664                                  ;; Status byte is set according to A.
   665                                  LDY # -1
   666                                  DEC .V1 + 1
   667                                  DEC .V2 + 1
   668                                  LDA (.V1),Y
   669                                  TAX
   670                                  SEC
   671                                  SBC (.V2),Y                     ;C = (size(v1) >= size(v2)): UNSIGNED
   672                                  BEQ @eqsz
   673                                  LDA # -1                        ;LDA doesn't alter C
   674                                  BCC @setcmp                     ;v1 shorter: CMP = -1, X = size(v1)
   675                                  LDA (.V2),Y
   676                                  TAX                             ;v1 longer: X := size(v2)
   677                                  LDA # 1                         ; CMP = 1 (this LDA sets Z = 0)
   678                                  BNE @setcmp                     ;BNE=JMP
   679                          @eqsz   LDA # 0                         ;same size: CMP = 0
   680                          @setcmp STA .CMP                        ;CMP = sign(size(v1) - size(v2))
   681                                  INY                             ;Y := 0
   682                          --      INC .V1 + 1                     ;for Y := 0 to X - 1 {
   683                                  INC .V2 + 1                     ;  compare char by char:
   684                          -       DEX
   685                                  BEQ @last
   686                                  LDA (.V1),Y                     ;  1st byte
   687                                  CMP (.V2),Y
   688                                  BCC @lt : BNE @gt
   689                                  INY
   690                                  LDA (.V1),Y                     ;  2nd byte
   691                                  CMP (.V2),Y
   692                                  BCC @lt : BNE @gt
   693                                  INY
   694                                  BNE -
   695                                  BEQ --                          ;}
   696                          @last   LDA (.V1),Y                     ;last word, 1st char
   697                                  CMP (.V2),Y
   698                                  BCC @lt : BNE @gt
   699                                  LDA .CMP                        ;(sub)strings are equal, check CMP =
   700                                  BMI @lt : BNE @gt               ; size(v1)-size(v2):
   701                                  INY                             ;CMP = 0, adjust result according to
   702                                  CLC                             ; string paddings:
   703                                  ADC (.V2),Y                     ; len_v1 - len_v2 = -pad_v1 + pad_v2
   704                                  SEC
   705                                  SBC (.V1),Y
   706                                  BCC @lt : BNE @gt
   707                                  LDY # 0 : TYA      : RTS
   708                          @lt     LDY # 0 : LDA # -1 : RTS
   709                          @gt     LDY # 0 : LDA # 1  : RTS
   710                          }
   711                          
   712                                  ;; Custom blocks: Field(v,0) points to the custom operations, a table
   713                                  ;; whose first word is the address of the compare primitive.
   714                                  ;; BreadCaml has no compare_ext: int vs custom is decided by
   715                                  ;; caml_compare_val (int < block), as in OCaml when compare_ext = NULL.
   716                          !ifdef caml_AUX__caml_compare_val_custom_tag {
   717                          caml_compare_val_custom_tag
   718                                  ;; Compare custom blocks in .V1 (ACCU) and .V2, by calling the
   719                                  ;; compare primitive of v1: ACCU = v1, SP[0] = v2, ACCU := Val_int(-1/0/1).
   720                                  ;; Result: A = -1/0/1 according to the OCaml semantics of compare.
   721                                  ;; Status byte is set according to A. Clobbers .V2.
   722                                  +caml_grow_stack 1              ;push v2: SP[0] := v2 (popped below)
   723                                  LDY # 1
   724                                  LDA .V2 + 1
   725                                  STA (SP),Y
   726                                  DEY
   727                                  LDA .V2
   728                                  STA (SP),Y
   729                                  LDA (.V1),Y                     ;.V2 := Field(v1,0) = custom ops
   730                                  STA .V2
   731                                  INY
   732                                  LDA (.V1),Y
   733                                  STA .V2 + 1
   734                                  LDA (.V2),Y                     ;Y = 1: hi byte of the compare routine
   735                                  STA @jsr + 2
   736                                  DEY
   737                                  LDA (.V2),Y                     ;lo byte
   738                                  STA @jsr + 1
   739                          @jsr    JSR .dummy                      ;SMC: ACCU := Val_int(compare(v1, v2))
   740                                  CLC
   741                                  LDA SP                          ;pop v2
   742                                  ADC # 2
   743                                  STA SP
   744                                  BCC +
   745                                  INC SP + 1
   746                          +       LDY # 0
   747                                  LDA ACCU + 1                    ;Val_int(-1) = $FFFF: A = $FF, N = 1
   748                                  BNE +
   749                                  LDA ACCU                        ;Val_int(0) = 1, Val_int(1) = 3
   750                                  LSR                             ; => A = 0 or 1, status set by LSR
   751                          +       RTS
   752                          }
   753                          
   754                          !ifdef caml_AUX__caml_compare_val_double_array_tag {
   755                          caml_compare_val_double_array_tag
   756                                  ;; Compare floatarrays in .V1 (ACCU) and .V2: first the sizes (as in
   757                                  ;; OCaml; size = 3 words per element, so comparing words is the same
   758                                  ;; as comparing lengths), then element by element.
   759                                  ;; Result: A = -1/0/1 according to the OCaml semantics of compare.
   760                                  ;; Status byte is set according to A. Clobbers .V1, .V2, .CMP.
   761                                  ;; (C64 floats have no NaN: there is no unordered case.)
   762                                  LDY # -1
   763                                  DEC .V1 + 1
   764                                  DEC .V2 + 1
   765                                  LDA (.V1),Y                     ;A := size(v1)
   766                                  TAX
   767                                  SEC
   768                                  SBC (.V2),Y                     ;C = (size(v1) >= size(v2)): UNSIGNED
   769                                  BEQ @same
   770                                  LDA # -1                        ;LDA doesn't alter C
   771                                  BCC +
   772                                  LDA # 1
   773                          +       LDY # 0
   774                                  ORA # 0                         ;set status byte according to A
   775                                  RTS
   776                          @same   INC .V1 + 1
   777                                  INC .V2 + 1
   778                                  STX .CMP                        ;.CMP := words left = 3 * elements left
   779                                  TXA
   780                                  BEQ @eq                         ;(cannot happen: empty array is an atom)
   781                          @elem   JSR caml_compare_val_double_tag ;compare the floats at .V1 and .V2
   782                                  BNE @ret                        ;different: return -1 or 1
   783                                  LDA .V1                         ;next element: both pointers += 6
   784                                  CLC
   785                                  ADC # 2 * Double_wosize
   786                                  STA .V1
   787                                  BCC +
   788                                  INC .V1 + 1
   789                          +       LDA .V2
   790                                  CLC
   791                                  ADC # 2 * Double_wosize
   792                                  STA .V2
   793                                  BCC +
   794                                  INC .V2 + 1
   795                          +       LDA .CMP
   796                                  SEC
   797                                  SBC # Double_wosize
   798                                  STA .CMP
   799                                  BNE @elem
   800                          @eq     LDY # 0
   801                                  TYA                             ;A = 0: equal
   802                          @ret    RTS
   803                          }
   804                          
   805                          !ifdef caml_AUX__caml_compare_val_object_tag {
   806                          caml_compare_val_object_tag
   807                                  ;; Compare objects (in BreadCaml: exceptions) in .V1 (ACCU) and .V2
   808                                  ;; by their oid = Field(v,1), a (signed) tagged integer, as in OCaml.
   809                                  ;; Result: A = -1/0/1; equal oids => A = 0 (the caller goes on with
   810                                  ;; the next item). Status byte is set according to A.
   811                                  LDY # 3
   812                                  LDA (.V1),Y                     ;oid, hi byte: signed comparison
   813                                  SEC
   814                                  SBC (.V2),Y
   815                                  BVC +
   816                                  BPL @lt                         ;overflow: sign is inverted
   817                                  BMI @gt
   818                          +       BMI @lt
   819                                  BNE @gt
   820                                  DEY
   821                                  LDA (.V1),Y                     ;oid, lo byte: unsigned comparison
   822                                  CMP (.V2),Y
   823                                  BCC @lt
   824                                  BNE @gt
   825                                  LDY # 0
   826                                  TYA                             ;A = 0: equal
   827                                  RTS
   828                          @lt     LDY # 0
   829                                  LDA # -1
   830                                  RTS
   831                          @gt     LDY # 0
   832                                  LDA # 1
   833                                  RTS
   834                          }
   835                          
   836                          !ifdef caml_AUX__caml_string_eq_neq {  ;caml_compare_val_string_tag is
   837                          caml_string_eq_neq                      ; slower for equality tests
   838                                  LDY # -1
   839                                  DEC .V1 + 1
   840                                  DEC .V2 + 1
   841                                  LDA (.V1),Y
   842                                  CMP (.V2),Y
   843                                  BNE @neq
   844                                  TAX
   845                                  INY                             ;Y := 0
   846                          --      INC .V1 + 1                     ;loop:
   847                                  INC .V2 + 1                     ; compare strings chr by chr
   848                          -       DEX
   849                                  BEQ +
   850                                  LDA (.V1),Y                     ;1st byte
   851                                  CMP (.V2),Y
   852                                  BNE @neq
   853                                  INY
   854                                  LDA (.V1),Y                     ;2nd byte
   855                                  CMP (.V2),Y
   856                                  BNE @neq
   857                                  INY
   858                                  BEQ --
   859                                  BNE -
   860                          +       LDA (.V1),Y                     ;last word, 1st char
   861                                  CMP (.V2),Y
   862                                  BNE @neq
   863                                  LDY # 0
   864                                  TYA
   865                                  RTS
   866                          @neq    LDY # 0
   867                                  LDA # -1
   868                                  RTS
   869                          }
   870                          
   871                          }       ;; !zone caml_COMPARISONS
   872                          

