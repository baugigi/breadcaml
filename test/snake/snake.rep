   270                          !ifdef caml_PRIM__caml_nonstd_string_of_float {
   271                          caml_nonstd_string_of_float
   272                                  ;; Stdlib.string_of_float
   273                                  LDA ACCU
   274                                  LDX ACCU + 1
   275                                  STA caml_float_loadFAC__addr
   276                                  STX caml_float_loadFAC__addr + 1
   277                                  JSR caml_float_loadFAC          ;.A = flag byte
   278                                  BEQ @fin
   279                                  LDX # 0                         ;Special value: copy "-inf", "inf" or
   280                                  CMP # Fl_ninf                   ; "nan" to $0100 instead of calling
   281                                  BEQ @cp                         ; FOUT.
   282                                  INX
   283                                  CMP # Fl_pinf
   284                                  BEQ @cp
   285                                  LDX # @nan - @strs
   286                          @cp     LDY # 0
   287                          -       LDA @strs,X
   288                                  STA $0100,Y
   289                                  BEQ @len                        ;(copy the final 0 too)
   290                                  INX
   291                                  INY
   292                                  BNE -                           ;BNE=JMP
   293                          @fin    LDA $47                         ;WARNING: FOUT OVERWRITES $47
   294                                  PHA                             ;save it
   295                                  +caml_JSR_BASROM C64_FOUT       ;0-terminated string in $0100
   296                                  PLA                             ;restore $47 value
   297                                  STA $47
   298                          @len    JMP caml_string_from_0100
   299                          @strs   !text "-inf", 0                 ;"inf" is @strs + 1
   300                          @nan    !text "nan", 0
   301                          }
   302                          
   303                          !ifdef caml_PRIM__caml_nonstd_string_of_int {
   304                          caml_nonstd_string_of_int
   305                                  ;; Stdlib.string_of_int
   306                                  ;; Convert an int to string, using the C64 format: first char for sign
   307                                  ;; (space if positive, minus if negative), followed by 5 digit max and
   308                                  ;; no non-significative zeroes.
   309                          @DGT    = TMP
   310                          @SKIPZ  = TMP + 1
   311  57bb a9fc                       LDA # String_tag                ;Max len is 4 words:
   312  57bd a204                       LDX # 4                         ;|'-','1'|'6','3'|'8','3'|\0,\1|
   313  57bf 20b750                     JSR caml_alloc                  ;Allocate string, addr in BLK
   314  57c2 a920                       LDA # ' '                       ;Positive numbers start with ' '
   315  57c4 24fc                       BIT ACCU + 1
   316  57c6 100e                       BPL +
   317  57c8 38                         SEC                             ;If value is negative,
   318  57c9 a902                       LDA # 2                         ; negate it
   319  57cb e5fb                       SBC ACCU
   320  57cd 85fb                       STA ACCU
   321  57cf 98                         TYA
   322  57d0 e5fc                       SBC ACCU + 1
   323  57d2 85fc                       STA ACCU + 1
   324  57d4 a92d                       LDA # '-'                       ; and put a '-' into the string
   325  57d6 914b               +       STA (BLK),Y
   326  57d8 c8                         INY
   327  57d9 46fc                       LSR ACCU + 1                    ;Get rid of trailing 1
   328  57db 66fb                       ROR ACCU
   329  57dd a930                       LDA # '0'                       ;Set SKIPZ flag to '0' (=ignore
   330  57df 854e                       STA @SKIPZ                      ; all initial zeroes)
   331  57e1 a203                       LDX # 3                         ;For X := 3 downto 0
   332  57e3 854d               --      STA @DGT                        ; Init DGT to '0'
   333  57e5 a5fb                       LDA ACCU                        ; Loop for calculating DGT:
   334  57e7 38                         SEC
   335  57e8 fd2958             -       SBC @lo10,X                     ;  Subtract 10^(X+1) from ACCU
   336  57eb 48                         PHA
   337  57ec a5fc                       LDA ACCU + 1
   338  57ee fd2d58                     SBC @hi10,X
   339  57f1 9009                       BCC +                           ; Exit loop on negative result
   340  57f3 85fc                       STA ACCU + 1                    ;  Store result in ACCU
   341  57f5 68                         PLA
   342  57f6 85fb                       STA ACCU
   343  57f8 e64d                       INC @DGT                        ;  Set DGT to next char digit
   344  57fa b0ec                       BCS -                           ; BCS=JMP, Continue loop
   345  57fc 68                 +       PLA
   346  57fd a54d                       LDA @DGT
   347  57ff c54e                       CMP @SKIPZ                      ; If DGT='0' & SKIPZ='0'
   348  5801 f007                       BEQ +                           ; then ignore current digit
   349  5803 c64e                       DEC @SKIPZ                      ; else stop skipping zeroes,
   350  5805 914b                       STA (BLK),Y                     ;  put DGT into the string,
   351  5807 c8                         INY
   352  5808 a930                       LDA # '0'                       ;  set A='0' for next iteration.
   353  580a ca                 +       DEX                             ; Decrement counter
   354  580b 10d6                       BPL --                          ;End_For
   355  580d 05fb                       ORA ACCU                        ;A := '0'|ACCU  (last digit)
   356  580f 914b                       STA (BLK),Y
   357  5811 c8                         INY
   358  5812 a900                       LDA # 0                         ;Pad string with \0
   359  5814 914b                       STA (BLK),Y
   360  5816 c8                         INY
   361  5817 98                         TYA
   362  5818 4a                         LSR                             ;Compute block size (in wo.)
   363  5819 aa                         TAX
   364  581a 9005                       BCC +
   365  581c a901                       LDA # 1                         ;Add \1 pad if necessary
   366  581e 914b                       STA (BLK),Y
   367  5820 e8                         INX                             ;size +1 for \0\1
   368  5821 a000               +       LDY # 0
   369  5823 202553                     JSR caml_shrink_latest_alloc    ;Shrink block to computed size
   370  5826 4c1353                     JMP caml_load_newblk   
   371  5829 0a64e810           @lo10   !byte <10, <100, <1000, <10000
   372  582d 00000327           @hi10   !byte >10, >100, >1000, >10000
   373                          }
   374                          
   375                                  ;;
   376                                  ;; AUX
   377                                  ;;
   378                          
   379                          !ifdef caml_AUX__caml_string_from_0100 {
   380                          caml_string_from_0100
   381                                  ;; Make a string with the characters at $0100, ended by a 0 (255 at
   382                                  ;; most): ACCU := the new string.
   383                                  LDX # $FF
   384                          -       INX                             ;count string length (except 0)
   385                                  LDA $0100,X
   386                                  BNE -                           ;(X = length when loop ends)
   387                                  LDA # 1                         ;add a final 1 for padding; it
   388                                  STA $0101,X                     ;won't be copied if len is odd
   389                                  TXA                             ;A := length
   390                                  LSR
   391                                  TAX                             ;X := length / 2
   392                                  INX                             ;X := length/2+1=blk size (wo.)
   393                                  LDA # String_tag
   394                                  LDY # 0
   395                                  JSR caml_alloc                  ;allocate the new block
   396                                  JSR caml_load_newblk            ;ACCU := new string
   397                                  TXA
   398                                  ASL
   399                                  TAY                             ;Y := 2 * size
   400                                  DEY
   401                          -       LDA $0100,Y                     ;copy string and 0/01 padding
   402                                  STA (BLK),Y                     ;to the new block
   403                                  DEY
   404                                  BNE -
   405                                  LDA $0100
   406                                  STA (BLK),Y
   407                                  RTS
   408                          }
   409                          
   410                          !ifdef caml_AUX__caml_string_index_y {
   411                          caml_string_index_y
   412                                  ;; given a string in ACCU, read index from SP[0], then
   413                                  ;; set Y and ACCU+1 so that ACCU+Y = &string[index];
   414                                  ;; raise Invalid_argument if not 0<=index<length(string).
   415  5831 a001                       LDY # 1
   416  5833 b1fd                       LDA (SP),Y                      ;get ARGh
   417  5835 4a                         LSR                             ;Int_val(ARGh)
   418  5836 854e                       STA TMP + 1                     ;save
   419  5838 88                         DEY
   420  5839 b1fd                       LDA (SP),Y                      ;get ARGl
   421  583b 6a                         ROR                             ;Int_val(ARGl)
   422  583c 854d                       STA TMP                         ;save
   423  583e 205958                     JSR caml_string_length_yx       ;get string length in .Y.X
   424  5841 e44e                       CPX TMP + 1                     ;compare hi bytes
   425  5843 9011                       BCC ++                          ;.X < ARGh: error
   426  5845 d006                       BNE +                           ;.X > ARGh: ok
   427  5847 c44d                       CPY TMP                         ;.X = ARGh: compare lo byte
   428  5849 900b                       BCC ++                          ;.Y < ARGl: error
   429  584b f009                       BEQ ++                          ;.Y = ARGl: error
   430  584d a44d               +       LDY TMP                         ;reload index, lo
   431  584f a54e                       LDA TMP + 1
   432  5851 f002                       BEQ +
   433  5853 e6fc                       INC ACCU + 1                    ;inc ACCUh if needed
   434  5855 60                 +       RTS
   435  5856 4c2355             ++      JMP caml_err_index_oob
   436                          }
   437                          
   438                          !ifdef caml_AUX__caml_string_length_yx {
   439                          caml_string_length_yx
   440                                  ;; ACCU = string
   441                                  ;; return the string length in .Y,.X (int16, lo-hi)
   442  5859 a5fc                       LDA ACCU + 1
   443  585b 48                         PHA                             ;save ACCU + 1
   444  585c 88                         DEY                             ;LDY # -1
   445  585d c6fc                       DEC ACCU + 1
   446  585f b1fb                       LDA (ACCU),Y                    ;.A := size
   447  5861 e6fc                       INC ACCU + 1
   448  5863 a200                       LDX # 0
   449  5865 0a                         ASL
   450  5866 a8                         TAY                             ;.Y := <(2 * size)
   451  5867 9008                       BCC @minus1
   452  5869 d003                       BNE +
   453  586b 88                         DEY                             ;shortcut when .Y=256
   454  586c d00b                       BNE @pad                        ;bne=jmp
   455  586e e6fc               +       INC ACCU + 1
   456  5870 e8                         INX                             ;.X := >(2 * size)
   457  5871 88                 @minus1 DEY                             ;.Y := <(2 * size - 1)
   458  5872 c0ff                       CPY # $FF
   459  5874 d003                       BNE @pad
   460  5876 c6fc                       DEC ACCU + 1
   461  5878 ca                         DEX                             ;.X := >(2 * size - 1)
   462  5879 b1fb               @pad    LDA (ACCU),Y                    ;.A := padding byte
   463  587b f006                       BEQ +
   464  587d 88                         DEY                             ;.Y := <(2 * size -1 -pad)
   465  587e c0ff                       CPY # $FF
   466  5880 d001                       BNE +
   467  5882 ca                         DEX                             ;.X := >(2 * size -1 -pad)
   468  5883 68                 +       PLA
   469  5884 85fc                       STA ACCU + 1                    ;restore ACCU+1
   470  5886 60                         RTS
   471                          }
   472                          
   473                          }      ;; !zone caml_STRINGS
