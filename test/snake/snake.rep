  1125                          ;; ---- virtual window primitives --------------------------------------------------
  1126                          
  1127                          !ifdef caml_PRIM__caml_nonstd_gfx_window {
  1128                          caml_nonstd_gfx_window
  1129                                  ;; Gfx.window x0 y0 x1 y1: (x0,y0) -> (0,0), (x1,y1) -> (width-1, 199)
  1130                                  +caml_gfx_arg_acc caml_gfx_X1
  1131                                  +caml_gfx_arg_sp 0, caml_gfx_Y1
  1132                                  +caml_gfx_arg_sp 1, caml_gfx_X2
  1133                                  +caml_gfx_arg_sp 2, caml_gfx_Y2
  1134                                  LDX # 0
  1135                                  LDY # 0
  1136                                  JSR caml_gfx_winaxis
  1137                                  LDX # 2
  1138                                  LDY # 1
  1139                                  JSR caml_gfx_winaxis
  1140                                  LDA # 1
  1141                                  STA caml_gfx_data__win
  1142                                  LDY # 0
  1143                                  +caml_gfx_ret_unit
  1144                                  RTS
  1145                          }
