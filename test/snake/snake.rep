   701                          }
   702                          
   703                          !ifdef caml_PRIM__caml_div_float {
   704                          caml_div_float
   705                                  JSR caml_float_binop
   706                                  BCC @fin
   707                                  LDX # Fb_DIV
   708                                  JMP caml_float_special2
   709                          @fin    BEQ @dz                         ;FAC exponent = 0: division by zero
   710                                  LDX # Fo_MUL                    ;(overflow: +-infinity)
   711                                  STX caml_float_overflow__op
   712                                  +caml_JSR_BASROM C64_FDIVT
   713                                  JMP caml_float_alloc_result
   714                          @dz     LDA C64_ARG                     ;x / 0.0: nan if x = 0.0, else
   715                                  BEQ @nan                        ; +-infinity with the sign of x
   716                                  LDA C64_ARG + 5
   717                                  BPL @pinf
   718                                  LDA # Ft_NINF
   719                                  BNE @tpl                        ;BNE=JMP
   720                          @pinf   LDA # Ft_PINF
   721                                  BNE @tpl                        ;BNE=JMP
   722                          @nan    LDA # Ft_NAN
   723                          @tpl    JMP caml_float_ret_tpl
   724                          }
   725                          
   726                          !ifdef caml_PRIM__caml_power_float {
   727                          caml_power_float
   728                                  JSR caml_float_binop
   729                                  BCC @fin
   730                                  LDX # Fb_POW
   731                                  JMP caml_float_special2
   732                          @fin    LDA C64_ARG                     ;x = 0.0 ?
   733                                  BNE @xnz
   734                                  BIT C64_FAC + 5                 ;yes: 0.0 ** (y<0) = +infinity
   735                                  BPL @rom                        ; (other cases are managed by ROM)
   736                                  LDA # Ft_PINF
   737                                  BNE @tpl                        ;BNE=JMP
   738                          @xnz    BIT C64_ARG + 5                 ;x < 0 ?
   739                                  BPL @rom
   740                                  LDY # 0                         ;yes: (x<0) ** y is nan if y is not
   741                                  LDA (SP),Y                      ; an integer (ROM raises an error)
   742                                  STA TMP
   743                                  INY
   744                                  LDA (SP),Y
   745                                  STA TMP + 1                     ;(TMP) = y
   746                                  JSR caml_float_intclass
   747                                  TAX
   748                                  BNE @rom
   749                                  LDA # Ft_NAN
   750                          @tpl    JMP caml_float_ret_tpl
   751                          @rom    LDX # Fo_POW                    ;(overflow: +-infinity)
   752                                  STX caml_float_overflow__op
   753                                  LDA C64_FAC                     ;ROM wants .A = FAC exponent
   754                                  +caml_JSR_BASROM C64_FPWRT
   755                                  JMP caml_float_alloc_result
   756                          }
   757                          
   759                          ;; Auxiliary routines
   760                          
   761                          ;; copy ACCU to FAC. Return C=1 if ACCU is special, .A = flag byte
   762                          !ifdef caml_AUX__caml_float_unop {
   763                          caml_float_unop
   764  837a ba                         TSX                             ;Save the CPU stack pointer as it will
   765  837b e8                         INX                             ; be after returning to the primitive
   766  837c e8                         INX                             ; (see caml_float_overflow)
   767  837d 8ea784                     STX caml_float_overflow__sp
   768  8380 a9ff                       LDA # Fo_NONE
   769  8382 8da884                     STA caml_float_overflow__op     ;the primitive may change it
   770  8385 a5fb                       LDA ACCU
   771  8387 8d9883                     STA caml_float_loadFAC__addr
   772  838a a5fc                       LDA ACCU + 1
   773  838c 8d9983                     STA caml_float_loadFAC__addr + 1
   774  838f 209583                     JSR caml_float_loadFAC          ;.A = flag byte
   775  8392 c901                       CMP # 1                         ;C=1 <=> flag <> 0
   776  8394 60                         RTS
   777                          }
   778                          
   779                          ;; copy SP[0] to FAC and ACCU to ARG. Return C=1 if one of them is special,
   780                          ;; else C=0, .A = FAC exponent (and flags .Z, .N according to .A), .Y = 0
   781                          !ifdef caml_AUX__caml_float_binop {
   782                          caml_float_binop
   783                                  TSX                             ;as above
   784                                  INX
   785                                  INX
   786                                  STX caml_float_overflow__sp
   787                                  LDA # Fo_NONE
   788                                  STA caml_float_overflow__op
   789                                  LDA (SP),Y
   790                                  STA caml_float_loadFAC__addr
   791                                  INY
   792                                  LDA (SP),Y
   793                                  STA caml_float_loadFAC__addr + 1
   794                                 ;DEY                             ;caml_float_alloc_result will set Y=0
   795                                  JSR caml_float_loadFAC
   796                                  STY TMP                         ;flag byte of SP[0]
   797                                  LDA ACCU
   798                                  STA caml_float_loadARG__addr
   799                                  LDA ACCU + 1
   800                                  STA caml_float_loadARG__addr + 1
   801                                  JSR caml_float_loadARG          ;.Y = flag byte of ACCU, .A = FAC exp
   802                                  PHA
   803                                  TYA
   804                                  ORA TMP                         ;0 <=> both finite
   805                                  CMP # 1                         ;C=1 <=> at least one is special
   806                                  PLA                             ;(does not touch C)
   807                                  RTS
   808                          }
   809                          
   810                          ;; Copy FAC (operation result) to a new allocated float. Flag byte := 0
   811                          !ifdef caml_AUX__caml_float_alloc_result {
   812                          caml_float_alloc_result
   813                                  LDA # Double_tag
   814                                  LDX # Double_wosize
   815                                  LDY # 0
   816                                  JSR caml_alloc
   817                                  LDX BLK
   818                                  LDY BLK + 1
   819                                  +caml_JSR_BASROM C64_MOVMF
   820                                  LDY # Float_flag
   821                                  LDA # 0
   822                                  STA (BLK),Y                     ;finite
   823                                  TAY
   824                                  JMP caml_load_newblk   
   825                          }
   826                          
   827                          ;; FAC/ARG loading routines -- how to use: 1) write float address in
   828                          ;; caml_float_loadFAC/ARG__addr; 2) JSR caml_float_loadFAC/ARG
   829                          ;; FAC: return .A = .Y = flag byte of the float. ARG: return .Y = flag byte,
   830                          ;; .A = FAC exponent
   831                          
   832                          !ifdef caml_AUX__caml_float_loadFAC {
   833                          caml_float_loadFAC
   834  8395 a205                       LDX # 5
   835                          caml_float_loadFAC__addr = * + 1
   836  8397 bd3412             -       LDA .dummy,X                    ;SMC: replaced with real address
   837  839a 9561                       STA C64_FAC,X
   838  839c ca                         DEX
   839  839d 10f8                       BPL -
   840  839f a466                       LDY C64_FAC + 5                 ;flag byte
   841  83a1 a562                       LDA C64_FAC + 1                 ;copy 1st byte of mantissa
   842  83a3 8566                       STA C64_FAC + 5                 ;to FAC sign byte
   843  83a5 0980                       ORA # $80
   844  83a7 8562                       STA C64_FAC + 1                 ;set 1st bit of mantissa = 1
   845  83a9 e8                         INX
   846  83aa 8670                       STX C64_FACRND                  ;FAC round byte := 0
   847  83ac 98                         TYA                             ;.A = flag byte (sets .Z)
   848  83ad 60                         RTS
   849                          }
   850                          
   851                          !ifdef caml_AUX__caml_float_loadARG {
   852                          caml_float_loadARG
   853                                  LDX # 5
   854                          caml_float_loadARG__addr = * + 1
   855                          -       LDA .dummy,X                    ;SMC: replaced with real address
   856                                  STA C64_ARG,X
   857                                  DEX
   858                                  BPL -
   859                                  LDY C64_ARG + 5                 ;flag byte
   860                                  LDX C64_ARG + 1                 ;copy 1st byte of mantissa
   861                                  STX C64_ARG + 5                 ;to ARG sign byte
   862                                  TXA
   863                                  EOR C64_FAC + 5                 ;compare with FAC sign byte
   864                                  STA C64_ARISGN                  ;store result of comparison
   865                                  TXA
   866                                  ORA # $80
   867                                  STA C64_ARG + 1                 ;set 1st bit of mantissa = 1
   868                                  LDA C64_FAC                     ;.A := FAC exponent
   869                                  RTS
   870                          }
   871                          
   872                          ;; Allocate a new float, copying the template at offset .A (Ft_*) in the table
   873                          !ifdef caml_AUX__caml_float_ret_tpl {
   874                          caml_float_ret_tpl
   875  83ae 48                         PHA
   876  83af a9fd                       LDA # Double_tag
   877  83b1 a203                       LDX # Double_wosize
   878  83b3 a000                       LDY # 0
   879  83b5 20117b                     JSR caml_alloc
   880  83b8 68                         PLA
   881  83b9 aa                         TAX
   882  83ba a000                       LDY # 0
   883  83bc bdcc83             -       LDA caml_float_ret_tpl__tab,X
   884  83bf 914b                       STA (BLK),Y
   885  83c1 e8                         INX
   886  83c2 c8                         INY
   887  83c3 c006                       CPY # 6
   888  83c5 d0f5                       BNE -
   889  83c7 a000                       LDY # 0
   890  83c9 4c6b7d                     JMP caml_load_newblk
   891                          caml_float_ret_tpl__tab
   892  83cc 000000000000               !byte $00, $00, $00, $00, $00, $00      ;Ft_ZERO  0.0
   893  83d2 810000000000               !byte $81, $00, $00, $00, $00, $00      ;Ft_ONE   1.0
   894  83d8 818000000000               !byte $81, $80, $00, $00, $00, $00      ;Ft_M1   -1.0
   895  83de 81490fdaa200               !byte $81, $49, $0F, $DA, $A2, $00      ;Ft_PIH   pi/2
   896  83e4 81c90fdaa200               !byte $81, $C9, $0F, $DA, $A2, $00      ;Ft_NPIH -pi/2
   897  83ea ff7fffffff01               !byte $FF, $7F, $FF, $FF, $FF, Fl_pinf  ;Ft_PINF +infinity
   898  83f0 ffffffffffff               !byte $FF, $FF, $FF, $FF, $FF, Fl_ninf  ;Ft_NINF -infinity
   899  83f6 000000000080               !byte $00, $00, $00, $00, $00, Fl_nan   ;Ft_NAN  nan
   900                          }
   901                          
   902                          ;; Unary operation on a special float: .X = Fu_* (operation * 3), ACCU = float
   903                          ;; Result: template of the class (+inf, -inf, nan) of the operand
   904                          !ifdef caml_AUX__caml_float_special1 {
   905                          caml_float_special1
   906                                  LDY # Float_flag
   907                                  LDA (ACCU),Y
   908                                  LDY # 0
   909                                  CMP # Fl_pinf
   910                                  BEQ @cls
   911                                  INY
   912                                  CMP # Fl_ninf
   913                                  BEQ @cls
   914                                  INY
   915                          @cls    STY TMP
   916                                  TXA
   917                                  CLC
   918                                  ADC TMP
   919                                  TAX
   920                                  LDA caml_float_special1__tab,X
   921                                  JMP caml_float_ret_tpl
   922                          caml_float_special1__tab                        ;+inf    -inf    nan
   923                                  !byte Ft_NINF, Ft_PINF, Ft_NAN          ;neg
   924                                  !byte Ft_PINF, Ft_PINF, Ft_NAN          ;abs
   925                                  !byte Ft_PINF, Ft_ZERO, Ft_NAN          ;exp
   926                                  !byte Ft_PINF, Ft_M1,   Ft_NAN          ;expm1
   927                                  !byte Ft_PINF, Ft_NAN,  Ft_NAN          ;log, log1p, log10, sqrt
   928                                  !byte Ft_NAN,  Ft_NAN,  Ft_NAN          ;sin, cos, tan
   929                                  !byte Ft_PIH,  Ft_NPIH, Ft_NAN          ;atan
   930                                  !byte Ft_PINF, Ft_NINF, Ft_NAN          ;floor, ceil
   931                          }
   932                          
   933                          ;; Binary operation, at least one operand being special: .X = Fb_*,
   934                          ;; ACCU = x, SP[0] = y. Allocates the result (IEEE 754 rules).
   935                          ;; TMP,TMP+1 = pointer to y; TMP+2 = flag of x; TMP+3 = flag of y
   936                          !ifdef caml_AUX__caml_float_special2 {
   937                          caml_float_special2
   938                                  LDY # 0
   939                                  LDA (SP),Y
   940                                  STA TMP
   941                                  INY
   942                                  LDA (SP),Y
   943                                  STA TMP + 1
   944                                  LDY # Float_flag
   945                                  LDA (TMP),Y
   946                                  STA TMP + 3
   947                                  LDA (ACCU),Y
   948                                  STA TMP + 2
   949                                  CPX # Fb_MUL
   950                                  BCS @n2
   951                                  CPX # Fb_SUB
   952                                  BNE @add
   953                                  LDA # 0                         ;x - y = x + (-y)
   954                                  SEC
   955                                  SBC TMP + 3                     ;(negates the flag: swaps +-inf,
   956                                  STA TMP + 3                     ; keeps 0 and nan)
   957                          @add    LDA TMP + 2                     ;fx = 0 (finite): result = fy
   958                                  BEQ @rfy
   959                                  LDA TMP + 3
   960                                  BEQ @rfx                        ;fy = 0: result = fx
   961                                  CMP TMP + 2
   962                                  BEQ @rfx                        ;fx = fy: result = fx (inf+inf, nan)
   963                                  LDA # Fl_nan                    ;else (inf-inf, inf+nan, ...): nan
   964                                  BNE @emit                       ;BNE=JMP
   965                          @rfx    LDA TMP + 2
   966                                  BNE @emit                       ;BNE=JMP
   967                          @rfy    LDA TMP + 3
   968                          @emit   LDX # Ft_PINF                   ;.A = flag: emit +inf, -inf or nan
   969                                  CMP # Fl_pinf
   970                                  BEQ @tpl
   971                                  LDX # Ft_NINF
   972                                  CMP # Fl_ninf
   973                                  BEQ @tpl
   974                                  LDX # Ft_NAN
   975                          @tpl    TXA
   976                                  JMP caml_float_ret_tpl
   977                          @n2     CPX # Fb_POW                    ;MUL, DIV, POW:
   978                                  BEQ @pow                        ;(pow: x^0=1 and 1^y=1 even if nan)
   979                                  LDA TMP + 2
   980                                  CMP # Fl_nan
   981                                  BEQ @nan
   982                                  LDA TMP + 3
   983                                  CMP # Fl_nan
   984                                  BEQ @nan
   985                                  CPX # Fb_DIV
   986                                  BEQ @div
   987                                  ;; ---- multiplication: infinity unless inf * 0
   988                                  LDA TMP + 2
   989                                  BEQ @mfx                        ;x finite, y infinite
   990                                  LDX TMP + 3
   991                                  BEQ @mfy                        ;y finite, x infinite
   992                                  EOR TMP + 3                     ;both infinite: sign = fx xor fy
   993                                  BPL @pinf
   994                                  BMI @ninf
   995                          @mfx    LDY # 0
   996                                  LDA (ACCU),Y                    ;x = 0.0 ?
   997                                  BEQ @nan
   998                                  INY
   999                                  LDA (ACCU),Y                    ;sign of x
  1000                                  EOR TMP + 3
  1001                                  BPL @pinf
  1002                                  BMI @ninf
  1003                          @mfy    LDY # 0
  1004                                  LDA (TMP),Y                     ;y = 0.0 ?
  1005                                  BEQ @nan
  1006                                  INY
  1007                                  LDA (TMP),Y                     ;sign of y
  1008                                  EOR TMP + 2
  1009                                  BPL @pinf
  1010                                  BMI @ninf
  1011                          
  1012                                  ;; ---- division
  1013                          @div    LDA TMP + 2
  1014                                  BNE @dx
  1015                                  LDA # Ft_ZERO                   ;finite / infinite = 0.0
  1016                                  BEQ @tpl2                       ;BEQ=JMP
  1017                          @dx     LDX TMP + 3
  1018                                  BNE @nan    ;inf / inf = nan
  1019                                  LDY # 0
  1020                                  LDA (TMP),Y                     ;inf / y: if y = 0.0 sign is the sign
  1021                                  BEQ @dsg                        ; of x, else sign(x) xor sign(y)
  1022                                  INY
  1023                                  LDA (TMP),Y
  1024                                  EOR TMP + 2
  1025                                  BPL @pinf
  1026                                  BMI @ninf
  1027                          @dsg    LDA TMP + 2                     ;(flag $01 or $FF)
  1028                                  BPL @pinf
  1029                                 ;BMI @ninf
  1030                          @ninf   LDA # Ft_NINF
  1031                                  BNE @tpl2
  1032                          @nan    LDA # Ft_NAN
  1033                                  BNE @tpl2
  1034                          @pinf   LDA # Ft_PINF
  1035                          @tpl2   JMP caml_float_ret_tpl
  1036                          
  1037                                  ;; ---- x ^ y
  1038                          @pow    LDA TMP + 3
  1039                                  BNE @p2
  1040                                  LDY # 0                         ;y finite (so x is special):
  1041                                  LDA (TMP),Y                     ; x ^ 0.0 = 1.0
  1042                                  BEQ @one
  1043                          @p2     LDA TMP + 2
  1044                                  BEQ @xfin
  1045                                  LDA # 1                         ;x infinite: |x| > 1
  1046                                  BNE @m
  1047                          @xfin   JSR @cmp1                       ;compare |x| with 1: $FF, 0, 1
  1048                                  BNE @m
  1049                                  LDY # 1                         ;|x| = 1: if x = +1.0 result is 1.0
  1050                                  LDA (ACCU),Y                    ; for every y (even nan)
  1051                                  BPL @one
  1052                                  LDA # 0
  1053                          @m      STA TMP + 4                     ;TMP+4 = -1, 0, 1 for |x| <, =, > 1
  1054                                  LDA TMP + 2
  1055                                  CMP # Fl_nan
  1056                                  BEQ @nan
  1057                                  LDA TMP + 3
  1058                                  CMP # Fl_nan
  1059                                  BEQ @nan
  1060                                  LDA TMP + 3
  1061                                  BEQ @yfin
  1062                                  LDA TMP + 4                     ;y = +-infinity
  1063                                  BEQ @one                        ; |x| = 1: 1.0
  1064                                  EOR TMP + 3                     ; same sign (|x|>1 and y=+inf, or
  1065                                  BPL @pinf   ;  |x|<1 and y=-inf): +inf, else 0.0
  1066                          @zero   LDA # Ft_ZERO
  1067                                  BEQ @tpl2                       ;BEQ=JMP
  1068                          @one    LDA # Ft_ONE
  1069                                  BNE @tpl2                       ;BNE=JMP
  1070                          @yfin   LDY # 1                         ;y finite, x infinite:
  1071                                  LDA (TMP),Y
  1072                                  BMI @zero                       ; y < 0: 0.0
  1073                                  LDA TMP + 2
  1074                                  CMP # Fl_pinf
  1075                                  BEQ @pinf   ; (+inf) ^ (y>0) = +inf
  1076                                  JSR caml_float_intclass         ; (-inf) ^ y: -inf if y is an odd
  1077                                  CMP # 2                         ;  integer, else +inf
  1078                                  BCS @ninf
  1079                                  BCC @pinf
  1080                          @cmp1   LDY # 0                         ;compare |ACCU| with 1.0 (finite)
  1081                                  LDA (ACCU),Y                    ; return .A=$FF if |x|<1, 0 if |x|=1,
  1082                                  CMP # $81                       ; 1 if |x|>1 (flags set by .A)
  1083                                  BCC @lt
  1084                                  BNE @gt
  1085                                  INY
  1086                                  LDA (ACCU),Y
  1087                                  AND # $7F
  1088                                  BNE @gt
  1089                          -       INY
  1090                                  LDA (ACCU),Y
  1091                                  BNE @gt
  1092                                  CPY # 4
  1093                                  BCC -
  1094                                  LDA # 0
  1095                                  RTS
  1096                          @lt     LDA # $FF
  1097                                  RTS
  1098                          @gt     LDA # 1
  1099                                  RTS
  1100                          }
  1101                          
  1102                          ;; Class of the finite float (TMP) = y: .A = 0 if y is not an integer, 1 if it
  1103                          ;; is an even integer (or 0.0), 2 if it is an odd integer. Flags set by .A
  1104                          ;; y = 0.m * 2^E, E = exponent - $80. Not an integer if E <= 0 (y <> 0); even
  1105                          ;; if E > 32; else odd <=> E + (trailing zeroes of the 32 bits of the mantissa)
  1106                          ;; = 32, even if > 32, not an integer if < 32.
  1107                          !ifdef caml_AUX__caml_float_intclass {
  1108                          caml_float_intclass
  1109  83fc a000                       LDY # 0
  1110  83fe b14d                       LDA (TMP),Y
  1111  8400 f036                       BEQ @even
  1112  8402 38                         SEC
  1113  8403 e980                       SBC # $80
  1114  8405 902e                       BCC @no
  1115  8407 f02c                       BEQ @no
  1116  8409 c921                       CMP # 33
  1117  840b b02b                       BCS @even
  1118  840d 8552                       STA TMP + 5
  1119  840f a200                       LDX # 0
  1120  8411 a004                       LDY # 4
  1121  8413 b14d               @tz     LDA (TMP),Y
  1122  8415 d00e                       BNE @bits
  1123  8417 8a                         TXA
  1124  8418 18                         CLC
  1125  8419 6908                       ADC # 8
  1126  841b aa                         TAX
  1127  841c 88                         DEY
  1128  841d c001                       CPY # 1
  1129  841f d0f2                       BNE @tz
  1130  8421 b14d                       LDA (TMP),Y                     ;1st byte: bit 7 is the sign, the
  1131  8423 0980                       ORA # $80                       ; mantissa bit is 1
  1132  8425 4a                 @bits   LSR
  1133  8426 b003                       BCS @cnt
  1134  8428 e8                         INX
  1135  8429 d0fa                       BNE @bits
  1136  842b 8a                 @cnt    TXA
  1137  842c 18                         CLC
  1138  842d 6552                       ADC TMP + 5
  1139  842f c920                       CMP # 32
  1140  8431 f008                       BEQ @odd
  1141  8433 b003                       BCS @even
  1142  8435 a900               @no     LDA # 0
  1143  8437 60                         RTS
  1144  8438 a901               @even   LDA # 1
  1145  843a 60                         RTS
  1146  843b a902               @odd    LDA # 2
  1147  843d 60                         RTS
  1148                          }
  1149                          
  1150                          ;; Domain check for the float just loaded into FAC: log x (.X = 0) or sqrt x
  1151                          ;; (.X <> 0). If x < 0, or x = 0 and .X = 0, the primitive is terminated here
  1152                          ;; with the result (nan, -infinity): the routine pops its return address and
  1153                          ;; jumps to caml_float_ret_tpl.
  1154                          !ifdef caml_AUX__caml_float_logdom {
  1155                          caml_float_logdom
  1156                                  LDA C64_FAC
  1157                                  BNE @nz
  1158                                  TXA                             ;x = 0.0: sqrt is fine,
  1159                                  BNE @ok                         ; log 0.0 = -infinity
  1160                                  PLA
  1161                                  PLA
  1162                                  LDA # Ft_NINF
  1163                                  JMP caml_float_ret_tpl
  1164                          @nz     BIT C64_FAC + 5                 ;x < 0 ?
  1165                                  BPL @ok
  1166                                  PLA
  1167                                  PLA
  1168                                  LDA # Ft_NAN
  1169                                  JMP caml_float_ret_tpl
  1170                          @ok     RTS
  1171                          }
  1172                          
  1173                          ;; A BASIC ROM routine called by a floating-point primitive raised the OVERFLOW
  1174                          ;; error. Called (JSR) by caml_syserr. If the primitive set the operation in
  1175                          ;; caml_float_overflow__op, the CPU stack is restored as it was when
  1176                          ;; caml_float_unop/binop (or the primitive itself) saved it in
  1177                          ;; caml_float_overflow__sp, and the primitive returns +-infinity to its caller.
  1178                          ;; Otherwise return to caml_syserr, which raises Sys_error "OVERFLOW".
  1179                          ;; The sign of the result is: add, sub: sign of x (ACCU); mul, div: sign(x)
  1180                          ;; xor sign(y) (SP[0]); pow: - if x < 0 and y is an odd integer; exp: +;
  1181                          ;; float_of_string: - if the string starts with '-'.
  1182                          !ifdef caml_AUX__caml_float_overflow {
  1183                          caml_float_overflow
  1184  843e ada884                     LDA caml_float_overflow__op
  1185  8441 1001                       BPL @known
  1186  8443 60                         RTS                             ;unknown operation: raise the error
  1187  8444 f049               @known  BEQ @sgnx                       ;Fo_ADD
  1188  8446 c902                       CMP # Fo_POW
  1189  8448 f02b                       BEQ @pow
  1190  844a b013                       BCS @exp                        ;Fo_EXP, Fo_STR
  1191  844c a000                       LDY # 0                         ;Fo_MUL
  1192  844e b1fd                       LDA (SP),Y
  1193  8450 854d                       STA TMP
  1194  8452 c8                         INY
  1195  8453 b1fd                       LDA (SP),Y
  1196  8455 854e                       STA TMP + 1                     ;(TMP) = y
  1197  8457 b14d                       LDA (TMP),Y                     ;.Y = 1: sign of y,
  1198  8459 51fb                       EOR (ACCU),Y                    ; xor sign of x
  1199  845b 303c                       BMI @neg
  1200  845d 1036                       BPL @pos
  1201  845f c904               @exp    CMP # Fo_STR
  1202  8461 d032                       BNE @pos                        ;Fo_EXP: +infinity
  1203  8463 a54d                       LDA TMP                         ;Fo_STR: restore the BASIC program
  1204  8465 857a                       STA C64_CHRPTR                  ; pointer, saved by the primitive
  1205  8467 a54e                       LDA TMP + 1
  1206  8469 857b                       STA C64_CHRPTR + 1
  1207  846b a000                       LDY # 0
  1208  846d b1fb                       LDA (ACCU),Y
  1209  846f c92d                       CMP # '-'
  1210  8471 f026                       BEQ @neg
  1211  8473 d020                       BNE @pos
  1212  8475 a001               @pow    LDY # 1
  1213  8477 b1fb                       LDA (ACCU),Y                    ;x < 0 ?
  1214  8479 101a                       BPL @pos
  1215  847b a000                       LDY # 0
  1216  847d b1fd                       LDA (SP),Y
  1217  847f 854d                       STA TMP
  1218  8481 c8                         INY
  1219  8482 b1fd                       LDA (SP),Y
  1220  8484 854e                       STA TMP + 1                     ;(TMP) = y
  1221  8486 20fc83                     JSR caml_float_intclass
  1222  8489 c902                       CMP # 2                         ;negative result iff y is odd
  1223  848b b00c                       BCS @neg
  1224  848d 9006                       BCC @pos
  1225  848f a001               @sgnx   LDY # 1
  1226  8491 b1fb                       LDA (ACCU),Y                    ;sign of x
  1227  8493 3004                       BMI @neg
  1228  8495 a91e               @pos    LDA # Ft_PINF
  1229  8497 d002                       BNE @res                        ;BNE=JMP
  1230  8499 a924               @neg    LDA # Ft_NINF
  1231  849b a2ff               @res    LDX # Fo_NONE                   ;Handle overflow: reset op, so that a
  1232  849d 8ea884                     STX caml_float_overflow__op     ; later overflow raised by a ROM routine
  1233  84a0 aea784                     LDX caml_float_overflow__sp     ; which doesn't set it is an error.
  1234  84a3 9a                         TXS                             ;Restore the CPU stack pointer
  1235  84a4 4cae83                     JMP caml_float_ret_tpl          ;return the result to the caller
  1236                          caml_float_overflow__sp
  1237  84a7 00                         !byte 0
  1238                          caml_float_overflow__op
  1239  84a8 ff                         !byte Fo_NONE
  1240                          }
  1241                          
  1242                          }      ;; !zone caml_FLOATS
  1243                          

