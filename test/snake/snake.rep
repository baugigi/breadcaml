    34                          C64_ADRAY2      = $05   ;-$06 Jump Vector: Convert Integer--Floating
    35                          C64_CHARAC      = $07   ;Search Character
    36                          C64_ENDCHR      = $08   ;Flag: Scan for Quote at End of String
