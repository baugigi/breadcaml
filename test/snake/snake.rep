   270                          !macro  i2e     {+i30 0}
   271                          !macro  i2f     {+i30 2}
   272                          !macro  i31     {+i09 : +i30 -2}                ;PUSHOFFSETCLOSUREi -> PUSH;...
   273                          !macro  i32     {+i09 : +i30 0}
   274                          !macro  i33     {+i09 : +i30 2}
   275                          !macro  i34 .n  {+i09 : +i30 .n}                ;PUSHOFFSETCLOSURE n-> PUSH;...
   276                          
   277                          ;; i36-i38 depend on i35
   278                          
   279                          !macro  i35 .n {                                ;GETGLOBAL n
   280                                  +caml_range 0, .n, $7FFF, "GETGLOBAL n: n"
   281                            !if .n < caml_exn_no {
   282                                  LDA # < caml_std_exn[.n]
   283                                  STA ACCU
   284                                  LDA # > caml_std_exn[.n]
   285                                  STA ACCU + 1
   286                            } else {
   287                                  .ofs = 2 * (.n - caml_exn_no)
   288                                  LDA caml_glob_table + .ofs
   289                                  STA ACCU
   290                                  LDA caml_glob_table + .ofs + 1
   291                                  STA ACCU + 1
   292                            }
   293                          }
