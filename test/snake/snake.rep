   442  7d35 9140                       STA (@SCN),Y                    ;  write it in field(0), hi
   443  7d37 aa                         TAX                             ;  and move it in X
   444  7d38 88                         DEY                             ;  Y := 0
   445  7d39 a54b                       LDA BLK                         ;  load fwd pointer, lo
   446  7d3b 9140                       STA (@SCN),Y                    ;  and write it in field(0),lo
   447  7d3d 38                         SEC                             ;  set carry before exit
   448  7d3e 60                         RTS                             ;  RETURN (X:A=fwdptr, Y=0)
   449                                  ;;  An infix block is NOT marked as visited: its size is the offset from
   450                                  ;;  the main block, needed by any other pointer to it (only the main
   451                                  ;;  block is copied and gets a forward pointer).
   452  7d3f 8a                 @infix  TXA                             ;A := X = size = dist.from main blk
   453  7d40 8e5e7d                     STX @dst + 1                    ;save it for later
   454  7d43 0a                         ASL                             ;C:A := 2*dist.
   455  7d44 8d4f7d                     STA @dst2lo + 1                 ;write next SBC's arg.
   456  7d47 9002                       BCC +                           ;perform @SCN := @SCN - .DST:
   457  7d49 c641                       DEC @SCN + 1                    ;  decr @SCN_hi if C set
   458  7d4b a540               +       LDA @SCN                        ;  load @SCN_lo
   459  7d4d 38                         SEC
   460  7d4e e934               @dst2lo SBC # <.dummy                   ;  SMC: subtract <2*dist.
   461  7d50 8540                       STA @SCN                        ;  save result, lo by.
   462  7d52 b002                       BCS +
   463  7d54 c641                       DEC @SCN + 1                    ;  adjust hi by.
   464  7d56 c8                 +       INY                             ;(@SCN),Y = main block's size
   465  7d57 20ca7c                     JSR @again                      ;get main block's fwdptr in X:A
   466  7d5a 8d657d                     STA @fwdlo + 1                  ;write next ADC's arg.
   467  7d5d a934               @dst    LDA # <.dummy                   ;SMC: get infix's SIZE
   468  7d5f 0a                         ASL                             ;A := <SIZE*2, C := >SIZE*2 
   469  7d60 9002                       BCC @fwdlo                      ;perform X:A:=X:A+main fwd ptr:
   470  7d62 e8                         INX                             ;  incr X if SIZE*2>255
   471  7d63 18                         CLC
   472  7d64 6934               @fwdlo  ADC # <.dummy                   ;  SMC: add forward ptr, lo byte
   473  7d66 9001                       BCC +
   474  7d68 e8                         INX                             ;  adjust X
   475  7d69 38                 +       SEC                             ;set carry before exit
   476  7d6a 60                         RTS                             ;RETURN (X:A = infix forward ptr)
   477                          
   478                                  ;; Copy BLK to ACCU.
   479                          caml_load_newblk
   480  7d6b a54c                       LDA BLK + 1
   481  7d6d 85fc                       STA ACCU + 1
   482  7d6f a54b                       LDA BLK
   483  7d71 85fb                       STA ACCU
   484  7d73 60                         RTS
   485                          
   486                                  ;; ACCU := Atom(0)
   487                          caml_mkatom0
   488  7d74 a97e                       LDA # < caml_atom0
   489  7d76 85fb                       STA ACCU
   490  7d78 a908                       LDA # > caml_atom0
   491  7d7a 85fc                       STA ACCU + 1
   492  7d7c 60                         RTS
   493                          
   494                          caml_shrink_latest_alloc
   495                                  ;; Reduce the size of the latest allocated block; new size MUST BE less
   496                                  ;; than the original one (no check) and NO GARBAGE COLLECTION occurred
   497                                  ;; since the block allocation. Params: X=size>0, Y=0, BLK=address.
   498                                  ;; Shrinking is done by updating the new size in the block's header and
   499                                  ;; the HEAP pointer. Return: A=X=size, Y=0.
   500                                  @SZ2 = GC                       ;2 by - block size in bytes
   501  7d7d c64c                       DEC BLK + 1                     ;Prepare access to the 'size'
   502  7d7f 88                         DEY                             ; byte in block's header
   503  7d80 b14b                       LDA (BLK),Y                     ;Read original size from header
   504  7d82 853e                       STA @SZ2                        ; and save it
   505  7d84 8a                         TXA                             ;A := new size
   506  7d85 914b                       STA (BLK),Y                     ;Write new size into header
   507  7d87 e64c                       INC BLK + 1                     ;Restore block pointer
   508  7d89 c8                         INY                             ; and Y register
   509  7d8a 49ff                       EOR # $FF                       ;Do an inverse subtraction:
   510  7d8c 38                         SEC                             ; A := @SZ2 - A
   511  7d8d 653e                       ADC @SZ2                        ;    = orig.size - new size
   512  7d8f 0a                         ASL                             ;Compute 2 * A
   513  7d90 853e                       STA @SZ2                        ;Store result, lo byte, in @SZ2
   514  7d92 843f                       STY @SZ2 + 1                    ;Set @SZ2 + 1 to 0
   515  7d94 263f                       ROL @SZ2 + 1                    ;Store result, MSB, in @SZ2 + 1
   516  7d96 a549                       LDA HEAP                        ;Recover unused block bytes by
   517  7d98 38                         SEC                             ; decrementing the heap pointer
   518  7d99 e53e                       SBC @SZ2                        ; by 2 * (orig.size - new size)
   519  7d9b 8549                       STA HEAP                        ;Store new value, lo byte
   520  7d9d a54a                       LDA HEAP + 1
   521  7d9f e53f                       SBC @SZ2 + 1
   522  7da1 854a                       STA HEAP + 1                    ;Store new value, hi byte
   523  7da3 60                         RTS                             ;Return.
   524                          
   525                          caml_memory_end
   526                          } ;!zone caml_MEMORY
