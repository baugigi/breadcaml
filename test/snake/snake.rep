   233  86f3 88                         DEY
   234  86f4 b1fd                       LDA (SP),Y                      ; <dofs
   235  86f6 6a                         ROR
   236  86f7 854f                       STA @TO                         ; TO := <int_val(dofs)
   237  86f9 88                         DEY
   238  86fa b1fd                       LDA (SP),Y                      ; >dst
