    16                          ;;                              AUXILIARY TOOLS
    17                          ;; -----------------------------------------------------------------------------
    18                          
    19                          !zone AUX_TOOLS {
    20                          
    21                          .dummy = $1234                          ;dummy operand for self-modifying
    22                                                                  ;code (SMC in comments)
    23                          
    24                          !ifdef caml_AUX__caml_memcpy {
    25                                  ;; Copy a contiguous memory area.  Start address in TMP (wo.),
    26                                  ;; destination address in TMP + 2 (wo.), size in TMP + 4 (wo.).
    27                                  ;; Source and destination areas may overlap.
    28                                  ;; Used registers: A, X, Y. Return Y = 0.
    29                          caml_memcpy
    30                                  @FROM = TMP                     ;source address
    31                                  @TO = TMP + 2                   ;destination address
    32                                  @NUM = TMP + 4                  ;num bytes
    33  54a5 a54e                       LDA @FROM + 1
    34  54a7 c550                       CMP @TO + 1
    35  54a9 902e                       BCC .caml_memcpy__up
    36  54ab d009                       BNE .caml_memcpy__dn
    37  54ad a54d                       LDA @FROM
    38  54af c54f                       CMP @TO
    39  54b1 9026                       BCC .caml_memcpy__up
    40  54b3 d001                       BNE .caml_memcpy__dn
    41  54b5 60                         RTS                             ;just in case @FROM = @TO
    42                          .caml_memcpy__dn
    43                                  ;; copy from a higher address to a lower one
    44  54b6 a000                       LDY # 0
    45  54b8 a652                       LDX @NUM + 1
    46  54ba f00e                       BEQ +
    47  54bc b14d               -       LDA (@FROM),Y                   ;move a page at a time
    48  54be 914f                       STA (@TO),Y
    49  54c0 c8                         INY
    50  54c1 d0f9                       BNE -
    51  54c3 e64e                       INC @FROM + 1
    52  54c5 e650                       INC @TO + 1
    53  54c7 ca                         DEX
    54  54c8 d0f2                       BNE -
    55  54ca a651               +       LDX @NUM
    56  54cc f008                       BEQ +
    57  54ce b14d               -       LDA (@FROM),Y                   ;move the remaining bytes
    58  54d0 914f                       STA (@TO),Y
    59  54d2 c8                         INY
    60  54d3 ca                         DEX
    61  54d4 d0f8                       BNE -
    62  54d6 a000               +       LDY # 0
    63  54d8 60                         RTS
    64                          .caml_memcpy__up
    65                                  ;; copy from a lower address to a higher one
    66  54d9 a652                       LDX @NUM + 1                    ;the last byte must be moved first
    67  54db 18                         CLC                             ;start at the final pages of from & to
    68  54dc 8a                         TXA
    69  54dd 654e                       ADC @FROM + 1
    70  54df 854e                       STA @FROM + 1
    71  54e1 18                         CLC
    72  54e2 8a                         TXA
    73  54e3 6550                       ADC @TO + 1
    74  54e5 8550                       STA @TO + 1
    75  54e7 e8                         INX                             ;allows use of BNE after DEX below
    76  54e8 a451                       LDY @NUM
    77  54ea f00e                       BEQ ++
    78  54ec 88                         DEY                             ;move bytes on the last page first
    79  54ed f007                       BEQ +
    80  54ef b14d               -       LDA (@FROM),Y
    81  54f1 914f                       STA (@TO),Y
    82  54f3 88                         DEY
    83  54f4 d0f9                       BNE -
    84  54f6 b14d               +       LDA (@FROM),Y                   ;handle Y = 0 separately
    85  54f8 914f                       STA (@TO),Y
    86  54fa 88                 ++      DEY
    87  54fb c64e                       DEC @FROM + 1                   ;move the next page (if any)
    88  54fd c650                       DEC @TO + 1
    89  54ff ca                         DEX
    90  5500 d0ed                       BNE -
    91  5502 a000                       LDY # 0
    92  5504 60                         RTS
    93                          }
    94                          
    95                          !ifdef  caml_AUX__caml_blkcpy {
    96                                  ;; Copy all fields from ACCU to BLK; C:Y = 2 * #fields.
    97                                  ;; The block's header is not copied!
    98                          caml_blkcpy
    99  5505 9006                       BCC +                           ; less than 256 bytes (<128 fields)
   100  5507 f016                       BEQ ++                          ; exactly 256 bytes   (=128 fields)
   101  5509 e6fc                       INC ACCU + 1                    ; more than 256 bytes (>128 fields)
   102  550b e64c                       INC BLK + 1
   103                          --
   104  550d 88                 +       DEY
   105  550e b1fb               -       LDA (ACCU),Y
   106  5510 914b                       STA (BLK),Y
   107  5512 88                         DEY
   108  5513 d0f9                       BNE -
   109  5515 b1fb                       LDA (ACCU),Y                    ; handle Y = 0 apart
   110  5517 914b                       STA (BLK),Y
   111  5519 9007                       BCC +
   112  551b c6fc                       DEC ACCU + 1
   113  551d c64c                       DEC BLK + 1
   114  551f 18                 ++      CLC
   115  5520 90eb                       BCC --
   116  5522 60                 +       RTS
   117                          }
