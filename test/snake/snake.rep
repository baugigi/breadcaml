    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          ;; -----------------------------------------------------------------------------
    15                          ;;                       C64.Sound - timing helpers (PAL / NTSC)
    16                          ;; -----------------------------------------------------------------------------
    17                          ;; Frame length in CPU cycles tells the video standard (hence the SID clock):
    18                          ;;      PAL 312 x 63 = 19656   NTSC 263 x 65 = 17095 (old NTSC 262 x 64 = 16768)
    19                          ;;      PAL-N 312 x 65 = 20280
    20                          !zone caml_C64_SND {
    21                          
    22                          !ifdef caml_PRIM__caml_nonstd_snd_frame_cycles {
    23                          caml_nonstd_snd_frame_cycles
    24                                  ;; Measures a whole frame with CIA2 timer B (free-running, no IRQ).
    25                                  ;; IRQs are masked for ~3 frames (the jiffy clock loses 3 ticks).
    26  59e3 08                         PHP
    27  59e4 78                         SEI
    28  59e5 a900                       LDA # 0
    29  59e7 8d0fdd                     STA C64_CIA2_CRB                ;stop timer B
    30  59ea a9ff                       LDA # $FF
    31  59ec 8d06dd                     STA C64_CIA2_TBLO
    32  59ef 8d07dd                     STA C64_CIA2_TBHI
    33  59f2 a910                       LDA # %00010000
    34  59f4 8d0fdd                     STA C64_CIA2_CRB                ;force load $FFFF (still stopped)
    35  59f7 20235a                     JSR @sync
    36  59fa a901                       LDA # %00000001
    37  59fc 8d0fdd                     STA C64_CIA2_CRB                ;start at raster line 0
    38  59ff 20235a                     JSR @sync
    39  5a02 a900                       LDA # 0
    40  5a04 8d0fdd                     STA C64_CIA2_CRB                ;stop at the next raster line 0
    41  5a07 38                         SEC
    42  5a08 a9ff                       LDA # $FF
    43  5a0a ed06dd                     SBC C64_CIA2_TBLO
    44  5a0d 85fb                       STA ACCU
    45  5a0f a9ff                       LDA # $FF
    46  5a11 ed07dd                     SBC C64_CIA2_TBHI
    47  5a14 85fc                       STA ACCU + 1                    ;elapsed cycles (up to 20280)
    48  5a16 46fc                       LSR ACCU + 1
    49  5a18 66fb                       ROR ACCU                        ;halved: must fit 15 bits
    50  5a1a 38                         SEC
    51  5a1b 26fb                       ROL ACCU
    52  5a1d 26fc                       ROL ACCU + 1                    ;Val_int
    53  5a1f 28                         PLP
    54  5a20 a000                       LDY # 0
    55  5a22 60                         RTS
    56  5a23 ad12d0             @sync   LDA C64_VIC_RASTER              ;leave line 0 ...
    57  5a26 f0fb                       BEQ @sync
    58  5a28 ad12d0             @w0     LDA C64_VIC_RASTER              ;... and wait for the next one (bit 8 = 0)
    59  5a2b d0fb                       BNE @w0
    60  5a2d ad11d0                     LDA C64_VIC_CR1
    61  5a30 30f6                       BMI @w0
    62  5a32 60                         RTS
    63                          }
    64                          
    65                          !ifdef caml_PRIM__caml_nonstd_snd_wait_frame {
    66                          caml_nonstd_snd_wait_frame
    67                                  ;; Returns when the raster reaches line 248 (once per frame).
    68  5a33 ad12d0             @a      LDA C64_VIC_RASTER
    69  5a36 c9f8                       CMP # $F8
    70  5a38 f0f9                       BEQ @a
    71  5a3a ad12d0             @b      LDA C64_VIC_RASTER
    72  5a3d c9f8                       CMP # $F8
    73  5a3f d0f9                       BNE @b
    74  5a41 a201                       LDX # <Val_unit
    75  5a43 86fb                       STX ACCU
    76  5a45 a000                       LDY # 0
    77  5a47 84fc                       STY ACCU + 1
    78  5a49 60                         RTS
    79                          }
    80                          
    81                          }       ;; !zone caml_C64_SND
    82                          

