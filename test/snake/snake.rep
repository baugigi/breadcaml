   141                          !ifdef caml_PRIM__caml_make_array {
   142                                  ;; If ACCU is a block of floats, unbox all elements, else do nothing
   143                          caml_make_array
   144                          @FLD = TMP
   145                          @NFL = TMP + 2
   146                          @OFS = TMP + 3
   147                          @RES = TMP + 4
   148                                  LDA ACCU
   149                                  BIT caml_is_block
   150                                  BNE @exit                       ;exit if !is_block(ACCU)
   151                                  CMP # <caml_atom0
   152                                  BNE +
   153                                  LDA ACCU + 1
   154                                  CMP # >caml_atom0
   155                                  BEQ @exit                       ;exit if size(ACCU)=0
   156                          +       LDA (ACCU),Y
   157                                  BIT caml_is_block
   158                                  BNE @exit                       ;exit if !is_block(Field0)
   159                                  STA @FLD
   160                                  SEC
   161                                  SBC # < caml_heap_start
   162                                  INY
   163                                  LDA (ACCU),Y
   164                                  CMP # > caml_heap_start
   165                                  BCC @exit0                      ;exit if out_of_heap(Field0)
   166                                  STA @FLD + 1
   167                                  LDY # -2
   168                                  DEC @FLD + 1
   169                                  LDA (@FLD),Y
   170                                  CMP # Double_tag
   171                                  BEQ +                           ;exit if tag(Field0)<>Double_tag
   172                          @exit0  LDY # 0
   173                          @exit   RTS
   174                          +       INY                             ;Y = -1
   175                                  DEC ACCU + 1
   176                                  LDA (ACCU),Y                    ;size of the source array
   177                                  INC ACCU + 1
   178                                  INY                             ;Y = 0
   179                                  CMP # 255 DIV Double_wosize + 1  ;check length
   180                                  BCC +
   181                                  +caml_raise Out_of_memory
   182                                  ;; size is lenght * 3
   183                          +       STA @NFL
   184                                  ASL
   185                                  ;CLC
   186                                  ADC @NFL
   187                                  TAX                              ;X = @NFL * 3 = @NFL * Double_wosize 
   188                                  LDA # Double_array_tag           ;A = tag
   189                                  JSR caml_alloc                   ;allocate array of floats; ACCU (the
   190                                                                   ; source array) is a GC root, so it
   191                                                                   ; stays valid. {Y = 0}
   192                                  LDA BLK
   193                                  STA @RES
   194                                  LDA BLK + 1
   195                                  STA @RES + 1                     ;save result address
   196                                  STY @OFS                         ;offset of the source field (Y = 0)
   197                                  ;; for each element: unbox Field(ACCU,i) into the new block
   198                          @loop   LDY @OFS
   199                                  LDA (ACCU),Y
   200                                  STA @FLD
   201                                  INY
   202                                  LDA (ACCU),Y
   203                                  STA @FLD + 1
   204                                  INY
   205                                  STY @OFS
   206                                  +caml_move_float @FLD, BLK       ;{Y = 0}
   207                                  DEC @NFL
   208                                  BEQ @end
   209                                  LDA BLK
   210                                  CLC
   211                                  ADC # Double_wosize * 2
   212                                  STA BLK
   213                                  BCC @loop
   214                                  INC BLK + 1
   215                                  BCS @loop                        ;C is still set
   216                          @end    LDA @RES                         ;ACCU := new array
   217                                  STA ACCU
   218                                  LDA @RES + 1
   219                                  STA ACCU + 1
   220                                  RTS                              ;{Y = 0}
   221                          }
