     1                          ;;; --------------------
     2                          ;;;        RANDOM
     3                          ;;; --------------------
     4                          
     5                          ;; X ABC Algorithm Pseudo-Random Number Generator for 8-Bit Devices.
     6                          ;; Quite fast, but not good for cryptographic/security purposes.
     7                          ;; From EternityForest (1), with modifications by Stix (2).
     8                          ;; (1) https://www.electro-tech-online.com/threads/ultra-fast-pseudorandom-
     9                          ;; 					      number-generator-for-8-bit.124249/
    10                          ;; (2) https://www.stix.id.au/wiki/Fast_8-bit_pseudorandom_number_generator
    11                          ;; Links are also on archive.org
    12                          
    13                          ;; NUMBER OF CYCLES AND THEIR LENGTHS:
    14                          ;;     Length   Count   Seeds (a,b,c,x)
    15                          ;; 2826386176    1      00,00,00,00
    16                          ;;  653676288    1      10,00,00,00
    17                          ;;  630179072    1      11,00,00,00
    18                          ;;  136099072    1      2A,00,00,00
    19                          ;;   19772672    2      7B,00,00,00  41,02,00,00
    20                          ;;    3474944    2      5E,02,00,00  BC,04,00,00
    21                          ;;     647936    1      E2,34,00,00
    22                          ;;     401152    1      52,27,00,00
    23                          ;;     224512    1      3E,19,00,00
    24                          ;;     196864    1      2B,38,00,00
    25                          ;;     156160    2      70,27,00,00  03,83,01,00
    26                          ;;      90112    2      FE,3A,00,00  D1,CE,00,00
    27                          ;;      66048    2      1A,0B,01,00  EA,8D,01,00
    28                          ;;       9472    2      65,1D,06,00  53,7E,15,00
    29                          ;;       5376    2      E8,19,01,00  5D,9D,0C,00
    30                          ;;       2048    2      F0,D3,0D,00  7A,F9,54,00
    31                          ;;        512    4      4C,95,3A,00  CF,EC,55,00  97,F6,70,00  E6,26,D3,00
    32                          ;;        256    2      00,02,01,00  7A,9D,21,00
    33                          ;; ----------   --
    34                          ;; 4294967296   30
    35                          
    36                          ;; DIEHARDER RESULT: (dieharder ver. 3.31.1 (C) 2003 Robert G. Brown)
    37                          ;;         test_name   |ntup| tsamples |psamples|  p-value |Assessment
    38                          ;; -- 8< --         108 lines of PASSED TESTS snipped         -- 8< --
    39                          ;;         diehard_opso|   0|   2097152|     100|0.00000000|  FAILED  
    40                          ;;         diehard_oqso|   0|   2097152|     100|0.00000008|  FAILED  
    41                          ;;           sts_serial|   4|    100000|     100|0.99564586|   WEAK   
    42                          ;;          rgb_bitdist|   4|    100000|     100|0.99890820|   WEAK   
    43                          ;; rgb_minimum_distance|   2|     10000|    1000|0.00429146|   WEAK   
    44                          ;;         dab_monobit2|  12|  65000000|       1|1.00000000|  FAILED
    45                          
    46                          ;; Note that  all above data refer  to the original 8-bit  PRNG algorithm, whose
    47                          ;; result  is  stored  in   `caml_nonstd_random_int__a`;  for  the  purposes  of
    48                          ;; BreadCaml, the  result is a 15-bit  OCaml integer, whose least  significant 8
    49                          ;; bits are taken from `caml_nonstd_random_int__a` and the remaining 7 bits from
    50                          ;; `caml_nonstd_random_int__b (discarding the most  significant bit): this could
    51                          ;; affect the strength of the algorithm as a whole.
    52                          
    55                          !zone caml_RANDOM {
    56                          
    57                          !ifdef caml_PRIM__caml_nonstd_random_int {
    58                          caml_nonstd_random_int
    59  2225 ee2922                     INC caml_nonstd_random_int__x
    60                          caml_nonstd_random_int__x = * + 1
    61  2228 a900                       LDA # $00                               ;SMC: LDA x
    62  222a 4d4122                     EOR caml_nonstd_random_int__c
    63                          caml_nonstd_random_int__a = * + 1
    64  222d 4900                       EOR # $00                               ;SMC: EOR a
    65  222f 8d2e22                     STA caml_nonstd_random_int__a
    66  2232 18                         CLC
    67                          caml_nonstd_random_int__b = * + 1
    68  2233 6900                       ADC # $00                               ;SMC: ADC b
    69  2235 8d3422                     STA caml_nonstd_random_int__b
    70  2238 4a                         LSR
    71  2239 9002                       BCC +                                   ;Stix's mod: LSR changed with
    72  223b 0980                       ORA # $80                               ;8-bit right rotate
    73  223d 4d2e22             +       EOR caml_nonstd_random_int__a
    74                          caml_nonstd_random_int__c = * + 1
    75  2240 6900                       ADC # $00                               ;SMC: ADC c
    76  2242 8d4122                     STA caml_nonstd_random_int__c
    77  2245 ad2e22                     LDA caml_nonstd_random_int__a		;a is the 8-bit random number
    78                                  ;; Original PRNG algo ends here.
    79  2248 38                         SEC
    80  2249 2a                         ROL                                     ;Return a 15-bit OCaml integer
    81  224a 852c                       STA ACCU                                ;from a and b, discarding
    82  224c ad3422                     LDA caml_nonstd_random_int__b		;bit #7 of b.
    83  224f 2a                         ROL
    84  2250 852d                       STA ACCU + 1
    85  2252 60                         RTS
    86                          }
    87                          
    88                          !ifdef caml_PRIM__caml_nonstd_random_self_init {
    89                          caml_nonstd_random_self_init
    90                                  ;; ARG0 is (), returned as is
    91  2253 a5a2                       LDA C64_TIME + 2                        ;Use the jiffy clock and the
    92  2255 8d2922                     STA caml_nonstd_random_int__x		;current raster line no. to
    93  2258 4d12d0                     EOR C64_VIC_RASTER                      ;generate a "random" seed
    94  225b 8d2e22                     STA caml_nonstd_random_int__a
    95  225e 0a                 -       ASL                                     ;"random" delay
    96  225f d0fd                       BNE -
    97  2261 ad2922                     LDA caml_nonstd_random_int__x
    98  2264 4d12d0                     EOR C64_VIC_RASTER
    99  2267 8d3422                     STA caml_nonstd_random_int__b
   100  226a 4a                 -       LSR                                     ;"random" delay
   101  226b d0fd                       BNE -
   102  226d ad12d0                     LDA C64_VIC_RASTER
   103  2270 8d4122                     STA caml_nonstd_random_int__c
   104  2273 60                         RTS
   105                          }
   106                          
   107                          !ifdef caml_PRIM__caml_nonstd_random_set_state {
   108                          caml_nonstd_random_set_state
   109                                  ;; ARG0 is a 4-char string "xabc"
   110  2274 a003                       LDY #3
   111  2276 b12c                       LDA (ACCU),Y
   112  2278 8d4122                     STA caml_nonstd_random_int__c
   113  227b 88                         DEY
   114  227c b12c                       LDA (ACCU),Y
   115  227e 8d3422                     STA caml_nonstd_random_int__b
   116  2281 88                         DEY
   117  2282 b12c                       LDA (ACCU),Y
   118  2284 8d2e22                     STA caml_nonstd_random_int__a
   119  2287 88                         DEY
   120  2288 b12c                       LDA (ACCU),Y
   121  228a 8d2922                     STA caml_nonstd_random_int__x
   122  228d 842d                       STY ACCU + 1
   123  228f a901                       LDA #<Val_unit
   124  2291 852c                       STA ACCU
   125  2293 60                         RTS
   126                          }
   127                          
   128                          !ifdef caml_PRIM__caml_nonstd_random_get_state {
   129                          caml_nonstd_random_get_state
   130                                  ;; return a 4-char string "xabc"
   131  2294 a203                       LDX # 3
   132  2296 a9fc                       LDA # String_tag
   133  2298 20111f                     JSR caml_alloc
   134  229b a005                       LDY # 5
   135  229d a901                       LDA # 1                                 ;OCaml string padding \001
   136  229f 9157                       STA (BLK),Y
   137  22a1 88                         DEY
   138  22a2 a900                       LDA # 0                                 ;OCaml string padding \000
   139  22a4 9157                       STA (BLK),Y
   140  22a6 88                         DEY
   141  22a7 ad4122                     LDA caml_nonstd_random_int__c
   142  22aa 9157                       STA (BLK),Y
   143  22ac 88                         DEY
   144  22ad ad3422                     LDA caml_nonstd_random_int__b
   145  22b0 9157                       STA (BLK),Y
   146  22b2 88                         DEY
   147  22b3 ad2e22                     LDA caml_nonstd_random_int__a
   148  22b6 9157                       STA (BLK),Y
   149  22b8 88                         DEY
   150  22b9 ad2922                     LDA caml_nonstd_random_int__x
   151  22bc 9157                       STA (BLK),Y
   152  22be a557                       LDA BLK
   153  22c0 852c                       STA ACCU
   154  22c2 a558                       LDA BLK + 1
   155  22c4 852d                       STA ACCU + 1
   156  22c6 60                         RTS
   157                          }
   158                          }       ;; !zone caml_RANDOM
   159                          

