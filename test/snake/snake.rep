    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          ;; ——————————————————————————————————————————————————————————————————————
    15                          ;; C64.Hw.Kernal: thin wrappers around the Kernal I/O routines (through the
    16                          ;; jump table at $FF81-$FFF3, so that alternative Kernals work too).
    17                          ;;
    18                          ;; Conventions as in c64lib_hw.asm: the arguments are not popped here, ACCU = 1st
    19                          ;; argument, SP[0] = 2nd, ...; 8-bit values are taken modulo 256; every
    20                          ;; primitive returns with Y = 0.  No primitive allocates, so no GC issue arises
    21                          ;; (the name strings are read in place while the Kernal runs).
    22                          ;;
    23                          ;; A primitive that may fail returns the Kernal error code (0 = no error;
    24                          ;; 1 too many files, 2 file open, 3 file not open, 4 file not found, 5 device
    25                          ;; not present, 6 not input file, 7 not output file, 8 missing file name,
    26                          ;; 9 illegal device number).  Most DOS errors (e.g. a missing file on OPEN) are
    27                          ;; NOT reported here but by the drive error channel and the status byte (READST).
    28                          ;;
    29                          ;; Kernal messages (SEARCHING FOR, LOADING...) are switched off by LOAD/SAVE.
    30                          ;; File names must be at most 255 characters long.
    31                          ;; ——————————————————————————————————————————————————————————————————————
    32                          
    33                          !zone caml_C64_KN {
    34                          
    35                          !macro caml_kn_a8 {                     ;A := low 8 bits of Int_val(ACCU)
    36                                  LDA ACCU + 1
    37                                  LSR
    38                                  LDA ACCU
    39                                  ROR
    40                          }
    41                          !macro caml_kn_s8 .n {                  ;A := low 8 bits of Int_val(SP[.n])  {Y = 0}
    42                                  LDY # .n * 2 + 1
    43                                  LDA (SP),Y
    44                                  LSR
    45                                  DEY
    46                                  LDA (SP),Y
    47                                  ROR
    48                                  LDY # 0
    49                          }
    50                          !macro caml_kn_ret8 {                   ;ACCU := Val_int(A)
    51                                  LDY # 0
    52                                  STY ACCU + 1
    53                                  SEC
    54                                  ROL
    55                                  STA ACCU
    56                                  ROL ACCU + 1
    57                          }
    58                          !macro caml_kn_ret_err {                ;after a Kernal call: Val_int(C ? A : 0)
    59                                  BCS +
    60                                  LDA # 0
    61                          +       +caml_kn_ret8
    62                          }
    63                          !macro caml_kn_ret_unit {
    64                                  LDY # 0
    65                                  LDX # <Val_unit
    66                                  STX ACCU
    67                                  STY ACCU + 1
    68                          }
    69                          !macro caml_kn_nameptr .n {             ;ACCU := string SP[.n]  {Y = 0}
    70                                  LDY # .n * 2                    ;(then the caller must JSR
    71                                  LDA (SP),Y                      ; caml_string_length_yx, which is
    72                                  STA ACCU                        ; not called here, otherwise mkdepends
    73                                  INY                             ; would not see the dependency)
    74                                  LDA (SP),Y
    75                                  STA ACCU + 1
    76                                  LDY # 0
    77                          }
    78                          !macro caml_kn_setnam {                 ;SETNAM for ACCU, .Y,.X = length
    79                                  TXA
    80                                  BEQ +
    81                                  LDY # 255                       ;longer than 255: truncated
    82                          +       TYA                             ;A := length
    83                                  LDX ACCU
    84                                  LDY ACCU + 1
    85                                  JSR C64_KSETNAM
    86                          }
    87                          
    88                          ;; open_file lfn dev sa name -> error code
    89                          !ifdef caml_PRIM__caml_nonstd_kn_open {
    90                          caml_nonstd_kn_open
    91                                  +caml_kn_s8 1                   ;secondary address
    92                                  STA TMP
    93                                  +caml_kn_s8 0                   ;device
    94                                  TAX
    95                                  +caml_kn_a8                     ;logical file number
    96                                  LDY TMP
    97                                  JSR C64_KSETLFS
    98                                  +caml_kn_nameptr 2
    99                                  JSR caml_string_length_yx
   100                                  +caml_kn_setnam
   101                                  JSR C64_KOPEN
   102                                  +caml_kn_ret_err
   103                                  RTS
   104                          }
   105                          ;; close lfn -> unit
   106                          !ifdef caml_PRIM__caml_nonstd_kn_close {
   107                          caml_nonstd_kn_close
   108                                  +caml_kn_a8
   109                                  JSR C64_KCLOSE
   110                                  +caml_kn_ret_unit
   111                                  RTS
   112                          }
   113                          ;; chkin lfn / chkout lfn -> error code
   114                          !ifdef caml_PRIM__caml_nonstd_kn_chkin {
   115                          caml_nonstd_kn_chkin
