   145                          C64_SFDX        = $CB   ;Flag: Print Shifted Chars.
   146                          C64_BLNSW       = $CC   ;Cursor Blink enable: 0 = Flash Cursor
   147                          C64_BLNCT       = $CD   ;Timer: Countdown to Toggle Cursor
   148                          C64_GDBLN       = $CE   ;Character Under Cursor
   149                          C64_BLNON       = $CF   ;Flag: Last Cursor Blink On/Off
   150                          C64_CRSW        = $D0   ;Flag: INPUT or GET from Keyboard
   151                          C64_PNT         = $D1   ;-$D2 Pointer: Current Screen Line Address
   152                          C64_PNTR        = $D3   ;Cursor Column on Current Line
