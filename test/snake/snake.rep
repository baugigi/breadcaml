    55  7ac5 c896               .CUR_END        !word .hs + .halfsz     ;end of current half
    56  7ac7 c896               .OTH_START      !word .hs + .halfsz     ;other half of the heap
    57  7ac9 009c               .OTH_END        !word .hs + .halfsz * 2 ;end of other half
    58                          
    59  7acb 9091c896c896009c   .PRISTINE       !word .hs, .hs + .halfsz, .hs + .halfsz, .hs + .halfsz * 2
    60                          
    61                                  ;; Initialize the heap pointer and the semi-space variables, which a
    62                                  ;; previous run may have swapped. Called by caml_init.
    63                          caml_heap_init
