   123                          }
   124                          
   125                          !ifdef  caml_AUX__caml_ptr_add2A {
   126                                  ;; Add 2 * A to a ZP pointer.
   127                          caml_ptr_add2A
   128                                  ASL                             ;{X = ptr addr, A = n}
   129                                  BCC +
   130                                  INC 1,X
   131                                  CLC
   132                          +       ADC 0,X
   133                                  STA 0,X
   134                                  BCC +
   135                                  INC 1,X
   136                          +       RTS                             ;{X = ptr addr, A = <2n, ptr += 2n}
   137                          }
   138                          
   139                          !ifdef  caml_AUX__caml_IntValx3 {
   140                                  ;; A := 3 * Int_Val(A)
   141                                  ;; E.g.: A = %00010001 (value 8) ==> A := %00011000 (int 24)
   142                          caml_IntValx3                           ;{A = v : int}
   143                                  LSR
   144                                  STA @adc + 1                    ;SMC: set arg for ADC# below
   145                                  ASL
   146                                 ;CLC
   147                          @adc    ADC # <.dummy                   ;SMC: ADC # Int_Val(v)
   148                                  RTS                             ;{A = 3 * IntVal(v), C = overflow}
   149                          }
   150                          
   151                          !ifdef  caml_AUX__caml_block_fill0 {
   152                                  ;; Fill in the first X fields of the block in BLK with Val_Int(0).
   153                                  ;; No checks on X nor BLK.
   154                          caml_block_fill0                        ;{X = #fields, Y = 0}
   155                                  LDA BLK + 1
   156                                  PHA
   157                          -       LDA # < Val_zero
   158                                  STA (BLK),Y
   159                                  INY
   160                                  LDA # > Val_zero
   161                                  STA (BLK),Y
   162                                  INY
   163                                  BNE +
   164                                  INC BLK + 1
   165                          +       DEX
   166                                  BNE -
   167                                  PLA
   168                                  STA BLK + 1
   169                                  LDY # 0
   170                                  RTS                             ;{A = BLK + 1, X = 0, Y = 0}
   171                          }
   172                          
   173                          }       ;; !zone AUX_TOOLS
   174                          

