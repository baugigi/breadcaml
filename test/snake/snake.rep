    21                          	!source "/home/piero/.opam/LTS/lib/bcaml/c64lib_userport.asm"

; ******** Source: /home/piero/.opam/LTS/lib/bcaml/c64lib_userport.asm
     1                          ;; ——————————————————————————————————————————————————————————————————————
     2                          ;; The BreadCaml Project / Progetto BreadCaml
     3                          ;; Copyright (C) 21-Apr-2026 Piero Furiesi
     4                          ;; 
     5                          ;; This program is  free software; you can redistribute  it and/or modify
     6                          ;; it under the terms of the  GNU GENERAL PUBLIC LICENSE (GPL) version 2,
     7                          ;; as specified in the LICENSE-en file in the project root folder.
     8                          ;; 
     9                          ;; Questo  programma  è software  libero;  può  essere ridistribuito  e/o
    10                          ;; modificato nei termini della GNU GENERAL PUBLIC LICENSE (GPL) versione
    11                          ;; 2, come specificato nel file  LICENZA-it nella cartella principale del
    12                          ;; progetto.
    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          ;; -----------------------------------------------------------------------------
    15                          ;;              C64.Hw.Userport and C64.Mcu - USER PORT PRIMITIVES
    16                          ;; -----------------------------------------------------------------------------
    17                          ;; The user port is wired to CIA 2:
    18                          ;;      PB0-PB7   port B ($DD01, direction $DD03); PB6/PB7 can be driven by the
    19                          ;;                timer A / timer B outputs
    20                          ;;      PA2       port A bit 2 ($DD00, direction $DD02): the other bits of port
    21                          ;;                A are the VIC bank (0-1) and the serial bus (3-7): never touched
    22                          ;;      /FLAG2    negative edge sets bit 4 of ICR ($DD0D) (reading ICR clears it)
    23                          ;;      /PC2      pulses low for 1 cycle after each read/write of port B
    24                          ;;      CNT2,SP2  shift register ($DD0C)
    25                          ;; Timers: CIA2 timer B is used by the Mcu.Time primitives (delay, clock, pulse
    26                          ;; measurement); timer A by the UART and by the tone generator. Sound.frame_cycles
    27                          ;; (c64lib_snd.asm) also uses timer B, and Hw.Nmi.block uses timer A and the ICR
    28                          ;; mask: do not mix them with these primitives while they run.
    29                          ;;
    30                          ;; Conventions as in c64lib_hw.asm: the arguments are not popped here, ACCU = 1st
    31                          ;; argument, SP[0] = 2nd, ...; masks and values are 8 bit (Int_val masked);
    32                          ;; every primitive returns with Y = 0.
    33                          ;;
    34                          ;; Cycle counts quoted below are CPU cycles (1 cycle = 1.015 us on PAL).
    35                          
    36                          !zone caml_C64_UP {
    37                          
    38                          !macro caml_up_a8 {                     ;A := low 8 bits of Int_val(ACCU)
    39                                  LDA ACCU + 1
    40                                  LSR
    41                                  LDA ACCU
    42                                  ROR
    43                          }
    44                          !macro caml_up_s8 .n {                  ;A := low 8 bits of Int_val(SP[.n])  {Y = 0}
    45                                  LDY # .n * 2 + 1
    46                                  LDA (SP),Y
    47                                  LSR
    48                                  DEY
    49                                  LDA (SP),Y
    50                                  ROR
    51                                  LDY # 0
    52                          }
    53                          !macro caml_up_s16 .n, .dst {           ;.dst:.dst+1 := Int_val(SP[.n])  {Y = 0}
    54                                  LDY # .n * 2 + 1
    55                                  LDA (SP),Y
    56                                  LSR
    57                                  STA .dst + 1
    58                                  DEY
    59                                  LDA (SP),Y
    60                                  ROR
    61                                  STA .dst
    62                                  LDY # 0
    63                          }
    64                          !macro caml_up_acc16 .dst {             ;.dst:.dst+1 := Int_val(ACCU)
    65                                  LDA ACCU + 1
    66                                  LSR
    67                                  STA .dst + 1
    68                                  LDA ACCU
    69                                  ROR
    70                                  STA .dst
    71                          }
    72                          !macro caml_up_ret8 {                   ;ACCU := Val_int(A)  {Y = 0}
    73                                  STY ACCU + 1
    74                                  SEC
    75                                  ROL
    76                                  STA ACCU
    77                                  ROL ACCU + 1
    78                          }
    79                          !macro caml_up_ret_bool {               ;ACCU := Val_bool(A <> 0)  {Y = 0}
    80                                  CMP # 1                         ;C := (A >= 1)
    81                                  LDA # 0
    82                                  ROL
    83                                  +caml_up_ret8
    84                          }
    85                          !macro caml_up_ret_unit {
    86                                  LDX # <Val_unit
    87                                  STX ACCU
    88                                  STY ACCU + 1
    89                          }
    90                          !macro caml_up_ret_16 {                 ;ACCU := Val_int(X:A)  (X:A < $4000)
    91                                  STA ACCU
    92                                  STX ACCU + 1
    93                                  SEC
    94                                  ROL ACCU
    95                                  ROL ACCU + 1
    96                          }
    97                          
    98                          ;; ----- Port B ----------------------------------------------------------------
    99                          
   100                          !ifdef caml_PRIM__caml_nonstd_up_read {
   101                          caml_nonstd_up_read
   102                                  LDA C64_CIA2_PRB
   103                                  +caml_up_ret8
   104                                  RTS
   105                          }
   106                          !ifdef caml_PRIM__caml_nonstd_up_write {
   107                          caml_nonstd_up_write
   108                                  +caml_up_a8
   109                                  STA C64_CIA2_PRB
   110                                  +caml_up_ret_unit
   111                                  RTS
   112                          }
   113                          !ifdef caml_PRIM__caml_nonstd_up_ddr {
   114                          caml_nonstd_up_ddr
   115                                  LDA C64_CIA2_DDRB
   116                                  +caml_up_ret8
   117                                  RTS
   118                          }
   119                          !ifdef caml_PRIM__caml_nonstd_up_set_ddr {
   120                          caml_nonstd_up_set_ddr
   121                                  +caml_up_a8
   122                                  STA C64_CIA2_DDRB
   123                                  +caml_up_ret_unit
   124                                  RTS
   125                          }
   126                          ;; Bit operations on the output latch: PRB := PRB op mask
   127                          !ifdef caml_PRIM__caml_nonstd_up_set {
   128                          caml_nonstd_up_set
   129                                  +caml_up_a8
   130                                  ORA C64_CIA2_PRB
   131                                  STA C64_CIA2_PRB
   132                                  +caml_up_ret_unit
   133                                  RTS
   134                          }
   135                          !ifdef caml_PRIM__caml_nonstd_up_clear {
   136                          caml_nonstd_up_clear
   137                                  +caml_up_a8
   138                                  EOR # $FF
   139                                  AND C64_CIA2_PRB
   140                                  STA C64_CIA2_PRB
   141                                  +caml_up_ret_unit
   142                                  RTS
   143                          }
   144                          !ifdef caml_PRIM__caml_nonstd_up_toggle {
   145                          caml_nonstd_up_toggle
   146                                  +caml_up_a8
   147                                  EOR C64_CIA2_PRB
   148                                  STA C64_CIA2_PRB
   149                                  +caml_up_ret_unit
   150                                  RTS
   151                          }
   152                          ;; Direction bit operations: DDRB := DDRB | mask (outputs) / & ~mask (inputs)
   153                          !ifdef caml_PRIM__caml_nonstd_up_dir_out {
   154                          caml_nonstd_up_dir_out
   155                                  +caml_up_a8
   156                                  ORA C64_CIA2_DDRB
   157                                  STA C64_CIA2_DDRB
   158                                  +caml_up_ret_unit
   159                                  RTS
   160                          }
   161                          !ifdef caml_PRIM__caml_nonstd_up_dir_in {
   162                          caml_nonstd_up_dir_in
   163                                  +caml_up_a8
   164                                  EOR # $FF
   165                                  AND C64_CIA2_DDRB
   166                                  STA C64_CIA2_DDRB
   167                                  +caml_up_ret_unit
   168                                  RTS
   169                          }
   170                          
   171                          ;; ----- PA2, /FLAG2 ------------------------------------------------------------
   172                          
   173                          !ifdef caml_PRIM__caml_nonstd_up_pa2_read {
   174                          caml_nonstd_up_pa2_read
   175                                  LDA C64_CIA2_PRA
   176                                  AND # %00000100
   177                                  +caml_up_ret_bool
   178                                  RTS
   179                          }
   180                          !ifdef caml_PRIM__caml_nonstd_up_pa2_write {
   181                          caml_nonstd_up_pa2_write
   182                                  +caml_up_a8
   183                                  AND # 1
   184                                  BEQ @low
   185                                  LDA C64_CIA2_PRA
   186                                  ORA # %00000100
   187                                  BNE @sta                        ;BNE = JMP
   188                          @low    LDA C64_CIA2_PRA
   189                                  AND # %11111011
   190                          @sta    STA C64_CIA2_PRA
   191                                  +caml_up_ret_unit
   192                                  RTS
   193                          }
   194                          !ifdef caml_PRIM__caml_nonstd_up_pa2_dir {
   195                          caml_nonstd_up_pa2_dir
   196                                  +caml_up_a8                     ;1 = output
   197                                  AND # 1
   198                                  BEQ @in
   199                                  LDA C64_CIA2_DDRA
   200                                  ORA # %00000100
   201                                  BNE @sta                        ;BNE = JMP
   202                          @in     LDA C64_CIA2_DDRA
   203                                  AND # %11111011
   204                          @sta    STA C64_CIA2_DDRA
   205                                  +caml_up_ret_unit
   206                                  RTS
   207                          }
   208                          ;; Reads ICR: returns the /FLAG2 flag, but clears ALL the CIA2 flags
   209                          !ifdef caml_PRIM__caml_nonstd_up_flag2 {
   210                          caml_nonstd_up_flag2
   211                                  LDA C64_CIA2_ICR
   212                                  AND # C64_CIA_ICR_FLG
   213                                  +caml_up_ret_bool
   214                                  RTS
   215                          }
   216                          
   217                          ;; ----- Timing ------------------------------------------------------------------
   218                          
   219                          ;; Waits TMP:TMP+1 cycles with timer B, one shot. The time spent between the
   220                          ;; start of the timer and the return is TMP:TMP+1 + 1 + (0..8) cycles.
   221                          ;; Clobbers A.
   222                          !ifdef caml_AUX__caml_up_wait {
   223                          caml_up_wait
   224                                  LDA # 0
   225                                  STA C64_CIA2_CRB                ;stop timer B, input mode = phi2
   226                                  LDA TMP
   227                                  STA C64_CIA2_TBLO
   228                                  LDA TMP + 1
   229                                  STA C64_CIA2_TBHI
   230                                  LDA # C64_CIA_CR_LOAD | C64_CIA_CR_ONESHOT | C64_CIA_CR_START
   231                                  STA C64_CIA2_CRB                ;load and start
   232                          -       LDA C64_CIA2_CRB
   233                                  LSR
   234                                  BCS -                           ;START bit clears at the underflow
   235                                  RTS
   236                          }
   237                          
   238                          ;; delay cycles: waits for Int_val(ACCU) cycles, 0 <= n <= 16383
   239                          !ifdef caml_PRIM__caml_nonstd_up_delay {
   240                          caml_nonstd_up_delay
   241                                  +caml_up_acc16 TMP
   242                                  JSR caml_up_wait
   243                                  +caml_up_ret_unit
   244                                  RTS
   245                          }
   246                          
   247                          ;; clock_start: timer B free running from $FFFF, counting cycles (wraps at 65536)
   248                          !ifdef caml_PRIM__caml_nonstd_up_clock_start {
   249                          caml_nonstd_up_clock_start
   250                                  LDA # 0
   251                                  STA C64_CIA2_CRB
   252                                  LDA # $FF
   253                                  STA C64_CIA2_TBLO
   254                                  STA C64_CIA2_TBHI
   255                                  LDA # C64_CIA_CR_LOAD | C64_CIA_CR_START
   256                                  STA C64_CIA2_CRB
   257                                  +caml_up_ret_unit
   258                                  RTS
   259                          }
   260                          ;; clock_read: elapsed cycles since clock_start, in units of 4 cycles (0..16383)
   261                          !ifdef caml_PRIM__caml_nonstd_up_clock_read {
   262                          caml_nonstd_up_clock_read
   263                          -       LDX C64_CIA2_TBHI
   264                                  LDA C64_CIA2_TBLO
   265                                  CPX C64_CIA2_TBHI
   266                                  BNE -                           ;consistent read
   267                                  EOR # $FF                       ;elapsed = $FFFF - counter = ~counter
   268                                  STA TMP
   269                                  TXA
   270                                  EOR # $FF
   271                                  LSR
   272                                  ROR TMP
   273                                  LSR
   274                                  ROR TMP                         ;(elapsed >> 2): A = hi, TMP = lo
   275                                  TAX
   276                                  LDA TMP
   277                                  +caml_up_ret_16
   278                                  RTS
   279                          }
   280                          
   281                          ;; pulse_out mask level cycles: drives the pins in mask to level (0/1) for the
   282                          ;; given cycles (16 bit, same limits as delay), then to the opposite level. The
   283                          ;; pins must already be outputs.
   284                          !ifdef caml_PRIM__caml_nonstd_up_pulse_out {
   285                          caml_nonstd_up_pulse_out
   286                                  +caml_up_s16 1, TMP             ;TMP:TMP+1 = cycles
   287                                  +caml_up_s8 0
   288                                  AND # 1
   289                                  STA TMP + 2                     ;level
   290                                  +caml_up_a8
   291                                  STA TMP + 3                     ;mask
   292                                  EOR # $FF
   293                                  STA TMP + 4                     ;~mask
   294                                  LDA TMP + 2
   295                                  BEQ @low
   296                                  LDA C64_CIA2_PRB                ;level 1: high, wait, low
   297                                  ORA TMP + 3
   298                                  STA C64_CIA2_PRB
   299                                  JSR caml_up_wait
   300                                  LDA C64_CIA2_PRB
   301                                  AND TMP + 4
   302                                  STA C64_CIA2_PRB
   303                                  +caml_up_ret_unit
   304                                  RTS
   305                          @low    LDA C64_CIA2_PRB                ;level 0: low, wait, high
   306                                  AND TMP + 4
   307                                  STA C64_CIA2_PRB
   308                                  JSR caml_up_wait
   309                                  LDA C64_CIA2_PRB
   310                                  ORA TMP + 3
   311                                  STA C64_CIA2_PRB
   312                                  +caml_up_ret_unit
   313                                  RTS
   314                          }
   315                          
   316                          ;; pulse_width mask level timeout: measures a complete pulse: waits (at most
   317                          ;; timeout * 256 cycles in all) for the pins in mask to be NOT at level, then to be
   318                          ;; at level (a rising/falling edge), then measures for how many cycles they stay so
   319                          ;; (at most 16383). Returns the width in cycles, or -1 on timeout or if the pulse
   320                          ;; is longer. With several pins in mask, "at level" means "any pin at level".
   321                          ;; Resolution: about 12 cycles (polling).  Uses timer B.
   322                          !macro caml_up_tmo .bad {               ;one 256-cycle block of timeout gone
   323                                  LDA TMP
   324                                  BNE ++
   325                                  LDA TMP + 1
   326                                  BNE +
   327                                  JMP .bad
   328                          +       DEC TMP + 1
   329                          ++      DEC TMP
   330                          }
   331                          !ifdef caml_PRIM__caml_nonstd_up_pulse_width {
   332                          caml_nonstd_up_pulse_width
   333                                  +caml_up_a8
   334                                  STA TMP + 2                     ;mask
   335                                  +caml_up_s8 0
   336                                  AND # 1
   337                                  BEQ @lv0
   338                                  LDA # 0                         ;level 1: inv = 0
   339                                  BEQ @sinv                       ;BEQ = JMP
   340                          @lv0    LDA TMP + 2                     ;level 0: inv = mask
   341                          @sinv   STA TMP + 3
   342                                  +caml_up_s16 1, TMP             ;TMP:TMP+1 = timeout (256-cycle blocks)
   343                                  LDA # 0
   344                                  STA C64_CIA2_CRB                ;timer B: free running from $FFFF
   345                                  LDA # $FF
   346                                  STA C64_CIA2_TBLO
   347                                  STA C64_CIA2_TBHI
   348                                  LDA # C64_CIA_CR_LOAD | C64_CIA_CR_START
   349                                  STA C64_CIA2_CRB
   350                                  LDA C64_CIA2_TBHI
   351                                  STA TMP + 4                     ;last hi byte seen
   352                          @w0     LDA C64_CIA2_PRB                ;PHASE 0: wait for "not at level"
   353                                  AND TMP + 2
   354                                  EOR TMP + 3
   355                                  BEQ @w1
   356                                  LDA C64_CIA2_TBHI
   357                                  CMP TMP + 4
   358                                  BEQ @w0
   359                                  STA TMP + 4
   360                                  +caml_up_tmo @bad
   361                                  JMP @w0
   362                          @w1     LDA C64_CIA2_PRB                ;PHASE 1: wait for "at level"
   363                                  AND TMP + 2
   364                                  EOR TMP + 3
   365                                  BNE @start
   366                                  LDA C64_CIA2_TBHI
   367                                  CMP TMP + 4
   368                                  BEQ @w1
   369                                  STA TMP + 4                     ;256 more cycles gone
   370                                  +caml_up_tmo @bad
   371                                  JMP @w1
   372                          @start  LDX C64_CIA2_TBHI               ;timestamp (consistent read)
   373                                  LDA C64_CIA2_TBLO
   374                                  CPX C64_CIA2_TBHI
   375                                  BNE @start
   376                                  STA TMP + 5
   377                                  STX TMP + 6
   378                                  STX TMP + 4
   379                                  LDA # 65
   380                                  STA TMP + 7                     ;at most 64 blocks of 256 cycles
   381                          @w2     LDA C64_CIA2_PRB                ;PHASE 2: wait for the end of the level
   382                                  AND TMP + 2
   383                                  EOR TMP + 3
   384                                  BEQ @end
   385                                  LDA C64_CIA2_TBHI
   386                                  CMP TMP + 4
   387                                  BEQ @w2
   388                                  STA TMP + 4
   389                                  DEC TMP + 7
   390                                  BNE @w2
   391                                  BEQ @bad                        ;too long
   392                          @end    LDX C64_CIA2_TBHI
   393                                  LDA C64_CIA2_TBLO
   394                                  CPX C64_CIA2_TBHI
   395                                  BNE @end
   396                                  STA TMP + 8
   397                                  STX TMP + 9
   398                                  SEC                             ;width = start - end (down counter)
   399                                  LDA TMP + 5
   400                                  SBC TMP + 8
   401                                  PHA
   402                                  LDA TMP + 6
   403                                  SBC TMP + 9
   404                                  TAX
   405                                  PLA
   406                                  CPX # $40
   407                                  BCS @bad
   408                                  LDY # 0
   409                                  STY C64_CIA2_CRB                ;stop timer B
   410                                  +caml_up_ret_16
   411                                  RTS
   412                          @bad    LDY # 0
   413                                  STY C64_CIA2_CRB
   414                                  LDA # $FF
   415                                  STA ACCU                        ;Val_int(-1) = $FFFF
   416                                  STA ACCU + 1
   417                                  RTS
   418                          }
   419                          
   420                          ;; ----- Clock rate -> cycles ---------------------------------------------------
   421                          
   422                          ;; TMP:TMP+2 := round(clock / d), d in TMP+3:TMP+4 (<> 0); the clock is the CPU
   423                          ;; clock for the current video standard (C64_PALNTS): PAL 985248 Hz, NTSC
   424                          ;; 1022727 Hz. Clobbers A, X, TMP..TMP+7.
   425                          !ifdef caml_AUX__caml_up_clock_div {
   426                          caml_up_clock_div
   427                                  LDA C64_PALNTS
   428                                  BEQ @ntsc
   429                                  LDA # <985248
   430                                  STA TMP
   431                                  LDA # >985248 & $FF
   432                                  STA TMP + 1
   433                                  LDA # 985248 >> 16
   434                                  BNE @half                       ;BNE = JMP
   435                          @ntsc   LDA # <1022727
   436                                  STA TMP
   437                                  LDA # >1022727 & $FF
   438                                  STA TMP + 1
   439                                  LDA # 1022727 >> 16
   440                          @half   STA TMP + 2
   441                                  LDA TMP + 4                     ;dividend := clock + d / 2 (rounding)
   442                                  LSR
   443                                  STA TMP + 6
   444                                  LDA TMP + 3
   445                                  ROR
   446                                  CLC
   447                                  ADC TMP
   448                                  STA TMP
   449                                  LDA TMP + 6
   450                                  ADC TMP + 1
   451                                  STA TMP + 1
   452                                  BCC +
   453                                  INC TMP + 2
   454                          +       LDA # 0
   455                                  STA TMP + 5                     ;remainder R = TMP+5:TMP+6
   456                                  STA TMP + 6
   457                                  LDX # 24
   458                          -       ASL TMP                         ;dividend (becomes quotient) <<= 1,
   459                                  ROL TMP + 1
   460                                  ROL TMP + 2
   461                                  ROL TMP + 5                     ;R := R << 1 | carry
   462                                  ROL TMP + 6
   463                                  BCS @sub                        ;17 bits: R >= d
   464                                  LDA TMP + 5
   465                                  CMP TMP + 3
   466                                  LDA TMP + 6
   467                                  SBC TMP + 4
   468                                  BCC @next
   469                          @sub    SEC
   470                                  LDA TMP + 5
   471                                  SBC TMP + 3
   472                                  STA TMP + 5
   473                                  LDA TMP + 6
   474                                  SBC TMP + 4
   475                                  STA TMP + 6
   476                                  INC TMP                         ;quotient bit
   477                          @next   DEX
   478                                  BNE -
   479                                  RTS
   480                          }
   481                          
   482                          ;; cycles_of_rate hz: CPU cycles in a period of a signal of hz Hz (1 <= hz <= 16383):
   483                          ;; round(clock / hz), or -1 if hz = 0 or the result is >= 16384.
   484                          !ifdef caml_PRIM__caml_nonstd_up_cycles_of_rate {
   485                          caml_nonstd_up_cycles_of_rate
   486                                  +caml_up_acc16 TMP + 3
   487                                  LDA TMP + 3
   488                                  ORA TMP + 4
   489                                  BEQ @bad
   490                                  JSR caml_up_clock_div
   491                                  LDA TMP + 2
   492                                  BNE @bad
   493                                  LDX TMP + 1
   494                                  CPX # $40
   495                                  BCS @bad
   496                                  LDA TMP
   497                                  LDY # 0
   498                                  +caml_up_ret_16
   499                                  RTS
   500                          @bad    LDY # 0
   501                                  LDA # $FF
   502                                  STA ACCU
   503                                  STA ACCU + 1
   504                                  RTS
   505                          }
   506                          
   507                          ;; ----- Bit masks --------------------------------------------------------------
   508                          
   509                          !ifdef caml_AUX__caml_up_masks {
   510                          caml_up_masks
   511                                  !byte $01, $02, $04, $08, $10, $20, $40, $80
   512                          }
   513                          
   514                          ;; ----- SPI (master, bit banged, MSB first) ------------------------------------
   515                          ;; cfg (15 bit) = sck | mosi << 3 | miso << 6 (PB numbers 0..7), | cpol << 9
   516                          ;;      | cpha << 10 | nomiso << 12 (bit 11 is reserved)
   517                          ;; delay: busy loop of 5 * delay cycles at each half clock period (0..255)
   518                          
   519                          !macro caml_up_spi_half {               ;delay, preserves C
   520                                  LDX TMP + 6
   521                                  BEQ +
   522                          -       DEX
   523                                  BNE -
   524                          +
   525                          }
   526                          !macro caml_up_spi_clk {                ;toggle SCK, preserves C
   527                                  LDA TMP + 7
   528                                  EOR TMP + 0
   529                                  STA TMP + 7
   530                                  STA C64_CIA2_PRB
   531                          }
   532                          !macro caml_up_spi_put {                ;MOSI := C
   533                                  LDA TMP + 7
   534                                  AND TMP + 3
   535                                  BCC +
   536                                  ORA TMP + 1
   537                          +       STA TMP + 7
   538                                  STA C64_CIA2_PRB
   539                          }
   540                          !macro caml_up_spi_get {                ;IN := IN << 1 | MISO
   541                                  LDA C64_CIA2_PRB
   542                                  AND TMP + 2
   543                                  CMP # 1                         ;C := (MISO <> 0)
   544                                  ROL TMP + 9
   545                          }
   546                          
   547                          ;; in: cfg in TMP+20:TMP+21, delay in TMP+6.  Computes TMP+0 = SCK mask,
   548                          ;; TMP+1 = MOSI mask, TMP+2 = MISO mask (0 if none), TMP+3 = ~MOSI mask,
   549                          ;; TMP+4 = SCK mask if cpol else 0, TMP+5 = cpha; puts SCK in its idle state
   550                          ;; (shadow of PRB in TMP+7).  Clobbers A, X, TMP+22.
   551                          !ifdef caml_AUX__caml_up_spi_setup {
   552                          caml_up_spi_setup
   553                                  LDA TMP + 20
   554                                  AND # 7
   555                                  TAX
   556                                  LDA caml_up_masks,X
   557                                  STA TMP                         ;SCK mask
   558                                  LDA TMP + 20
   559                                  LSR
   560                                  LSR
   561                                  LSR
   562                                  AND # 7
   563                                  TAX
   564                                  LDA caml_up_masks,X
   565                                  STA TMP + 1                     ;MOSI mask
   566                                  EOR # $FF
   567                                  STA TMP + 3
   568                                  LDA TMP + 21                    ;miso = (cfg >> 6) & 7
   569                                  AND # 1
   570                                  ASL
   571                                  ASL
   572                                  STA TMP + 22
   573                                  LDA TMP + 20
   574                                  ASL
   575                                  ROL
   576                                  ROL
   577                                  AND # 3
   578                                  ORA TMP + 22
   579                                  TAX
   580                                  LDA caml_up_masks,X
   581                                  STA TMP + 2                     ;MISO mask
   582                                  LDA TMP + 21
   583                                  AND # %00010000                 ;nomiso
   584                                  BEQ +
   585                                  LDA # 0
   586                                  STA TMP + 2
   587                          +       LDA TMP + 21
   588                                  AND # %00000010                 ;cpol
   589                                  BEQ +
   590                                  LDA TMP
   591                          +       STA TMP + 4
   592                                  LDA TMP + 21
   593                                  LSR
   594                                  LSR
   595                                  AND # 1
   596                                  STA TMP + 5                     ;cpha
   597                                  LDA TMP
   598                                  EOR # $FF
   599                                  AND C64_CIA2_PRB
   600                                  ORA TMP + 4                     ;SCK := idle level (cpol)
   601                                  STA TMP + 7
   602                                  STA C64_CIA2_PRB
   603                                  RTS
   604                          }
   605                          
   606                          ;; A = byte to send -> A = byte received  (after caml_up_spi_setup)
   607                          !ifdef caml_AUX__caml_up_spi_byte {
   608                          caml_up_spi_byte
   609                                  STA TMP + 8
   610                                  LDA # 0
   611                                  STA TMP + 9
   612                                  LDA # 8
   613                                  STA TMP + 10
   614                          @bit    ASL TMP + 8                     ;C := next bit to send
   615                                  LDA TMP + 5
   616                                  BNE @cpha1
   617                                  +caml_up_spi_put                ;CPHA 0: data, leading edge (sample),
   618                                  +caml_up_spi_half
   619                                  +caml_up_spi_clk
   620                                  +caml_up_spi_get
   621                                  +caml_up_spi_half
   622                                  +caml_up_spi_clk                ;trailing edge
   623                                  JMP @next
   624                          @cpha1  +caml_up_spi_clk                ;CPHA 1: leading edge, data,
   625                                  +caml_up_spi_put
   626                                  +caml_up_spi_half
   627                                  +caml_up_spi_clk                ;trailing edge (sample)
   628                                  +caml_up_spi_get
   629                                  +caml_up_spi_half
   630                          @next   DEC TMP + 10
   631                                  BNE @bit
   632                                  LDA TMP + 9
   633                                  RTS
   634                          }
   635                          
   636                          ;; spi_xfer cfg delay byte -> byte
   637                          !ifdef caml_PRIM__caml_nonstd_up_spi_xfer {
   638                          caml_nonstd_up_spi_xfer
   639                                  +caml_up_acc16 TMP + 20
   640                                  +caml_up_s8 0
   641                                  STA TMP + 6                     ;delay
   642                                  +caml_up_s8 1
   643                                  PHA                             ;byte
   644                                  JSR caml_up_spi_setup
   645                                  PLA
   646                                  JSR caml_up_spi_byte
   647                                  LDY # 0
   648                                  +caml_up_ret8
   649                                  RTS
   650                          }
   651                          
   652                          ;; spi_buf cfg delay buf ofs len: full duplex in place on len bytes of buf
   653                          ;; (a Bytes), starting at ofs. NO CHECKS: the OCaml wrapper validates the range.
   654                          !ifdef caml_PRIM__caml_nonstd_up_spi_buf {
   655                          caml_nonstd_up_spi_buf
   656                                  +caml_up_acc16 TMP + 20
   657                                  +caml_up_s8 0
   658                                  STA TMP + 6                     ;delay
   659                                  LDY # 2
   660                                  LDA (SP),Y                      ;buf: the block address
   661                                  STA TMP + 24
   662                                  INY
   663                                  LDA (SP),Y
   664                                  STA TMP + 25
   665                                  +caml_up_s16 2, TMP + 26        ;ofs
   666                                  CLC
   667                                  LDA TMP + 24
   668                                  ADC TMP + 26
   669                                  STA TMP + 24
   670                                  LDA TMP + 25
   671                                  ADC TMP + 27
   672                                  STA TMP + 25
   673                                  +caml_up_s16 3, TMP + 26        ;len
   674                                  JSR caml_up_spi_setup
   675                          @loop   LDA TMP + 26
   676                                  ORA TMP + 27
   677                                  BEQ @done
   678                                  LDY # 0
   679                                  LDA (TMP + 24),Y
   680                                  JSR caml_up_spi_byte
   681                                  LDY # 0
   682                                  STA (TMP + 24),Y
   683                                  INC TMP + 24
   684                                  BNE +
   685                                  INC TMP + 25
   686                          +       LDA TMP + 26
   687                                  BNE +
   688                                  DEC TMP + 27
   689                          +       DEC TMP + 26
   690                                  JMP @loop
   691                          @done   LDY # 0
   692                                  +caml_up_ret_unit
   693                                  RTS
   694                          }
   695                          
   696                          ;; ----- UART (8N1, bit banged on PB0-PB7, timer A) ------------------------------
   697                          ;; cfg (15 bit) = pin | cycles_per_bit << 3  (cycles_per_bit <= 4095)
   698                          ;; uart_tx cfg byte; uart_rx cfg timeout -> byte, or -1 (timeout) or -2 (framing
   699                          ;; error). Interrupts are disabled while a frame is sent/received.
   700                          
   701                          !macro caml_up_wait_ta {                ;wait for the timer A underflow
   702                          -       LDA C64_CIA2_ICR
   703                                  LSR
   704                                  BCC -
   705                          }
   706                          
   707                          ;; in: TMP+20:TMP+21 = cfg.  out: TMP+2 = pin mask, TMP+4 = ~mask,
   708                          ;; TMP+20:TMP+21 = cycles per bit
   709                          !ifdef caml_AUX__caml_up_uart_cfg {
   710                          caml_up_uart_cfg
   711                                  LDA TMP + 20
   712                                  AND # 7
   713                                  TAX
   714                                  LDA caml_up_masks,X
   715                                  STA TMP + 2
   716                                  EOR # $FF
   717                                  STA TMP + 4
   718                                  LDX # 3
   719                          -       LSR TMP + 21
   720                                  ROR TMP + 20
   721                                  DEX
   722                                  BNE -
   723                                  RTS
   724                          }
   725                          
   726                          ;; Timing: the timer is started 6 cycles (LDA #, STA) after the start bit edge, so
   727                          ;; its first interval is shortened by KS+1 cycles.
   728                          caml_up_KS = 6
   729                          
   730                          !ifdef caml_PRIM__caml_nonstd_up_uart_tx {
   731                          caml_nonstd_up_uart_tx
   732                                  +caml_up_acc16 TMP + 20
   733                                  +caml_up_s8 0
   734                                  STA TMP + 3                     ;byte
   735                                  JSR caml_up_uart_cfg
   736                                  PHP
   737                                  SEI
   738                                  LDA # 0
   739                                  STA C64_CIA2_CRA                ;stop timer A
   740                                  LDA # C64_CIA_ICR_ALL
   741                                  STA C64_CIA2_ICR                ;no CIA2 interrupt source
   742                                  LDA C64_CIA2_ICR                ;acknowledge
   743                                  SEC                             ;counter := cpb - 1 - KS (first interval)
   744                                  LDA TMP + 20
   745                                  SBC # caml_up_KS + 1
   746                                  STA C64_CIA2_TALO
   747                                  LDA TMP + 21
   748                                  SBC # 0
   749                                  STA C64_CIA2_TAHI
   750                                  LDA # C64_CIA_CR_LOAD
   751                                  STA C64_CIA2_CRA
   752                                  SEC                             ;latch := cpb - 1
   753                                  LDA TMP + 20
   754                                  SBC # 1
   755                                  STA C64_CIA2_TALO
   756                                  LDA TMP + 21
   757                                  SBC # 0
   758                                  STA C64_CIA2_TAHI
   759                                  LDA C64_CIA2_PRB                ;start bit
   760                                  AND TMP + 4
   761                                  STA C64_CIA2_PRB
   762                                  LDA # C64_CIA_CR_START
   763                                  STA C64_CIA2_CRA
   764                                  LDX # 9                         ;8 data bits + stop bit
   765                          @bit    +caml_up_wait_ta
   766                                  SEC
   767                                  ROR TMP + 3                     ;C := next bit (the stop bit is a 1)
   768                                  LDA C64_CIA2_PRB
   769                                  AND TMP + 4
   770                                  BCC +
   771                                  ORA TMP + 2
   772                          +       STA C64_CIA2_PRB
   773                                  DEX
   774                                  BNE @bit
   775                                  +caml_up_wait_ta                ;end of the stop bit
   776                                  LDA # 0
   777                                  STA C64_CIA2_CRA
   778                                  PLP
   779                                  +caml_up_ret_unit
   780                                  RTS
   781                          }
   782                          
   783                          ;; rx: the sample point is 1.5 bit times after the start bit edge; the edge is
   784                          ;; detected within ~10 cycles, then the timer starts 6 cycles later (KR).
   785                          caml_up_KR = 16
   786                          
   787                          !ifdef caml_PRIM__caml_nonstd_up_uart_rx {
   788                          caml_nonstd_up_uart_rx
   789                                  +caml_up_acc16 TMP + 20
   790                                  +caml_up_s16 0, TMP             ;timeout, in 256-cycle blocks
   791                                  JSR caml_up_uart_cfg
   792                                  PHP
   793                                  SEI
   794                                  LDA # 0
   795                                  STA C64_CIA2_CRA
   796                                  LDA # C64_CIA_ICR_ALL
   797                                  STA C64_CIA2_ICR
   798                                  LDA C64_CIA2_ICR
   799                                  LDA TMP + 21                    ;TMP+22:TMP+23 := 1.5 * cpb
   800                                  LSR
   801                                  STA TMP + 23
   802                                  LDA TMP + 20
   803                                  ROR
   804                                  CLC
   805                                  ADC TMP + 20
   806                                  STA TMP + 22
   807                                  LDA TMP + 23
   808                                  ADC TMP + 21
   809                                  STA TMP + 23
   810                                  SEC                             ;counter := 1.5 cpb - 1 - KR
   811                                  LDA TMP + 22
   812                                  SBC # caml_up_KR + 1
   813                                  STA C64_CIA2_TALO
   814                                  LDA TMP + 23
   815                                  SBC # 0
   816                                  STA C64_CIA2_TAHI
   817                                  LDA # C64_CIA_CR_LOAD
   818                                  STA C64_CIA2_CRA
   819                                  SEC                             ;latch := cpb - 1
   820                                  LDA TMP + 20
   821                                  SBC # 1
   822                                  STA C64_CIA2_TALO
   823                                  LDA TMP + 21
   824                                  SBC # 0
   825                                  STA C64_CIA2_TAHI
   826                                  LDA # 0
   827                                  STA C64_CIA2_CRB                ;timer B: free running, the timeout clock
   828                                  LDA # $FF
   829                                  STA C64_CIA2_TBLO
   830                                  STA C64_CIA2_TBHI
   831                                  LDA # C64_CIA_CR_LOAD | C64_CIA_CR_START
   832                                  STA C64_CIA2_CRB
   833                                  LDA C64_CIA2_TBHI
   834                                  STA TMP + 4
   835                          @wait   LDA C64_CIA2_PRB                ;wait for the start bit (low)
   836                                  AND TMP + 2
   837                                  BEQ @edge
   838                                  LDA C64_CIA2_TBHI
   839                                  CMP TMP + 4
   840                                  BEQ @wait
   841                                  STA TMP + 4
   842                                  LDA TMP
   843                                  BNE +
   844                                  LDA TMP + 1
   845                                  BEQ @tmout
   846                                  DEC TMP + 1
   847                          +       DEC TMP
   848                                  JMP @wait
   849                          @edge   LDA # C64_CIA_CR_START
   850                                  STA C64_CIA2_CRA
   851                                  LDX # 8
   852                          @bit    +caml_up_wait_ta
   853                                  LDA C64_CIA2_PRB
   854                                  AND TMP + 2
   855                                  CMP # 1                         ;C := bit
   856                                  ROR TMP + 3                     ;LSB first
   857                                  DEX
   858                                  BNE @bit
   859                                  +caml_up_wait_ta                ;middle of the stop bit
   860                                  LDA C64_CIA2_PRB
   861                                  AND TMP + 2
   862                                  BEQ @frame                      ;stop bit low: framing error
   863                                  LDA # 0
   864                                  STA C64_CIA2_CRA
   865                                  STA C64_CIA2_CRB
   866                                  PLP
   867                                  LDA TMP + 3
   868                                  LDY # 0
   869                                  +caml_up_ret8
   870                                  RTS
   871                          @frame  LDA # 0
   872                                  STA C64_CIA2_CRA
   873                                  STA C64_CIA2_CRB
   874                                  PLP
   875                                  LDY # 0
   876                                  LDA # $FE                       ;Val_int(-2) = $FFFD
   877                                  STA ACCU
   878                                  LDA # $FF
   879                                  STA ACCU + 1
   880                                  LDA # $FD
   881                                  STA ACCU
   882                                  RTS
   883                          @tmout  LDA # 0
   884                                  STA C64_CIA2_CRA
   885                                  STA C64_CIA2_CRB
   886                                  PLP
   887                                  LDY # 0
   888                                  LDA # $FF
   889                                  STA ACCU                        ;Val_int(-1) = $FFFF
   890                                  STA ACCU + 1
   891                                  RTS
   892                          }
   893                          
   894                          ;; ----- Tone: square wave on PB6 (timer A) or PB7 (timer B) ---------------------
   895                          ;; tone pin hz: half period = round(clock / (2 hz)) cycles, 8 <= hz <= 16383.
   896                          ;; tone_stop pin. Returns false if hz is out of range or pin is not 6 or 7.
   897                          
   898                          !ifdef caml_PRIM__caml_nonstd_up_tone {
   899                          caml_nonstd_up_tone
   900                                  +caml_up_s16 0, TMP + 3         ;hz
   901                                  LDA TMP + 4
   902                                  BNE @hzok
   903                                  LDA TMP + 3
   904                                  CMP # 8
   905                                  BCC @bad
   906                          @hzok   ASL TMP + 3                     ;d := 2 hz (<= 32766)
   907                                  ROL TMP + 4
   908                                  +caml_up_a8                     ;pin
   909                                  STA TMP + 12
   910                                  CMP # 6
   911                                  BEQ +
   912                                  CMP # 7
   913                                  BNE @bad
   914                          +       JSR caml_up_clock_div
   915                                  LDA TMP + 2
   916                                  BNE @bad                        ;(not reached: hz >= 8)
   917                                  LDA TMP                         ;latch := half - 1
   918                                  BNE +
   919                                  DEC TMP + 1
   920                          +       DEC TMP
   921                                  LDA TMP + 12
   922                                  CMP # 7
   923                                  BEQ @tb
   924                                  LDA # 0                         ;timer A on PB6
   925                                  STA C64_CIA2_CRA
   926                                  LDA TMP
   927                                  STA C64_CIA2_TALO
   928                                  LDA TMP + 1
   929                                  STA C64_CIA2_TAHI
   930                                  LDA C64_CIA2_DDRB
   931                                  ORA # %01000000
   932                                  STA C64_CIA2_DDRB
   933                                  LDA # C64_CIA_CR_LOAD | C64_CIA_CR_PBON | C64_CIA_CR_TOGGLE | C64_CIA_CR_START
   934                                  STA C64_CIA2_CRA
   935                                  BNE @ok                         ;BNE = JMP
   936                          @tb     LDA # 0                         ;timer B on PB7
   937                                  STA C64_CIA2_CRB
   938                                  LDA TMP
   939                                  STA C64_CIA2_TBLO
   940                                  LDA TMP + 1
   941                                  STA C64_CIA2_TBHI
   942                                  LDA C64_CIA2_DDRB
   943                                  ORA # %10000000
   944                                  STA C64_CIA2_DDRB
   945                                  LDA # C64_CIA_CR_LOAD | C64_CIA_CR_PBON | C64_CIA_CR_TOGGLE | C64_CIA_CR_START
   946                                  STA C64_CIA2_CRB
   947                          @ok     LDY # 0
   948                                  LDA # 1
   949                                  +caml_up_ret_bool
   950                                  RTS
   951                          @bad    LDY # 0
   952                                  LDA # 0
   953                                  +caml_up_ret_bool
   954                                  RTS
   955                          }
   956                          !ifdef caml_PRIM__caml_nonstd_up_tone_stop {
   957                          caml_nonstd_up_tone_stop
   958                                  +caml_up_a8
   959                                  CMP # 7
   960                                  BEQ @tb
   961                                  LDA # 0
   962                                  STA C64_CIA2_CRA                ;timer A stopped, PB6 back to port B
   963                                  BEQ @end                        ;BEQ = JMP
   964                          @tb     LDA # 0
   965                                  STA C64_CIA2_CRB
   966                          @end    +caml_up_ret_unit
   967                                  RTS
   968                          }
   969                          
   970                          } ;end of zone
