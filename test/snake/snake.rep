   311                          
   312                          !ifdef caml_PRIM__caml_classify_float {
   313                          caml_classify_float
   314                                  +Val_Int ~@FP_normal,    0      ;order must match variants in
   315                                  +Val_Int ~@FP_subnormal, 1      ;type Float.fpclass
   316                                  +Val_Int ~@FP_zero,      2
   317                                  +Val_Int ~@FP_infinite,  3
   318                                  +Val_Int ~@FP_nan,       4
   319                                  LDY # Float_flag
   320                                  LDA (ACCU),Y
   321                                  BNE @spec
   322                                  TAY                             ;.Y = 0
   323                                  LDA (ACCU),Y                    ;exponent
   324                                  STY ACCU + 1
   325                                  BEQ @zero
   326                                  LDA # @FP_normal
   327                                  STA ACCU
   328                                  RTS
   329                          @zero   LDA # @FP_zero
   330                                  STA ACCU
   331                                  RTS
   332                          @spec   LDX # @FP_infinite
   333                                  CMP # Fl_nan
   334                                  BNE @set
   335                                  LDX # @FP_nan
   336                          @set    STX ACCU
   337                                  LDY # 0
   338                                  STY ACCU + 1
   339                                  RTS
   340                          }
   341                          
   342                          !ifdef caml_PRIM__caml_int_of_float {
   343                          caml_int_of_float
   344                                  JSR caml_float_unop
   345                                  BCC @fin
   346                                  LDX # $FF                       ;special value (.A = flag):
   347                                  LDY # $7F                       ; +inf gives the largest int,
   348                                  CMP # Fl_pinf
   349                                  BEQ @set
   350                                  LDX # $01                       ; -inf the smallest,
   351                                  LDY # $80
   352                                  CMP # Fl_ninf
   353                                  BEQ @set
   354                                  LDY # 0                         ; nan gives 0.
   355                          @set    STX ACCU
   356                                  STY ACCU + 1
   357                                  LDY # 0
   358                                  RTS
   359                          @fin    LDA C64_FAC + 5                 ;FAC sign byte
   360                                  PHA                             ;save sign
   361                                  LDA # 0
   362                                  STA C64_FAC + 5                 ;FAC := |FAC| (FACINX floors, OCaml
   363                                  +caml_JSR_BASROM C64_FACINX     ; truncates) => result in Y(lo), A(hi)
   364                                  STY ACCU
   365                                  STA ACCU + 1
   366                                  PLA
   367                                  BPL +                           ;negative argument:
   368                                  SEC                             ; negate the (truncated) magnitude
   369                                  LDA # 0
   370                                  SBC ACCU
   371                                  STA ACCU
   372                                  LDA # 0
   373                                  SBC ACCU + 1
   374                                  STA ACCU + 1
   375                          +       SEC
   376                                  ROL ACCU                        ;OCaml int repr
   377                                  ROL ACCU + 1
   378                                  LDY # 0
   379                                  RTS
   380                          }
   381                          
   382                          !ifdef caml_PRIM__caml_float_of_int {
   383                          caml_float_of_int
   384                                  LDA ACCU + 1
   385                                  CMP # $80                       ;CMP + ROR = arithm. shift right
   386                                  ROR
   387                                  TAX
   388                                  ROR ACCU
   389                                  LDY ACCU
   390                                  TXA
   391                                  +caml_JSR_BASROM C64_GIVAYF
   392                                  JMP caml_float_alloc_result
   393                          }
   394                          
   395                          !ifdef caml_PRIM__caml_copysign_float {
   396                          caml_copysign_float
   397                                  ;; |ACCU| with the sign of SP[0] (the sign of nan is taken as '+')
   398                                  LDY # 0
   399                                  LDA (SP),Y
   400                                  STA TMP
   401                                  INY
   402                                  LDA (SP),Y
   403                                  STA TMP + 1                     ;(TMP) = SP[0]
   404                                  LDY # Float_flag
   405                                  LDA (TMP),Y
   406                                  BNE @yspec
   407                                  LDY # 1                         ;finite: load 1st mantissa byte of
   408                                  LDA (TMP),Y                     ; SP[0] (its bit 7 is the sign)
   409                          @sign   PHA
   410                                  JSR caml_float_unop             ;ACCU --> FAC
   411                                  PLA                             ;(this and TAX do not touch C)
   412                                  TAX
   413                                  BCS @spx
   414                                  STA C64_FAC + 5                 ;copy the sign to FAC sign byte
   415                                  JMP caml_float_alloc_result
   416                          @yspec  CMP # Fl_ninf                   ;special: C=1 only if -inf
   417                                  LDA # 0
   418                                  ROR                             ;bit 7 of .A = sign of SP[0]
   419                                  JMP @sign
   420                          @spx    LDY # Float_flag                ;ACCU is special:
   421                                  LDA (ACCU),Y
   422                                  CMP # Fl_nan
   423                                  BNE @inf
   424                                  LDY # 0                         ; nan: result is ACCU itself
   425                                  RTS
   426                          @inf    LDA # Ft_PINF                   ; infinity:
   427                                  CPX # $80                       ;  C=1 if the sign is '-'
   428                                  BCC @tpl
   429                                  LDA # Ft_NINF
   430                          @tpl    JMP caml_float_ret_tpl
   431                          }
   432                          
   433                          !ifdef caml_PRIM__caml_float_of_string {
   434                          caml_float_of_string
   435                                  ;; Special values first: [+|-] ("nan" | "inf" | "infinity"), any case
   436                                  LDY # 0
   437                                  STY TMP + 2                     ;sign ($FF = '-')
   438                                  LDA (ACCU),Y
   439                                  CMP # '-'
   440                                  BNE @plus
   441                                  DEC TMP + 2
   442                                  INY
   443                                  BNE @word                       ;BNE=JMP
   444                          @plus   CMP # '+'
   445                                  BNE @word
   446                                  INY
   447                          @word   STY TMP + 3
   448                                  LDX # @w_nan - @words
   449                                  JSR @try
   450                                  BEQ @isnan
   451                                  LDX # @w_inf - @words
   452                                  LDY TMP + 3
   453                                  JSR @try
   454                                  BEQ @isinf
   455                                  LDX # @w_infinity - @words
   456                                  LDY TMP + 3
   457                                  JSR @try
   458                                  BNE @num                        ;no match: it is a number
   459                          @isinf  LDA # Ft_PINF
   460                                  BIT TMP + 2
   461                                  BPL @tpl
   462                                  LDA # Ft_NINF
   463                                  BNE @tpl                        ;BNE=JMP
   464                          @isnan  LDA # Ft_NAN
   465                          @tpl    JMP caml_float_ret_tpl
   466                          @try    LDA @words,X                    ;match string at (ACCU),Y with word X
   467                                  BEQ @end                        ; (case-insensitive: PETSCII uppercase
   468                                  LDA (ACCU),Y                    ; letters are $C1-$DA, lowercase $41-$5A)
   469                                  AND # $7F
   470                                  CMP @words,X
   471                                  BNE @no                         ;mismatch: return Z=0
   472                                  INY
   473                                  INX
   474                                  BNE @try                        ;BNE=JMP
   475                          @end    LDA (ACCU),Y                    ;string must end here: return Z=1 if so
   476                          @no     RTS
   477                          @words
   478                          @w_nan      !text "nan", 0
   479                          @w_inf      !text "inf", 0
   480                          @w_infinity !text "infinity", 0
   481                          @num    TSX                             ;overflow (+-infinity): see
   482                                  STX caml_float_overflow__sp     ; caml_float_overflow
   483                                  LDA # Fo_STR
   484                                  STA caml_float_overflow__op
   485                                  LDA C64_CHRPTR                  ;Save the current CHRPTR value
   486                                  STA TMP
   487                                  LDA C64_CHRPTR + 1
   488                                  STA TMP + 1
   489                                  LDA ACCU + 1
   490                                  LDX ACCU
   491                          !ifdef caml_basic_rom_overlap {
   492                                  ;; FIN reads the string with the BASIC ROM on, but the string may be in
   493                                  ;; the RAM under it ($A000-$BFFF): copy it (0-terminated, max 80 chars)
   494                                  ;; to the BASIC input buffer and convert the copy.
   495                                  CMP # > (C64_BASROM - 79)       ;If the first 80 characters of the
   496                                  BCC @setptr                     ; string are below $A000, skip the copy
   497                                  BNE @setptr                     ; and set the pointer to ACCU;
   498                                  CPX # < (C64_BASROM - 79)
   499                                  BCC @setptr
   500                                  LDY # 0                         ;else copy the string to the buffer
   501                          -       LDA (ACCU),Y
   502                                  STA C64_BUF,Y
   503                                  BEQ +
   504                                  INY
   505                                  CPY # 80
   506                                  BCC -
   507                                  LDA # 0
   508                                  STA C64_BUF,Y
   509                          +       LDA # >C64_BUF                  ; and set the pointer to it.
   510                                  LDX # <C64_BUF
   511                          }
   512                          @setptr STA C64_CHRPTR + 1              ;CHRPTR := A:X
   513                                  STX C64_CHRPTR
   514                                  JSR C64_CHRGOT                  ;not a BASIC ROM routine
   515                                  +caml_JSR_BASROM C64_FIN        ;String to float conversion routine
   516                                  ;; FIN never fails: it converts the longest valid prefix (0 if none) and
   517                                  ;; leaves C64_CHRPTR at the first character it did not use. Accept only
   518                                  ;; a string that FIN consumed up to its end (0 byte)...
   519                                  LDY # 0
   520                                  LDA (C64_CHRPTR),Y
   521                                  BNE @bad                        ;trailing garbage ("12abc", "abc")
   522                                  LDA C64_FAC
   523                                  BNE @good                       ;...and, if the result is 0, only if
   524                          @dig    LDA (ACCU),Y                    ; there is a mantissa digit before the
   525                                  BEQ @bad                        ; exponent: "-", ".", "", "e5" are not
   526                                  CMP # $45                       ; numbers, "0", "-0.0", "0e5" are.
   527                                  BEQ @bad                        ;$45 = 'e'
   528                                  EOR # $30
   529                                  CMP # 10
   530                                  BCC @good                       ;a digit
   531                                  INY
   532                                  BNE @dig
   533                          @bad    LDA TMP                         ;Restore the previous value of CHRPTR
   534                                  STA C64_CHRPTR
   535                                  LDA TMP + 1
   536                                  STA C64_CHRPTR + 1
   537                                  +caml_raise Failure, "float_of_string"
   538                          @good   LDA TMP                         ;Restore the previous value of CHRPTR
   539                                  STA C64_CHRPTR
   540                                  LDA TMP + 1
   541                                  STA C64_CHRPTR + 1
   542                                  JMP caml_float_alloc_result
   543                          }
   544                          
   545                          !ifdef caml_PRIM__caml_ldexp_float {
   546                                  ;; compute ACCU * 2 ^ N, -255 < N < 255.
   547                                  ;; SP[0] = Val_int(N) (usual tagged int, two's complement if N < 0)
   548                          caml_ldexp_float
   549                                  LDY # Float_flag
   550                                  LDA (ACCU),Y
   551                                  BEQ @fin
   552                                  LDY # 0                         ;nan, +-infinity: ldexp x n = x
   553                                  RTS
   554                          @fin    LDY # 0
   555                                  LDA # Double_tag
   556                                  LDX # Double_wosize
   557                                  JSR caml_alloc                  ;{Y = 0}
   558                                  LDA # 0                         ;the flag byte of the result is 0
   559                                  LDY # Float_flag                ; (ldexp x n = x if x is nan or inf,
   560                                  STA (BLK),Y                     ;  see below)
   561                                  TAY                             ;.Y = 0
   562                                  LDA (ACCU),Y                    ;(biased) exponent of the source
   563                                  BEQ @save                       ;0.0 * 2^N = 0.0: don't add N to exp 0
   564                                  STA TMP
   565                                  INY
   566                                  LDA (SP),Y                      ;hi byte of Val_int(N)
   567                                  TAX                             ;X: bit 7 = sign of N
   568                                  LSR                             ;C := bit 0 of hi byte
   569                                  DEY
   570                                  LDA (SP),Y
   571                                  ROR                             ;A := low byte of N (two's complement)
   572                                  STA TMP + 1
   573                                  TXA
   574                                  BMI @neg                        ;N < 0 ?
   575                                  LDA TMP + 1                     ;no: exp := exp + N
   576                                  CLC
   577                                  ADC TMP
   578                                  BCC @save
   579                                  LDY # 1                         ; overflow: +-infinity,
   580                                  LDA (ACCU),Y                    ;  with the sign of the source
   581                                  BMI @ninf
   582                                  LDA # Ft_PINF
   583                                  BNE @tpl                        ;BNE=JMP
   584                          @ninf   LDA # Ft_NINF
   585                          @tpl    JMP caml_float_ret_tpl
   586                          @neg    LDA TMP + 1                     ;yes: exp := exp - |N| = exp + (256-|N|)
   587                                  CLC
   588                                  ADC TMP
   589                                  BCS @save                       ; if underflow,
   590                                  LDA # 0                         ;  set exp = 0 (result = 0.0)
   591                          @save   STA (BLK),Y                     ;save exp byte (Y = 0)
   592                                  BEQ +                           ;skip copy of mantissa if zero
   593                                  LDY # 4
   594                          -       LDA (ACCU),Y                    ;copy mantissa
   595                                  STA (BLK),Y
   596                                  DEY
   597                                  BNE -
   598                          +       JMP caml_load_newblk
   599                          }
   600                          
   601                          !ifdef caml_PRIM__caml_frexp_float {
   602                          caml_frexp_float
   603                                  ;; allocate a new float with same mantissa and exp=0
   604                                  LDA # Double_tag                ;tag of new float
   605                                  LDX # Double_wosize             ;size of new float
   606                                  JSR caml_alloc                  ;alloc new float
   607                                  LDY # Float_flag
   608                                  LDA (ACCU),Y
   609                                  STA (BLK),Y                     ;copy the flag byte
   610                                  BEQ @fin
   611                                  LDY # 4                         ;nan, +-infinity: frexp x = (x, 0)
   612                          -       LDA (ACCU),Y                    ; copy the float,
   613                                  STA (BLK),Y
   614                                  DEY
   615                                  BPL -
   616                                  INY
   617                                  TYA
   618                                  PHA                             ; and set the exponent to 0
   619                                  BEQ @pair
   620                          @fin    LDY # 0
   621                                  LDA (ACCU),Y                    ;load (biased) exponent
   622                                  PHA                             ;save it for later
   623                                  BNE @nz                         ;float is 0.0?
   624                                  STA (BLK),Y                     ;yes: set new float exp = 0
   625                                  BEQ @pair                       ; and go further
   626                          @nz     LDA # $80                       ;no: set new float exp = $80
   627                                  STA (BLK),Y
   628                                  LDY # 4                         ; then copy the mantissa
   629                          -       LDA (ACCU),Y
   630                                  STA (BLK),Y
   631                                  DEY
   632                                  BNE -
   633                          @pair   JSR caml_load_newblk            ;ACCU = new float
   634                                  ;; allocate a new pair (float * int)
   635                                  LDA # 0                         ;tag of new pair
   636                                  LDX # 2                         ;size of new pair
   637                                  JSR caml_alloc                  ;alloc new pair
   638                                  ;; set pair elements
   639                                  LDA ACCU
   640                                  STA (BLK),Y
   641                                  INY
   642                                  LDA ACCU + 1
   643                                  STA (BLK),Y                     ;field0 := new float
   644                                  INY
   645                                  LDX # 0
   646                                  PLA                             ;reload biased exponent
   647                                  BNE @debias                     ;exp = 0?
   648                                  LDA # <Val_zero                 ;yes:
   649                                  STA (BLK),Y                     ; set field1,lo := <Val_int(0)
   650                                  LDA # >Val_zero
   651                                  BEQ @fld1h                      ; beq=jmp to set field1,hi
   652                          @debias SEC                             ;no:
   653                                  SBC # $80                       ; compute debiased exponent
   654                                  BCS @valint                     ; if negative,
   655                                  DEX                             ;  set hi byte = $FF
   656                                  SEC
   657                          @valint ROL                             ; compute <Val_int(exponent)
   658                                  STA (BLK),Y                     ; field1,lo := <Val_int(exponent)
   659                                  TXA
   660                                  ROL                             ; compute >Val_int(exponent)
   661                          @fld1h  INY
   662                                  STA (BLK),Y                     ;field1,hi := >Val_int(exponent)
   663                                  LDY # 0
   664                                  JMP caml_load_newblk   
   665                          }
   666                          
   667                          !ifdef caml_PRIM__caml_add_float {
   668                          caml_add_float
   669                                  JSR caml_float_binop
   670                                  BCC @fin
   671                                  LDX # Fb_ADD
   672                                  JMP caml_float_special2
   673                          @fin    LDX # Fo_ADD                        ;(overflow: +-infinity)
   674                                  STX caml_float_overflow__op
   675                                  +caml_JSR_BASROM C64_FADDT
   676                                  JMP caml_float_alloc_result
   677                          }
   678                          
   679                          !ifdef caml_PRIM__caml_sub_float {
   680                          caml_sub_float
   681                                  JSR caml_float_binop
   682                                  BCC @fin
   683                                  LDX # Fb_SUB
   684                                  JMP caml_float_special2
   685                          @fin    LDX # Fo_ADD                        ;(overflow: +-infinity)
   686                                  STX caml_float_overflow__op
   687                                  +caml_JSR_BASROM C64_FSUBT
   688                                  JMP caml_float_alloc_result
   689                          }
   690                          
   691                          !ifdef caml_PRIM__caml_mul_float {
   692                          caml_mul_float
   693                                  JSR caml_float_binop
   694                                  BCC @fin
   695                                  LDX # Fb_MUL
   696                                  JMP caml_float_special2
   697                          @fin    LDX # Fo_MUL                        ;(overflow: +-infinity)
   698                                  STX caml_float_overflow__op
   699                                  +caml_JSR_BASROM C64_FMULT
   700                                  JMP caml_float_alloc_result
   701                          }
   702                          
   703                          !ifdef caml_PRIM__caml_div_float {
   704                          caml_div_float
   705                                  JSR caml_float_binop
   706                                  BCC @fin
   707                                  LDX # Fb_DIV
   708                                  JMP caml_float_special2
   709                          @fin    BEQ @dz                         ;FAC exponent = 0: division by zero
   710                                  LDX # Fo_MUL                    ;(overflow: +-infinity)
   711                                  STX caml_float_overflow__op
   712                                  +caml_JSR_BASROM C64_FDIVT
   713                                  JMP caml_float_alloc_result
   714                          @dz     LDA C64_ARG                     ;x / 0.0: nan if x = 0.0, else
   715                                  BEQ @nan                        ; +-infinity with the sign of x
   716                                  LDA C64_ARG + 5
   717                                  BPL @pinf
   718                                  LDA # Ft_NINF
   719                                  BNE @tpl                        ;BNE=JMP
   720                          @pinf   LDA # Ft_PINF
   721                                  BNE @tpl                        ;BNE=JMP
   722                          @nan    LDA # Ft_NAN
   723                          @tpl    JMP caml_float_ret_tpl
   724                          }
   725                          
   726                          !ifdef caml_PRIM__caml_power_float {
   727                          caml_power_float
   728                                  JSR caml_float_binop
   729                                  BCC @fin
   730                                  LDX # Fb_POW
   731                                  JMP caml_float_special2
   732                          @fin    LDA C64_ARG                     ;x = 0.0 ?
   733                                  BNE @xnz
   734                                  BIT C64_FAC + 5                 ;yes: 0.0 ** (y<0) = +infinity
   735                                  BPL @rom                        ; (other cases are managed by ROM)
   736                                  LDA # Ft_PINF
   737                                  BNE @tpl                        ;BNE=JMP
   738                          @xnz    BIT C64_ARG + 5                 ;x < 0 ?
   739                                  BPL @rom
   740                                  LDY # 0                         ;yes: (x<0) ** y is nan if y is not
   741                                  LDA (SP),Y                      ; an integer (ROM raises an error)
   742                                  STA TMP
   743                                  INY
   744                                  LDA (SP),Y
   745                                  STA TMP + 1                     ;(TMP) = y
   746                                  JSR caml_float_intclass
   747                                  TAX
   748                                  BNE @rom
   749                                  LDA # Ft_NAN
   750                          @tpl    JMP caml_float_ret_tpl
   751                          @rom    LDX # Fo_POW                    ;(overflow: +-infinity)
   752                                  STX caml_float_overflow__op
   753                                  LDA C64_FAC                     ;ROM wants .A = FAC exponent
   754                                  +caml_JSR_BASROM C64_FPWRT
   755                                  JMP caml_float_alloc_result
   756                          }
   757                          
   759                          ;; Auxiliary routines
   760                          
   761                          ;; copy ACCU to FAC. Return C=1 if ACCU is special, .A = flag byte
   762                          !ifdef caml_AUX__caml_float_unop {
   763                          caml_float_unop
   764  837a ba                         TSX                             ;Save the CPU stack pointer as it will
   765  837b e8                         INX                             ; be after returning to the primitive
   766  837c e8                         INX                             ; (see caml_float_overflow)
   767  837d 8ea784                     STX caml_float_overflow__sp
   768  8380 a9ff                       LDA # Fo_NONE
   769  8382 8da884                     STA caml_float_overflow__op     ;the primitive may change it
   770  8385 a5fb                       LDA ACCU
   771  8387 8d9883                     STA caml_float_loadFAC__addr
   772  838a a5fc                       LDA ACCU + 1
   773  838c 8d9983                     STA caml_float_loadFAC__addr + 1
   774  838f 209583                     JSR caml_float_loadFAC          ;.A = flag byte
   775  8392 c901                       CMP # 1                         ;C=1 <=> flag <> 0
   776  8394 60                         RTS
   777                          }
   778                          
   779                          ;; copy SP[0] to FAC and ACCU to ARG. Return C=1 if one of them is special,
   780                          ;; else C=0, .A = FAC exponent (and flags .Z, .N according to .A), .Y = 0
   781                          !ifdef caml_AUX__caml_float_binop {
   782                          caml_float_binop
   783                                  TSX                             ;as above
   784                                  INX
   785                                  INX
   786                                  STX caml_float_overflow__sp
   787                                  LDA # Fo_NONE
   788                                  STA caml_float_overflow__op
   789                                  LDA (SP),Y
   790                                  STA caml_float_loadFAC__addr
   791                                  INY
   792                                  LDA (SP),Y
   793                                  STA caml_float_loadFAC__addr + 1
   794                                 ;DEY                             ;caml_float_alloc_result will set Y=0
   795                                  JSR caml_float_loadFAC
   796                                  STY TMP                         ;flag byte of SP[0]
   797                                  LDA ACCU
   798                                  STA caml_float_loadARG__addr
   799                                  LDA ACCU + 1
   800                                  STA caml_float_loadARG__addr + 1
   801                                  JSR caml_float_loadARG          ;.Y = flag byte of ACCU, .A = FAC exp
   802                                  PHA
   803                                  TYA
   804                                  ORA TMP                         ;0 <=> both finite
   805                                  CMP # 1                         ;C=1 <=> at least one is special
   806                                  PLA                             ;(does not touch C)
   807                                  RTS
   808                          }
   809                          
   810                          ;; Copy FAC (operation result) to a new allocated float. Flag byte := 0
   811                          !ifdef caml_AUX__caml_float_alloc_result {
   812                          caml_float_alloc_result
   813                                  LDA # Double_tag
   814                                  LDX # Double_wosize
   815                                  LDY # 0
   816                                  JSR caml_alloc
   817                                  LDX BLK
   818                                  LDY BLK + 1
   819                                  +caml_JSR_BASROM C64_MOVMF
   820                                  LDY # Float_flag
   821                                  LDA # 0
   822                                  STA (BLK),Y                     ;finite
   823                                  TAY
   824                                  JMP caml_load_newblk   
   825                          }
   826                          
   827                          ;; FAC/ARG loading routines -- how to use: 1) write float address in
   828                          ;; caml_float_loadFAC/ARG__addr; 2) JSR caml_float_loadFAC/ARG
   829                          ;; FAC: return .A = .Y = flag byte of the float. ARG: return .Y = flag byte,
   830                          ;; .A = FAC exponent
   831                          
   832                          !ifdef caml_AUX__caml_float_loadFAC {
   833                          caml_float_loadFAC
   834  8395 a205                       LDX # 5
   835                          caml_float_loadFAC__addr = * + 1
   836  8397 bd3412             -       LDA .dummy,X                    ;SMC: replaced with real address
   837  839a 9561                       STA C64_FAC,X
   838  839c ca                         DEX
   839  839d 10f8                       BPL -
   840  839f a466                       LDY C64_FAC + 5                 ;flag byte
   841  83a1 a562                       LDA C64_FAC + 1                 ;copy 1st byte of mantissa
   842  83a3 8566                       STA C64_FAC + 5                 ;to FAC sign byte
   843  83a5 0980                       ORA # $80
   844  83a7 8562                       STA C64_FAC + 1                 ;set 1st bit of mantissa = 1
   845  83a9 e8                         INX
   846  83aa 8670                       STX C64_FACRND                  ;FAC round byte := 0
   847  83ac 98                         TYA                             ;.A = flag byte (sets .Z)
   848  83ad 60                         RTS
   849                          }
   850                          
   851                          !ifdef caml_AUX__caml_float_loadARG {
   852                          caml_float_loadARG
   853                                  LDX # 5
   854                          caml_float_loadARG__addr = * + 1
   855                          -       LDA .dummy,X                    ;SMC: replaced with real address
   856                                  STA C64_ARG,X
   857                                  DEX
   858                                  BPL -
   859                                  LDY C64_ARG + 5                 ;flag byte
   860                                  LDX C64_ARG + 1                 ;copy 1st byte of mantissa
   861                                  STX C64_ARG + 5                 ;to ARG sign byte
   862                                  TXA
   863                                  EOR C64_FAC + 5                 ;compare with FAC sign byte
   864                                  STA C64_ARISGN                  ;store result of comparison
   865                                  TXA
   866                                  ORA # $80
   867                                  STA C64_ARG + 1                 ;set 1st bit of mantissa = 1
   868                                  LDA C64_FAC                     ;.A := FAC exponent
   869                                  RTS
   870                          }
   871                          
   872                          ;; Allocate a new float, copying the template at offset .A (Ft_*) in the table
   873                          !ifdef caml_AUX__caml_float_ret_tpl {
   874                          caml_float_ret_tpl
   875  83ae 48                         PHA
   876  83af a9fd                       LDA # Double_tag
   877  83b1 a203                       LDX # Double_wosize
   878  83b3 a000                       LDY # 0
   879  83b5 201f7b                     JSR caml_alloc
   880  83b8 68                         PLA
   881  83b9 aa                         TAX
   882  83ba a000                       LDY # 0
   883  83bc bdcc83             -       LDA caml_float_ret_tpl__tab,X
   884  83bf 914b                       STA (BLK),Y
   885  83c1 e8                         INX
   886  83c2 c8                         INY
   887  83c3 c006                       CPY # 6
   888  83c5 d0f5                       BNE -
   889  83c7 a000                       LDY # 0
   890  83c9 4c7b7d                     JMP caml_load_newblk
   891                          caml_float_ret_tpl__tab
   892  83cc 000000000000               !byte $00, $00, $00, $00, $00, $00      ;Ft_ZERO  0.0
   893  83d2 810000000000               !byte $81, $00, $00, $00, $00, $00      ;Ft_ONE   1.0
   894  83d8 818000000000               !byte $81, $80, $00, $00, $00, $00      ;Ft_M1   -1.0
   895  83de 81490fdaa200               !byte $81, $49, $0F, $DA, $A2, $00      ;Ft_PIH   pi/2
   896  83e4 81c90fdaa200               !byte $81, $C9, $0F, $DA, $A2, $00      ;Ft_NPIH -pi/2
   897  83ea ff7fffffff01               !byte $FF, $7F, $FF, $FF, $FF, Fl_pinf  ;Ft_PINF +infinity
   898  83f0 ffffffffffff               !byte $FF, $FF, $FF, $FF, $FF, Fl_ninf  ;Ft_NINF -infinity
   899  83f6 000000000080               !byte $00, $00, $00, $00, $00, Fl_nan   ;Ft_NAN  nan
   900                          }
   901                          
   902                          ;; Unary operation on a special float: .X = Fu_* (operation * 3), ACCU = float
   903                          ;; Result: template of the class (+inf, -inf, nan) of the operand
   904                          !ifdef caml_AUX__caml_float_special1 {
   905                          caml_float_special1
   906                                  LDY # Float_flag
   907                                  LDA (ACCU),Y
   908                                  LDY # 0
   909                                  CMP # Fl_pinf
   910                                  BEQ @cls
   911                                  INY
   912                                  CMP # Fl_ninf
   913                                  BEQ @cls
   914                                  INY
   915                          @cls    STY TMP
   916                                  TXA
   917                                  CLC
   918                                  ADC TMP
   919                                  TAX
   920                                  LDA caml_float_special1__tab,X
   921                                  JMP caml_float_ret_tpl
   922                          caml_float_special1__tab                        ;+inf    -inf    nan
   923                                  !byte Ft_NINF, Ft_PINF, Ft_NAN          ;neg
   924                                  !byte Ft_PINF, Ft_PINF, Ft_NAN          ;abs
   925                                  !byte Ft_PINF, Ft_ZERO, Ft_NAN          ;exp
   926                                  !byte Ft_PINF, Ft_M1,   Ft_NAN          ;expm1
   927                                  !byte Ft_PINF, Ft_NAN,  Ft_NAN          ;log, log1p, log10, sqrt
   928                                  !byte Ft_NAN,  Ft_NAN,  Ft_NAN          ;sin, cos, tan
   929                                  !byte Ft_PIH,  Ft_NPIH, Ft_NAN          ;atan
   930                                  !byte Ft_PINF, Ft_NINF, Ft_NAN          ;floor, ceil
   931                          }
   932                          
   933                          ;; Binary operation, at least one operand being special: .X = Fb_*,
   934                          ;; ACCU = x, SP[0] = y. Allocates the result (IEEE 754 rules).
   935                          ;; TMP,TMP+1 = pointer to y; TMP+2 = flag of x; TMP+3 = flag of y
   936                          !ifdef caml_AUX__caml_float_special2 {
   937                          caml_float_special2
   938                                  LDY # 0
   939                                  LDA (SP),Y
   940                                  STA TMP
   941                                  INY
   942                                  LDA (SP),Y
   943                                  STA TMP + 1
   944                                  LDY # Float_flag
   945                                  LDA (TMP),Y
   946                                  STA TMP + 3
   947                                  LDA (ACCU),Y
   948                                  STA TMP + 2
   949                                  CPX # Fb_MUL
   950                                  BCS @n2
   951                                  CPX # Fb_SUB
   952                                  BNE @add
   953                                  LDA # 0                         ;x - y = x + (-y)
   954                                  SEC
   955                                  SBC TMP + 3                     ;(negates the flag: swaps +-inf,
   956                                  STA TMP + 3                     ; keeps 0 and nan)
   957                          @add    LDA TMP + 2                     ;fx = 0 (finite): result = fy
   958                                  BEQ @rfy
   959                                  LDA TMP + 3
   960                                  BEQ @rfx                        ;fy = 0: result = fx
   961                                  CMP TMP + 2
   962                                  BEQ @rfx                        ;fx = fy: result = fx (inf+inf, nan)
   963                                  LDA # Fl_nan                    ;else (inf-inf, inf+nan, ...): nan
   964                                  BNE @emit                       ;BNE=JMP
   965                          @rfx    LDA TMP + 2
   966                                  BNE @emit                       ;BNE=JMP
   967                          @rfy    LDA TMP + 3
   968                          @emit   LDX # Ft_PINF                   ;.A = flag: emit +inf, -inf or nan
   969                                  CMP # Fl_pinf
   970                                  BEQ @tpl
   971                                  LDX # Ft_NINF
   972                                  CMP # Fl_ninf
   973                                  BEQ @tpl
   974                                  LDX # Ft_NAN
   975                          @tpl    TXA
   976                                  JMP caml_float_ret_tpl
   977                          @n2     CPX # Fb_POW                    ;MUL, DIV, POW:
   978                                  BEQ @pow                        ;(pow: x^0=1 and 1^y=1 even if nan)
   979                                  LDA TMP + 2
   980                                  CMP # Fl_nan
   981                                  BEQ @nan
   982                                  LDA TMP + 3
   983                                  CMP # Fl_nan
   984                                  BEQ @nan
   985                                  CPX # Fb_DIV
   986                                  BEQ @div
   987                                  ;; ---- multiplication: infinity unless inf * 0
   988                                  LDA TMP + 2
   989                                  BEQ @mfx                        ;x finite, y infinite
   990                                  LDX TMP + 3
   991                                  BEQ @mfy                        ;y finite, x infinite
   992                                  EOR TMP + 3                     ;both infinite: sign = fx xor fy
   993                                  BPL @pinf
   994                                  BMI @ninf
   995                          @mfx    LDY # 0
   996                                  LDA (ACCU),Y                    ;x = 0.0 ?
   997                                  BEQ @nan
   998                                  INY
   999                                  LDA (ACCU),Y                    ;sign of x
  1000                                  EOR TMP + 3
  1001                                  BPL @pinf
  1002                                  BMI @ninf
  1003                          @mfy    LDY # 0
  1004                                  LDA (TMP),Y                     ;y = 0.0 ?
  1005                                  BEQ @nan
  1006                                  INY
  1007                                  LDA (TMP),Y                     ;sign of y
  1008                                  EOR TMP + 2
  1009                                  BPL @pinf
  1010                                  BMI @ninf
  1011                          
  1012                                  ;; ---- division
  1013                          @div    LDA TMP + 2
  1014                                  BNE @dx
  1015                                  LDA # Ft_ZERO                   ;finite / infinite = 0.0
  1016                                  BEQ @tpl2                       ;BEQ=JMP
  1017                          @dx     LDX TMP + 3
  1018                                  BNE @nan    ;inf / inf = nan
  1019                                  LDY # 0
  1020                                  LDA (TMP),Y                     ;inf / y: if y = 0.0 sign is the sign
  1021                                  BEQ @dsg                        ; of x, else sign(x) xor sign(y)
  1022                                  INY
  1023                                  LDA (TMP),Y
  1024                                  EOR TMP + 2
  1025                                  BPL @pinf
  1026                                  BMI @ninf
  1027                          @dsg    LDA TMP + 2                     ;(flag $01 or $FF)
  1028                                  BPL @pinf
  1029                                 ;BMI @ninf
  1030                          @ninf   LDA # Ft_NINF
  1031                                  BNE @tpl2
  1032                          @nan    LDA # Ft_NAN
  1033                                  BNE @tpl2
  1034                          @pinf   LDA # Ft_PINF
  1035                          @tpl2   JMP caml_float_ret_tpl
  1036                          
  1037                                  ;; ---- x ^ y
  1038                          @pow    LDA TMP + 3
  1039                                  BNE @p2
  1040                                  LDY # 0                         ;y finite (so x is special):
  1041                                  LDA (TMP),Y                     ; x ^ 0.0 = 1.0
  1042                                  BEQ @one
  1043                          @p2     LDA TMP + 2
  1044                                  BEQ @xfin
  1045                                  LDA # 1                         ;x infinite: |x| > 1
  1046                                  BNE @m
  1047                          @xfin   JSR @cmp1                       ;compare |x| with 1: $FF, 0, 1
  1048                                  BNE @m
  1049                                  LDY # 1                         ;|x| = 1: if x = +1.0 result is 1.0
  1050                                  LDA (ACCU),Y                    ; for every y (even nan)
  1051                                  BPL @one
  1052                                  LDA # 0
  1053                          @m      STA TMP + 4                     ;TMP+4 = -1, 0, 1 for |x| <, =, > 1
  1054                                  LDA TMP + 2
  1055                                  CMP # Fl_nan
  1056                                  BEQ @nan
  1057                                  LDA TMP + 3
  1058                                  CMP # Fl_nan
  1059                                  BEQ @nan
  1060                                  LDA TMP + 3
  1061                                  BEQ @yfin
  1062                                  LDA TMP + 4                     ;y = +-infinity
  1063                                  BEQ @one                        ; |x| = 1: 1.0
  1064                                  EOR TMP + 3                     ; same sign (|x|>1 and y=+inf, or
  1065                                  BPL @pinf   ;  |x|<1 and y=-inf): +inf, else 0.0
  1066                          @zero   LDA # Ft_ZERO
  1067                                  BEQ @tpl2                       ;BEQ=JMP
  1068                          @one    LDA # Ft_ONE
  1069                                  BNE @tpl2                       ;BNE=JMP
  1070                          @yfin   LDY # 1                         ;y finite, x infinite:
  1071                                  LDA (TMP),Y
  1072                                  BMI @zero                       ; y < 0: 0.0
  1073                                  LDA TMP + 2
  1074                                  CMP # Fl_pinf
  1075                                  BEQ @pinf   ; (+inf) ^ (y>0) = +inf
  1076                                  JSR caml_float_intclass         ; (-inf) ^ y: -inf if y is an odd
  1077                                  CMP # 2                         ;  integer, else +inf
  1078                                  BCS @ninf
  1079                                  BCC @pinf
  1080                          @cmp1   LDY # 0                         ;compare |ACCU| with 1.0 (finite)
  1081                                  LDA (ACCU),Y                    ; return .A=$FF if |x|<1, 0 if |x|=1,
  1082                                  CMP # $81                       ; 1 if |x|>1 (flags set by .A)
  1083                                  BCC @lt
  1084                                  BNE @gt
  1085                                  INY
  1086                                  LDA (ACCU),Y
  1087                                  AND # $7F
  1088                                  BNE @gt
  1089                          -       INY
  1090                                  LDA (ACCU),Y
  1091                                  BNE @gt
  1092                                  CPY # 4
  1093                                  BCC -
  1094                                  LDA # 0
  1095                                  RTS
  1096                          @lt     LDA # $FF
  1097                                  RTS
  1098                          @gt     LDA # 1
  1099                                  RTS
  1100                          }
  1101                          
  1102                          ;; Class of the finite float (TMP) = y: .A = 0 if y is not an integer, 1 if it
  1103                          ;; is an even integer (or 0.0), 2 if it is an odd integer. Flags set by .A
  1104                          ;; y = 0.m * 2^E, E = exponent - $80. Not an integer if E <= 0 (y <> 0); even
  1105                          ;; if E > 32; else odd <=> E + (trailing zeroes of the 32 bits of the mantissa)
  1106                          ;; = 32, even if > 32, not an integer if < 32.
  1107                          !ifdef caml_AUX__caml_float_intclass {
  1108                          caml_float_intclass
  1109  83fc a000                       LDY # 0
  1110  83fe b14d                       LDA (TMP),Y
  1111  8400 f036                       BEQ @even
  1112  8402 38                         SEC
  1113  8403 e980                       SBC # $80
  1114  8405 902e                       BCC @no
  1115  8407 f02c                       BEQ @no
  1116  8409 c921                       CMP # 33
  1117  840b b02b                       BCS @even
  1118  840d 8552                       STA TMP + 5
  1119  840f a200                       LDX # 0
  1120  8411 a004                       LDY # 4
  1121  8413 b14d               @tz     LDA (TMP),Y
  1122  8415 d00e                       BNE @bits
  1123  8417 8a                         TXA
  1124  8418 18                         CLC
  1125  8419 6908                       ADC # 8
  1126  841b aa                         TAX
  1127  841c 88                         DEY
  1128  841d c001                       CPY # 1
  1129  841f d0f2                       BNE @tz
  1130  8421 b14d                       LDA (TMP),Y                     ;1st byte: bit 7 is the sign, the
  1131  8423 0980                       ORA # $80                       ; mantissa bit is 1
  1132  8425 4a                 @bits   LSR
  1133  8426 b003                       BCS @cnt
  1134  8428 e8                         INX
  1135  8429 d0fa                       BNE @bits
  1136  842b 8a                 @cnt    TXA
  1137  842c 18                         CLC
  1138  842d 6552                       ADC TMP + 5
  1139  842f c920                       CMP # 32
  1140  8431 f008                       BEQ @odd
  1141  8433 b003                       BCS @even
  1142  8435 a900               @no     LDA # 0
  1143  8437 60                         RTS
  1144  8438 a901               @even   LDA # 1
  1145  843a 60                         RTS
  1146  843b a902               @odd    LDA # 2
  1147  843d 60                         RTS
  1148                          }
  1149                          
  1150                          ;; Domain check for the float just loaded into FAC: log x (.X = 0) or sqrt x
  1151                          ;; (.X <> 0). If x < 0, or x = 0 and .X = 0, the primitive is terminated here
  1152                          ;; with the result (nan, -infinity): the routine pops its return address and
  1153                          ;; jumps to caml_float_ret_tpl.
  1154                          !ifdef caml_AUX__caml_float_logdom {
  1155                          caml_float_logdom
  1156                                  LDA C64_FAC
  1157                                  BNE @nz
  1158                                  TXA                             ;x = 0.0: sqrt is fine,
  1159                                  BNE @ok                         ; log 0.0 = -infinity
  1160                                  PLA
  1161                                  PLA
  1162                                  LDA # Ft_NINF
  1163                                  JMP caml_float_ret_tpl
  1164                          @nz     BIT C64_FAC + 5                 ;x < 0 ?
  1165                                  BPL @ok
  1166                                  PLA
  1167                                  PLA
  1168                                  LDA # Ft_NAN
  1169                                  JMP caml_float_ret_tpl
  1170                          @ok     RTS
  1171                          }
  1172                          
  1173                          ;; A BASIC ROM routine called by a floating-point primitive raised the OVERFLOW
  1174                          ;; error. Called (JSR) by caml_syserr. If the primitive set the operation in
  1175                          ;; caml_float_overflow__op, the CPU stack is restored as it was when
  1176                          ;; caml_float_unop/binop (or the primitive itself) saved it in
  1177                          ;; caml_float_overflow__sp, and the primitive returns +-infinity to its caller.
  1178                          ;; Otherwise return to caml_syserr, which raises Sys_error "OVERFLOW".
  1179                          ;; The sign of the result is: add, sub: sign of x (ACCU); mul, div: sign(x)
  1180                          ;; xor sign(y) (SP[0]); pow: - if x < 0 and y is an odd integer; exp: +;
  1181                          ;; float_of_string: - if the string starts with '-'.
  1182                          !ifdef caml_AUX__caml_float_overflow {
  1183                          caml_float_overflow
  1184  843e ada884                     LDA caml_float_overflow__op
  1185  8441 1001                       BPL @known
  1186  8443 60                         RTS                             ;unknown operation: raise the error
  1187  8444 f049               @known  BEQ @sgnx                       ;Fo_ADD
  1188  8446 c902                       CMP # Fo_POW
  1189  8448 f02b                       BEQ @pow
  1190  844a b013                       BCS @exp                        ;Fo_EXP, Fo_STR
  1191  844c a000                       LDY # 0                         ;Fo_MUL
  1192  844e b1fd                       LDA (SP),Y
  1193  8450 854d                       STA TMP
  1194  8452 c8                         INY
  1195  8453 b1fd                       LDA (SP),Y
  1196  8455 854e                       STA TMP + 1                     ;(TMP) = y
  1197  8457 b14d                       LDA (TMP),Y                     ;.Y = 1: sign of y,
  1198  8459 51fb                       EOR (ACCU),Y                    ; xor sign of x
  1199  845b 303c                       BMI @neg
  1200  845d 1036                       BPL @pos
  1201  845f c904               @exp    CMP # Fo_STR
  1202  8461 d032                       BNE @pos                        ;Fo_EXP: +infinity
  1203  8463 a54d                       LDA TMP                         ;Fo_STR: restore the BASIC program
  1204  8465 857a                       STA C64_CHRPTR                  ; pointer, saved by the primitive
  1205  8467 a54e                       LDA TMP + 1
  1206  8469 857b                       STA C64_CHRPTR + 1
  1207  846b a000                       LDY # 0
  1208  846d b1fb                       LDA (ACCU),Y
  1209  846f c92d                       CMP # '-'
  1210  8471 f026                       BEQ @neg
  1211  8473 d020                       BNE @pos
  1212  8475 a001               @pow    LDY # 1
  1213  8477 b1fb                       LDA (ACCU),Y                    ;x < 0 ?
  1214  8479 101a                       BPL @pos
  1215  847b a000                       LDY # 0
  1216  847d b1fd                       LDA (SP),Y
  1217  847f 854d                       STA TMP
  1218  8481 c8                         INY
  1219  8482 b1fd                       LDA (SP),Y
  1220  8484 854e                       STA TMP + 1                     ;(TMP) = y
  1221  8486 20fc83                     JSR caml_float_intclass
  1222  8489 c902                       CMP # 2                         ;negative result iff y is odd
  1223  848b b00c                       BCS @neg
  1224  848d 9006                       BCC @pos
  1225  848f a001               @sgnx   LDY # 1
  1226  8491 b1fb                       LDA (ACCU),Y                    ;sign of x
  1227  8493 3004                       BMI @neg
  1228  8495 a91e               @pos    LDA # Ft_PINF
  1229  8497 d002                       BNE @res                        ;BNE=JMP
  1230  8499 a924               @neg    LDA # Ft_NINF
  1231  849b a2ff               @res    LDX # Fo_NONE                   ;Handle overflow: reset op, so that a
  1232  849d 8ea884                     STX caml_float_overflow__op     ; later overflow raised by a ROM routine
  1233  84a0 aea784                     LDX caml_float_overflow__sp     ; which doesn't set it is an error.
  1234  84a3 9a                         TXS                             ;Restore the CPU stack pointer
  1235  84a4 4cae83                     JMP caml_float_ret_tpl          ;return the result to the caller
  1236                          caml_float_overflow__sp
  1237  84a7 00                         !byte 0
  1238                          caml_float_overflow__op
  1239  84a8 ff                         !byte Fo_NONE
  1240                          }
  1241                          
  1242                          }      ;; !zone caml_FLOATS
  1243                          

