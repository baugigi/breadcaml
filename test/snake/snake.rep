    12                          ;; progetto.
    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          
    15                          ;; -----------------------------------------------------------------------------
    16                          ;;                                   FLOATS
    17                          ;; -----------------------------------------------------------------------------
    18                          
    19                          ;; ZP locations used by the C64's BASIC ROM float routines and by Breadcaml:
    20                          
    21                          ;; Breadcaml Address BASIC float routines
    22                          ;; --------- ------- ----------------------------------------------------------
    23                          ;; XARGS     $02      <UNUSED>
    24                          ;; <UNUSED>  $12     used by tan and, preparing tan, by sin/cos routines
    25                          ;; <UNUSED>  $22-$23 used to move variables into FAC/ARG and back to memory
    26                          ;; <UNUSED>  $24-$25 used during FP comparisons and PETSCII to FP conversion
    27                          ;; <UNUSED>  $26-$2A result of multiplication or division
    28                          ;; ENV       $2B-$2C  <UNUSED>
    29                          ;; TRAPSP    $2D-$2E  <UNUSED>
    30                          ;; Interpr.  $2F-$3D  <UNUSED>
    31                          ;; GC        $3E-$45  <UNUSED>
    32                          ;; <UNUSED>  $47     used by FOUT
    33                          ;; HEAP      $49-$4A  <UNUSED>
    34                          ;; BLK       $4B-$4C  <UNUSED>
    35                          ;; TMP+0,8   $4D-$55  <UNUSED>
    36                          ;; TMP+9     $56     used in addition, subtraction, and by the exp function
    37                          ;; TMP+10,14 $57-$5B  <UNUSED>
    38                          ;; TMP+15,19 $5C-$60 used by the PETSCII conversion routines
    39                          ;; TMP+20    $61     FAC exponent
    40                          ;; TMP+21,24 $62-$65 FAC mantissa
    41                          ;; TMP+25    $66     FAC sign in bit 7
    42                          ;; TMP+26    $67     used by trig, exp, log, and PETSCII to FP conversion
    43                          ;; TMP+27    $68     used during normalisation and FP to integer conversion
    44                          ;; TMP+28    $69     ARG exponent
    45                          ;; TMP+29,32 $6A-$6D ARG mantissa
    46                          ;; TMP+33    $6E     ARG sign in bit 7
    47                          ;; TMP+34    $6F     sign result of arithm. operations, set when ARG is loaded
    48                          ;; TMP+35    $70     FAC low order rounding byte, cleared when FAC is loaded
    49                          ;; TMP+36,37 $71-$72 used for series eval and PETSCII to FP conversion
    50                          ;; ACCU      $FB-$FC  <UNUSED>
    51                          ;; SP        $FD-$FE  <UNUSED>
    52                          
    54                          !zone caml_FLOATS {
    55                          
    56                          .dummy = $1234                          ;dummy operand for self-modifying code
    57                                                                  ;(SMC in comments)
    58                          
    59                          ;; SPECIAL VALUES (see loader.asm for the encoding of the flag byte, Fl_*):
    60                          ;; byte 5 of a float block is 0 for finite numbers, $01 for +infinity, $FF for
    61                          ;; -infinity and $80 for nan. caml_float_unop and caml_float_binop load the
    62                          ;; operand(s) into FAC (and ARG) and return C=1 if at least one operand is
    63                          ;; special (the primitive then jumps to caml_float_special1/2), C=0 if all
    64                          ;; operands are finite (the primitive goes on with the BASIC ROM routine).
    65                          
    66                          ;; Float templates (offsets in caml_float_ret_tpl__tab), 6 bytes each:
    67                          Ft_ZERO = 0                             ;0.0
    68                          Ft_ONE  = 6                             ;1.0
    69                          Ft_M1   = 12                            ;-1.0
    70                          Ft_PIH  = 18                            ;pi/2
    71                          Ft_NPIH = 24                            ;-pi/2
    72                          Ft_PINF = 30                            ;+infinity
    73                          Ft_NINF = 36                            ;-infinity
    74                          Ft_NAN  = 42                            ;nan
    75                          
    76                          ;; Unary operations: index * 3 in the table caml_float_special1__tab
    77                          Fu_NEG   = 0
    78                          Fu_ABS   = 3
    79                          Fu_EXP   = 6
    80                          Fu_EXPM1 = 9
    81                          Fu_LOG   = 12                           ;log, log1p, log10, sqrt
    82                          Fu_TRIG  = 15                           ;sin, cos, tan
    83                          Fu_ATAN  = 18
    84                          Fu_FLOOR = 21                           ;floor, ceil
    85                          
    86                          ;; Binary operations: index in caml_float_special2
    87                          Fb_ADD = 0
    88                          Fb_SUB = 1
    89                          Fb_MUL = 2
    90                          Fb_DIV = 3
    91                          Fb_POW = 4
    92                          
    93                          ;; Operations which may overflow (stored in caml_float_overflow__op, see there)
    94                          Fo_NONE = $FF                           ;unknown: overflow raises Sys_error
    95                          ;; Contract: a primitive that calls a ROM routine which may overflow must set
    96                          ;; caml_float_overflow__op (and caml_float_overflow__sp, which caml_float_unop/
    97                          ;; binop do) before the call. caml_float_overflow__op is reset to Fo_NONE only
    98                          ;; after an overflow has been handled, so a primitive that does not follow the
    99                          ;; contract after a successful float operation may find a stale value.
   100                          Fo_ADD  = 0                             ;(add and sub: same sign rule)
   101                          Fo_MUL  = 1                             ;(mul and div: same sign rule)
   102                          Fo_POW  = 2
   103                          Fo_EXP  = 3                             ;(exp, expm1)
   104                          Fo_STR  = 4                             ;float_of_string
   105                          
   106                          !ifdef caml_PRIM__caml_nonstd_sign_float {
   107                          caml_nonstd_sign_float
   108                                  ;; Stdlib.sign_float: -1, 0, 1 (nan gives 0)
   109                                  LDY # Float_flag
   110                                  LDA (ACCU),Y
   111                                  BEQ @fin
   112                                  CMP # Fl_pinf
   113                                  BEQ @pos
   114                                  CMP # Fl_ninf
   115                                  BEQ @neg
   116                                  BNE @zero                       ;nan: BNE=JMP
   117                          @fin    LDY # 0
   118                                  LDA (ACCU),Y                    ;Read byte #0 (exponent)
   119                                  BEQ @zero                       ;Exponent=0 <=> float=0.
   120                                  INY
   121                                  LDA (ACCU),Y                    ;Read byte #1 (mantissa, msb)
   122                                  BPL @pos                        ;If the mantissa is negative,
   123                          @neg    LDA # $FF                       ; set ACCU=Val_Int(-1)
   124                                  STA ACCU
   125                                  STA ACCU + 1
   126                                  LDY # 0
   127                                  RTS
   128                          @pos    LDA # Val_one                   ;else set ACCU=Val_Int(1)
   129                                  BNE @store                      ; BNE=JMP.
   130                          @zero   LDA # Val_zero                  ;Zero: set ACCU=Val_Int(0).
   131                          @store  STA ACCU
   132                                  LDY # 0
   133                                  STY ACCU + 1
   134                                  RTS                             ;Y=0 at exit.
   135                          }
   136                          
   137                          !ifdef caml_PRIM__caml_neg_float {
   138                          caml_neg_float
   139                                  JSR caml_float_unop
   140                                  BCC @fin
   141                                  LDX # Fu_NEG
   142                                  JMP caml_float_special1
   143                          @fin    +caml_JSR_BASROM C64_NEGOP
   144                                  JMP caml_float_alloc_result
   145                          }
   146                          
   147                          !ifdef caml_PRIM__caml_abs_float {
   148                          caml_abs_float
   149                                  JSR caml_float_unop
   150                                  BCC @fin
   151                                  LDX # Fu_ABS
   152                                  JMP caml_float_special1
   153                          @fin    +caml_JSR_BASROM C64_ABS
   154                                  JMP caml_float_alloc_result
   155                          }
   156                          
   157                          !ifdef caml_PRIM__caml_exp_float {
   158                          caml_exp_float
   159                                  JSR caml_float_unop
   160                                  BCC @fin
   161                                  LDX # Fu_EXP
   162                                  JMP caml_float_special1
   163                          @fin    LDX # Fo_EXP                    ;(overflow: +infinity)
   164                                  STX caml_float_overflow__op
   165                                  +caml_JSR_BASROM C64_EXP
   166                                  JMP caml_float_alloc_result
   167                          }
   168                          
   169                          !ifdef caml_PRIM__caml_expm1_float {
   170                          caml_expm1_float
   171                                  JSR caml_float_unop
   172                                  BCC @fin
   173                                  LDX # Fu_EXPM1
   174                                  JMP caml_float_special1
   175                          @fin    LDX # Fo_EXP                    ;(overflow: +infinity)
   176                                  STX caml_float_overflow__op
   177                                  +caml_JSR_BASROM C64_EXP
   178                                  LDA # <C64_M1
   179                                  LDY # >C64_M1
   180                                  +caml_JSR_BASROM C64_FADD
   181                                  JMP caml_float_alloc_result
   182                          }
   183                          
   184                          !ifdef caml_PRIM__caml_log_float {
   185                          caml_log_float
   186                                  JSR caml_float_unop
   187                                  BCC @fin
   188                                  LDX # Fu_LOG
   189                                  JMP caml_float_special1
   190                          @fin    LDX # 0                         ;log 0.0 = -infinity, log (x<0) = nan
   191                                  JSR caml_float_logdom
   192                                  +caml_JSR_BASROM C64_LOG
   193                                  JMP caml_float_alloc_result
   194                          }
   195                          
   196                          !ifdef caml_PRIM__caml_log1p_float {
   197                          caml_log1p_float
   198                                  JSR caml_float_unop
   199                                  BCC @fin
   200                                  LDX # Fu_LOG
   201                                  JMP caml_float_special1
   202                          @fin    LDA # <C64_ONE
   203                                  LDY # >C64_ONE
   204                                  +caml_JSR_BASROM C64_FADD
   205                                  LDX # 0                         ;log1p (-1.0) = -infinity, ... = nan
   206                                  JSR caml_float_logdom
   207                                  +caml_JSR_BASROM C64_LOG
   208                                  JMP caml_float_alloc_result
   209                          }
   210                          
   211                          !ifdef caml_PRIM__caml_log10_float {
   212                          .ln10m1 !h 7f 5e 5b d8 a9       ;(ln 10)^-1
   213                          caml_log10_float
   214                                  ;; log10 x = ln x / ln 10
   215                                  JSR caml_float_unop
   216                                  BCC @fin
   217                                  LDX # Fu_LOG
   218                                  JMP caml_float_special1
   219                          @fin    LDX # 0
   220                                  JSR caml_float_logdom
   221                                  +caml_JSR_BASROM C64_LOG
   222                            !if caml_log10_float <= C64_BASROM {
   223                                  LDA # <.ln10m1
   224                                  LDY # >.ln10m1
   225                            } else {
   226                                  LDY # 5
   227                          -       LDA .ln10m1 - 1,Y
   228                                  STA TMP - 1,Y
   229                                  DEY
   230                                  BNE -
   231                                  LDA # TMP
   232                            }
   233                                  +caml_JSR_BASROM C64_FMUL
   234                                  JMP caml_float_alloc_result
   235                          }
   236                          
   237                          !ifdef caml_PRIM__caml_sin_float {
   238                          caml_sin_float
   239                                  JSR caml_float_unop
   240                                  BCC @fin
   241                                  LDX # Fu_TRIG
   242                                  JMP caml_float_special1
   243                          @fin    +caml_JSR_BASROM C64_SIN
   244                                  JMP caml_float_alloc_result
   245                          }
   246                          
   247                          !ifdef caml_PRIM__caml_cos_float {
   248                          caml_cos_float
   249                                  JSR caml_float_unop
   250                                  BCC @fin
   251                                  LDX # Fu_TRIG
   252                                  JMP caml_float_special1
   253                          @fin    +caml_JSR_BASROM C64_COS
   254                                  JMP caml_float_alloc_result
   255                          }
   256                          
   257                          !ifdef caml_PRIM__caml_tan_float {
   258                          caml_tan_float
   259                                  JSR caml_float_unop
   260                                  BCC @fin
   261                                  LDX # Fu_TRIG
   262                                  JMP caml_float_special1
   263                          @fin    +caml_JSR_BASROM C64_TAN
   264                                  JMP caml_float_alloc_result
   265                          }
   266                          
   267                          !ifdef caml_PRIM__caml_sqrt_float {
   268                          caml_sqrt_float
   269                                  JSR caml_float_unop
   270                                  BCC @fin
   271                                  LDX # Fu_LOG
   272                                  JMP caml_float_special1
   273                          @fin    LDX # 1                         ;sqrt (x<0) = nan
   274                                  JSR caml_float_logdom
   275                                  +caml_JSR_BASROM C64_SQR
   276                                  JMP caml_float_alloc_result
   277                          }
   278                          
   279                          !ifdef caml_PRIM__caml_atan_float {
   280                          caml_atan_float
   281                                  JSR caml_float_unop
   282                                  BCC @fin
   283                                  LDX # Fu_ATAN
   284                                  JMP caml_float_special1
   285                          @fin    +caml_JSR_BASROM C64_ATN
   286                                  JMP caml_float_alloc_result
   287                          }
   288                          
   289                          !ifdef caml_PRIM__caml_floor_float {
   290                          caml_floor_float
   291                                  JSR caml_float_unop
   292                                  BCC @fin
   293                                  LDX # Fu_FLOOR
   294                                  JMP caml_float_special1
   295                          @fin    +caml_JSR_BASROM C64_INT
   296                                  JMP caml_float_alloc_result
   297                          }
   298                          
   299                          !ifdef caml_PRIM__caml_ceil_float {
   300                          caml_ceil_float
   301                                  ;; let ceil x = -.(floor (-. x))
   302                                  JSR caml_float_unop
   303                                  BCC @fin
   304                                  LDX # Fu_FLOOR
   305                                  JMP caml_float_special1
   306                          @fin    +caml_JSR_BASROM C64_NEGOP
   307                                  +caml_JSR_BASROM C64_INT
   308                                  +caml_JSR_BASROM C64_NEGOP
   309                                  JMP caml_float_alloc_result
   310                          }
   311                          
   312                          !ifdef caml_PRIM__caml_classify_float {
   313                          caml_classify_float
   314                                  +Val_Int ~@FP_normal,    0      ;order must match variants in
   315                                  +Val_Int ~@FP_subnormal, 1      ;type Float.fpclass
   316                                  +Val_Int ~@FP_zero,      2
   317                                  +Val_Int ~@FP_infinite,  3
   318                                  +Val_Int ~@FP_nan,       4
   319                                  LDY # Float_flag
   320                                  LDA (ACCU),Y
   321                                  BNE @spec
   322                                  TAY                             ;.Y = 0
   323                                  LDA (ACCU),Y                    ;exponent
   324                                  STY ACCU + 1
   325                                  BEQ @zero
   326                                  LDA # @FP_normal
   327                                  STA ACCU
   328                                  RTS
   329                          @zero   LDA # @FP_zero
   330                                  STA ACCU
   331                                  RTS
   332                          @spec   LDX # @FP_infinite
   333                                  CMP # Fl_nan
   334                                  BNE @set
   335                                  LDX # @FP_nan
   336                          @set    STX ACCU
   337                                  LDY # 0
   338                                  STY ACCU + 1
   339                                  RTS
   340                          }
   341                          
   342                          !ifdef caml_PRIM__caml_int_of_float {
   343                          caml_int_of_float
   344                                  JSR caml_float_unop
   345                                  BCC @fin
   346                                  LDX # $FF                       ;special value (.A = flag):
   347                                  LDY # $7F                       ; +inf gives the largest int,
   348                                  CMP # Fl_pinf
   349                                  BEQ @set
   350                                  LDX # $01                       ; -inf the smallest,
   351                                  LDY # $80
   352                                  CMP # Fl_ninf
   353                                  BEQ @set
   354                                  LDY # 0                         ; nan gives 0.
   355                          @set    STX ACCU
   356                                  STY ACCU + 1
   357                                  LDY # 0
   358                                  RTS
   359                          @fin    LDA C64_FAC + 5                 ;FAC sign byte
   360                                  PHA                             ;save sign
   361                                  LDA # 0
   362                                  STA C64_FAC + 5                 ;FAC := |FAC| (FACINX floors, OCaml
   363                                  +caml_JSR_BASROM C64_FACINX     ; truncates) => result in Y(lo), A(hi)
   364                                  STY ACCU
   365                                  STA ACCU + 1
   366                                  PLA
   367                                  BPL +                           ;negative argument:
   368                                  SEC                             ; negate the (truncated) magnitude
   369                                  LDA # 0
   370                                  SBC ACCU
   371                                  STA ACCU
   372                                  LDA # 0
   373                                  SBC ACCU + 1
   374                                  STA ACCU + 1
   375                          +       SEC
   376                                  ROL ACCU                        ;OCaml int repr
   377                                  ROL ACCU + 1
   378                                  LDY # 0
   379                                  RTS
   380                          }
   381                          
   382                          !ifdef caml_PRIM__caml_float_of_int {
   383                          caml_float_of_int
   384                                  LDA ACCU + 1
   385                                  CMP # $80                       ;CMP + ROR = arithm. shift right
   386                                  ROR
   387                                  TAX
   388                                  ROR ACCU
   389                                  LDY ACCU
   390                                  TXA
   391                                  +caml_JSR_BASROM C64_GIVAYF
   392                                  JMP caml_float_alloc_result
   393                          }
   394                          
   395                          !ifdef caml_PRIM__caml_copysign_float {
   396                          caml_copysign_float
   397                                  ;; |ACCU| with the sign of SP[0] (the sign of nan is taken as '+')
   398                                  LDY # 0
   399                                  LDA (SP),Y
   400                                  STA TMP
   401                                  INY
   402                                  LDA (SP),Y
   403                                  STA TMP + 1                     ;(TMP) = SP[0]
   404                                  LDY # Float_flag
   405                                  LDA (TMP),Y
   406                                  BNE @yspec
   407                                  LDY # 1                         ;finite: load 1st mantissa byte of
   408                                  LDA (TMP),Y                     ; SP[0] (its bit 7 is the sign)
   409                          @sign   PHA
   410                                  JSR caml_float_unop             ;ACCU --> FAC
   411                                  PLA                             ;(this and TAX do not touch C)
   412                                  TAX
   413                                  BCS @spx
   414                                  STA C64_FAC + 5                 ;copy the sign to FAC sign byte
   415                                  JMP caml_float_alloc_result
   416                          @yspec  CMP # Fl_ninf                   ;special: C=1 only if -inf
   417                                  LDA # 0
   418                                  ROR                             ;bit 7 of .A = sign of SP[0]
   419                                  JMP @sign
   420                          @spx    LDY # Float_flag                ;ACCU is special:
   421                                  LDA (ACCU),Y
   422                                  CMP # Fl_nan
   423                                  BNE @inf
   424                                  LDY # 0                         ; nan: result is ACCU itself
   425                                  RTS
   426                          @inf    LDA # Ft_PINF                   ; infinity:
   427                                  CPX # $80                       ;  C=1 if the sign is '-'
   428                                  BCC @tpl
   429                                  LDA # Ft_NINF
   430                          @tpl    JMP caml_float_ret_tpl
   431                          }
   432                          
   433                          !ifdef caml_PRIM__caml_float_of_string {
   434                          caml_float_of_string
   435                                  ;; Special values first: [+|-] ("nan" | "inf" | "infinity"), any case
   436                                  LDY # 0
   437                                  STY TMP + 2                     ;sign ($FF = '-')
   438                                  LDA (ACCU),Y
   439                                  CMP # '-'
   440                                  BNE @plus
   441                                  DEC TMP + 2
   442                                  INY
   443                                  BNE @word                       ;BNE=JMP
   444                          @plus   CMP # '+'
   445                                  BNE @word
   446                                  INY
   447                          @word   STY TMP + 3
   448                                  LDX # @w_nan - @words
   449                                  JSR @try
   450                                  BEQ @isnan
   451                                  LDX # @w_inf - @words
   452                                  LDY TMP + 3
   453                                  JSR @try
   454                                  BEQ @isinf
   455                                  LDX # @w_infinity - @words
   456                                  LDY TMP + 3
   457                                  JSR @try
   458                                  BNE @num                        ;no match: it is a number
   459                          @isinf  LDA # Ft_PINF
   460                                  BIT TMP + 2
   461                                  BPL @tpl
   462                                  LDA # Ft_NINF
   463                                  BNE @tpl                        ;BNE=JMP
   464                          @isnan  LDA # Ft_NAN
   465                          @tpl    JMP caml_float_ret_tpl
   466                          @try    LDA @words,X                    ;match string at (ACCU),Y with word X
   467                                  BEQ @end                        ; (case-insensitive: PETSCII uppercase
   468                                  LDA (ACCU),Y                    ; letters are $C1-$DA, lowercase $41-$5A)
   469                                  AND # $7F
   470                                  CMP @words,X
   471                                  BNE @no                         ;mismatch: return Z=0
   472                                  INY
   473                                  INX
   474                                  BNE @try                        ;BNE=JMP
   475                          @end    LDA (ACCU),Y                    ;string must end here: return Z=1 if so
   476                          @no     RTS
   477                          @words
   478                          @w_nan      !text "nan", 0
   479                          @w_inf      !text "inf", 0
   480                          @w_infinity !text "infinity", 0
   481                          @num    TSX                             ;overflow (+-infinity): see
   482                                  STX caml_float_overflow__sp     ; caml_float_overflow
   483                                  LDA # Fo_STR
   484                                  STA caml_float_overflow__op
   485                                  LDA C64_CHRPTR                  ;Save the current CHRPTR value
   486                                  STA TMP
   487                                  LDA C64_CHRPTR + 1
   488                                  STA TMP + 1
   489                                  LDA ACCU + 1
   490                                  LDX ACCU
   491                           !ifdef caml_basic_rom_overlap {
   492                                  ;; FIN reads the string with the BASIC ROM on, but the string may be in
   493                                  ;; the RAM under it ($A000-$BFFF): copy it (0-terminated, max 80 chars)
   494                                  ;; to the BASIC input buffer and convert the copy.
   495                                  CMP # > (C64_BASROM - 79)       ;If the first 80 characters of the
   496                                  BCC @setptr                     ; string are below $A000, skip the copy
   497                                  BNE @copy                       ; and set the pointer to ACCU;
   498                                  CPX # < (C64_BASROM - 79)
   499                                  BCC @setptr
   500                          @copy   LDY # 0                         ;else copy the string to the buffer
   501                          -       LDA (ACCU),Y
   502                                  STA C64_BUF,Y
   503                                  BEQ +
   504                                  INY
   505                                  CPY # 80
   506                                  BCC -
   507                                  LDA # 0
   508                                  STA C64_BUF,Y
   509                          +       LDA # >C64_BUF                  ; and set the pointer to it.
   510                                  LDX # <C64_BUF
   511                           }
   512                          @setptr STA C64_CHRPTR + 1              ;CHRPTR := A:X
   513                                  STX C64_CHRPTR
   514                                  JSR C64_CHRGOT                  ;not a BASIC ROM routine
   515                                  +caml_JSR_BASROM C64_FIN        ;String to float conversion routine
   516                                  ;; FIN never fails: it converts the longest valid prefix (0 if none) and
   517                                  ;; leaves C64_CHRPTR at the first character it did not use. Accept only
   518                                  ;; a string that FIN consumed up to its end (0 byte)...
   519                                  LDY # 0
   520                                  LDA (C64_CHRPTR),Y
   521                                  BNE @bad                        ;trailing garbage ("12abc", "abc")
   522                                  LDA C64_FAC
   523                                  BNE @good                       ;...and, if the result is 0, only if
   524                          @dig    LDA (ACCU),Y                    ; there is a mantissa digit before the
   525                                  BEQ @bad                        ; exponent: "-", ".", "", "e5" are not
   526                                  CMP # $45                       ; numbers, "0", "-0.0", "0e5" are.
   527                                  BEQ @bad                        ;$45 = 'e'
   528                                  EOR # $30
   529                                  CMP # 10
   530                                  BCC @good                       ;a digit
   531                                  INY
   532                                  BNE @dig
   533                          @bad    LDA TMP                         ;Restore the previous value of CHRPTR
   534                                  STA C64_CHRPTR
   535                                  LDA TMP + 1
   536                                  STA C64_CHRPTR + 1
   537                                  +caml_raise Failure, "float_of_string"
   538                          @good   LDA TMP                         ;Restore the previous value of CHRPTR
   539                                  STA C64_CHRPTR
   540                                  LDA TMP + 1
   541                                  STA C64_CHRPTR + 1
   542                                  JMP caml_float_alloc_result
   543                          }
   544                          
   545                          !ifdef caml_PRIM__caml_ldexp_float {
   546                                  ;; compute ACCU * 2 ^ N, -255 < N < 255.
   547                                  ;; SP[0] = Val_int(N) (usual tagged int, two's complement if N < 0)
   548                          caml_ldexp_float
   549                                  LDY # Float_flag
   550                                  LDA (ACCU),Y
   551                                  BEQ @fin
   552                                  LDY # 0                         ;nan, +-infinity: ldexp x n = x
   553                                  RTS
   554                          @fin    LDY # 0
   555                                  LDA # Double_tag
   556                                  LDX # Double_wosize
   557                                  JSR caml_alloc                  ;{Y = 0}
   558                                  LDA # 0                         ;the flag byte of the result is 0
   559                                  LDY # Float_flag                ; (ldexp x n = x if x is nan or inf,
   560                                  STA (BLK),Y                     ;  see below)
   561                                  TAY                             ;.Y = 0
   562                                  LDA (ACCU),Y                    ;(biased) exponent of the source
   563                                  BEQ @save                       ;0.0 * 2^N = 0.0: don't add N to exp 0
   564                                  STA TMP
   565                                  INY
   566                                  LDA (SP),Y                      ;hi byte of Val_int(N)
   567                                  TAX                             ;X: bit 7 = sign of N
   568                                  LSR                             ;C := bit 0 of hi byte
   569                                  DEY
   570                                  LDA (SP),Y
   571                                  ROR                             ;A := low byte of N (two's complement)
   572                                  STA TMP + 1
   573                                  TXA
   574                                  BMI @neg                        ;N < 0 ?
   575                                  LDA TMP + 1                     ;no: exp := exp + N
   576                                  CLC
   577                                  ADC TMP
   578                                  BCC @save
   579                                  LDY # 1                         ; overflow: +-infinity,
   580                                  LDA (ACCU),Y                    ;  with the sign of the source
   581                                  BMI @ninf
   582                                  LDA # Ft_PINF
   583                                  BNE @tpl                        ;BNE=JMP
   584                          @ninf   LDA # Ft_NINF
   585                          @tpl    JMP caml_float_ret_tpl
   586                          @neg    LDA TMP + 1                     ;yes: exp := exp - |N| = exp + (256-|N|)
   587                                  CLC
   588                                  ADC TMP
   589                                  BCS @save                       ; if underflow,
   590                                  LDA # 0                         ;  set exp = 0 (result = 0.0)
   591                          @save   STA (BLK),Y                     ;save exp byte (Y = 0)
   592                                  BEQ +                           ;skip copy of mantissa if zero
   593                                  LDY # 4
   594                          -       LDA (ACCU),Y                    ;copy mantissa
   595                                  STA (BLK),Y
   596                                  DEY
   597                                  BNE -
   598                          +       JMP caml_load_newblk
   599                          }
   600                          
   601                          !ifdef caml_PRIM__caml_frexp_float {
   602                          caml_frexp_float
   603                                  ;; allocate a new float with same mantissa and exp=0
   604                                  LDA # Double_tag                ;tag of new float
   605                                  LDX # Double_wosize             ;size of new float
   606                                  JSR caml_alloc                  ;alloc new float
   607                                  LDY # Float_flag
   608                                  LDA (ACCU),Y
   609                                  STA (BLK),Y                     ;copy the flag byte
   610                                  BEQ @fin
   611                                  LDY # 4                         ;nan, +-infinity: frexp x = (x, 0)
   612                          -       LDA (ACCU),Y                    ; copy the float,
   613                                  STA (BLK),Y
   614                                  DEY
   615                                  BPL -
   616                                  INY
   617                                  TYA
   618                                  PHA                             ; and set the exponent to 0
   619                                  BEQ @pair
   620                          @fin    LDY # 0
   621                                  LDA (ACCU),Y                    ;load (biased) exponent
   622                                  PHA                             ;save it for later
   623                                  BNE @nz                         ;float is 0.0?
   624                                  STA (BLK),Y                     ;yes: set new float exp = 0
   625                                  BEQ @pair                       ; and go further
   626                          @nz     LDA # $80                       ;no: set new float exp = $80
   627                                  STA (BLK),Y
   628                                  LDY # 4                         ; then copy the mantissa
   629                          -       LDA (ACCU),Y
   630                                  STA (BLK),Y
   631                                  DEY
   632                                  BNE -
   633                          @pair   JSR caml_load_newblk            ;ACCU = new float
   634                                  ;; allocate a new pair (float * int)
   635                                  LDA # 0                         ;tag of new pair
   636                                  LDX # 2                         ;size of new pair
   637                                  JSR caml_alloc                  ;alloc new pair
   638                                  ;; set pair elements
   639                                  LDA ACCU
   640                                  STA (BLK),Y
   641                                  INY
   642                                  LDA ACCU + 1
   643                                  STA (BLK),Y                     ;field0 := new float
   644                                  INY
   645                                  LDX # 0
   646                                  PLA                             ;reload biased exponent
   647                                  BNE @debias                     ;exp = 0?
   648                                  LDA # <Val_zero                 ;yes:
   649                                  STA (BLK),Y                     ; set field1,lo := <Val_int(0)
   650                                  LDA # >Val_zero
   651                                  BEQ @fld1h                      ; beq=jmp to set field1,hi
   652                          @debias SEC                             ;no:
   653                                  SBC # $80                       ; compute debiased exponent
   654                                  BCS @valint                     ; if negative,
   655                                  DEX                             ;  set hi byte = $FF
   656                                  SEC
   657                          @valint ROL                             ; compute <Val_int(exponent)
   658                                  STA (BLK),Y                     ; field1,lo := <Val_int(exponent)
   659                                  TXA
   660                                  ROL                             ; compute >Val_int(exponent)
   661                          @fld1h  INY
   662                                  STA (BLK),Y                     ;field1,hi := >Val_int(exponent)
   663                                  LDY # 0
   664                                  JMP caml_load_newblk   
   665                          }
   666                          
   667                          !ifdef caml_PRIM__caml_add_float {
   668                          caml_add_float
   669                                  JSR caml_float_binop
   670                                  BCC @fin
   671                                  LDX # Fb_ADD
   672                                  JMP caml_float_special2
   673                          @fin    LDX # Fo_ADD                        ;(overflow: +-infinity)
   674                                  STX caml_float_overflow__op
   675                                  LDA C64_FAC                         ;FADDT tests .Z (FAC exp = 0?): the
   676                                  +caml_JSR_BASROM C64_FADDT          ; LDX above (Fo_ADD = 0) has set it
   677                                  JMP caml_float_alloc_result
   678                          }
   679                          
   680                          !ifdef caml_PRIM__caml_sub_float {
   681                          caml_sub_float
   682                                  JSR caml_float_binop
   683                                  BCC @fin
   684                                  LDX # Fb_SUB
   685                                  JMP caml_float_special2
   686                          @fin    LDX # Fo_ADD                        ;(overflow: +-infinity)
   687                                  STX caml_float_overflow__op
   688                                  +caml_JSR_BASROM C64_FSUBT
   689                                  JMP caml_float_alloc_result
   690                          }
   691                          
   692                          !ifdef caml_PRIM__caml_mul_float {
   693                          caml_mul_float
   694                                  JSR caml_float_binop
   695                                  BCC @fin
   696                                  LDX # Fb_MUL
   697                                  JMP caml_float_special2
   698                          @fin    LDX # Fo_MUL                        ;(overflow: +-infinity)
   699                                  STX caml_float_overflow__op
   700                                  +caml_JSR_BASROM C64_FMULT
   701                                  JMP caml_float_alloc_result
   702                          }
   703                          
   704                          !ifdef caml_PRIM__caml_div_float {
   705                          caml_div_float
   706                                  JSR caml_float_binop
   707                                  BCC @fin
   708                                  LDX # Fb_DIV
   709                                  JMP caml_float_special2
   710                          @fin    BEQ @dz                         ;FAC exponent = 0: division by zero
   711                                  LDX # Fo_MUL                    ;(overflow: +-infinity)
   712                                  STX caml_float_overflow__op
   713                                  +caml_JSR_BASROM C64_FDIVT
   714                                  JMP caml_float_alloc_result
   715                          @dz     LDA C64_ARG                     ;x / 0.0: nan if x = 0.0, else
   716                                  BEQ @nan                        ; +-infinity with the sign of x
   717                                  LDA C64_ARG + 5
   718                                  BPL @pinf
   719                                  LDA # Ft_NINF
   720                                  BNE @tpl                        ;BNE=JMP
   721                          @pinf   LDA # Ft_PINF
   722                                  BNE @tpl                        ;BNE=JMP
   723                          @nan    LDA # Ft_NAN
   724                          @tpl    JMP caml_float_ret_tpl
   725                          }
   726                          
   727                          !ifdef caml_PRIM__caml_power_float {
   728                          caml_power_float
   729                                  JSR caml_float_binop
   730                                  BCC @fin
   731                                  LDX # Fb_POW
   732                                  JMP caml_float_special2
   733                          @fin    LDA C64_ARG                     ;x = 0.0 ?
   734                                  BNE @xnz
   735                                  BIT C64_FAC + 5                 ;yes: 0.0 ** (y<0) = +infinity
   736                                  BPL @rom                        ; (other cases are managed by ROM)
   737                                  LDA # Ft_PINF
   738                                  BNE @tpl                        ;BNE=JMP
   739                          @xnz    BIT C64_ARG + 5                 ;x < 0 ?
   740                                  BPL @rom
   741                                  LDY # 0                         ;yes: (x<0) ** y is nan if y is not
   742                                  LDA (SP),Y                      ; an integer (ROM raises an error)
   743                                  STA TMP
   744                                  INY
   745                                  LDA (SP),Y
   746                                  STA TMP + 1                     ;(TMP) = y
   747                                  JSR caml_float_intclass
   748                                  TAX
   749                                  BNE @rom
   750                                  LDA # Ft_NAN
   751                          @tpl    JMP caml_float_ret_tpl
   752                          @rom    LDX # Fo_POW                    ;(overflow: +-infinity)
   753                                  STX caml_float_overflow__op
   754                                  LDA C64_FAC                     ;ROM wants .A = FAC exponent
   755                                  +caml_JSR_BASROM C64_FPWRT
   756                                  JMP caml_float_alloc_result
   757                          }
   758                          
   760                          ;; Auxiliary routines
   761                          
   762                          ;; copy ACCU to FAC. Return C=1 if ACCU is special, .A = flag byte
   763                          !ifdef caml_AUX__caml_float_unop {
   764                          caml_float_unop
   765                                  TSX                             ;Save the CPU stack pointer as it will
   766                                  INX                             ; be after returning to the primitive
   767                                  INX                             ; (see caml_float_overflow)
   768                                  STX caml_float_overflow__sp
   769                                  LDA # Fo_NONE
   770                                  STA caml_float_overflow__op     ;the primitive may change it
   771                                  LDA ACCU
   772                                  STA caml_float_loadFAC__addr
   773                                  LDA ACCU + 1
   774                                  STA caml_float_loadFAC__addr + 1
   775                                  JSR caml_float_loadFAC          ;.A = flag byte
   776                                  CMP # 1                         ;C=1 <=> flag <> 0
   777                                  RTS
   778                          }
   779                          
   780                          ;; copy SP[0] to FAC and ACCU to ARG. Return C=1 if one of them is special,
   781                          ;; else C=0, .A = FAC exponent (and flags .Z, .N according to .A), .Y = 0
   782                          !ifdef caml_AUX__caml_float_binop {
   783                          caml_float_binop
   784                                  TSX                             ;as above
   785                                  INX
   786                                  INX
   787                                  STX caml_float_overflow__sp
   788                                  LDA # Fo_NONE
   789                                  STA caml_float_overflow__op
   790                                  LDA (SP),Y
   791                                  STA caml_float_loadFAC__addr
   792                                  INY
   793                                  LDA (SP),Y
   794                                  STA caml_float_loadFAC__addr + 1
   795                                 ;DEY                             ;caml_float_alloc_result will set Y=0
   796                                  JSR caml_float_loadFAC
   797                                  STY TMP                         ;flag byte of SP[0]
   798                                  LDA ACCU
   799                                  STA caml_float_loadARG__addr
   800                                  LDA ACCU + 1
   801                                  STA caml_float_loadARG__addr + 1
   802                                  JSR caml_float_loadARG          ;.Y = flag byte of ACCU, .A = FAC exp
   803                                  PHA
   804                                  TYA
   805                                  ORA TMP                         ;0 <=> both finite
   806                                  CMP # 1                         ;C=1 <=> at least one is special
   807                                  PLA                             ;(does not touch C)
   808                                  RTS
   809                          }
   810                          
   811                          ;; Copy FAC (operation result) to a new allocated float. Flag byte := 0
   812                          !ifdef caml_AUX__caml_float_alloc_result {
   813                          caml_float_alloc_result
   814                                  LDA # Double_tag
   815                                  LDX # Double_wosize
   816                                  LDY # 0
   817                                  JSR caml_alloc
   818                                  LDX BLK
   819                                  LDY BLK + 1
   820                                  +caml_JSR_BASROM C64_MOVMF
   821                                  LDY # Float_flag
   822                                  LDA # 0
   823                                  STA (BLK),Y                     ;finite
   824                                  TAY
   825                                  JMP caml_load_newblk   
   826                          }
   827                          
   828                          ;; FAC/ARG loading routines -- how to use: 1) write float address in
   829                          ;; caml_float_loadFAC/ARG__addr; 2) JSR caml_float_loadFAC/ARG
   830                          ;; FAC: return .A = .Y = flag byte of the float. ARG: return .Y = flag byte,
   831                          ;; .A = FAC exponent
   832                          
   833                          !ifdef caml_AUX__caml_float_loadFAC {
   834                          caml_float_loadFAC
   835                                  LDX # 5
   836                          caml_float_loadFAC__addr = * + 1
   837                          -       LDA .dummy,X                    ;SMC: replaced with real address
   838                                  STA C64_FAC,X
   839                                  DEX
   840                                  BPL -
   841                                  LDY C64_FAC + 5                 ;flag byte
   842                                  LDA C64_FAC + 1                 ;copy 1st byte of mantissa
   843                                  STA C64_FAC + 5                 ;to FAC sign byte
   844                                  ORA # $80
   845                                  STA C64_FAC + 1                 ;set 1st bit of mantissa = 1
   846                                  INX
   847                                  STX C64_FACRND                  ;FAC round byte := 0
   848                                  TYA                             ;.A = flag byte (sets .Z)
   849                                  RTS
   850                          }
   851                          
   852                          !ifdef caml_AUX__caml_float_loadARG {
   853                          caml_float_loadARG
   854                                  LDX # 5
   855                          caml_float_loadARG__addr = * + 1
   856                          -       LDA .dummy,X                    ;SMC: replaced with real address
   857                                  STA C64_ARG,X
   858                                  DEX
   859                                  BPL -
   860                                  LDY C64_ARG + 5                 ;flag byte
   861                                  LDX C64_ARG + 1                 ;copy 1st byte of mantissa
   862                                  STX C64_ARG + 5                 ;to ARG sign byte
   863                                  TXA
   864                                  EOR C64_FAC + 5                 ;compare with FAC sign byte
   865                                  STA C64_ARISGN                  ;store result of comparison
   866                                  TXA
   867                                  ORA # $80
   868                                  STA C64_ARG + 1                 ;set 1st bit of mantissa = 1
   869                                  LDA C64_FAC                     ;.A := FAC exponent
   870                                  RTS
   871                          }
   872                          
   873                          ;; Allocate a new float, copying the template at offset .A (Ft_*) in the table
   874                          !ifdef caml_AUX__caml_float_ret_tpl {
   875                          caml_float_ret_tpl
   876                                  PHA
   877                                  LDA # Double_tag
   878                                  LDX # Double_wosize
   879                                  LDY # 0
   880                                  JSR caml_alloc
   881                                  PLA
   882                                  TAX
   883                                  LDY # 0
   884                          -       LDA caml_float_ret_tpl__tab,X
   885                                  STA (BLK),Y
   886                                  INX
   887                                  INY
   888                                  CPY # 6
   889                                  BNE -
   890                                  LDY # 0
   891                                  JMP caml_load_newblk
   892                          caml_float_ret_tpl__tab
   893                                  !byte $00, $00, $00, $00, $00, $00      ;Ft_ZERO  0.0
   894                                  !byte $81, $00, $00, $00, $00, $00      ;Ft_ONE   1.0
   895                                  !byte $81, $80, $00, $00, $00, $00      ;Ft_M1   -1.0
   896                                  !byte $81, $49, $0F, $DA, $A2, $00      ;Ft_PIH   pi/2
   897                                  !byte $81, $C9, $0F, $DA, $A2, $00      ;Ft_NPIH -pi/2
   898                                  !byte $FF, $7F, $FF, $FF, $FF, Fl_pinf  ;Ft_PINF +infinity
   899                                  !byte $FF, $FF, $FF, $FF, $FF, Fl_ninf  ;Ft_NINF -infinity
   900                                  !byte $00, $00, $00, $00, $00, Fl_nan   ;Ft_NAN  nan
   901                          }
   902                          
   903                          ;; Unary operation on a special float: .X = Fu_* (operation * 3), ACCU = float
   904                          ;; Result: template of the class (+inf, -inf, nan) of the operand
   905                          !ifdef caml_AUX__caml_float_special1 {
   906                          caml_float_special1
   907                                  LDY # Float_flag
   908                                  LDA (ACCU),Y
   909                                  LDY # 0
   910                                  CMP # Fl_pinf
   911                                  BEQ @cls
   912                                  INY
   913                                  CMP # Fl_ninf
   914                                  BEQ @cls
   915                                  INY
   916                          @cls    STY TMP
   917                                  TXA
   918                                  CLC
   919                                  ADC TMP
   920                                  TAX
   921                                  LDA caml_float_special1__tab,X
   922                                  JMP caml_float_ret_tpl
   923                          caml_float_special1__tab                        ;+inf    -inf    nan
   924                                  !byte Ft_NINF, Ft_PINF, Ft_NAN          ;neg
   925                                  !byte Ft_PINF, Ft_PINF, Ft_NAN          ;abs
   926                                  !byte Ft_PINF, Ft_ZERO, Ft_NAN          ;exp
   927                                  !byte Ft_PINF, Ft_M1,   Ft_NAN          ;expm1
   928                                  !byte Ft_PINF, Ft_NAN,  Ft_NAN          ;log, log1p, log10, sqrt
   929                                  !byte Ft_NAN,  Ft_NAN,  Ft_NAN          ;sin, cos, tan
   930                                  !byte Ft_PIH,  Ft_NPIH, Ft_NAN          ;atan
   931                                  !byte Ft_PINF, Ft_NINF, Ft_NAN          ;floor, ceil
   932                          }
   933                          
   934                          ;; Binary operation, at least one operand being special: .X = Fb_*,
   935                          ;; ACCU = x, SP[0] = y. Allocates the result (IEEE 754 rules).
   936                          ;; TMP,TMP+1 = pointer to y; TMP+2 = flag of x; TMP+3 = flag of y
   937                          !ifdef caml_AUX__caml_float_special2 {
   938                          caml_float_special2
   939                                  LDY # 0
   940                                  LDA (SP),Y
   941                                  STA TMP
   942                                  INY
   943                                  LDA (SP),Y
   944                                  STA TMP + 1
   945                                  LDY # Float_flag
   946                                  LDA (TMP),Y
   947                                  STA TMP + 3
   948                                  LDA (ACCU),Y
   949                                  STA TMP + 2
   950                                  CPX # Fb_MUL
   951                                  BCS @n2
   952                                  CPX # Fb_SUB
   953                                  BNE @add
   954                                  LDA # 0                         ;x - y = x + (-y)
   955                                  SEC
   956                                  SBC TMP + 3                     ;(negates the flag: swaps +-inf,
   957                                  STA TMP + 3                     ; keeps 0 and nan)
   958                          @add    LDA TMP + 2                     ;fx = 0 (finite): result = fy
   959                                  BEQ @rfy
   960                                  LDA TMP + 3
   961                                  BEQ @rfx                        ;fy = 0: result = fx
   962                                  CMP TMP + 2
   963                                  BEQ @rfx                        ;fx = fy: result = fx (inf+inf, nan)
   964                                  LDA # Fl_nan                    ;else (inf-inf, inf+nan, ...): nan
   965                                  BNE @emit                       ;BNE=JMP
   966                          @rfx    LDA TMP + 2
   967                                  BNE @emit                       ;BNE=JMP
   968                          @rfy    LDA TMP + 3
   969                          @emit   LDX # Ft_PINF                   ;.A = flag: emit +inf, -inf or nan
   970                                  CMP # Fl_pinf
   971                                  BEQ @tpl
   972                                  LDX # Ft_NINF
   973                                  CMP # Fl_ninf
   974                                  BEQ @tpl
   975                                  LDX # Ft_NAN
   976                          @tpl    TXA
   977                                  JMP caml_float_ret_tpl
   978                          @n2     CPX # Fb_POW                    ;MUL, DIV, POW:
   979                                  BEQ @pow                        ;(pow: x^0=1 and 1^y=1 even if nan)
   980                                  LDA TMP + 2
   981                                  CMP # Fl_nan
   982                                  BEQ @nan
   983                                  LDA TMP + 3
   984                                  CMP # Fl_nan
   985                                  BEQ @nan
   986                                  CPX # Fb_DIV
   987                                  BEQ @div
   988                                  ;; ---- multiplication: infinity unless inf * 0
   989                                  LDA TMP + 2
   990                                  BEQ @mfx                        ;x finite, y infinite
   991                                  LDX TMP + 3
   992                                  BEQ @mfy                        ;y finite, x infinite
   993                                  EOR TMP + 3                     ;both infinite: sign = fx xor fy
   994                                  BPL @pinf
   995                                  BMI @ninf
   996                          @mfx    LDY # 0
   997                                  LDA (ACCU),Y                    ;x = 0.0 ?
   998                                  BEQ @nan
   999                                  INY
  1000                                  LDA (ACCU),Y                    ;sign of x
  1001                                  EOR TMP + 3
  1002                                  BPL @pinf
  1003                                  BMI @ninf
  1004                          @mfy    LDY # 0
  1005                                  LDA (TMP),Y                     ;y = 0.0 ?
  1006                                  BEQ @nan
  1007                                  INY
  1008                                  LDA (TMP),Y                     ;sign of y
  1009                                  EOR TMP + 2
  1010                                  BPL @pinf
  1011                                  BMI @ninf
  1012                          
  1013                                  ;; ---- division
  1014                          @div    LDA TMP + 2
  1015                                  BNE @dx
  1016                                  LDA # Ft_ZERO                   ;finite / infinite = 0.0
  1017                                  BEQ @tpl2                       ;BEQ=JMP
  1018                          @dx     LDX TMP + 3
  1019                                  BNE @nan    ;inf / inf = nan
  1020                                  LDY # 0
  1021                                  LDA (TMP),Y                     ;inf / y: if y = 0.0 sign is the sign
  1022                                  BEQ @dsg                        ; of x, else sign(x) xor sign(y)
  1023                                  INY
  1024                                  LDA (TMP),Y
  1025                                  EOR TMP + 2
  1026                                  BPL @pinf
  1027                                  BMI @ninf
  1028                          @dsg    LDA TMP + 2                     ;(flag $01 or $FF)
  1029                                  BPL @pinf
  1030                                 ;BMI @ninf
  1031                          @ninf   LDA # Ft_NINF
  1032                                  BNE @tpl2
  1033                          @nan    LDA # Ft_NAN
  1034                                  BNE @tpl2
  1035                          @pinf   LDA # Ft_PINF
  1036                          @tpl2   JMP caml_float_ret_tpl
  1037                          
  1038                                  ;; ---- x ^ y
  1039                          @pow    LDA TMP + 3
  1040                                  BNE @p2
  1041                                  LDY # 0                         ;y finite (so x is special):
  1042                                  LDA (TMP),Y                     ; x ^ 0.0 = 1.0
  1043                                  BEQ @one
  1044                          @p2     LDA TMP + 2
  1045                                  BEQ @xfin
  1046                                  LDA # 1                         ;x infinite: |x| > 1
  1047                                  BNE @m
  1048                          @xfin   JSR @cmp1                       ;compare |x| with 1: $FF, 0, 1
  1049                                  BNE @m
  1050                                  LDY # 1                         ;|x| = 1: if x = +1.0 result is 1.0
  1051                                  LDA (ACCU),Y                    ; for every y (even nan)
  1052                                  BPL @one
  1053                                  LDA # 0
  1054                          @m      STA TMP + 4                     ;TMP+4 = -1, 0, 1 for |x| <, =, > 1
  1055                                  LDA TMP + 2
  1056                                  CMP # Fl_nan
  1057                                  BEQ @nan
  1058                                  LDA TMP + 3
  1059                                  CMP # Fl_nan
  1060                                  BEQ @nan
  1061                                  LDA TMP + 3
  1062                                  BEQ @yfin
  1063                                  LDA TMP + 4                     ;y = +-infinity
  1064                                  BEQ @one                        ; |x| = 1: 1.0
  1065                                  EOR TMP + 3                     ; same sign (|x|>1 and y=+inf, or
  1066                                  BPL @pinf   ;  |x|<1 and y=-inf): +inf, else 0.0
  1067                          @zero   LDA # Ft_ZERO
  1068                                  BEQ @tpl2                       ;BEQ=JMP
  1069                          @one    LDA # Ft_ONE
  1070                                  BNE @tpl2                       ;BNE=JMP
  1071                          @yfin   LDY # 1                         ;y finite, x infinite:
  1072                                  LDA (TMP),Y
  1073                                  BMI @zero                       ; y < 0: 0.0
  1074                                  LDA TMP + 2
  1075                                  CMP # Fl_pinf
  1076                                  BEQ @pinf   ; (+inf) ^ (y>0) = +inf
  1077                                  JSR caml_float_intclass         ; (-inf) ^ y: -inf if y is an odd
  1078                                  CMP # 2                         ;  integer, else +inf
  1079                                  BCS @ninf
  1080                                  BCC @pinf
  1081                          @cmp1   LDY # 0                         ;compare |ACCU| with 1.0 (finite)
  1082                                  LDA (ACCU),Y                    ; return .A=$FF if |x|<1, 0 if |x|=1,
  1083                                  CMP # $81                       ; 1 if |x|>1 (flags set by .A)
  1084                                  BCC @lt
  1085                                  BNE @gt
  1086                                  INY
  1087                                  LDA (ACCU),Y
  1088                                  AND # $7F
  1089                                  BNE @gt
  1090                          -       INY
  1091                                  LDA (ACCU),Y
  1092                                  BNE @gt
  1093                                  CPY # 4
  1094                                  BCC -
  1095                                  LDA # 0
  1096                                  RTS
  1097                          @lt     LDA # $FF
  1098                                  RTS
  1099                          @gt     LDA # 1
  1100                                  RTS
  1101                          }
  1102                          
  1103                          ;; Class of the finite float (TMP) = y: .A = 0 if y is not an integer, 1 if it
  1104                          ;; is an even integer (or 0.0), 2 if it is an odd integer. Flags set by .A
  1105                          ;; y = 0.m * 2^E, E = exponent - $80. Not an integer if E <= 0 (y <> 0); even
  1106                          ;; if E > 32; else odd <=> E + (trailing zeroes of the 32 bits of the mantissa)
  1107                          ;; = 32, even if > 32, not an integer if < 32.
  1108                          !ifdef caml_AUX__caml_float_intclass {
  1109                          caml_float_intclass
  1110                                  LDY # 0
  1111                                  LDA (TMP),Y
  1112                                  BEQ @even
  1113                                  SEC
  1114                                  SBC # $80
  1115                                  BCC @no
  1116                                  BEQ @no
  1117                                  CMP # 33
  1118                                  BCS @even
  1119                                  STA TMP + 5
  1120                                  LDX # 0
  1121                                  LDY # 4
  1122                          @tz     LDA (TMP),Y
  1123                                  BNE @bits
  1124                                  TXA
  1125                                  CLC
  1126                                  ADC # 8
  1127                                  TAX
  1128                                  DEY
  1129                                  CPY # 1
  1130                                  BNE @tz
  1131                                  LDA (TMP),Y                     ;1st byte: bit 7 is the sign, the
  1132                                  ORA # $80                       ; mantissa bit is 1
  1133                          @bits   LSR
  1134                                  BCS @cnt
  1135                                  INX
  1136                                  BNE @bits
  1137                          @cnt    TXA
  1138                                  CLC
  1139                                  ADC TMP + 5
  1140                                  CMP # 32
  1141                                  BEQ @odd
  1142                                  BCS @even
  1143                          @no     LDA # 0
  1144                                  RTS
  1145                          @even   LDA # 1
  1146                                  RTS
  1147                          @odd    LDA # 2
  1148                                  RTS
  1149                          }
  1150                          
  1151                          ;; Domain check for the float just loaded into FAC: log x (.X = 0) or sqrt x
  1152                          ;; (.X <> 0). If x < 0, or x = 0 and .X = 0, the primitive is terminated here
  1153                          ;; with the result (nan, -infinity): the routine pops its return address and
  1154                          ;; jumps to caml_float_ret_tpl.
  1155                          !ifdef caml_AUX__caml_float_logdom {
  1156                          caml_float_logdom
  1157                                  LDA C64_FAC
  1158                                  BNE @nz
  1159                                  TXA                             ;x = 0.0: sqrt is fine,
  1160                                  BNE @ok                         ; log 0.0 = -infinity
  1161                                  PLA
  1162                                  PLA
  1163                                  LDA # Ft_NINF
  1164                                  JMP caml_float_ret_tpl
  1165                          @nz     BIT C64_FAC + 5                 ;x < 0 ?
  1166                                  BPL @ok
  1167                                  PLA
  1168                                  PLA
  1169                                  LDA # Ft_NAN
  1170                                  JMP caml_float_ret_tpl
  1171                          @ok     RTS
  1172                          }
  1173                          
  1174                          ;; A BASIC ROM routine called by a floating-point primitive raised the OVERFLOW
  1175                          ;; error. Called (JSR) by caml_syserr. If the primitive set the operation in
  1176                          ;; caml_float_overflow__op, the CPU stack is restored as it was when
  1177                          ;; caml_float_unop/binop (or the primitive itself) saved it in
  1178                          ;; caml_float_overflow__sp, and the primitive returns +-infinity to its caller.
  1179                          ;; Otherwise return to caml_syserr, which raises Sys_error "OVERFLOW".
  1180                          ;; The sign of the result is: add, sub: sign of x (ACCU); mul, div: sign(x)
  1181                          ;; xor sign(y) (SP[0]); pow: - if x < 0 and y is an odd integer; exp: +;
  1182                          ;; float_of_string: - if the string starts with '-'.
  1183                          !ifdef caml_AUX__caml_float_overflow {
  1184                          caml_float_overflow
  1185                                  LDA caml_float_overflow__op
  1186                                  BPL @known
  1187                                  RTS                             ;unknown operation: raise the error
  1188                          @known  BEQ @sgnx                       ;Fo_ADD
  1189                                  CMP # Fo_POW
  1190                                  BEQ @pow
  1191                                  BCS @exp                        ;Fo_EXP, Fo_STR
  1192                                  LDY # 0                         ;Fo_MUL
  1193                                  LDA (SP),Y
  1194                                  STA TMP
  1195                                  INY
  1196                                  LDA (SP),Y
  1197                                  STA TMP + 1                     ;(TMP) = y
  1198                                  LDA (TMP),Y                     ;.Y = 1: sign of y,
  1199                                  EOR (ACCU),Y                    ; xor sign of x
  1200                                  BMI @neg
  1201                                  BPL @pos
  1202                          @exp    CMP # Fo_STR
  1203                                  BNE @pos                        ;Fo_EXP: +infinity
  1204                                  LDA TMP                         ;Fo_STR: restore the BASIC program
  1205                                  STA C64_CHRPTR                  ; pointer, saved by the primitive
  1206                                  LDA TMP + 1
  1207                                  STA C64_CHRPTR + 1
  1208                                  LDY # 0
  1209                                  LDA (ACCU),Y
  1210                                  CMP # '-'
  1211                                  BEQ @neg
  1212                                  BNE @pos
  1213                          @pow    LDY # 1
  1214                                  LDA (ACCU),Y                    ;x < 0 ?
  1215                                  BPL @pos
  1216                                  LDY # 0
  1217                                  LDA (SP),Y
  1218                                  STA TMP
  1219                                  INY
  1220                                  LDA (SP),Y
  1221                                  STA TMP + 1                     ;(TMP) = y
  1222                                  JSR caml_float_intclass
  1223                                  CMP # 2                         ;negative result iff y is odd
  1224                                  BCS @neg
  1225                                  BCC @pos
  1226                          @sgnx   LDY # 1
  1227                                  LDA (ACCU),Y                    ;sign of x
  1228                                  BMI @neg
  1229                          @pos    LDA # Ft_PINF
  1230                                  BNE @res                        ;BNE=JMP
  1231                          @neg    LDA # Ft_NINF
  1232                          @res    LDX # Fo_NONE                   ;Handle overflow: reset op, so that a
  1233                                  STX caml_float_overflow__op     ; later overflow raised by a ROM routine
  1234                                  LDX caml_float_overflow__sp     ; which doesn't set it is an error.
  1235                                  TXS                             ;Restore the CPU stack pointer
  1236                                  JMP caml_float_ret_tpl          ;return the result to the caller
  1237                          caml_float_overflow__sp
  1238                                  !byte 0
  1239                          caml_float_overflow__op
  1240                                  !byte Fo_NONE
  1241                          }
  1242                          
  1243                          }      ;; !zone caml_FLOATS
  1244                          

