    20                          
    21                          !ifdef caml_PRIM__caml_nonstd_print_char {
    22                          caml_nonstd_print_char
    23  554a 46fc                       LSR ACCU + 1
    24  554c a5fb                       LDA ACCU
    25  554e 6a                         ROR
    26  554f 84fc                       STY ACCU + 1
    27  5551 a201                       LDX # <Val_unit
    28  5553 86fb                       STX ACCU
    29  5555 4ccaf1                     JMP C64_CHROUT                  ;JMP = JSR+RTS
    30                          }
    31                          
    32                          !ifdef caml_PRIM__caml_nonstd_read_line {
    33                          caml_nonstd_read_line
    34                                  ;; Stdlib.read_line
    35                          @CNT    = TMP                           ;string length
    36                          @PTR    = TMP + 2                       ;buffer pointer
    37                                  LDA # String_tag
    38                                  LDX # $FF
    39                                  JSR caml_alloc                  ;allocate buffer, addr in BLK
    40                                  LDA BLK
    41                                  STA @PTR
    42                                  LDA BLK + 1
    43                                  STA @PTR + 1                    ;init buffer pointer
    44                                  STY @CNT                        ;reset char counter
    45                                  STY @CNT + 1
    46                                  STY C64_BLNSW                   ;enable cursor blink
    47                          -       JSR C64_GETIN                   ;A:=char from keyboard; X,Y:=?
    48                                  BEQ -                           ;no char entered
    49                                  TAX                             ;save char in X
    50                                  CMP # $14
    51                                  BEQ @delete                     ;DELETE
    52                                  CMP # $0D
    53                                  BEQ @return                     ;RETURN
    54                                  AND # %01111111
    55                                  CMP # $20
    56                                  BCC -                           ;NON-PRINTABLE
    57                                  LDA @CNT + 1                    ;check counter
    58                                  BEQ +                           ;ok, cnt < 256
    59                                  LDA @CNT
    60                                  CMP # <509
    61                                  BEQ -                           ;cnt=509, only DEL/CR admitted:
    62                          +       TXA                             ;reload char in A
    63                                  LDY # $00                       ;(Y used by C64_GETIN)
    64                                  STA (@PTR),Y                    ;put char into the buffer
    65                                  INC @PTR                        ;increment the buffer pointer
    66                                  BNE +
    67                                  INC @PTR + 1
    68                          +       INC @CNT                        ;increment the counter
    69                                  BNE +
    70                                  INC @CNT + 1
    71                          +       JSR C64_CHROUT                  ;print char
    72                                  JMP -                           ;process next char
    73                          @delete LDA @CNT                        ;if counter_lo = 0
    74                                  BNE +
    75                                  ORA @CNT + 1                    ;then if counter_hi = 0
    76                                  BEQ -                           ;    then nothing to del, jmp -
    77                                  DEC @CNT + 1                    ;    else decr counter_hi;
    78                          +       DEC @CNT                        ;decr counter_lo
    79                                  LDA @PTR                        ;if pointer_lo = 0
    80                                  BNE +
    81                                  DEC @PTR + 1                    ;then decr pointer_hi
    82                          +       DEC @PTR                        ;decr pointer_lo
    83                                  TXA                             ;reload char in A
    84                                  JSR C64_CHROUT                  ;print char
    85                                  JMP -                           ;process next char
    86                          @return DEC C64_BLNSW                   ;disable cursor blink
    87                                  JSR C64_CHROUT                  ;print newline
    88                                  LSR @CNT + 1
    89                                  ROR @CNT                        ;counter := counter / 2
    90                                  LDY # 0
    91                                  TYA                             ;add string padding:
    92                                  STA (@PTR),Y                    ;1st padding byte = 0
    93                                  BCS +                           ;is counter even?
    94                                  INY
    95                                  TYA
    96                                  STA (@PTR),Y                    ;yes: 2nd padding byte = 1
    97                                  DEY                             ;Y := 0
    98                          +       LDX @CNT
    99                                  INX                             ;X := # words of padded string
   100                                  JSR caml_shrink_latest_alloc    ;shrink allocated block
   101                                  JMP caml_load_newblk            ;return string in ACCU
   102                          }
   103                          
   104                          !ifdef caml_PRIM__caml_nonstd_print_string {
   105                          caml_nonstd_print_string
   106                                  ;; Stdlib.print_string
   107  5558 a0ff                       LDY # -1
   108  555a c6fc                       DEC ACCU + 1
   109  555c b1fb                       LDA (ACCU),Y                    ;get block size
   110  555e e6fc                       INC ACCU + 1
   111  5560 c8                         INY
   112  5561 aa                         TAX                             ;X := size
   113  5562 ca                 -       DEX                             ;X := X - 1
   114  5563 f012                       BEQ +                           ;Exit loop when X=0
   115  5565 b1fb                       LDA (ACCU),Y                    ;Loop: print 2 chars a time
   116  5567 20caf1                     JSR C64_CHROUT                  ; first char
   117  556a c8                         INY
   118  556b b1fb                       LDA (ACCU),Y
   119  556d 20caf1                     JSR C64_CHROUT                  ; second one
   120  5570 c8                         INY
   121  5571 d0ef                       BNE -                           ;Continue loop
   122  5573 e6fc                       INC ACCU + 1
   123  5575 d0eb                       BNE -                           ;BNE=JMP, continue loop
   124  5577 c8                 +       INY
   125  5578 b1fb                       LDA (ACCU),Y                    ;Load last byte
   126  557a d006                       BNE +                           ;If last byte = 0
   127  557c 88                         DEY
   128  557d b1fb                       LDA (ACCU),Y                    ;then load previous one
   129  557f 20caf1                     JSR C64_CHROUT                  ; and print it.
   130  5582 a901               +       LDA # Val_unit
   131  5584 85fb                       STA ACCU
   132  5586 a000                       LDY # 0
   133  5588 84fc                       STY ACCU + 1                    ;ACCU := Val_unit
   134  558a 60                         RTS
   135                          }
   136                          
   137                          !ifdef caml_PRIM__caml_nonstd_get_key {
   138                          caml_nonstd_get_key
   139                                  ;; C64.Key.get : unit -> char; '\000' if no key is waiting
   140  558b 203ef1                     JSR C64_GETIN                   ;A := PETSCII code or 0
   141  558e a000                       LDY # 0
   142  5590 84fc                       STY ACCU + 1
   143  5592 38                         SEC
   144  5593 2a                         ROL
   145  5594 85fb                       STA ACCU
   146  5596 26fc                       ROL ACCU + 1                    ;ACCU := Val_int(A)
   147  5598 60                         RTS
   148                          }
   149                          
   150                          !ifdef caml_PRIM__caml_nonstd_wait_key {
   151                          caml_nonstd_wait_key
   152                                  ;; Stdlib.stdin, C64.Key.wait : unit -> char; waits for a key
   153                          -       JSR C64_GETIN
   154                                  BEQ -
   155                                  LDY # 0
   156                                  STY ACCU + 1
   157                                  SEC
   158                                  ROL
   159                                  STA ACCU
   160                                  ROL ACCU + 1                    ;ACCU := Val_int(A)
   161                                  RTS
   162                          }
   163                          
   164                          !ifdef caml_PRIM__caml_nonstd_joystick {
   165                          caml_nonstd_joystick
   166                                  ;; C64.Key.joy : int -> int; port 1 or 2 -> |FIRE|RIGHT|LEFT|DOWN|UP|
   167  5599 46fc                       LSR ACCU + 1
   168  559b 66fb                       ROR ACCU                        ;ACCU := Int_val(port)
   169  559d a5fb                       LDA ACCU
   170  559f a000                       LDY # 0
   171  55a1 c901                       CMP # 1
   172  55a3 d00e                       BNE @port2
   173  55a5 08                         PHP
   174  55a6 78                         SEI
   175  55a7 a9ff                       LDA # $FF
   176  55a9 8d00dc                     STA C64_CIA1_PRA                ;deselect all keyboard columns
   177  55ac ad01dc                     LDA C64_CIA1_PRB
   178  55af 28                         PLP
   179  55b0 4cb655                     JMP @ret
   180  55b3 ad00dc             @port2  LDA C64_CIA1_PRA
   181  55b6 49ff               @ret    EOR # $FF
   182  55b8 291f                       AND # %00011111                 ;1 = active
   183  55ba 84fc                       STY ACCU + 1
   184  55bc 38                         SEC
   185  55bd 2a                         ROL
   186  55be 85fb                       STA ACCU
   187  55c0 26fc                       ROL ACCU + 1                    ;ACCU := Val_int(A)
   188  55c2 60                         RTS
   189                          }
   190                          
   191                          }       ;; !zone caml_IO
