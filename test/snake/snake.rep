    41                          ;; Macros in opcode order, but dependencies
    42                          
    43                          ;; i00-i12 depend on i08
    44                          
    45                          !macro  i08 .n {                                ;ACCESS n
    46                                  +caml_range 0, .n, $7FFF, "ACC n: n" 
    47                                  .n2h = >(2 * .n)
    48                                  .n2l = <(2 * .n)
    49                            !if .n2l > 0 {
    50                                  LDY # .n2l
    51                            }
    52                            !if .n2h = 0 {
    53                                  !set    caml_gen_ACCL = 1
    54                                  JSR caml_ACCL
    55                            } elif .n2h = 1 {
    56                                  !set    caml_gen_ACCL = 1
    57                                  INC SP + 1
    58                                  JSR caml_ACCL
    59                                  DEC SP + 1
    60                            } else {
    61                                  !set    caml_gen_ACCH = 1
    62                                  LDA # .n2h
    63                                  JSR caml_ACCH
    64                            }
    65                          }
    66                          !macro  i00     {+i08 0}                        ;ACCi -> ACC i
    67                          !macro  i01     {+i08 1}
    68                          !macro  i02     {+i08 2}
    69                          !macro  i03     {+i08 3}
    70                          !macro  i04     {+i08 4}
    71                          !macro  i05     {+i08 5}
    72                          !macro  i06     {+i08 6}
    73                          !macro  i07     {+i08 7}
