   276                                  LSR TMP + 1
   277                                  ROR TMP
   278                                  CLC
   279                                  LDA TMP
   280                                  ADC ACCU
   281                                  STA ACCU
   282                                  LDA TMP + 1
   283                                  ADC ACCU + 1
   284                                  STA ACCU + 1
   285                                  RTS
   286                          }
   287                          
   288                          !ifdef caml_PRIM__caml_lazy_follow_forward {
   289                                  ;; ACCU = value
   290                          caml_lazy_follow_forward
   291                                  ;; is value a block?
   292                                  LDA ACCU
   293                                  BIT caml_is_block
   294                                  BNE @exit
   295                                  ;; tag(value) = Forward_tag?
   296                                  LDY # -2
   297                                  DEC ACCU + 1
   298                                  LDA (ACCU),Y
   299                                  INC ACCU + 1
   300                                  LDY # 0
   301                                  CMP # Forward_tag
   302                                  BNE @exit
   303                                  ;; is value in heap?
   304                                  SEC
   305                                  LDA # < caml_heap_start
   306                                  SBC ACCU
   307                                  STA TMP
   308                                  LDA # > caml_heap_start
   309                                  SBC ACCU + 1
   310                                  STA TMP + 1
   311                                  LDA TMP
   312                                  CMP # < caml_heap_sz
   313                                  LDA TMP + 1
   314                                  SBC # > caml_heap_sz
   315                                  BCS @exit
   316                                  ;; ACCU <- Field(value,0)
   317                                  LDA (ACCU),Y
   318                                  TAX
   319                                  INY
   320                                  LDA (ACCU),Y
   321                                  STA ACCU + 1
   322                                  STX ACCU
   323                                  DEY
   324                          @exit   RTS
   325                          }
   326                          
   327                          !ifdef caml_PRIM__caml_lazy_make_forward {
   328                                  ;; ACCU = value
   329                          caml_lazy_make_forward
   330                                  LDA # Forward_tag
   331                                  LDX # 1
   332                                  JSR caml_alloc
   333                                  LDA ACCU
   334                                  STA (BLK),Y
   335                                  INY
   336                                  LDA ACCU + 1
   337                                  STA (BLK),Y
   338                                  DEY
   339                                  LDA BLK
   340                                  STA ACCU
   341                                  LDA BLK + 1
   342                                  STA ACCU + 1
   343                                  RTS
   344                          }
   345                          
   346                          }      ;; !zone caml_OBJ
