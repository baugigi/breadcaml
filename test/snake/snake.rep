   305                          caml_nonstd_hw_unsafe_blit_at
   306                                  +caml_hw_addr_page
   307                                  +caml_hw_value 1
   308                                  STA TMP + 5
   309                                  +caml_hw_value 2
   310                                  STA TMP + 4
   311                                  +caml_hw_int16 3
   312                                  JMP caml_hw_blit
   313                          }
   314                          
   315                          !ifdef caml_PRIM__caml_nonstd_hw_blit_at {
   316                          caml_nonstd_hw_blit_at
   317                                  +caml_hw_addr_page
   318                                  +caml_hw_value 1
   319                                  STA TMP + 5
   320                                  +caml_hw_value 2
   321                                  STA TMP + 4
   322                                  +caml_hw_int16 3
   323                                  LDA TMP + 4
   324                                  CMP # <caml_stack_end
   325                                  LDA TMP + 5
   326                                  SBC # >caml_stack_end
   327                                  BCC @err                        ;destination below caml_stack_end
   328                                  LDA TMP + 1
   329                                  CMP # $40
   330                                  BCS @err                        ;negative length
   331                                  LDA TMP + 4
   332                                  CLC
   333                                  ADC TMP
   334                                  STA TMP + 2
   335                                  LDA TMP + 5
   336                                  ADC TMP + 1
   337                                  BCC @ok
   338                                  ORA TMP + 2
   339                                  BNE @err                        ;wraps around $FFFF
   340                          @ok     JMP caml_hw_blit
   341                          @err    +caml_raise Invalid_argument, "C64.Hw.Mem.blit_at"
   342                          }
   343                          
   344                          ;; ---- NMI blocking ------------------------------------------------------------
   345                          ;; Nmi.block: the Kernal NMI vector is pointed to an RTI and a CIA2 timer NMI is
   346                          ;; forced. The RTI does not read $DD0D (no ACK): CIA2 keeps /NMI low, no further
   347                          ;; edge can occur (RESTORE key included) until Nmi.unblock (or program exit).
   348                          ;; Needed by peek_ram/peek_at_ram, which run with all ROMs switched off.
   349                          
   350                          !ifdef caml_PRIM__caml_nonstd_hw_nmi_block {
   351                          caml_nonstd_hw_nmi_block
   352                                  PHP
   353                                  SEI
   354                                  LDA # <@rti
   355                                  STA C64_NMINV
   356                                  LDA # >@rti
   357                                  STA C64_NMINV + 1
   358                                  LDA # C64_CIA_ICR_ALL
   359                                  STA C64_CIA2_ICR             ;disable all CIA2 interrupt sources
   360                                  LDA C64_CIA2_ICR             ; and acknowledge pending ones
   361                                  LDA # 1
   362                                  STA C64_CIA2_TALO
   363                                  STY C64_CIA2_TAHI             ;timer A latch := 1
   364                                  LDA # C64_CIA_ICR_SET | C64_CIA_ICR_TA
   365                                  STA C64_CIA2_ICR             ;enable NMI on timer A underflow
   366                                  LDA # C64_CIA_CR_LOAD | C64_CIA_CR_ONESHOT | C64_CIA_CR_START
   367                                  STA C64_CIA2_CRA             ;force load, one shot, start
   368                                  NOP
   369                                  NOP
   370                                  NOP
   371                                  NOP                             ;the NMI occurs here (and is ignored)
   372                                  PLP
   373                                  +caml_hw_ret_unit
   374                                  RTS
   375                          @rti    RTI
   376                          }
   377                          
   378                          !ifdef caml_PRIM__caml_nonstd_hw_nmi_unblock {
   379                          caml_nonstd_hw_nmi_unblock
   380                                  PHP
   381                                  SEI
   382                                  LDA # C64_CIA_ICR_ALL
   383                                  STA C64_CIA2_ICR             ;disable all CIA2 interrupt sources
   384                                  LDA C64_CIA2_ICR             ; and acknowledge pending ones
   385                                  LDA # <C64_KNMI
   386                                  STA C64_NMINV
   387                                  LDA # >C64_KNMI
   388                                  STA C64_NMINV + 1
   389                                  PLP
   390                                  +caml_hw_ret_unit
   391                                  RTS
   392                          }
   393                          
   394                          ;; ---- chip registers ------------------------------------------------------------
   395                          ;; peek off / poke off v on VIC-II, SID, CIA1, CIA2: off = register offset from
   396                          ;; the chip base address (0..127; larger values wrap modulo 128). No checks at all.
   397                          ;; Color RAM: off = 0..999, reads return the low nybble only.
   398                          
   399                          !macro caml_hw_reg_peek .base {
   400                                  LDA ACCU
   401                                  LSR
   402                                  TAX                             ;X := Int_val(off) mod 128
   403                                  LDA .base,X
   404                                  +caml_hw_ret_int
   405                                  RTS
   406                          }
   407                          !macro caml_hw_reg_poke .base {
   408                                  LDA ACCU
   409                                  LSR
   410                                  TAX                             ;X := Int_val(off) mod 128
   411                                  +caml_hw_value 0
   412                                  STA .base,X
   413                                  +caml_hw_ret_unit
   414                                  RTS
   415                          }
   416                          
   417                          !ifdef caml_PRIM__caml_nonstd_hw_vic_peek {
   418                          caml_nonstd_hw_vic_peek
   419                                  +caml_hw_reg_peek C64_VIC_M0X
   420                          }
   421                          !ifdef caml_PRIM__caml_nonstd_hw_vic_poke {
   422                          caml_nonstd_hw_vic_poke
   423                                  +caml_hw_reg_poke C64_VIC_M0X

