    14                          ;; -----------------------------------------------------------------------------
    15                          ;;                       C64.Hw.Mem - LOW LEVEL MEMORY ACCESS
    16                          ;; -----------------------------------------------------------------------------
    17                          ;; Address encodings (OCaml ints are 15 bit, addresses are 16 bit):
    18                          ;;  - short form  (peek, poke):         the tagged int, sign-extended, IS the
    19                          ;;      address: 0..$3FFF -> $0000-$3FFF, -16384..-1 -> $C000-$FFFF.
    20                          ;;  - page form   (peek_at, poke_at):   address = page * 256 + off, both 0..255.
    21                          ;; poke/poke_at refuse addresses in [$0000, caml_stack_end) (Invalid_argument);
    22                          ;; unsafe_poke/unsafe_poke_at do not check anything. The value is masked to 8 bits.
    23                          ;; peek_ram/peek_at_ram read the RAM under the ROMs/I/O (interrupts disabled).
    24                          
    25                          !zone caml_C64_HW {
    26                          
    27                          ;; short form: ACCU := sign-extended Int_val(ACCU)
    28                          !macro caml_hw_addr_short {
    29                                  LDA ACCU + 1
    30                                  CMP # $80
    31                                  ROR ACCU + 1
    32                                  ROR ACCU
    33                          }
    34                          ;; page form: ACCU = page, SP[0] = off -> ACCU := page * 256 + off   {Y = 0}
    35                          !macro caml_hw_addr_page {
    36                                  LSR ACCU + 1
    37                                  ROR ACCU
    38                                  LDX ACCU                        ;X := page
    39                                  INY
    40                                  LDA (SP),Y
    41                                  LSR
    42                                  DEY
    43                                  LDA (SP),Y
    44                                  ROR                             ;A := off
    45                                  STA ACCU
    46                                  STX ACCU + 1
    47                          }
    48                          ;; C := 1 iff ACCU (address) >= caml_stack_end (unsigned 16 bit compare)
    49                          !macro caml_hw_check {
    50                                  LDA ACCU
    51                                  CMP # <caml_stack_end
    52                                  LDA ACCU + 1
    53                                  SBC # >caml_stack_end
    54                          }
    55                          ;; A := low 8 bits of Int_val(SP[.n])   {leaves Y = 0}
    56                          !macro caml_hw_value .n {
    57                                  LDY # .n * 2 + 1
    58                                  LDA (SP),Y
    59                                  LSR
    60                                  DEY
    61                                  LDA (SP),Y
    62                                  ROR
    63                                  LDY # 0
    64                          }
    65                          !macro caml_hw_int16 .n {               ;TMP,TMP+1 := Int_val(SP[.n])  {Y = 0}
    66                                  LDY # .n * 2 + 1
    67                                  LDA (SP),Y
    68                                  LSR
    69                                  STA TMP + 1
    70                                  DEY
    71                                  LDA (SP),Y
    72                                  ROR
    73                                  STA TMP
    74                                  LDY # 0
    75                          }
    76                          !macro caml_hw_ret_int {                ;ACCU := Val_int(A)
    77                                  STY ACCU + 1
    78                                  SEC
    79                                  ROL
    80                                  STA ACCU
    81                                  ROL ACCU + 1
    82                          }
    83                          !macro caml_hw_ret_unit {
    84                                  LDX # <Val_unit
    85                                  STX ACCU
    86                                  STY ACCU + 1
    87                          }
    88                          !macro caml_hw_read_ram {               ;A := RAM[ACCU], I flag preserved
    89                                  PHP
    90                                  SEI
    91                                  LDA C64_R6510
    92                                  PHA
    93                                  AND # C64_R6510_RAM
    94                                  STA C64_R6510
    95                                  LDA (ACCU),Y
    96                                  TAX
    97                                  PLA
    98                                  STA C64_R6510
    99                                  PLP
   100                                  TXA
   101                          }
