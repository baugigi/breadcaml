   273                          !ifdef caml_PRIM__caml_floatarray_get {
   274                                  ;; return an array element (floatarray version)
   275                                  ;; ACCU = array
   276                                  ;; SP[0] = index
   277                          caml_floatarray_get
   278                                  DEY
   279                                  DEC ACCU + 1
   280                          caml_floatarray_get__loadsize
   281                          @SZ     = TMP
   282                          @IDX    = TMP + 1
   283                                  ;; load size
   284                                  LDA (ACCU),Y
   285                                  STA @SZ
   286                                  INC ACCU + 1                    ;restore ACCU+1
   287                                  ;; allocate float
   288                                  LDA # Double_tag
   289                                  LDX # Double_wosize
   290                                  JSR caml_alloc
   291                                  ;; load index, hi
   292                                  LDY # 1
   293                                  LDA (SP),Y
   294                                  BNE @error                      ;exn if hi > 0
   295                                  ;; load index, lo
   296                                  DEY
   297                                  LDA (SP),Y
   298                                  ;; exn if 3 * index >= size
   299                                  JSR caml_IntValx3
   300                                  BCS @error
   301                                  CMP @SZ
   302                                  BCS @error
   303                                  ;; ACCU <- &array[index]
   304                                  LDX # ACCU
   305                                  JSR caml_ptr_add2A
   306                                  ;; copy float
   307                                  +caml_move_float ACCU, BLK
   308                                  ;; return float
   309                                  JMP caml_load_newblk
   310                          @error  JMP caml_err_index_oob
   311                          }
   312                          
   313                          !ifdef caml_PRIM__caml_array_unsafe_get {
   314                          caml_array_unsafe_get
   315                                  ;; return an array element (unsafe version)
   316                                  ;; ACCU = array
   317                                  ;; SP[0] = index
   318                                  LDY # -2
   319                                  DEC ACCU + 1
   320                                  LDA (ACCU),Y                    ;load tag
   321                                  INC ACCU + 1                    ;restore ptr
   322                                  LDY # 0
   323                                  CMP # Double_array_tag          ;check if float
   324                                  BEQ caml_floatarray_unsafe_get  ;yes: special case
   325                                  LDA (SP),Y                      ;Val_int(index), lo
   326                                  STA TMP
   327                                  INY
   328                                  LDA (SP),Y                      ;Val_int(index), hi
   329                                  BEQ +
   330                                  INC ACCU + 1
   331                          +       LDY TMP
   332                                  ;; get array element
   333                                  LDA (ACCU),Y                    ;array[index], hi
   334                                  TAX
   335                                  DEY
   336                                  LDA (ACCU),Y                    ;array[index], lo
   337                                  STA ACCU
   338                                  STX ACCU + 1
   339                                  LDY # 0
   340                                  RTS
   341                          }
   342                          
   343                          !ifdef caml_PRIM__caml_floatarray_unsafe_get {
   344                                  ;; return an array element (unsafe, floatarray version)
   345                                  ;; ACCU = array
   346                                  ;; SP[0] = index
   347                          caml_floatarray_unsafe_get
   348                                  ;; allocate float
   349                                  LDA # Double_tag
   350                                  LDX # Double_wosize
   351                                  JSR caml_alloc
   352                                  ;; load index, lo (ignore hi byte)
   353                                  LDA (SP),Y                      ;2*i+1
   354                                  ;; calc 3 * i
   355                                  JSR caml_IntValx3
   356                                  ;; ACCU <- &array[index]
   357                                  LDX # ACCU
   358                                  JSR caml_ptr_add2A
   359                                  ;; copy float
   360                                  +caml_move_float ACCU, BLK
   361                                  ;; return float
   362                                  JMP caml_load_newblk   
   363                          }
   364                          
   365                          !ifdef caml_PRIM__caml_array_set {
   366                          caml_array_set
   367                                  ;; set an array element to given value
   368                                  ;; ACCU = array
   369                                  ;; SP[0] = index
   370                                  ;; SP[1] = newval
   371                          
   372                                  ;; load tag
   373                                  LDY # -2
   374                                  DEC ACCU + 1
   375                                  LDA (ACCU),Y
   376                                  INY
   377                                  ;; check if float
   378                                  CMP # Double_array_tag
   379                                  BNE caml_array_set_addr__loadsize
   380                                  JMP caml_floatarray_set__loadsize   ;{Y=-1, ACCU+1 already decremented}
   381                          }
   382                          
   383                          !ifdef caml_PRIM__caml_array_set_addr {
   384                                  ;; set an array element to given value (no-float version)
   385                                  ;; ACCU = array
   386                                  ;; SP[0] = Val_int(index)
   387                                  ;; SP[1] = newval
   388                          caml_array_set_addr
   389                                  ;; load size
   390  7ed1 88                         DEY
   391  7ed2 c6fc                       DEC ACCU + 1
   392                          caml_array_set_addr__loadsize
   393                          @SZ     = TMP
   394                          @NEW    = TMP + 1
   395  7ed4 b1fb                       LDA (ACCU),Y
   396  7ed6 854d                       STA @SZ
   397  7ed8 e6fc                       INC ACCU + 1
   398                                  ;; load newval
   399  7eda a003                       LDY # 3
   400  7edc b1fd                       LDA (SP),Y
   401  7ede 854f                       STA @NEW + 1
   402  7ee0 88                         DEY
   403  7ee1 b1fd                       LDA (SP),Y
   404  7ee3 854e                       STA @NEW
   405                                  ;; load index, hi
   406  7ee5 88                         DEY
   407  7ee6 b1fd                       LDA (SP),Y
   408                                  ;; exn if index > 255 or index < 0
   409  7ee8 4a                         LSR
   410  7ee9 d01f                       BNE @error
   411                                  ;; load index, lo
   412  7eeb 88                         DEY
   413  7eec b1fd                       LDA (SP),Y
   414  7eee 6a                         ROR
   415                                  ;; exn if index >= size
   416  7eef c54d                       CMP @SZ
   417  7ef1 b017                       BCS @error
   418                                  ;; array[index] <- newval
   419  7ef3 0a                         ASL
   420  7ef4 9002                       BCC +
   421  7ef6 e6fc                       INC ACCU + 1
   422  7ef8 a8                 +       TAY
   423  7ef9 a54e                       LDA @NEW
   424  7efb 91fb                       STA (ACCU),Y
   425  7efd c8                         INY
   426  7efe a54f                       LDA @NEW + 1
   427  7f00 91fb                       STA (ACCU),Y
   428                                  ;; ACCU <- ()
   429  7f02 a001                       LDY # <Val_unit                 ;Y := 1
   430  7f04 84fb                       STY ACCU
   431  7f06 88                         DEY
   432  7f07 84fc                       STY ACCU + 1
   433  7f09 60                         RTS
   434  7f0a 4c8b7f             @error  JMP caml_err_index_oob
   435                          }
   436                          
   437                          !ifdef caml_PRIM__caml_floatarray_set {
   438                                  ;; set an array element to given value (floatarray version)
   439                                  ;; ACCU = array
   440                                  ;; SP[0] = index
   441                                  ;; SP[1] = newval
   442                          caml_floatarray_set
   443                                  ;; load size
   444                                  DEY
   445                                  DEC ACCU + 1
   446                          caml_floatarray_set__loadsize
   447                          @SZ     = TMP
   448                          @IDX    = TMP + 1
   449                          @NEW    = TMP + 2
   450                                  LDA (ACCU),Y
   451                                  STA @SZ
   452                                  INC ACCU + 1
   453                                  ;; load newval
   454                                  LDY # 3
   455                                  LDA (SP),Y
   456                                  STA @NEW + 1
   457                                  DEY
   458                                  LDA (SP),Y
   459                                  STA @NEW
   460                                  ;; load index, hi
   461                                  DEY
   462                                  LDA (SP),Y
   463                                  ;; exn if hi > 0
   464                                  BNE @error
   465                                  ;; load index, lo
   466                                  DEY
   467                                  LDA (SP),Y
   468                                  ;; exn if 3 * index >= size
   469                                  JSR caml_IntValx3
   470                                  BCS @error
   471                                  CMP @SZ
   472                                  BCS @error
   473                                  ;; ACCU <- &array[index]
   474                                  LDX # ACCU
   475                                  JSR caml_ptr_add2A
   476                                  ;; copy float
   477                                  +caml_move_float @NEW, ACCU
   478                                  ;; ACCU <- ()
   479                                  STY ACCU + 1
   480                                  INY
   481                                  STY ACCU
   482                                  DEY
   483                                  RTS
   484                          @error  JMP caml_err_index_oob
   485                          }
   486                          
   487                          !ifdef caml_PRIM__caml_array_unsafe_set {
   488                          caml_array_unsafe_set
   489                                  ;; set an array element to given value (unsafe version)
   490                                  ;; ACCU = array
   491                                  ;; SP[0] = index
   492                                  ;; SP[1] = newval
   493                          
   494                                  ;; load tag
   495                                  LDY # -2
   496                                  DEC ACCU + 1
   497                                  LDA (ACCU),Y
   498                                  INC ACCU + 1
   499                                  LDY # 0
   500                                  ;; check if float
   501                                  CMP # Double_array_tag
   502                                  BEQ caml_floatarray_unsafe_set
   503                                  ;; FALLTHROUGH caml_array_unsafe_set_addr
   504                          }
   505                          
   506                          !ifdef caml_PRIM__caml_array_unsafe_set_addr {
   507                                  ;; set an array element to given value (unsafe, no-float version)
   508                                  ;; ACCU = array
   509                                  ;; SP[0] = index
   510                                  ;; SP[1] = newval
   511                          caml_array_unsafe_set_addr
   512                                  ;; load index
   513                                  LDA (SP),Y                      ;Val_int(index), lo
   514                                  STA TMP
   515                                  INY
   516                                  LDA (SP),Y                      ;Val_int(index), hi
   517                                  BEQ +
   518                                  INC ACCU + 1
   519                                  ;; load newval
   520                          +       INY
   521                                  LDA (SP),Y
   522                                  TAX
   523                                  INY
   524                                  LDA (SP),Y
   525                                  ;; array[index] <- newval
   526                                  LDY TMP
   527                                  STA (ACCU),Y
   528                                  DEY
   529                                  TXA
   530                                  STA (ACCU),Y
   531                                  ;; ACCU <- ()
   532                                  LDY # <Val_unit                 ;Y := 1
   533                                  STY ACCU
   534                                  DEY
   535                                  STY ACCU + 1
   536                                  RTS
   537                          }
   538                          
   539                          !ifdef caml_PRIM__caml_floatarray_unsafe_set {
   540                                  ;; set an array element to given value (unsafe, floatarray version)
   541                                  ;; ACCU = array
   542                                  ;; SP[0] = index
   543                                  ;; SP[1] = newval
   544                          caml_floatarray_unsafe_set
   545                                  ;; load index, lo (ignore hi byte)
   546                                  LDA (SP),Y                      ;2*i+1
   547                                  ;; calc 3 * i
   548                                  JSR caml_IntValx3
   549                                  ;; ACCU <- &array[index]
   550                                  LDX # ACCU
   551                                  JSR caml_ptr_add2A
   552                                  ;; load newval
   553                                  LDY # 2
   554                                  LDA (SP),Y
   555                                  STA TMP
   556                                  INY
   557                                  LDA (SP),Y
   558                                  STA TMP + 1
   559                                  ;; copy float
   560                                  +caml_move_float TMP, ACCU
   561                                  ;; ACCU <- ()
   562                                  LDA # <Val_unit
   563                                  STA ACCU
   564                                  STY ACCU + 1                    ;Y = 0
   565                                  RTS
   566                          }
   567                          
   568                          !ifdef caml_PRIM__caml_array_blit {
   569                          caml_array_blit
   570                                  ;; copy a subarray to other one (source and dest may overlap)
   571                                  ;; ACCU = arr1
   572                                  ;; SP[0] = ofs1
   573                                  ;; SP[1] = arr2
   574                                  ;; SP[2] = ofs2
   575                                  ;; SP[3] = n
   576                          @NBY    = TMP + 2
   577                                  ;; load tag
   578                                  LDY # -2
   579                                  DEC ACCU + 1
   580                                  LDA (ACCU),Y
   581                                  INC ACCU + 1
   582                                  ;; check if float
   583                                  CMP # Double_array_tag
   584                                  BNE @no_float
   585                                  ;; array of floats, compute source start address
   586                                  LDY # 0
   587                                  STY @NBY + 1
   588                                  LDA (SP),Y                      ;ofs1, ignore hi byte
   589                                  JSR caml_IntValx3
   590                                  ;; ACCU <- &arr1[ofs1]
   591                                  LDX # ACCU                      ;A = 6 * ofs1
   592                                  JSR caml_ptr_add2A
   593                                  ;; compute destination start address
   594                                  LDY # 4
   595                                  LDA (SP),Y                      ;ofs2, ignore hi byte
   596                                  ;; calc 3 * index
   597                                  JSR caml_IntValx3
   598                                  STA TMP
   599                                  ;; TMP <- &arr2[ofs2]
   600                                  TAX                             ;X = 3 * ofs2
   601                                  DEY
   602                                  LDA (SP),Y
   603                                  STA TMP + 1
   604                                  TXA
   605                                  ASL                             ;A = 6 * ofs2
   606                                  BCC +
   607                                  INC TMP + 1
   608                                  CLC
   609                          +       DEY
   610                                  ADC (SP),Y
   611                                  STA TMP
   612                                  BCC +
   613                                  INC TMP + 1
   614                                  ;; @NBY = 6 * n (no. of bytes to be moved)
   615                          +       LDY # 6
   616                                  LDA (SP),Y                      ;ignore hi byte
   617                                  JSR caml_IntValx3
   618                                  ASL
   619                                  STA @NBY
   620                                  BCC +
   621                                  INC @NBY + 1
   622                          +       JMP @copy
   623                          @no_float
   624                                  ;; ordinary array, compute source start address
   625                                  LDY # 0
   626                                  CLC
   627                                  LDA (SP),Y
   628                                  ADC ACCU
   629                                  STA ACCU
   630                                  INY
   631                                  LDA (SP),Y
   632                                  ADC ACCU + 1
   633                                  STA ACCU + 1
   634                                  LDA ACCU
   635                                  BNE +
   636                                  DEC ACCU + 1
   637                          +       DEC ACCU
   638                                  ;; compute destination start address
   639                                  INY
   640                                  LDA (SP),Y
   641                                  STA TMP
   642                                  INY
   643                                  LDA (SP),Y
   644                                  STA TMP + 1
   645                                  INY
   646                                  CLC
   647                                  LDA TMP
   648                                  ADC (SP),Y
   649                                  STA TMP
   650                                  INY
   651                                  LDA TMP + 1
   652                                  ADC (SP),Y
   653                                  STA TMP + 1
   654                                  LDA TMP
   655                                  BNE +
   656                                  DEC TMP + 1
   657                          +       DEC TMP
   658                                  ;; compute no. of bytes to be copied: @NBY = 2n (n = SP[3] = 2n+1 - 1)
   659                                  INY
   660                                  LDA (SP),Y
   661                                  STA @NBY
   662                                  INY
   663                                  LDA (SP),Y
   664                                  STA @NBY + 1
   665                                  LDA @NBY
   666                                  BNE +
   667                                  DEC @NBY + 1
   668                          +       DEC @NBY
   669                                  ;; ACCU = source, TMP = destination, @NBY = no. of bytes (exact)
   670                          @copy   LDA @NBY
   671                                  ORA @NBY + 1
   672                                  BEQ @done0                      ;nothing to copy
   673                                  LDA ACCU
   674                                  CMP TMP
   675                                  LDA ACCU + 1
   676                                  SBC TMP + 1
   677                                  BCS @cpydn
   678                                  ;; source < dest: copy from the end (safe if the ranges overlap).
   679                                  ;; (blkcpy is not used: it copies to BLK, not to TMP)
   680                                  CLC
   681                                  LDA ACCU + 1
   682                                  ADC @NBY + 1
   683                                  STA ACCU + 1
   684                                  CLC
   685                                  LDA TMP + 1
   686                                  ADC @NBY + 1
   687                                  STA TMP + 1
   688                                  LDY @NBY
   689                                  BEQ @uppg
   690                          -       DEY
   691                                  LDA (ACCU),Y
   692                                  STA (TMP),Y
   693                                  CPY # 0
   694                                  BNE -
   695                          @uppg   LDX @NBY + 1                    ;Y = 0 here
   696                                  BEQ @done0
   697                          --      DEC ACCU + 1
   698                                  DEC TMP + 1
   699                          -       DEY                             ;Y: 0 -> 255 -> ... -> 0
   700                                  LDA (ACCU),Y
   701                                  STA (TMP),Y
   702                                  CPY # 0
   703                                  BNE -
   704                                  DEX
   705                                  BNE --
   706                          @done0  LDY # 0
   707                          @done   STY ACCU + 1                    ;Y = 0
   708                                  LDA # <Val_unit
   709                                  STA ACCU
   710                                  RTS                             ;Exit.
   711                                  ;; source >= dest: copy from the start
   712                          @cpydn  LDY # 0
   713                                  LDX @NBY + 1
   714                                  BEQ @dnlo
   715                          -       LDA (ACCU),Y                    ;a whole page
   716                                  STA (TMP),Y
   717                                  INY
   718                                  BNE -
   719                                  INC ACCU + 1
   720                                  INC TMP + 1
   721                                  DEX
   722                                  BNE -
   723                          @dnlo   LDX @NBY
   724                                  BEQ @done0
   725                          -       LDA (ACCU),Y                    ;the remaining bytes
   726                                  STA (TMP),Y
   727                                  INY
   728                                  DEX
   729                                  BNE -
   730                                  BEQ @done0
   731                          }
   732                          
   733                          !ifdef caml_PRIM__caml_array_sub {
   734                          caml_array_sub
   735                                  ;; allocate and return a subarray
   736                                  ;; ACCU = a
   737                                  ;; SP[0] = ofs
   738                                  ;; SP[1] = n
   739                                  ;; GC-safe: while caml_alloc may run a GC, ACCU is kept equal to the
   740                                  ;; array's start (a root) and the source address is computed after it.
   741                          @NB     = TMP                           ;no. of bytes to be copied
   742                          @TG     = TMP + 2                       ;tag of the new array
   743                                  ;; load tag
   744                                  LDY # -2
   745                                  DEC ACCU + 1
   746                                  LDA (ACCU),Y
   747                                  INC ACCU + 1
   748                                  STA @TG
   749                                  CMP # Double_array_tag
   750                                  BNE @ordinary
   751                                  ;; array of floats: @NB = 6 * n
   752                                  LDY # 2
   753                                  LDA (SP),Y                      ;ignore hi byte
   754                                  JSR caml_IntValx3
   755                                  ASL
   756                                  STA @NB
   757                                  LDA # 0
   758                                  ROL
   759                                  STA @NB + 1
   760                                  JMP @alloc
   761                          @ordinary
   762                                  LDA # 0
   763                                  STA @TG
   764                                  LDY # 2
   765                                  LDA (SP),Y
   766                                  STA @NB
   767                                  INY
   768                                  LDA (SP),Y
   769                                  STA @NB + 1
   770                                  LDA @NB
   771                                  BNE +
   772                                  DEC @NB + 1
   773                          +       DEC @NB                         ;@NB = 2 * n
   774                                  ;; allocate subarray (an empty one is the atom 0)
   775                          @alloc  LDA @NB + 1
   776                                  LSR
   777                                  LDA @NB
   778                                  ROR
   779                                  TAX
   780                                  BNE +
   781                                  LDY # 0
   782                                  JMP caml_mkatom0
   783                          +       LDA @TG
   784                                  JSR caml_alloc                  ;ACCU = a is still a valid root
   785                                  ;; compute source address (ACCU may have been moved by the GC)
   786                                  LDY # 0
   787                                  LDA @TG
   788                                  CMP # Double_array_tag
   789                                  BEQ @floats
   790                                  CLC
   791                                  LDA ACCU
   792                                  ADC (SP),Y
   793                                  STA ACCU
   794                                  INY
   795                                  LDA ACCU + 1
   796                                  ADC (SP),Y
   797                                  STA ACCU + 1
   798                                  LDA ACCU
   799                                  BNE +
   800                                  DEC ACCU + 1
   801                          +       DEC ACCU                        ;ACCU := a + 2 * ofs
   802                                  JMP @copy
   803                          @floats LDA (SP),Y                      ;ofs, ignore hi byte
   804                                  JSR caml_IntValx3
   805                                  LDX # ACCU
   806                                  JSR caml_ptr_add2A              ;ACCU := &a[ofs] (6 * ofs bytes)
   807                                  ;; copy bytes from source to destination
   808                          @copy   LSR @NB + 1
   809                                  LDY @NB
   810                                  JSR caml_blkcpy
   811                                  ;; ACCU <- subarray
   812                                  JMP caml_load_newblk
   813                          }
   814                          
   815                          !ifdef caml_PRIM__caml_array_append {
   816                          caml_array_append
   817                                  ;; append two arrays
   818                                  ;; ACCU = arr1
   819                                  ;; SP[0] = arr2
   820                                  ;; GC-safe: ACCU and SP[0] are roots; arr2 is reloaded from the stack
   821                                  ;; after caml_alloc, and no cached/internal pointer lives across it.
   822                          @AUX    = TMP
   823                          @SIZE1  = TMP + 2
   824                          @SIZE2  = TMP + 4
   825                                  ;; load sizes and tag
   826                                  LDA (SP),Y                      ;{Y = 0}
   827                                  STA @AUX
   828                                  INY
   829                                  LDA (SP),Y
   830                                  STA @AUX + 1
   831                                  LDY # -1
   832                                  DEC ACCU + 1
   833                                  DEC @AUX + 1
   834                                  LDA (ACCU),Y
   835                                  STA @SIZE1
   836                                  LDA (@AUX),Y
   837                                  STA @SIZE2
   838                                  DEY
   839                                  LDA (ACCU),Y                    ;tag
   840                                  INC ACCU + 1                    ;ACCU = arr1 again (valid pointer)
   841                                  PHA
   842                                  LDA @SIZE2
   843                                  CLC
   844                                  ADC @SIZE1
   845                                  BCC +
   846                                  ;; exception if total size > 255
   847                                  PLA
   848                                  LDY # 0
   849                                  JMP @error
   850                          +       TAX                             ;size
   851                                  BNE +
   852                                  PLA
   853                                  LDY # 0
   854                                  JMP caml_mkatom0                ;both arrays empty
   855                          +       PLA                             ;tag
   856                                  JSR caml_alloc                  ;ACCU and SP[0] updated if GC
   857                                  LDA BLK
   858                                  STA @AUX                        ;save ptr to result
   859                                  LDA BLK + 1
   860                                  STA @AUX + 1
   861                                  ;; copy arr1 to dest
   862                                  LDA @SIZE1
   863                                  BEQ +
   864                                  ASL
   865                                  TAY
   866                                  JSR caml_blkcpy                 ;{BLK unchanged, Y = 0}
   867                                  ;; BLK <- &BLK[SIZE1]
   868                          +       LDA @SIZE1
   869                                  LDX # BLK
   870                                  JSR caml_ptr_add2A
   871                                  ;; ACCU <- arr2 (reloaded from the stack)
   872                                  LDY # 0
   873                                  LDA (SP),Y
   874                                  STA ACCU
   875                                  INY
   876                                  LDA (SP),Y
   877                                  STA ACCU + 1
   878                                  ;; copy arr2 to dest
   879                                  LDA @SIZE2
   880                                  BEQ +
   881                                  ASL
   882                                  TAY
   883                                  JSR caml_blkcpy
   884                                  ;; ACCU <- result
   885                          +       LDY # 0
   886                                  LDA @AUX
   887                                  STA ACCU
   888                                  LDA @AUX + 1
   889                                  STA ACCU + 1
   890                                  RTS
   891                          @error  +caml_raise Invalid_argument, "Array.append"
   892                          }
   893                          
   894                          !ifdef caml_PRIM__caml_array_concat {
   895                          caml_array_concat
   896                                  ;; concatenate all arrays in a list
   897                                  ;; ACCU = list
   898                          @TAG    = TMP
   899                          @SIZE   = TMP + 1
   900                          @HEAD   = TMP + 2
   901                          @TAIL   = TMP + 4
   902                          @RESULT = TMP + 2
   903                                  DEY
   904                                  STY @TAG                        ;@TAG = -1
   905                                  INY
   906                                  STY @SIZE
   907                                  ;; return caml_atom0 if list = []
   908                                  LDA ACCU
   909                                  BIT caml_is_block
   910                                  BEQ +
   911                                  JMP caml_mkatom0
   912                                  ;; scan list and sum all arrays sizes
   913                          +       LDA (ACCU),Y
   914                                  STA @HEAD
   915                                  INY
   916                                  LDA (ACCU),Y
   917                                  STA @HEAD + 1
   918                                  INY
   919                                  LDA (ACCU),Y
   920                                  STA @TAIL
   921                                  INY
   922                                  LDA (ACCU),Y
   923                                  STA @TAIL + 1
   924                                  ;; get current array size and add it to @SIZE
   925                          -       LDY # -1
   926                                  DEC @HEAD + 1
   927                                  LDA (@HEAD),Y
   928                                  BEQ +
   929                                  CLC
   930                                  ADC @SIZE
   931                                  BCC ++
   932                                  +caml_raise Invalid_argument, "Array.concat"
   933                          ++      STA @SIZE
   934                                  ;; only once: set @TAG from first non-empty array
   935                                  CPY @TAG                        ;test if @TAG = -1
   936                                  BNE +
   937                                  DEY
   938                                  LDA (@HEAD),Y
   939                                  STA @TAG
   940                                  INY
   941                                  ;; set @HEAD to next list element, @TAIL to rest
   942                          +       INY
   943                                  LDA @TAIL
   944                                  BIT caml_is_block               ;end of list?
   945                                  BNE @alloc                      ;Z=0: not a block, i.e. []: exit loop
   946                                  LDA (@TAIL),Y                   ;no:   continue
   947                                  STA @HEAD
   948                                  INY
   949                                  LDA (@TAIL),Y
   950                                  STA @HEAD + 1
   951                                  INY
   952                                  LDA (@TAIL),Y
   953                                  TAX
   954                                  INY
   955                                  LDA (@TAIL),Y
   956                                  STX @TAIL
   957                                  STA @TAIL + 1
   958                                  JMP -
   959                                  ;; allocate destination array
   960                          @alloc  LDX @SIZE
   961                                  BNE +
   962                                  JMP caml_mkatom0
   963                          +       LDA @TAG
   964                                  JSR caml_alloc                  ;OK: ACCU (list) is a root, @TAIL reloaded below
   965                                  LDA BLK
   966                                  STA @RESULT
   967                                  LDA BLK + 1
   968                                  STA @RESULT + 1                 ;save dest address
   969                                  ;; scan list again and append all arrays
   970                                  LDY # 3
   971                                  LDA (ACCU),Y
   972                                  STA @TAIL + 1
   973                                  DEY
   974                                  LDA (ACCU),Y
   975                                  STA @TAIL
   976                                  DEY
   977                                  LDA (ACCU),Y
   978                                  TAX
   979                                  DEY
   980                                  LDA (ACCU),Y
   981                                  STX ACCU + 1
   982                                  STA ACCU
   983                                  ;; get current array size
   984                          -       LDY # -1
   985                                  DEC ACCU + 1
   986                                  LDA (ACCU),Y
   987                                  BEQ +                           ;skip if zero
   988                                  INC ACCU + 1
   989                                  TAX
   990                                  ASL
   991                                  TAY
   992                                  ;; copy array elements to destination
   993                                  JSR caml_blkcpy
   994                                  TXA
   995                                  ;; set BLK pointer to first element to be copied next
   996                                  LDX # BLK
   997                                  JSR caml_ptr_add2A
   998                                  ;; set ACCU to next list element, @TAIL to rest
   999                          +       LDY # 0
  1000                                  LDA @TAIL
  1001                                  BIT caml_is_block               ;end of list?
  1002                                  BNE @eol                        ;Z=0: not a block, i.e. []: exit
  1003                                  LDA (@TAIL),Y                   ;no:   continue
  1004                                  STA ACCU
  1005                                  INY
  1006                                  LDA (@TAIL),Y
  1007                                  STA ACCU + 1
  1008                                  INY
  1009                                  LDA (@TAIL),Y
  1010                                  TAX
  1011                                  INY
  1012                                  LDA (@TAIL),Y
  1013                                  STX @TAIL
  1014                                  STA @TAIL + 1
  1015                                  JMP -
  1016                                  ;; set ACCU = destination array and return
  1017                          @eol    LDA @RESULT
  1018                                  STA ACCU
  1019                                  LDA @RESULT + 1
  1020                                  STA ACCU + 1
  1021                                  RTS
  1022                          }
  1023                          
  1024                          }      ;; !zone caml_ARRAYS
  1025                          

