    15                          ;;; -----------------------------------------------------------
    16                          ;;; COMPARISONS
    17                          ;;; -----------------------------------------------------------
    18                          
    19                          !zone caml_COMPARISONS {
    20                          
    21                          !ifndef caml_compare_warn {
    22                          caml_compare_warn
    23                            !warn "TODO: caml_compare_val_custom_tag"
    24                            !warn "TODO: caml_compare_val_double_array_tag"
    25                            !warn "TODO: caml_compare_val_object_tag"
    26                          }
    27                          
    28                          .dummy = $1234                                  ;dummy address for SMC
    29                                  
    30                          !macro  beq .adr { BNE + : JMP .adr :+ }        ;Long branch if equal
    31                          !macro  bne .adr { BEQ + : JMP .adr :+ }        ;Long branch if not equal
    32                          
    33                          .V1     = ACCU                                  ;word, 1st argument
    34                          .V2     = TMP                                   ;word, 2nd argument
    35                          .SAVESP = TMP + 2                               ;word, SP backup
    36                          .CMP    = TMP + 4                               ;byte, result/temp
    37                          .COMPARE= TMP + 5                               ;byte, total ordering flag
    38                          .FLTMP  = TMP + 6                               ;5 bytes, float temp area
    39                                  ;; TMP + 11 ...                         ;free
    40                          
    41                                  ;;
    42                                  ;; int
    43                                  ;;
    44                          
    45                          !ifdef caml_PRIM__caml_int_compare {
    46                          caml_int_compare
    47                                  LDA ACCU + 1                            ;Compare hi bytes by subtraction
    48                                  INY
    49                                  SEC
    50                                  SBC (SP),Y
    51                                  BEQ ++                                  ;if A = arg0h-arg1h <> 0 then
    52                                  BVC +                                   ;  A_7 <- N xor V
    53                                  EOR #$80                                ;  (A_7=1 <==> arg0 < arg1)
    54                          +       STA ACCU + 1                            ;  store it in ACCUh
    55                                  DEY
    56                                  RTS                                     ;  exit (ACCUl unchanged);      
    57                          ++      DEY                                     ;else
    58                                  LDA (SP),Y                              ;  compare lo bytes
    59                                  CMP ACCU                                ;  (C=1 <==> arg0 <= arg1)
    60                                  BEQ caml_return_zero                    ;  if equal, return Val_zero;
    61                                  ROR ACCU + 1                            ;  else rotate C -> ACCUh_7
    62                                  RTS                                     ;  and exit (ACCUl unchanged);
    63                          }
    64                          
    65                                  ;;
    66                                  ;; floats
    67                                  ;;
    68                          
    69                          !ifdef caml_PRIM__caml_eq_float {
    70                          caml_eq_float
    71                                  JSR caml_compare_identity_setV2
    72                                  BEQ caml_return_true
    73                                  JSR caml_compare_val_double_tag
    74                                  BEQ caml_return_true
    75                                  BNE caml_return_false
    76                          }
    77                          
    78                          !ifdef caml_PRIM__caml_neq_float {
    79                          caml_neq_float
    80                                  JSR caml_compare_identity_setV2
    81                                  BEQ caml_return_false
    82                                  JSR caml_compare_val_double_tag
    83                                  BEQ caml_return_false
    84                                  BNE caml_return_true
    85                          }
    86                          
    87                          !ifdef caml_PRIM__caml_le_float {
    88                          caml_le_float
    89                                  JSR caml_compare_identity_setV2
    90                                  BEQ caml_return_true
    91                                  JSR caml_compare_val_double_tag
    92                                  BMI caml_return_true
    93                                  BPL caml_return_false
    94                          }
    95                          
    96                          !ifdef caml_PRIM__caml_lt_float {
    97                          caml_lt_float
    98                                  JSR caml_compare_identity_setV2
    99                                  BEQ caml_return_false
   100                                  JSR caml_compare_val_double_tag
   101                                  BMI caml_return_true
   102                                  BPL caml_return_false
   103                          }
   104                          
   105                          !ifdef caml_PRIM__caml_ge_float {
   106                          caml_ge_float
   107                                  JSR caml_compare_identity_setV2
   108                                  BEQ caml_return_true
   109                                  JSR caml_compare_val_double_tag
   110                                  BMI caml_return_false
   111                                  BPL caml_return_true
   112                          }
   113                          
   114                          !ifdef caml_PRIM__caml_gt_float {
   115                          caml_gt_float
   116                                  JSR caml_compare_identity_setV2
   117                                  BEQ caml_return_false
   118                                  JSR caml_compare_val_double_tag
   119                                  BMI caml_return_false
   120                                  BPL caml_return_true
   121                          }
   122                          
   123                          !ifdef caml_PRIM__caml_float_compare {
   124                          caml_float_compare
   125                                  JSR caml_compare_identity_setV2
   126                                  BEQ caml_return_zero
   127                                  JSR caml_compare_val_double_tag
   128                                  JMP caml_compare_set_result
   129                          }
   130                          
   131                                  ;;
   132                                  ;; bytes/string
   133                                  ;;
   134                          
   135                          !ifdef caml_PRIM__caml_bytes_equal {
   136                          caml_bytes_equal = caml_string_equal
   137                          }
   138                          !ifdef caml_PRIM__caml_string_equal {
   139                          caml_string_equal
   140                                  JSR caml_compare_identity_setV2
   141                                  BEQ caml_return_true
   142                                  JSR caml_string_eq_neq
   143                                  BEQ caml_return_true
   144                                  BNE caml_return_false
   145                          }
   146                          
   147                          !ifdef caml_PRIM__caml_bytes_notequal {
   148                          caml_bytes_notequal = caml_string_notequal
   149                          }
   150                          !ifdef caml_PRIM__caml_string_notequal {
   151                          caml_string_notequal
   152                                  JSR caml_compare_identity_setV2
   153                                  BEQ caml_return_false
   154                                  JSR caml_string_eq_neq
   155                                  BEQ caml_return_false
   156                                  BNE caml_return_true
   157                          }
   158                          
   159                          ;;; --------------------------------------      ;Auxiliary routines for saving
   160                          !ifdef  caml_PRIM__caml_return_true {           ;the comparison result in ACCU.
   161                          caml_return_true                                ;Placed here due to the branch
   162                                  STY ACCU + 1                            ;offset limitations.
   163                                  LDA # <Val_true
   164                                  STA ACCU
   165                                  RTS
   166                          }
   167                          
   168                          !ifdef  caml_PRIM__caml_return_false {
   169                          caml_return_false
   170                                  STY ACCU + 1
   171                                  LDA # <Val_false
   172                                  STA ACCU
   173                                  RTS
   174                          }
   175                          
   176                          !ifdef  caml_PRIM__caml_return_zero {
   177                          caml_return_zero=caml_return_false
   178                          }
   179                          ;;; --------------------------------------
   180                          
   181                          !ifdef caml_PRIM__caml_bytes_lessthan {
   182                          caml_bytes_lessthan = caml_string_lessthan
   183                          }
   184                          !ifdef caml_PRIM__caml_string_lessthan {
   185                          caml_string_lessthan
   186                                  JSR caml_compare_identity_setV2
   187                                  BEQ caml_return_false
   188                                  JSR caml_compare_val_string_tag
   189                                  BMI caml_return_true
   190                                  BPL caml_return_false
   191                          }
   192                          
   193                          !ifdef caml_PRIM__caml_bytes_greaterequal {
   194                          caml_bytes_greaterequal = caml_string_greaterequal
   195                          }
   196                          !ifdef caml_PRIM__caml_string_greaterequal {
   197                          caml_string_greaterequal
   198                                  JSR caml_compare_identity_setV2
   199                                  BEQ caml_return_true
   200                                  JSR caml_compare_val_string_tag
   201                                  BMI caml_return_false
   202                                  BPL caml_return_true
   203                          }
   204                          
   205                          !ifdef caml_PRIM__caml_bytes_lessequal {
   206                          caml_bytes_lessequal = caml_string_lessequal
   207                          }
   208                          !ifdef caml_PRIM__caml_string_lessequal {
   209                          caml_string_lessequal
   210                                  JSR caml_compare_identity_setV2
   211                                  BEQ caml_return_true
   212                                  JSR caml_compare_val_string_tag
   213                                  BMI caml_return_true
   214                                  BPL caml_return_false
   215                          }
   216                          
   217                          !ifdef caml_PRIM__caml_bytes_greaterthan {
   218                          caml_bytes_greaterthan = caml_string_greaterthan
   219                          }
   220                          !ifdef caml_PRIM__caml_string_greaterthan {
   221                          caml_string_greaterthan
   222                                  JSR caml_compare_identity_setV2
   223                                  BEQ caml_return_false
   224                                  JSR caml_compare_val_string_tag
   225                                  BMI caml_return_false
   226                                  BPL caml_return_true
   227                          }
   228                          
   229                          !ifdef caml_PRIM__caml_bytes_compare {
   230                          caml_bytes_compare = caml_string_compare
   231                          }
   232                          !ifdef caml_PRIM__caml_string_compare {
   233                          caml_string_compare
   234                                  JSR caml_compare_identity_setV2
   235                                  BEQ caml_return_zero
   236                                  JSR caml_compare_val_string_tag
   237                                  JMP caml_compare_set_result
   238                          }
   239                          
   240                                  ;;
   241                                  ;; polymorphic comparisons
   242                                  ;;
   243                          
   244                          !ifdef caml_PRIM__caml_equal {
   245                          caml_equal
   246                                  JSR caml_compare_val
   247                                  BNE caml_return_false
   248                                  BEQ caml_return_true
   249                          }
   250                          
   251                          !ifdef caml_PRIM__caml_notequal {
   252                          caml_notequal
   253                                  JSR caml_compare_val
   254                                  BNE caml_return_true
   255                                  BEQ caml_return_false
   256                          }
   257                          
   258                          !ifdef caml_PRIM__caml_lessthan {
   259                          caml_lessthan
   260                                  JSR caml_compare_val
   261                                  BPL caml_return_false
   262                                  BMI caml_return_true
   263                          }
   264                          
   265                          !ifdef caml_PRIM__caml_greaterequal {
   266                          caml_greaterequal
   267                                  JSR caml_compare_val
   268                                  BPL caml_return_true
   269                                  BMI caml_return_false
   270                          }
   271                          
   272                          !ifdef caml_PRIM__caml_lessequal {
   273                          caml_lessequal
   274                                  JSR caml_compare_val
   275                                  BMI caml_return_true
   276                                  BNE caml_return_false
   277                                  BEQ caml_return_true
   278                          }
   279                          
   280                          !ifdef caml_PRIM__caml_greaterthan {
   281                          caml_greaterthan
   282                                  JSR caml_compare_val
   283                                  BMI caml_return_false
   284                                  BNE caml_return_true
   285                                  BEQ caml_return_false
   286                          }
   287                          
   288                          !ifdef caml_PRIM__caml_compare {
   289                          caml_compare
   290                                  INY                                     ;set .COMPARE=1
   291                                  JSR caml_compare_val
   292                                  ;; FALLTHROUGH caml_compare_set_result
   293                          }
   294                          
   295                          !ifdef caml_PRIM__caml_compare_set_result {
   296                          caml_compare_set_result
   297                                  BPL +
   298                                  LDA # -1
   299                                  STA ACCU
   300                                  STA ACCU + 1
   301                                  RTS
   302                          +       SEC
   303                                  ROL
   304                                  STA ACCU
   305                                  STY ACCU + 1
   306                                  RTS
   307                          }
   308                          
   309                          !ifdef caml_PRIM__caml_compare_identity_setV2 {
   310                          caml_compare_identity_setV2
   311                                  ;; check if ACCU == SP[0] (physical identity)
   312                                  ;; yes: return Z = 1
   313                                  ;; no:  return Z = 0, .V2 = SP[0]
   314                                  LDA (SP),Y
   315                                  TAX
   316                                  INY
   317                                  LDA (SP),Y
   318                                  DEY
   319                                  CPX .V1
   320                                  BNE +
   321                                  CMP .V1 + 1
   322                                  BNE +
   323                                  RTS
   324                          +       STX .V2
   325                                  STA .V2 + 1
   326                                  RTS
   327                          }
   328                          
   329                          !ifdef caml_PRIM__caml_compare_val {
   330                          caml_compare_val
   331                                  ;; Compare values in ACCU and SP[0].
   332                                  ;; PREREQUISITE: Y <> 0 if called by caml_compare, Y = 0 otherwise.
   333                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   334                                  ;; Status byte is set according to A.
   335                                  STY .COMPARE                            ;Y <> 0 iif called by caml_compare
   336                                  LDY # 0
   337                                  LDA SP
   338                                  STA .SAVESP
   339                                  LDA SP + 1
   340                                  STA .SAVESP + 1
   341                                  LDA (SP),Y
   342                                  STA .V2
   343                                  INY
   344                                  LDA (SP),Y
   345                                  STA .V2 + 1
   346                          .loop   LDY # 0
   347                                  STY .CMP
   348                                  LDA .V1 + 1
   349                                  LDX .V1
   350                                  CPX .V2
   351                                  BEQ .eq_tst
   352                                  SBC .V2 + 1
   353                          .neq    BVC +                                   ;(signed) v1<v2 iif V xor N = 1
   354                                  ORA # $80
   355                          +       BMI +
   356                                  INC .CMP                                ;v1 > v2 => CMP := 1
   357                                  BNE .int_or_block                       ;bne=jmp
   358                          +       DEC .CMP                                ;v1 < v2 => CMP := -1
   359                                  BNE .int_or_block                       ;bne=jmp
   360                          .eq_tst SBC .V2 + 1
   361                                  BNE .neq
   362                                  CMP .COMPARE                            ;v1==v2; called by caml_compare?
   363                                  BEQ .int_or_block                       ;no: go deep, maybe raise exn :(
   364                                  JMP .next_item                          ;yes: speed up, go to next_item
   365                          .int_or_block
   366                                  TXA
   367                                  BIT caml_is_block
   368                                  BEQ .v1_block
   369                                  LDA .V2
   370                                  BIT caml_is_block
   371                                  BEQ .v1_int_v2_block
   372                                  LDA .CMP
   373                                  JMP .return_or_next
   374                          .v1_int_v2_block
   375                                  LDY # -2
   376                                  DEC .V2 + 1
   377                                  LDA (.V2),Y                             ;A := Tag(v2)
   378                                  INC .V2 + 1
   379                                  CMP # Forward_tag                       ;check for special cases
   380                                  BEQ .v2_forward
   381                                  CMP # Custom_tag
   382                                  BEQ .v2_custom
   383                                  LDA # -1
   384                                  JMP .return                             ;int < block => RETURN LESS
   385                          .v2_forward
   386                                  LDY # 1
   387                                  LDA (.V2),Y                             ;v2 := Field(v2,0)
   388                                  TAX
   389                                  DEY
   390                                  LDA (.V2),Y
   391                                  STX .V2 + 1
   392                                  STA .V2
   393                                  JMP .loop                               ;continue
   394                          .v2_custom
   395                                  LDY # 1
   396                                  LDA (.V2),Y                             ;load jmptbl address
   397                                  STA .v2jsr + 2
   398                                  DEY
   399                                  LDA (.V2),Y
   400                                  STA .v2jsr + 1
   401                          .v2jsr  JSR .dummy                              ;call custom_compare, res. in A
   402                                  JMP .return_or_next
   403                          .v1_block
   404                                  LDA .V2
   405                                  BIT caml_is_block
   406                                  BEQ .v1_block_v2_block
   407                                  LDY # -2                                ;v1:block, v2:int
   408                                  DEC .V1 + 1
   409                                  LDA (.V1),Y                             ;A := Tag(v1)
   410                                  INC .V1 + 1
   411                                  CMP # Forward_tag                       ;check for special cases
   412                                  BEQ .v1_forward
   413                                  CMP # Custom_tag
   414                                  BEQ .v1_cust_tst
   415                                  LDA # 1
   416                                  JMP .return                             ;block > int => RETURN GREATER
   417                          .v1_forward
   418                                  LDY # 1
   419                                  LDA (.V1),Y                             ;v1 := Field(v1,0)
   420                                  TAX
   421                                  DEY
   422                                  LDA (.V1),Y
   423                                  STX .V1 + 1
   424                                  STA .V1
   425                                  JMP .loop                               ;continue
   426                          .v1_cust_tst
   427                                  LDY # 1
   428                                  LDA (.V1),Y                             ;load jmptbl address
   429                                  STA .v1jsr + 2
   430                                  DEY
   431                                  LDA (.V1),Y
   432                                  STA .v1jsr + 1
   433                          .v1jsr  JSR .dummy                              ;call custom_compare, res. in A
   434                                  JMP .return_or_next
   435                          .v1_block_v2_block
   436                                  LDY # -2
   437                                  DEC .V1 + 1
   438                                  DEC .V2 + 1
   439                                  LDA (.V2),Y
   440                                  TAX                                     ;X := Tag_v2
   441                                  LDA (.V1),Y                             ;A := Tag_v1
   442                                  INC .V1 + 1
   443                                  INC .V2 + 1
   444                                  CMP # Forward_tag
   445                                  BEQ .v1_forward                         ;jump if Tag_v1=Forward_tag
   446                                  CPX # Forward_tag
   447                                  +beq .v2_forward                        ;jump if Tag_v2=Forward_tag
   448                                  STX .CMP
   449                                  SEC
   450                                  SBC .CMP
   451                                  BEQ .switch_on_tag                      ;Tag_v1=Tag_v2 =>choose routine
   452                                  JMP .return                             ;Tag_v1!=Tag_v2=>RETURN
   453                          .switch_on_tag
   454                                  CPX # String_tag                        ;dichotomic switch
   455                                  BCC .t249
   456                                  BNE .t254
   457                                  JSR caml_compare_val_string_tag
   458                                  JMP .return_or_next
   459                          .t249   CPX # Infix_tag
   460                                  BCC .t247
   461                                  BNE +
   462                          -       +caml_raise Invalid_argument, "compare: functional value"
   463                          +       +caml_raise Invalid_argument, "compare: abstract value"
   464                          .t247   CPX # Closure_tag
   465                                  BCC .default
   466                                  BEQ -
   467                                  JSR caml_compare_val_object_tag
   468                                  JMP .return_or_next
   469                          .t254   CPX # Double_array_tag
   470                                  BCC .t253
   471                                  BNE .t255
   472                                  JSR caml_compare_val_double_array_tag
   473                                  JMP .return_or_next
   474                          .t253   JSR caml_compare_val_double_tag
   475                                  JMP .return_or_next
   476                          .t255   JSR caml_compare_val_custom_tag
   477                                  JMP .return_or_next
   478                          .default
   479                                  ;; compare sizes first
   480                                  LDY # -1
   481                                  DEC .V1 + 1
   482                                  DEC .V2 + 1
   483                                  LDA (.V1),Y                             ;A := size(v1)
   484                                  TAX                                     ;save it
   485                                  SEC
   486                                  SBC (.V2),Y                             ;A := size(v1) - size(v2)
   487                                  BNE .return                             ;A <> 0 ==> return(A)
   488                                  TXA                                     ;reload size(v1)
   489                                  BEQ .next_item                          ;v1, v2 atoms ==> next_item
   490                                  INC .V1 + 1
   491                                  INC .V2 + 1
   492                                  DEX                                     ;only one field?
   493                                  BEQ .field0                             ;yes:compare Fld(v1,0) Fld(v2,0)
   494                                  +caml_grow_stack 3                      ;no: save data on stack:
   495                                  LDY # 0
   496                                  CLC
   497                                  LDA .V1
   498                                  ADC # 2
   499                                  STA (SP),Y
   500                                  INY
   501                                  LDA .V1 + 1
   502                                  ADC # 0
   503                                  STA (SP),Y                              ;address of Field(v1,1) in SP[0]
   504                                  INY
   505                                  CLC
   506                                  LDA .V2
   507                                  ADC # 2
   508                                  STA (SP),Y
   509                                  INY
   510                                  LDA .V2 + 1
   511                                  ADC # 0
   512                                  STA (SP),Y                              ;address of Field(v2,1) in SP[1]
   513                                  INY
   514                                  DEX                                     ;# of following fields in SP[2]
   515                                  TXA
   516                                  STA (SP),Y
   517                          .field0 LDY # 0
   518                                  LDA (.V1),Y                             ;get <Field(v1,0)
   519                                  TAX                                     ;save it
   520                                  LDA (.V2),Y                             ;get <Field(v2,0)
   521                                  STA .CMP                                ;save it
   522                                  INY
   523                                  LDA (.V1),Y                             ;get >Field(v1,0)
   524                                  STA .V1 + 1                             ;.V1 + 1 :=  >Field(v1,0)
   525                                  LDA (.V2),Y                             ;get >Field(v2,0)
   526                                  STA .V2 + 1                             ;.V2 + 1  := >Field(v2,0)
   527                                  STX .V1                                 ;.V1 := Field(v1,0)
   528                                  LDA .CMP
   529                                  STA .V2                                 ;.V2 := Field(v2,0)
   530                                  JMP .loop                               ;continue comparison on v1, v2
   531                          .return_or_next
   532                                  ORA # 0                                 ;set status byte according to A
   533                                  BEQ .next_item                          ;if A=0 then compare nexts
   534                          .return LDX .SAVESP                             ;else
   535                                  STX SP                                  ; restore SP
   536                                  LDX .SAVESP + 1
   537                                  STX SP + 1
   538                                  LDY # 0
   539                                  ORA # 0                                 ; set status byte according to A
   540                                  RTS                                     ; exit
   541                          .next_item
   542                                  LDA SP                                  ;if SP = .SAVESP
   543                                  CMP .SAVESP
   544                                  BNE +
   545                                  LDA SP + 1
   546                                  CMP .SAVESP + 1
   547                                  BNE +
   548                                  LDA # 0                                 ;then RETURN EQUAL
   549                                  BEQ .return                             ;BEQ=JMP
   550                          +       LDY # 0                                 ;else get next item from stack:
   551                                  LDA (SP),Y                              ;V1 := SP[0] (lo byte)
   552                                  STA .V1
   553                                  CLC
   554                                  ADC # 2
   555                                  STA (SP),Y                              ;SP[0] := &next field (lo byte)
   556                                  INY
   557                                  LDA (SP),Y                              ;as above, hi byte
   558                                  STA .V1 + 1
   559                                  ADC # 0
   560                                  STA (SP),Y
   561                                  INY
   562                                  LDA (SP),Y                              ;V2 := SP[1] (lo byte)
   563                                  STA .V2
   564                                  CLC
   565                                  ADC # 2
   566                                  STA (SP),Y                              ;SP[1] := &next field (lo byte)
   567                                  INY
   568                                  LDA (SP),Y                              ;as above, hi byte
   569                                  STA .V2 + 1
   570                                  ADC # 0
   571                                  STA (SP),Y
   572                                  INY
   573                                  LDA (SP),Y                              ;get counter of remaining fields
   574                                  BEQ +                                   ;if counter = 0, continue loop
   575                                  SEC
   576                                  SBC # 1                                 ;else decrement the counter
   577                                  STA (SP),Y
   578                                  CLC
   579                                  LDA # 6
   580                                  ADC SP
   581                                  STA SP
   582                                  BCC +
   583                                  INC SP + 1                              ;and pop items from stack
   584                          +       LDY # 1                                 ;get curr. Fld(v1,x), Fld(v2,x)
   585                                  LDA (.V1),Y
   586                                  TAX
   587                                  LDA (.V2),Y
   588                                  STA .CMP
   589                                  DEY
   590                                  LDA (.V1),Y
   591                                  STA .V1
   592                                  STX .V1 + 1
   593                                  LDA (.V2),Y
   594                                  STA .V2
   595                                  LDA .CMP
   596                                  STA .V2 + 1
   597                                  JMP .loop                               ;continue loop
   598                          }
   599                          
   600                          !ifdef caml_PRIM__caml_compare_val_double_tag {
   601                          caml_compare_val_double_tag
   602                                  ;; Compare floats in ACCU and SP[0].
   603                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   604                                  ;; Status byte is set according to A.
   605                                  LDA .V1
   606                                  STA caml_float_loadFAC__addr
   607                                  LDA .V1 + 1
   608                                  STA caml_float_loadFAC__addr + 1
   609                                  JSR caml_float_loadFAC
   610                                  LDY .V2 + 1
   611                                  LDA .V2
   612                                  +caml_JSR_BASROM C64_FCOMP
   613                                  LDY # 0
   614                                  ORA # 0                                 ;set status byte according to A
   615                                  RTS
   616                          }
   617                          
   618                          !ifdef caml_PRIM__caml_compare_val_string_tag {
   619                          caml_compare_val_string_tag
   620                                  ;; Compare strings in ACCU and SP[0].
   621                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   622                                  ;; Status byte is set according to A.
   623                                  LDY # -1
   624                                  DEC .V1 + 1
   625                                  DEC .V2 + 1
   626                                  LDA (.V1),Y
   627                                  TAX
   628                                  SEC
   629                                  SBC (.V2),Y
   630                                  STA .CMP                                ;CMP = size(v1) - size(v2)
   631                                  BCC +
   632                                  LDA (.V2),Y
   633                                  TAX                                     ;X := min(size(v1), size(v2))
   634                          +       INY                                     ;Y := 0
   635                          --      INC .V1 + 1                             ;for Y := 0 to X - 1 {
   636                                  INC .V2 + 1                             ;  compare char by char:
   637                          -       DEX
   638                                  BEQ ++
   639                                  LDA (.V1),Y                             ;  1st byte
   640                                  CMP (.V2),Y
   641                                  BCC @lt
   642                                  BNE @gt
   643                                  INY
   644                                  LDA (.V1),Y                             ;  2nd byte
   645                                  CMP (.V2),Y
   646                                  BCC @lt
   647                                  BNE @gt
   648                                  INY
   649                                  BNE -
   650                                  BEQ --                                  ;}
   651                          ++      LDA (.V1),Y                             ;last word, 1st char
   652                                  CMP (.V2),Y
   653                                  BCC @lt
   654                                  BNE @gt
   655                                                                          ;(sub)strings are =, return CMP
   656                                  LDA .CMP                                ;CMP is size(v1)-size(v2),
   657                                  BNE +                                   ;if CMP = 0, adjust result
   658                                  INY                                     ;according to string paddings:
   659                                  CLC                                     ;len_v1-len_v2=-pad_v1+pad_v2
   660                                  ADC (.V2),Y
   661                                  SEC
   662                                  SBC (.V1),Y
   663                          +       LDY # 0
   664                                  ORA # 0                                 ;set status byte according to A
   665                                  RTS
   666                          @lt     LDY # 0
   667                                  LDA # -1
   668                                  RTS
   669                          @gt     LDY # 0
   670                                  LDA # 1
   671                                  RTS
   672                          }
   673                          
   674                          !ifdef caml_PRIM__caml_compare_val_custom_tag {
   675                          caml_compare_val_custom_tag
   676                                  ;; Compare custom values in ACCU and SP[0].
   677                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   678                                  ;; Status byte is set according to A.
   679                                  +caml_raise Not_found
   680                          }
   681                          
   682                          !ifdef caml_PRIM__caml_compare_val_double_array_tag {
   683                          caml_compare_val_double_array_tag
   684                                  ;; Compare floatarrays in ACCU and SP[0].
   685                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   686                                  ;; Status byte is set according to A.
   687                                  +caml_raise Not_found
   688                          }
   689                          
   690                          !ifdef caml_PRIM__caml_compare_val_object_tag {
   691                          caml_compare_val_object_tag
   692                                  ;; Compare objects in ACCU and SP[0].
   693                                  ;; Result: A </=/> 0 according to the OCaml semantics of compare.
   694                                  ;; Status byte is set according to A.
   695                                  +caml_raise Not_found
   696                          }
   697                          
   698                          !ifdef caml_PRIM__caml_string_eq_neq {           ;caml_compare_val_string_tag is
   699                          caml_string_eq_neq                              ; slower for equality tests
   700                                  LDY # -1
   701                                  DEC .V1 + 1
   702                                  DEC .V2 + 1
   703                                  LDA (.V1),Y
   704                                  CMP (.V2),Y
   705                                  BNE @neq
   706                                  TAX
   707                                  INY                                     ;Y := 0
   708                          --      INC .V1 + 1                             ;loop:
   709                                  INC .V2 + 1                             ; compare strings chr by chr
   710                          -       DEX
   711                                  BEQ +
   712                                  LDA (.V1),Y                             ;1st byte
   713                                  CMP (.V2),Y
   714                                  BNE @neq
   715                                  INY
   716                                  LDA (.V1),Y                             ;2nd byte
   717                                  CMP (.V2),Y
   718                                  BNE @neq
   719                                  INY
   720                                  BEQ --
   721                                  BNE -
   722                          +       LDA (.V1),Y                             ;last word, 1st char
   723                                  CMP (.V2),Y
   724                                  BNE @neq
   725                                  LDY # 0
   726                                  TYA
   727                                  RTS
   728                          @neq    LDY # 0
   729                                  LDA # -1
   730                                  RTS
   731                          }
   732                          
   733                          }       ;; !zone caml_COMPARISONS
   734                          

