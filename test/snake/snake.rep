   249                          !ifdef caml_PRIM__caml_nonstd_string_of_float {
   250                          caml_nonstd_string_of_float
   251                                  ;; Stdlib.string_of_float
   252                                  LDA ACCU
   253                                  LDX ACCU + 1
   254                                  STA caml_float_loadFAC__addr
   255                                  STX caml_float_loadFAC__addr + 1
   256                                  JSR caml_float_loadFAC
   257                                  LDA $47                                 ;WARNING: FOUT OVERWRITES $47
   258                                  PHA                                     ;save it
   259                                  +caml_JSR_BASROM C64_FOUT               ;0-terminated string in $0100
   260                                  PLA                                     ;restore $47 value
   261                                  STA $47
   262                                  LDX # $FF
   263                          -       INX                                     ;count string length (except 0)
   264                                  LDA $0100,X
   265                                  BNE -                                   ;(X = length when loop ends)
   266                                  LDA # 1                                 ;add a final 1 for padding; it
   267                                  STA $0101,X                             ;won't be copied if len is odd
   268                                  TXA                                     ;A := length
   269                                  LSR
   270                                  TAX                                     ;X := length / 2
   271                                  INX                                     ;X := length/2+1=blk size (wo.)
   272                                  LDA # String_tag
   273                                  LDY # 0
   274                                  JSR caml_alloc                          ;allocate the new block
   275                                  LDA BLK
   276                                  STA ACCU
   277                                  LDA BLK + 1
   278                                  STA ACCU + 1                            ;ACCU := new string
   279                                  TXA
   280                                  ASL
   281                                  TAY                                     ;Y := 2 * size
   282                                  DEY
   283                          -       LDA $0100,Y                             ;copy string and 0/01 padding
   284                                  STA (BLK),Y                             ;to the new block
   285                                  DEY
   286                                  BNE -
   287                                  LDA $0100
   288                                  STA (BLK),Y
   289                                  RTS
   290                          }
   291                          
   292                          !ifdef caml_PRIM__caml_nonstd_string_of_int {
   293                          caml_nonstd_string_of_int
   294                                  ;; Stdlib.string_of_int
   295                                  ;; Convert an int to string, using the C64 format: first char for sign
   296                                  ;; (space if positive, minus if negative), followed by 5 digit max and
   297                                  ;; no non-significative zeroes.
   298                          @DGT    = TMP
   299                          @SKIPZ  = TMP + 1
   300  2376 a9fc                       LDA # String_tag                        ;Max len is 4 words:
   301  2378 a204                       LDX # 4                                 ;|'-','1'|'6','3'|'8','3'|\0,\1|
   302  237a 20111f                     JSR caml_alloc                          ;Allocate string, addr in BLK
   303  237d a920                       LDA # ' '                               ;Positive numbers start with ' '
   304  237f 242d                       BIT ACCU + 1
   305  2381 100e                       BPL +
   306  2383 38                         SEC                                     ;If value is negative,
   307  2384 a902                       LDA # 2                                 ; negate it
   308  2386 e52c                       SBC ACCU
   309  2388 852c                       STA ACCU
   310  238a 98                         TYA
   311  238b e52d                       SBC ACCU + 1
   312  238d 852d                       STA ACCU + 1
   313  238f a92d                       LDA # '-'                               ; and put a '-' into the string
   314  2391 9157               +       STA (BLK),Y
   315  2393 c8                         INY
   316  2394 462d                       LSR ACCU + 1                            ;Get rid of trailing 1
   317  2396 662c                       ROR ACCU
   318  2398 a930                       LDA # '0'                               ;Set SKIPZ flag to '0' (=ignore
   319  239a 8546                       STA @SKIPZ                              ; all initial zeroes)
   320  239c a203                       LDX # 3                                 ;For X := 3 downto 0
   321  239e 8545               --      STA @DGT                                ; Init DGT to '0'
   322  23a0 a52c                       LDA ACCU                                ; Loop for calculating DGT:
   323  23a2 38                         SEC
   324  23a3 fdea23             -       SBC @lo10,X                             ;  Subtract 10^(X+1) from ACCU
   325  23a6 48                         PHA
   326  23a7 a52d                       LDA ACCU + 1
   327  23a9 fdee23                     SBC @hi10,X
   328  23ac 9009                       BCC +                                   ; Exit loop on negative result
   329  23ae 852d                       STA ACCU + 1                            ;  Store result in ACCU
   330  23b0 68                         PLA
   331  23b1 852c                       STA ACCU
   332  23b3 e645                       INC @DGT                                ;  Set DGT to next char digit
   333  23b5 b0ec                       BCS -                                   ; BCS=JMP, Continue loop
   334  23b7 68                 +       PLA
   335  23b8 a545                       LDA @DGT
   336  23ba c546                       CMP @SKIPZ                              ; If DGT='0' & SKIPZ='0'
   337  23bc f007                       BEQ +                                   ; then ignore current digit
   338  23be c646                       DEC @SKIPZ                              ; else stop skipping zeroes,
   339  23c0 9157                       STA (BLK),Y                             ;  put DGT into the string,
   340  23c2 c8                         INY
   341  23c3 a930                       LDA # '0'                               ;  set A='0' for next iteration.
   342  23c5 ca                 +       DEX                                     ; Decrement counter
   343  23c6 10d6                       BPL --                                  ;End_For
   344  23c8 052c                       ORA ACCU                                ;A := '0'|ACCU  (last digit)
   345  23ca 9157                       STA (BLK),Y
   346  23cc c8                         INY
   347  23cd a900                       LDA # 0                                 ;Pad string with \0
   348  23cf 9157                       STA (BLK),Y
   349  23d1 c8                         INY
   350  23d2 98                         TYA
   351  23d3 4a                         LSR                                     ;Compute block size (in wo.)
   352  23d4 aa                         TAX
   353  23d5 9005                       BCC +
   354  23d7 a901                       LDA # 1                                 ;Add \1 pad if necessary
   355  23d9 9157                       STA (BLK),Y
   356  23db e8                         INX                                     ;size +1 for \0\1
   357  23dc a557               +       LDA BLK
   358  23de 852c                       STA ACCU
   359  23e0 a558                       LDA BLK + 1
   360  23e2 852d                       STA ACCU + 1
   361  23e4 a000                       LDY # 0
   362  23e6 204521                     JSR caml_shrink_latest_alloc            ;Shrink block to computed size
   363  23e9 60                         RTS
   364  23ea 0a64e810           @lo10   !byte <10, <100, <1000, <10000
   365  23ee 00000327           @hi10   !byte >10, >100, >1000, >10000
   366                          }
