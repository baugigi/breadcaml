   583                          ;; Conversion from IEEE754 binary32 to C64FLP and vice-versa.
   584                          ;; See en.wikipedia.org/wiki/Single-precision_floating-point_format
   585                          ;; &   www.c64-wiki.com/wiki/Floating_point_arithmetic
   586                          ;;
   587                          ;; IEEE754:      |±¦e07_e01|e00¦m22_m16|m15_m08|m07_m00|
   588                          ;; little-endian |m07_m00|m15_m08|e00¦m22_m16|±¦e07_e01| Int32.t
   589                          ;; exponent representation: excess-127
   590                          ;;      exp = $01...$FE -> ± (2^(exp-127) * 1.mantissa)
   591                          ;;      exp = $FF -> special numbers: NaN, +infinity, -infinity
   592                          ;;      exp = $00, mantissa =  0 -> +0.0, -0.0
   593                          ;;      exp = $00, mantissa <> 0 ->  ± (2^(-126) * 0.mantissa)
   594                          ;; range:   ±1.17549435E-38 ... ±3.40282346E+38 (normal)
   595                          ;;          ±1.40129846E-45 ... ±1.17549421E-38 (subnormal)
   596                          ;; example: 1.0= |0¦0111111|1¦0000000|00000000|00000000|
   597                          ;; little-endian |00000000|00000000|1¦0000000|0¦0111111| Int32.t
   598                          ;;
   599                          ;; C64 (in RAM): |E07_E00|±¦M30_M24|M23_M16|M15_M08|M07_M00|
   600                          ;; C64 (in FAC): |E07_E00|1¦M30_M24|M23_M16|M15_M08|M07_M00|±///////|
   601                          ;; exponent representation: excess-128
   602                          ;;      exp = $01...$FF -> ± (2^(exp-128) * 0.1mantissa)
   603                          ;;      exp = $00 -> 0.0
   604                          ;; range:   ±2.93873588E-39 ... ±1.70141183E+38
   605                          ;; example: 1.0= |10000001|0¦0000000|00000000|00000000|00000000|  (RAM)
   606                          ;;          1.0= |10000001|1¦0000000|00000000|00000000|00000000|0|(FAC)
   607                          
   608                          !ifdef  caml_PRIM__caml_int32_bits_of_float {
   609                          caml_int32_bits_of_float
   610                                  +caml_int32_alloc
   611                                  LDA ACCU
   612                                  STA caml_float_loadFAC__addr
   613                                  LDA ACCU + 1
   614                                  STA caml_float_loadFAC__addr + 1
   615                                  JSR caml_float_loadFAC
   616                                  LDY # 5                         ; (BLK),Y points to int32 last byte
   617                                  LDX C64_FAC                     ; load c64 exponent
   618                                  BEQ @exp0                       ; switch
   619                                  DEX
   620                                  BEQ @exp1
   621                                  DEX
   622                                  BEQ @exp2
   623                                  ;; c64 exponent > 2:
   624                                  ;; ieee_exp = c64_exp - 2, ieee_mant = asl c64_mant (drop leftmost 1)
   625                                  ;; normal representation - rounding may increment exponent by one
   626                                  CLC                             ;flag: .C=1 if called from @exp2
   627                          @round  BIT C64_FAC + 4                 ;round mantissa
   628                                  BPL +
   629                                  INC C64_FAC + 3
   630                                  BNE +
   631                                  INC C64_FAC + 2
   632                                  BNE +
   633                                  INC C64_FAC + 1
   634                                  BNE +
   635                                  INX                             ;increment exponent if needed
   636                          +       BCS @exp2r                      ;return if called from @exp2
   637                                  ASL C64_FAC + 1                 ;remove leftmost 1 from mantissa
   638                                  ASL C64_FAC + 5                 ;.C := sign bit
   639                                  TXA                             ;.A := exponent |e07_e00|
   640                                  ROR                             ;.A := |±¦e07_e01|, .C := e00
   641                                  STA (BLK),Y                     ;store |±¦e07_e01|
   642                                  LDA C64_FAC + 1                 ;.A := |m22_m16¦0|
   643                                  ROR                             ;.A := |e00¦m22_m16|
   644                                  DEY
   645                                  STA (BLK),Y                     ;store |e00¦m22_m16|
   646                                  LDA C64_FAC + 2                 ;.A := |m15_m08|
   647                                  DEY
   648                                  STA (BLK),Y                     ;store |m15_m08|
   649                                  LDA C64_FAC + 3                 ;.A := |m07_m00|
   650                          @end    DEY
   651                                  STA (BLK),Y                     ;store |m07_m00|
   652                                  LDY # 0
   653                                  LDA BLK
   654                                  STA ACCU
   655                                  LDA BLK + 1
   656                                  STA ACCU + 1
   657                                  ;ACCU := int32
   658                                  RTS                             ;return
   659                                  ;; c64_exp = 0: ieee_exp = 0, ieee_mant = 0
   660                          @exp0   TXA                             ;.A := 0
   661                                  STA (BLK),Y                     ;store zero into all bytes
   662                                  DEY
   663                                  STA (BLK),Y
   664                                  DEY
   665                                  STA (BLK),Y
   666                                  JMP @end                        ;...continue
   667                                  ;; c64_exp = 1: ieee_exp = 0, ieee_mant = lsr c64_mant (subnormal)
   668                                  ;; rounding doesn't affect exponent, as mantissa is 0.0mmm...
   669                          @exp1   LSR C64_FAC + 1                 ;lsr mantissa
   670                                  ROR C64_FAC + 2
   671                                  ROR C64_FAC + 3
   672                                  ROR C64_FAC + 4                 ;fallthrough @exp2
   673                                  ;; c64_exp = 2: ieee_exp = 0, ieee_mant = c64_mant (subnormal)
   674                                  ;; rounding may incr. exponent and cause a switch from
   675                                  ;; subnormal repr. (2^(-126) * 0.mantissa, 0 implicit)
   676                                  ;; to normal one (2^(-126) * 1.rnd_mantissa, 1 implicit)
   677                          @exp2   SEC                             ;use .C as a return flag
   678                                  BCS @round                      ;round mantissa
   679                          @exp2r  TXA                             ;.A := exponent |e07_e00|
   680                                  ASL C64_FAC + 5                 ;.C := sign bit
   681                                  ROR                             ;.A := |±¦e07_e01|, .C := e00
   682                                  STA (BLK),Y                     ;store |±¦e07_e01|
   683                                  LDA C64_FAC + 1
   684                                  ROR
   685                                  DEY
   686                                  STA (BLK),Y                     ;store |e00¦m22_m16|
   687                                  LDA C64_FAC + 2
   688                                  ROR
   689                                  DEY
   690                                  STA (BLK),Y                     ;store |m15_m08|
   691                                  LDA C64_FAC + 3
   692                                  ROR
   693                                  JMP @end                        ;...continue
   694                          }
