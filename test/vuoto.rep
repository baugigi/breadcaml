   282                          ;; -----------------------------------------------------------------------------
   283                          ;;      ROM/RAM OVERLAP - BASIC ROUTINES CALLS
   284                          ;; -----------------------------------------------------------------------------
   285                          
   286                                  ;; Macro: call a BASIC ROM routine
   287                          !macro caml_JSR_BASROM .routine {
   288                            !ifndef caml_basic_rom_overlap {              ;Best case: code never overlaps
   289                                  JSR .routine                            ;BASIC ROM
   290                            } else {
   291                              !if @x < C64_BASROM {                       ;BASROM is disabled but this
   292                                  JSR caml_BASROM_on                      ;part of code doesn't overlap it
   293                                  JSR .routine
   294                                  JSR caml_BASROM_off
   295                          @x  } else {                                    ;Worst case: this part of code
   296                                  PHP                                     ;overlaps BASIC ROM. Pass the
   297                                  PHA                                     ;routine address to a wrapper
   298                                  LDA # <.routine                         ;in a safe zone and call it
   299                                  STA caml_BASROM_addr
   300                                  LDA # >.routine
   301                                  STA caml_BASROM_addr + 1
   302                                  JSR caml_BASROM_wrapper
   303                              }
   304                            }
   305                          }
   306                          
   307                          !ifdef caml_basic_rom_overlap {
   308                          caml_BASROM_wrapper                             ;Wrapper for 'Worst case' above
   309                                  LDA C64_D6510
   310                                  ORA # %00000011
   311                                  STA C64_D6510
   312                                  PLA
   313                                  PLP
   314                          caml_BASROM_addr = * + 1
   315                                  JSR .dummy                              ;SMC: JSR .routine
   316                                  ;; fallthrough caml_BASROM_off
   317                          caml_BASROM_off                                 ;Deactivate BASIC ROM
   318                                  PHP
   319                                  PHA
   320                                  LDA C64_D6510
   321                                  AND # %11111110
   322                                  STA C64_D6510
   323                                  PLA
   324                                  PLP
   325                                  RTS
   326                          caml_BASROM_on                                  ;Activate BASIC ROM
   327                                  PHP
   328                                  PHA
   329                                  LDA C64_D6510
   330                                  ORA # %00000011
   331                                  STA C64_D6510
   332                                  PLA
   333                                  PLP
   334                                  RTS
   335                          }
