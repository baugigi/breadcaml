    13                           !source "/home/pifu/.opam/LTS/lib/bcamlc/stdlib_random.asm"

; ******** Source: /home/pifu/.opam/LTS/lib/bcamlc/stdlib_random.asm
     1                          ;; ——————————————————————————————————————————————————————————————————————
     2                          ;; Progetto BreadCaml / The BreadCaml Project
