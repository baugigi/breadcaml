   382                          !ifdef  caml_PRIM__caml_int32_mul {
   383                          caml_int32_mul
   384                          @M      = TMP                                   ;4 bytes
   385                          @P      = TMP + 4                               ;4 bytes
   386                          @NPTR   = TMP + 8                               ;2 bytes
   387                                  +caml_int32_alloc
   388                                  SEC
   389                                  LDA (SP),Y
   390                                  SBC # $FF - 5                   :!warn "COS'E'? COMMENTARE!"
   391                                  STA @NPTR
   392                                  INY
   393                                  LDA (SP),Y
   394                                  SBC # 0
   395                                  STA @NPTR + 1
   396                                  LDX # 0
   397                                  LDY # 5
   398                                  LDA (ACCU),Y
   399                                  LSR
   400                                  STA @M + 3
   401                                  STX @P + 3
   402                            !for @i, 2, 0 {
   403                                  DEY
   404                                  LDA (ACCU),Y
   405                                  ROR
   406                                  STA @M + @i
   407                                  STX @P + @i
   408                            }
   409                          ;;      ldx #32
   410                          ;; --   bcc +
   411                          ;;      clc
   412                          ;;      ldy #$FF - 3
   413                          ;; -    lda (@NPTR),Y
   414                          ;;      adc @P - $FF + 3,Y
   415                          ;;      sta @P - $FF + 3,Y
   416                          ;;      iny
   417                          ;;      bne -
   418                          ;; +    lsr @P + 3
   419                          ;;  !for @i, 2, 0 {ror @P + @i}
   420                          ;;  !for @i, 3, 0 {ror @M + @i}
   421                          ;;      dex
   422                          ;;      bne --
   423                                  LDX # 8
   424                          --      BCC +
   425                                  CLC
   426                                  LDY # $FF-3
   427                          -       LDA (@NPTR),Y
   428                                  ADC @P - $FF + 3,Y
   429                                  STA @P - $FF + 3,Y
   430                                  INY
   431                                  BNE -
   432                          +       LSR @P + 3
   433                            !for @i, 2, 0 {
   434                                  ROR @P + @i
   435                            }
   436                            !for @i, 3, 0 {
   437                                  ROR @M + @i
   438                            }
   439                                  DEX
   440                                  BNE --
   441                                  LDA @NPTR
   442                                  BNE +
   443                                  DEC @NPTR + 1
   444                          +       DEC @NPTR
   445                                  LDX # 8
   446                          --      BCC +
   447                                  CLC
   448                                  LDY # $FF-2
   449                          -       LDA (@NPTR),Y
   450                                  ADC @P - $FF + 2,Y
   451                                  STA @P - $FF + 2,Y
   452                                  INY
   453                                  BNE -
   454                          +       LSR @P + 2
   455                            !for @i, 1, 0 {
   456                                  ROR @P + @i
   457                            }
   458                            !for @i, 3, 0 {
   459                                  ROR @M + @i
   460                            }
   461                                  DEX
   462                                  BNE --
   463                                  LDA @NPTR
   464                                  BNE +
   465                                  DEC @NPTR + 1
   466                          +       DEC @NPTR
   467                                  LDX # 8
   468                          --      BCC +
   469                                  CLC
   470                                  LDY # $FF - 1
   471                          -       LDA (@NPTR),Y
   472                                  ADC @P - $FF + 1,Y
   473                                  STA @P - $FF + 1,Y
   474                                  INY
   475                                  BNE -
   476                          +       LSR @P + 1
   477                                  ROR @P
   478                            !for @i, 3, 0 {
   479                                  ROR @M + @i
   480                            }
   481                                  DEX
   482                                  BNE --
   483                                  LDA @NPTR
   484                                  BNE +
   485                                  DEC @NPTR + 1
   486                          +       DEC @NPTR
   487                                  LDX # 8
   488                          --      BCC +
   489                                  CLC
   490                                  LDY # $FF
   491                                  LDA (@NPTR),Y
   492                                  ADC @P - $FF,Y
   493                                  STA @P - $FF,Y
   494                          +       LSR @P
   495                            !for @i, 3, 0 {
   496                                  ROR @M + @i
   497                            }
   498                                  DEX
   499                                  BNE --
   500                                  LDY # 5
   501                          -       LDA @M - 2,Y
   502                                  STA (BLK),Y
   503                                  DEY
   504                                  CPY # 2
   505                                  BCS -
   506                                  LDA BLK
   507                                  STA ACCU
   508                                  LDA BLK + 1
   509                                  STA ACCU + 1
   510                                  LDY # 0
   511                                  RTS
   512                          }
