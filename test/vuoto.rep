    23                          
    24                          ;; Check for out-of-range argument
    25                          !macro caml_range .min, .arg, .max, .txt {
    26                            !if (.arg < .min) | (.arg > .max) {
    27                                  !error .txt + " = ", .arg, " out of range [", .min, ", ", .max, "]"
    28                            }
    29                          }
    30                          
    31                          ;; These shouldn't be necessary: ocamlc should have already given up
    32                          !macro  i82     {!serious "ERROR: Objects and classes not implemented"}
    33                          !macro  i8d .t  {!serious "ERROR: Objects and classes not implemented"}
    34                          !macro  i8e     {!serious "ERROR: Objects and classes not implemented"}
    35                          
    37                          !ifndef caml_INTERP {
    38                                  ;; --------------------------------------------------------------------
    39                                  ;;      NATIVE CODE GENERATION
    40                                  ;; --------------------------------------------------------------------
    41                          
    42                          ;; Macros in opcode order, but dependencies
    43                          
    44                          ;; i00-i12 depend on i08
    45                          !macro  i08 .n {                                ;ACCESS n
    46                                  +caml_range 0, .n, $7FFF, "ACC n: n" 
    47                                  .n2h = >(2 * .n)
    48                                  .n2l = <(2 * .n)
    49                            !if .n2l > 0 {
    50                                  LDY # .n2l
    51                            }
    52                            !if .n2h = 0 {
    53                                  !set    caml_gen_ACCL = 1
    54                                  JSR ACCL
    55                            } elif .n2h = 1 {
    56                                  !set    caml_gen_ACCL = 1
    57                                  INC SP + 1
    58                                  JSR ACCL
    59                                  DEC SP + 1
    60                            } else {
    61                                  !set    caml_gen_ACCH = 1
    62                                  LDA # .n2h
    63                                  JSR ACCH
    64                            }
    65                          }
    66                          !macro  i00     {+i08 0}                        ;ACCi -> ACC i
    67                          !macro  i01     {+i08 1}
    68                          !macro  i02     {+i08 2}
    69                          !macro  i03     {+i08 3}
    70                          !macro  i04     {+i08 4}
    71                          !macro  i05     {+i08 5}
    72                          !macro  i06     {+i08 6}
    73                          !macro  i07     {+i08 7}
    74                          
    75                          ;; i0a-i12, i1a-i1e, i31-i34, i36, i38, i3c-i3d, i68-i6c depend on i09
    76                          !macro  i09 {                                   ;PUSH
    77                                  !set    caml_gen_PUSH = 1
    78                                  JSR PUSH
    79                          }
    80                          !macro  i0a     {+i09}                          ;PUSHACC0 -> PUSH
    81                          !macro  i0b     {+i09 : +i08 1}                 ;PUSHACCi -> PUSH; ACC i
    82                          !macro  i0c     {+i09 : +i08 2}
    83                          !macro  i0d     {+i09 : +i08 3}
    84                          !macro  i0e     {+i09 : +i08 4}
    85                          !macro  i0f     {+i09 : +i08 5}
    86                          !macro  i10     {+i09 : +i08 6}
    87                          !macro  i11     {+i09 : +i08 7}
    88                          !macro  i12 .n  {+i09 : +i08 .n}                ;PUSHACC n -> PUSH; ACC n
    89                          !macro  i13 .n {                                ;POP n
    90                                  +caml_range 0, .n, $7FFF, "POP n: n"
    91                                  .n2h = >(2 * .n)
    92                                  .n2l = <(2 * .n)
    93                            !if .n = 0 {
    94                                  ;NOP
    95                            } elif .n = 1 {
    96                                  !set    caml_gen_POP1 = 1
    97                                  JSR POP1
    98                            } else {
    99                                  LDA # .n2l
   100                              !if .n2h > 0 {
   101                                  LDY # .n2h
   102                              }
   103                                  !set    caml_gen_POPN = 1
   104                                  JSR POPN
   105                            }
   106                          }
   107                          !macro  i14 .n {                                ;ASSIGN n
   108                                  +caml_range 0, .n, $7FFF, "ASSIGN n: n"
   109                                  .n2h = >(2 * .n)
   110                                  .n2l = <(2 * .n)
   111                                  !set    caml_gen_ASSIGNL = 1
   112                            !if .n2l > 0 {
   113                                  LDY # .n2l
   114                            }
   115                            !if .n2h = 0 {
   116                                  JSR ASSIGNL
   117                            } elif .n2h = 1 {
   118                                  INC SP + 1
   119                                  JSR ASSIGNL
   120                                  DEC SP + 1
   121                            } else {
   122                                  !set    caml_gen_ASSIGNH = 1
   123                                  LDA # .n2h
   124                                  JSR ASSIGNH
   125                                  STX SP + 1
   126                            }
   127                          }
