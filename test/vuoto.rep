  2154                                          BCC +
  2155                                          INC ACCU + 1
  2156                          +               TAY
  2157                                          LDA (ACCU),Y
  2158                                          TAX
  2159                                          INY
  2160                                          LDA (ACCU),Y
  2161                                          STX ACCU
  2162                                          STA ACCU + 1
  2163                                          LDY #0
