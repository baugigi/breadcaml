   159                          ;;          /
   160                          ;; .Tag_Sz_*_.______···_______.
   161                          ;; |252¦Sz_|_"Exception_name"_|
   162                          
   163                                  Out_of_memory   =  0 :  End_of_file     =  4 :  Stack_overflow  =  8
   164                                  Sys_error       =  1 :  Division_by_zero=  5 :  Sys_blocked_io  =  9
   165                                  Failure         =  2 :  Not_found       =  6 :  Assert_failure  = 10
   166                                  Invalid_argument=  3 :  Match_failure   =  7 :  Undef_rec_module= 11
   167                                  caml_exn_no     = 12
