   521                          
   522                          !ifdef caml_PRIM__caml_float_alloc_result {
   523                          caml_float_alloc_result
   524                                  ;; store result in a new allocated float
   525                                  LDA # Double_tag
   526                                  LDX # Double_wosize
   527                                  LDY # 0
   528                                  JSR caml_alloc
   529                                  LDX BLK
   530                                  LDY BLK + 1
   531                                  +caml_JSR_BASROM C64_MOVMF
   532                                  LDA BLK
   533                                  STA ACCU
   534                                  LDA BLK + 1
   535                                  STA ACCU + 1
   536                                  LDY # 0
   537                                  RTS
   538                          }
