  2125                                          +caml_NEXT
  2126                          GETGLBSUB                                       ;called by [PH]GETGLB[FLD]
  2127                                          JSR caml_interp_getarg
  2128                                          STA ACCU
  2129                                          JSR caml_interp_getarg
  2130                                          STA ACCU + 1
  2131                                          CMP # >caml_glob_table          ;return if ACCU is an address
  2132                                          BCC +                           ; of a standard exception blk
  2133                                          INY                             ;else ACCU points to the global
  2134                                          LDA (ACCU),Y                    ; table: access it and get the
  2135                                          TAX                             ; value
  2136                                          DEY
  2137                                          LDA (ACCU),Y
  2138                                          STA ACCU
  2139                                          STX ACCU + 1
  2140                          +               RTS
  2141                          }
  2142                          
