    88                                          LDY TMP
    89                            }                                     ;{A = >2n, Y = <2n}
    90                                  LDX SP + 1                              ;Save SP+1
    91                                  CLC                                     ;Prepare ADC
    92                                  ADC SP + 1                              ;Add >2n to SP+1
    93                                  STA SP + 1                              ;Save result
    94                                  LDA (SP),Y                              ;Read SP[n], lo byte
    95                                  STA ACCU                                ;and save it in ACCU
    96                                  INY                                     ;Increment index
    97                                  LDA (SP),Y                              ;Read SP[n], hi byte
    98                                  STA ACCU + 1                            ;and save it in ACCU+1
    99                                  LDY # 0                                 ;Reset Y
   100                                  STX SP + 1                              ;Restore SP+1
   101                                  +caml_NEXT                      ;{Y = 0}
   102                          }
   103                          
   104                          PUSH
   105                          !ifdef caml_gen_PUSH {                  ;{Y = 0}
   106                                  LDA SP                                  ;Read the stack pointer, lo
   107                                  BNE +                                   ;If zero
   108                                  DEC SP + 1                              ;then decrement the stack ptr, hi
   109                                  LDA SP + 1
   110                                  CMP # >caml_stack_start
   111                                  BCS +
   112                                  JMP caml_stack_overflow
   113                          +       DEC SP                                  ;Decrement the stack pointer, lo
   114                                  LDA ACCU + 1                            ;Copy ACCU + 1
   115                                  STA (SP),Y                              ;to SP[0], hi byte
   116                                  DEC SP                                  ;Decrement the stack pointer, lo
   117                                  LDA ACCU                                ;Copy ACCU
   118                                  STA (SP),Y                              ;to SP[0], lo byte
