   144                                  INY
   145                                  LDA (ACCU),Y
   146                                  ADC (TMP),Y
   147                                  STA (BLK),Y
   148                            }
   149                                  LDY # 1
   150                                  LDA # > caml_int64_custom
   151                                  STA (BLK),Y
   152                                  DEY
   153                                  LDA # < caml_int64_custom
   154                                  STA (BLK),Y
   155                                  LDA BLK
