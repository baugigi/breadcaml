   236                          
   237                                  ;; BASIC Floating point routines
   238                          	;; BEWARE: MULTIPLY BUG! See https://www.c64-wiki.com/wiki/Multiply_bug
   239                          
   240                                  ;; Movement
   241                          C64_MOVFM       = $BBA2 ;Load FAC from MEM (A/Y). Returns Y=0,A=exp,fl=exp.
   242                          C64_CONUPK      = $BA8C ;Load ARG from MEM (A/Y), set ARISIGN and A:=FAC exp.
   243                          C64_MOVAF       = $BC0C ;Copy (rounded) FAC to ARG.
   244                          C64_MOVMF       = $BBD4 ;Copy (rounded) FAC to MEM (X/Y). Returns A=FAC exp.
   245                          C64_MOVEF       = $BC0F ;Copy FAC to ARG without rounding. 
   246                          C64_MOVFA       = $BBFC ;Copy ARG to FAC
   247                                  ;; Basic Arithmetic
   248                          C64_FADD        = $B867 ;FAC := MEM (A/Y) + FAC 
   249                          C64_FADDT       = $B86A ;FAC := ARG + FAC
   250                          C64_FSUB        = $B850 ;FAC := MEM (A/Y) - FAC 
   251                          C64_FSUBT       = $B853 ;FAC := ARG - FAC
   252                          C64_FMUL        = $BA28 ;FAC := MEM (A/Y) * FAC 
   253                          C64_FMULT       = $BA2B ;FAC := ARG * FAC
   254                          C64_MUL10       = $BAE2 ;Quickly multiply the float held in FAC by 10.
   255                          C64_FDIV        = $BB0F ;FAC := MEM (A/Y) / FAC, ARG := remainder.
   256                          C64_FDIVT       = $BB12 ;FAC := ARG / FAC, ARG := remainder
   257                          C64_DIV10       = $BAFE ;FAC := ABS(FAC / 10).
   258                          C64_NEGOP       = $BFB4 ;Switch sign on the float in FAC, if non-zero
   259                                  ;; Trigonometry
   260                          C64_SIN         = $E26B ;Perform the SIN function on the float in FAC
   261                          C64_COS         = $E264 ;Perform the COS function on the float in FAC
   262                          C64_TAN         = $E2B4 ;Perform the TAN function on the float in FAC
   263                          C64_ATN         = $E30E ;Perform the ATN function on the float in FAC
   264                                  ;; Logarithms
   265                          C64_LOG         = $B9EA ;FAC := ln FAC
   266                          C64_EXP         = $BFED ;FAC := e ^ FAC
   267                          C64_FPWR        = $BF78 ;FAC := MEM (A/Y) ^ FAC.
   268                          C64_FPWRT       = $BF7B ;FAC := ARG ^ FAC.
   269                          C64_SQR         = $BF71 ;FAC := FAC ^ 0.5
   270                          C64_SQRARG      = $BF74 ;FAC := ARG ^ 0.5
   271                                  ;; Other functions
   272                          C64_FADDH       = $B849 ;Add .5 to FAC
   273                          C64_SIGN        = $BC2B ;Sets flags N,Z depending on whether FAC is 0, + or -.
   274                          C64_ABS         = $BC58 ;Perform the ABS function on the float in FAC
   275                          C64_INT         = $BCCC ;Perform the INT function on the float in FAC
   276                          C64_FCOMP       = $BC5B ;Compare FAC and MEM (A/Y). A = 0 (=), 1 (>), -1 (<).
   277                                  ;; Type Conversion
   278                          C64_FOUT        = $BDDD ;Convert float in FAC to a string at $100 (also in A/Y)
   279                          C64_STRVAL      = $B7B5 ;Convert a string ($22/$23, A=length) to float in FAC.  
   280                          C64_FIN         = $BCF3 ;Convert a 0-terminated string $7A/$7B to float in FAC
   281                                                  ;(CHRGOT needed before, or LDA# 1st chr and CLC.)
   282                          C64_FLOATS      = $BC44 ;Conv. 16bit signed int $62 BIG-ENDIAN to float in FAC.
   283                          C64_GIVAYF      = $B391 ;Convert 16bit signed int (Y=lo/A=hi) to float in FAC.
   284                          C64_FLOAT       = $BC3C ;Convert 8bit unsigned int in A to float in FAC.
   285                          C64_SNGFLT      = $B3A2 ;Convert 8bit unsigned int in Y to float in FAC.
   286                          C64_FACINX      = $B1AA ;Convert float in FAC to 16bit signed int (Y=lo/A=hi).
   287                          C64_QINT        = $BC9B ;Conv. float in FAC to 32bit signed int $62 BIG-ENDIAN.
   288                          C64_FADFLT      = $B8D2 ;Normalize value in FAC;(SEC(+)/CLC(-) needed before.)
   289                                  ;; Polynomials
   290                          C64_POLY1       = $E043 ;Evaluate a polynomial with odd powers only, for FAC
   291                          C64_POLY2       = $E059 ;Evaluate a polynomial with odd & even powers, for FAC
