  2342                              !ifdef caml_gen_BGTGEINT {
  2343                                          BCC ACC07
  2344                                          ;; fallthrough BGTGEINT
  2345                              } else { !set ACC7_BGTINT = ACC07 }
  2346                            } else { !set ACC7_BGTINT = BGTGEINT }
  2347                          }
