  2243                                          BEQ @pptrs
  2244                                          LDA PC
  2245                                          LDX PC + 1
  2246                                          JMP SWITCHI
  2247                          @pptrs          LDX PC + 1
  2248                                          ASL TMP
  2249                                          BCC +
  2250                                          INX
  2251                          +               LDA PC
  2252                                          SEC                             ;+1
  2253                                          ADC TMP
  2254                                          BCC +
  2255                                          INX
