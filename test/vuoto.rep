   274                                  STA (SP),Y
   275                                  INY
   276                                  LDA ENV + 1
   277                                  STA (SP),Y
   278                                  INY
   279                                  LDA XARGS                               ;STACK[n+2] := XARGS
   280                                  STA (SP),Y
