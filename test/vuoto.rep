   180                          !ifdef  caml_PRIM__caml_int32_and {
   181                          caml_int32_and
   182                                  +caml_int32_alloc
   183                                  LDA (SP),Y
   184                                  STA TMP
   185                                  INY
   186                                  LDA (SP),Y
   187                                  STA TMP + 1
   188                            !for @i, 1, 4 {
   189                                  INY
   190                                  LDA (ACCU),Y
   191                                  AND (TMP),Y
