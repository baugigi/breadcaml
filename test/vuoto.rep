   100                          !ifdef  caml_PRIM__caml_int32_neg {
   101                          caml_int32_neg
   102                                  +caml_int32_alloc
   103                                  LDX # 0
   104                                  SEC
   105                                  LDA # < caml_int32_custom
   106                                  STA (BLK),Y
   107                                  INY
   108                                  LDA # > caml_int32_custom
   109                                  STA (BLK),Y
   110                            !for @i, 1, 4 {
   111                                  INY
   112                                  TXA
   113                                  SBC (ACCU),Y
   114                                  STA (BLK),Y
   115                            }
   116                                  LDA BLK
   117                                  STA ACCU
   118                                  LDA BLK + 1
   119                                  STA ACCU + 1
   120                                  LDY # 0
   121                                  RTS
   122                          }
