   368                          !ifdef caml_gen_RESTART {               ;{}
   369                                  @ENV0 = TMP
   370                                  LDA ENV                                 ;@ENV0 := ENV
   371                                  STA @ENV0
   372                                  LDA ENV + 1
   373                                  STA @ENV0 + 1
   374                                  LDY # 2
   375                                  LDA (@ENV0),Y                           ;ENV := ENV[1]
   376                                  STA ENV
   377                                  INY
   378                                  LDA (@ENV0),Y
   379                                  STA ENV + 1
   380                                  LDY # -1
   381                                  DEC @ENV0 + 1
   382                                  LDA (@ENV0),Y                           ;Get size(@ENV0)
   383                                  SEC
   384                                  SBC # 2                                 ;A := size(@ENV0)-2
   385                                  BCC +
   386                                  BNE @pharg                              ;push args
   387                          +       INY                                     ;Exit if size(@ENV0)-2 <= 0
   388                                  +caml_NEXT                      ;{Y = 0}
   389                          @pharg  INC @ENV0 + 1
   390                                  ASL
   391                                  TAY                                     ;Y := 2 * (size(@ENV0)-2)
   392                                  ;CLC                                    ;(C clear as size(@ENV0)-2<128)
   393                                  ADC XARGS                               ;Incr. XARGS by size(@ENV0)-2
   394                                  STA XARGS
   395                                  LDA SP
   396                                  STY SP
   397                                  SEC
   398                                  SBC SP
   399                                  STA SP                                  ;SP := SP - 2 * (size(@ENV0)-2)
   400                                  BCS +
   401                                  DEC SP + 1
   402                                  LDA SP + 1
   403                                  CMP # >caml_stack_start
   404                                  BCS +
   405                                  JMP caml_stack_overflow
   406                          +       CLC
   407                                  LDA # 4                                 ;@ENV0 := &Field(@ENV0, 2)
   408                                  ADC @ENV0
   409                                  STA @ENV0
   410                                  BCC +
   411                                  INC @ENV0 + 1
   412                          +       DEY
   413                          -       LDA (@ENV0),Y                           ;push args onto the stack
