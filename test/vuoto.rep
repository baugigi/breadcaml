   392                          !ifdef  caml_PRIM__caml_int64_mul {
   393                          caml_int64_mul
   394                          @M      = TMP                                   ;8 bytes
   395                          @P      = TMP + 8                               ;8 bytes
   396                          @NPTR   = TMP + 16                              ;2 bytes
   397                                  +caml_int64_alloc
   398                                  SEC
   399                                  LDA (SP),Y
   400                                  SBC # $FF - 9                   :!warn "COS'E'? COMMENTARE!"
   401                                  STA @NPTR
   402                                  INY
   403                                  LDA (SP),Y
   404                                  SBC # 0
   405                                  STA @NPTR + 1
   406                                  LDX # 0
   407                                  LDY # 9
   408                                  LDA (ACCU),Y
   409                                  LSR
   410                                  STA @M + 7
   411                                  STX @P + 7
   412                            !for @i, 6, 0 {
   413                                  DEY
   414                                  LDA (ACCU),Y
   415                                  ROR
   416                                  STA @M + @i
   417                                  STX @P + @i
   418                            }
   419                                  LDX # 64
   420                          --      BCC +
   421                                  CLC
   422                                  LDY # $FF - 7
   423                          -       LDA (@NPTR),Y
   424                                  ADC @P - $FF + 7,Y
   425                                  STA @P - $FF + 7,Y
   426                                  INY
   427                                  BNE -
   428                          +       LSR @P + 7
   429                            !for @i, 6, 0 {
   430                                  ROR @P + @i
   431                            }
   432                            !for @i, 7, 0 {
   433                                  ROR @M + @i
   434                            }
   435                                  DEX
   436                                  BNE --
   437                                  LDY # 9
   438                          -       LDA @M - 2,Y
   439                                  STA (BLK),Y
   440                                  DEY
   441                                  CPY # 2
   442                                  BCS -
   443                                  LDA BLK
   444                                  STA ACCU
   445                                  LDA BLK + 1
   446                                  STA ACCU + 1
   447                                  LDY # 0
   448                                  RTS
   449                          }
   450                          
   451                          !ifdef  caml_PRIM__caml_int64_to_float {
   452                          caml_int64_to_float
   453                                  STY C64_FAC + 5                 ;clear FAC sign
   454                                  STY C64_FACRND                  ;clear FAC round byte
   455                                  LDA # 64 + $80
   456                                  STA C64_FAC                     ;set exponent (64)
   457                                  LDY # 6
   458                                  LDX # 3
   459                          -       LDA (ACCU),Y                    ;copy int64 hi bytes into FAC mantissa
   460                                  STA C64_FAC + 1,X
   461                                  INY
   462                                  DEX
   463                                  BPL -
   464                                  EOR # $80
   465                                  CMP # $80                       ;set carry if int64 is positive
   466                                  +caml_JSR_BASROM C64_FADFLT     ;normalize
   467                                  LDX # <TMP
   468                                  LDY # >TMP
   469                                  +caml_JSR_BASROM C64_MOVMF      ;copy FAC to TMP
   470                          ;       ldy #0                          ;Y = 0 by MOVMF
   471                                  STY C64_FAC + 5                 ;clear FAC sign
   472                                  STY C64_FACRND                  ;clear FAC round byte
   473                                  LDA # 32 + $80
   474                                  STA C64_FAC                     ;set exponent (32)
   475                                  LDY # 2
   476                                  LDX # 3
   477                          -       LDA (ACCU),Y                    ;copy int64 lo bytes into FAC mantissa
   478                                  STA C64_FAC + 1,X
   479                                  INY
   480                                  DEX
   481                                  BPL -
   482                                  SEC                             ;set carry (positive)
   483                                  +caml_JSR_BASROM C64_FADFLT     ;normalize
   484                                  LDA # <TMP
   485                                  LDY # >TMP
   486                                  +caml_JSR_BASROM C64_FADD       ;FAC := TMP + FAC
   487                                  JMP caml_float_alloc_result
   488                          }
   489                          
   490                          ;; Conversion from IEEE754 binary64 to C64FLP and vice-versa.
   491                          ;; See en.wikipedia.org/wiki/Double-precision_floating-point_format
   492                          ;; &   www.c64-wiki.com/wiki/Floating_point_arithmetic
   493                          ;;
   494                          ;; IEEE754:      |±¦e10_e04|e03_e00¦m51_m48|m47_m40|...|m07_m00|
   495                          ;; little-endian |m07_m00|...|m47_m40|e03_e00¦m51_m48|±¦e10_e04| Int64.t
   496                          ;; exponent representation: excess-1023
   497                          ;;      exp = $001...$7FE -> ± (2^(exp-1023) * 1.mantissa)
   498                          ;;      exp = $7FF -> special numbers: NaN, +infinity, -infinity
   499                          ;;      exp = $000, mantissa =  0 -> +0.0, -0.0
   500                          ;;      exp = $000, mantissa <> 0 ->  ± (2^(-1022) * 0.mantissa)
   501                          ;; range:   ±2.22507386E-308 ... ±1.79769313E+308 (normal)
   502                          ;;          ±4.94065646E-324 ... ±2.22507386E-308 (subnormal)
   503                          ;; example: 1.0= |0¦0111111|1111¦0000|00000000|...|00000000|
   504                          ;; little-endian |00000000|...|00000000|1111¦0000|0¦0111111| Int64.t
   505                          ;;
   506                          ;; C64 (in RAM): |E07_E00|±¦M30_M24|M23_M16|M15_M08|M07_M00|
   507                          ;; C64 (in FAC): |E07_E00|1¦M30_M24|M23_M16|M15_M08|M07_M00|±///////|
   508                          ;; exponent representation: excess-128
   509                          ;;      exp = $01...$FF -> ± (2^(exp-128) * 0.1mantissa)
   510                          ;;      exp = $00 -> 0.0
   511                          ;; range:   ±2.93873588E-39 ... ±1.70141183E+38
   512                          ;; example: 1.0= |10000001|0¦0000000|00000000|00000000|00000000|  (RAM)
   513                          ;;          1.0= |10000001|1¦0000000|00000000|00000000|00000000|0|(FAC)
   514                          
   515                          !ifdef  caml_PRIM__caml_int64_bits_of_float {
   516                          caml_int64_bits_of_float
   517                          @EXPHI  = TMP
   518                                  +caml_int64_alloc
   519                                  LDA ACCU
   520                                  STA caml_float_loadFAC_addr
   521                                  LDA ACCU + 1
   522                                  STA caml_float_loadFAC_addr + 1
   523                                  JSR caml_float_loadFAC
   524                                  LDA C64_FAC                     ;load exp
   525                                  CLC
   526                                  ADC # <(1023 - 128 - 1)         ;adjust bias, lo bits
   527                                  STA C64_FAC                     ;save
   528                                  LDA # 0
   529                                  ADC # >(1023 - 128 - 1)         ;idem, hi bits
   530                                  LDX # 3                         ;shift left exp 4 times
   531                          -       ASL C64_FAC
   532                                  ROL
   533                                  DEX
   534                                  BPL -
   535                                  STA @EXPHI
   536                                  LDA C64_FAC + 5                 ;load sign byte
   537                                  AND # %10000000                 ;get bit 7
   538                                  ORA @EXPHI                      ;merge with exp
   539                                  LDY # 9
   540                                  STA (BLK),Y                     ;save |±¦e10_e04|
   541                                  LDX # 4                         ;shift left mantissa 5 times
   542                          -       ASL C64_FAC + 4
   543                            !for @i, 3, 1 {
   544                                  ROL C64_FAC + @i
   545                            }
   546                                  ROL
   547                                  DEX
   548                                  BPL -
   549                                  AND # %00001111                 ;merge m51_m48
   550                                  ORA C64_FAC                     ;with e03_e00
   551                                  DEY
   552                            !for @i, 1, 4 {
   553                                  STA (BLK),Y
   554                                  LDA C64_FAC + @i
   555                                  DEY
   556                            }
   557                                  LDA # 0
   558                                  STA (BLK),Y                     ;put 0 in last 3 bytes
   559                                  DEY
   560                                  STA (BLK),Y
   561                                  DEY
   562                                  STA (BLK),Y
   563                                  TAY
   564                                  LDA BLK
   565                                  STA ACCU
   566                                  LDA BLK + 1
   567                                  STA ACCU + 1
   568                                  ;return result
   569                                  RTS
   570                          }
   571                          
   572                          !ifdef  caml_PRIM__caml_int64_float_of_bits {
   573                          caml_int64_float_of_bits
   574                                  LDY # 9
   575                                  LDA (ACCU),Y                    ;.A <- sign¦e10_e04
   576                                  STA C64_FAC + 5                 ;put sign into FAC sign byte
   577                                  AND # %01111111                 ;clear sign bit
   578                                  TAX
   579                                  DEY
   580                                  LDA (ACCU),Y                    ;.A <- e03_e00¦m51_m48
   581                                  STA C64_FAC + 1
   582                                  SEC
   583                                  SBC # <((1023-128-1) << 4)      ;adjust exp bias, lo bits
   584                                  STA C64_FAC
   585                                  TXA
   586                                  SBC # >((1023-128-1) << 4)      ;idem, hi bits
   587                                  BCS +
   588                                  LDA # 0                         ;treat floats under C64 repr.
   589                                  STA C64_FAC                     ;lower limit as zero:
   590                          @zero   STA C64_FAC + 5                 ;clear minus sign, if any;
   591                                  JMP caml_float_alloc_result     ;allocate float and return
   592                          @exn    +caml_raise Invalid_argument, "Int64.float_of_bits"
   593                          @mask  !byte %11110000
   594                          +       BIT @mask
   595                                  BNE @exn                        ;if NaN, ±inf or overflow, raise exn
   596                            !for @i, 1, 4 {
   597                                  LSR                             ;shift result into FAC exp byte
   598                                  ROR C64_FAC
   599                            }
   600                                  BEQ @zero                       ;if zero skip mantissa loading
   601                                  DEY
   602                                  LDA (ACCU),Y                    ;load significative part of mantissa
   603                                  STA C64_FAC + 2
   604                                  DEY
   605                                  LDA (ACCU),Y
   606                                  STA C64_FAC + 3
   607                                  DEY
   608                                  LDA (ACCU),Y
   609                                  STA C64_FAC + 4
   610                                  DEY
   611                                  LDA (ACCU),Y
   612                                  STA C64_FACRND
   613                                  LDX # 2                         ;shift left 3 times
   614                          -       ASL C64_FACRND
   615                            !for @i, 4, 1 {
   616                                  ROL C64_FAC + @i
   617                            }
   618                                  DEX
   619                                  BPL -
   620                                  LDA C64_FAC + 1
   621                                  ORA # $80                       ;set leftmost bit of mantissa
   622                                  STA C64_FAC + 1
   623                                  JMP caml_float_alloc_result     ;allocate float and return
   624                          }
   625                          
   626                          ; caml_int64_bits_of_float(value vd)
   627                          ; caml_int64_div(value v1, value v2)
   628                          ; caml_int64_mod(value v1, value v2)
   629                          ; caml_int64_bswap(value v)
   630                          ; caml_int64_of_int(value v)
   631                          ; caml_int64_to_int(value v)
   632                          ; caml_int64_of_float
   633                          ; caml_int64_of_int32(value v)
   634                          ; caml_int64_to_int32(value v)
   635                          
   636                          }       ;; zone caml_INT64
   637                          

