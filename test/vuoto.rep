    14                          
    15                          ;;; ----------------------------------------------------------------------------
    16                          ;;; ARRAYS (ocaml-4.04.1/byterun/array.c)
    17                          ;;; ----------------------------------------------------------------------------
    18                          !zone caml_ARRAYS {
    19                          
    20                          !ifdef caml_PRIM__caml_make_vect {
    21                          caml_make_vect
    22                                  ;; allocate and initialize an array
    23                                  ;; ACCU = length
    24                                  ;; SP[0] = init
    25                          @NFLO2  = TMP
    26                          @INIT   = TMP + 2
    27                                  ;; load init
    28                                  INY
    29                                  LDA (SP),Y
    30                                  STA @INIT + 1
    31                                  DEY
    32                                  LDA (SP),Y
    33                                  STA @INIT
    34                                  ;; is init a block?
    35                                  BIT caml_is_block                       ; test @INIT
    36                                  BNE @no_float_array
    37                                  ;; tag(init) = Double_tag?
    38                                  LDY # -2
    39                                  DEC @INIT + 1
    40                                  LDA (@INIT),Y
    41                                  INC @INIT + 1
    42                                  LDY # 0
    43                                  CMP # Double_tag
    44                                  BNE @no_float_array
    45                          ;;      ;; is init in heap?
    46                          ;;      SEC
    47                          ;;      LDA @INIT
    48                          ;;      SBC # < caml_heap_start
    49                          ;;      STA TMP
    50                          ;;      LDA @INIT + 1
    51                          ;;      SBC # > caml_heap_start
    52                          ;;      STA TMP + 1
    53                          ;;      LDA TMP
    54                          ;;      CMP # < caml_heap_sz
    55                          ;;      LDA TMP + 1
    56                          ;;      SBC # > caml_heap_sz
    57                          ;;      BCS @no_float_array
    58                                  ;; allocate float array 
    59                                  JSR caml_make_float_vect
    60                                  ;; init floats
    61                                  LDA @NFLO2                      ; see caml_make_float_vect
    62                                  LSR
    63                                  TAX                             ; X = no. of floats
    64                          ;       CLC
    65                          -       +caml_move_float @INIT, BLK
    66                                  LDA # < (2 * Double_wosize)
    67                                  ADC BLK
    68                                  STA BLK
    69                                  LDA # > (2 * Double_wosize)
    70                                  ADC BLK + 1
    71                                  STA BLK + 1
    72                                  DEX
    73                                  BNE -
    74                                  RTS
    75                          @no_float_array
    76                                  ;; check length
    77                                  LSR ACCU + 1
    78                                  BNE @error
    79                                  LDA ACCU
    80                                  ROR
    81                                  BNE +
    82                                  ;; length = 0, empty array
    83                                  LDA # < caml_atom0
    84                                  STA ACCU
    85                                  LDA # > caml_atom0
    86                                  STA ACCU + 1
    87                                  RTS
    88                                  ;; length > 0, allocate array
    89                          +       TAX                             ; size
    90                                  TYA                             ; tag = 0
    91                                  JSR caml_alloc
    92                                  LDA BLK
    93                                  STA ACCU
    94                                  LDA BLK + 1
    95                                  STA ACCU + 1
    96                                  ;; init fields
    97                          -       LDA @INIT
    98                                  STA (BLK),Y
    99                                  INY
   100                                  LDA @INIT + 1
   101                                  STA (BLK),Y
   102                                  INY
   103                                  BNE +
   104                                  INC BLK + 1
   105                          +       DEX
   106                                  BNE -
   107                                  LDY # 0
   108                                  RTS
   109                          @error  +caml_raise Invalid_argument, "Array.make"
   110                          }
   111                          
   112                          !ifdef caml_PRIM__caml_make_float_vect {
   113                                  ;; allocate an array of floats
   114                                  ;; ACCU = length
   115                          caml_make_float_vect
   116                          @NFLO2  = TMP                   ; see caml_make_vect
   117                                  LDA ACCU + 1
   118                                  BNE @error
   119                                  LDA ACCU
   120                                  ;; exn if 3 * index > 255
   121                                  AND # $FE
   122                                  BNE +
   123                                  ;; length = 0, empty array
   124                                  LDA # < caml_atom0
   125                                  STA ACCU
   126                                  LDA # > caml_atom0
   127                                  STA ACCU + 1
   128                                  RTS
   129                                  ;; length > 0, size is length * 3
   130                          +       STA @NFLO2
   131                                  LSR
   132                          ;       CLC                             ;implicit
   133                                  ADC @NFLO2
   134                                  BCS @error
   135                                  ;; allocate array of floats
   136                                  TAX                             ; size
   137                                  LDA # Double_array_tag          ; tag
   138                                  JSR caml_alloc
   139                                  LDA BLK
   140                                  STA ACCU
   141                                  LDA BLK + 1
   142                                  STA ACCU + 1
   143                                  RTS
   144                          @error  +caml_raise Invalid_argument, "Array.create_float"
   145                          }
   146                          
   147                          !ifdef caml_PRIM__caml_make_array {
   148                                  ;; if init is a block of floats, unbox all elements
   149                                  ;; ACCU = init
   150                          caml_make_array
   151                          @FIELD0 = TMP
   152                          @NFLOATS= TMP + 2
   153                                  ;; exit if size(init) = 0
   154                                  LDA # >caml_atom0
   155                                  CMP ACCU + 1
   156                                  BNE +
   157                                  LDA # <caml_atom0
   158                                  CMP ACCU
   159                                  BEQ @exit
   160                                  ;; exit if Field(init,0) is not a block
   161                          +       INY
   162                                  LDA (ACCU),Y
   163                                  STA @FIELD0
   164                                  INY
   165                                  LDA (ACCU),Y
   166                                  STA @FIELD0 + 1
   167                                  BIT caml_is_block                       ; test @FIELD0
   168                                  BNE @exit
   169                          ;;      ;; exit if Field(init,0) is out of heap
   170                          ;;      SEC
   171                          ;;      LDA @FIELD0
   172                          ;;      SBC # < caml_heap_start
   173                          ;;      STA TMP
   174                          ;;      LDA @FIELD0 + 1
   175                          ;;      SBC # > caml_heap_start
   176                          ;;      STA TMP + 1
   177                          ;;      LDA TMP
   178                          ;;      CMP # < caml_heap_sz
   179                          ;;      LDA TMP + 1
   180                          ;;      SBC # > caml_heap_sz
   181                          ;;      BCS @exit
   182                                  ;; exit if tag(Field(init,0)) <> Double_tag
   183                                  LDY # -2
   184                                  DEC @FIELD0 + 1
   185                                  LDA (@FIELD0),Y
   186                                  CMP # Double_tag
   187                                  BEQ +
   188                                  LDY # 0
   189                          @exit   RTS
   190                                  ;; check length
   191                          +       INY
   192                                  DEC ACCU + 1
   193                                  LDA (ACCU),Y
   194                          ;       inc ACCU + 1
   195                                  INY
   196                                  CMP # 255 DIV Double_wosize + 1
   197                                  BCC +
   198                                  +caml_raise Out_of_memory
   199                                  ;; size is lenght * 3
   200                          +       STA @NFLOATS
   201                                  ASL
   202                          ;       clc
   203                                  ADC @NFLOATS
   204                                  ;; allocate array of floats
   205                                  TAX
   206                                  LDA # Double_array_tag
   207                                  JSR caml_alloc
   208                                  LDA BLK
   209                                  STA ACCU
   210                                  LDA BLK + 1
   211                                  STA ACCU + 1
   212                                  ;; init fields
   213                                  INC @FIELD0 + 1                 ; previously dec'ed
   214                          -       +caml_move_float @FIELD0, BLK
   215                                  DEX
   216                                  BEQ @exit
   217                                  INC @FIELD0
   218                                  INC @FIELD0
   219                                  BNE +
   220                                  INC @FIELD0 + 1
   221                          +       INC BLK
   222                                  INC BLK
   223                                  BNE -
   224                                  INC BLK + 1
   225                                  JMP -
   226                          }
   227                          
   228                          !ifdef caml_PRIM__caml_array_get {
   229                          caml_array_get
   230                                  ;; return an array element
   231                                  ;; ACCU = array
   232                                  ;; SP[0] = index
   233                          
   234                                  ;; load tag
   235                                  LDY # -2
   236                                  DEC ACCU + 1
   237                                  LDA (ACCU),Y
   238                                  INY
   239                                  ;; check if float
   240                                  CMP # Double_array_tag
   241                                  BNE caml_array_get_addr__loadsize
   242                                  JMP caml_array_get_float__loadsize
   243                          }
   244                          
   245                          !ifdef caml_PRIM__caml_array_get_addr {
   246                                  ;; return an array element (no-float version)
   247                                  ;; ACCU = array
   248                                  ;; SP[0] = index
   249                          caml_array_get_addr
   250                                  DEY
   251                                  DEC ACCU + 1
   252                          caml_array_get_addr__loadsize
   253                                  LDA (ACCU),Y
   254                                  STA TMP                                 ; TMP := size
   255                                  INC ACCU + 1                            ; restore ptr to Field(0)
   256                                  LDY # 1
   257                                  LDA (SP),Y                              ; load index, hi
   258                                  LSR
   259                                  BNE @error                              ; exn if index>255 or index<0
   260                                  BCC +
   261                                  INC ACCU + 1                            ; inc ACCU if index > 127
   262                          +       DEY
   263                                  LDA (SP),Y                              ; load index, lo
   264                                  TAY                                     ; now ACCU+Y points to elt, hi
   265                                  ROR
   266                                  CMP TMP
   267                                  BCS @error                              ; exn if index >= size
   268                                  LDA (ACCU),Y                            ; get array elt, hi
   269                                  TAX
   270                                  DEY
   271                                  LDA (ACCU),Y                            ; get array elt, lo
   272                                  STA ACCU                                ; ACCU <- array[index]
   273                                  STX ACCU + 1
   274                                  LDY # 0
   275                                  RTS
   276                          @error  +caml_raise Invalid_argument, "index out of bounds"
   277                          }
   278                          
   279                          !ifdef caml_PRIM__caml_array_get_float {
   280                                  ;; return an array element (float-only version)
   281                                  ;; ACCU = array
   282                                  ;; SP[0] = index
   283                          caml_array_get_float
   284                                  ;; load size
   285                                  DEY
   286                                  DEC ACCU + 1
   287                          caml_array_get_float__loadsize
   288                          @SZ     = TMP
   289                          @IDX    = TMP + 1
   290                                  LDA (ACCU),Y
   291                                  STA @SZ
   292                                  INC ACCU + 1
   293                                  ;; load index, hi
   294                                  LDY # 1
   295                                  LDA (SP),Y
   296                                  BEQ +
   297                                  ;; exn if hi > 0
   298                                  JMP @error
   299                                  ;; load index, lo
   300                          +       DEY
   301                                  LDA (SP),Y
   302                                  ;; exn if 3 * index >= size
   303                                  AND # $FE
   304                                  BEQ +
   305                                  STA @IDX
   306                                  LSR
   307                                  ;CLC
   308                                  ADC @IDX
   309                                  BCS @error
   310                                  CMP @SZ
   311                                  BCS @error
   312                                  ;; ACCU <- &array[index]
   313                          +       ASL
   314                                  BCC +
   315                                  INC ACCU + 1
   316                                  CLC
   317                          +       ADC ACCU
   318                                  STA ACCU
   319                                  BCC +
   320                                  INC ACCU + 1
   321                                  ;; allocate float
   322                          +       LDA # Double_tag
   323                                  LDX # Double_wosize
   324                                  JSR caml_alloc
   325                                  ;; copy float
   326                                  +caml_move_float ACCU, BLK
   327                                  ;; return float
   328                                  LDA BLK
   329                                  STA ACCU
   330                                  LDA BLK + 1
   331                                  STA ACCU + 1
   332                                  RTS
   333                          @error  +caml_raise Invalid_argument, "index out of bounds"
   334                          }
   335                          
   336                          !ifdef caml_PRIM__caml_array_unsafe_get {
   337                          caml_array_unsafe_get
   338                                  ;; return an array element (unsafe version)
   339                                  ;; ACCU = array
   340                                  ;; SP[0] = index
   341                                  LDY # -2
   342                                  DEC ACCU + 1
   343                                  LDA (ACCU),Y                            ; load tag
   344                                  INC ACCU + 1                            ; restore ptr
   345                                  LDY # 0
   346                                  CMP # Double_array_tag                  ; check if float
   347                                  BEQ caml_array_unsafe_get_float         ; yes: special case
   348                                  LDA (SP),Y                              ; Val_int(index), lo
   349                                  STA TMP
   350                                  INY
   351                                  LDA (SP),Y                              ; Val_int(index), hi
   352                                  BEQ +
   353                                  INC ACCU + 1
   354                          +       LDY TMP
   355                                  ;; get array element
   356                                  LDA (ACCU),Y                            ; array[index], hi
   357                                  TAX
   358                                  DEY
   359                                  LDA (ACCU),Y                            ; array[index], lo
   360                                  STA ACCU
   361                                  STX ACCU + 1
   362                                  LDY # 0
   363                                  RTS
   364                          }
   365                          
   366                          !ifdef caml_PRIM__caml_array_unsafe_get_float {
   367                                  ;; return an array element (unsafe, float-only version)
   368                                  ;; ACCU = array
   369                                  ;; SP[0] = index
   370                          caml_array_unsafe_get_float
   371                                  ;; load index, lo (ignore hi byte)
   372                                  LDA (SP),Y                      ; 2*i+1
   373                                  ;; calc 3 * i
   374                                  AND # $FE
   375                                  STA TMP
   376                                  LSR
   377                                  CLC
   378                                  ADC TMP
   379                                  ;; ACCU <- &array[index]
   380                                  ASL
   381                                  BCC +
   382                                  INC ACCU + 1
   383                                  CLC
   384                          +       ADC ACCU
   385                                  STA ACCU
   386                                  BCC +
   387                                  INC ACCU + 1
   388                                  ;; allocate float
   389                          +       LDA # Double_tag
   390                                  LDX # Double_wosize
   391                                  JSR caml_alloc
   392                                  ;; copy float
   393                                  +caml_move_float ACCU, BLK
   394                                  ;; return float
   395                                  LDA BLK
   396                                  STA ACCU
   397                                  LDA BLK + 1
   398                                  STA ACCU + 1
   399                                  RTS
   400                          }
   401                          
   402                          !ifdef caml_PRIM__caml_array_set {
   403                          caml_array_set
   404                                  ;; set an array element to given value
   405                                  ;; ACCU = array
   406                                  ;; SP[0] = index
   407                                  ;; SP[1] = newval
   408                          
   409                                  ;; load tag
   410                                  LDY # -2
   411                                  DEC ACCU + 1
   412                                  LDA (ACCU),Y
   413                                  INY
   414                                  ;; check if float
   415                                  CMP # Double_array_tag
   416                                  BNE caml_array_set_addr__loadsize
   417                                  JMP caml_array_set_float__loadsize
   418                          }
   419                          
   420                          !ifdef caml_PRIM__caml_array_set_addr {
   421                                  ;; set an array element to given value (no-float version)
   422                                  ;; ACCU = array
   423                                  ;; SP[0] = Val_int(index)
   424                                  ;; SP[1] = newval
   425                          caml_array_set_addr
   426                                  ;; load size
   427                                  DEY
   428                                  DEC ACCU + 1
   429                          caml_array_set_addr__loadsize
   430                          @SZ     = TMP
   431                          @NEW    = TMP + 1
   432                                  LDA (ACCU),Y
   433                                  STA @SZ
   434                                  INC ACCU + 1
   435                                  ;; load newval
   436                                  LDY # 3
   437                                  LDA (SP),Y
   438                                  STA @NEW + 1
   439                                  DEY
   440                                  LDA (SP),Y
   441                                  STA @NEW
   442                                  ;; load index, hi
   443                                  DEY
   444                                  LDA (SP),Y
   445                                  ;; exn if index > 255 or index < 0
   446                                  LSR
   447                                  BNE @error
   448                                  ;; load index, lo
   449                                  DEY
   450                                  LDA (SP),Y
   451                                  ROR
   452                                  ;; exn if index >= size
   453                                  CMP @SZ
   454                                  BCS @error
   455                                  ;; array[index] <- newval
   456                                  ASL
   457                                  BCC +
   458                                  INC ACCU + 1
   459                          +       TAY
   460                                  LDA @NEW
   461                                  STA (ACCU),Y
   462                                  INY
   463                                  LDA @NEW + 1
   464                                  STA (ACCU),Y
   465                                  ;; ACCU <- ()
   466                                  LDY # <Val_unit                 ;.Y := 1
   467                                  STY ACCU
   468                                  DEY
   469                                  STY ACCU + 1
   470                                  RTS
   471                          @error  +caml_raise Invalid_argument, "index out of bounds"
   472                          }
   473                          
   474                          !ifdef caml_PRIM__caml_array_set_float {
   475                                  ;; set an array element to given value (float-only version)
   476                                  ;; ACCU = array
   477                                  ;; SP[0] = index
   478                                  ;; SP[1] = newval
   479                          caml_array_set_float
   480                                  ;; load size
   481                                  DEY
   482                                  DEC ACCU + 1
   483                          caml_array_set_float__loadsize
   484                          @SZ     = TMP
   485                          @IDX    = TMP + 1
   486                          @NEW    = TMP + 2
   487                                  LDA (ACCU),Y
   488                                  STA @SZ
   489                                  INC ACCU + 1
   490                                  ;; load newval
   491                                  LDY # 3
   492                                  LDA (SP),Y
   493                                  STA @NEW + 1
   494                                  DEY
   495                                  LDA (SP),Y
   496                                  STA @NEW
   497                                  ;; load index, hi
   498                                  DEY
   499                                  LDA (SP),Y
   500                                  ;; exn if hi > 0
   501                                  BNE @error
   502                                  ;; load index, lo
   503                                  DEY
   504                                  LDA (SP),Y
   505                                  ;; exn if 3 * index >= size
   506                                  AND # $FE
   507                                  STA @IDX
   508                                  LSR
   509                                  CLC
   510                                  ADC @IDX
   511                                  BCS @error
   512                                  CMP @SZ
   513                                  BCS @error
   514                                  ;; ACCU <- &array[index]
   515                          +       ASL
   516                                  BCC +
   517                                  INC ACCU + 1
   518                                  CLC
   519                          +       ADC ACCU
   520                                  STA ACCU
   521                                  BCC +
   522                                  INC ACCU + 1
   523                                  ;; copy float
   524                          +       +caml_move_float @NEW, ACCU
   525                                  ;; ACCU <- ()
   526                                  STY ACCU + 1
   527                                  INY
   528                                  STY ACCU
   529                                  DEY
   530                                  RTS
   531                          @error  +caml_raise Invalid_argument, "index out of bounds"
   532                          }
   533                          
   534                          !ifdef caml_PRIM__caml_array_unsafe_set {
   535                          caml_array_unsafe_set
   536                                  ;; set an array element to given value (unsafe version)
   537                                  ;; ACCU = array
   538                                  ;; SP[0] = index
   539                                  ;; SP[1] = newval
   540                          
   541                                  ;; load tag
   542                                  LDY # -2
   543                                  DEC ACCU + 1
   544                                  LDA (ACCU),Y
   545                                  INC ACCU + 1
   546                                  LDY # 0
   547                                  ;; check if float
   548                                  CMP # Double_array_tag
   549                                  BEQ caml_array_unsafe_set_float
   550                                  ;; FALLTHROUGH caml_array_unsafe_set_addr
   551                          }
   552                          
   553                          !ifdef caml_PRIM__caml_array_unsafe_set_addr {
   554                                  ;; set an array element to given value (unsafe, no-float version)
   555                                  ;; ACCU = array
   556                                  ;; SP[0] = index
   557                                  ;; SP[1] = newval
   558                          caml_array_unsafe_set_addr
   559                                  ;; load index
   560                                  LDA (SP),Y                      ; Val_int(index), lo
   561                                  STA TMP
   562                                  INY
   563                                  LDA (SP),Y                      ; Val_int(index), hi
   564                                  BEQ +
   565                                  INC ACCU + 1
   566                                  ;; load newval
   567                          +       INY
   568                                  LDA (SP),Y
   569                                  TAX
   570                                  INY
   571                                  LDA (SP),Y
   572                                  ;; array[index] <- newval
   573                                  LDY TMP
   574                                  STA (ACCU),Y
   575                                  DEY
   576                                  TXA
   577                                  STA (ACCU),Y
   578                                  ;; ACCU <- ()
   579                                  LDY # <Val_unit                 ;.Y := 1
   580                                  STY ACCU
   581                                  DEY
   582                                  STY ACCU + 1
   583                                  RTS
   584                          }
   585                          
   586                          !ifdef caml_PRIM__caml_array_unsafe_set_float {
   587                                  ;; set an array element to given value (unsafe, float-only version)
   588                                  ;; ACCU = array
   589                                  ;; SP[0] = index
   590                                  ;; SP[1] = newval
   591                          caml_array_unsafe_set_float
   592                                  ;; load index, lo (ignore hi byte)
   593                                  LDA (SP),Y                      ; 2*i+1
   594                                  ;; calc 3 * i
   595                                  AND # $FE
   596                                  STA TMP
   597                                  LSR
   598                                  CLC
   599                                  ADC TMP
   600                                  ;; ACCU <- &array[index]
   601                                  ASL
   602                                  BCC +
   603                                  INC ACCU + 1
   604                                  CLC
   605                          +       ADC ACCU
   606                                  STA ACCU
   607                                  BCC +
   608                                  INC ACCU + 1
   609                                  ;; load newval
   610                          +       LDY # 2
   611                                  LDA (SP),Y
   612                                  STA TMP
   613                                  INY
   614                                  LDA (SP),Y
   615                                  STA TMP + 1
   616                                  ;; copy float
   617                                  +caml_move_float TMP, ACCU
   618                                  ;; ACCU <- ()
   619                                  LDA # <Val_unit
   620                                  STA ACCU
   621                                  STY ACCU + 1                    ; Y = 0
   622                                  RTS
   623                          }
   624                          
   625                          !ifdef caml_PRIM__caml_array_blit {
   626                          caml_array_blit
   627                                  ;; copy a subarray to other one (source and dest may overlap)
   628                                  ;; ACCU = arr1
   629                                  ;; SP[0] = ofs1
   630                                  ;; SP[1] = arr2
   631                                  ;; SP[2] = ofs2
   632                                  ;; SP[3] = n
   633                          @NBY    = TMP + 2
   634                                  ;; load tag
   635                                  LDY # -2
   636                                  DEC ACCU + 1
   637                                  LDA (ACCU),Y
   638                                  INC ACCU + 1
   639                                  ;; check if float
   640                                  CMP # Double_array_tag
   641                                  BNE @no_float
   642                                  ;; array of floats, compute source start address
   643                                  LDY # 0
   644                                  STY @NBY + 1
   645                                  LDA (SP),Y                      ; ofs1, ignore hi byte
   646                                  AND # $FE
   647                                  STA TMP
   648                                  LSR
   649                                  CLC
   650                                  ADC TMP
   651                                  ;; ACCU <- &arr1[ofs1]
   652                                  ASL                             ; A = 6 * ofs1
   653                                  BCC +
   654                                  INC ACCU + 1
   655                                  CLC
   656                          +       ADC ACCU
   657                                  STA ACCU
   658                                  BCC +
   659                                  INC ACCU + 1
   660                                  ;; compute destination start address
   661                          +       LDY # 4
   662                                  LDA (SP),Y                      ; ofs2, ignore hi byte
   663                                  ;; calc 3 * index
   664                                  AND # $FE
   665                                  STA TMP
   666                                  LSR
   667                                  CLC
   668                                  ADC TMP
   669                                  ;; TMP <- &arr2[ofs2]
   670                                  TAX                             ; X = 3 * ofs2
   671                                  DEY
   672                                  LDA (SP),Y
   673                                  STA TMP + 1
   674                                  TXA
   675                                  ASL                             ; A = 6 * ofs2
   676                                  BCC +
   677                                  INC TMP + 1
   678                                  CLC
   679                          +       DEY
   680                                  ADC (SP),Y
   681                                  STA TMP
   682                                  BCC +
   683                                  INC TMP + 1
   684                                  ;; @NBY = 6 * n (no. of bytes to be moved)
   685                          +       LDY # 6
   686                                  LDA (SP),Y                      ; ignore hi byte
   687                                  AND # $FE
   688                                  STA @NBY
   689                                  LSR
   690                                  CLC
   691                                  ADC @NBY
   692                                  STA @NBY
   693                                  BCC +
   694                                  INC @NBY + 1
   695                          +       JMP @copy
   696                          @no_float
   697                                  ;; ordinary array, compute source start address
   698                                  LDY # 0
   699                                  CLC
   700                                  LDA (SP),Y
   701                                  ADC ACCU
   702                                  STA ACCU
   703                                  INY
   704                                  LDA (SP),Y
   705                                  ADC ACCU + 1
   706                                  STA ACCU + 1
   707                                  LDA ACCU
   708                                  BNE +
   709                                  DEC ACCU + 1
   710                          +       DEC ACCU
   711                                  ;; compute destination start address
   712                                  INY
   713                                  LDA (SP),Y
   714                                  STA TMP
   715                                  INY
   716                                  LDA (SP),Y
   717                                  STA TMP + 1
   718                                  INY
   719                                  CLC
   720                                  LDA TMP
   721                                  ADC (SP),Y
   722                                  STA TMP
   723                                  INY
   724                                  LDA TMP + 1
   725                                  ADC (SP),Y
   726                                  STA TMP + 1
   727                                  LDA TMP
   728                                  BNE +
   729                                  DEC TMP + 1
   730                          +       DEC TMP
   731                                  ;; compute no. of bytes to be copied
   732                                  INY
   733                                  LDA @NBY
   734                                  ADC (SP),Y
   735                                  STA @NBY
   736                                  INY
   737                                  LDA @NBY + 1
   738                                  ADC (SP),Y
   739                                  STA @NBY + 1
   740                                  LDA @NBY
   741                                  BNE +
   742                                  DEC @NBY + 1
   743                          +       DEC @NBY
   744                                  ;; copy bytes from source to destination
   745                          @copy   LDA ACCU
   746                                  CMP TMP
   747                                  LDA ACCU + 1
   748                                  SBC TMP + 1
   749                                  BCS @cpydn
   750                                  ;; ACCU < TMP, copy memory up (arr1[0] last)
   751                                  LSR @NBY + 1
   752                                  LDY @NBY
   753                                  JSR caml_blkcpy
   754                                  ;; ACCU <- ()
   755                          @done   STY ACCU + 1                    ; Y = 0
   756                                  LDA # <Val_unit
   757                                  STA ACCU
   758                                  RTS
   759                                  ;; ACCU >= TMP, copy memory down (arr1[0] first)
   760                          @cpydn  LDX @NBY + 1                    ; 0 or 1
   761                                  BEQ +
   762                                  LDY # 0
   763                          -       LDA (ACCU),Y                    ; >255 bytes: copy a whole page
   764                                  STA (TMP),Y
   765                                  INY
   766                                  BNE -
   767                                  INC ACCU + 1
   768                                  INC TMP + 1
   769                          +       LDX @NBY
   770                                  BEQ +
   771                          -       LDA (ACCU),Y                    ; copy the remaining bytes
   772                                  STA (TMP),Y
   773                                  INY
   774                                  DEX
   775                                  BNE -
   776                          +       LDY # 0
   777                                  JMP @done
   778                          }
   779                          
   780                          !ifdef caml_PRIM__caml_array_sub {
   781                          caml_array_sub
   782                                  ;; allocate and return a subarray
   783                                  ;; ACCU = a
   784                                  ;; SP[0] = ofs
   785                                  ;; SP[1] = n
   786                          @NBY    = TMP
   787                                  ;; load tag
   788                                  LDY # -2
   789                                  DEC ACCU + 1
   790                                  LDA (ACCU),Y
   791                                  INC ACCU + 1
   792                                  ;; check if float
   793                                  CMP # Double_array_tag
   794                                  BNE @no_floats
   795                                  ;; array of floats, compute source start address
   796                                  LDY # 0                         ; ignore hi byte
   797                                  STY @NBY + 1
   798                                  LDA (SP),Y
   799                                  AND # $FE
   800                                  STA TMP
   801                                  LSR
   802                                  CLC
   803                                  ADC TMP
   804                                  ;; ACCU <- &arr1[ofs1]
   805                                  ASL                             ; A = 6 * ofs1
   806                                  BCC +
   807                                  INC ACCU + 1
   808                                  CLC
   809                          +       ADC ACCU
   810                                  STA ACCU
   811                                  BCC +
   812                                  INC ACCU + 1
   813                                  ;; @NBY = 6 * n (no. of bytes to be moved)
   814                          +       LDY # 2
   815                                  LDA (SP),Y                      ; ignore hi byte
   816                                  AND # $FE
   817                                  STA @NBY
   818                                  LSR
   819                                  CLC
   820                                  ADC @NBY
   821                                  STA @NBY
   822                                  BCC +
   823                                  INC @NBY + 1
   824                                  ;; allocate subarray
   825                          +       LDA @NBY + 1
   826                                  LSR
   827                                  LDA @NBY
   828                                  ROR
   829                                  TAX
   830                                  LDA # Double_array_tag
   831                                  JSR caml_alloc
   832                                  JMP @copy
   833                          @no_floats
   834                                  ;; ordinary array, compute source start address
   835                                  LDY # 0
   836                                  CLC
   837                                  LDA ACCU
   838                                  ADC (SP),Y
   839                                  STA ACCU
   840                                  INY
   841                                  LDA ACCU + 1
   842                                  ADC (SP),Y
   843                                  STA ACCU + 1
   844                                  LDA ACCU
   845                                  BNE +
   846                                  DEC ACCU + 1
   847                          +       DEC ACCU
   848                                  ;; compute no. of bytes to be copied
   849                                  INY
   850                                  LDA (SP),Y
   851                                  STA @NBY
   852                                  INY
   853                                  LDA (SP),Y
   854                                  STA @NBY + 1
   855                                  LDA @NBY
   856                                  BNE +
   857                                  DEC @NBY + 1
   858                          +       DEC @NBY
   859                                  ;; allocate subarray
   860                                  LDA @NBY + 1
   861                                  LSR
   862                                  LDA @NBY
   863                                  ROR
   864                                  TAX
   865                                  LDA # 0
   866                                  JSR caml_alloc
   867                                  ;; copy bytes from source to destination
   868                          @copy   LSR @NBY + 1
   869                                  LDY @NBY
   870                                  JSR caml_blkcpy
   871                                  ;; ACCU <- subarray
   872                          @done   LDA BLK
   873                                  STA ACCU
   874                                  LDA BLK + 1
   875                                  STA ACCU + 1
   876                                  RTS
   877                          }
   878                          
   879                          !ifdef caml_PRIM__caml_array_append {
   880                          caml_array_append
   881                                  ;; append two arrays
   882                                  ;; ACCU = arr1
   883                                  ;; SP[0] = arr2
   884                          @AUX    = TMP
   885                          @SIZE1  = TMP + 2
   886                          @SIZE2  = TMP + 4
   887                                  ;; load sizes
   888                                  LDA (SP),Y
   889                                  STA @AUX
   890                                  INY
   891                                  LDA (SP),Y
   892                                  STA @AUX + 1
   893                                  LDY # -1
   894                                  DEC ACCU + 1
   895                                  DEC @AUX + 1
   896                                  LDA (ACCU),Y
   897                                  STA @SIZE1
   898                                  LDA (@AUX),Y
   899                                  STA @SIZE2
   900                                  CLC
   901                                  ADC @SIZE1
   902                                  BCC +
   903                                  ;; exception if total size > 255
   904                                  INY                             ; Y = 0
   905                                  JMP @error
   906                                  ;; load tag and allocate
   907                          +       DEY
   908                                  TAX                             ; size
   909                                  LDA (ACCU),Y                    ; tag
   910                                  JSR caml_alloc
   911                                  ;; copy arr1 to dest
   912                                  INC ACCU + 1
   913                                  LDA @SIZE1
   914                                  ASL
   915                                  TAY
   916                                  JSR caml_blkcpy
   917                                  ;; ACCU <- arr2
   918                                  LDA @AUX
   919                                  STA ACCU
   920                                  LDA @AUX + 1
   921                                  STA ACCU + 1
   922                                  ;; save ptr to result
   923                                  LDA BLK
   924                                  STA @AUX
   925                                  LDA BLK + 1
   926                                  STA @AUX + 1
   927                                  ;; TMP <- &TMP[SIZE1]
   928                          +       LDA @SIZE1
   929                                  ASL
   930                                  BCC +
   931                                  INC BLK + 1
   932                                  CLC
   933                          +       ADC BLK
   934                                  STA BLK
   935                                  BCC +
   936                                  INC BLK + 1
   937                                  ;; copy arr2 to dest
   938                          +       LDA @SIZE2
   939                                  ASL
   940                                  TAY
   941                                  JSR caml_blkcpy
   942                                  ;; ACCU <- AUX
   943                                  LDA @AUX
   944                                  STA ACCU
   945                                  LDA @AUX + 1
   946                                  STA ACCU + 1
   947                                  RTS
   948                          @error  +caml_raise Invalid_argument, "Array.append"
   949                          }
   950                          
   951                          !ifdef caml_PRIM__caml_array_concat {
   952                          caml_array_concat
   953                                  ;; concatenate all arrays in a list
   954                                  ;; ACCU = list
   955                          @TAG    = TMP
   956                          @SIZE   = TMP + 1
   957                          @HEAD   = TMP + 2
   958                          @TAIL   = TMP + 4
   959                          @RESULT = TMP + 2
   960                                  DEY
   961                                  STY @TAG                        ; @TAG = -1
   962                                  INY
   963                                  STY @SIZE
   964                                  ;; return caml_atom0 if list = []
   965                                  LDA ACCU
   966                                  BIT caml_is_block
   967                                  BNE @atom0
   968                                  ;; scan list and sum all arrays sizes
   969                                  LDA (ACCU),Y
   970                                  STA @HEAD
   971                                  INY
   972                                  LDA (ACCU),Y
   973                                  STA @HEAD + 1
   974                                  INY
   975                                  LDA (ACCU),Y
   976                                  STA @TAIL
   977                                  INY
   978                                  LDA (ACCU),Y
   979                                  STA @TAIL + 1
   980                                  ;; get current array size and add it to @SIZE
   981                          -       LDY # -1
   982                                  DEC @HEAD + 1
   983                                  LDA (@HEAD),Y
   984                                  BEQ +
   985                                  CLC
   986                                  ADC @SIZE
   987                                  BCS @error                      ; raise exn if > 255
   988                                  STA @SIZE
   989                                  ;; only once: set @TAG from first non-empty array
   990                                  CPY @TAG                        ; test if @TAG = -1
   991                                  BNE +
   992                                  DEY
   993                                  LDA (@HEAD),Y
   994                                  STA @TAG
   995                                  INY
   996                                  ;; set @HEAD to next list element, @TAIL to rest
   997                          +       INY
   998                                  LDA @TAIL
   999                                  BIT caml_is_block                       ; end of list?
  1000                                  BEQ @alloc                      ; yes:  exit loop
  1001                                  LDA (@TAIL),Y                   ; no:   continue
  1002                                  STA @HEAD
  1003                                  INY
  1004                                  LDA (@TAIL),Y
  1005                                  STA @HEAD + 1
  1006                                  INY
  1007                                  LDA (@TAIL),Y
  1008                                  TAX
  1009                                  INY
  1010                                  LDA (@TAIL),Y
  1011                                  STX @TAIL
  1012                                  STA @TAIL + 1
  1013                                  JMP -
  1014                                  ;; allocate destination array
  1015                          @alloc  LDX @SIZE
  1016                                  BEQ @atom0
  1017                                  LDA @TAG
  1018                                  JSR caml_alloc
  1019                                  LDA BLK
  1020                                  STA @RESULT
  1021                                  LDA BLK + 1
  1022                                  STA @RESULT + 1                 ; save dest address
  1023                                  ;; scan list again and append all arrays
  1024                                  LDY # 3
  1025                                  LDA (ACCU),Y
  1026                                  STA @TAIL + 1
  1027                                  DEY
  1028                                  LDA (ACCU),Y
  1029                                  STA @TAIL
  1030                                  DEY
  1031                                  LDA (ACCU),Y
  1032                                  TAX
  1033                                  DEY
  1034                                  LDA (ACCU),Y
  1035                                  STX ACCU + 1
  1036                                  STA ACCU
  1037                                  ;; get current array size
  1038                          -       LDY # -1
  1039                                  DEC ACCU + 1
  1040                                  LDA (ACCU),Y
  1041                                  BEQ ++                          ; skip if zero
  1042                                  INC ACCU + 1
  1043                                  TAX
  1044                                  ASL
  1045                                  TAY
  1046                                  ;; copy array elements to destination
  1047                                  JSR caml_blkcpy
  1048                                  TXA
  1049                                  ;; set BLK pointer to first element to be copied next
  1050                                  ASL
  1051                                  BCC +
  1052                                  CLC
  1053                                  INC BLK + 1
  1054                          +       ADC BLK
  1055                                  STA BLK
  1056                                  BCC ++
  1057                                  INC BLK + 1
  1058                                  ;; set ACCU to next list element, @TAIL to rest
  1059                          ++      LDY # 0
  1060                                  LDA @TAIL
  1061                                  BIT caml_is_block               ; end of list?
  1062                                  BEQ @eol                        ; yes:  exit
  1063                                  LDA (@TAIL),Y                   ; no:   continue
  1064                                  STA ACCU
  1065                                  INY
  1066                                  LDA (@TAIL),Y
  1067                                  STA ACCU + 1
  1068                                  INY
  1069                                  LDA (@TAIL),Y
  1070                                  TAX
  1071                                  INY
  1072                                  LDA (@TAIL),Y
  1073                                  STX @TAIL
  1074                                  STA @TAIL + 1
  1075                                  JMP -                           ; loop
  1076                                  ;; set ACCU = destination array and return
  1077                          @eol    LDA @RESULT
  1078                                  STA ACCU
  1079                                  LDA @RESULT + 1
  1080                                  STA ACCU + 1
  1081                                  RTS
  1082                          @atom0  LDA # < caml_atom0
  1083                                  STA ACCU
  1084                                  LDA # > caml_atom0
  1085                                  STA ACCU + 1
  1086                                  RTS
  1087                          @error  +caml_raise Invalid_argument, "Array.concat"
  1088                          }
  1089                          
  1090                          }      ;; !zone caml_ARRAYS
  1091                          

