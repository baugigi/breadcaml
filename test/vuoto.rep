   239                                          SBC # $41 -1                    ;-1 as C=0; A:=2n-1=2*opc-$41
   240                                          TAY
   241                            }                                     ;{Y = 2n-1}
   242                                  @SP = TMP
   243                                  @N2M1 = TMP + 2
   244                                  STY @N2M1
   245                                  LDA SP                                  ;Save current SP value
   246                                  STA @SP
   247                                  LDA SP + 1
   248                                  STA @SP + 1
