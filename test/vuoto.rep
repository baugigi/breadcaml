   521                          ;; RETURN:
   522                          ;;
   523                          ;; A function might be called with more arguments on the stack than expected. If
   524                          ;; there is any extra argument, RETURN does not give control back to the caller:
   525                          ;; instead, it assumes that there is a closure in the accumulator and gives it
   526                          ;; immediate control.
   527                          
   528                          RETURN
   529                          !ifdef caml_gen_RETURN {
   530                            !ifdef caml_INTERP {
   531                                          @PC = PC
   532                                          JSR caml_interp_getarg
   533                                          ORA # 0                         ;set N flag according to A
   534                                          BEQ +
   535                            } else {                              ;{A = 2n}
   536                                  @PC = TMP
   537                                  BEQ +
   538                                  CLC
   539                            }
   540                                  ADC SP                                  ;pop n elements
   541                                  STA SP
   542                                  BCC +
   543                                  INC SP + 1
   544                                  CLC
   545                          +       LDA XARGS                               ;If XARGS - Val_one < Val_zero
   546                                  SBC # (Val_one & $FE) -1                ;(-1 as carry is clear)
   547                                  BCC GORETURN                            ;then get return frame
   548                                  STA XARGS                               ;else XARGS := XARGS - Val_one
   549                                  LDA ACCU
   550                                  STA ENV                                 ; ENV := ACCU
   551                                  LDA ACCU + 1
   552                                  STA ENV + 1
   553                                  LDA (ACCU),Y                            ; TMP := Code(ACCU)
   554                                  STA @PC
   555                                  INY
   556                                  LDA (ACCU),Y
   557                                  STA @PC + 1
   558                                  DEY                                     ; reset Y
   559                                  +caml_JMP_CODEPTR @PC           ;{Y = 0}
   560                          }
