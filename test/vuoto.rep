   245                          ;; i2d-i2f, i31-i34 depend on i30
   246                          !macro  i30 .n {                                ;OFFSETCLOSURE n
   247                                  +caml_range -$FE, .n, $FE, "OFFSETCLOSURE n: n"
   248                                  +caml_range 0, .n mod 2, 0, "OFFSETCLOSURE n: n mod 2"
   249                                  .n2h = >(2 * .n)
   250                                  .n2l = <(2 * .n)
   251                            !if .n2h > 0 {
   252                                  LDX # .n2h
   253                              }
   254                            !if .n = 0 {
   255                                  !set    caml_gen_OFSCL0 = 1
