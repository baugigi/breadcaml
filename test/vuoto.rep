   240                                  ;;
   241                                  ;; polymorphic comparisons
   242                                  ;;
   243                          
   244                          !ifdef caml_PRIM__caml_equal {
   245                          caml_equal
   246                                  JSR caml_compare_val
   247                                  BNE caml_return_false
   248                                  BEQ caml_return_true
   249                          }
   250                          
   251                          !ifdef caml_PRIM__caml_notequal {
   252                          caml_notequal
   253                                  JSR caml_compare_val
   254                                  BNE caml_return_true
   255                                  BEQ caml_return_false
   256                          }
   257                          
   258                          !ifdef caml_PRIM__caml_lessthan {
   259                          caml_lessthan
