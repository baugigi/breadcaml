    11                           !source "/home/pifu/.opam/LTS/lib/bcamlc/stdlib_io.asm"

; ******** Source: /home/pifu/.opam/LTS/lib/bcamlc/stdlib_io.asm
     1                          ;; ——————————————————————————————————————————————————————————————————————
     2                          ;; Progetto BreadCaml / The BreadCaml Project
     3                          ;; Copyright (C) 21-Apr-2026 Piero Furiesi
     4                          ;;
