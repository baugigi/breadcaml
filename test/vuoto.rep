   380                          !ifdef  caml_INTERP {
   381                            !pseudopc caml_interp_fetch {
   382                                          @PC  = @fetch + 1               ;Bytecode interpreter
   383                                          @idx = @exec + 1                ;fetch-exec routine:
   384                          @fetch          LDA .dummy                      ; 3 by. SMC: fetch next opc
   385                                          INC+1 @PC                       ; 2 by. incr. LDA operand (PCl)
   386                                          BNE +                           ; 2 by.
   387                                          INC+1 @PC + 1                   ; 2 by. incr. LDA operand (PCh)
   388                          +
   389                              !ifdef caml_DEBUG {
   390                                          JSR caml_debug
   391                              } else {
   392                                          ASL                             ; 1 by. C:A = 2 * opc
   393                                          STA+1 @idx                      ; 2 by. modify JMP() operand
   394                              }
   395                          @exec           JMP (caml_interp_jmptbl)        ; 3 by. SMC: JMP(>jmptbl + A)
   396                            }                                             ;--
   397  0a63 0000000000000000...} else {!fill 15}                               ;15 by. total
   398  0a72 0000000000000000...        !fill 28                                ;28 by. for BLK, GC, TMP
   399                          
   400                          ;; -----------------------------------------------------------------------------
   401                          ;;      INTERPRETER TRACING DEBUGGER
   402                          ;;      | PC | Opcode | ACCU | SP[0] ... SP[5] | ENV | XARGS |
   403                          ;; -----------------------------------------------------------------------------
   404                          
   405                          !ifdef  caml_INTERP {
   406                          !ifdef caml_DEBUG {
   407                          caml_debug
   408                                  @RevOn  = $12
   409                                  @RevOff = $92
   410                                  @Cyan   = $9F
   411                                  @LBlue  = $9A
   412                                  @CR     = $0D
   413                                  PHP                                     ;       [S
   414                                  PHA                                     ;       [opc; S
   415                                  ;; print a header every 22 lines
   416                                  DEC @count
   417                                  BPL +
   418                                  LDA # @CR
   419                                  JSR C64_CHROUT
   420                                  LDX # @hdr - @end                       ;negative number
   421                          -       LDA @end - $100,X
   422                                  JSR C64_CHROUT
   423                                  INX
   424                                  BNE -
   425                                  LDA #21
   426                                  STA @count
   427                          +       ;; print PC
   428                                  LDA PC
   429                                  SEC
   430                                  SBC # 1
   431                                  PHA                                     ;       [PC; opc; S
   432                                  LDA PC + 1
   433                                  SBC # 0
   434                                  JSR @pr_hex
   435                                  PLA                                     ;A=PC   [opc; S
   436                                  JSR @pr_hex
   437                                  ;; print opcode
   438                                  LDA # @RevOn
   439                                  JSR C64_CHROUT
   440                                  PLA                                     ;A=opc  [S
   441                                  PHA                                     ;       [opc; S
   442                                  JSR @pr_hex
   443                                  ;; print ACCU
   444                                  LDA # @Cyan
   445                                  JSR C64_CHROUT
   446                                  LDA ACCU + 1
   447                                  JSR @pr_hex
   448                                  LDA ACCU
   449                                  JSR @pr_hex
   450                                  LDA # @RevOff
   451                                  JSR C64_CHROUT
   452                                  ;; print top 6 stack elements
   453                                  LDY # 0
   454                          -       TYA
   455                                  PHA                                     ;       [Y/4; opc; S
   456                                  LSR
   457                                  LSR
   458                                  LDA # @LBlue
   459                                  BCS +                                   ;switch Cyan/LBlue
   460                                  LDA # @Cyan
   461                          +       JSR C64_CHROUT
   462                                  PLA                                     ;A=Y/4  [opc; S
   463                                  TAY
   464                                  LDA (SP),Y
   465                                  TAX
   466                                  INY
   467                                  LDA (SP),Y
   468                                  JSR @pr_hex                             ;print STACK[i]
   469                                  TXA
   470                                  JSR @pr_hex
   471                                  INY
   472                                  CPY # 12
   473                                  BNE -
   474                                  ;; print ENV
   475                                  LDA # @RevOn
   476                                  JSR C64_CHROUT
   477                                  LDA ENV + 1
   478                                  JSR @pr_hex
   479                                  LDA ENV
   480                                  JSR @pr_hex
   481                                  ;; print XARGS
   482                                  LDA # @RevOff
   483                                  JSR C64_CHROUT
   484                                  LDA XARGS
   485                                  LSR
   486                                  JSR @pr_hex
   487                                  ;; continue fetch-exec
   488                                  PLA                                     ;A=opc  [S
   489                                  PLP                                     ;S      [
   490                                  ASL
   491                                  LDY # 0
   492                                  RTS
   493                          @count  !byte 0
   494                          @pr_hex PHA                                     ;       [A
   495                                  LSR
   496                                  LSR
   497                                  LSR
   498                                  LSR
   499                                  LDX # 2
   500                                  BNE +
   501                          -       PLA                                     ;A      [
   502                                  AND # $0F
   503                          +       CLC
   504                                  ADC # '0'
   505                                  CMP # '9' + 1
   506                                  BCC +
   507                                  ADC # 7 -1                              ;-1 as C=1
   508                          +       JSR C64_CHROUT
   509                                  DEX
   510                                  BNE -
   511                                  RTS
   512                          @hdr    !text @RevOn, "addr", @RevOff, "oc",   @Cyan,  "accu", @RevOn, "stk0"
   513                                  !text @LBlue, "   1", @Cyan,   "   2", @LBlue, "   3", @Cyan,  "   4"
   514                                  !text @LBlue, "   5", @RevOff, " env", @RevOn, "xa",   @RevOff
   515                          @end
   516                          }} ;ifdef caml_INTERP & caml_DEBUG
   517                          
   518                          caml_loader_end
   519                          } ;zone caml_LOADER
   520                          

