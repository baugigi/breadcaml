    69                          ;; -----------------------------------------------------------------------------
    70                          
    71                          ACCL
    72                          !ifdef caml_gen_ACCL {                  ;{Y = <2n}
    73                                  LDA (SP),Y                              ;Read SP[n], lo byte
    74                                  STA ACCU                                ;and save it in ACCU
    75                                  INY                                     ;Increment index
    76                                  LDA (SP),Y                              ;Read SP[n], hi byte
    77                                  STA ACCU + 1                            ;and save it in ACCU+1
    78                                  LDY # 0                                 ;Reset Y
    79                                  +caml_NEXT                      ;{Y = 0}
    80                          }
    81                          
    82                          ACCH
    83                          !ifdef caml_gen_ACCH {
