    38                          !macro caml_int64_alloc {
    39                                  LDA # Custom_tag
    40                                  LDX # 5
    41                                  JSR caml_alloc
    42                          }
    43                          
    44                          !ifdef  caml_PRIM__caml_int64_custom    {
    45                          !align $01, $00
    46                          caml_int64_custom
    47                                  !word @caml_int64_compare
    48                                  !word @caml_int64_hash
    49                          @caml_int64_compare
    50                                  STY TMP + 2
    51                                  LDA (SP),Y
    52                                  STA TMP
    53                                  INY
    54                                  LDA (SP),Y
    55                                  STA TMP + 1
    56                                  SEC
    57                                  LDX # 7
    58                          -       INY
    59                                  LDA (ACCU),Y
    60                                  SBC (TMP),Y
    61                                  ORA TMP + 2
    62                                  STA TMP + 2
    63                                  DEX
    64                                  BNE -
    65                                  INY
    66                                  LDA (ACCU),Y
    67                                  SBC (TMP),Y
    68                                  BVC +
    69                                  EOR # $80
    70                          +       BMI ++                          ;jump if <
    71                                  LDY # 0
    72                                  STY ACCU + 1
    73                                  ORA TMP + 2
    74                                  BNE +                           ;jump if >
    75                                  LDA # <Val_zero
    76                                  STA ACCU
    77                                  RTS
    78                          +       LDA # <Val_one
    79                                  STA ACCU
    80                                  RTS
    81                          ++      LDY # $FF
    82                                  STY ACCU
    83                                  STY ACCU + 1
    84                                  INY
    85                                  RTS
    86                          @caml_int64_hash
    87                                  LDY # 9
    88                                  LDA (ACCU),Y
    89                            !for @i, 1, 3 {
    90                                  DEY
    91                                  EOR (ACCU),Y
    92                            }
    93                                  TAX
    94                                  DEY
    95                                  LDA (ACCU),Y
    96                            !for @i, 1, 3 {
    97                                  DEY
    98                                  EOR (ACCU),Y
    99                            }
   100                                  SEC
   101                                  ROL
   102                                  STA ACCU
   103                                  TXA
   104                                  ROL
   105                                  STA ACCU + 1
   106                                  LDY # 0
   107                                  RTS
   108                          }
   109                          
   110                          !ifdef  caml_PRIM__caml_int64_neg {
   111                          caml_int64_neg
   112                                  +caml_int64_alloc
   113                                  LDX # 0
   114                                  SEC
   115                                  LDA # < caml_int64_custom
   116                                  STA (BLK),Y
   117                                  INY
   118                                  LDA # > caml_int64_custom
   119                                  STA (BLK),Y
   120                            !for @i, 1, 8 {
   121                                  INY
   122                                  TXA
   123                                  SBC (ACCU),Y
   124                                  STA (BLK),Y
   125                            }
   126                                  LDA BLK
   127                                  STA ACCU
   128                                  LDA BLK + 1
   129                                  STA ACCU + 1
   130                                  LDY # 0
   131                                  RTS
   132                          }
