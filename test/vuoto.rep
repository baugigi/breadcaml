   562                          CLOSURE
   563                          !ifdef caml_gen_CLOSURE {
   564                                  @CODE   = TMP
   565                                  @NM1    = TMP + 2
   566                            !ifdef caml_INTERP {
   567                                          JSR caml_interp_getarg
   568                                          TAX
   569                                          JSR caml_interp_getarg
   570                                          STA @CODE
   571                                          JSR caml_interp_getarg
   572                                          STA @CODE + 1
   573                            } else {                      ;{X = n, A = <ptr, Y = >ptr}
   574                                  STA @CODE                               ;save code pointer
   575                                  STY @CODE + 1
   576                            }
   577                                  INX                                     ;allocate a closure block
   578                                  LDA # Closure_tag                       ;with n + 1 fields
   579                                  JSR caml_alloc
   580                                  LDA @CODE                               ;Field(BLK,0) := code pointer
   581                                  STA (BLK),Y                             ;Y=0 by caml_alloc
   582                                  INY
   583                                  LDA @CODE + 1
   584                                  STA (BLK),Y
   585                                  DEX                                     ;X := n
   586                                  BEQ +                                   ;if n > 0 then
   587                                  INY
   588                                  LDA ACCU                                ; Field(BLK,1) := ACCU
   589                                  STA (BLK),Y
   590                                  INY
   591                                  LDA ACCU + 1
   592                                  STA (BLK),Y
   593                          +       LDA BLK + 1                             ;ACCU := block address, A:=BLK
   594                                  STA ACCU + 1
   595                                  LDA BLK
   596                                  STA ACCU
   597                                  CPX # 2
   598                                  BCC ++                                  ;If n <= 1 then exit
   599                                  ADC # 4 - 1                             ;(-1 as carry is set)
   600                                  STA BLK                                 ;BLK := &Field(BLK,2)
   601                                  BCC +
   602                                  INC BLK + 1
   603                          +       DEX
   604                                  STX @NM1
   605                                  LDY # 0                                 ;for i := 0 to n - 2
   606                          -       LDA (SP),Y                              ; Field(BLK,2+i) := SP[i]
   607                                  STA (BLK),Y
   608                                  INY
   609                                  LDA (SP),Y
   610                                  STA (BLK),Y
   611                                  INY
   612                                  DEX
   613                                  BNE -
   614                                  LDA @NM1                                ;Pop n - 1 elements
   615                                  ASL
   616                                  ;CLC                                    ;C clear as 2*@NM1 < 256
   617                                  ADC SP
   618                                  STA SP
   619                                  BCC ++
   620                                  INC SP + 1
   621                          ++      LDY # 0
   622                                  +caml_NEXT                      ;{Y = 0}
   623                          }
   624                          
   625                          CLOSREC
   626                          !ifdef caml_gen_CLOSREC {
   627                                  @NVAR   = TMP
   628                                  @NFUN   = TMP + 1
   629                                  @ADR    = TMP + 2
   630                            !ifdef caml_INTERP {                          ;$2c .v .f .data=fun1 [funs]
   631                                          @DATA = PC
   632                                          JSR caml_interp_getarg
   633                                          STA @NVAR
   634                                          JSR caml_interp_getarg          ;Now @DATA=PC points to .data
   635                                          STA @NFUN
   636                            } else {                              ;{A = <.data, Y = >.data}
   637                                  @DATA = TMP + 4
   638                                  STA @DATA
   639                                  DEY
   640                                  STY @DATA + 1                           ;Now @DATA points to .data - $100
   641                                  LDY # -2                                ;Now @DATA + Y points to .v
   642                                  LDA (@DATA),Y                           ;Read .v
   643                                  STA @NVAR                               ; and save it
   644                                  INY
   645                                  LDA (@DATA),Y                           ;Read .f
   646                                  STA @NFUN                               ; and save it
   647                                  INY                                     ;Set Y = 0
   648                                  INC @DATA + 1                           ;Now @DATA points to .data
   649                            }
   650                                  ASL                                     ;Compute the size of the
   651                                  CLC                                     ; closure block as
   652                                  ADC @NVAR                               ; 2×@NFUN+@NVAR-1 words (<=255)
   653                                  TAX                                     ;(here A may be 0 if f=128,v=0)
   654                                  DEX                                     ;(last step, X=255 if f=128,v=0)
   655                                  LDA # Closure_tag                       ;Load appropriate tag
   656                                  JSR caml_alloc                          ; and allocate the closure
   657                                  LDA @NVAR                               ;If @NVAR>0 then push ACCU on the
   658                                  BEQ +                                   ; stack (it'll be popped out and
   659                                  JSR PUSH                                ; inserted into the closure)
   660                          +       LDA BLK
   661                                  STA ACCU                                ;ACCU := closure address
   662                                  STA @ADR                                ;@ADR := closure address
   663                                  LDA BLK + 1
   664                                  STA ACCU + 1
   665                                  STA @ADR + 1
   666                                  LDX @NFUN                               ;Set loop counter
   667                                  BNE @code                               ;JMP @code (loop entry)
   668                          @ifx    LDA # Infix_tag                         ; Put an infix tag in lo byte of
   669                                  STA (BLK),Y                             ;  Field(BLK,2i-1), i=@NFUN-X+1
   670                                  INY
   671                                  TYA                                     ; Compute the offset: Y is odd,
   672                                  LSR                                     ;  LSR:ADC is (Y+1)/2="distance"
   673                                  ADC # 0                                 ;  in word from main closure;
   674                                  STA (BLK),Y                             ;  write it into hi byte.
   675                                  INY                                     ; An Y overflow may occur here:
   676                                  BNE +                                   ;  if so,
   677                                  INC BLK + 1                             ;  increment hi bytes of
   678                                  INC @DATA + 1                           ;  both pointers.
   679                          +       LDA @DATA                               ; Decrement DATA by 2
   680                                  SEC                                     ;  as only 2 bytes from the .t
   681                                  SBC # 2                                 ;  tab will be copied every 4
   682                                  STA @DATA                               ;  increments of Y index.
   683                                  BCS @code
   684                                  DEC @DATA + 1
   685                          @code   LDA (@DATA),Y                           ;Loop entry: populate fun fields
   686                                  STA (BLK),Y                             ; Load code ptr, lo by; store it
   687                                  INY                                     ;  in Field(BLK,2i-2),i=@NFUN-X+1
   688                                  LDA (@DATA),Y
   689                                  STA (BLK),Y                             ; As above, hi byte
   690                                  INY
   691                                  DEX                                     ; Decrement loop counter (i++)
   692                                  BNE @ifx                                ;Loop until X = 0 (i > @NFUN)
   693                            !ifdef caml_INTERP {
   694                                          TYA
   695                                          CLC
   696                                          ADC PC
   697                                          STA PC                          ;PC:=@DATA+Y=PC+Y=.data+2×f
   698                                          BCC +
   699                                          INC PC + 1
   700                          + }
   701                                  TYA                                     ;Set BLK to point to next field
   702                                  CLC
   703                                  ADC BLK
   704                                  STA BLK
   705                                  BCC +
   706                                  INC BLK + 1
   707                          +       LDX @NVAR
   708                                  BEQ @grwstk                             ;If @NVAR = 0 then exit
   709                                  LDY # 0
   710                          @vars   LDA (SP),Y                              ;Loop: copy vars from stack to
   711                                  STA (BLK),Y                             ; Fld(2f-1),…,Fld(2f+v-2)
   712                                  INY
   713                                  LDA (SP),Y
   714                                  STA (BLK),Y
   715                                  INY
   716                                  BNE +
   717                                  INC SP + 1
   718                                  INC BLK + 1
   719                          +       DEX
   720                                  BNE @vars
   721                                  TYA                                     ;Pop @NVAR elts
   722                                  CLC
   723                                  ADC SP
   724                                  STA SP
   725                                  BCC @grwstk
   726                                  INC SP + 1
   727                          @grwstk LDA @NFUN
   728                                  ASL
   729                                  TAY
   730                                  BCS +                                   ;branch if @NFUN=128
   731                                  EOR # $FF
   732                                  SEC
   733                                  ADC SP
   734                                  STA SP                                  ;SP := SP-2*@NFUN
   735                                  BCS ++
   736                          +       DEC SP + 1
   737                                  LDA SP + 1
   738                                  CMP # >caml_stack_start
   739                                  BCS ++
   740                                  JMP caml_stack_overflow
   741                          ++      DEY                                     ;Init counter: Y=2*@NFUN-1
   742                          @pshadr LDA @ADR + 1                            ;Loop: push onto the stack
   743                                  STA (SP),Y                              ; each function address;
   744                                  DEY                                     ; the 1st one is in @ADR,
   745                                  BEQ +                                   ; the others are 4 bytes 
   746                                  LDA @ADR                                ; far each other,
   747                                  STA (SP),Y
   748                                  DEY
   749                                  CLC
   750                                  ADC # 4                                 ; so add 4 to @ADR at each
   751                                  STA @ADR                                ; step
   752                                  BCC @pshadr
   753                                  INC @ADR + 1
   754                                  BCS @pshadr                             ;JMP @pshadr
   755                          +       LDA @ADR                                ;Last byte
   756                                  STA (SP),Y
   757                                  +caml_NEXT                      ;{Y = 0}
   758                          }
