   158                                  LDX # >.adr
   159                                  JSR PHRET
   160                          }
   161                          
   162                          ;; i21-i23 depend on i20
   163                          !macro  i20 .n {                                ;APPLY n
   164                                  +caml_range 1, .n, $7F, "APPLY n: n"
   165                                  !set    caml_gen_APPLY = 1
   166                                  LDY # 2 * .n - 1
   167                            !if .n <= 3 {
