   211                                          STA TMP
   212                                          JSR caml_interp_getarg
   213                                          TAX
   214                            } else {                              ;{A = <adr, X = >adr, Y = 0}
   215                                  STA TMP
   216                            }
   217                                  +caml_grow_stack 3
   218                                  LDA TMP
   219                                  STA (SP),Y                              ;STACK[0] := return address
   220                                  INY
   221                                  TXA
   222                                  STA (SP),Y
   223                                  INY
   224                                  LDA ENV                                 ;STACK[1] := ENV
   225                                  STA (SP),Y
   226                                  INY
   227                                  LDA ENV + 1
   228                                  STA (SP),Y
   229                                  INY
   230                                  LDA XARGS                               ;STACK[2] := XARGS
