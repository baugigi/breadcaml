   190                                  JMP APPTRMN
   191                            }
   192                          }
   193                          !macro  i25 .s  {+i24 1,.s}                     ;APPTERMi s -> APPTERM i s
   194                          !macro  i26 .s  {+i24 2,.s}
   195                          !macro  i27 .s  {+i24 3,.s}
   196                          !macro  i28 .n {                                ;RETURN n
   197                                  +caml_range 0, .n, $7F, "RETURN n: n"
   198                                  !set    caml_gen_RETURN = 1
   199                                  !set    caml_gen_GORETURN = 1
   200                            !if .n = 0 {
   201                                  TYA
   202                            } else {
   203                                  LDA # 2 * .n
   204                            }
   205                                  JMP RETURN
   206                          }
   207                          !macro  i29 {                                   ;RESTART
   208                                  !set    caml_gen_RESTART = 1
   209                                  !set    caml_restart_len = @end - *     ;needed by GRAB routine
   210                                  JSR RESTART
   211                          @end
   212                          }
   213                          !macro  i2a .n {                                ;GRAB n
   214                                  +caml_range 0, .n, $7C, "GRAB n: n"
   215                                  +Val_Int ~.v, .n
   216                                  !set    caml_gen_GRAB = 1
   217                                  !set    caml_gen_GORETURN = 1
   218                                  !set    caml_grab_len = @end - *        ;needed by GRAB routine
   219                                  LDA # .v
   220                                  JSR GRAB
   221                          @end
   222                          }
   223                          !macro  i2b .n, .ptr {                          ;CLOSURE n ptr
   224                                  +caml_range 0, .n, $7F, "CLOSURE n p: n"
   225                                  LDX # .n
   226                                  LDA # <.ptr
   227                                  LDY # >.ptr
   228                                  !set    caml_gen_CLOSURE = 1
   229                                  JSR CLOSURE
   230                          }
   231                          !macro  i2c .f, .v, .o, .t {                    ;CLOSUREREC f v o t
   232                                  +caml_range 1, .f, $80, "CLOSUREREC f v o t: f"
   233                                  +caml_range 0, .v, $FE, "CLOSUREREC f v o t: v"
   234                                  +caml_range 1, 2 * .f - 1 + .v, $FF, "CLOSUREREC f v o t: 2f-1+v"
   235                                  !set    caml_gen_CLOSREC = 1
   236                                  LDA # <.data
   237                                  LDY # >.data
   238                                  JSR CLOSREC
   239                                  JMP +
   240                                  !byte .v, .f
   241                          .data   !word .o, .t
   242                          +
   243                          }
