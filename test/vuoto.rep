   271                          !ifdef  caml_PRIM__caml_int64_shift_left {
   272                          caml_int64_shift_left
   273                                  +caml_int64_alloc
   274                                  LDA (SP),Y
   275                                  LSR
   276                                  AND # 63
   277                                  BNE +
   278                                  LDY # 9
   279                            !for @i, 1, 8 {
   280                                  LDA (ACCU),Y
   281                                  STA (BLK),Y
   282                                  DEY
   283                            }
   284                          --      LDA # > caml_int64_custom
   285                                  STA (BLK),Y
   286                                  DEY
   287                                  LDA # < caml_int64_custom
   288                                  STA (BLK),Y
   289                                  LDA BLK
   290                                  STA ACCU
   291                                  LDA BLK + 1
   292                                  STA ACCU + 1
   293                                  RTS
   294                          +       TAX
   295                          -       LDY # 2
   296                                  LDA (ACCU),Y
   297                                  ASL
   298                                  STA (BLK),Y
   299                            !for @i, 1, 7 {
   300                                  INY
   301                                  LDA (ACCU),Y
   302                                  ROL
   303                                  STA (BLK),Y
   304                            }
   305                                  DEX
   306                                  BNE -
   307                                  LDY # 1
   308                                  BNE --                          ;jmp
   309                          }
   310                          
   311                          !ifdef  caml_PRIM__caml_int64_shift_right {
   312                          caml_int64_shift_right
   313                                  +caml_int64_alloc
   314                                  LDA (SP),Y
   315                                  LSR
   316                                  AND # 63
   317                                  BNE +
   318                                  LDY # 9
   319                            !for @i, 1, 8 {
   320                                  LDA (ACCU),Y
   321                                  STA (BLK),Y
   322                                  DEY
   323                            }
   324                          --      LDA # > caml_int64_custom
   325                                  STA (BLK),Y
   326                                  DEY
   327                                  LDA # < caml_int64_custom
   328                                  STA (BLK),Y
   329                                  LDA BLK
   330                                  STA ACCU
   331                                  LDA BLK + 1
   332                                  STA ACCU + 1
   333                                  RTS
   334                          +       TAX
   335                          -       LDY # 9
   336                                  LDA (ACCU),Y
   337                                  CMP # $80
   338                                  ROR
   339                                  STA (BLK),Y
   340                            !for @i, 1, 7 {
   341                                  DEY
   342                                  LDA (ACCU),Y
   343                                  ROR
   344                                  STA (BLK),Y
   345                            }
   346                                  DEX
   347                                  BNE -
   348                                  LDY # 1
   349                                  BNE --                          ;jmp
   350                          }
