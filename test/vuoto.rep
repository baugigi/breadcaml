   425                            !ifdef caml_INTERP {
   426                                          JSR caml_interp_getarg
   427                            }                                     ;{A = v = 2n+1, Y = 0}
   428                                  EOR # $FF
   429                                  SEC
   430                                  ADC XARGS                               ;A := XARGS - v = ~A + 1 + XARGS
