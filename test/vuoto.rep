  2293                          
  2294                                  ;; "PAIRED OPCODES" DISAMBIGUATION.
  2295                                  ;; Two opcodes are paired iff their bits are equal but the msb.
  2296                                  ;; Paired opcodes share the same jumptable place (see at end);
  2297                                  ;; the fetch-exec routine sets C = msb of fetched opcode.
  2298                                  ;; N.b.: the routines placement guarantees that conditional
  2299                                  ;; branches targets stay in range [-128, +127]
  2300                          
  2301                          !set PUSH_ULTINT = *
  2302                          !ifdef caml_gen_PUSH_ULTINT {
  2303                            !ifdef caml_gen_PUSH {
  2304                              !ifdef caml_gen_ULTINT {
  2305                                          BCS +
  2306                                          JSR PUSH
  2307                                          +caml_NEXT
  2308                          +               JMP ULTINT
  2309                              } else {    JSR PUSH
  2310                                          +caml_NEXT }
  2311                            } else { !set PUSH_ULTINT = ULTINT }
  2312                          }
  2313                          
  2314                          PHACC5_STOP
