    19                          !ifdef caml_PRIM__caml_nonstd_mem_peek {
    20                          caml_nonstd_mem_peek
    21                                  ;; Sys.mem_peek lo hi returns the content of memory location at address
    22                                  ;; 256*hi+lo as an integer; lo, hi are taken modulo 256.
    23                                  LSR ACCU + 1
    24                                  ROR ACCU
    25                                  INY
    26                                  LDA (SP),Y
    27                                  LSR
    28                                  DEY
    29                                  LDA (SP),Y
    30                                  ROR
    31                                  STA ACCU + 1
    32                                  LDA (ACCU),Y
    33                                  SEC
    34                                  ROL
    35                                  STA ACCU
    36                                  STY ACCU + 1
    37                                  ROL ACCU + 1
    38                                  RTS
    39                          }
