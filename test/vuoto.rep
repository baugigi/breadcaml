    32                          !macro caml_int32_alloc {
    33                                  LDA # Custom_tag
    34                                  LDX # 3
    35                                  JSR caml_alloc
    36                          }
    37                          
    38                          !ifdef  caml_PRIM__caml_int32_custom {
    39                          !align $01, $00
    40                          caml_int32_custom
    41                                  !word @caml_int32_compare
    42                                  !word @caml_int32_hash
    43                          @caml_int32_compare
    44                                  STY TMP + 2
    45                                  LDA (SP),Y
    46                                  STA TMP
    47                                  INY
    48                                  LDA (SP),Y
    49                                  STA TMP + 1
    50                                  SEC
    51                                  LDX # 3
    52                          -       INY
    53                                  LDA (ACCU),Y
    54                                  SBC (TMP),Y
    55                                  ORA TMP + 2
    56                                  STA TMP + 2
    57                                  DEX
    58                                  BNE -
    59                                  INY
    60                                  LDA (ACCU),Y
    61                                  SBC (TMP),Y
    62                                  BVC +
    63                                  EOR # $80
    64                          +       BMI ++                          ;jump if <
    65                                  LDY # 0
    66                                  STY ACCU + 1
    67                                  ORA TMP + 2
    68                                  BNE +                           ;jump if >
    69                                  LDA # <Val_zero
    70                                  STA ACCU
    71                                  RTS
    72                          +       LDA # <Val_one
    73                                  STA ACCU
    74                                  RTS
    75                          ++      LDY # $FF
    76                                  STY ACCU
    77                                  STY ACCU + 1
    78                                  INY
    79                                  RTS
    80                          @caml_int32_hash
    81                                  LDY # 5
    82                                  LDA (ACCU),Y
    83                                  DEY
    84                                  EOR (ACCU),Y
    85                                  TAX
    86                                  DEY
    87                                  LDA (ACCU),Y
    88                                  DEY
    89                                  EOR (ACCU),Y
    90                                  SEC
    91                                  ROL
    92                                  STA ACCU
    93                                  TXA
    94                                  ROL
    95                                  STA ACCU + 1
    96                                  LDY # 0
    97                                  RTS
    98                          }
