     7                          ;; versione  2,  come specificato  nel  file  LICENZA-it nella  directory
     8                          ;; principale del progetto.
     9                          ;;
    10                          ;; This program is  free software; you can redistribute  it and/or modify
    11                          ;; it under the terms of the  GNU General Public License (GPL) version 2,
    12                          ;; as specified in the LICENSE-en file in the project root.
    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          
    15                          ;;; --------------------
    16                          ;;;        RANDOM
    17                          ;;; --------------------
    18                          
    19                          ;; X ABC Algorithm Pseudo-Random Number Generator for 8-Bit Devices.
    20                          ;; Quite fast, but not good for cryptographic/security purposes.
    21                          ;; From EternityForest, https://www.electro-tech-online.com/threads/
    22                          ;;      ultra-fast-pseudorandom-number-generator-for-8-bit.124249/
    23                          ;; With modifications by Stix:
    24                          ;;      https://www.stix.id.au/wiki/Fast_8-bit_pseudorandom_number_generator
    25                          ;; Stix's statistics about the cycles of this PRNG:
    26                          ;;     Length   Count   Seeds (a,b,c,x)
    27                          ;; 2826386176    1      00,00,00,00
    28                          ;;  653676288    1      10,00,00,00
    29                          ;;  630179072    1      11,00,00,00
    30                          ;;  136099072    1      2A,00,00,00
    31                          ;;   19772672    2      7B,00,00,00  41,02,00,00
    32                          ;;    3474944    2      5E,02,00,00  BC,04,00,00
    33                          ;;     647936    1      E2,34,00,00
    34                          ;;     401152    1      52,27,00,00
    35                          ;;     224512    1      3E,19,00,00
    36                          ;;     196864    1      2B,38,00,00
    37                          ;;     156160    2      70,27,00,00  03,83,01,00
    38                          ;;      90112    2      FE,3A,00,00  D1,CE,00,00
    39                          ;;      66048    2      1A,0B,01,00  EA,8D,01,00
    40                          ;;       9472    2      65,1D,06,00  53,7E,15,00
    41                          ;;       5376    2      E8,19,01,00  5D,9D,0C,00
    42                          ;;       2048    2      F0,D3,0D,00  7A,F9,54,00
    43                          ;;        512    4      4C,95,3A,00  CF,EC,55,00  97,F6,70,00  E6,26,D3,00
    44                          ;;        256    2      00,02,01,00  7A,9D,21,00
    45                          ;; ----------   --
    46                          ;; 4294967296   30
    47                          ;;
    48                          ;; Please note that those statistics are about 8-bit random numbers (returned in
    49                          ;; caml_nonstd_random_int__a); for BreadCaml purposes, I take a 15-bit OCaml
    50                          ;; integer from caml_nonstd_random_int__a (lo bits) and caml_nonstd_random_int__b
    51                          ;; (hi bits, discarding bit #7): this may affect the whole algorithm strength.
    52                          
    53                          !zone caml_RANDOM {
    54                          
    55                          !ifdef caml_PRIM__caml_nonstd_random_int {
    56                          caml_nonstd_random_int
    57                                  INC caml_nonstd_random_int__x
    58                          caml_nonstd_random_int__x = * + 1
    59                                  LDA # $00                               ;SMC: LDA __x
    60                                  EOR caml_nonstd_random_int__c
    61                          caml_nonstd_random_int__a = * + 1
    62                                  EOR # $00                               ;SMC: EOR __a
    63                                  STA caml_nonstd_random_int__a
    64                                  CLC
    65                          caml_nonstd_random_int__b = * + 1
    66                                  ADC # $00                               ;SMC: ADC __b
    67                                  STA caml_nonstd_random_int__b
    68                                  LSR
    69                                  BCC +                                   ;Stix's mod: LSR changed with
    70                                  ORA # $80                               ;8-bit right rotate
    71                          +       EOR caml_nonstd_random_int__a
    72                          caml_nonstd_random_int__c = * + 1
    73                                  ADC # $00                               ;SMC: ADC __c
    74                                  STA caml_nonstd_random_int__c
    75                                  LDA caml_nonstd_random_int__a           ;__a is the 8-bit random number
    76                                  ;; end of PRNG algo
    77                                  SEC
    78                                  ROL                                     ;Return a 15-bit OCaml integer
    79                                  STA ACCU                                ;from __a and __b, discarding
    80                                  LDA caml_nonstd_random_int__b           ;bit#7 of __b
    81                                  ROL
    82                                  STA ACCU + 1
    83                                  RTS
    84                          }
    85                          
    86                          !ifdef caml_PRIM__caml_nonstd_random_self_init {
    87                          caml_nonstd_random_self_init
    88                                  ;; ARG0 is (), returned as is
    89                                  LDA C64_TIME + 2                        ;Use the jiffy clock and the
    90                                  STA caml_nonstd_random_int__x           ;current raster line no. to
    91                                  EOR C64_VIC_RASTER                      ;generate a "random" seed
    92                                  STA caml_nonstd_random_int__a
    93                          -       ASL                                     ;"random" delay
    94                                  BNE -
    95                                  LDA caml_nonstd_random_int__x
    96                                  EOR C64_VIC_RASTER
    97                                  STA caml_nonstd_random_int__b
    98                          -       LSR                                     ;"random" delay
    99                                  BNE -
   100                                  LDA C64_VIC_RASTER
   101                                  STA caml_nonstd_random_int__c
   102                                  RTS
   103                          }
   104                          
   105                          !ifdef caml_PRIM__caml_nonstd_random_set_state {
   106                          caml_nonstd_random_set_state
   107                                  ;; ARG0 is a 4-char string "xabc"
   108                                  LDY #3
   109                                  LDA (ACCU),Y
   110                                  STA caml_nonstd_random_int__c
   111                                  DEY
   112                                  LDA (ACCU),Y
   113                                  STA caml_nonstd_random_int__b
   114                                  DEY
   115                                  LDA (ACCU),Y
   116                                  STA caml_nonstd_random_int__a
   117                                  DEY
   118                                  LDA (ACCU),Y
   119                                  STA caml_nonstd_random_int__x
   120                                  STY ACCU + 1
   121                                  LDA #<Val_unit
   122                                  STA ACCU
   123                                  RTS
   124                          }
   125                          
   126                          !ifdef caml_PRIM__caml_nonstd_random_get_state {
   127                          caml_nonstd_random_get_state
   128                                  ;; return a 4-char string "xabc"
   129                                  LDX # 3
   130                                  LDA # String_tag
   131                                  JSR caml_alloc
   132                                  LDY # 5
   133                                  LDA # 1                                 ;OCaml string padding \001
   134                                  STA (BLK),Y
   135                                  DEY
   136                                  LDA # 0                                 ;OCaml string padding \000
   137                                  STA (BLK),Y
   138                                  DEY
   139                                  LDA caml_nonstd_random_int__c
   140                                  STA (BLK),Y
   141                                  DEY
   142                                  LDA caml_nonstd_random_int__b
   143                                  STA (BLK),Y
   144                                  DEY
   145                                  LDA caml_nonstd_random_int__a
   146                                  STA (BLK),Y
   147                                  DEY
   148                                  LDA caml_nonstd_random_int__x
   149                                  STA (BLK),Y
   150                                  LDA BLK
   151                                  STA ACCU
   152                                  LDA BLK + 1
   153                                  STA ACCU + 1
   154                                  RTS
   155                          }
   156                          }       ;; !zone caml_RANDOM
   157                          

