   596                          
   597                          ;; Conversion from IEEE754 binary32 to C64FLP and vice-versa.
   598                          ;; See en.wikipedia.org/wiki/Single-precision_floating-point_format
   599                          ;; &   www.c64-wiki.com/wiki/Floating_point_arithmetic
   600                          ;;
   601                          ;; IEEE754:      |±¦e07_e01|e00¦m22_m16|m15_m08|m07_m00|
   602                          ;; little-endian |m07_m00|m15_m08|e00¦m22_m16|±¦e07_e01| Int32.t
   603                          ;; exponent representation: excess-127
   604                          ;;      exp = $01...$FE -> ± (2^(exp-127) * 1.mantissa)
   605                          ;;      exp = $FF -> special numbers: NaN, +infinity, -infinity
   606                          ;;      exp = $00, mantissa =  0 -> +0.0, -0.0
   607                          ;;      exp = $00, mantissa <> 0 ->  ± (2^(-126) * 0.mantissa)
   608                          ;; range:   ±1.17549435E-38 ... ±3.40282346E+38 (normal)
   609                          ;;          ±1.40129846E-45 ... ±1.17549421E-38 (subnormal)
   610                          ;; example: 1.0= |0¦0111111|1¦0000000|00000000|00000000|
   611                          ;; little-endian |00000000|00000000|1¦0000000|0¦0111111| Int32.t
   612                          ;;
   613                          ;; C64 (in RAM): |E07_E00|±¦M30_M24|M23_M16|M15_M08|M07_M00|
   614                          ;; C64 (in FAC): |E07_E00|1¦M30_M24|M23_M16|M15_M08|M07_M00|±///////|
   615                          ;; exponent representation: excess-128
   616                          ;;      exp = $01...$FF -> ± (2^(exp-128) * 0.1mantissa)
   617                          ;;      exp = $00 -> 0.0
   618                          ;; range:   ±2.93873588E-39 ... ±1.70141183E+38
   619                          ;; example: 1.0= |10000001|0¦0000000|00000000|00000000|00000000|  (RAM)
   620                          ;;          1.0= |10000001|1¦0000000|00000000|00000000|00000000|0|(FAC)
   621                          
   622                          !ifdef  caml_PRIM__caml_int32_bits_of_float {
   623                          caml_int32_bits_of_float
   624                                  +caml_int32_alloc
   625                                  LDA ACCU
   626                                  STA caml_float_loadFAC__addr
   627                                  LDA ACCU + 1
   628                                  STA caml_float_loadFAC__addr + 1
   629                                  JSR caml_float_loadFAC
   630                                  LDY # 5                         ; (BLK),Y points to int32 last byte
   631                                  LDX C64_FAC                     ; load c64 exponent
   632                                  BEQ @exp0                       ; switch
   633                                  DEX
   634                                  BEQ @exp1
   635                                  DEX
   636                                  BEQ @exp2
   637                                  ;; c64 exponent > 2:
   638                                  ;; ieee_exp = c64_exp - 2, ieee_mant = asl c64_mant (drop leftmost 1)
   639                                  ;; normal representation - rounding may increment exponent by one
   640                                  CLC                             ;flag: .C=1 if called from @exp2
   641                          @round  BIT C64_FAC + 4                 ;round mantissa
   642                                  BPL +
   643                                  INC C64_FAC + 3
   644                                  BNE +
   645                                  INC C64_FAC + 2
   646                                  BNE +
   647                                  INC C64_FAC + 1
   648                                  BNE +
   649                                  INX                             ;increment exponent if needed
   650                          +       BCS @exp2r                      ;return if called from @exp2
   651                                  ASL C64_FAC + 1                 ;remove leftmost 1 from mantissa
   652                                  ASL C64_FAC + 5                 ;.C := sign bit
   653                                  TXA                             ;.A := exponent |e07_e00|
   654                                  ROR                             ;.A := |±¦e07_e01|, .C := e00
   655                                  STA (BLK),Y                     ;store |±¦e07_e01|
   656                                  LDA C64_FAC + 1                 ;.A := |m22_m16¦0|
   657                                  ROR                             ;.A := |e00¦m22_m16|
   658                                  DEY
   659                                  STA (BLK),Y                     ;store |e00¦m22_m16|
   660                                  LDA C64_FAC + 2                 ;.A := |m15_m08|
   661                                  DEY
   662                                  STA (BLK),Y                     ;store |m15_m08|
   663                                  LDA C64_FAC + 3                 ;.A := |m07_m00|
   664                          @end    DEY
   665                                  STA (BLK),Y                     ;store |m07_m00|
   666                                  LDY # 0
   667                                  LDA BLK
   668                                  STA ACCU
   669                                  LDA BLK + 1
   670                                  STA ACCU + 1
   671                                  ;ACCU := int32
   672                                  RTS                             ;return
   673                                  ;; c64_exp = 0: ieee_exp = 0, ieee_mant = 0
   674                          @exp0   TXA                             ;.A := 0
   675                                  STA (BLK),Y                     ;store zero into all bytes
   676                                  DEY
   677                                  STA (BLK),Y
   678                                  DEY
   679                                  STA (BLK),Y
   680                                  JMP @end                        ;...continue
   681                                  ;; c64_exp = 1: ieee_exp = 0, ieee_mant = lsr c64_mant (subnormal)
   682                                  ;; rounding doesn't affect exponent, as mantissa is 0.0mmm...
   683                          @exp1   LSR C64_FAC + 1                 ;lsr mantissa
   684                                  ROR C64_FAC + 2
   685                                  ROR C64_FAC + 3
   686                                  ROR C64_FAC + 4                 ;fallthrough @exp2
   687                                  ;; c64_exp = 2: ieee_exp = 0, ieee_mant = c64_mant (subnormal)
   688                                  ;; rounding may incr. exponent and cause a switch from
   689                                  ;; subnormal repr. (2^(-126) * 0.mantissa, 0 implicit)
   690                                  ;; to normal one (2^(-126) * 1.rnd_mantissa, 1 implicit)
   691                          @exp2   SEC                             ;use .C as a return flag
   692                                  BCS @round                      ;round mantissa
   693                          @exp2r  TXA                             ;.A := exponent |e07_e00|
   694                                  ASL C64_FAC + 5                 ;.C := sign bit
   695                                  ROR                             ;.A := |±¦e07_e01|, .C := e00
   696                                  STA (BLK),Y                     ;store |±¦e07_e01|
   697                                  LDA C64_FAC + 1
   698                                  ROR
   699                                  DEY
   700                                  STA (BLK),Y                     ;store |e00¦m22_m16|
   701                                  LDA C64_FAC + 2
   702                                  ROR
   703                                  DEY
   704                                  STA (BLK),Y                     ;store |m15_m08|
   705                                  LDA C64_FAC + 3
   706                                  ROR
   707                                  JMP @end                        ;...continue
   708                          }
   709                          
   710                          !ifdef  caml_PRIM__caml_int32_float_of_bits {
   711                          caml_int32_float_of_bits
   712                                  LDY # 4
   713                                  LDA (ACCU),Y                    ;.A <- e00¦m22_m16
   714                                  CMP # $80                       ;.C <- e00
   715                                  ORA # $80                       ;.A <- 1¦m22_m16
   716                                  STA C64_FAC + 1                 ;store into FAC
   717                                  INY
   718                                  LDA (ACCU),Y                    ;.A <- sign¦e07_e01
   719                                  ROL                             ;.C <- sign, .A <- e07_e00
   720                                  ROR C64_FAC + 5                 ;put sign into FAC sign byte
   721                                  CMP # $FE                       ;raise exn if NaN, +-infinity, or
   722                                  BCS @exn                        ;if conversion would overflow
   723                                  TAX                             ;.X <- exp
   724                                  LDY # 3
   725                                  LDA (ACCU),Y                    ;.A <- m15_m08
   726                                  STA C64_FAC + 2                 ;store into FAC
   727                                  DEY
   728                                  LDA (ACCU),Y                    ;.A <- m07_m00
   729                                  STA C64_FAC + 3                 ;store into FAC
   730                                  LDY # 0
   731                                  STY C64_FAC + 4                 ;clear FAC unused mantissa bits
   732                                  STY C64_FACRND                  ;and FAC round byte
   733                                  CPX # 1
   734                                  BCC @zero                       ;jump if +0.0, -0.0 or subnormal
   735                                  INX
   736                                  INX                             ;adjust exp bias
   737                          -       STX C64_FAC                     ;set FAC exp
   738                                  JMP caml_float_alloc_result     ;allocate float and return
   739                          @zero   LDA C64_FAC + 3                 ;check if +0.0 or -0.0
   740                                  BNE @subnrm                     ;jump if subnormal
   741                                  LDA C64_FAC + 2
   742                                  BNE @subnrm                     ;jump if subnormal
   743                                  LDA C64_FAC + 1
   744                                  AND # $7F                       ;ignore leftmost bit of mantissa (1)
   745                                  BNE @subnrm                     ;jump if subnormal
   746                                  STA C64_FAC + 1
   747                                  STA C64_FAC + 5                 ;clear minus sign, if any
   748                                  BEQ -                           ;set FAC exp, allocate float and return
   749                          @subnrm LDX # 2                         ;subnormal: set biased exp = -126
   750                                  STX C64_FAC
   751                          -       ASL C64_FAC + 3                 ;try to normalize (FAC+4 ignored as null)
   752                                  ROL C64_FAC + 2
   753                                  ROL C64_FAC + 1
   754                                  BMI +                           ;ok, leftmost bit is 1
   755                                  DEC C64_FAC
   756                                  BNE -
   757                                  LDY # 0                         ;ko, result is zero
   758                                  STY C64_FAC + 5                 ;clear minus sign, if any
   759                          +       JMP caml_float_alloc_result     ;allocate float and return
   760                          @exn    +caml_raise Invalid_argument, "Int32.float_of_bits"
   761                          }
