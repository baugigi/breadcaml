   343                          !macro  i44     {+i47 1}
   344                          !macro  i45     {+i47 2}
   345                          !macro  i46     {+i47 3}
   346                          !macro  i48 .n {                                ;GETFLOATFIELD n
   347                                  +caml_range 0, .n, $FF div Double_wosize, "GETFLOATFIELD n: n"
   348                                  .n2l = <(2 * .n * Double_wosize)
   349                                  .n2h = >(2 * .n * Double_wosize)
   350                                  !set    caml_gen_GETFFLD0 = 1
   351                            !if .n2h > 0 {
   352                                  INC ACCU + 1
   353                            }
   354                            !if .n2l > 0 {
   355                                  !set    caml_gen_GETFFLDN = 1
   356                                  LDA # .n2l
   357                                  JSR GETFFLDN
   358                            } else {
