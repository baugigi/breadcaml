  2480                                          ;; fallthrough BLTLEINT
  2481                              } else { !set ACC6_BLEINT = ACC07 }
  2482                            } else { !set ACC6_BLEINT = BLTLEINT }
  2483                          }
  2484                          BLTLEINT
  2485                          !ifdef caml_gen_BLTLEINT {
  2486                                          JSR caml_interp_getarg
  2487                                          TAX
  2488                                          JSR caml_interp_getarg
  2489                                          TAY
  2490                                          TXA
  2491                                          JSR SGNCMP
  2492                                          BMI BRANCH
  2493                                          CLC:BCC caml_interp_skip2or3by
  2494                          }
  2495                                          ;; BRANCH, START, FETCH ARG, SKIP ARG.
  2496                          
  2497                          BRANCH                                          ;Branch to *PC
  2498                                          LDA (PC),Y
  2499                                          TAX
  2500                                          INC PC
  2501                                          BNE +
  2502                                          INC PC + 1
  2503                          +               LDA (PC),Y
  2504                                          ;; fallthrough caml_interp_start
  2505                          caml_interp_start                               ;ENTRYPOINT: start interpreter
  2506                                          STX PC
  2507                                          STA PC + 1
  2508                                          JMP caml_interp_fetch
  2509                          
  2510                          caml_interp_skip2or3by                          ;Skip next 2 + Carry bytes
  2511                                          LDA # 2
  2512                                          ADC PC
  2513                                          STA PC
  2514                                          BCC +
  2515                                          INC PC + 1
  2516                          +               JMP caml_interp_fetch
  2517                          
  2518                          caml_interp_getarg                              ;Fetch a 1-byte argument
  2519                                          LDA (PC),Y
  2520                                          INC PC
  2521                                          BNE +
  2522                                          INC PC + 1
  2523                          +               RTS
  2524                          
  2525                                          ;; OPCODES JUMPTABLE.
  2526                                          ;; The table is page-aligned. The fetch-exec routine sets C=bit7
  2527                                          ;; of fetched opcode, then accesses the table using 2*opcode as
  2528                                          ;; an index.  
  2529                          
  2530                                          !align  $FF, $00
  2531                          caml_interp_jmptbl
  2532                                          ;; $00...$0f/$80...$8f  (unused opcodes: $0a, $82, $8d, $8e)
  2533                                          !wo ACC0_OFSREF, ACC1_ISINT, ACC07, ACC3_BEQ, ACC4_BNEQ
  2534                                          !wo ACC5_BLTINT, ACC6_BLEINT, ACC7_BGTINT, ACC_BGEINT
  2535                                          !wo PUSH_ULTINT, UGEINT, PHACC1_BULTINT, PHACC2_BUGEINT 
  2536                                          !wo PHACC17, PHACC17, PHACC5_STOP
  2537                                          ;; $10...$1f/$90...$94  (unused opcodes: $90...$94)
  2538                                          !wo PHACC17, PHACC17, PHACC, POPN, ASSIGNH, ENVACC14, ENVACC14
  2539                                          !wo ENVACC14, ENVACC14, ENVACCN, PHENVACC14, PHENVACC14
  2540                                          !wo PHENVACC14, PHENVACC14, PHENVACC, PHRET
  2541                                          ;; $20...$2f
  2542                                          !wo APPLYN, APPLY13, APPLY13, APPLY13, APPTRMN, APPTRM13
  2543                                          !wo APPTRM13, APPTRM13, RETURN, RESTART, GRAB, CLOSURE, CLOSREC
  2544                                          !wo OFSCLM2, OFSCL0, OFSCL2
  2545                                          ;; $30...$3f            (unused opcodes: $3b, $3d)
  2546                                          !wo OFSCLN, PHOFSCLM2, PHOFSCL0, PHOFSCL2, PHOFSCLN, GETGLB
  2547                                          !wo PHGETGLB, GETGLBFLD, PHGETGLBFLD, SETGLB, ATOM0, $ffff
  2548                                          !wo PHATOM0, $ffff, MKBLKN, MKBLK13
  2549                                          ;; $40...$4f
  2550                                          !wo MKBLK13, MKBLK13, MKFBLK, GETFLD0, GETFLD13, GETFLD13
  2551                                          !wo GETFLD13, GETFLDN, GETFFLDN, SETFLD0, SETFLD13, SETFLD13
  2552                                          !wo SETFLD13, SETFLDN, SETFFLDN, VECLEN
  2553                                          ;; $50...$5f            (unused opcode: $5c)
  2554                                          !wo GETVEC, SETVEC, GETCHR, SETCHR, BRANCH, BIF, BIFNOT, SWITCH
  2555                                          !wo BOOLNOT, PHTRP, POPTRP, RAISE, $ffff, CCALL, CCALL, CCALL
  2556                                          ;; $60...$6f
  2557                                          !wo CCALL, CCALL, CCALL, CST03, CST03, CST03, CST03, CSTN
  2558                                          !wo PHCST03, PHCST03, PHCST03, PHCST03, PHCSTN, NEGINT, ADDINT
  2559                                          !wo SUBINT
  2560                                          ;; $70...$7f
  2561                                          !wo MULINT, DIVINT, MODINT, ANDINT, ORINT, XORINT, LSLINT
  2562                                          !wo LSRINT, ASRINT, EQ, NEQ, LTINT, LEINT, GTINT, GEINT, OFSINT
  2563                          
