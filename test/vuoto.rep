    15                          ;;; -----------------------------------------------------------
    16                          :;; ALLOC DUMMY (ocaml-4.04.1/byterun/alloc.c)
    17                          ;;; -----------------------------------------------------------
    18                          
    19                          !zone caml_DUMMY {
    20                          
    21                          !ifdef caml_PRIM__caml_alloc_dummy_function {
    22                          caml_alloc_dummy_function = caml_alloc_dummy
    23                          }
    24                          !ifdef caml_PRIM__caml_alloc_dummy {
    25                                  ;; allocate a dummy block for a recursive value (or function)
    26                                  ;; ACCU = size, (SP[0] = function arity, ignored)
    27                          caml_alloc_dummy
    28                                  LSR ACCU + 1
    29                                  LDA ACCU
    30                                  ROR
    31                                  BEQ +                           ; size = 0
    32                                  ;; allocate block
    33                                  TAX
    34                                  TYA
    35                                  JSR caml_alloc
    36                                  LDA BLK
    37                                  STA ACCU
    38                                  LDA BLK + 1
    39                                  STA ACCU + 1
    40                                  RTS
    41                                  ;; Atom(0)
    42                          +       LDA # < caml_atom0
    43                                  STA ACCU
    44                                  LDA # > caml_atom0
    45                                  STA ACCU + 1
    46                                  RTS
    47                          }
    48                          
    49                          !ifdef caml_PRIM__caml_alloc_dummy_float {
    50                                  ;; allocate a dummy block for a recursive array/record of floats
    51                                  ;; ACCU = no. of floats
    52                          caml_alloc_dummy_float
    53                                  ;; ignore ACCU + 1, as 0 <= no. of floats <= 85
    54                                  LDA ACCU
    55                                  LSR
    56                                  BEQ +                           ; Atom(0)
    57                                  ;; X <- no. of floats * Double_wosize
    58                                  CLC
    59                                  ADC ACCU
    60                                  TAX
    61                                  DEX
    62                                  ;; allocate block
    63                                  TYA                             ; A = Y = 0
    64                                  JSR caml_alloc
    65                                  LDA BLK
    66                                  STA ACCU
    67                                  LDA BLK + 1
    68                                  STA ACCU + 1
    69                                  RTS
    70                                  ;; Atom(0)
    71                          +       LDA # < caml_atom0
    72                                  STA ACCU
    73                                  LDA # > caml_atom0
    74                                  STA ACCU + 1
    75                                  RTS
    76                          }
    77                          
    78                          !ifdef caml_PRIM__caml_update_dummy {
    79                                  ;; update a dummy block with given value
    80                                  ;; ACCU = dummy, SP[0] = newval
    81                          caml_update_dummy
    82                                  ;; load newval size
    83                                  LDA (SP),Y
    84                                  STA TMP
    85                                  INY
    86                                  LDA (SP),Y
    87                                  STA TMP + 1
    88                                  LDY # -1
    89                                  DEC TMP + 1
    90                                  LDA (TMP),y
    91                                  BNE +
    92                                  ;; size = 0, update nothing
    93                                  INY                             ; Y = 0
    94                                  BEQ ++
    95                                  ;; tag(dummy) <- tag(newval)
    96                          +       TAX                             ; save size
    97                                  DEY
    98                                  DEC ACCU + 1
    99                                  LDA (TMP),y
   100                                  STA (ACCU),y
   101                                  INC ACCU + 1
   102                                  INC TMP + 1
   103                                  ;; copy newval fields into dummy ones
   104                                  TXA                             ; reload size
   105                                  ASL
   106                                  TAY                             ; Y = 2 * size, Carry = MSB
   107                                  JSR caml_blkcpy
   108                                  ;; ACCU <- ()
   109                          ++      STY ACCU + 1                    ; Y = 0
   110                                  LDA # <Val_unit
   111                                  STA ACCU
   112                                  RTS
   113                          }
   114                          
   115                          }       ;; !zone caml_DUMMY
   116                          

