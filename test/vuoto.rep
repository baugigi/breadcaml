   830                                  STA (BLK),Y
   831                                  INY
   832                                  LDA (SP),Y
   833                                  STA (BLK),Y
   834                                  INY
   835                                  BNE +
   836                                  INC SP + 1
   837                                  INC BLK + 1
   838                          +       DEX                                     ;to newblock's fields
   839                                  BNE -   
