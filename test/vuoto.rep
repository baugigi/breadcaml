; ******** Source: /home/pifu/.opam/LTS/lib/bcamlc/stdlib_strings.asm
     1                          ;; ——————————————————————————————————————————————————————————————————————
     2                          ;; Progetto BreadCaml / The BreadCaml Project
     3                          ;; Copyright (C) 21-Apr-2026 Piero Furiesi
     4                          ;;
     5                          ;; Questo  programma è  software libero;  è possibile  ridistribuirlo e/o
     6                          ;; modificarlo secondo i  termini della GNU General  Public License (GPL)
     7                          ;; versione  2,  come specificato  nel  file  LICENZA-it nella  directory
     8                          ;; principale del progetto.
     9                          ;;
    10                          ;; This program is  free software; you can redistribute  it and/or modify
    11                          ;; it under the terms of the  GNU General Public License (GPL) version 2,
    12                          ;; as specified in the LICENSE-en file in the project root.
    13                          ;; ——————————————————————————————————————————————————————————————————————
    14                          
    15                          ;;; ---------------------------------------------------------------------------
    16                          ;;; STRINGS
    17                          ;;; ---------------------------------------------------------------------------
    18                          
    19                          !zone caml_STRINGS {
    20                          
    21                          !ifdef caml_PRIM__caml_string_of_bytes {
    22                          caml_string_of_bytes = caml_bytes_of_string
    23                          }
    24                          !ifdef caml_PRIM__caml_bytes_of_string {
    25                          caml_bytes_of_string
    26                                  RTS
    27                          }
    28                          
    29                          !ifdef caml_PRIM__caml_create_bytes {
    30                          caml_create_bytes = caml_create_string
    31                          }
    32                          !ifdef caml_PRIM__caml_create_string {
    33                          caml_create_string
    34                                  ;; ACCU = length
    35                                  ;; alloc a new block for a string of given length (max 509)
    36                          
    37                                  LDA ACCU + 1                            ;load >length
    38                                  LSR                                     ;
    39                                  ROR ACCU                                ;ACCUl,A := Int_val(lenght)
    40                                  LSR
    41                                  BNE +++                                 ;A>0 => len > max, raise exn.
    42                                  ROR ACCU                                ;ACCUl :=  Int_val(lenght) / 2
    43                                  PHP                                     ;save carry (remainder)
    44                                  LDX ACCU                                ;X := block size, in words
    45                                  INX                                     ;take into account Ocaml padding
    46                                  BEQ ++                                  ;Exception if size > 255
    47                                  LDA # String_tag                        ;load tag
    48                                  JSR caml_alloc                          ;allocate block
    49                                  LDA BLK
    50                                  STA ACCU
    51                                  LDA BLK + 1
    52                                  STA ACCU + 1                            ;ACCU := address of new block
    53                                  DEX                                     ;Compute the padding bytes:
    54                                  TXA                                     ;A := size - 1
    55                                  ASL                                     ;A := 2 * size - 2
    56                                  BCC +
    57                                  INC BLK + 1
    58                          +       TAY                                     ;BLK+.Y = address of last word
    59                                  LDA # 0
    60                                  PLP                                     ;reload .C flag
    61                                  BCS +                                   ;string length is odd?
    62                                  STA (BLK),Y                             ;no: padding = "\000\001"
    63                                  LDA # 1
    64                          +       INY                                     ;yes: padding = "\000"
    65                                  STA (BLK),Y
    66                                  LDY # 0
    67                                  RTS
    68                          ++      PLP
    69                          +++     +caml_raise Invalid_argument, "String.create"
    70                          }
    71                          
    72                          !ifdef caml_PRIM__caml_ml_bytes_length {
    73                          caml_ml_bytes_length = caml_ml_string_length
    74                          }
    75                          !ifdef caml_PRIM__caml_ml_string_length {
    76                          caml_ml_string_length
    77                                  ;; ACCU = string
    78                                  ;; return the string length (0 to 509)
    79                          
    80                                  JSR caml_string_length_yx               ;TMP, TMP + 1 := len
    81                                  TYA
    82                                  SEC
    83                                  ROL
    84                                  STA ACCU
    85                                  TXA
    86                                  ROL
    87                                  STA ACCU + 1                            ;ACCU := Val_int(len)
    88                                  LDY # 0
    89                                  RTS
    90                          }
    91                          
    92                          !ifdef caml_PRIM__caml_bytes_get {
    93                          caml_bytes_get = caml_string_get
    94                          }
    95                          !ifdef caml_PRIM__caml_string_get {
    96                          caml_string_get
    97                                  ;; ACCU=string, SP[0]=index
    98                                  ;; return string[index]
    99                          
   100                                  JSR caml_string_index_y
   101                                  LDA (ACCU),Y                            ;get char
   102                                  SEC
   103                                  ROL
   104                                  STA ACCU
   105                                  LDA # 0
   106                                  TAY                                     ;.Y := 0
   107                                  ROL
   108                                  STA ACCU + 1                            ;ACCU := Val_char(char)
   109                                  RTS
   110                          }
   111                          
   112                          !ifdef caml_PRIM__caml_bytes_set {
   113                          caml_bytes_set = caml_string_set
   114                          }
   115                          !ifdef caml_PRIM__caml_string_set {
   116                          caml_string_set
   117                                  ;; ACCU=string, SP[0]=index, SP[1]=newval
   118                                  ;; string.[index]<-newval; return: ()
   119                          ;       TMP                                     ; used by caml_string_index_y
   120                          ;       TMP + 1                                 ; used by caml_string_index_y
   121                          @CHAR   = TMP + 2
   122                                  LDY # 3
   123                                  LDA (SP),Y                              ; get newval, hi
   124                                  DEY
   125                                  LSR
   126                                  LDA (SP),Y                              ; get newval, lo
   127                                  ROR
   128                                  STA @CHAR                               ; save char_val(newval)
   129                                  JSR caml_string_index_y                 ; Y := index
   130                                  LDA @CHAR
   131                                  STA (ACCU),Y                            ; modify string in place
   132                                  LDY # <Val_unit
   133                                  STY ACCU
   134                                  DEY
   135                                  STY ACCU + 1                            ; return ()
   136                                  RTS
   137                          }
   138                          
   139                          !ifdef caml_PRIM__caml_fill_bytes {
   140                          caml_fill_bytes = caml_fill_string
   141                          }
   142                          !ifdef caml_PRIM__caml_fill_string {
   143                          caml_fill_string
   144                                  ;; ACCU = string, SP[0]=ofs, SP[1]=num, SP[2]=char
   145                                  ;; for num times, string.[i]<-char starting from i=ofs; return: ()
   146                                  ;; (unsafe, args are checked in Bytes module)
   147                          
   148                                  ;; TMP + 1 <- int_val(num)
   149                                  LDY # 3
   150                                  LDA (SP),Y
   151                                  LSR
   152                                  STA TMP + 1
   153                                  DEY
   154                                  LDA (SP),Y
   155                                  ROR
   156                                  BNE +
   157                                  CMP TMP + 1
   158                                  BEQ ++                          ;num = 0, nothing to do
   159                          +       STA TMP
   160                                  ;; ACCU <- ACCU + int_val(pos)
   161                                  DEY
   162                                  LDA (SP),Y
   163                                  LSR
   164                                  TAX
   165                                  DEY
   166                                  LDA (SP),Y
   167                                  ROR
   168                                  CLC
   169                                  ADC ACCU
   170                                  STA ACCU
   171                                  TXA
   172                                  ADC ACCU + 1
   173                                  STA ACCU + 1
   174                                  ;; A <- int_val(char)
   175                                  LDY # 5
   176                                  LDA (SP),Y
   177                                  LSR
   178                                  DEY
   179                                  LDA (SP),Y
   180                                  ROR
   181                                  ;; start substitution
   182                                  LDY # 0
   183                                  LDX TMP
   184                          --      STA (ACCU),Y                            ;modify string in place
   185                                  DEX
   186                                  BEQ +
   187                          -       INY
   188                                  BNE --
   189                                  INC ACCU + 1
   190                                  JMP --
   191                          +       CPX TMP + 1
   192                                  BEQ ++
   193                                  DEC TMP + 1
   194                                  JMP -
   195                          ++      LDY # <Val_unit
   196                                  STY ACCU
   197                                  DEY
   198                                  STY ACCU + 1                            ;return ()
   199                                  RTS
   200                          }
   201                          
   202                          !ifdef caml_PRIM__caml_blit_bytes {
   203                          caml_blit_bytes = caml_blit_string
   204                          }
   205                          !ifdef caml_PRIM__caml_blit_string {
   206                          caml_blit_string
   207                                  ;; ACCU=src, SP[0]=sofs SP[1]=dst, SP[2]=dofs, SP[3]=len
   208                                  ;; copies len consecutive bytes, starting from src.[sofs], to dst.[dofs]
   209                                  ;; source and destination intervals may overlap.
   210                                  ;; (unsafe, args are checked in Bytes module)
   211                          @FROM   = TMP
   212                          @TO     = TMP + 2
   213                          @SIZE   = TMP + 4
   214                                  LDY # 7
   215                                  LDA (SP),Y                              ; >len
   216                                  LSR
   217                                  STA @SIZE + 1                           ; SIZE + 1 := >int_val(len)
   218                                  DEY
   219                                  LDA (SP),Y                              ; <len
   220                                  ROR
   221                                  STA @SIZE                               ; SIZE := <int_val(len)
   222                                  DEY
   223                                  LDA (SP),Y                              ; >dofs
   224                                  LSR
   225                                  STA @TO + 1                             ; TO := >int_val(dofs)
   226                                  DEY
   227                                  LDA (SP),Y                              ; <dofs
   228                                  ROR
   229                                  STA @TO                                 ; TO := <int_val(dofs)
   230                                  DEY
   231                                  LDA (SP),Y                              ; >dst
   232                                  TAX
   233                                  DEY
   234                                  LDA (SP),Y                              ; <dst
   235                                  CLC
   236                                  ADC @TO
   237                                  STA @TO                                 ; TO := <(dst + int_val(dofs))
   238                                  TXA
   239                                  ADC @TO + 1
   240                                  STA @TO + 1                             ; TO + 1:= >(dst+int_val(dofs))
   241                                  DEY
   242                                  LDA (SP),Y                              ; >sofs
   243                                  LSR
   244                                  TAX
   245                                  DEY
   246                                  LDA (SP),Y                              ; <soft
   247                                  ROR
   248                                  CLC
   249                                  ADC ACCU
   250                                  STA @FROM                               ; FROM := <(src + int_val(sofs))
   251                                  TAY
   252                                  TXA
   253                                  ADC ACCU + 1
   254                                  STA @FROM + 1                           ; FROM+1 := >(src+int_val(sofs))
   255                                  JSR caml_memcpy                         ; ok, even if src & dest overlap
   256                                  LDY # <Val_unit
   257                                  STY ACCU
   258                                  DEY
   259                                  STY ACCU + 1
   260                                  RTS
   261                          }
   262                          
   263                          !ifdef caml_PRIM__caml_nonstd_string_of_float {
   264                          caml_nonstd_string_of_float
   265                                  ;; Stdlib.string_of_float
   266                                  LDA ACCU
   267                                  LDX ACCU + 1
   268                                  STA caml_float_loadFAC__addr
   269                                  STX caml_float_loadFAC__addr + 1
   270                                  JSR caml_float_loadFAC
   271                                  LDA $47                                 ;WARNING: FOUT OVERWRITES $47
   272                                  PHA                                     ;save it
   273                                  +caml_JSR_BASROM C64_FOUT               ;0-terminated string in $0100
   274                                  PLA                                     ;restore $47 value
   275                                  STA $47
   276                                  LDX # $FF
   277                          -       INX                                     ;count string length (except 0)
   278                                  LDA $0100,X
   279                                  BNE -                                   ;(X = length when loop ends)
   280                                  LDA # 1                                 ;add a final 1 for padding; it
   281                                  STA $0101,X                             ;won't be copied if len is odd
   282                                  TXA                                     ;A := length
   283                                  LSR
   284                                  TAX                                     ;X := length / 2
   285                                  INX                                     ;X := length/2+1=blk size (wo.)
   286                                  LDA # String_tag
   287                                  LDY # 0
   288                                  JSR caml_alloc                          ;allocate the new block
   289                                  LDA BLK
   290                                  STA ACCU
   291                                  LDA BLK + 1
   292                                  STA ACCU + 1                            ;ACCU := new string
   293                                  TXA
   294                                  ASL
   295                                  TAY                                     ;Y := 2 * size
   296                                  DEY
   297                          -       LDA $0100,Y                             ;copy string and 0/01 padding
   298                                  STA (BLK),Y                             ;to the new block
   299                                  DEY
   300                                  BNE -
   301                                  LDA $0100
   302                                  STA (BLK),Y
   303                                  RTS
   304                          }
   305                          
   306                          !ifdef caml_PRIM__caml_nonstd_string_of_int {
   307                          caml_nonstd_string_of_int
   308                                  ;; Stdlib.string_of_int
   309                                  ;; Convert an int to string, using the C64 format: first char for sign
   310                                  ;; (space if positive, minus if negative), followed by 5 digit max and
   311                                  ;; no non-significative zeroes.
   312                          @DGT    = TMP
   313                          @SKIPZ  = TMP + 1
   314                                  LDA # String_tag                        ;Max len is 4 words:
   315                                  LDX # 4                                 ;|'-','1'|'6','3'|'8','3'|\0,\1|
   316                                  JSR caml_alloc                          ;Allocate string, addr in BLK
   317                                  LDA # ' '                               ;Positive numbers start with ' '
   318                                  BIT ACCU + 1
   319                                  BPL +
   320                                  SEC                                     ;If value is negative,
   321                                  LDA # 2                                 ; negate it
   322                                  SBC ACCU
   323                                  STA ACCU
   324                                  TYA
   325                                  SBC ACCU + 1
   326                                  STA ACCU + 1
   327                                  LDA # '-'                               ; and put a '-' into the string
   328                          +       STA (BLK),Y
   329                                  INY
   330                                  LSR ACCU + 1                            ;Get rid of trailing 1
   331                                  ROR ACCU
   332                                  LDA # '0'                               ;Set SKIPZ flag to '0' (=ignore
   333                                  STA @SKIPZ                              ; all initial zeroes)
   334                                  LDX # 3                                 ;For X := 3 downto 0
   335                          --      STA @DGT                                ; Init DGT to '0'
   336                                  LDA ACCU                                ; Loop for calculating DGT:
   337                                  SEC
   338                          -       SBC @lo10,X                             ;  Subtract 10^(X+1) from ACCU
   339                                  PHA
   340                                  LDA ACCU + 1
   341                                  SBC @hi10,X
   342                                  BCC +                                   ; Exit loop on negative result
   343                                  STA ACCU + 1                            ;  Store result in ACCU
   344                                  PLA
   345                                  STA ACCU
   346                                  INC @DGT                                ;  Set DGT to next char digit
   347                                  BCS -                                   ; BCS=JMP, Continue loop
   348                          +       PLA
   349                                  LDA @DGT
   350                                  CMP @SKIPZ                              ; If DGT='0' & SKIPZ='0'
   351                                  BEQ +                                   ; then ignore current digit
   352                                  DEC @SKIPZ                              ; else stop skipping zeroes,
   353                                  STA (BLK),Y                             ;  put DGT into the string,
   354                                  INY
   355                                  LDA # '0'                               ;  set A='0' for next iteration.
   356                          +       DEX                                     ; Decrement counter
   357                                  BPL --                                  ;End_For
   358                                  ORA ACCU                                ;A := '0'|ACCU  (last digit)
   359                                  STA (BLK),Y
   360                                  INY
   361                                  LDA # 0                                 ;Pad string with \0
   362                                  STA (BLK),Y
   363                                  INY
   364                                  TYA
   365                                  LSR                                     ;Compute block size (in wo.)
   366                                  TAX
   367                                  BCC +
   368                                  LDA # 1                                 ;Add \1 pad if necessary
   369                                  STA (BLK),Y
   370                                  INX                                     ;size +1 for \0\1
   371                          +       LDA BLK
   372                                  STA ACCU
   373                                  LDA BLK + 1
   374                                  STA ACCU + 1
   375                                  LDY # 0
   376                                  JSR caml_shrink_latest_alloc            ;Shrink block to computed size
   377                                  RTS
   378                          @lo10   !byte <10, <100, <1000, <10000
   379                          @hi10   !byte >10, >100, >1000, >10000
   380                          }
   381                          
   382                                  ;;
   383                                  ;; AUX
   384                                  ;;
   385                          
   386                          !ifdef caml_PRIM__caml_string_index_y {
   387                          caml_string_index_y
   388                                  ;; given a string in ACCU, read index from SP[0], then
   389                                  ;; set Y and ACCU+1 so that ACCU+Y = &string[index];
   390                                  ;; raise Invalid_argument if not 0<=index<length(string).
   391                                  LDY # 1
   392                                  LDA (SP),Y                              ;get ARGh
   393                                  LSR                                     ;Int_val(ARGh)
   394                                  STA TMP + 1                             ;save
   395                                  DEY
   396                                  LDA (SP),Y                              ;get ARGl
   397                                  ROR                                     ;Int_val(ARGl)
   398                                  STA TMP                                 ;save
   399                                  JSR caml_string_length_yx               ;get string length in .Y.X
   400                                  CPX TMP + 1                             ;compare hi bytes
   401                                  BCC ++                                  ;.X < ARGh: error
   402                                  BNE +                                   ;.X > ARGh: ok
   403                                  CPY TMP                                 ;.X = ARGh: compare lo byte
   404                                  BCC ++                                  ;.Y < ARGl: error
   405                                  BEQ ++                                  ;.Y = ARGl: error
   406                          +       LDY TMP                                 ;reload index, lo
   407                                  LDA TMP + 1
   408                                  BEQ +
   409                                  INC ACCU + 1                            ;inc ACCUh if needed
   410                          +       RTS
   411                          ++      +caml_raise Invalid_argument, "index out of bounds"
   412                          }
   413                          
   414                          !ifdef caml_PRIM__caml_string_length_yx {
   415                          caml_string_length_yx
   416                                  ;; ACCU = string
   417                                  ;; return the string length in .Y,.X (int16, lo-hi)
   418                                  LDA ACCU + 1
   419                                  PHA                                     ;save ACCU + 1
   420                                  DEY                                     ;LDY # -1
   421                                  DEC ACCU + 1
   422                                  LDA (ACCU),Y                            ;.A := size
   423                                  INC ACCU + 1
   424                                  LDX # 0
   425                                  ASL
   426                                  TAY                                     ;.Y := <(2 * size)
   427                                  BCC @minus1
   428                                  BNE +
   429                                  DEY                                     ;shortcut when .Y=256
   430                                  BNE @pad                                ;bne=jmp
   431                          +       INC ACCU + 1
   432                                  INX                                     ;.X := >(2 * size)
   433                          @minus1 DEY                                     ;.Y := <(2 * size - 1)
   434                                  CPY # $FF
   435                                  BNE @pad
   436                                  DEC ACCU + 1
   437                                  DEX                                     ;.X := >(2 * size - 1)
   438                          @pad    LDA (ACCU),Y                            ;.A := padding byte
   439                                  BEQ +
   440                                  DEY                                     ;.Y := <(2 * size -1 -pad)
   441                                  CPY # $FF
   442                                  BNE +
   443                                  DEX                                     ;.X := >(2 * size -1 -pad)
   444                          +       PLA
   445                                  STA ACCU + 1                            ;restore ACCU+1
   446                                  RTS
   447                          }
   448                          
   449                          }      ;; !zone caml_STRINGS
   450                          

