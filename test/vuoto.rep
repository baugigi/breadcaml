   169                          !macro  caml_raise .exn {                       ;Raise a standard exception
   170                                  LDA # <caml_std_exn[.exn]
   171                                  STA ACCU
   172                                  LDA # >caml_std_exn[.exn]
   173                                  STA ACCU + 1
   174                                  JMP RAISE
   175                          }
   176                          !macro  caml_raise .exn, .str {                 ;As above, with a string arg.
   177                                  LDA # <.blk
   178                                  STA ACCU
   179                                  LDA # >.blk
   180                                  STA ACCU + 1
   181                                  JMP RAISE
   182                                  !align $01, $00
   183                                  !byte String_tag, (.h - .s) div 2
   184                          .s      +caml_string .str
   185                          .h      !byte 0, 2
   186                          .blk    !word caml_std_exn[.exn], .s
   187                          }
   188                                  ;; Statically allocate std exns and init caml_std_exn[] ptr array
   189                          !macro  caml_alloc_exn .s, .i {
