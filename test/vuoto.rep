    19                          !zone AUX_TOOLS {
    20                                  
    21                          !ifdef caml_PRIM__caml_memcpy {
    22                                  ;; copy memory
    23                                  ;; TMP, TMP + 1 =  source start address
    24                                  ;; TMP + 2, TMP + 3 = destination start address
    25                                  ;; TMP + 4, TMP + 5 = number of bytes to move
    26                                  ;; used registers: A, X, Y; return Y = 0.
    27                          caml_memcpy
    28                                  @FROM = TMP                     ;source address
    29                                  @TO = TMP + 2                   ;destination address
    30                                  @NUM = TMP + 4                  ;num bytes
    31                                  LDA @FROM + 1
    32                                  CMP @TO + 1
    33                                  BCC @caml_memcpy_up
    34                                  BNE @caml_memcpy_dn
    35                                  LDA @FROM
    36                                  CMP @TO
    37                                  BCC @caml_memcpy_up
    38                                  BNE @caml_memcpy_dn
    39                                  RTS
    40                                  ;; copy memory from a higher address to a lower one
    41                          @caml_memcpy_dn
    42                                  LDY # 0
    43                                  LDX @NUM + 1
    44                                  BEQ +
    45                          -       LDA (@FROM),Y                   ;move a page at a time
    46                                  STA (@TO),Y
    47                                  INY
    48                                  BNE -
    49                                  INC @FROM + 1
    50                                  INC @TO + 1
    51                                  DEX
    52                                  BNE -
    53                          +       LDX @NUM
    54                                  BEQ +
    55                          -       LDA (@FROM),Y                   ;move the remaining bytes
    56                                  STA (@TO),Y
    57                                  INY
    58                                  DEX
    59                                  BNE -
    60                          +       LDY # 0
    61                                  RTS
    62                                  ;; copy memory from a lower address to a higher one
    63                          @caml_memcpy_up
    64                                  LDX @NUM + 1                    ;the last byte must be moved first
    65                                  CLC                             ;start at the final pages of from & to
    66                                  TXA
    67                                  ADC @FROM + 1
    68                                  STA @FROM + 1
    69                                  CLC
    70                                  TXA
    71                                  ADC @TO + 1
    72                                  STA @TO + 1
    73                                  INX                             ;allows use of bne after dex below
    74                                  LDY @NUM
    75                                  BEQ ++
    76                                  DEY                             ;move bytes on the last page first
    77                                  BEQ +
    78                          -       LDA (@FROM),Y
    79                                  STA (@TO),Y
    80                                  DEY
    81                                  BNE -
    82                          +       LDA (@FROM),Y                   ;handle y = 0 separately
    83                                  STA (@TO),Y
    84                          ++      DEY
    85                                  DEC @FROM + 1                   ;move the next page (if any)
    86                                  DEC @TO + 1
    87                                  DEX
    88                                  BNE -
    89                                  LDY # 0
    90                                  RTS
    91                          }
    92                          
    93                          !ifdef  caml_PRIM__caml_blkcpy {
    94                                  ;; caml_blkcpy
    95                                  ;; Aux. routine to copy all fields from ACCU to BLK; C:Y = 2 * size.
    96                                  ;; The block's header is not copied!
    97                          caml_blkcpy
    98                                  BCC +                           ; less than 256 bytes (<128 fields)
    99                                  BEQ ++                          ; exactly 256 bytes   (=128 fields)
   100                                  INC ACCU + 1                    ; more than 256 bytes (>128 fields)
   101                                  INC BLK + 1
   102                          --
   103                          +       DEY
   104                          -       LDA (ACCU),Y
   105                                  STA (BLK),Y
   106                                  DEY
   107                                  BNE -
   108                                  LDA (ACCU),Y                    ; handle Y = 0 apart
   109                                  STA (BLK),Y
   110                                  BCC +
   111                                  DEC ACCU + 1
   112                                  DEC BLK + 1
   113                          ++      CLC
   114                                  BCC --
   115                          +       RTS
   116                          }
   117                          
   118                          }       ;; !zone AUX_TOOLS
   119                          

