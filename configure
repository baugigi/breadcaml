#  ——————————————————————————————————————————————————————————————————————
#  The BreadCaml Project / Progetto BreadCaml
#  Copyright (C) 21-Apr-2026 Piero Furiesi
#  
#  This program is  free software; you can redistribute  it and/or modify
#  it under the terms of the  GNU GENERAL PUBLIC LICENSE (GPL) version 2,
#  as specified in the LICENSE-en file in the project root folder.
#  
#  Questo  programma  è software  libero;  può  essere ridistribuito  e/o
#  modificato nei termini della GNU GENERAL PUBLIC LICENSE (GPL) versione
#  2, come specificato nel file  LICENZA-it nella cartella principale del
#  progetto.
#  ——————————————————————————————————————————————————————————————————————

for C in date dirname mktemp realpath; do
  command -v "$C" &>/dev/null || {
    echo "This script requires GNU coreutils." 1>&2
    exit 1
  }
done

[ "$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd -P)" = "$(pwd -P)" ] || {
  echo "Please run this script from its own directory." 1>&2
  exit 1
}

[ -d etc ] || mkdir etc

##### CONFIG DATA

# Config file
MAKEFILE_CONF="etc/Makefile.conf"

# BreadCaml version
[[ -r VERSION ]] || { echo "VERSION file not found" 1>&2; exit 1; }
VERSION="$(<VERSION)"

# Default installation paths
PREFIX="${OPAM_SWITCH_PREFIX:-$HOME}"
BINDIR="$PREFIX/bin"
LIBDIR="$PREFIX/lib/bcaml"
MANDIR="$PREFIX/man"
DOCDIR="$PREFIX/doc/bcaml"

# Section for Breadcaml Stdlib man pages
MAN3EXT=3bc

# ACME cross-assembler installation data
ACME_TBZ2=acme-crossass-code-0-r454-trunk.tar.bz2  # source tarball
ACME_REL='0.97 ("Zem"), 1 May 2026'                # release
ACME_MIN=20251116                                  # oldest compatible date

# OCaml environment installation data
OPAM_INSTALLER='https://opam.ocaml.org/install.sh' # official opam installer
OCAML_FORMULA='["ocaml" {>= "4.14.0" & < "5.0.0"}]'  # compiler required
OCAML_SWITCH=LTS                                   # name of the switch to create
OBYTELIB=obytelib                                  # opam package to install

# Set to 'Y' (options -y, -s) to accept all the installation proposals
ASSUME_YES=''

##### OUTPUT

# echo command (will be ':' if -s|--silent option is specified)
ECHO=echo

# Enable @(pattern_list) matching
shopt -s extglob

# If stdout is a terminal and supports colours, use them
unset -v red grn yel bld nrm
[[ -t 1 ]] && command -v tput &>/dev/null && {
  ncol="$(tput colors 2>/dev/null)"
  (( $? == 0 && ${ncol:-0} >= 4 )) && {
    red="$(tput setaf 1)"
    grn="$(tput setaf 2)"
    yel="$(tput setaf 3)"
    bld="$(tput bold)"
    nrm="$(tput sgr0)"
  }
}

##### FUNCTIONS

# Print a failure message and exit
function failwith { # $1: text message
  echo "${bld}${red}Configuration failed:${nrm} $*." 1>&2
  exit 1
}

# Print an execution progress message of given type
function message { # $1: message type; $2: message text
  case "$1" in
    start | end) "$ECHO" "${bld}$2${nrm}" ;;
    ok)          "$ECHO" "${bld}${grn} ok,${nrm} $2" ;;
    warn)        "$ECHO" "${bld}${yel} WRN${nrm} $2" ;;
    cont)        "$ECHO" "     $2" ;;
    ask)         "$ECHO" -n "${bld}     $2${nrm}" ;;
    err)         echo "${bld}${red} ERR${nrm} $2" 1>&2 ;;
    *)           failwith "message: invalid argument '$1'" ;;
  esac
}

# Ask the user to confirm an installation, unless ASSUME_YES is set (options
# -y, -s): the answer must be 'y' or 'yes' (case-insensitive) or empty.
function confirm { # $@: the lines of text describing the proposal
  [[ $ASSUME_YES ]] && return 0
  local LINE ANSWER
  for LINE in "$@"; do message cont "$LINE"; done
  message ask "Do you want to proceed? [Y/n] "
  read -r ANSWER || failwith "no answer"
  [[ $ANSWER == @([Yy]|[Yy][Ee][Ss]|) ]] || failwith "aborted by user"
}

# Run a command; with option -s its output is shown only if it fails.
function run { # $@: command and arguments
  if [[ $ECHO == ':' ]]; then
    local LOG
    LOG="$(mktemp)"
    "$@" >"$LOG" 2>&1 || { cat "$LOG" 1>&2; rm -f "$LOG"; return 1; }
    rm -f "$LOG"
  else
    "$@"
  fi
}

# Install ACME (and rename/retain the old release) in BINDIR, after asking for
# confirmation. Return COMMAND[acme] properly set.
function install_acme { # $1: [rename|retain] (optional)
  unset -v ACME_OLD
  if [[ $1 ]]; then
    confirm "This script can install the BreadCaml-compatible release" \
            "$ACME_REL in '$BINDIR'." \
            "The existing release will be ${1%e}ed."
  else
    confirm "This script can install the BreadCaml-compatible release" \
            "$ACME_REL in '$BINDIR'."
  fi
  message cont "Installing ACME..."
  [[ -r $ACME_TBZ2 ]] || \
    failwith "file '$ACME_TBZ2' doesn't exist or is not readable"
  [[ $1 == rename ]] && {
    ACME_OLD="$(mktemp "${CMD[acme]}-old-XXXXX")"
    cp -p "${CMD[acme]}" "$ACME_OLD"
  }
  ACME_TMP="$(mktemp -d)"
  ACME_LOG="$(mktemp)"
  mkdir -p "$BINDIR"
  if ! { tar -xjf "$ACME_TBZ2" --one-top-level="$ACME_TMP" \
             --strip-components=1 && \
           make -C "$ACME_TMP/src" BINDIR="$BINDIR" install && \
           rm -fr "$ACME_TMP"
       } >"$ACME_LOG" 2>&1; then
    cat "$ACME_LOG" 1>&2
    [[ $1 == rename ]] && mv -f "$ACME_OLD" "${CMD[acme]}"
    rm -fr "$ACME_TMP" "$ACME_LOG"
    failwith "ACME installation failed"
  fi
  rm -f "$ACME_LOG"
  message ok "ACME rel. $ACME_REL installed successfully."
  case "$1" in
    rename) message cont "The previous release is now '$ACME_OLD'.";;
    retain) message cont "The previous release has been retained." ;;
  esac
  CMD[acme]="$BINDIR/acme"
}

# Succeed if $1 is a version number of OCaml 4.14.x
function ocaml_version_ok { # $1: version (as printed by ocamlc -vnum)
  local MAJOR MINOR PATCH
  IFS='.' read -r MAJOR MINOR PATCH <<<"$1"
  [[ $MAJOR == +([0-9]) && $MINOR == +([0-9]) ]] && \
    (( MAJOR == 4 && MINOR >= 14 ))
}

# Print the version of OCaml in the opam switch $1 (nothing if there is none)
function switch_ocaml_version { # $1: switch name
  "${CMD[opam]}" exec --switch="$1" -- ocamlc -vnum 2>/dev/null
}

# Use the opam switch $1 for the rest of this script: set up its environment
# (PATH, OPAM_SWITCH_PREFIX...) as 'eval $(opam env)' does, and, unless the
# user specified the target directories, install into the switch.
function use_switch { # $1: switch name
  eval "$("${CMD[opam]}" env --switch="$1" --set-switch)" || \
    failwith "cannot set the environment of the opam switch '$1'"
  hash -r
  [[ $DIROPT ]] || {
    PREFIX="${OPAM_SWITCH_PREFIX:-$HOME}"
    BINDIR="$PREFIX/bin"
    LIBDIR="$PREFIX/lib/bcaml"
    MANDIR="$PREFIX/man"
    DOCDIR="$PREFIX/doc/bcaml"
  }
}

# Install opam with the official installer, then set CMD[opam].
function install_opam {
  local DL INST
  if command -v curl &>/dev/null; then DL=(curl -fsSL -o)
  elif command -v wget &>/dev/null; then DL=(wget -q -O)
  else failwith "opam is not installed, and neither curl nor wget is available"
  fi
  confirm "This script can download and run the official opam installer" \
          "($OPAM_INSTALLER)." \
          "It will ask where to install opam, and may ask for your password."
  message cont "Installing opam..."
  INST="$(mktemp)"
  "${DL[@]}" "$INST" "$OPAM_INSTALLER" || {
    rm -f "$INST"
    failwith "cannot download '$OPAM_INSTALLER'"
  }
  sh "$INST" || { rm -f "$INST"; failwith "opam installation failed"; }
  rm -f "$INST"
  hash -r
  CMD[opam]="$(command -v opam 2>/dev/null)" || {
    # the installer may have used a directory that is not in PATH
    local D
    for D in /usr/local/bin "$HOME/.local/bin" "$HOME/bin"; do
      [[ -x $D/opam ]] && { PATH="$D:$PATH"; CMD[opam]="$D/opam"; break; }
    done
  }
  [[ ${CMD[opam]} ]] || \
    failwith "opam was installed, but it is not in the search PATH"
  message ok "opam installed successfully."
}

# Make sure that opam has been initialised (without any switch: see
# ensure_switch) and that a switch with OCaml 4.14.x is in use; install or
# create what is missing. Return the environment of that switch set up.
function ensure_switch {
  local CUR VER S FOUND
  if [[ ! -r ${OPAMROOT:-$HOME/.opam}/config ]]; then
    message warn "opam has not been initialised"
    confirm "This script can initialise opam ('opam init --bare'), without" \
            "modifying your shell configuration files."
    run "${CMD[opam]}" init --bare --yes --no-setup || \
      failwith "'opam init' failed (if it complains about the sandbox, run" \
               "'opam init --bare --disable-sandboxing' and retry)"
  fi
  CUR="$("${CMD[opam]}" switch show 2>/dev/null)"
  VER=''
  [[ $CUR ]] && VER="$(switch_ocaml_version "$CUR")"
  if ocaml_version_ok "$VER"; then
    message ok "opam: the active switch is '$CUR' (OCaml $VER)"
    use_switch "$CUR"
    return 0
  fi
  if [[ $CUR ]]; then
    message warn "opam: the active switch '$CUR' has no OCaml 4.14.x compiler"
  else
    message warn "opam: no active switch found"
  fi
  # another switch may have the right compiler
  FOUND=''
  for S in $("${CMD[opam]}" switch list --short 2>/dev/null); do
    VER="$(switch_ocaml_version "$S")"
    ocaml_version_ok "$VER" && { FOUND="$S"; break; }
  done
  if [[ $FOUND ]]; then
    confirm "The opam switch '$FOUND' has OCaml $VER." \
            "It will be used by BreadCaml; the default switch of opam is" \
            "not changed."
    message ok "opam: using the switch '$FOUND' (OCaml $VER)"
    use_switch "$FOUND"
    return 0
  fi
  # create a new switch
  S="$OCAML_SWITCH"
  "${CMD[opam]}" switch list --short 2>/dev/null | grep -qxF -- "$S" && \
    S="$OCAML_SWITCH-4.14"
  confirm "This script can create the opam switch '$S' with OCaml 4.14.x." \
          "This compiles the compiler and may take several minutes."
  message cont "Creating the opam switch '$S'..."
  run "${CMD[opam]}" switch create "$S" --formula="$OCAML_FORMULA" --yes || \
    failwith "cannot create the opam switch '$S'"
  message ok "opam: switch '$S' created"
  use_switch "$S"
}

# Make sure that the opam package $1 is installed in the active switch.
function ensure_opam_package { # $1: package name
  if [[ $("${CMD[opam]}" list -s -i "$1" 2>/dev/null) ]]; then
    message ok "opam: $1 is installed in the active switch"
    return 0
  fi
  message warn "opam: $1 is not installed in the active switch"
  confirm "This script can install the opam package '$1'."
  message cont "Installing $1..."
  run "${CMD[opam]}" install --yes "$1" || {
    message cont "Updating the opam repositories and retrying..."
    run "${CMD[opam]}" update --yes && run "${CMD[opam]}" install --yes "$1"
  } || failwith "cannot install the opam package '$1'"
  message ok "opam: $1 installed successfully"
}

# show help and exit
function usage {
  cat <<EOF
Usage: $0 [ OPTIONS... ]
 -b, --bindir DIR  Target directory for Breadcaml binaries
                   (default: $PREFIX/bin)
 -l, --libdir DIR  Target directory for the BreadCaml Stdlib files
                   (default: $PREFIX/lib/bcaml)
 -m, --mandir DIR  Target directory for manual pages
                   (default: $PREFIX/man)
 -d, --docdir DIR  Target directory for HTML documentation
                   (default: $PREFIX/doc/bcaml)
 -p, --prefix DIR  Shortcut for
                   -b DIR/bin -l DIR/lib/bcaml -m DIR/man -d DIR/doc/bcaml
 -y, --yes         Automatically accept the installation proposals for
                   ACME, opam, OCaml 4.14.x and OByteLib, if missing
 -s, --silent      Like -y, also do not display messages (except errors)
 -h, --help        Show this text.
EOF
  exit 0
}

#####

# Parse command-line options and update installation paths accordingly
unset -v DIROPT
while (( $# )); do
  case "$1" in
    -b | --bindir | -l | --libdir | -m | --mandir | -d | --docdir)
      [[ $DIROPT == @(-p|--prefix) ]] && \
        failwith "'$1' and '$DIROPT' are incompatible"
      DIROPT="$1"
      shift
      (( $# )) || failwith "'$DIROPT' expects an argument"
      case "$DIROPT" in
        -b | --bindir) BINDIR="$(realpath -m "${1:-$BINDIR}")" ;;
        -l | --libdir) LIBDIR="$(realpath -m "${1:-$LIBDIR}")" ;;
        -m | --mandir) MANDIR="$(realpath -m "${1:-$MANDIR}")" ;;
        -d | --docdir) DOCDIR="$(realpath -m "${1:-$DOCDIR}")" ;;
      esac
      ;;
    -p | --prefix)
      [[ $DIROPT == @(-b|--bindir|-l|--libdir|-m|--mandir|-d|--docdir) ]] && \
        failwith "'$1' and '$DIROPT' are incompatible"
      DIROPT="$1"
      shift
      (( $# )) || failwith "'$DIROPT' expects an argument"
      PREFIX="$(realpath -m "${1:-$PREFIX}")"
      BINDIR="$PREFIX/bin"
      LIBDIR="$PREFIX/lib/bcaml"
      MANDIR="$PREFIX/man"
      DOCDIR="$PREFIX/doc/bcaml"
      ;;
    -y | --yes)
      ASSUME_YES='Y'
      ;;
    -s | --silent)
      ASSUME_YES='Y'
      ECHO=':'
      ;;
    -h | --help)
      usage
      ;;
    *)  failwith "unknown option '$1'"
  esac
  shift
done

# Ensure all needed system commands are available
message start "Checking system commands..."
declare -A CMD
unset -v MISSING ERRORS
NL=$'\n'
for C in ar bzip2 gcc make sed tar; do
  if CMD[$C]="$(command -v "$C" 2>/dev/null)"; then
    message ok "$C is ${CMD[$C]}"
  else
    message err "$C not found"
    MISSING+="${MISSING:+, }$C"
  fi
  [[ ${CMD[sed]} && $C == sed ]] && {
    # Check that the sed command is the GNU version.
    if "${CMD[sed]}" 'v' </dev/null >/dev/null 2>&1; then
      message ok "sed: its version is the GNU one"
    else
      ERR="sed: its version is not the GNU one"
      message err "$ERR"
      ERRORS+="${ERRORS:+$NL}$ERR"
    fi
  }
done
message end "Done."
if [[ $MISSING$ERRORS ]]; then
  [[ $MISSING ]] && message err "Missing command(s): $MISSING"
  [[ $ERRORS ]] && message err "Environment error(s):$NL$ERRORS"
  failwith "prerequisites not met"
fi

# Ensure that opam, an OCaml 4.14.x switch and obytelib are available,
# proposing to install what is missing
message start "Checking opam and the OCaml environment..."
if CMD[opam]="$(command -v opam 2>/dev/null)"; then
  message ok "opam is ${CMD[opam]}"
else
  message warn "opam not found"
  install_opam
fi
OPAM_MAJOR="$("${CMD[opam]}" --version 2>/dev/null)"
[[ ${OPAM_MAJOR%%.*} == +([0-9]) ]] && (( ${OPAM_MAJOR%%.*} >= 2 )) || \
  failwith "opam 2.x or later is required (found: '${OPAM_MAJOR:-unknown}')"
ensure_switch
ensure_opam_package "$OBYTELIB"
unset -v MISSING ERRORS
for C in ocamlc.opt ocamlopt.opt ocamldoc.opt; do
  KEY=${C%.opt}
  if CMD[$KEY]="$(command -v "$C" 2>/dev/null)"; then
    message ok "$C is ${CMD[$KEY]}"
  elif CMD[$KEY]="$(command -v "$KEY" 2>/dev/null)"; then
    message warn "$C not found, failsafe to ${CMD[$KEY]}"
  else
    message err "$C not found"
    MISSING+="${MISSING:+, }$C"
  fi
  [[ $KEY == ocamlc && ${CMD[ocamlc]} ]] && {
    # Check that the version of ocamlc is correct.
    VER="$("${CMD[ocamlc]}" -vnum)"
    if ocaml_version_ok "$VER"; then
      OCAMLSTDLIB="$("${CMD[ocamlc]}" -where)"
      OCAMLSAFEOPTS="-safe-string -strict-formats -strict-sequence"
      message ok "ocamlc: version is $VER"
    else
      ERR="ocamlc: incompatible version $VER"
      ERR+=" (required: 4.14.0 <= ver < 5.0.0)"
      message err "$ERR"
      ERRORS+="${ERRORS:+$NL}$ERR"
    fi
  }
done
message end "Done."
if [[ $MISSING$ERRORS ]]; then
  [[ $MISSING ]] && message err "Missing command(s): $MISSING"
  [[ $ERRORS ]] && message err "Environment error(s):$NL$ERRORS"
  failwith "prerequisites not met"
fi

# Check if ACME is obsolete or not installed
message start "Checking for the ACME cross-assembler..."
CMD[acme]="$BINDIR/acme"
if [[ -x $BINDIR/acme ]] || \
     CMD[acme]="$(command -v acme 2>/dev/null)"; then
  IFS=',' read -r X REL DATE < <("${CMD[acme]}" --version 2>/dev/null)
  YMD="$(date -d"$DATE" +%Y%m%d 2>/dev/null)"
  if (( YMD >= ACME_MIN )); then
    message ok "found ${CMD[acme]} $REL,$DATE"
  else
    message warn "incompatible version ${CMD[acme]} $REL,$DATE"
    if [[ ${CMD[acme]} == "$BINDIR/acme" ]]; then
      install_acme rename
    else
      install_acme retain
    fi
  fi
else
  message warn "ACME not installed, or not in search PATH"
  install_acme
fi
message end "Done."

# Passing variables from bash to a Makefile is a mess; avoid problematic chars.
# TODO: an appropriate escaping function.
for P in "${CMD[@]}" "$BINDIR" "$LIBDIR" "$MANDIR" "$OCAMLSTDLIB"; do
  [[ $P == *[!a-zA-Z0-9_./+@-]* ]] && \
    failwith "unsupported character in '$P' (allowed: a-z A-Z 0-9 _ . / + @ -)"
done

# Export configuration data to $MAKEFILE_CONF
cat > "$MAKEFILE_CONF" <<EOF
$(sed -nE '/^# (—)+$/,/^# (—)+$/p' "$0")
ACME := ${CMD[acme]}
BINDIR := $BINDIR
LIBDIR := $LIBDIR
MAN1DIR := $MANDIR/man1
MAN3DIR := $MANDIR/man3
MAN3EXT := $MAN3EXT
DOCDIR := $DOCDIR
OCAMLC := ${CMD[ocamlc]} $OCAMLSAFEOPTS
OCAMLC_UNSAFE := ${CMD[ocamlc]}
OCAMLSTDLIB := $OCAMLSTDLIB
OCAMLDOC := ${CMD[ocamldoc]}
OCAMLOPT := ${CMD[ocamlopt]} $OCAMLSAFEOPTS
VERSION := $VERSION

# Progress message for make recipes: coloured only if make's stdout is a
# terminal (GNU make >= 4.1 sets MAKE_TERMOUT) and NO_COLOR is not set
ifdef MAKE_TERMOUT
ifndef NO_COLOR
message = printf '\033[32m%s\033[0m %s\n' '\$(1)' '\$(2)'
endif
endif
message ?= printf '%s %s\n' '\$(1)' '\$(2)'
EOF

# Show the result of the configuration
$ECHO "
${bld}BreadCaml version $VERSION configured successfully as follows:${nrm}

  BINDIR = '$BINDIR'
  LIBDIR = '$LIBDIR'
  MANDIR = '$MANDIR'
  DOCDIR = '$DOCDIR'

  The ${bld}bcamlc${nrm} compiler will use
  - the OCaml bytecode compiler '${CMD[ocamlc]}'
  - the ACME cross-assembler    '${CMD[acme]}'

${bld}*${nrm} For configuration options, run:      '${bld}$0 --help${nrm}'
${bld}*${nrm} To build the BreadCaml system, run:  '${bld}make${nrm}'
  Then install it with:                '${bld}make install${nrm}'
  Finally, clean the source tree with: '${bld}make clean${nrm}'
${bld}*${nrm} To uninstall BreadCaml, run:         '${bld}make uninstall${nrm}'
"
