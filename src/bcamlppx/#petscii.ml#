(** Char constants for graphic glyphs available only in the PETSCII
    lowercase/uppercase character set. *)
module LcaseGlyph = struct

  (** {1 checker shades} *)

  (** inverse checker shade *)		let ichk = '\222'

  (** {1 diagonal hatches} *)
  
  (** ascending diagonal hatch *) 	let adh = '\223'
  (** descending diagonal hatch *) 	let ddh = '\169'
  
  (** {1 misc} *)
  
  (** check mark, tick *)		let cmk = '\186'
end



(** [translate_char ch] is the PETSCII character corresponding to the ASCII
    character [ch], according to the following mapping:
    - if [ch] is a letter, it is mapped to the PETSCII character with the
    corresponding glyph from the lowercase/uppercase set (Note: uppercase
    letters are mapped to PETSCII codes 193 to 218, not to codes 97 to 122,
    which are duplicates of the previous ones but cannot be produced using the
    C64 keyboard);
    - if [ch] is ['_'], ['|'], or ['\163'] (the ISO-8859-1 Latin1 Pound sign),
    it is mapped to the PETSCII character with code 164, 221, or 92,
    respectively;
    - otherwise, [ch] is mapped to the PETSCII character with the same code. *)
let translate_char ch = match ch with
  | 'A' .. 'Z' -> (Char.(chr (code ch + 0x80)))
  | 'a' .. 'z' -> (Char.(chr (code ch - 0x20)))
  | '_' -> CommonGlyph.under
  | '|' -> CommonGlyph.cvl
  | '\163' -> CommonGlyph.pound
  | _ -> ch


