(** ASCII to PETSCII conversion for the bcamlppx preprocessor. *)

module CtlChar = struct
  
  (** {1 cursor movements} *)
  
  (** up *)		let up = '\145'
  (** down *)		let dn = '\017'
  (** left *)		let lf = '\157'
  (** right *)		let rt = '\029'
  
  (** {1 colours} *)
  
  (** black *)		let blk = '\144'
  (** white *)		let wht = '\005'
  (** red *)		let red = '\028'
  (** cyan *)		let cyn = '\159'
  (** purple *)		let pur = '\156'
  (** green *)		let grn = '\030'
  (** blue *)		let blu = '\031'
  (** yellow *)		let yel = '\158'
  (** orange *)		let org = '\129'
  (** brown *)		let brn = '\149'
  (** pink *)		let pnk = '\150'
  (** light green *)	let lgrn = '\153'
  (** light blue *)	let lblu = '\154'
  (** dark grey *)	let dgry = '\151'
  (** medium grey *)	let mgry = '\152'
  (** light grey *)	let lgry = '\155'

  (** {1 charsets} *)
  
  (** enable reverse mode *)			let rvson = '\018'
  (** disable reverse mode *)			let rvsoff = '\146'
  (** enable SHT+CBM for charset switching *)	let swon = '\009'
  (** disable SHT+CBM for charset switching *)	let swoff = '\008'
  (** select the lowercase charset *)		let lcase = '\014'
  (** select the uppercase charset *)		let ucase = '\142'

  (** {1 function keys} *)
  
  (** F1 *)		let f1 = '\133'
  (** F2 (SHT+F1) *)	let f2 = '\137'
  (** F3 *)		let f3 = '\134'
  (** F4 (SHT+F3) *)	let f4 = '\138'
  (** F5 *)		let f5 = '\135'
  (** F6 (SHT+F5) *)	let f6 = '\139'
  (** F7 *)		let f7 = '\136'
  (** F8 (SHT+F7) *)	let f8 = '\140'
  
  (** {1 other keys} *)
  
  (** RUN/STOP *)	let stop    = '\003'
  (** SHT+RUN/STOP *)	let run	    = '\131'
  (** RETURN *) 	let cr	    = '\013'
  (** CLR/HOME *)	let home    = '\019'
  (** SHT+CLR/HOME *)	let clr	    = '\147'
  (** INST/DEL *)	let del	    = '\020'
  (** SHT+INST/DEL *)	let inst    = '\148'
  (** SHT+SPACE BAR *)	let shf_spc = '\160'
  (** SHT+RETURN *)	let shf_cr  = '\141'
  (** CTL+LEFT ARROW *)	let ctl_larw  = '\006'
  (** CTL+UP ARROW *)	let ctl_uarw  = grn
  (** CTL+POUND *)  	let ctl_pound = red

  (** {1 misc} *)

  (** NULL *)		let nul = '\000'

end


(** Char constants for graphic glyphs available in both uppercase/graphic and
    lowercase/uppercase PETSCII character sets. *)
module CommonGlyph = struct
  
  (** {1 one-pixel-wide lines} *)

  (** underscore *)	let under = '\164'
  (** upperscore *)	let upper = '\163'

  (** {1 two-pixel-wide lines} *)

  (** top horizontal line *)		let thl = '\183'
  (** central horizontal line *)	let chl = '\192'
  (** bottom horizontal line *)		let bhl = '\175'
  (** left vertical line *)		let lvl = '\165'
  (** central vertical line *)		let cvl = '\221'
  (** right vertical line *)		let rvl = '\167'

  (** {i alternate characters} *)

  (** same glyph as {!lvl} *)		let lvl_ = '\180'
  (** same glyph as {!rvl} *)		let rvl_ = '\170'
  

  (** {1 blocks} *)
                                                     
  (** top block, 1 pixel wide *)	let tb1 = upper
  (** top block, 2 pixel wide *)	let tb2 = thl
  (** top block, 3 pixel wide *)	let tb3 = '\184'
  (** bottom block, 1 pixel wide *)	let bb1 = under
  (** bottom block, 2 pixel wide *)	let bb2 = bhl
  (** bottom block, 3 pixel wide *)	let bb3 = '\185'
