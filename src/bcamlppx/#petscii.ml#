let rec split_chars str = fun res pos ->
  if pos < 0 then res
  else split_chars str (str.[pos] :: res) (pos - 1)

let of_mnemo mnemo =
  let mnemo = String.uppercase_ascii mnemo in
  try
    Hashtbl.find mnemo_ht mnemo
  with Not_found ->
    begin match split_chars mnemo [] (String.length mnemo - 1) with
    | ['0'..'9' as d2; '0'..'9' as d1; '0'..'9' as d0] ->
       let dec dgt = Char.(code dgt - code '0') in
       Char.chr (100 * dec d2 + 10 * dec d1 + dec d0)
    | ['O';
       '0'..'3' as o2; '0'..'7' as o1; '0'..'7' as o0] ->
       let oct dgt = Char.(code dgt - code '0') in
       Char.chr (64 * oct o2 + 8 * oct o1 + oct o0)
    | ['X';
       ('0'..'9'|'A'..'F') as x1;
       ('0'..'9'|'A'..'F') as x0] ->
       let hex dgt = match dgt with
         | '0'..'9' -> Char.(code dgt - code '0')
         | _ -> 10 + Char.(code (uppercase_ascii dgt) - code 'A') in
       Char.chr (16 * hex x1 + hex x0)
    | ['C'; 'T'; 'L'; '_'; c ] ->
       begin match c with
       | 'A' .. 'Z' -> Char.(chr (1 + code c - code 'A'))
       | '0' .. '9' ->
          let i = Char.(code c - code '0') in
          CtlChar.[|rvsoff; blk; wht; red; cyn; pur; grn; blu; yel; rvson|].(i)
       | '@' -> '\000'
       | ':' -> '\027'
       | ';' -> '\029'
       | '=' -> '\031'
       | _ -> failwith "Petscii.translate_string"
       end
    | _ -> failwith "Petscii.translate_string"
    end

let rec parse status res splitted_str_lst = match status, splitted_str_lst with
  (* status = `In iif '{' parsed and closing '}' not parsed yet *)
  | `Out, Str.Text t   :: l -> parse `Out (String.map translate_char t :: res) l
  | `Out, Str.Delim "{":: l -> parse `In res l
  | `In,  Str.Text t   :: l -> parse `In (String.make 1 (of_mnemo t) :: res) l
  | `In,  Str.Delim "}":: l -> parse `Out res l
  | `Out, [] ->                String.concat "" (List.rev res)
  | _ -> failwith "Petscii.translate_string"

(**/**)


(** [translate_string str] is the string obtained from [str] by replacing all
    its substrings of the form ["{mnemonic}"] with the PETSCII character
    represented by [mnemonic].

    Valid mnemonics are case-insensitive strings as follows:
    - a string corresponding to an identifier defined in {!CtlChar},
    {!CommonGlyph}, {!UcaseGlyph}, or {!LcaseGlyph} modules represents the PETSCII
    char bound to that identifier;
    - [ddd], [oddd], or [xdd] (where [d] is a decimal, octal, or hexadecimal
    digit respectively) represents the PETSCII character with the corresponding
    code;
    - [ctl_c] (where [c] is a letter, a digit, [@], [:], [;], or [=]) represents
    the PETSCII character corresponding to the [CONTROL+c] key combination on
    the C64 keyboard.

    E.g., both ["{POUND}"] and ["{pound}"] are translated to the British Pound
    sign, bound to {!CommonGlyph.pound}; ["{X56}"] and ["{UArw}"] are translated
    to the {!CommonGlyph.uarw} character; ["{Ctl_H}"] is translated to ['\008'].
    
    @raise Failure ["Petscii.translate_string"] if [str] contains nested or
      unbalanced [{] [}] or invalid mnemonics. *)
let translate_string str =
  parse `Out [] Str.(full_split (regexp "[{}]") str)

